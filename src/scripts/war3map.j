dItem,ItemOwnerPlayer_2,false)call SetItemUserData(TempCreatedItem,1)elseif itemTypeIndex==ItemIndexCost700C thenset itemSlot=GetUnitItemSlotIndex(triggerUnit,pickedItem)set ItemOwnerPlayer_2=GetItemPlayer(pickedItem)call RemoveItemSilently(pickedItem)set TempCreatedItem=CreateItemInInventorySlot(triggerUnit,ItemTypeId[ItemIndexCost700B],itemSlot)call SetItemPlayer(TempCreatedItem,ItemOwnerPlayer_2,false)call SetItemUserData(TempCreatedItem,0)elseif MatchesAnyReservedId(itemTypeIndex)thenif LoadInteger(GameHashtable,GetHandleId(pickedItem),GetHandleId(triggerUnit))>0 thenset ActiveStateFlag=trueset itemSlot=GetUnitItemSlotIndex(triggerUnit,pickedItem)set newItem=CreateItem(LoadInteger(GameHashtable,GetHandleId(pickedItem),GetHandleId(triggerUnit)),GetUnitX(triggerUnit),GetUnitY(triggerUnit))call FlushChildHashtable(GameHashtable,GetHandleId(pickedItem))set ItemOwnerPlayer_2=GetItemPlayer(pickedItem)call RemoveItemSilently(pickedItem)set TempCreatedItem=CreateItemInInventorySlot(triggerUnit,ItemTypeId[ItemIndexCost700E],itemSlot)call SetItemPlayer(TempCreatedItem,ItemOwnerPlayer_2,false)call SetItemUserData(TempCreatedItem,1)call UnitAddItem(triggerUnit,newItem)set ActiveStateFlag=falsecall UnitRemoveAbility(triggerUnit,'B0GI')endifendifset triggerUnit=nullset pickedItem=nullset linkedUnit=nullset newItem=nullendfunctionfunction OnPickupToggleArmletForm takes nothing returns booleanlocal integer slotIndexlocal real tempRealcall DisableTrigger(ToggleableTrigger)if FindItemTypeIndexBaseTables(GetManipulatedItem())==ItemIndexCost2400B thenset slotIndex=GetUnitItemSlotIndex(GetTriggerUnit(),GetManipulatedItem())set ItemOwnerPlayer_2=GetItemPlayer(GetManipulatedItem())call RemoveItem(GetManipulatedItem())set TempCreatedItem=CreateItemInInventorySlot(GetTriggerUnit(),ItemTypeId[ItemIndexArmlet],slotIndex)call SetItemPlayer(TempCreatedItem,ItemOwnerPlayer_2,false)call SetItemUserData(TempCreatedItem,1)call SetUnitStateFlagActive(GetT