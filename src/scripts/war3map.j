etTriggerEventId()==EVENT_WIDGET_DEATH thencall RemoveFireRemnantFromList(casterUnit,remnantUnit)call DestroyEffect((LoadEffectHandle(GameHashtable,(triggerId),(175))))call DestroyEffect((LoadEffectHandle(GameHashtable,(triggerId),(176))))call DestroyEffect((LoadEffectHandle(GameHashtable,(triggerId),(177))))call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(remnantTrigger)elseif distance<2 thencall SetUnitAnimationByIndex(remnantUnit,1)elseif distance<moveStep thenset newX=destXset newY=destYelseset newX=remnantX+moveStep*Cos(moveAngle)set newY=remnantY+moveStep*Sin(moveAngle)endifcall SetUnitX(remnantUnit,newX)call SetUnitY(remnantUnit,newY)endifset remnantTrigger=nullset casterUnit=nullset remnantUnit=nullreturn falseendfunctionfunction SpawnFireRemnant takes nothing returns nothinglocal unit caster=GetTriggerUnit()local real angle=AngleBetweenCoords(GetUnitX(caster),GetUnitY(caster),GetSpellTargetX(),GetSpellTargetY())*bj_DEGTORADlocal integer handleId=GetHandleId(caster)local integer remnantCount=(LoadInteger(GameHashtable,(handleId),(746)))local integer abilityLevel=GetUnitAbilityLevel(caster,'A2JK')local unit prevRemnant=(LoadUnitHandle(GameHashtable,(handleId),(1450+1)))local unit remnantUnit=CreateUnit(GetOwningPlayer(caster),'h0E8',GetUnitX(caster),GetUnitY(caster),angle*bj_RADTODEG)local trigger whichTriggerlocal integer index=1set remnantCount=remnantCount+1call SaveUnitHandle(GameHashtable,(handleId),(1450+remnantCount),(remnantUnit))call SaveInteger(GameHashtable,(handleId),(746),(remnantCount))set whichTrigger=CreateTrigger()set handleId=GetHandleId(whichTrigger)call SetUnitVertexColor(remnantUnit,255,255,255,75)call SetUnitTimeScale(remnantUnit,2)call SetUnitAnimationByIndex(remnantUnit,0)call TriggerRegisterTimerEvent(whichTrigger,.02,true)call TriggerAddCondition(whichTrigger,Condition(function OnFireRemnantTravelTick))call TriggerRegisterDeathEvent(whichTrigger,remnantUnit)call UnitApplyTimedLife(remnantUnit,'BTLF',45)call SaveEffectHandle(GameHashtable,(handleId),(175),(AddSpecialEffectTarget("war3mapImported\\Phoenix_Missile_smaller.mdx",remnantUnit,"hand right alternate")))call SaveEffectHandle(GameHashtable,(handleId),(176),(AddSpecialEffectTarget("war3mapImported\\Phoenix_Missile_smaller.mdx",remnantUnit,"hand left alternate")))call SaveEffectHandle(GameHashtable,(handleId),(177),(AddSpecialEffectTarget("war3mapImported\\FlameDash_Ground.mdx",remnantUnit,"origin")))call SaveUnitHandle(GameHashtable,(handleId),(2),(caster))call SaveUnitHandle(GameHashtable,(handleId),(19),(remnantUnit))call SaveReal(GameHashtable,(handleId),(47),((GetSpellTargetX())*1.))call SaveReal(GameHashtable,(handleId),(48),((GetSpellTargetY())*1.))set caster=nullset whichTrigger=nullset prevRemnant=nullset remnantUnit=nullendfunctionfunction OnCastPlaceFireRemnant takes nothing returns nothinglocal unit triggerUnit=GetTriggerUnit()local integer chargeCount=(LoadInteger(GameHashtable,(GetHandleId(triggerUnit)),(747)))if chargeCount>0 thencall SpawnFireRemnant()call UnitRemoveAbility(triggerUnit,SwapAbilitySpellIds[chargeCount])set chargeCount=chargeCount-1call SaveInteger(GameHashtable,(GetHandleId(triggerUnit)),(747),(chargeCount))call AddPermanentAbility(triggerUnit,SwapAbilitySpellIds[chargeCount])elsecall ShowErrorMessageToPlayer(GetOwningPlayer(GetTriggerUnit()),GetObjectName('n0NY'))endifset triggerUnit=nullendfunctionfunction FilterFireRemnant takes nothing returns booleanreturn GetUnitTypeId(GetFilterUnit())=='h0E8'endfunctionfunction EnumFindFarthestFireRemnant takes nothing returns nothinglocal real distanceToTarget=DistanceBetweenCoords(GetUnitX(GetEnumUnit()),GetUnitY(GetEnumUnit()),TargetPointX,TargetPointY)if distanceToTarget>BestDistanceValue and IsUnitDeadOrInvalid(GetEnumUnit())==false thenset SelectedEnumUnit_2=GetEnumUnit()set BestDistanceValue=distanceToTargetendifendfunctionfunction FindFarthestFireRemnant takes unit sourceUnit,real centerX,real centerY returns unitlocal group tempGroup=AcquireGroupFromPool()set SelectedEnumUnit_2=nullset BestDistanceValue=-1set TargetPointX=centerXset TargetPointY=centerYcall GroupEnumUnitsOfPlayer(tempGroup,GetOwningPlayer(sourceUnit),Condition(function FilterFireRemnant))call ForGroup(tempGroup,function EnumFindFarthestFireRemnant)call ReleaseGroupToPool(tempGroup)set tempGroup=nullreturn SelectedEnumUnit_2endfunctionfunction ComputeRemnantDashSpeed takes unit fromUnit,unit toUnit returns reallocal real distance=DistanceBetweenWidgets(fromUnit,toUnit)local real travelTime=distance/1300.if travelTime>.4 thenreturn distance/.4endifreturn 1300.endfunctionfunction OnFireRemnantDashTick takes nothing returns booleanlocal trigger tickTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(tickTrigger)local unit casterUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local real originX=(LoadReal(GameHashtable,(triggerId),(47)))local real originY=(LoadReal(GameHashtable,(triggerId),(48)))local unit targetRemnant=(LoadUnitHandle(GameHashtable,(triggerId),(19)))local real unitX=GetUnitX(casterUnit)local real unitY=GetUnitY(casterUnit)local real targetX=(LoadReal(GameHashtable,(triggerId),(6)))local real targetY=(LoadReal(GameHashtable,(triggerId),(7)))local real anglelocal real nextXlocal real nextYlocal real distancelocal real dashSpeed=(LoadReal(GameHashtable,(triggerId),(44)))local real stepDistance=dashSpeed*.02local group tempGrouplocal integer stepCount=(LoadInteger(GameHashtable,(triggerId),(34)))if casterUnit==null thencall FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(tickTrigger)return falseendifif targetRemnant!=null thenset targetX=GetUnitX(targetRemnant)set targetY=GetUnitY(targetRemnant)call SaveReal(GameHashtable,(triggerId),(6),((targetX)*1.))call SaveReal(GameHashtable,(triggerId),(7),((targetY)*1.))endifset angle=AngleBetweenCoords(unitX,unitY,targetX,targetY)*bj_DEGTORADset distance=DistanceBetweenCoords(unitX,unitY,targetX,targetY)if GetTriggerEventId()==EVENT_WIDGET_DEATH thencall SaveInteger(GameHashtable,(GetHandleId((casterUnit))),((4319)),(2))call SetUnitVertexColor(casterUnit,255,255,255,255)call SetUnitTimeScale(casterUnit,1)call SetUnitAnimationByIndex(casterUnit,0)call SetUnitPathing(casterUnit,true)call SetUnitInvulnerable(casterUnit,false)call UnitRemoveAbility(casterUnit,'A04R')call DestroyEffect((LoadEffectHandle(GameHashtable,(triggerId),(175))))call DestroyEffect((LoadEffectHandle(GameHashtable,(triggerId),(176))))call DestroyEffect((LoadEffectHandle(GameHashtable,(triggerId),(177))))call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(tickTrigger)elseif distance<stepDistance thencall SetUnitX(casterUnit,targetX)call SetUnitY(casterUnit,targetY)call ExplodeFireRemnantAt(casterUnit,targetRemnant,targetX,targetY)set targetRemnant=FindFarthestFireRemnant(casterUnit,originX,originY)if targetRemnant==null thencall SaveInteger(GameHashtable,(GetHandleId((casterUnit))),((4319)),(2))call KillTreesInArea(targetX,targetY,100)call SetUnitVertexColor(casterUnit,255,255,255,255)call SetUnitTimeScale(casterUnit,1)call SetUnitAnimationByIndex(casterUnit,1)call SetUnitPathing(casterUnit,true)call SetUnitInvulnerable(casterUnit,false)call UnitRemoveAbility(casterUnit,'A04R')call DestroyEffect((LoadEffectHandle(GameHashtable,(triggerId),(175))))call DestroyEffect((LoadEffectHandle(GameHashtable,(triggerId),(176))))call DestroyEffect((LoadEffectHandle(GameHashtable,(triggerId),(177))))call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(tickTrigger)elsecall SaveInteger(GameHashtable,(triggerId),(34),(stepCount+1))call SaveUnitHandle(GameHashtable,(triggerId),(19),(targetRemnant))call SaveReal(GameHashtable,(triggerId),(44),((ComputeRemnantDashSpeed(casterUnit,targetRemnant))*1.))call SaveReal(GameHashtable,(triggerId),(6),((GetUnitX(targetRemnant))*1.))call SaveReal(GameHashtable,(triggerId),(7),((GetUnitY(targetRemnant))*1.))endifelsecall SetUnitAnimationByIndex(casterUnit,0)call SetUnitPathing(casterUnit,false)set nextX=unitX+stepDistance*Cos(angle)set nextY=unitY+stepDistance*Sin(angle)call SetUnitX(casterUnit,nextX)call SetUnitY(casterUnit,nextY)call SetUnitFacing(casterUnit,angle*bj_RADTODEG)call KillTreesInArea(nextX,nextY,100)endifcall RecordUnitPosition(casterUnit,stepCount,GetUnitX(casterUnit),GetUnitY(casterUnit))set tickTrigger=nullset casterUnit=nullset targetRemnant=nullreturn falseendfunctionfunction OnFireRemnantManaRefundExpire takes nothing returns booleanlocal trigger expireTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(expireTrigger)local unit casterUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))call SetUnitState(casterUnit,UNIT_STATE_MANA,GetUnitState(casterUnit,UNIT_STATE_MANA)+150)call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(expireTrigger)set expireTrigger=nullset casterUnit=nullreturn falseendfunctionfunction OnCastActivateFireRemnant takes nothing returns nothinglocal unit caster=GetTriggerUnit()local trigger dashTriggerlocal integer handleId=GetHandleId(caster)local integer chargeCount=(LoadInteger(GameHashtable,(handleId),(746)))local unit farthestRemnantif chargeCount>0 and((LoadInteger(GameHashtable,(GetHandleId((caster))),((4319))))==1)==false thenset dashTrigger=CreateTrigger()set handleId=GetHandleId(dashTrigger)call SetUnitVertexColor(caster,255,0,0,75)call SetUnitTimeScale(caster,2)call SetUnitAnimationByIndex(caster,0)call SetUnitPathing(caster,false)call SetUnitInvulnerable(caster,true)call AddPermanentAbility(caster,'A04R')call SaveInteger(GameHashtable,(GetHandleId((caster))),((4319)),(1))call TriggerRegisterTimerEvent(dashTrigger,.02,true)call TriggerAddCondition(dashTrigger,Condition(function OnFireRemnantDashTick))call TriggerRegisterDeathEvent(dashTrigger,caster)call SaveEffectHandle(GameHashtable,(handleId),(175),(AddSpecialEffectTarget("war3mapImported\\Phoenix_Missile_smaller.mdx",caster,"hand right alternate")))call SaveEffectHandle(GameHashtable,(handleId),(176),(AddSpecialEffectTarget("war3mapImported\\Phoenix_Missile_smaller.mdx",caster,"hand left alternate")))call SaveEffectHandle(GameHashtable,(handleId),(177),(AddSpecialEffectTarget("war3mapImported\\FlameDash_Ground.mdx",caster,"origin")))call SaveUnitHandle(GameHashtable,(handleId),(2),(caster))call SaveReal(GameHashtable,(handleId),(47),((GetSpellTargetX())*1.))call SaveReal(GameHashtable,(handleId),(48),((GetSpellTargetY())*1.))set farthestRemnant=FindFarthestFireRemnant(caster,GetSpellTargetX(),GetSpellTargetY())call SaveUnitHandle(GameHashtable,(handleId),(19),(farthestRemnant))call SaveReal(GameHashtable,(handleId),(44),((ComputeRemnantDashSpeed(caster,farthestRemnant))*1.))call SaveReal(GameHashtable,(handleId),(6),((GetUnitX(farthestRemnant))*1.))call SaveReal(GameHashtable,(handleId),(7),((GetUnitY(farthestRemnant))*1.))call SaveInteger(GameHashtable,(handleId),(34),(1))elseset dashTrigger=CreateTrigger()set handleId=GetHandleId(dashTrigger)call TriggerRegisterTimerEvent(dashTrigger,.0,false)call TriggerAddCondition(dashTrigger,Condition(function OnFireRemnantManaRefundExpire))call SaveUnitHandle(GameHashtable,(handleId),(2),(caster))endifset dashTrigger=nullset caster=nullset farthestRemnant=nullendfunctionfunction OnSpellEffectFireRemnant takes nothing returns booleanif GetSpellAbilityId()==SwapAbilitySpellIds[0]or GetSpellAbilityId()==SwapAbilitySpellIds[1]or GetSpellAbilityId()==SwapAbilitySpellIds[2]or GetSpellAbilityId()==SwapAbilitySpellIds[3]thencall OnCastPlaceFireRemnant()elseif GetSpellAbilityId()=='A2JL' thencall OnCastActivateFireRemnant()endifreturn falseendfunctionfunction OnFireRemnantChargeRegenTick takes nothing returns booleanlocal trigger tickTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(tickTrigger)local unit caster=(LoadUnitHandle(GameHashtable,(handleId),(2)))local integer chargeLevel=(LoadInteger(GameHashtable,(GetHandleId(caster)),(747)))local integer regenCounter=(LoadInteger(GameHashtable,(handleId),(34)))if chargeLevel<3 thenset regenCounter=regenCounter-1call SaveInteger(GameHashtable,(handleId),(34),(regenCounter))if regenCounter==0 thencall UnitRemoveAbility(caster,SwapAbilitySpellIds[chargeLevel])set regenCounter=35call SaveInteger(GameHashtable,(handleId),(34),(regenCounter))set chargeLevel=chargeLevel+1call SaveInteger(GameHashtable,(GetHandleId(caster)),(747),(chargeLevel))call AddPermanentAbility(caster,SwapAbilitySpellIds[chargeLevel])endifendifset tickTrigger=nullset caster=nullreturn falseendfunctionfunction StartFireRemnantChargeRegen takes nothing returns nothinglocal unit casterUnit=GetTriggerUnit()local trigger regenTrigger=CreateTrigger()local integer triggerId=GetHandleId(regenTrigger)call SaveInteger(GameHashtable,(GetHandleId(casterUnit)),(747),(3))call AddPermanentAbility(casterUnit,SwapAbilitySpellIds[3])call TriggerRegisterTimerEvent(regenTrigger,1,true)call TriggerAddCondition(regenTrigger,Condition(function OnFireRemnantChargeRegenTick))call SaveUnitHandle(GameHashtable,(triggerId),(2),(casterUnit))call SaveInteger(GameHashtable,(triggerId),(34),(30))set casterUnit=nullset regenTrigger=nullendfunctionfunction OnLearnFireRemnant takes nothing returns booleanif GetLearnedSkill()=='A2JK' and IsUnitIllusion(GetTriggerUnit())==false thencall AddPermanentAbility(GetTriggerUnit(),'A2JL')call SetUnitAbilityLevel(GetTriggerUnit(),'A2JL',GetUnitAbilityLevel(GetTriggerUnit(),'A2JK'))if GetUnitAbilityLevel(GetTriggerUnit(),'A2JK')==1 thencall StartFireRemnantChargeRegen()call StartFireRemnantPositionScan()endifendifreturn falseendfunctionfunction InitFireRemnantAbility takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(t,Condition(function OnSpellEffectFireRemnant))set t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_HERO_SKILL)call TriggerAddCondition(t,Condition(function OnLearnFireRemnant))set t=nullset SwapAbilitySpellIds[0]='A2JO'set SwapAbilitySpellIds[1]='A2JQ'set SwapAbilitySpellIds[2]='A2JP'set SwapAbilitySpellIds[3]='A2JR'endfunctionfunction ApplyA2B4MissileHitAndKill takes unit caster,unit missileUnit,unit targetUnit,integer abilityLevel returns nothingcall CreateDummyCastScaledAbilityOnTarget(caster,targetUnit,1.25+.25*abilityLevel)call DamageTargetByType(caster,targetUnit,1,40*abilityLevel)call KillUnit(missileUnit)endfunctionfunction FilterA2B4MissileTargetEnemy takes nothing returns booleanif(IsUnitEnemy(FilterReferenceUnit_2,GetOwningPlayer(GetFilterUnit()))and(GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and IsUnitDeadOrInvalid(GetFilterUnit())==false)and(IsUnitType(GetFilterUnit(),UNIT_TYPE_ANCIENT)==false or IsTargetableAncientType(GetFilterUnit())))and(IsUnitVisible(GetFilterUnit(),GetOwningPlayer(FilterReferenceUnit_2)) or UnitHasAnyStealthAbility(GetFilterUnit())==false)thenreturn IsUnitInGroup(GetFilterUnit(),EnumExclusionGroup)==falseendifreturn falseendfunctionfunction OnA2B4MissileSwarmTick takes nothing returns booleanlocal trigger castTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(castTrigger)local group enumGrouplocal integer loopIndex=1local unit casterUnit=(LoadUnitHandle(GameHashtable,(handleId),(2)))local real currentX=(LoadReal(GameHashtable,(handleId),(6)))local real currentY=(LoadReal(GameHashtable,(handleId),(7)))local real angle=(LoadReal(GameHashtable,(handleId),(137)))local unit missileUnitlocal unit targetUnitlocal real storedX=(LoadReal(GameHashtable,(handleId),(47)))local real storedY=(LoadReal(GameHashtable,(handleId),(48)))local group exclusionGroup=(LoadGroupHandle(GameHashtable,(handleId),(187)))set EnumExclusionGroup=exclusionGroupset currentX=ClampXToPlayableArea(currentX+12*Cos(angle))set currentY=ClampYToPlayableArea(currentY+12*Sin(angle))call SaveReal(GameHashtable,(handleId),(6),((currentX)*1.))call SaveReal(GameHashtable,(handleId),(7),((currentY)*1.))if GetTriggerEvalCount(castTrigger)>39 thenloopexitwhen loopIndex>3call KillUnit((LoadUnitHandle(GameHashtable,(handleId),(393+loopIndex-1))))set loopIndex=loopIndex+1endloopcall ReleaseGroupToPool(exclusionGroup)call FlushChildHashtable(GameHashtable,(handleId))call RecycleExpiringTrigger(castTrigger)elseset enumGroup=AcquireGroupFromPool()set FilterReferenceUnit_2=casterUnitcall GroupEnumUnitsInRange(enumGroup,currentX,currentY,275,Condition(function FilterA2B4MissileTargetEnemy))loopexitwhen loopIndex>3if(LoadBoolean(GameHashtable,(handleId),(511+loopIndex-1)))==false thenset missileUnit=(LoadUnitHandle(GameHashtable,(handleId),(393+loopIndex-1)))set currentX=(LoadReal(GameHashtable,(handleId),(549+loopIndex-1)))set currentY=(LoadReal(GameHashtable,(handleId),(567+loopIndex-1)))set currentX=ClampXToPlayableArea(currentX+12*Cos(angle))set currentY=ClampYToPlayableArea(currentY+12*Sin(angle))call SaveReal(GameHashtable,(handleId),(549+loopIndex-1),((currentX)*1.))call SaveReal(GameHashtable,(handleId),(567+loopIndex-1),((currentY)*1.))call SetUnitX(missileUnit,currentX)call SetUnitY(missileUnit,currentY)set targetUnit=GroupPickRandomUnit(enumGroup)if targetUnit!=null thencall GroupRemoveUnit(enumGroup,targetUnit)call SaveInteger(GameHashtable,(GetHandleId((targetUnit))),((4314)),(1))call SaveBoolean(GameHashtable,(handleId),(511+loopIndex-1),(true))call ApplyA2B4MissileHitAndKill(casterUnit,missileUnit,targetUnit,GetUnitAbilityLevel(casterUnit,'A2B4'))endifendifset loopIndex=loopIndex+1endloopcall ReleaseGroupToPool(enumGroup)set enumGroup=nullset missileUnit=nullset targetUnit=nullendifset castTrigger=nullset casterUnit=nullreturn falseendfunctionfunction CastA2B4MissileSwarm takes nothing returns nothinglocal real targetX=GetSpellTargetX()local real targetY=GetSpellTargetY()local unit casterUnit=GetTriggerUnit()local real casterX=GetUnitX(casterUnit)local real casterY=GetUnitY(casterUnit)local real angle=AngleBetweenCoords(casterX,casterY,targetX,targetY)*bj_DEGTORADlocal real offsetAnglelocal unit missileUnitlocal real destX=ClampXToPlayableArea(casterX+500*Cos(angle))local real destY=ClampYToPlayableArea(casterY+500*Sin(angle))local integer missileIndex=0local trigger tickTrigger=CreateTrigger()local integer triggerId=GetHandleId(tickTrigger)local real tempReallocal integer abilityLevel=GetUnitAbilityLevel(casterUnit,'A2B4')local integer missileTypeId='h0DN'set missileIndex=missileIndex+1set offsetAngle=angle*bj_RADTODEG+90if offsetAngle>360 thenset offsetAngle=offsetAngle-360endifset offsetAngle=offsetAngle*bj_DEGTORADset missileUnit=CreateUnit(GetOwningPlayer(casterUnit),missileTypeId,casterX+100*Cos(angle)+100*Cos(offsetAngle),casterY+100*Sin(angle)+100*Sin(offsetAngle),angle*bj_RADTODEG)call SaveUnitHandle(GameHashtable,(triggerId),(393+missileIndex-1),(missileUnit))call SaveBoolean(GameHashtable,(triggerId),(511+missileIndex-1),(false))call SaveReal(GameHashtable,(triggerId),(549+missileIndex-1),((GetUnitX(missileUnit))*1.))call SaveReal(GameHashtable,(triggerId),(567+missileIndex-1),((GetUnitY(missileUnit))*1.))set missileIndex=missileIndex+1set offsetAngle=angle*bj_RADTODEG-90if offsetAngle<0 thenset offsetAngle=360+offsetAngleendifset offsetAngle=offsetAngle*bj_DEGTORADset missileUnit=CreateUnit(GetOwningPlayer(casterUnit),missileTypeId,casterX+100*Cos(angle)+100*Cos(offsetAngle),casterY+100*Sin(angle)+100*Sin(offsetAngle),angle*bj_RADTODEG)call SaveUnitHandle(GameHashtable,(triggerId),(393+missileIndex-1),(missileUnit))call SaveBoolean(GameHashtable,(triggerId),(511+missileIndex-1),(false))call SaveReal(GameHashtable,(triggerId),(549+missileIndex-1),((GetUnitX(missileUnit))*1.))call SaveReal(GameHashtable,(triggerId),(567+missileIndex-1),((GetUnitY(missileUnit))*1.))set missileIndex=missileIndex+1set missileUnit=CreateUnit(GetOwningPlayer(casterUnit),missileTypeId,casterX+100*Cos(angle),casterY+100*Sin(angle),angle*bj_RADTODEG)call SaveUnitHandle(GameHashtable,(triggerId),(393+missileIndex-1),(missileUnit))call SaveBoolean(GameHashtable,(triggerId),(511+missileIndex-1),(false))call SaveReal(GameHashtable,(triggerId),(549+missileIndex-1),((GetUnitX(missileUnit))*1.))call SaveReal(GameHashtable,(triggerId),(567+missileIndex-1),((GetUnitY(missileUnit))*1.))call TriggerRegisterTimerEvent(tickTrigger,.015,true)call TriggerAddCondition(tickTrigger,Condition(function OnA2B4MissileSwarmTick))call SaveUnitHandle(GameHashtable,(triggerId),(2),(casterUnit))call SaveReal(GameHashtable,(triggerId),(6),((casterX)*1.))call SaveReal(GameHashtable,(triggerId),(7),((casterY)*1.))call SaveReal(GameHashtable,(triggerId),(137),((angle)*1.))call SaveReal(GameHashtable,(triggerId),(47),((destX)*1.))call SaveReal(GameHashtable,(triggerId),(48),((destY)*1.))call SaveGroupHandle(GameHashtable,(triggerId),(187),(AcquireGroupFromPool()))set casterUnit=nullset missileUnit=nullset tickTrigger=nullendfunctionfunction OnSpellCastA2B4 takes nothing returns booleanif GetSpellAbilityId()=='A2B4' thencall CastA2B4MissileSwarm()endifreturn falseendfunctionfunction RegisterA2B4SpellTrigger takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(t,Condition(function OnSpellCastA2B4))set t=nullendfunctionfunction OnBladeMailReflectDamage takes nothing returns booleanlocal trigger t=GetTriggeringTrigger()local integer triggerId=GetHandleId(t)local unit caster=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local integer reflectAbilityId=(LoadInteger(GameHashtable,(triggerId),(59)))if caster==null thencall FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(t)return falseendifif GetTriggerEventId()!=EVENT_UNIT_DAMAGED or GetTriggerEvalCount(t)>6 thencall FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(t)call UnitRemoveAbility(caster,reflectAbilityId)call UnitRemoveAbility(caster,'B0FJ')call UnitRemoveAbility(caster,'B0FK')elseif GetEventDamageSource()==caster and GetEventDamage()>0 thencall TriggerRegisterTimerEvent(t,.3,false)endifset t=nullset caster=nullreturn falseendfunctionfunction OnAttackStunProc takes nothing returns booleanlocal trigger eventTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(eventTrigger)local unit attackedUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local unit attacker=GetAttacker()local integer abilityLevel=GetUnitAbilityLevel(attackedUnit,'A2EY')local integer buffAbilityIdlocal integer hitCount=(LoadInteger(GameHashtable,(triggerId),(34)))if attackedUnit==GetTriggerUnit()and ((LoadInteger(GameHashtable,(GetHandleId((attackedUnit))),((4316))))==1)==false and IsUnitAlly(attackedUnit,GetOwningPlayer(attacker))==false thenif GetRandomInt(0,100)<=(hitCount+1)*ProcChancePerLevel[abilityLevel] thencall SaveInteger(GameHashtable,(triggerId),(34),(0))call StartUnitFlagTimer(attackedUnit,4316,0.9)if abilityLevel==1 thenset buffAbilityId='A2GD'elseif abilityLevel==2 thenset buffAbilityId='A2GE'elseif abilityLevel==3 thenset buffAbilityId='A2GF'elseif abilityLevel==4 thenset buffAbilityId='A2GC'endifcall SetPlayerAbilityAvailable(GetOwningPlayer(attackedUnit),buffAbilityId,false)call AddPermanentAbility(attackedUnit,buffAbilityId)set eventTrigger=CreateTrigger()set triggerId=GetHandleId(eventTrigger)call TriggerRegisterDeathEvent(eventTrigger,attackedUnit)call TriggerRegisterUnitEvent(eventTrigger,attacker,EVENT_UNIT_DAMAGED)call TriggerRegisterTimerEvent(eventTrigger,1.,false)call TriggerAddCondition(eventTrigger,Condition(function OnBladeMailReflectDamage))call SaveUnitHandle(GameHashtable,(triggerId),(2),(attackedUnit))call SaveUnitHandle(GameHashtable,(triggerId),(17),(attacker))call SaveInteger(GameHashtable,(triggerId),(59),(buffAbilityId))elsecall SaveInteger(GameHashtable,(triggerId),(34),(hitCount+1))endifendifset eventTrigger=nullset attackedUnit=nullset attacker=nullreturn falseendfunctionfunction RegisterAttackStunProc takes nothing returns nothinglocal unit casterUnit=GetTriggerUnit()local trigger attackTrigger=CreateTrigger()local integer triggerId=GetHandleId(attackTrigger)call TriggerRegisterAnyUnitEventBJ(attackTrigger,EVENT_PLAYER_UNIT_ATTACKED)call TriggerAddCondition(attackTrigger,Condition(function OnAttackStunProc))call SaveUnitHandle(GameHashtable,(triggerId),(2),(casterUnit))set casterUnit=nullset attackTrigger=nullendfunctionfunction OnAttackStunLearned takes nothing returns booleanif GetLearnedSkill()=='A2EY' and IsUnitIllusion(GetTriggerUnit())==false and GetUnitAbilityLevel(GetTriggerUnit(),'A2EY')==1 thencall RegisterAttackStunProc()endifreturn falseendfunctionfunction InitAttackStunSpell takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_HERO_SKILL)call TriggerAddCondition(t,Condition(function OnAttackStunLearned))set ProcChancePerLevel[1]=3.646set ProcChancePerLevel[2]=4.562set ProcChancePerLevel[3]=5.570set ProcChancePerLevel[4]=6.668set t=nullendfunctionfunction ApplyBitmaskBonusAbilities takes unit whichUnit,integer bitmask returns nothinglocal integer array bitArraylocal integer remaining=bitmasklocal integer quotient=1local integer index=0local integer maxBitif bitmask<1 thencall UnitRemoveAbility(whichUnit,AbilityIdsToRemove[0])call UnitRemoveAbility(whichUnit,AbilityIdsToRemove[1])call UnitRemoveAbility(whichUnit,AbilityIdsToRemove[2])call UnitRemoveAbility(whichUnit,AbilityIdsToRemove[3])call UnitRemoveAbility(whichUnit,AbilityIdsToRemove[4])call UnitRemoveAbility(whichUnit,AbilityIdsToRemove[5])call UnitRemoveAbility(whichUnit,AbilityIdsToRemove[6])call UnitRemoveAbility(whichUnit,AbilityIdsToRemove[7])call UnitRemoveAbility(whichUnit,AbilityIdsToRemove[8])returnendifloopexitwhen quotient==0set quotient=remaining/2set bitArray[index]=remaining-quotient*2set remaining=quotientset index=index+1endloopset maxBit=8set index=0loopexitwhen index>maxBitif bitArray[index]==1 thencall AddPermanentAbility(whichUnit,AbilityIdsToRemove[index])elsecall UnitRemoveAbility(whichUnit,AbilityIdsToRemove[index])endifset index=index+1endloopendfunctionfunction AwardDuelWinBonus takes unit winnerUnit,integer abilityLevel,unit loserUnit returns nothinglocal integer winnerHandleId=GetHandleId(winnerUnit)local integer bonusBitmask=(LoadInteger(GameHashtable,(winnerHandleId),(739)))if IsUnitType(loserUnit,UNIT_TYPE_HERO) thenset bonusBitmask=bonusBitmask+6+4*abilityLevelcall SaveInteger(GameHashtable,(winnerHandleId),(739),(bonusBitmask))call CreateTimedTextTagOnUnit(GetUnitName(winnerUnit)+" won the duel!!",5,winnerUnit,.03,255,0,0,255)call ApplyBitmaskBonusAbilities(winnerUnit,bonusBitmask)endifendfunctionfunction IsUnitNotCycloned takes unit u returns booleanreturn GetUnitAbilityLevel(u,'Bcyc')==0 or IsUnitCycloned(u)==falseendfunctionfunction OnDuelPeriodic takes nothing returns booleanlocal trigger eventTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(eventTrigger)local unit dueler=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local unit opponent=(LoadUnitHandle(GameHashtable,(triggerId),(17)))local integer abilityLevel=(LoadInteger(GameHashtable,(triggerId),(5)))local real expireTime=(LoadReal(GameHashtable,(triggerId),(442)))local unit dummyUnitif dueler==null thencall FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(eventTrigger)return falseendifcall ReleaseAbunRefCount(dueler)call ReleaseAbunRefCount(opponent)if GetTriggerEvalCount(eventTrigger)==1 thenset dummyUnit=CreateUnit(GetOwningPlayer(opponent),'e00E',GetUnitX(opponent),GetUnitY(opponent),0)call UnitAddAbility(dummyUnit,'A2G5')call IssueTargetOrderById(dummyUnit,852583,opponent)set dummyUnit=CreateUnit(GetOwningPlayer(dueler),'e00E',GetUnitX(dueler),GetUnitY(dueler),0)call UnitAddAbility(dummyUnit,'A2G5')call IssueTargetOrderById(dummyUnit,852583,dueler)set dummyUnit=nullendifif GetTriggerEventId()==EVENT_WIDGET_DEATH or expireTime<(TimerGetElapsed(GameClockTimer))or IsUnitNotCycloned(dueler)==false or IsUnitNotCycloned(opponent)==false thenif GetTriggerEventId()==EVENT_WIDGET_DEATH thenif GetTriggerUnit()==dueler thencall AwardDuelWinBonus(opponent,abilityLevel,GetTriggerUnit())elsecall AwardDuelWinBonus(dueler,abilityLevel,GetTriggerUnit())endifendifcall UnitRemoveAbility(dueler,'B0FG')call UnitRemoveAbility(opponent,'B0FG')call DestroyEffect((LoadEffectHandle(GameHashtable,(triggerId),(175))))call DestroyEffect((LoadEffectHandle(GameHashtable,(triggerId),(176))))call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(eventTrigger)call SetUnitPathing(dueler,true)call SetUnitPathing(opponent,true)elseif GetIssuedOrderId()!=851973 thencall SetUnitPathing(dueler,false)call SetUnitPathing(opponent,false)call DisableTrigger(eventTrigger)call IssueTargetOrderById(dueler,851983,opponent)call IssueTargetOrderById(opponent,851983,dueler)call EnableTrigger(eventTrigger)endifset eventTrigger=nullset dueler=nullset opponent=nullreturn falseendfunctionfunction CastDuel takes nothing returns nothinglocal unit caster=GetTriggerUnit()local unit targetUnit=GetSpellTargetUnit()local integer abilityLevel=GetUnitAbilityLevel(caster,'A2CI')local trigger duelTriggerlocal integer handleIdcall SetUnitPathing(caster,false)call SetUnitPathing(targetUnit,false)call IssueTargetOrderById(caster,851983,targetUnit)call IssueTargetOrderById(targetUnit,851983,caster)set duelTrigger=CreateTrigger()set handleId=GetHandleId(duelTrigger)call SaveEffectHandle(GameHashtable,(handleId),(175),(AddSpecialEffectTarget("war3mapImported\\DuelFX.mdx",caster,"overhead")))call SaveEffectHandle(GameHashtable,(handleId),(176),(AddSpecialEffectTarget("war3mapImported\\DuelFX.mdx",targetUnit,"overhead")))call SaveUnitHandle(GameHashtable,(handleId),(2),(caster))call SaveUnitHandle(GameHashtable,(handleId),(17),(targetUnit))call SaveInteger(GameHashtable,(handleId),(5),(abilityLevel))call SaveReal(GameHashtable,(handleId),(442),(((TimerGetElapsed(GameClockTimer))+.75*abilityLevel+3.25)*1.))call TriggerAddCondition(duelTrigger,Condition(function OnDuelPeriodic))call TriggerRegisterTimerEvent(duelTrigger,.05,true)call TriggerRegisterTimerEvent(duelTrigger,.01,false)call TriggerRegisterDeathEvent(duelTrigger,caster)call TriggerRegisterDeathEvent(duelTrigger,targetUnit)call TriggerRegisterUnitEvent(duelTrigger,targetUnit,EVENT_UNIT_ISSUED_TARGET_ORDER)call TriggerRegisterUnitEvent(duelTrigger,targetUnit,EVENT_UNIT_ISSUED_POINT_ORDER)call TriggerRegisterUnitEvent(duelTrigger,targetUnit,EVENT_UNIT_ISSUED_ORDER)call TriggerRegisterUnitEvent(duelTrigger,caster,EVENT_UNIT_ISSUED_TARGET_ORDER)call TriggerRegisterUnitEvent(duelTrigger,caster,EVENT_UNIT_ISSUED_POINT_ORDER)call TriggerRegisterUnitEvent(duelTrigger,caster,EVENT_UNIT_ISSUED_ORDER)set caster=nullset targetUnit=nullset duelTrigger=nullendfunctionfunction OnDuelCast takes nothing returns booleanif GetSpellAbilityId()=='A2CI' and HasAnyMarkedAbility(GetSpellTargetUnit())==false thencall CastDuel()endifreturn falseendfunctionfunction InitDuelSpell takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(t,Condition(function OnDuelCast))set t=nullset AbilityIdsToRemove[0]='A2GK'set AbilityIdsToRemove[1]='A2GJ'set AbilityIdsToRemove[2]='A2GI'