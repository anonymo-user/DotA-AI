)==0 thencall DamageTargetByType(casterUnit,targetUnit,DamageType1,abilityLevel*15*.5)endifelseif morphFormId==AbilityMorphFormA thenif GetUnitAbilityLevel(targetUnit,AbilityMorphFormA)>0 thencall UnitRemoveAbility(targetUnit,AbilityMorphFormA)call UnitRemoveAbility(targetUnit,AbilityRemovableC)endifelseif GetUnitAbilityLevel(targetUnit,AbilityMorphFormB)>0 thencall UnitRemoveAbility(targetUnit,AbilityMorphFormB)call UnitRemoveAbility(targetUnit,AbilityRemovableD)endifendifendifcall ReleaseGroupToPool(enemyGroup)set enemyGroup=nullendifset tickTrigger=nullset casterUnit=nullset targetUnit=nullreturn falseendfunctionfunction ApplyNB7AbilitySuppression takes nothing returns nothinglocal unit caster=GetTriggerUnit()local unit target=GetSpellTargetUnit()local trigger suppressTrigger=CreateTrigger()local integer triggerId=GetHandleId(suppressTrigger)local integer morphAbility=AbilityMorphFormAif GetUnitTypeId(caster)=='N0MM' thenset morphAbility=AbilityMorphFormBendifcall SetPlayerAbilityAvailable(GetOwningPlayer(target),AbilityMorphFormA,false)call SetPlayerAbilityAvailable(GetOwningPlayer(target),AbilityMorphFormB,false)call TriggerRegisterTimerEvent(suppressTrigger,.05,true)call TriggerRegisterDeathEvent(suppressTrigger,target)call TriggerAddCondition(suppressTrigger,Condition(function OnOutOfCombatAuraTick))call SaveUnitHandle(GameHashtable,(triggerId),(2),(caster))call SaveUnitHandle(GameHashtable,(triggerId),(17),(target))call SaveInteger(GameHashtable,(triggerId),(758),(morphAbility))call SaveEffectHandle(GameHashtable,(triggerId),(32),(AddSpecialEffectTarget(FluxEffectPath,target,"origin")))call TriggerEvaluate(suppressTrigger)set caster=nullset target=nullset suppressTrigger=nullendfunctionfunction OnCastNB7SuppressAbilities takes nothing returns booleanif GetSpellAbilityId()==AbilityMagnetizeId and HasAnyMarkedAbility(GetSpellTargetUnit())==false thencall ApplyNB7AbilitySuppression()endifreturn falseendfunctionfunction RegisterNB7SuppressionSpell takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(t,Condition(function OnCastNB7SuppressAbilities))set t=nullendfunctionfunction OnClonedHeroRemoveExpire takes nothing returns booleanlocal trigger expireTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(expireTrigger)local unit clonedHero=(LoadUnitHandle(GameHashtable,(triggerId),(17)))call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(expireTrigger)call FlushChildHashtable(GameHashtable,(GetHandleId(clonedHero)))call RemoveUnit(clonedHero)set expireTrigger=nullset clonedHero=nullreturn falseendfunctionfunction OnClonedHeroHideExpire takes nothing returns booleanlocal trigger expireTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(expireTrigger)local unit clonedHero=(LoadUnitHandle(GameHashtable,(triggerId),(2)))call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(expireTrigger)call FlushChildHashtable(GameHashtable,(GetHandleId(clonedHero)))call ShowUnit(clonedHero,false)set expireTrigger=nullset clonedHero=nullreturn falseendfunctionfunction OnClonedHeroLifetimeTick takes nothing returns booleanlocal trigger lifetimeTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(lifetimeTrigger)local unit caster=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local unit clonedUnit=(LoadUnitHandle(GameHashtable,(triggerId),(17)))local integer abilityLevel=GetUnitAbilityLevel(caster,AbilitySubMagnetizeId)if GetTriggerEvalCount(lifetimeTrigger)==200 or GetTriggerEventId()==EVENT_WIDGET_DEATH thencall FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(lifetimeTrigger)call KillUnit(clonedUnit)call DestroyEffect(AddSpecialEffect(FeralSpiritTargetEffectPath,GetUnitX(clonedUnit),GetUnitY(clonedUnit)))set lifetimeTrigger=CreateTrigger()set triggerId=GetHandleId(lifetimeTrigger)call SaveUnitHandle(GameHashtable,(triggerId),(2),(clonedUnit))call TriggerRegisterTimerEvent(lifetimeTrigger,0,false)call TriggerAddCondition(lifetimeTrigger,Condition(function OnClonedHeroHideExpire))set lifetimeTrigger=CreateTrigger()set triggerId=GetHandleId(lifetimeTrigger)call TriggerRegisterTimerEvent(lifetimeTrigger,3,false)call TriggerAddCondition(lifetimeTrigger,Condition(function OnClonedHeroRemoveExpire))call SaveUnitHandle(GameHashtable,(triggerId),(17),(clonedUnit))elsecall SuspendHeroXP(clonedUnit,true)call UnitModifySkillPoints(clonedUnit,-25)endifset lifetimeTrigger=nullset caster=nullset clonedUnit=nullreturn falseendfunctionfunction SpawnHeroCloneForN07 takes nothing returns nothinglocal unit heroUnit=GetTriggerUnit()local trigger lifetimeTrigger=CreateTrigger()local integer handleId=GetHandleId(lifetimeTrigger)local unit cloneUnit=CreateUnit(GetOwningPlayer(heroUnit),DummyCasterUnitType,GetUnitX(heroUnit),GetUnitY(heroUnit),0)local integer abilityLevel=GetUnitAbilityLevel(heroUnit,AbilitySubMagnetizeId)local integer index=0local item copiedItemlocal integer defaultItemType='I02M'call DestroyEffect(AddSpecialEffectTarget(FeralSpiritTargetEffectPath,cloneUnit,"chest"))if IsPlayerOnTeamZero(GetOwningPlayer(cloneUnit))==false thenset defaultItemType='I0PC'endifcall SelectUnitAddForPlayer(cloneUnit,GetOwningPlayer(heroUnit))call DisableTrigger(ToggleableTrigger)loopexitwhen index>5if UnitItemInSlot(heroUnit,index)!=null and GetItemTypeId(UnitItemInSlot(heroUnit,index))!=ItemTypeId[ItemIndexCost0Charged]and GetItemTypeId(UnitItemInSlot(heroUnit,index))!=ItemTypeId[ItemIndexCost5225]and GetItemTypeId(UnitItemInSlot(heroUnit,index))!=ItemTypeId[ItemIndexGold150]and GetItemTypeId(UnitItemInSlot(heroUnit,index))!=ItemTypeId[ItemIndexTruesight]and GetItemTypeId(UnitItemInSlot(heroUnit,index))!=ItemTypeId[ItemIndexGold100B]thenset copiedItem=CreateItem(GetItemTypeId(UnitItemInSlot(heroUnit,index)),0,0)if GetItemCharges(UnitItemInSlot(heroUnit,index))>0 thencall SetItemCharges(copiedItem,GetItemCharges(UnitItemInSlot(heroUnit,index)))endifcall UnitAddItem(cloneUnit,copiedItem)call SetItemPlayer(copiedItem,GetOwningPlayer(cloneUnit),false)if GetItemTypeId(copiedItem)==ItemTypeId[ItemIndexCost7800]or GetItemTypeId(copiedItem)==ItemTypeId[ItemIndexCost7800B]or GetItemTypeId(copiedItem)==ItemTypeId[ItemIndexCost900A]thencall SetItemDropOnDeath(copiedItem,false)endifelsecall UnitAddItem(cloneUnit,CreateItem(defaultItemType,0,0))endifset index=index+1endloopcall EnableTrigger(ToggleableTrigger)call SetHeroLevel(cloneUnit,GetHeroLevel(heroUnit),false)set index=1loopexitwhen index>GetUnitAbilityLevel(heroUnit,'Aamk')call SelectHeroSkill(cloneUnit,'Aamk')set index=index+1endloopset index=1loopexitwhen index>GetUnitAbilityLevel(heroUnit,AutoLearnSkillCodeA)call SelectHeroSkill(cloneUnit,AutoLearnSkillCodeA)set index=index+1endloopset index=1loopexitwhen index>GetUnitAbilityLevel(heroUnit,AutoLearnSkillCodeB)call SelectHeroSkill(cloneUnit,AutoLearnSkillCodeB)set index=index+1endloopset index=1loopexitwhen index>GetUnitAbilityLevel(heroUnit,AbilityMagnetizeId)call SelectHeroSkill(cloneUnit,AbilityMagnetizeId)set index=index+1endloopset index=1loopexitwhen index>GetUnitAbilityLevel(heroUnit,UltimateAbilityId)call SelectHeroSkill(cloneUnit,UltimateAbilityId)set index=index+1endloopset index=1loopexitwhen index>GetUnitAbilityLevel(heroUnit,AbilitySubMagnetizeId)call SelectHeroSkill(cloneUnit,AbilitySubMagnetizeId)set index=index+1endloopcall UnitRemoveAbility(cloneUnit,AbilitySubMagnetizeId)call UnitModifySkillPoints(cloneUnit,-25)call SuspendHeroXP(cloneUnit,true)call TriggerRegisterTimerEvent(lifetimeTrigger,.1,true)call TriggerRegisterDeathEvent(lifetimeTrigger,cloneUnit)call TriggerAddCondition(lifetimeTrigger,Condition(function OnClonedHeroLifetimeTick))call SaveUnitHandle(GameHashtable,(handleId),(2),(heroUnit))call SaveUnitHandle(GameHashtable,(handleId),(17),(cloneUnit))call SetUnitState(heroUnit,UNIT_STATE_LIFE,GetUnitState(heroUnit,UNIT_STATE_LIFE)*(1-(.45-.15*abilityLevel)))call SetUnitState(heroUnit,UNIT_STATE_MANA,GetUnitState(heroUnit,UNIT_STATE_MANA)*(1-(.45-.15*abilityLevel)))call SetUnitState(cloneUnit,UNIT_STATE_LIFE,GetUnitState(heroUnit,UNIT_STATE_LIFE))call SetUnitState(cloneUnit,UNIT_STATE_MANA,GetUnitState(heroUnit,UNIT_STATE_MANA))set heroUnit=nullset cloneUnit=nullset lifetimeTrigger=nullendfunctionfunction OnCastN07SpawnClone takes nothing returns booleanif GetSpellAbilityId()==AbilitySubMagnetizeId thencall SpawnHeroCloneForN07()endifreturn falseendfunctionfunction RegisterN07CloneSpell takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(t,Condition(function OnCastN07SpawnClone))set t=nullendfunctionfunction ToggleA2NXWhenNoEnemiesNear takes nothing returns booleanlocal trigger toggleTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(toggleTrigger)local unit caster=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local group enemyGroup=AcquireGroupFromPool()local integer abilityLevel=GetUnitAbilityLevel(caster,'A0VC')set FilterReferenceUnit_2=castercall GroupEnumUnitsInRange(enemyGroup,GetUnitX(caster),GetUnitY(caster),400+25,Condition(function FilterEnemyHeroTargetable_2))if FirstOfGroup(enemyGroup)==null thenif GetUnitAbilityLevel(caster,'A2NX')!=abilityLevel thencall AddPermanentAbility(caster,'A2NX')call SetUnitAbilityLevel(caster,'A2NX',abilityLevel)endifelseif GetUnitAbilityLevel(caster,'A2NX')>0 thencall UnitRemoveAbility(caster,'A2NX')endifendifcall ReleaseGroupToPool(enemyGroup)set caster=nullset toggleTrigger=nullset enemyGroup=nullreturn falseendfunctionfunction StartA0VCEnemyProximityMonitor takes nothing returns nothinglocal trigger monitorTrigger=CreateTr