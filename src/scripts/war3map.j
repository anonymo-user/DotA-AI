=TrackedSideUnit[playerId]local integer heroLevel=GetHeroLevel(sideUnit)local integer loopIndex=0if AiSuppressModeFlag thenreturnendifif OneTimeInitFlag_2==false thenreturnendifif PlayerStockedUnitId[playerId]=='h0D4' thenreturnendifif PlayerStockedUnitId[playerId]!=0 thencall RemoveUnitFromStock(controlUnit,PlayerStockedUnitId[playerId])endifcall AddUnitToStock(controlUnit,StockUnitIdByTier[GetStockTierIndexForLevel(heroLevel)],1,1)set PlayerStockedUnitId[playerId]=StockUnitIdByTier[GetStockTierIndexForLevel(heroLevel)]set sideUnit=nullset controlUnit=nullendfunctionfunction RefreshAllPlayersStock takes nothing returns booleanif AiSuppressModeFlag thenreturn falseendifcall RefreshPlayerStockUnit(SentinelPlayer[1])call RefreshPlayerStockUnit(SentinelPlayer[2])call RefreshPlayerStockUnit(SentinelPlayer[3])call RefreshPlayerStockUnit(SentinelPlayer[4])call RefreshPlayerStockUnit(SentinelPlayer[5])call RefreshPlayerStockUnit(ScourgePlayer[1])call RefreshPlayerStockUnit(ScourgePlayer[2])call RefreshPlayerStockUnit(ScourgePlayer[3])call RefreshPlayerStockUnit(ScourgePlayer[4])call RefreshPlayerStockUnit(ScourgePlayer[5])return falseendfunctionfunction OnSpecialStockCooldownExpire takes nothing returns booleanlocal trigger whichTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(whichTrigger)local integer playerId=(LoadInteger(GameHashtable,(handleId),(34)))local unit controlUnit=PlayerControlUnit[playerId]local unit sideUnit=TrackedSideUnit[playerId]local integer heroLevel=GetHeroLevel(sideUnit)local integer loopIndex=0call RemoveUnitFromStock(controlUnit,'h0D4')call AddUnitToStock(controlUnit,StockUnitIdByTier[GetStockTierIndexForLevel(heroLevel)],1,1)set PlayerStockedUnitId[playerId]=StockUnitIdByTier[GetStockTierIndexForLevel(heroLevel)]call FlushChildHashtable(GameHashtable,(handleId))call RecycleExpiringTrigger(whichTrigger)set whichTrigger=nullset sideUnit=nullreturn falseendfunctionfunction BeginSpe