endifendfunctionfunction PlaySoundForPlayerIfUnmuted takes sound whichSound,player whichPlayer returns nothingif GetLocalPlayer()==whichPlayer and PlayerLocalToggleB[GetPlayerId(whichPlayer)]==false thencall StartSound(whichSound)endifendfunctionfunction FilterNonEnemyHero takes nothing returns booleanreturn IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO) and IsUnitEnemy(FilterReferenceUnit_2,GetOwningPlayer(GetFilterUnit()))==falseendfunctionfunction PlaySoundToEnumUnitOwner takes nothing returns nothingcall PlaySoundForPlayerIfUnmuted(PlayerFeedbackSound,GetOwningPlayer(GetEnumUnit()))endfunctionfunction PlaySoundToAlliedHeroesInRange takes unit sourceUnit,sound whichSound,real centerX,real centerY,real radius returns nothinglocal group nearbyGroup=AcquireGroupFromPool()set FilterReferenceUnit_2=sourceUnitset PlayerFeedbackSound=whichSoundcall GroupEnumUnitsInRange(nearbyGroup,centerX,centerY,radius,Condition(function FilterNonEnemyHero))call GroupRemoveUnit(nearbyGroup,sourceUnit)call ForGroup(nearbyGroup,function PlaySoundToEnumUnitOwner)call ReleaseGroupToPool(nearbyGroup)set nearbyGroup=nullendfunctionfunction ClearTextMessagesForPlayer takes player whichPlayer returns nothingif GetLocalPlayer()==whichPlayer thencall ClearTextMessages()endifendfunctionfunction ReduceUnitLifeFloored takes unit whichUnit,real damage returns nothingcall SetUnitState(whichUnit,UNIT_STATE_LIFE,RealMax(GetUnitState(whichUnit,UNIT_STATE_LIFE)-damage,1))endfunctionfunction PollRemoveTimedAbility takes nothing returns booleanlocal trigger whichTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(whichTrigger)local unit whichUnit=(LoadUnitHandle(GameHashtable,(handleId),(17)))local integer abilityId=(LoadInteger(GameHashtable,(handleId),(59)))if whichUnit==null thencall FlushChildHashtable(GameHashtable,handleId)call RecycleExpiringTrigger(whichTrigger)return falseendifif UnitRemoveAbility(whichUnit,abilityId) or GetUnitAbilityLevel(which