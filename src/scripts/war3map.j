didateNoA04R)local unit bestUnit=nulllocal unit currentUnitset ActiveEnumGroup=enumGroupset CurrentOrderTarget=preferredUnitcall GroupEnumUnitsInRange(candidateGroup,GetUnitX(centerUnit),GetUnitY(centerUnit),500,filterCondition)set currentUnit=FirstOfGroup(candidateGroup)set bestUnit=currentUnitloopexitwhen currentUnit==nullif GetUnitState(currentUnit,UNIT_STATE_LIFE)!=GetUnitState(currentUnit,UNIT_STATE_MAX_LIFE)thenif currentUnit!=preferredUnit and IsUnitType(currentUnit,UNIT_TYPE_HERO) and IsUnitType(bestUnit,UNIT_TYPE_HERO)==false thenset bestUnit=currentUnitelseif currentUnit!=preferredUnit and GetUnitState(currentUnit,UNIT_STATE_LIFE)<GetUnitState(bestUnit,UNIT_STATE_LIFE)and IsUnitType(currentUnit,UNIT_TYPE_HERO) and IsUnitType(bestUnit,UNIT_TYPE_HERO) thenset bestUnit=currentUnitelseif currentUnit!=preferredUnit and IsUnitType(bestUnit,UNIT_TYPE_HERO)==false and GetUnitState(currentUnit,UNIT_STATE_LIFE)<GetUnitState(bestUnit,UNIT_STATE_LIFE)thenset bestUnit=currentUnitelseif currentUnit==preferredUnit thenset bestUnit=currentUnitendifendifcall GroupRemoveUnit(candidateGroup,currentUnit)set currentUnit=FirstOfGroup(candidateGroup)endloopcall ReleaseGroupToPool(candidateGroup)call DestroyBoolExpr(filterCondition)set candidateGroup=nullset filterCondition=nullset currentUnit=nullset StoredReturnUnit=bestUnitreturn StoredReturnUnitendfunctionfunction OnCastChainHealA0OR takes nothing returns nothinglocal unit casterUnit=GetTriggerUnit()local unit targetUnit=GetSpellTargetUnit()local string effectModelPath="Abilities\\Spells\\Undead\\ReplenishMana\\ReplenishManaCaster.mdl"local string attachPoint="origin"local unit array healTargetslocal integer tempIndexlocal integer loopIndex=1local integer abilityLevel=GetUnitAbilityLevel(casterUnit,'A0OR')local real healAmount=60+abilityLevel*20local group healedGroup=AcquireGroupFromPool()local integer maxBounceslocal boolean chainBroken=falseset AllyFilterExcludedUnit=casterUnitif abilityLevel==1 thenset maxBounces=3elseif abilityLevel==2 thenset maxBounces=4elseif abilityLevel==3 thenset maxBounces=5elseif abilityLevel==4 thenset maxBounces=6endifcall SetUnitState(casterUnit,UNIT_STATE_LIFE,GetUnitState(casterUnit,UNIT_STATE_LIFE)+healAmount)call ApplyV08ToEnemiesInRange(casterUnit,casterUnit,healAmount)call GroupAddUnit(healedGroup,casterUnit)call CreateTimedEffectOnUnitUntilDeath(effectModelPath,casterUnit,attachPoint,2)if targetUnit==casterUnit thenset healTargets[loopIndex]=PickLowestHealthAllyInRange(healedGroup,casterUnit,casterUnit,targetUnit)elseset healTargets[loopIndex]=targetUnitendifif healTargets[loopIndex]==null thencall ReleaseGroupToPool(healedGroup)returnendifcall SetUnitState(healTargets[loopIndex],UNIT_STATE_LIFE,GetUnitState(healTargets[loopIndex],UNIT_STATE_LIFE)+healAmount)call ApplyV08ToEnemiesInRange(casterUnit,healTargets[loopIndex],healAmount)call GroupAddUnit(healedGroup,healTargets[loopIndex])call CreateTimedEffectOnUnitUntilDeath(effectModelPath,healTargets[loopIndex],attachPoint,2)call CreateTimedLightning("SPLK",GetUnitX(casterUnit),GetUnitY(casterUnit),GetUnitX(healTargets[loopIndex]),GetUnitY(healTargets[loopIndex]),.3,.5,.9,1.,.7)set loopIndex=2loopexitwhen loopIndex>maxBounces or chainBrokenset healTargets[loopIndex]=PickLowestHealthAllyInRange(healedGroup,healTargets[loopIndex-1],casterUnit,targetUnit)if healTargets[loopIndex]==null thenset chainBroken=trueelsecall GroupAddUnit(healedGroup,healTargets[loopIndex])call CreateTimedEffectOnUnitUntilDeath(effectModelPath,healTargets[loopIndex],attachPoint,2)call SetUnitState(healTargets[loopIndex],UNIT_STATE_LIFE,GetUnitState(healTargets[loopIndex],UNIT_STATE_LIFE)+healAmount)call ApplyV08ToEnemiesInRange(casterUnit,healTargets[loopIndex],healAmount)call CreateTimedLightning("SPLK",GetUnitX(healTargets[loopIndex-1]),GetUnitY(healTargets[loopIndex-1]),GetUnitX(healTargets[loopIndex]),GetUnitY(healTargets[loopIndex]),.3,.5,.9,1.,.7)set loopIndex=loopIndex+1endifendlooploopset loopIndex=loopIndex-1set healTargets[loopIndex]=nullexitwhen loopIndex<2endloopcall ReleaseGroupToPool(healedGroup)set casterUnit=nullset targetUnit=nullset healedGroup=nullendfunctionfunction RegisterChainHealA0OR takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(t,Condition(function FilterCastA0OR))call TriggerAddAction(t,function OnCastChainHealA0OR)set t=nullendfunctionfunction FilterSpellA2X6UnmarkedTarget takes nothing returns booleanreturn GetSpellAbilityId()==('A2X6')and HasAnyMarkedAbility(GetSpellTargetUnit())==falseendfunctionfunction DummyCastAbilityA0NJOnUnit takes unit casterUnit,unit targetUnit,integer abilityLevel returns nothinglocal unit dummyUnit=CreateUnit(GetOwningPlayer(casterUnit),'e00E',GetUnitX(targetUnit),GetUnitY(targetUnit),0)call AddPermanentAbility(dummyUnit,'A0NJ')call SetUnitAbilityLevel(dummyUnit,'A0NJ',abilityLevel)call IssueTargetOrderById(dummyUnit,852075,targetUnit)set dummyUnit=nullendfunctionfunction OnSpellA2X6PeriodicStrikeTick takes nothing returns nothinglocal trigger tickTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(tickTrigger)local unit casterUnit=(LoadUnitHandle(GameHashtable,(handleId),(2)))local unit targetUnit=(LoadUnitHandle(GameHashtable,(handleId),(17)))local integer abilityLevel=GetUnitAbilityLevel(casterUnit,('A2X6'))local integer tickCount=GetTriggerExecCount(tickTrigger)local real damageAmount=8+6*abilityLevellocal unit dummyUnit=(LoadUnitHandle(GameHashtable,(handleId),(19)))if abilityLevel==1 thencall AddPermanentAbility(targetUnit,('A0OW'))if tickCount==1 thencall DummyCastAbilityA0NJOnUnit(casterUnit,targetUnit,1)endifif tickCount==2 thencall DummyCastAbilityA0NJOnUnit(casterUnit,targetUnit,1)endifif tickCount>2 thencall DamageTargetByType(dummyUnit,targetUnit,2,damageAmount)endifif tickCount==8 thencall UnitRemoveAbility(targetUnit,('A0OW'))call FlushChildHashtable(GameHashtable,(handleId))call RecycleExpiringTrigger(tickTrigger)endifendifif abilityLevel==2 thencall AddPermanentAbility(targetUnit,('A0OW'))if tickCount==1 thencall DummyCastAbilityA0NJOnUnit(casterUnit,targetUnit,1)endifif tickCount==2 thencall DummyCastAbilityA0NJOnUnit(casterUnit,targetUnit,2)endifif tickCount>2 thencall DamageTargetByType(dummyUnit,targetUnit,2,damageAmount)endifif tickCount==8 thencall UnitRemoveAbility(targetUnit,('A0OW'))call FlushChildHashtable(GameHashtable,(handleId))call RecycleExpiringTrigger(tickTrigger)endifendifif abilityLevel==3 thencall AddPermanentAbility(targetUnit,('A0OW'))if tickCount==1 thencall DummyCastAbilityA0NJOnUnit(casterUnit,targetUnit,2)endifif tickCount==2 thencall DummyCastAbilityA0NJOnUnit(casterUnit,targetUnit,3)endifif tickCount>2 thencall DamageTargetByType(dummyUnit,targetUnit,2,damageAmount)endifif tickCount==8 thencall UnitRemoveAbility(targetUnit,('A0OW'))call FlushChildHashtable(GameHashtable,(handleId))call RecycleExpiringTrigger(tickTrigger)endifendifif abilityLevel==4 thencall AddPermanentAbility(targetUnit,('A0OW'))if tickCount==1 thencall DummyCastAbilityA0NJOnUnit(casterUnit,targetUnit,2)endifif tickCount==2 thencall CreateDummyCastScaledAbilityOnTarget(casterUnit,targetUnit,1.0)endifif tickCount>2 thencall DamageTargetByType(dummyUnit,targetUnit,2,damageAmount)endifif tickCount==8 thencall UnitRemoveAbility(targetUnit,('A0OW'))call FlushChildHashtable(GameHashtable,(handleId))call RecycleExpiringTrigger(tickTrigger)endifendifset dummyUnit=nullendfunctionfunction StartSpellA2X6OnProjectileImpact takes nothing returns nothinglocal trigger strikeTrigger=CreateTrigger()local integer triggerId=GetHandleId(strikeTrigger)local unit caster=FilterReferenceUnit_2local unit targetUnit=FilterReferenceUnitBlocal unit dummyUnit=CreateUnit(GetOwningPlayer(caster