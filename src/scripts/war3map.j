yLevel(caster,'A0CC')local real convertAmount=80+40*abilityLevelif abilityLevel==0 thenset abilityLevel=GetUnitAbilityLevel(caster,'A02Z')set convertAmount=120+60*abilityLevelendifset convertAmount=convertAmount*.25if GetUnitAbilityLevel(caster,'Bdcl')==0 or(GetTriggerEventId()==EVENT_UNIT_SPELL_ENDCAST and(GetSpellAbilityId()=='A0CC' or GetSpellAbilityId()=='A02Z'))thencall FlushChildHashtable(GameHashtable,(handleId))call RecycleExpiringTrigger(tickTrigger)elseif GetTriggerEventId()!=EVENT_UNIT_SPELL_ENDCAST thenif GetUnitState(caster,UNIT_STATE_LIFE)+convertAmount>=GetUnitState(caster,UNIT_STATE_MAX_LIFE)thencall SetUnitState(caster,UNIT_STATE_MANA,GetUnitState(caster,UNIT_STATE_MANA)+convertAmount+GetUnitState(caster,UNIT_STATE_LIFE)-GetUnitState(caster,UNIT_STATE_MAX_LIFE))endifendifset tickTrigger=nullset caster=nullset targetUnit=nullreturn falseendfunctionfunction StartLifeToManaConvert takes nothing returns nothinglocal unit casterUnit=GetTriggerUnit()local unit targetUnit=GetSpellTargetUnit()local trigger convertTrigger=CreateTrigger()local integer triggerId=GetHandleId(convertTrigger)call TriggerRegisterTimerEvent(convertTrigger,.25,true)call TriggerRegisterUnitEvent(convertTrigger,casterUnit,EVENT_UNIT_SPELL_ENDCAST)call TriggerAddCondition(convertTrigger,Condition(function OnLifeToManaConvertTick))call SaveUnitHandle(GameHashtable,(triggerId),(2),(casterUnit))call SaveUnitHandle(GameHashtable,(triggerId),(17),(targetUnit))set casterUnit=nullset targetUnit=nullset convertTrigger=nullendfunctionfunction OnCastLifeToManaConvert takes nothing returns booleanif(GetSpellAbilityId()=='A0CC' or GetSpellAbilityId()=='A02Z')and IsUnitType(GetSpellTargetUnit(),UNIT_TYPE_HERO)thencall StartLifeToManaConvert()endifreturn falseendfunctionfunction RegisterLifeToManaConvert takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(t,Condition(function OnCastLifeToManaConvert))set t=nullendfunctionfunction DealLightningRingDamage takes unit sourceUnit,unit targetUnit returns nothinglocal real baseDamage=20+40*SpellAbilityLevellocal real maxDamage=70+30*SpellAbilityLevellocal real finalDamage=(baseDamage+maxDamage*SpellDistanceParam/700)*.5call DamageTargetByType(sourceUnit,targetUnit,DamageType1,finalDamage)call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\ChimaeraLightningMissile\\ChimaeraLightningMissile.mdl",targetUnit,"chest"))endfunctionfunction EnumLightningRingDamage takes nothing returns nothinglocal unit targetUnit=GetEnumUnit()local group hitGroup=TempUnitGrouplocal unit casterUnit=SpellCastingUnitif IsUnitInGroup(targetUnit,hitGroup)==false thencall GroupAddUnit(hitGroup,targetUnit)call DealLightningRingDamage(casterUnit,targetUnit)endifset targetUnit=nullset hitGroup=nullset casterUnit=nullendfunctionfunction OnLightningRingA1E7Tick takes nothing returns booleanlocal trigger whichTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(whichTrigger)local unit casterUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local unit dummyUnit=(LoadUnitHandle(GameHashtable,(triggerId),(19)))local group hitGroup=(LoadGroupHandle(GameHashtable,(triggerId),(133)))local effect ringEffectlocal integer tickCount=GetTriggerEvalCount(whichTrigger)local real ringXlocal real casterX=GetUnitX(casterUnit)local real ringYlocal real casterY=GetUnitY(casterUnit)local integer indexlocal integer ringRadiuslocal group tempGroup=AcquireGroupFromPool()call SetUnitX(dummyUnit,GetUnitX(casterUnit))call SetUnitY(dummyUnit,GetUnitY(casterUnit))set TempUnitGroup=hitGroupset SpellCastingUnit=casterUnitset SpellAbilityLevel=GetUnitAbilityLevel(casterUnit,'A1E7')if tickCount>20 thenset ringRadius=21*36+(20-tickCount)*36set SpellDistanceParam=ringRadiusset index=0loopexitwhen index>36set ringX=casterX+ringRadius*Cos(360*index/ 36*bj_DEGTORAD)set ringY=casterY+ringRadius*Sin(360*index/ 36*bj_DEGTORAD)set FilterReferenceUnit_2=casterUnitcall GroupEnumUnitsInRange(tempGroup,ringX,ringY,100,Condition(function FilterEnemyNonStructure))call ForGroup(tempGroup,function EnumLightningRingDamage)set index=index+1endloopelseset ringRadius=tickCount*36set SpellDistanceParam=ringRadiusset index=0loopexitwhen index>36set ringX=casterX+ringRadius*Cos(360*index/ 36*bj_DEGTORAD)set ringY=casterY+ringRadius*Sin(360*index/ 36*bj_DEGTORAD)set FilterReferenceUnit_2=casterUnitcall GroupEnumUnitsInRange(tempGroup,ringX,ringY,100,Condition(function FilterEnemyNonStructure))call ForGroup(tempGroup,function EnumLightningRingDamage)set index=index+1endloopendifcall ReleaseGroupToPool(tempGroup)if tickCount==40 thencall KillUnit(dummyUnit)call ReleaseGroupToPool(hitGroup)call DestroyEffect((LoadEffectHandle(GameHashtable,(triggerId),(32))))call FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(whichTrigger)elseif tickCount==20 thencall GroupClear(hitGroup)set ringEffect=nullendifset whichTrigger=nullset dummyUnit=nullset hitGroup=nullset casterUnit=nullset tempGroup=nullreturn falseendfunctionfunction StartLightningRingA1E7 takes nothing returns nothinglocal unit casterUnit=GetTriggerUnit()local real casterX=GetUnitX(casterUnit)local real casterY=GetUnitY(casterUnit)local unit ringUnit=CreateUnit(GetOwningPlayer(casterUnit),'h092',casterX,casterY,0)local integer index=0local group hitGroup=AcquireGroupFromPool()local trigger tickTrigger=CreateTrigger()local integer handleId=GetHandleId(tickTrigger)call SaveEffectHandle(GameHashtable,(handleId),(32),(AddSpecialEffectTarget("effects\\Lightning_Ball_Tail_FX.mdx",casterUnit,"origin")))call SaveGroupHandle(GameHashtable,(handleId),(133),(hitGroup))call SaveUnitHandle(GameHashtable,(handleId),(2),(casterUnit))call SaveUnitHandle(GameHashtable,(handleId),(19),(ringUnit))call TriggerRegisterTimerEvent(tickTrigger,.06,true)call TriggerAddCondition(tickTrigger,Condition(function OnLightningRingA1E7Tick))set tickTrigger=nullset ringUnit=nullset casterUnit=nullset hitGroup=nullendfunctionfunction OnCastAbilityA1E7 takes nothing returns booleanif GetSpellAbilityId()=='A1E7' thencall StartLightningRingA1E7()endifreturn falseendfunctionfunction RegisterAbilityA1E7Cast takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(t,Condition(function OnCastAbilityA1E7))set t=nullendfunctionfunction IsSpellReflectable takes integer abilityId returns booleanreturn abilityId!='A09V' and abilityId!='A026' and abilityId!='A0LZ' and abilityId!='A0QN' and abilityId!='A0OI' and abilityId!='A0DY' and abilityId!='A1WB' and abilityId!='AHfa'endfunctionfunction CastReflectCounterDummies takes unit casterUnit,unit positionUnit,unit targetUnit,integer abilityLevel returns nothinglocal unit dummyUnit=CreateUnit(GetOwningPlayer(casterUnit),'e00E',GetUnitX(positionUnit),GetUnitY(positionUnit),0)call AddPermanentAbility(dummyUnit,'A1AK')call SetUnitAbilityLevel(dummyUnit,'A1AK',abilityLevel)call IssueTargetOrderById(dummyUnit,852119,targetUnit)call AddPermanentAbility(dummyUnit,'A18D')call SetUnitAbilityLevel(dummyUnit,'A18D',abilityLevel)call IssueTargetOrderById(dummyUnit,852111,targetUnit)set dummyUnit=nullendfunctionfunction OnSpellReflectTargeted takes nothing returns booleanlocal trigger reflectTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(reflectTrigger)local unit reflectingUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local integer abilityLevelif GetSpellTargetUnit()==reflectingUnit and IsSpellReflectable(GetSpellAbilityId()) and IsUnitAlly(GetTriggerUnit(),GetOwningPlayer(reflectingUnit))==false and IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO) thenset abilityLevel=GetUnitAbilityLevel(reflectingUnit,'A1E6')call CastReflectCounterDummies(reflectingUnit,reflectingUnit,GetTriggerUnit(),abilityLevel)endifset reflectTrigger=nullset reflectingUnit=nullreturn falseendfunctionfunction RegisterSpellReflectWatcher takes unit reflectingUnit,boolean enableFlag returns nothinglocal trigger reflectTrigger=CreateTrigger()local integer triggerId=GetHandleId(reflectTrigger)call RegisterPlayerUnitEventAllPlayers(reflectTrigger,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(reflectTrigger,Condition(function OnSpellReflectTargeted))call SaveUnitHandle(GameHashtable,(triggerId),(2),(reflectingUnit))set reflectingUnit=nullset reflectTrigger=nullendfunctionfunction OnLearnReflectSkill takes nothing returns booleanif GetLearnedSkill()=='A1E6' and GetUnitAbilityLevel(GetTriggerUnit(),'A1E6')==1 and IsUnitIllusion(GetTriggerUnit())==false thencall RegisterSpellReflectWatcher(GetTriggerUnit(),false)endifreturn falseendfunctionfunction RegisterReflectSkillLearn takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_HERO_SKILL)call TriggerAddCondition(t,Condition(function OnLearnReflectSkill))set t=nullendfunctionfunction ApplyW0AbilityBitmask takes unit whichUnit,integer mask returns nothinglocal integer array bitslocal integer remaining=masklocal integer quotient=1local integer bitIndex=0local integer bitCountif whichUnit==null or GetUnitTypeId(whichUnit)<1 thenreturnendifif mask<1 thencall UnitRemoveAbility(whichUnit,RemovableAbilityId_2[0])call UnitRemoveAbility(whichUnit,RemovableAbilityId_2[1])call UnitRemoveAbility(whichUnit,RemovableAbilityId_2[2])call UnitRemoveAbility(whichUnit,RemovableAbilityId_2[3])call UnitRemoveAbility(whichUnit,RemovableAbilityId_2[4])call UnitRemoveAbility(whichUnit,RemovableAbilityId_2[5])call UnitRemoveAbility(whichUnit,RemovableAbilityId_2[6])call UnitRemoveAbility(whichUnit,RemovableAbilityId_2[7])returnendifif IsUnitDeadOrInvalid(whichUnit) thenreturnendifloopexitwhen quotient==0set quotient=remaining/ 2set bits[bitIndex]=remaining-quotient*2set remaining=quotientset bitIndex=bitIndex+1endloopset bitCount=bitIndexset bitIndex=0loopexitwhen bitIndex>bitCountif bits[bitIndex]==1 thencall AddPermanentAbility(whichUnit,RemovableAbilityId_2[bitIndex])elsecall UnitRemoveAbility(whichUnit,RemovableAbilityId_2[bitIndex])endifset bitIndex=bitIndex+1endloopendfunctionfunction ApplyZ0AbilityBitmask takes unit whichUnit,integer mask returns nothinglocal integer array bitslocal integer remaining=masklocal integer quotient=1local integer bitIndex=0local integer bitCountif whichUnit==null or GetUnitTypeId(whichUnit)<1 thenreturnendifif mask<1 thencall UnitRemoveAbility(whichUnit,RemovableAbilityIdAlt[0])call UnitRemoveAbility(whichUnit,RemovableAbilityIdAlt[1])call UnitRemoveAbility(whichUnit,RemovableAbilityIdAlt[2])call UnitRemoveAbility(whichUnit,RemovableAbilityIdAlt[3])call UnitRemoveAbility(whichUnit,RemovableAbilityIdAlt[4])call UnitRemoveAbility(whichUnit,RemovableAbilityIdAlt[5])call UnitRemoveAbility(whichUnit,RemovableAbilityIdAlt[6])call UnitRemoveAbility(whichUnit,RemovableAbilityIdAlt[7])returnendifif IsUnitDeadOrInvalid(whichUnit) thenreturnendifloopexitwhen quotient==0set quotient=remaining/ 2set bits[bitIndex]=remaining-quotient*2set remaining=quotientset bitIndex=bitIndex+1endloopset bitCount=bitIndexset bitIndex=0loopexitwhen bitIndex>bitCountif bits[bitIndex]==1 thencall AddPermanentAbility(whichUnit,RemovableAbilityIdAlt[bitIndex])elsecall UnitRemoveAbility(whichUnit,RemovableAbilityIdAlt[bitIndex])endifset bitIndex=bitIndex+1endloopendfunctionfunction OnTetherCleanupExpire takes nothing returns booleanlocal trigger expireTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(expireTrigger)local unit sourceUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local unit targetUnit=(LoadUnitHandle(GameHashtable,(triggerId),(17)))if GetTriggerEventId()==EVENT_UNIT_DEATH thenif GetTriggerUnit()==sourceUnit thencall ApplyW0AbilityBitmask(sourceUnit,0)call SaveUnitHandle(GameHashtable,(triggerId),(2),(null))elsecall ApplyZ0AbilityBitmask(targetUnit,0)call SaveUnitHandle(GameHashtable,(triggerId),(17),(null))endifelseif sourceUnit!=null thencall ApplyW0AbilityBitmask(sourceUnit,0)endifif targetUnit!=null thencall ApplyZ0AbilityBitmask(targetUnit,0)endifcall FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(expireTrigger)endifset expireTrigger=nullset sourceUnit=nullset targetUnit=nullreturn falseendfunctionfunction ScheduleTetherAbilityCleanup takes unit firstUnit,unit secondUnit,unit deadUnit returns nothinglocal trigger cleanupTrigger=CreateTrigger()local integer triggerId=GetHandleId(cleanupTrigger)if deadUnit==null thencall TriggerRegisterUnitEvent(cleanupTrigger,firstUnit,EVENT_UNIT_DEATH)call TriggerRegisterUnitEvent(cleanupTrigger,secondUnit,EVENT_UNIT_DEATH)call SaveUnitHandle(GameHashtable,(triggerId),(2),(firstUnit))call SaveUnitHandle(GameHashtable,(triggerId),(17),(secondUnit))elseif deadUnit==secondUnit thencall ApplyZ0AbilityBitmask(secondUnit,0)call TriggerRegisterUnitEvent(cleanupTrigger,firstUnit,EVENT_UNIT_DEATH)call SaveUnitHandle(GameHashtable,(triggerId),(2),(firstUnit))call SaveUnitHandle(GameHashtable,(triggerId),(17),(null))elsecall ApplyW0AbilityBitmask(firstUnit,0)call TriggerRegisterUnitEvent(cleanupTrigger,secondUnit,EVENT_UNIT_DEATH)call SaveUnitHandle(GameHashtable,(triggerId),(2),(null))call SaveUnitHandle(GameHashtable,(triggerId),(17),(secondUnit))endifcall TriggerRegisterTimerEvent(cleanupTrigger,18,false)call TriggerAddCondition(cleanupTrigger,Condition(function OnTetherCleanupExpire))set cleanupTrigger=nullendfunctionfunction OnTetherLinkTick takes nothing returns booleanlocal trigger tickTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(tickTrigger)local unit casterUnit=(LoadUnitHandle(GameHashtable,(handleId),(2)))local unit targetUnit=(LoadUnitHandle(GameHashtable,(handleId),(17)))local lightning tetherLightning=(LoadLightningHandle(GameHashtable,(handleId),(196)))local integer abilityLevel=(LoadInteger(GameHashtable,(handleId),(5)))local integer tickCount=GetTriggerEvalCount(tickTrigger)local unit dummyUnit=(LoadUnitHandle(GameHashtable,(handleId),(19)))call MoveLightning(tetherLightning,true,GetUnitX(casterUnit),GetUnitY(casterUnit),GetUnitX(targetUnit),GetUnitY(targetUnit))call SetUnitX(dummyUnit,GetUnitX(targetUnit))call SetUnitY(dummyUnit,GetUnitY(targetUnit))if DistanceBetweenCoords(GetUnitX(casterUnit),GetUnitY(casterUnit),GetUnitX(targetUnit),GetUnitY(targetUnit))>700 or GetTriggerEventId()==EVENT_UNIT_DEATH thencall DestroyLightning(tetherLightning)call KillUnit(dummyUnit)if GetTriggerEventId()==EVENT_UNIT_DEATH thencall ScheduleTetherAbilityCleanup(casterUnit,targetUnit,GetTriggerUnit())elsecall ScheduleTetherAbilityCleanup(casterUnit,targetUnit,null)endifcall FlushChildHashtable(GameHashtable,handleId)call RecycleExpiringTrigger(tickTrigger)elseif tickCount>160 thencall DestroyLightning(tetherLightning)call KillUnit(dummyUnit)call ScheduleTetherAbilityCleanup(casterUnit,targetUnit,null)call FlushChildHashtable(GameHashtable,handleId)call RecycleExpiringTrigger(tickTrigger)elseif ModuloInteger(tickCount,20)==0 or tickCount==1 thencall ApplyW0AbilityBitmask(casterUnit,(abilityLevel*7)*R2I(tickCount/ 20))call ApplyZ0AbilityBitmask(targetUnit,(abilityLevel*7)*R2I(tickCount/ 20))endifset tickTrigger=nullset casterUnit=nullset targetUnit=nullset tetherLightning=nullset dummyUnit=nullreturn falseendfunctionfunction BeginTetherLink takes unit caster,unit targetUnit,lightning tetherLightning,unit dummyUnit returns nothinglocal trigger tickTrigger=CreateTrigger()local integer handleId=GetHandleId(tickTrigger)local integer abilityLevel=GetUnitAbilityLevel(caster,'A1DP')call TriggerRegisterTimerEvent(tickTrigger,.05,true)call TriggerRegisterUnitEvent(tickTrigger,caster,EVENT_UNIT_DEATH)call TriggerRegisterUnitEvent(tickTrigger,targetUnit,EVENT_UNIT_DEATH)call TriggerAddCondition(tickTrigger,Condition(function OnTetherLinkTick))call SaveUnitHandle(GameHashtable,(handleId),(2),(caster))call SaveUnitHandle(GameHashtable,(handleId),(17),(targetUnit))call SaveInteger(GameHashtable,(handleId),(5),(abilityLevel))call SaveLightningHandle(GameHashtable,(handleId),(196),(tetherLightning))call SaveUnitHandle(GameHashtable,(handleId),(19),(dummyUnit))set tickTrigger=nullendfunctionfunction OnTetherProjectileTick takes nothing returns booleanlocal trigger castTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(castTrigger)local unit casterUnit=(LoadUnitHandle(GameHashtable,(handleId),(2)))local lightning tetherLightning=(LoadLightningHandle(GameHashtable,(handleId),(196)))local unit projectileUnit=(LoadUnitHandle(GameHashtable,(handleId),(19)))local real casterX=GetUnitX(casterUnit)local real casterY=GetUnitY(casterUnit)local real projectileX=(LoadReal(GameHashtable,(handleId),(64)))local real projectileY=(LoadReal(GameHashtable,(handleId),(65)))local real angle=(LoadReal(GameHashtable,(handleId),(137)))local unit targetUnit=nulllocal group enumGroup=AcquireGroupFromPool()if casterUnit==null thencall ReleaseGroupToPool(enumGroup)call FlushChildHashtable(GameHashtable,handleId)call RecycleExpiringTrigger(castTrigger)return falseendifset projectileX=ClampXToPlayableArea(projectileX+25*Cos(angle))set projectileY=ClampYToPlayableArea(projectileY+25*Sin(angle))call SaveReal(GameHashtable,(handleId),(64),((projectileX)*1.0))call SaveReal(GameHashtable,(handleId),(65),((projectileY)*1.0))call MoveLightning(tetherLightning,true,casterX,casterY,projectileX,projectileY)call SetUnitX(projectileUnit,projectileX)call SetUnitY(projectileUnit,projectileY)set FilterReferenceUnit_2=casterUnitcall GroupEnumUnitsInRange(enumGroup,projectileX,projectileY,225,Condition(function FilterEnemyHeroTargetable))set targetUnit=FirstOfGroup(enumGroup)call ReleaseGroupToPool(enumGroup)if targetUnit!=null thencall BeginTetherLink(casterUnit,targetUnit,tetherLightning,projectileUnit)call FlushChildHashtable(GameHashtable,handleId)call RecycleExpiringTrigger(castTrigger)elseif GetTriggerEvalCount(castTrigger)>25 or GetTriggerEventId()==EVENT_UNIT_DEATH thencall DestroyLightning(tetherLightning)call KillUnit(projectileUnit)call FlushChildHashtable(GameHashtable,handleId)call RecycleExpiringTrigger(castTrigger)endifset castTrigger=nullset casterUnit=nullset tetherLightning=nullset targetUnit=nullset enumGroup=nullset projectileUnit=nullreturn falseendfunctionfunction CastTetherSpell takes nothing returns nothinglocal unit caster=GetTriggerUnit()local unit targetUnit=GetSpellTargetUnit()local trigger tickTriggerlocal integer handleIdlocal location targetLoclocal lightning tetherLightning=AddLightning("CLSB",true,GetUnitX(caster),GetUnitY(caster),GetUnitX(caster),GetUnitY(caster))local unit dummyUnit=CreateUnit(GetOwningPlayer(caster),'h088',GetUnitX(caster),GetUnitY(caster),0)call SetLightningColor(tetherLightning,.3,.5,1,1)if targetUnit==null thenset targetLoc=GetSpellTargetLoc()set tickTrigger=CreateTrigger()set handleId=GetHandleId(tickTrigger)call TriggerRegisterTimerEvent(tickTrigger,.02,true)call TriggerRegisterUnitEvent(tickTrigger,caster,EVENT_UNIT_DEATH)call TriggerAddCondition(tickTrigger,Condition(function OnTetherProjectileTick))call SaveUnitHandle(GameHashtable,(handleId),(2),(caster))call SaveLightningHandle(GameHashtable,(handleId),(196),(tetherLightning))call SaveUnitHandle(GameHashtable,(handleId),(19),(dummyUnit))call SaveReal(GameHashtable,(handleId),(137),((Atan2(GetLocationY(targetLoc)-GetUnitY(caster),GetLocationX(targetLoc)-GetUnitX(caster)))*1.0))call SaveReal(GameHashtable,(handleId),(64),((GetUnitX(caster))*1.0))call SaveReal(GameHashtable,(handleId),(65),((GetUnitY(caster))*1.0))call RemoveLocation(targetLoc)set targetLoc=nullset tickTrigger=nullelsecall BeginTetherLink(caster,targetUnit,tetherLightning,dummyUnit)endifset targetUnit=nullset caster=nullset targetLoc=nullset tickTrigger=nullset dummyUnit=nullendfunctionfunction OnCastAbilityA1DP takes nothing returns booleanif GetSpellAbilityId()=='A1DP' and HasAnyMarkedAbility(GetSpellTargetUnit())==false thencall CastTetherSpell()endifreturn falseendfunctionfunction RegisterTetherSpell takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(t,Condition(function OnCastAbilityA1DP))set t=nullset RemovableAbilityId_2[0]='A1DV'set RemovableAbilityId_2[1]='A1DQ'set RemovableAbilityId_2[2]='A1DR'set RemovableAbilityId_2[3]='A1DS'set RemovableAbilityId_2[4]='A1DT'set RemovableAbilityId_2[5]='A1DU'set RemovableAbilityId_2[6]='A1DW'set RemovableAbilityId_2[7]='A1DX'set RemovableAbilityIdAlt[0]='A1E4'set RemovableAbilityIdAlt[1]='A1E3'set RemovableAbilityIdAlt[2]='A1E2'set RemovableAbilityIdAlt[3]='A1E1'set RemovableAbilityIdAlt[4]='A1E0'set RemovableAbilityIdAlt[5]='A1E5'set RemovableAbilityIdAlt[6]='A1DZ'set RemovableAbilityIdAlt[7]='A1DY'endfunctionfunction ClearTrackedUnitsN1Abilities takes integer parentKey returns nothinglocal integer index=1local integer count=(LoadInteger(GameHashtable,(parentKey),(136)))local unit trackedUnitlocal integer unitIndexif count==0 thenreturnendifloopexitwhen index>countset unitIndex=(LoadInteger(GameHashtable,(parentKey),(2200+index)))set trackedUnit=UnitByIndex(unitIndex)call ClearUnitHandleSlot(unitIndex)if trackedUnit!=null thencall UnitRemoveAbility(trackedUnit,RemovableAbilityIds[0])call UnitRemoveAbility(trackedUnit,RemovableAbilityIds[1])call UnitRemoveAbility(trackedUnit,RemovableAbilityIds[2])call UnitRemoveAbility(trackedUnit,RemovableAbilityIds[3])call UnitRemoveAbility(trackedUnit,RemovableAbilityIds[4])call UnitRemoveAbility(trackedUnit,RemovableAbilityIds[5])endifset index=index+1endloopset trackedUnit=nullendfunctionfunction TrackMarkedUnit takes unit markedUnit,integer ownerId returns nothinglocal integer unitSlot=RegisterUnitHandleSlot(markedUnit)local integer markedCount=(LoadInteger(GameHashtable,(ownerId),(136)))set markedCount=markedCount+1call SaveInteger(GameHashtable,(ownerId),(136),(markedCount))call SaveInteger(GameHashtable,(ownerId),(2200+markedCount),(unitSlot))endfunctionfunction GetN1AbilityBitmask takes unit u returns integerreturn GetUnitAbilityLevel(u,RemovableAbilityIds[0])*1+GetUnitAbilityLevel(u,RemovableAbilityIds[1])*2+GetUnitAbilityLevel(u,RemovableAbilityIds[2])*4+GetUnitAbilityLevel(u,RemovableAbilityIds[3])*8+GetUnitAbilityLevel(u,RemovableAbilityIds[4])*16endfunctionfunction ApplyN1AbilityBitmask takes unit whichUnit,integer mask returns nothinglocal integer array bitslocal integer remaining=masklocal integer quotient=1local integer bitIndex=0local integer bitCountif whichUnit==null or IsUnitDeadOrInvalid(whichUnit) thenreturnendifif mask<1 thencall UnitRemoveAbility(whichUnit,RemovableAbilityIds[0])call UnitRemoveAbility(whichUnit,RemovableAbilityIds[1])call UnitRemoveAbility(whichUnit,RemovableAbilityIds[2])call UnitRemoveAbility(whichUnit,RemovableAbilityIds[3])call UnitRemoveAbility(whichUnit,RemovableAbilityIds[4])call UnitRemoveAbility(whichUnit,RemovableAbilityIds[5])returnendifloopexitwhen quotient==0set quotient=remaining/ 2set bits[bitIndex]=remaining-quotient*2set remaining=quotientset bitIndex=bitIndex+1endloopset bitCount=bitIndexset bitIndex=0loopexitwhen bitIndex>bitCountif bits[bitIndex]==1 thencall AddPermanentAbility(whichUnit,RemovableAbilityIds[bitIndex])elsecall UnitRemoveAbility(whichUnit,RemovableAbilityIds[bitIndex])endifset bitIndex=bitIndex+1endloopendfunctionfunction AddN1DebuffStack takes unit whichUnit,integer stackAmount returns nothingif IsUnitType(whichUnit,UNIT_TYPE_STRUCTURE)==false thencall ApplyN1AbilityBitmask(whichUnit,stackAmount+GetN1AbilityBitmask(whichUnit))call TrackMarkedUnit(whichUnit,MarkedUnitTrackKey)endifendfunctionfunction ExecuteN1DebuffStrike takes unit casterUnit,unit dummyCaster,unit targetUnit,integer abilityLevel returns nothingcall IssueTargetOrderById(dummyCaster,852119,targetUnit)call ScheduleDelayedAction(casterUnit,targetUnit,DamageType2,(50+25*abilityLevel)/2.,.3)call AddN1DebuffStack(targetUnit,1)endfunctionfunction FilterLowestLifeEnemy takes nothing returns booleanif(IsUnitVisible(GetFilterUnit(),GetOwningPlayer(FilterReferenceUnit_2))and IsUnitEnemy(FilterReferenceUnit_2,GetOwningPlayer(GetFilterUnit()))and(GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and IsUnitDeadOrInvalid(GetFilterUnit())==false))and GetUnitTypeId(GetFilterUnit())!='n00L' thenif GetUnitState(GetFilterUnit(),UNIT_STATE_LIFE)<LowestUnitLifeFound thenset LowestUnitLifeFound=GetUnitState(GetFilterUnit(),UNIT_STATE_LIFE)set FilterMatchedUnit=GetFilterUnit()endifendifreturn falseendfunctionfunction FilterTrackLowestLifeVisibleEnemy takes nothing returns booleanif(IsUnitVisible(GetFilterUnit(),GetOwningPlayer(FilterReferenceUnit_2))and IsUnitEnemy(FilterReferenceUnit_2,GetOwningPlayer(GetFilterUnit()))and(GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and IsUnitDeadOrInvalid(GetFilterUnit())==false))and GetUnitTypeId(GetFilterUnit())!='emow' and GetUnitTypeId(GetFilterUnit())!='uzig' and GetUnitTypeId(GetFilterUnit())!='n00L' thenif GetUnitState(GetFilterUnit(),UNIT_STATE_LIFE)<LowestUnitLifeFound thenset LowestUnitLifeFound=GetUnitState(GetFilterUnit(),UNIT_STATE_LIFE)set FilterMatchedUnit=GetFilterUnit()endifendifreturn falseendfunctionfunction TargetLowestLifeEnemyInRange takes unit casterUnit,unit dummyCaster,integer abilityLevel returns nothinglocal group enumGroup=AcquireGroupFromPool()set FilterMatchedUnit=nullset LowestUnitLifeFound=999999set FilterReferenceUnit_2=casterUnitif GetUnitAbilityLevel(casterUnit,'A1UV')>0 thencall GroupEnumUnitsInRange(enumGroup,GetUnitX(casterUnit),GetUnitY(casterUnit),525,Condition(function FilterTrackLowestLifeVisibleEnemy))elsecall GroupEnumUnitsInRange(enumGroup,GetUnitX(casterUnit),GetUnitY(casterUnit),525,Condition(function FilterLowestLifeEnemy))endifcall ReleaseGroupToPool(enumGroup)if FilterMatchedUnit!=null thencall ExecuteN1DebuffStrike(casterUnit,dummyCaster,FilterMatchedUnit,abilityLevel)endifset enumGroup=nullendfunctionfunction OnFollowerAutoStrikeTick takes nothing returns booleanlocal trigger tickTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(tickTrigger)local unit caster=(LoadUnitHandle(GameHashtable,(handleId),(2)))local unit followerUnit=(LoadUnitHandle(GameHashtable,(handleId),(19)))local integer abilityLevel=(LoadInteger(GameHashtable,(handleId),(5)))local integer tickCount=GetTriggerEvalCount(tickTrigger)local real strikeIntervalif GetTriggerEventId()==EVENT_UNIT_DEATH thencall ClearTrackedUnitsN1Abilities(handleId)call FlushChildHashtable(GameHashtable,handleId)call RecycleExpiringTrigger(tickTrigger)if GetTriggerUnit()==caster thencall KillUnit(followerUnit)endifelseif GetUnitAbilityLevel(caster,'A1UV')>0 thenif abilityLevel==1 thenset strikeInterval=.55elseif abilityLevel==2 thenset strikeInterval=.45elseset strikeInterval=.35endifelseif abilityLevel==1 thenset strikeInterval=.7elseif abilityLevel==2 thenset strikeInterval=.6elseset strikeInterval=.5endifendifset strikeInterval=strikeInterval/TimerPeriodShortif ModuloInteger(tickCount,R2I(strikeInterval))==0 or tickCount==1 thenset MarkedUnitTrackKey=handleIdcall TargetLowestLifeEnemyInRange(caster,followerUnit,abilityLevel)endifcall SetUnitX(followerUnit,GetUnitX(caster))call SetUnitY(followerUnit,GetUnitY(caster))endifset tickTrigger=nullset caster=nullset followerUnit=nullreturn falseendfunctionfunction SpawnFollowerAutoStrike takes nothing returns nothinglocal unit caster=GetTriggerUnit()local integer abilityLevel=GetUnitAbilityLevel(caster,'A1AO')local trigger strikeTrigger=CreateTrigger()local integer triggerId=GetHandleId(strikeTrigger)local unit followerUnit=CreateUnit(GetOwningPlayer(caster),'h081',GetUnitX(caster),GetUnitY(caster),0)if abilityLevel==0 thenset abilityLevel=GetUnitAbilityLevel(caster,'A1UV')endifcall UnitApplyTimedLife(followerUnit,'BTLF',30)call SetUnitAbilityLevel(followerUnit,'A1DJ',abilityLevel)call TriggerRegisterUnitEvent(strikeTrigger,caster,EVENT_UNIT_DEATH)call TriggerRegisterUnitEvent(strikeTrigger,followerUnit,EVENT_UNIT_DEATH)call TriggerRegisterTimerEvent(strikeTrigger,TimerPeriodShort,true)call TriggerAddCondition(strikeTrigger,Condition(function OnFollowerAutoStrikeTick))call SaveUnitHandle(GameHashtable,(triggerId),(19),(followerUnit))call SaveUnitHandle(GameHashtable,(triggerId),(2),(caster))call SaveInteger(GameHashtable,(triggerId),(5),(abilityLevel))set caster=nullset strikeTrigger=nullset followerUnit=nullendfunctionfunction FilterCastFollowerAutoStrike takes nothing returns booleanif GetSpellAbilityId()=='A1AO' or GetSpellAbilityId()=='A1UV' thencall SpawnFollowerAutoStrike()endifreturn falseendfunctionfunction RegisterFollowerAutoStrikeSpell takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(t,Condition(function FilterCastFollowerAutoStrike))set t=nullset RemovableAbilityIds[0]='A1DK'set RemovableAbilityIds[1]='A1DL'set RemovableAbilityIds[2]='A1DN'set RemovableAbilityIds[3]='A1DM'set RemovableAbilityIds[4]='A1DO'endfunctionfunction OnUnitTossArcTick takes nothing returns booleanlocal trigger tickTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(tickTrigger)local integer unitIndex=(LoadInteger(GameHashtable,(handleId),(73)))local unit tossedUnit=UnitByIndex(unitIndex)local integer tickCount=GetTriggerEvalCount(tickTrigger)local real heightOffset=(tickCount-13)*(tickCount-13)if tickCount<26 thenif IsUnitTypeExemptFromFlyHeight(tossedUnit)==false thencall SetUnitFlyHeight(tossedUnit,375-heightOffset,0)endifelsecall PauseUnit(tossedUnit,false)if IsUnitTypeExemptFromFlyHeight(tossedUnit)==false thencall SetUnitFlyHeight(tossedUnit,GetUnitDefaultFlyHeight(tossedUnit),0)endifcall DamageTargetByType((LoadUnitHandle(GameHashtable,(handleId),(2))),tossedUnit,DamageType1,(LoadReal(GameHashtable,(handleId),(20))))call CreateDummyCastScaledAbilityOnTarget((LoadUnitHandle(GameHashtable,(handleId),(2))),tossedUnit,(LoadReal(GameHashtable,(handleId),(57))))call ClearUnitHandleSlot(unitIndex)call FlushChildHashtable(GameHashtable,handleId)call RecycleExpiringTrigger(tickTrigger)endifset tickTrigger=nullset tossedUnit=nullreturn falseendfunctionfunction LaunchUnitTossArc takes unit tossedUnit,unit caster,real tossHeight,real tossDistance,real tossDuration returns nothinglocal trigger tickTrigger=CreateTrigger()local integer handleId=GetHandleId(tickTrigger)call PauseUnit(tossedUnit,true)if IsUnitTypeExemptFromFlyHeight(tossedUnit)==false thencall UnitAddAbility(tossedUnit,'Amrf')call UnitRemoveAbility(tossedUnit,'Amrf')endifcall DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\Impale\\ImpaleHitTarget.mdl",GetUnitX(tossedUnit),GetUnitY(tossedUnit)))call SaveInteger(GameHashtable,(handleId),(73),(RegisterUnitHandleSlot(tossedUnit)))call SaveUnitHandle(GameHashtable,(handleId),(2),(caster))call SaveReal(GameHashtable,(handleId),(20),((tossDistance)*1.0))call SaveReal(GameHashtable,(handleId),(57),((tossHeight)*1.0))call TriggerRegisterTimerEvent(tickTrigger,.02/ .52*tossDuration,true)call TriggerAddCondition(tickTrigger,Condition(function OnUnitTossArcTick))set tickTrigger=nullendfunctionfunction EnumApplyTossToEnemies takes nothing returns nothingif IsUnitInGroup(GetEnumUnit(),EnumCollectGroup_2)==false and UnitHasAnyImmunityAbilityOrFlag(GetEnumUnit())==false and((LoadInteger(GameHashtable,(GetHandleId((GetEnumUnit()))),((4253))))==1)==false thencall GroupAddUnit(EnumCollectGroup_2,GetEnumUnit())call LaunchUnitTossArc(GetEnumUnit(),FilterReferenceUnit_2,EnumParamY,EnumParamX,EnumParamAngle)endifendfunctionfunction OnImpaleLineProjectileTick takes nothing returns booleanlocal trigger tickTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(tickTrigger)local unit caster=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local real damage=(LoadReal(GameHashtable,(triggerId),(20)))local real tossParam=(LoadReal(GameHashtable,(triggerId),(57)))local real currentX=(LoadReal(GameHashtable,(triggerId),(64)))local real currentY=(LoadReal(GameHashtable,(triggerId),(65)))local real endX=(LoadReal(GameHashtable,(triggerId),(66)))local real endY=(LoadReal(GameHashtable,(triggerId),(67)))local real width=(LoadReal(GameHashtable,(triggerId),(68)))local real speed=(LoadReal(GameHashtable,(triggerId),(44)))local real angle=Atan2(endY-currentY,endX-currentX)local group hitGroup=(LoadGroupHandle(GameHashtable,(triggerId),(22)))local group enumGroup=AcquireGroupFromPool()local real stepDistance=speed*0.0625local real lastEffectX=(LoadReal(GameHashtable,(triggerId),(71)))local real lastEffectY=(LoadReal(GameHashtable,(triggerId),(72)))local real effectSpacing=(LoadReal(GameHashtable,(triggerId),(70)))local real spellAngle=(LoadReal(GameHashtable,(triggerId),(63)))if stepDistance>DistanceBetweenCoords(currentX,currentY,endX,endY)thenset currentX=endXset currentY=endYelseset currentX=currentX+stepDistance*Cos(angle)set currentY=currentY+stepDistance*Sin(angle)endifset FilterReferenceUnit_2=casterset EnumParamX=damageset EnumParamY=tossParamset EnumParamAngle=spellAngleset EnumCollectGroup_2=hitGroupcall GroupEnumUnitsInRange(enumGroup,currentX,currentY,width,Condition(function FilterAttackableEnemy))call ForGroup(enumGroup,function EnumApplyTossToEnemies)call ReleaseGroupToPool(enumGroup)if DistanceBetweenCoords(currentX,currentY,lastEffectX,lastEffectY)>=effectSpacing thencall SaveReal(GameHashtable,(triggerId),(71),((currentX)*1.0))call SaveReal(GameHashtable,(triggerId),(72),((currentY)*1.0))call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\Impale\\ImpaleMissTarget.mdl",currentX,currentY))endifcall SaveReal(GameHashtable,(triggerId),(64),((currentX)*1.0))call SaveReal(GameHashtable,(triggerId),(65),((currentY)*1.0))if currentX==endX and currentY==endY thenif(LoadBoolean(GameHashtable,(triggerId),(69)))==true thencall ReleaseGroupToPool(hitGroup)endifcall FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(tickTrigger)endifset hitGroup=nullset enumGroup=nullset caster=nullset tickTrigger=nullreturn falseendfunctionfunction DivideRoundNearestToInt takes real numerator,real denominator returns integerif numerator/ denominator-R2I(numerator/ denominator)>=.5 thenreturn R2I(numerator/ denominator)+1endifreturn R2I(numerator/ denominator)endfunctionfunction LaunchImpaleLineProjectile takes unit caster,unit targetUnit,real damage,real tossParam,real spellAngle,real startX,real startY,real endX,real endY,real width,group existingGroup,boolean ownsGroupFlag,real speed returns nothinglocal trigger projectileTrigger=CreateTrigger()local integer triggerId=GetHandleId(projectileTrigger)local real totalDistance=DistanceBetweenCoords(startX,startY,endX,endY)local integer segmentCount=DivideRoundNearestToInt(totalDistance,DodgeChanceDivisor)local real segmentLength=totalDistance/ segmentCountlocal group tempGroupcall SaveUnitHandle(GameHashtable,(triggerId),(2),(caster))call SaveReal(GameHashtable,(triggerId),(20),((damage)*1.0))call SaveReal(GameHashtable,(triggerId),(57),((tossParam)*1.0))call SaveReal(GameHashtable,(triggerId),(63),((spellAngle)*1.0))call SaveReal(GameHashtable,(triggerId),(64),((startX)*1.0))call SaveReal(GameHashtable,(triggerId),(65),((startY)*1.0))call SaveReal(GameHashtable,(triggerId),(66),((endX)*1.0))call SaveReal(GameHashtable,(triggerId),(67),((endY)*1.0))call SaveReal(GameHashtable,(triggerId),(68),((width)*1.0))call SaveReal(GameHashtable,(triggerId),(44),((speed)*1.0))if existingGroup==null thenset tempGroup=AcquireGroupFromPool()if targetUnit!=null and IsUnitIllusion(targetUnit)==false thencall GroupAddUnit(tempGroup,targetUnit)endifcall SaveGroupHandle(GameHashtable,(triggerId),(22),(tempGroup))call SaveBoolean(GameHashtable,(triggerId),(69),(ownsGroupFlag))elsecall SaveGroupHandle(GameHashtable,(triggerId),(22),(existingGroup))call SaveBoolean(GameHashtable,(triggerId),(69),(ownsGroupFlag))endifcall SaveReal(GameHashtable,(triggerId),(70),((segmentLength)*1.0))call SaveReal(GameHashtable,(triggerId),(71),((startX)*1.0))call SaveReal(GameHashtable,(triggerId),(72),((startY)*1.0))call TriggerRegisterTimerEvent(projectileTrigger,.0625,true)call TriggerAddCondition(projectileTrigger,Condition(function OnImpaleLineProjectileTick))set projectileTrigger=nullset tempGroup=nullendfunctionfunction OnImpaleLeapArriveExpire takes nothing returns booleanlocal trigger leapTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(leapTrigger)local unit leapUnit=(LoadUnitHandle(GameHashtable,(triggerId),(14)))local real destX=(LoadReal(GameHashtable,(triggerId),(6)))local real destY=(LoadReal(GameHashtable,(triggerId),(7)))call SetUnitPosition(leapUnit,destX,destY)call SetUnitAnimation(leapUnit,"morph ALTERNATE")call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(leapTrigger)set leapTrigger=nullset leapUnit=nullreturn falseendfunctionfunction CastImpaleLeapA06O takes nothing returns nothinglocal unit casterUnit=GetTriggerUnit()local integer abilityLevel=GetUnitAbilityLevel(casterUnit,'A06O')local location targetLoclocal real anglelocal real casterX=GetUnitX(casterUnit)local real casterY=GetUnitY(casterUnit)local real targetXlocal real targetYlocal real tempRealAlocal real tempRealBlocal real CasterXlocal real CasterYlocal integer CasterAbilitylocal unit dummyUnitlocal trigger arriveTrigger=CreateTrigger()local integer triggerId=GetHandleId(arriveTrigger)local real damageAmountlocal real stunDuration=1.65local unit markedTarget=nullif abilityLevel==1 thenset damageAmount=100elseif abilityLevel==2 thenset damageAmount=160elseif abilityLevel==3 thenset damageAmount=220elseif abilityLevel==4 thenset damageAmount=280endifif GetSpellTargetUnit()!=null thenset targetLoc=GetUnitLoc(GetSpellTargetUnit())elseset targetLoc=GetSpellTargetLoc()endifset targetX=GetLocationX(targetLoc)set targetY=GetLocationY(targetLoc)call RemoveLocation(targetLoc)set angle=AngleBetweenCoords(casterX,casterY,targetX,targetY)call SaveUnitHandle(GameHashtable,(triggerId),(14),(casterUnit))call SaveReal(GameHashtable,(triggerId),(6),((targetX)*1.0))call SaveReal(GameHashtable,(triggerId),(7),((targetY)*1.0))call TriggerRegisterTimerEvent(arriveTrigger,DistanceBetweenCoords(casterX,casterY,targetX,targetY)/2000,false)call TriggerAddCondition(arriveTrigger,Condition(function OnImpaleLeapArriveExpire))if DistanceBetweenCoords(casterX,casterY,targetX,targetY)<150 thenset targetX=casterX+150*Cos(angle*bj_DEGTORAD)set targetY=casterY+150*Sin(angle*bj_DEGTORAD)endifif GetSpellTargetUnit()!=null and HasAnyMarkedAbility(GetSpellTargetUnit())thenset markedTarget=GetSpellTargetUnit()endifcall LaunchImpaleLineProjectile(casterUnit,markedTarget,damageAmount,stunDuration,0.52,casterX,casterY,targetX,targetY,175,null,true,1600)set casterUnit=nullset dummyUnit=nullset targetLoc=nullset casterUnit=nullset arriveTrigger=nullendfunctionfunction FilterCastImpaleLeap takes nothing returns booleanif GetSpellAbilityId()=='A06O'thencall CastImpaleLeapA06O()endifreturn falseendfunctionfunction RegisterImpaleLeapSpell takes nothing 