rigger)if clone1!=null thencall SetUnitX(clone1,killX)call SetUnitY(clone1,killY)call KillUnit(clone1)endifif clone2!=null thencall SetUnitX(clone2,killX)call SetUnitY(clone2,killY)call KillUnit(clone2)endifif clone3!=null thencall SetUnitX(clone3,killX)call SetUnitY(clone3,killY)call KillUnit(clone3)endifif clone4!=null thencall SetUnitX(clone4,killX)call SetUnitY(clone4,killY)call KillUnit(clone4)endifcall EnableTrigger(EarthshakerTipTrigger)set clone1=nullset clone2=nullset clone3=nullset clone4=nullendfunctionfunction BeginAegisRevive takes nothing returns nothinglocal unit hero=GetTriggerUnit()local real tempXlocal real tempYlocal trigger reviveTrigger=CreateTrigger()local integer handleId=GetHandleId(reviveTrigger)call StoreAndSyncDataInteger("AegisOff",GetPlayerId(GetOwningPlayer(hero)))if GetUnitTypeId(hero)=='H00I' thencall KillMeepoClonesAt(hero,GetUnitX(hero),GetUnitY(hero))endifset PendingRecipeUnit=nullcall TriggerRegisterTimerEvent(reviveTrigger,5.,false)call TriggerAddCondition(reviveTrigger,Condition(function OnAegisReviveExpire))call SaveUnitHandle(GameHashtable,(handleId),(14),(hero))call StartUnitFlagTimer(hero,4304,5)set reviveTrigger=nullset hero=nullendfunctionfunction OnAegisItemUsed takes nothing returns nothingif FindItemTypeIndexBaseTables(GetManipulatedItem())==ItemIndexCost0Charged thencall BeginAegisRevive()endifendfunctionfunction EnumFindLiveRuneItem takes nothing returns nothingif GetWidgetLife(GetEnumItem())>0 and IsPickupRestrictedItemType(GetItemTypeId(GetEnumItem()))thenset TempCreatedItem=GetEnumItem()endifendfunctionfunction RollDistinctRuneType takes nothing returns integerlocal integer rolledType=GetRandomInt(1,5)loopexitwhen rolledType!=SearchResultItemIndexset rolledType=GetRandomInt(1,5)endloopset SearchResultItemIndex=rolledTypereturn rolledTypeendfunctionfunction SpawnPeriodicRunes takes nothing returns booleanlocal boolean unusedFlagA=falselocal boolean un