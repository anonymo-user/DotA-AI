iginX,originY)call PanCameraToTimedForPlayer(GetOwningPlayer(caster),originX,originY,0)call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\NightElf\\NECancelDeath\\NECancelDeath.mdl",GetUnitX(caster),GetUnitY(caster)))call DirectHeroToNearestLane(caster)endifif allyUnit!=null and IsUnitDeadOrInvalid(allyUnit)==false and GetOwningPlayer(allyUnit)!=SentinelPlayer[0]and GetOwningPlayer(allyUnit)!=ScourgePlayer[0]and((LoadBoolean(GameHashtable,(GetHandleId(GetOwningPlayer((allyUnit)))),(139)))==false)thencall DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\NightElf\\NECancelDeath\\NECancelDeath.mdl",GetUnitX(allyUnit),GetUnitY(allyUnit)))call StartUnitFlagTimer(allyUnit,4402,1)call SetUnitPosition(allyUnit,originX,originY)if IsUnitType(allyUnit,UNIT_TYPE_HERO) and IsUnitDeadOrInvalid(allyUnit)==false thencall PanCameraToTimedForPlayer(GetOwningPlayer(allyUnit),originX,originY,0)endifcall DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\NightElf\\NECancelDeath\\NECancelDeath.mdl",GetUnitX(allyUnit),GetUnitY(allyUnit)))call DirectHeroToNearestLane(allyUnit)endifcall SaveInteger(GameHashtable,(GetHandleId((caster))),((4294)),(2))call DestroyEffect((LoadEffectHandle(GameHashtable,(triggerId),(32))))call FogModifierStop(fogMod)call DestroyFogModifier(fogMod)call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(whichTrigger)endifendifset whichTrigger=nullset caster=nullset allyUnit=nullset fogMod=nullreturn falseendfunctionfunction A1TBRecallChannelPeriodic takes nothing returns booleanlocal trigger channelTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(channelTrigger)local unit casterUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local real savedX=(LoadReal(GameHashtable,(triggerId),(47)))local real savedY=(LoadReal(GameHashtable,(triggerId),(48)))local fogmodifier fogModlocal integer abilityLevel=GetUnitAbilityLevel(casterUnit,'A1TB')if UnitHasStunOrDisableBuff(casterUnit)or UnitHasAnyDisableDebuff(casterUnit)or IsUnitDeadOrInvalid(casterUnit)thencall SaveInteger(GameHashtable,(GetHandleId((casterUnit))),((4294)),(2))call DestroyEffect((LoadEffectHandle(GameHashtable,(triggerId),(32))))call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(channelTrigger)elseif GetTriggerEvalCount(channelTrigger)==(2.75-.25*abilityLevel)/.05 thenset fogMod=CreateFogModifierRadius(GetOwningPlayer(casterUnit),FOG_OF_WAR_VISIBLE,GetUnitX(casterUnit),GetUnitY(casterUnit),400,true,true)call FogModifierStart(fogMod)call DestroyEffect((LoadEffectHandle(GameHashtable,(triggerId),(32))))call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(channelTrigger)set channelTrigger=CreateTrigger()set triggerId=GetHandleId(channelTrigger)call SaveUnitHandle(GameHashtable,(triggerId),(2),(casterUnit))call TriggerRegisterTimerEvent(channelTrigger,.01,false)call TriggerRegisterTimerEvent(channelTrigger,12,false)call TriggerRegisterUnitEvent(channelTrigger,casterUnit,EVENT_UNIT_DEATH)call TriggerAddCondition(channelTrigger,Condition(function A1TBRecallTeleportPeriodic))call SaveReal(GameHashtable,(triggerId),(189),((GetUnitX(casterUnit))*1.))call SaveReal(GameHashtable,(triggerId),(190),((GetUnitY(casterUnit))*1.))call SaveReal(GameHashtable,(triggerId),(47),((savedX)*1.))call SaveReal(GameHashtable,(triggerId),(48),((savedY)*1.))call SaveEffectHandle(GameHashtable,(triggerId),(32),(AddSpecialEffect("war3mapImported\\EarthlyEminence.mdl",GetUnitX(casterUnit),GetUnitY(casterUnit))))call SaveFogModifierHandle(GameHashtable,(triggerId),(42),(fogMod))set channelTrigger=CreateTrigger()set triggerId=GetHandleId(channelTrigger)call SaveUnitHandle(GameHashtable,(triggerId),(2),(casterUnit))call TriggerRegisterTimerEvent(channelTrigger,1,true)call TriggerAddCondition(channelTrigger,Condition(function A1TBRecallCountdownPeriodic))endifset casterUnit=nullset channelTrigger=nullset fogMod=nullreturn fals