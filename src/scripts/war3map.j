dTimeScaledXpAndGold takes unit hero,item whichItem returns nothinglocal integer elapsedMinutes=R2I((TimerGetElapsed(GameClockTimer))/60)local integer xpAmount=50+5*elapsedMinuteslocal integer goldAmount=50+2*elapsedMinuteslocal boolean bonusReward=(LoadBoolean(GameHashtable,(GetHandleId(whichItem)),(835)))if bonusReward thenset xpAmount=100set goldAmount=100endifcall AddHeroXP(hero,xpAmount,true)call AwardGoldWithFloatingText_3(GetOwningPlayer(hero),goldAmount,hero)call PlaySoundOnUnitBJ(g_soundReceiveGold,100,hero)endfunctionfunction ApplyRuneBuffViaDummy takes unit hero,item whichItem returns nothinglocal unit target=herolocal real targetX=GetUnitX(target)local real targetY=GetUnitY(target)local unit dummy=CreateUnit(GetOwningPlayer(target),'e00E',targetX,targetY,0)if IsUnitType(target,UNIT_TYPE_MELEE_ATTACKER)==true thencall UnitAddAbility(dummy,'A2XN')elsecall UnitAddAbility(dummy,'A0GR')endifcall IssueTargetOrderById(dummy,852274,target)call IssueTargetOrderById(dummy,852274,target)set target=nullset dummy=nullendfunctionfunction HandleRuneItemUse takes unit heroUnit,item whichItem returns nothingif GetItemTypeId(whichItem)=='I007' or GetItemTypeId(whichItem)=='I006' or GetItemTypeId(whichItem)=='I008' or GetItemTypeId(whichItem)=='I00K' or GetItemTypeId(whichItem)=='I00J' or GetItemTypeId(whichItem)=='I0RC' thencall NotifyRuneStoreOrUse(heroUnit,GetItemTypeId(whichItem),false)endifif GetItemTypeId(whichItem)=='I007' thencall ApplyRuneBuffViaDummy(heroUnit,whichItem)elseif GetItemTypeId(whichItem)=='I00J' thenif GetUnitAbilityLevel(heroUnit,'B09Y')>0 thencall UnitRemoveAbility(heroUnit,'B09Y')call UnitRemoveAbility(heroUnit,'B01Q')call DisableTrigger(GetTriggeringTrigger())call UnitAddItemById(heroUnit,'I00J')call EnableTrigger(GetTriggeringTrigger())endifelseif GetItemTypeId(whichItem)=='I008' thencall StartRestorationBuffPoll(heroUnit,whichItem)elseif GetItemTypeId(whichItem)=='I0RC' thencall AwardTimeScaledXpAndGold(heroUnit,whichItem)endifendfunctionfunction RefreshHeroOrbAbilities takes unit whichHero,item whichItem returns nothinglocal integer orbAbilityIdlocal integer orbAbilityLevelcall UnitRemoveAbility(whichHero,'A27S')call UnitRemoveAbility(whichHero,'A27Q')call UnitRemoveAbility(whichHero,'A27R')call UnitRemoveAbility(whichHero,'A27T')if GetUnitAbilityLevel(whichHero,'A28F')>0 thencall UnitRemoveAbility(whichHero,'A28F')call UnitAddAbility(whichHero,'A28F')endifif GetUnitTypeId(whichHero)=='Edem' thenset orbAbilityId='A0KY'elseif GetUnitTypeId(whichHero)=='U00F' thenset orbAbilityId='A06D'elseif GetUnitTypeId(whichHero)=='EC77' thenset orbAbilityId='A0MM'elseif GetUnitTypeId(whichHero)=='Ogrh' thenset orbAbilityId='A0YK'elseif GetUnitTypeId(whichHero)=='H00J' or GetUnitTypeId(whichHero)=='H00I' thenset orbAbilityId='A2QA'elseif GetUnitTypeId(whichHero)=='UC60' thenset orbAbilityId='A2TS'elseset whichHero=nullreturnendifset orbAbilityLevel=GetUnitAbilityLevel(whichHero,orbAbilityId)if orbAbilityLevel>0 thencall UnitRemoveAbility(whichHero,orbAbilityId)call UnitAddAbility(whichHero,orbAbilityId)call SetUnitAbilityLevel(whichHero,orbAbilityId,orbAbilityLevel)endifendfunctionfunction IsItemTypeNotExcludedForStack takes integer itemTypeIndex returns booleanreturn itemTypeIndex!=ItemIndexCost7800 and itemTypeIndex!=ItemIndexCost4900 and itemTypeIndex!=ItemIndexCost900A and itemTypeIndex!=ItemIndexCost0Chargedendfunctionfunction SetHeldItemUnpawnable takes nothing returns nothingif GetTriggerEventId()==EVENT_PLAYER_UNIT_PICKUP_ITEM thencall SetItemPawnable(GetManipulatedItem(),false)elsecall SetItemPawnable(GetManipulatedItem(),true)endifendfunctionfunction OnPermanentItemManipulateTogglePawnable takes nothing returns booleanif GetItemType(GetManipulatedItem())==ITEM_TYPE_PERMANENT and IsItemTypeNotExcludedForStack(FindItemTypeIndexBaseTables(GetManipulatedItem()))and IsUnitTypeInEitherSet(GetTriggerUnit())thencall SetHeldItemUnpawnable()endifreturn falseendfunctionfunction RefreshComboAbilityA0V0OnDrop takes nothing returns booleanlocal unit heroUnit=GetTriggerUnit()local integer comboLevel=1if UnitItemOfType(heroUnit,ItemTypeId[ItemIndexGold1000B])!=null thenset comboLevel=2endifif FindOtherItemOfType(heroUnit,ItemTypeId[ItemIndexCost450A],GetManipulatedItem())!=null thenset comboLevel=3endifif FindOtherItemOfType(heroUnit,ItemTypeId[ItemIndexCost1350],GetManipulatedItem())!=null thenset comboLevel=4endifif FindOtherItemOfType(heroUnit,ItemTypeId[ItemIndexCost1400B],GetManipulatedItem())!=null or FindOtherItemOfType(heroUnit,ItemTypeId[ItemIndexCost1400C],GetManipulatedItem())!=null or FindOtherItemOfType(heroUnit,ItemTypeId[ItemIndexCost1400D],GetManipulatedItem())!=null thenset comboLevel=5endifif FindOtherItemOfType(heroUnit,ItemTypeId[ItemIndexCost1450],GetManipulatedItem())!=null thenset comboLevel=6endifif FindOtherItemOfType(heroUnit,ItemTypeId[ItemIndexGold1000A],GetManipulatedItem())!=null thenset comboLevel=7endifif FindOtherItemOfType(heroUnit,ItemTypeId[ItemIndexCost2450],GetManipulatedItem())!=null thenset comboLevel=8endifif FindOtherItemOfType(heroUnit,ItemTypeId[ItemIndexCost2850],GetManipulatedItem())!=null thencall UnitAddAbility(heroUnit,'A0V0')call SetUnitAbilityLevel(heroUnit,'A0V0',comboLevel)call UnitMakeAbilityPermanent(heroUnit,true,'A0V0')elsecall UnitRemoveAbility(heroUnit,'A0V0')endifset heroUnit=nullreturn falseendfunctionfunction RefreshComboAbilityA0V0OnPickup takes nothing returns booleanlocal unit heroUnit=GetTriggerUnit()local integer comboLevel=1if UnitItemOfType(heroUnit,ItemTypeId[ItemIndexGold1000B])!=null thenset comboLevel=2endifif FindOtherItemOfType(heroUnit,ItemTypeId[ItemIndexCost450A],GetManipulatedItem())!=null thenset comboLevel=3endifif UnitItemOfType(heroUnit,ItemTypeId[ItemIndexCost1350])!=null thenset comboLevel=4endifif UnitItemOfType(heroUnit,ItemTypeId[ItemIndexCost1400B])!=null o