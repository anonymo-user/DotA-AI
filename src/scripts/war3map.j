ealthBelow50Fired=truecall StoreAndSyncDataInteger("Throne",50)endifif healthRatio<.25 and HealthBelow25Fired==false thenset HealthBelow25Fired=truecall StoreAndSyncDataInteger("Throne",25)endifif healthRatio<.1 and HealthBelow10Fired==false thenset HealthBelow10Fired=truecall StoreAndSyncDataInteger("Throne",10)endifreturn falseendfunctionfunction AreAllTeam1BarracksDestroyed takes nothing returns booleanreturn( not(Team2Lane1SpawnFlagB or Team2Lane0SpawnFlagB or Team2Lane2SpawnFlagB or Team2Lane1SpawnFlagA or Team2Lane0SpawnFlagA or Team2Lane2SpawnFlagA))endfunctionfunction AnnounceAndUpgradeTeamCreeps takes nothing returns nothingcall DisplayTimedTextToForceMembers(bj_FORCE_ALL_PLAYERS,20.,(GetObjectName(('n04O')))+(GetObjectName(('n0C7'))))call SetPlayerTechResearchedSwap('R00D',(GetPlayerTechCountSimple('R00D',SentinelPlayer[0])+30),SentinelPlayer[0])call SetPlayerTechResearchedSwap('R00C',(GetPlayerTechCountSimple('R00C',SentinelPlayer[0])+30),SentinelPlayer[0])call DisableTrigger(Team1BarracksDestroyedUpgradeTrigger)endfunctionfunction AreNoModeFlagsSet takes nothing returns booleanif(Team1Lane1SpawnFlagA or Team1Lane0SpawnFlagB or Team1Lane2SpawnFlagA or GameModeFlagAv or Team1Lane0SpawnFlagA or Team1Lane2SpawnFlagB)thenreturn falseendifreturn trueendfunctionfunction AnnounceAndGrantTechBonusOnce takes nothing returns nothingcall DisplayTimedTextToForceMembers(bj_FORCE_ALL_PLAYERS,20.,(GetObjectName(('n04X')))+" "+(GetObjectName(('n0C9'))))call SetPlayerTechResearchedSwap('R009',(GetPlayerTechCountSimple('R009',ScourgePlayer[0])+30),ScourgePlayer[0])call SetPlayerTechResearchedSwap('R00B',(GetPlayerTechCountSimple('R00B',ScourgePlayer[0])+30),ScourgePlayer[0])call DisableTrigger(TechBonusGrantTrigger)endfunctionfunction IncrementBothForcesCreepUpgradeLevels takes nothing returns nothingcall SetPlayerTechResearchedSwap('R007',(GetPlayerTechCountSimple('R007',SentinelPlayer[0])+1),SentinelPlayer[0])call SetPlayerTechResearch