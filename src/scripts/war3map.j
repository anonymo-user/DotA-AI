shtable,(triggerId),(32))),(LoadEffectHandle(GameHashtable,(triggerId),(176))))call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(thisTrigger)endifendifset thisTrigger=nullset casterUnit=nullset tossedUnit=nullreturn falseendfunctionfunction OnCastA27FToss takes nothing returns nothinglocal unit caster=GetTriggerUnit()local unit target=GetSpellTargetUnit()local trigger liftTrigger=CreateTrigger()local integer triggerId=GetHandleId(liftTrigger)local integer abilityLevel=GetUnitAbilityLevel(caster,'A27F')local unit dummyCaster=CreateUnit(GetOwningPlayer(target),'e00E',GetUnitX(target),GetUnitY(target),0)call UnitAddAbility(dummyCaster,'A282')call SetUnitAbilityLevel(dummyCaster,'A282',abilityLevel)call IssueTargetOrderById(dummyCaster,852095,target)call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'A27F',false)call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'A27X',true)call UnitAddAbility(caster,'A27X')call SetUnitPathing(target,false)if IsUnitTypeExemptFromFlyHeight(target)==false thencall AddPermanentAbility(target,'Amrf')call UnitRemoveAbility(target,'Amrf')endifcall SaveUnitHandle(GameHashtable,(triggerId),(2),(caster))call SaveUnitHandle(GameHashtable,(triggerId),(17),(target))call SaveUnitHandle(GameHashtable,(triggerId),(711),(target))call SaveInteger(GameHashtable,(triggerId),(12),(R2I((1.25+.25*abilityLevel)/.02)))call SaveInteger(GameHashtable,(triggerId),(34),(0))call SaveInteger(GameHashtable,(triggerId),(706),(0))call SaveInteger(GameHashtable,(triggerId),(707),(1))call SaveReal(GameHashtable,(triggerId),(47),((GetUnitX(target))*1.))call SaveReal(GameHashtable,(triggerId),(48),((GetUnitY(target))*1.))call SaveEffectHandle(GameHashtable,(triggerId),(32),(AddSpecialEffectTarget("war3mapImported\\AntiGravityTarget.mdx",target,"origin")))call SaveEffectHandle(GameHashtable,(triggerId),(176),(AddSpecialEffect("Abilities\\Spells\\Other\\GeneralAuraTarget\\GeneralAuraTarget.mdl",GetUnitX(target),GetUnitY(target))))call TriggerRegisterTimerEvent(liftTrigger,.02,true)call TriggerRegisterDeathEvent(liftTrigger,target)call TriggerRegisterUnitEvent(liftTrigger,caster,EVENT_UNIT_SPELL_EFFECT)call TriggerAddCondition(liftTrigger,Condition(function OnA27FTossLiftTick))set caster=nullset target=nullendfunctionfunction OnCastA27FTossFilter takes nothing returns booleanif GetSpellAbilityId()=='A27F' and HasAnyMarkedAbility(GetSpellTargetUnit())==false thencall OnCastA27FToss()endifreturn falseendfunctionfunction RegisterA27FTossSpell takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(t,Condition(function OnCastA27FTossFilter))call PreloadAbilityOnDummy('A0X6')call PreloadAbilityOnDummy('A282')set t=nullendfunctionfunction ApplyA27GBounceDebuffByLevel takes unit casterUnit,unit targetUnit returns nothinglocal integer abilityLevel=GetUnitAbilityLevel(casterUnit,'A27G')if IsUnitType(targetUnit,UNIT_TYPE_HERO) thenif abilityLevel==1 thencall GrantTimedAbility_2(targetUnit,'A27W',1,10)elseif abilityLevel==2 thencall GrantTimedAbility_2(targetUnit,'A286',1,10)elseif abilityLevel==3 thencall GrantTimedAbility_2(targetUnit,'A285',1,10)elseif abilityLevel==4 thencall GrantTimedAbility_2(targetUnit,'A287',1,10)endifelseif abilityLevel==1 thencall GrantTimedAbility_2(targetUnit,'A291',1,10)elseif abilityLevel==2 thencall GrantTimedAbility_2(targetUnit,'A28Z',1,10)elseif abilityLevel==3 thencall GrantTimedAbility_2(targetUnit,'A292',1,10)elseif abilityLevel==4 thencall GrantTimedAbility_2(targetUnit,'A290',1,10)endifendifcall PlaySoundAtPoint(SpiritTouchSound,GetUnitX(targetUnit),GetUnitY(targetUnit))endfunctionfunction EnumTrackNearestBounceTarget takes nothing returns nothinglocal real dif IsUnitInGroup(GetEnumUnit(),EnumMembershipGroup)==false thenset d=DistanceBetweenWidgets(GetEnumUnit(),DistanceReferenceUnit_2)if d<NearestDistanceFound_3 thenset NearestDistanceFound_3=dset SelectedEnumUnit=GetEnumUnit()endifendifendfunctionfunction OnA27GBounceTick takes nothing returns booleanlocal trigger bounceTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(bounceTrigger)local unit sourceUnit=(LoadUnitHandle(GameHashtable,(handleId),(2)))local unit currentTarget=(LoadUnitHandle(GameHashtable,(handleId),(17)))local group hitGroup=(LoadGroupHandle(GameHashtable,(handleId),(187)))local real targetX=GetUnitX(currentTarget)local real targetY=GetUnitY(currentTarget)local group nearbyGroup=AcquireGroupFromPool()call GroupAddUnit(hitGroup,currentTarget)call ApplyA27GBounceDebuffByLevel(sourceUnit,currentTarget)set FilterReferenceUnit_2=sourceUnitset SelectedEnumUnit=nullset DistanceReferenceUnit_2=currentTargetset EnumMembershipGroup=hitGroupset NearestDistanceFound_3=999999call GroupEnumUnitsInRange(nearbyGroup,targetX,targetY,440+25,Condition(function FilterVisibleEnemyValidTarget))call ForGroup(nearbyGroup,function EnumTrackNearestBounceTarget)call ReleaseGroupToPool(nearbyGroup)if SelectedEnumUnit==null or GetTriggerEvalCount(bounceTrigger)>26 thencall ReleaseGroupToPool(hitGroup)call FlushChildHashtable(GameHashtable,(handleId))call RecycleExpiringTrigger(bounceTrigger)elseset currentTarget=SelectedEnumUnitcall SaveUnitHandle(GameHashtable,(handleId),(17),(currentTarget))endifset nearbyGroup=nullset bounceTrigger=nullset sourceUnit=nullset currentTarget=nullset hitGroup=nullreturn falseendfunctionfunction OnCastA27GBounce takes nothing returns nothinglocal unit caster=GetTriggerUnit()local unit target=GetSpellTargetUnit()local trigger bounceTrigger=CreateTrigger()local integer triggerId=GetHandleId(bounceTrigger)local group bounceGroup=AcquireGroupFromPool()local unit dummyCaster=CreateUnit(GetOwningPlayer(caster),'e00E',GetUnitX(caster),GetUnitY(caster),GetUnitFacing(caster))call PlaySoundAtPoint(SpiritTouchSound,GetUnitX(