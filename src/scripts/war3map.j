=falseendfunctionfunction OnCastAgiStrRatioPushDamage takes nothing returns nothinglocal unit caster=GetTriggerUnit()local unit targetUnit=GetSpellTargetUnit()local integer abilityLevel=GetUnitAbilityLevel(caster,'A0G6')local unit dummyUnitlocal location pushLoclocal real pushAnglelocal integer agility=GetHeroAgi(caster,true)local integer strength=GetHeroStr(caster,true)local real agiStrRatio=I2R(agility)/ I2R(strength)local real strAgiRatio=I2R(strength)/ I2R(agility)local real agiDamageScalelocal real baseDamagelocal real strScaleValuelocal real pushDistancelocal real totalDamagelocal real abilityValuelocal integer onesDigitlocal integer tenthsDigitlocal integer hundredthsDigitlocal string onesStringlocal string tenthsStringlocal string hundredthsStringlocal real maxStrScale=.25+abilityLevelif agiStrRatio<.5 thenset agiDamageScale=.25set baseDamage=20*abilityLevelelseif agiStrRatio>1.5 thenset agiDamageScale=.5*abilityLevelset baseDamage=20*abilityLevelelseset agiDamageScale=.25+(agiStrRatio-.5)*(.5*abilityLevel-.25)set baseDamage=20*abilityLevelendifif strAgiRatio<.5 thenset strScaleValue=.25set pushDistance=100elseif strAgiRatio>1.5 thenset strScaleValue=maxStrScaleset pushDistance=300elseset pushDistance=100+(strAgiRatio-.5)*200set strScaleValue=.25+(strAgiRatio-.5)*(maxStrScale-.25)endifset totalDamage=baseDamage+agiDamageScale*agilityset abilityValue=strScaleValueset onesDigit=R2I(abilityValue)set tenthsDigit=R2I(10*abilityValue-onesDigit*10)set hundredthsDigit=R2I(100*abilityValue-tenthsDigit*10-onesDigit*100)set onesString=I2S(onesDigit)set tenthsString=I2S(tenthsDigit)set hundredthsString=I2S(hundredthsDigit)set pushAngle=Atan2(GetUnitY(targetUnit)-GetUnitY(caster),GetUnitX(targetUnit)-GetUnitX(caster))set pushLoc=Location(GetUnitX(targetUnit)+pushDistance*Cos(pushAngle),GetUnitY(targetUnit)+pushDistance*Sin(pushAngle))call SetUnitPositionLoc(targetUnit,pushLoc)call KillTreesInArea(GetLocationX(pushL