urceUnit=nullset targetUnit=nullendfunctionfunction PulseNovaPeriodicTick takes nothing returns booleanlocal trigger triggeringTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(triggeringTrigger)local unit casterUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local integer abilityLevel=GetUnitAbilityLevel(casterUnit,'A21F')local group enemyGroupif casterUnit==null thencall FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(triggeringTrigger)return falseendifif abilityLevel!=0 thenif abilityLevel==1 thenset DamageAmountValue=100elseif abilityLevel==2 thenset DamageAmountValue=130elseset DamageAmountValue=160endifelseset abilityLevel=GetUnitAbilityLevel(casterUnit,'A21G')if abilityLevel==1 thenset DamageAmountValue=160elseif abilityLevel==2 thenset DamageAmountValue=190elseset DamageAmountValue=220endifendifif GetTriggerEventId()==EVENT_WIDGET_DEATH or GetUnitState(casterUnit,UNIT_STATE_MANA)<20*abilityLevel or(LoadInteger(GameHashtable,(GetHandleId(casterUnit)),(704)))==-1 or(GetTriggerEventId()==EVENT_UNIT_SPELL_EFFECT and(GetSpellAbilityId()=='A21H' or GetSpellAbilityId()=='A27H'))thenif(LoadInteger(GameHashtable,(GetHandleId(casterUnit)),(704)))==0 or(LoadInteger(GameHashtable,(GetHandleId(casterUnit)),(704)))=='A21F' thencall SetPlayerAbilityAvailable(GetOwningPlayer(casterUnit),'A21F',true)endifif(LoadInteger(GameHashtable,(GetHandleId(casterUnit)),(704)))==0 or(LoadInteger(GameHashtable,(GetHandleId(casterUnit)),(704)))=='A21G' thencall SetPlayerAbilityAvailable(GetOwningPlayer(casterUnit),'A21G',true)endifcall SetPlayerAbilityAvailable(GetOwningPlayer(casterUnit),'A21H',false)call FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(triggeringTrigger)call SetUnitStateFlagDone(casterUnit,"AI|PulseNova")elseif GetTriggerEventId()!=EVENT_UNIT_SPELL_EFFECT thencall SetUnitState(casterUnit,UNIT_STATE_MANA,GetUnitState(casterUnit,UNIT_STATE_MANA)-20*abilityLevel)