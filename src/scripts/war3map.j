gger,targetUnit)call TriggerRegisterTimerEvent(expireTrigger,6.,false)call TriggerAddCondition(expireTrigger,Condition(function OnA226MorphExpireRemoveAbilities))call SaveUnitHandle(GameHashtable,(triggerId),(17),(targetUnit))call SaveReal(GameHashtable,(GetHandleId(targetUnit)),(715),((5.9+(TimerGetElapsed(GameClockTimer)))*1.))set expireTrigger=nullendfunctionfunction EnumApplyA226ToEnemy takes nothing returns nothingif IsUnitTypeInSetC(GetEnumUnit())==false thencall GrantA226LeveledAbilityTimed(GetEnumUnit())endifcall SetPlayerAbilityAvailable(GetOwningPlayer(GetEnumUnit()),'A228',false)call SetPlayerAbilityAvailable(GetOwningPlayer(GetEnumUnit()),'A2Y7',false)call SetPlayerAbilityAvailable(GetOwningPlayer(GetEnumUnit()),'A2Y6',false)call SetPlayerAbilityAvailable(GetOwningPlayer(GetEnumUnit()),'A2Y5',false)call DamageTargetByType(AbilityDamageCasterUnit,GetEnumUnit(),DamageType2,25+50*AbilityLevelForDamage_2)call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\CrushingWave\\CrushingWaveDamage.mdl",GetEnumUnit(),"chest"))endfunctionfunction CastA226CrushingWave takes nothing returns nothinglocal group enemyGroup=AcquireGroupFromPool()local unit casterUnit=GetTriggerUnit()local integer abilityLevel=GetUnitAbilityLevel(casterUnit,'A226')set FilterReferenceUnit_2=casterUnitset AbilityLevelForDamage_2=abilityLevelset AbilityDamageCasterUnit=casterUnitcall GroupEnumUnitsInRange(enemyGroup,GetUnitX(casterUnit),GetUnitY(casterUnit),375+25,Condition(function FilterEnemyNonStructure))call ForGroup(enemyGroup,function EnumApplyA226ToEnemy)call ReleaseGroupToPool(enemyGroup)set enemyGroup=nullset casterUnit=nullendfunctionfunction OnTimerResetTimeScale takes nothing returns booleanlocal trigger timerTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(timerTrigger)local unit casterUnit=(LoadUnitHandle(GameHashtable,(handleId),(2)))call FlushChildHashtable(GameHashtable,(handleId))call RecycleExpiringTrigger(timerTrigger)call SetUnitTimeScale(casterUnit,1)set timerTrigger=nullset casterUnit=nullreturn falseendfunctionfunction StartA226CastAnimationSpeedup takes nothing returns nothinglocal trigger speedupTrigger=CreateTrigger()local integer handleId=GetHandleId(speedupTrigger)local unit casterUnit=GetTriggerUnit()call TriggerRegisterTimerEvent(speedupTrigger,.3,false)call TriggerRegisterDeathEvent(speedupTrigger,casterUnit)call TriggerAddCondition(speedupTrigger,Condition(function OnTimerResetTimeScale))call SaveUnitHandle(GameHashtable,(handleId),(2),(casterUnit))call SetUnitTimeScale(casterUnit,2)set speedupTrigger=nullset casterUnit=nullendfunctionfunction OnA226SpellEffectOrCast takes nothing returns booleanif GetSpellAbilityId()=='A226' thenif GetTriggerEventId()==EVENT_PLAYER_UNIT_SPELL_EFFECT thencall CastA226CrushingWave()elsecall StartA226CastAnimationSpeedup()endifendifreturn falseendfunctionfunction RegisterA226SpellEvents takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_CAST)call TriggerAddCondition(t,Condition(function OnA226SpellEffectOrCast))set t=nullendfunctionfunction OnA0YMProjectileImpactSlowDamage takes nothing returns nothinglocal integer handleId=GetHandleId(GetTriggeringTrigger())local unit casterUnit=FilterReferenceUnit_2local unit targetUnit=FilterReferenceUnitBlocal integer abilityLevel=(LoadInteger(GameHashtable,(handleId),(5)))local real damageAmount=20+abilityLevel*40local unit slowDummy=CreateUnit(GetOwningPlayer(casterUnit),'e00E',GetUnitX(targetUnit),GetUnitY(targetUnit),0)local integer bonusLevel=GetUnitAbilityLevel(casterUnit,'A03Q')if IsUnitType(targetUnit,UNIT_TYPE_HERO)==true thenset damageAmount=damageAmount/2endifif bonusLevel>0 and GetRandomReal(0,100)<15 thenset damageAmount=damageAmount*(1.2+1.1*bonusLevel)call CreateTimedTextTagOnUnit(I2