33)))local real ringRadiuslocal real pointXlocal real centerX=GetUnitX(casterUnit)local real pointYlocal real centerY=GetUnitY(casterUnit)local group enumGroup=AcquireGroupFromPool()local integer tickCount=GetTriggerEvalCount(castTrigger)local integer loopIndexcall SetUnitX(dummyUnit,GetUnitX(casterUnit))call SetUnitY(dummyUnit,GetUnitY(casterUnit))set TempGroupBackup=hitGroupset TempUnitBackup=casterUnitset LoadedTargetUnit=(LoadUnitHandle(GameHashtable,(handleId),(132)))if GetTriggerEvalCount(castTrigger)>37 thencall KillUnit(dummyUnit)call ReleaseGroupToPool(hitGroup)call FlushChildHashtable(GameHashtable,handleId)call RecycleExpiringTrigger(castTrigger)elseset ringRadius=tickCount*21set loopIndex=0loopexitwhen loopIndex>36set pointX=centerX+ringRadius*Cos(360*loopIndex/ 36*bj_DEGTORAD)set pointY=centerY+ringRadius*Sin(360*loopIndex/ 36*bj_DEGTORAD)set FilterReferenceUnit_2=casterUnitcall GroupEnumUnitsInRange(enumGroup,pointX,pointY,150,Condition(function FilterVisibleEnemyTarget))call ForGroup(enumGroup,function EnumFrostNovaRingTarget)set loopIndex=loopIndex+1endloopendifcall ReleaseGroupToPool(enumGroup)set castTrigger=nullset dummyUnit=nullset hitGroup=nullset casterUnit=nullset enumGroup=nullreturn falseendfunctionfunction StartExpandingFrostNova takes nothing returns nothinglocal unit caster=GetTriggerUnit()local real castX=GetUnitX(caster)local real castY=GetUnitY(caster)local group hitGroup=AcquireGroupFromPool()local trigger trig=CreateTrigger()local integer trigId=GetHandleId(trig)local unit ringUnit=CreateUnit(GetOwningPlayer(caster),'h091',castX,castY,0)local unit dummyUnit=CreateUnit(GetOwningPlayer(caster),'e00E',GetUnitX(caster),GetUnitY(caster),0)call UnitAddAbility(dummyUnit,'A0T0')call SaveGroupHandle(GameHashtable,(trigId),(133),(hitGroup))call SaveUnitHandle(GameHashtable,(trigId),(19),(ringUnit))call SaveUnitHandle(GameHashtable,(trigId),(132),(dummyUnit))call SaveUnitHandle(GameHashtable,