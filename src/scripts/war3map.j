kes nothing returns nothingif GetUnitCurrentOrder(GetEnumUnit())==0 and IsUnitInRange(GetEnumUnit(),CurrentOrderTarget,GetUnitAcquireRange(GetEnumUnit()))==false thencall GroupRemoveUnit(ActiveEnumGroup,GetEnumUnit())call SetUnitUserData(GetEnumUnit(),0)call IssuePointOrderByIdLoc(GetEnumUnit(),851983,GetCreepLaneDestination(GetEnumUnit()))endifendfunctionfunction OnCreepPullTimerExpire takes nothing returns nothinglocal integer handleId=GetHandleId(LoadUnitHandle(GameHashtable,GetHandleId(GetExpiredTimer()),(2)))local integer slotIndex=(LoadInteger(GameHashtable,(handleId),(143)))local group creepGroup=(LoadGroupHandle(GameHashtable,(handleId),(144)))set UnitSlot[slotIndex]=nullcall ForGroup(creepGroup,function EnumResetCreepToLane)call GroupClear(creepGroup)set creepGroup=nullendfunctionfunction PullNearbyCreepsToTarget takes unit sourceUnit,unit newTarget returns nothinglocal integer handleId=GetHandleId(sourceUnit)local group creepGroup=(LoadGroupHandle(GameHashtable,(handleId),(144)))local integer slotIndex=(LoadInteger(GameHashtable,(handleId),(143)))local unit previousTarget=UnitSlot[slotIndex]local group nearbyGroupif previousTarget!=null and previousTarget!=newTarget thencall ForGroup(creepGroup,function EnumResetCreepToLane)call GroupClear(creepGroup)endifset UnitSlot[slotIndex]=newTargetset ActiveEnumGroup=creepGroupset CurrentOrderTarget=newTargetset UnitUserDataValue=slotIndexcall ForGroup(creepGroup,function EnumReleaseIdleCreepFromTarget)set nearbyGroup=AcquireGroupFromPool()call GroupEnumUnitsInRange(nearbyGroup,GetUnitX(newTarget),GetUnitY(newTarget),500,Condition(function FilterRecruitableCreepNearTarget))call ForGroup(nearbyGroup,function EnumAssignCreepToPullTarget)call ReleaseGroupToPool(nearbyGroup)call TimerStart((LoadTimerHandle(GameHashtable,(handleId),(141))),2,false,function OnCreepPullTimerExpire)set nearbyGroup=nullset previousTarget=nullset creepGroup=nullendfunctionfunction IsCreepAggroExemptHero