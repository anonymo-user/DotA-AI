=pickedUnitset pickedUnit=nullset nearbyGroup=nullreturn FilterReferenceUnit_2endfunctionfunction OnTossFlightTick takes nothing returns booleanlocal trigger tickTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(tickTrigger)local integer tickCount=GetTriggerEvalCount(tickTrigger)local unit caster=(LoadUnitHandle(GameHashtable,(triggerId),(14)))local unit tossedUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local unit targetUnit=(LoadUnitHandle(GameHashtable,(triggerId),(17)))local real originX=(LoadReal(GameHashtable,(triggerId),(282)))local real originY=(LoadReal(GameHashtable,(triggerId),(283)))local real tossedX=0local real tossedY=0local real destX=0local real destY=0local real flightAnglelocal real distanceToTargetlocal real stepDistancelocal real heightFactorlocal real newXlocal real newYlocal location tempLocif tossedUnit==null or GetUnitTypeId(tossedUnit)<1 thencall FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(tickTrigger)set tickTrigger=nullset caster=nullset tossedUnit=nullset targetUnit=nullreturn falseendifset tossedX=GetUnitX(tossedUnit)set tossedY=GetUnitY(tossedUnit)if targetUnit!=null thenset destX=GetUnitX(targetUnit)set destY=GetUnitY(targetUnit)endifif targetUnit==null or DistanceBetweenCoords(originX,originY,destX,destY)>1000 thenset destX=originXset destY=originYendifset flightAngle=AngleBetweenCoords(tossedX,tossedY,destX,destY)set distanceToTarget=DistanceBetweenCoords(tossedX,tossedY,destX,destY)set stepDistance=distanceToTarget/IMaxBJ((65-tickCount),1)set heightFactor=(tickCount-33)*(tickCount-33)set newX=tossedX+stepDistance*Cos(flightAngle*bj_DEGTORAD)set newY=tossedY+stepDistance*Sin(flightAngle*bj_DEGTORAD)if tickCount<65 thenif IsUnitTypeExemptFromFlyHeight(tossedUnit)==false thencall SetUnitFlyHeight(tossedUnit,775-heightFactor,0)endifcall SetUnitPosition(tossedUnit,newX,newY)elseif IsUnitTypeExemptFromFlyHeight(tossedUnit)==false 