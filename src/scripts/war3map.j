nif GetTriggerEventId()==EVENT_PLAYER_UNIT_SPELL_CAST thencall PlayIgniteCastEffect()elseif HasAnyMarkedAbility(GetSpellTargetUnit())==false thencall ApplyIgniteMark()endifendifreturn falseendfunctionfunction RegisterIgniteSpell takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_CAST)call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(t,Condition(function OnIgniteSpellEvent))set t=nullendfunctionfunction ReselectStoredUnitOnTimer takes nothing returns booleanlocal trigger timerTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(timerTrigger)local unit storedUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))call SelectUnitForPlayerSingle(storedUnit,GetOwningPlayer(storedUnit))call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(timerTrigger)set timerTrigger=nullset storedUnit=nullreturn falseendfunctionfunction OnA01YRebirthCheck takes nothing returns booleanlocal trigger rebirthTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(rebirthTrigger)local unit heroUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local integer abilityLevel=GetUnitAbilityLevel(heroUnit,'A01Y')local real cooldownDuration=360-100*abilityLevellocal unit dummyCasterif abilityLevel==3 thenendifif TimerGetRemaining(PlayerAbilityCooldownTimer[GetPlayerId(GetOwningPlayer(heroUnit))])==0 and GetUnitState(heroUnit,UNIT_STATE_MANA)>=160 thencall ShowUnit(heroUnit, true)set dummyCaster=CreateUnit(GetOwningPlayer(heroUnit),'e00E',GetUnitX(heroUnit),GetUnitY(heroUnit),0)call UnitAddAbility(dummyCaster,'A274')call IssueImmediateOrderById(dummyCaster,852096)call TimerStart(PlayerAbilityCooldownTimer[GetPlayerId(GetOwningPlayer(heroUnit))],cooldownDuration,false,null)set rebirthTrigger=CreateTrigger()set triggerId=GetHandleId(rebirthTrigger)call TriggerRegisterTimerEvent(rebirthTrigger,3+.01,false)call TriggerAddCondition(rebirthTrigger,Condition(function ReselectStoredUnitOnTimer))call SaveUnitHandle(GameHashtable,(triggerId),(2),(heroUnit))endifset rebirthTrigger=nullset heroUnit=nullset dummyCaster=nullreturn falseendfunctionfunction RegisterA01YDeathRebirth takes nothing returns nothinglocal trigger deathTrigger=CreateTrigger()local integer triggerId=GetHandleId(deathTrigger)local unit heroUnit=GetTriggerUnit()call TriggerRegisterDeathEvent(deathTrigger,heroUnit)call TriggerAddCondition(deathTrigger,Condition(function OnA01YRebirthCheck))call SaveUnitHandle(GameHashtable,(triggerId),(2),(heroUnit))set deathTrigger=nullset heroUnit=nullendfunctionfunction OnLearnA01YRebirth takes nothing returns booleanif GetLearnedSkill()=='A01Y' and GetUnitAbilityLevel(GetTriggerUnit(),'A01Y')==1 and IsUnitIllusion(GetTriggerUnit())==false thencall RegisterA01YDeathRebirth()endifreturn falseendfunctionfunction InitA01YRebirthSkill takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_HERO_SKILL)call TriggerAddCondition(t,Condition(function OnLearnA01YRebirth))set t=nullendfunctionfunction IsAuraMeleeUnitType takes unit u returns booleanreturn GetUnitTypeId(u)=='E005' or GetUnitTypeId(u)=='H00E' or GetUnitTypeId(u)=='H00G' or GetUnitTypeId(u)=='H08D' or GetUnitTypeId(u)=='H08C' or GetUnitTypeId(u)=='H084' or GetUnitTypeId(u)=='H08B' or GetUnitTypeId(u)=='E02O'endfunctionfunction OnB0GYLifestealDamage takes nothing returns booleanlocal trigger whichTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(whichTrigger)local unit caster=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local unit targetUnit=(LoadUnitHandle(GameHashtable,(triggerId),(17)))local integer abilityLevel=(LoadInteger(GameHashtable,(triggerId),(5)))if GetTriggerEventId()==EVENT_UNIT_DAMAGED thenif GetEventDamageSource()==caster and GetEventDamage()>0 thencall SetUnitState(caster,UNIT_