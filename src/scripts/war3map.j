ayer(GetTriggerPlayer(),0,0,60,(GetObjectName(('N05Y'))))if GameModeFlagX thenset loopStart=CachedLoopIndexset loopEnd=HeroPoolLoopBoundCendifif IsPlayerOnTeamZero(triggerPlayer)thenif GameModeFlagF9 thenset loopStart=CachedLoopIndexset loopEnd=HeroPoolLoopBoundAcall CreateUnitAtLoc(triggerPlayer,'n00C',spawnLocA,bj_UNIT_FACING)elsecall CreateUnitAtLoc(triggerPlayer,'n00C',spawnLocA,bj_UNIT_FACING)call CreateUnitAtLoc(triggerPlayer,'n00C',spawnLocB,bj_UNIT_FACING)endifcall PanCameraToTimedLocForPlayer(triggerPlayer,spawnLocA,0)elseif GameModeFlagF9 thenset loopStart=HeroPoolLoopStartBset loopEnd=HeroPoolLoopBoundCcall CreateUnitAtLoc(triggerPlayer,'n00C',spawnLocB,bj_UNIT_FACING)elsecall CreateUnitAtLoc(triggerPlayer,'n00C',spawnLocA,bj_UNIT_FACING)call CreateUnitAtLoc(triggerPlayer,'n00C',spawnLocB,bj_UNIT_FACING)endifcall PanCameraToTimedLocForPlayer(triggerPlayer,spawnLocB,0)endifloopexitwhen loopStart>loopEndif PointValueClaimed[loopStart]==false thencall SetPlayerTechMaxAllowed(triggerPlayer,RestrictedTechId[loopStart],1)endifset loopStart=loopStart+1endloopcall ReleaseGroupToPool(playerUnitsGroup)set playerUnitsGroup=nullcall RemoveLocation(spawnLoc)set spawnLoc=nullcall RemoveLocation(spawnLocA)set spawnLocA=nullcall RemoveLocation(spawnLocB)set spawnLocB=nullreturnendifloopset randomIndex=GetRandomInt(heroPoolStart,heroPoolEnd)if(PointValueClaimed[randomIndex]==false)thenset PointValueClaimed[randomIndex]=trueset TrackedSideUnit[GetPlayerId(triggerPlayer)]=CreateUnitAtLoc(triggerPlayer,RestrictedTechId[randomIndex],spawnLoc,bj_UNIT_FACING)call ForbidTechForAllPlayers(RestrictedTechId[randomIndex])endifexitwhen TrackedSideUnit[GetPlayerId(GetTriggerPlayer())]!=nullendloopcall ReleaseGroupToPool(playerUnitsGroup)set playerUnitsGroup=nullcall RemoveLocation(spawnLoc)set spawnLoc=nullcall RemoveLocation(spawnLocA)set spawnLocA=nullcall RemoveLocation(spawnLocB)set spawnLocB=nullendfunctionfunction RunGuardedSwapAction takes nothing returns nothingif CanPlayerRepickHero()thencall PerformPlayerRepick()endifendfunctionfunction DisplayEnabledGameModes takes nothing returns nothinglocal player triggerPlayer=GetTriggerPlayer()local string colorPrefix="|c006699CC"if GameModeFlagOu thencall DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,colorPrefix+"League Mode"+"|r:      "+(GetObjectName(('n075'))))endifif GameModeFlagP4 thencall DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,colorPrefix+"Extended League"+"|r:      "+(GetObjectName(('n07B'))))call DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,"                                 "+(GetObjectName(('n070'))))endifif AiSuppressModeFlag thencall DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,colorPrefix+"Death Match"+"|r:        "+(GetObjectName(('n06Z'))))call DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,"                              "+(GetObjectName(('n06Y')))+" "+I2S(IntMin(HeroPoolLoopBoundA,HeroPoolLoopBoundC-HeroPoolLoopStartB+1))+" "+(GetObjectName(('n07C'))))endifif GameModeFlagD9 thencall DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,colorPrefix+"Mirror Match"+"|r:       "+(GetObjectName(('n06W'))))endifif GameModeFlagX thencall DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,colorPrefix+"All Pick"+"|r:                 "+(GetObjectName(('n06V'))))endifif GameModeFlagOL thencall DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,colorPrefix+"Random Draft"+"|r:                 "+(GetObjectName(('n072'))))endifif GameModeFlagVT thencall DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,colorPrefix+"Single Draft"+"|r:                 "+(GetObjectName(('n07G'))))endifif GameModeFlagV thencall DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,colorPrefix+"All Random"+"|r:          "+(GetObjectName(('n071'))))endifif GameModeFlagO9 thencall DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,colorPrefix+"Vote Random"+"|r:         "+(GetObjectName(('n074'))))endifif GameModeFlagW thencall DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,colorPrefix+"Team Random"+"|r:     "+(GetObjectName(('n06M'))))endifif GameModeFlagY_2 thencall DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,colorPrefix+"Reverse"+"|r:                 "+(GetObjectName(('n073'))))endifif HasInitializedFlag thencall DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,colorPrefix+"Shuffle Players"+"|r:     "+(GetObjectName(('n07H'))))endifif FlagRxTriggered thencall DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,colorPrefix+"All Agility"+"|r:             "+(GetObjectName(('n07L'))))endifif FlagBxTriggered thencall DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,colorPrefix+"All Strength"+"|r:         "+(GetObjectName(('n07K'))))endifif FlagNxTriggered thencall DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,colorPrefix+"All Intelligence"+"|r:    "+(GetObjectName(('n07J'))))endifif OneTimeGuardBeta thencall DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,colorPrefix+"Range Only"+"|r:    "+(GetObjectName(('n0G4'))))endifif OneTimeGuardGamma thencall DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,colorPrefix+"Melee Only"+"|r:    "+(GetObjectName(('n0G5'))))endifif GameModeFlagE9 thencall DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,colorPrefix+"Duplicate Mode"+"|r:   "+(GetObjectName(('n07I'))))endifif GameModeFlagY thencall DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,colorPrefix+"Item Drop"+"|r:             "+(GetObjectName(('n07F'))))endifif InitGuardG7 thencall DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,colorPrefix+"No Powerups"+"|r:        "+(GetObjectName(('n07M'))))endifif InitGuardM7 thencall DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,colorPrefix+"Super Creeps"+"