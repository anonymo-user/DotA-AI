dleId(whichTrigger)local integer tickCount=GetTriggerEvalCount(whichTrigger)local unit casterUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))call UnitRemoveAbility(casterUnit,'A1SP')call FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(whichTrigger)set whichTrigger=nullset casterUnit=nullreturn falseendfunctionfunction OnCastA1SOGrantA1SP takes nothing returns nothinglocal trigger grantTrigger=CreateTrigger()local integer triggerId=GetHandleId(grantTrigger)local unit casterUnit=GetTriggerUnit()call AddPermanentAbility(casterUnit,'A1SP')call UnitMakeAbilityPermanent(casterUnit,true,'A1SP')call SetUnitAbilityLevel(casterUnit,'A1SP',GetUnitAbilityLevel(casterUnit,'A1SO'))call TriggerRegisterTimerEvent(grantTrigger,3,false)call TriggerRegisterUnitEvent(grantTrigger,casterUnit,EVENT_UNIT_DEATH)call TriggerAddCondition(grantTrigger,Condition(function OnA1SPExpireRemoveAbility))call SaveUnitHandle(GameHashtable,(triggerId),(2),(casterUnit))set grantTrigger=nullset casterUnit=nullendfunctionfunction FilterCastA1SO takes nothing returns booleanif GetSpellAbilityId()=='A1SO' thencall OnCastA1SOGrantA1SP()endifreturn falseendfunctionfunction RegisterA1SOTrigger takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(t,Condition(function FilterCastA1SO))set t=nullendfunctionfunction OnA1SQProjectileTick takes nothing returns booleanlocal trigger projectileTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(projectileTrigger)local integer tickCount=GetTriggerEvalCount(projectileTrigger)local unit casterUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local unit targetUnit=(LoadUnitHandle(GameHashtable,(triggerId),(17)))local unit projectileUnit=(LoadUnitHandle(GameHashtable,(triggerId),(45)))local real newXlocal real newYlocal real distancelocal real damageAmountlocal real projX=(LoadReal(GameHashtable,(triggerId),(23)))local real projY=(LoadReal(GameHashtable,(triggerId),(24)))local real moveAngle=AngleBetweenCoords(projX,projY,GetUnitX(targetUnit),GetUnitY(targetUnit))*bj_DEGTORADlocal integer abilityLevel=GetUnitAbilityLevel(casterUnit,'A1SQ')if GetTriggerEventId()==EVENT_UNIT_DEATH thencall UnitShareVision(projectileUnit,GetOwningPlayer(targetUnit),false)call DestroyEffect((LoadEffectHandle(GameHashtable,(triggerId),(32))))call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(projectileTrigger)if GetTriggerUnit()!=projectileUnit thencall KillUnit(projectileUnit)endifelseif GetTriggerEventId()==EVENT_UNIT_DAMAGED thencall UnitRemoveBuffs(projectileUnit,true,true)elseif tickCount<3/.02 thencall SetUnitFacing(projectileUnit,moveAngle*bj_RADTODEG)elseif tickCount==4/.02 thencall UnitShareVision(projectileUnit,GetOwningPlayer(targetUnit),true)endifcall SetUnitFacing(projectileUnit,moveAngle*bj_RADTODEG)set newX=projX+(280+ProjectileSpreadFactor*tickCount*.02)*.02*Cos(moveAngle)set newY=projY+(280+ProjectileSpreadFactor*tickCount*.02)*.02*Sin(moveAngle)call SetUnitPosition(projectileUnit,newX,newY)call SaveReal(GameHashtable,(triggerId),(23),((newX)*1.))call SaveReal(GameHashtable,(triggerId),(24),((newY)*1.))if DistanceBetweenCoords(newX,newY,GetUnitX(targetUnit),GetUnitY(targetUnit))<20 thenset distance=RMinBJ(DistanceBetweenCoords(newX,newY,(LoadReal(GameHashtable,(triggerId),(6))),(LoadReal(GameHashtable,(triggerId),(7)))),1500)set damageAmount=distance/1500*(125*GetUnitAbilityLevel(casterUnit,'A1SQ'))set damageAmount=RMaxBJ(damageAmount,50)call KillUnit(projectileUnit)call DestroyEffect((LoadEffectHandle(GameHashtable,(triggerId),(32))))call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(projectileTrigger)call DamageTargetByType(casterUnit,targetUnit,DamageType1,damageAmount)call CreateDummyCastScaledAbilityOnTarget(casterUnit,targetUnit,2+.2*abilityLevel)endifendifset projectileTrigger=nullset casterUnit=nullset targetUnit=nullset projectileUnit=nullreturn falseendfunctionfunction OnCastSnipeSpawnMissile takes nothing returns nothinglocal trigger tickTrigger=CreateTrigger()local integer handleId=GetHandleId(tickTrigger)local unit casterUnit=GetTriggerUnit()local unit targetUnit=GetSpellTargetUnit()local real angleRad=AngleBetweenCoords(GetUnitX(casterUnit),GetUnitY(casterUnit),GetUnitX(targetUnit),GetUnitY(targetUnit))*bj_DEGTORADlocal real spawnX=ClampXToPlayableArea(GetUnitX(casterUnit)+150*Cos(angleRad))local real spawnY=ClampYToPlayableArea(GetUnitY(casterUnit)+150*Sin(angleRad))local integer abilityLevel=GetUnitAbilityLevel(casterUnit,'A1SQ')local unit missileUnitlocal integer missileTypeIdlocal string effectPath="effects\\Snipe Target.mdx"if IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(casterUnit))==false and IsEitherKeyPlayerActive(GetLocalPlayer())==false thenset effectPath=""endifif abilityLevel==1 thenset missileTypeId='h0CG'elseif abilityLevel==2 thenset missileTypeId='h0C1'elseif abilityLevel==3 thenset missileTypeId='h0CF'elseif abilityLevel==4 thenset missileTypeId='h0CH'endifset missileUnit=CreateUnit(GetOwningPlayer(casterUnit),missileTypeId,spawnX,spawnY,angleRad*bj_RADTODEG)call TriggerRegisterTimerEvent(tickTrigger,.02,true)call TriggerRegisterUnitEvent(tickTrigger,targetUnit,EVENT_UNIT_DEATH)call TriggerRegisterUnitEvent(tickTrigger,missileUnit,EVENT_UNIT_DEATH)call TriggerRegisterUnitEvent(tickTrigger,missileUnit,EVENT_UNIT_DAMAGED)call TriggerAddCondition(tickTrigger,Condition(function OnA1SQProjectileTick))call SaveUnitHandle(GameHashtable,(handleId),(2),(casterUnit))call SaveUnitHandle(GameHashtable,(handleId),(17),(targetUnit))call SaveUnitHandle(GameHashtable,(handleId),(45),(missileUnit))call SaveReal(GameHashtable,(handleId),(6),((GetUnitX(casterUnit))*1.))call SaveReal(GameHashtable,(handleId),(7),((GetUnitY(casterUnit))*1.))call SaveReal(GameHashtable,(handleId),(23),((GetUnitX(missileUnit))*1.))call SaveReal(GameHashtable,(handleId),(24),((GetUnitY(missileUnit))*1.))call SaveEffectHandle(GameHashtable,(handleId),(32),(AddSpecialEffectTarget(effectPath,targetUnit,"overhead")))set tickTrigger=nullset casterUnit=nullset targetUnit=nullset missileUnit=nullendfunctionfunction ConditionSnipeCast takes nothing returns booleanif GetSpellAbilityId()=='A1SQ' and HasAnyMarkedAbility(GetSpellTargetUnit())==false thencall OnCastSnipeSpawnMissile()endifreturn falseendfunctionfunction InitSnipeSpell takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(t,Condition(function ConditionSnipeCast))call PreloadAbilityOnDummy('A0X6')set t=nullendfunctionfunction OnTimerRemoveDebuffA1SS takes nothing returns booleanlocal trigger removeTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(removeTrigger)local unit debuffedUnit=(LoadUnitHandle(GameHashtable,(triggerId),(17)))if debuffedUnit==null thencall FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(removeTrigger)return falseendifcall FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(removeTrigger)call UnitRemoveAbility(debuffedUnit,'A1SS')call UnitRemoveAbility(debuffedUnit,'B0DE')set removeTrigger=nullset debuffedUnit=nullreturn falseendfunctionfunction OnTimerRemoveDebuffA1T4 takes nothing returns booleanlocal trigger removeTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(removeTrigger)local unit debuffedUnit=(LoadUnitHandle(GameHashtable,(triggerId),(17)))if debuffedUnit==null thencall FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(removeTrigger)return falseendifcall FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(removeTrigger)call UnitRemoveAbility(debuffedUnit,'A1T4')call UnitRemoveAbility(debuffedUnit,'B0DG')set removeTrigger=nullset debuffedUnit=nullreturn falseendfunctionfunction EnumDamageAndApplyA1SS takes nothing returns nothinglocal trigger whichTriggerlocal integer triggerIdlocal integer abilityLevel=GetUnitAbilityLevel(AoeDamageSourceC,'A1T5')local boolean isUpgraded=falseif abilityLevel==0 thenset abilityLevel=GetUnitAbilityLevel(AoeDamageSourceC,'A235')set isUpgraded=trueendifif IsUnitTypeInSetC(GetEnumUnit())==false thenset whichTrigger=CreateTrigger()set triggerId=GetHandleId(whichTrigger)call TriggerRegisterTimerEvent(whichTrigger,2,false)call TriggerRegisterUnitEvent(whichTrigger,GetEnumUnit(),EVENT_UNIT_DEATH)call TriggerAddCondition(whichTrigger,Condition(function OnTimerRemoveDebuffA1SS))call SaveUnitHandle(GameHashtable,(triggerId),(17),(GetEnumUnit()))call SetPlayerAbilityAvailable(GetOwningPlayer(GetEnumUnit()),'A1SS',false)call AddPermanentAbility(GetEnumUnit(),'A1SS')endifcall DamageTargetByType(AoeDamageSourceC,GetEnumUnit(),DamageType1,abilityLevel*50+200)set whichTrigger=nullendfunctionfunction EnumDamageAndApplyA1T4 takes nothing returns nothinglocal trigger whichTriggerlocal integer triggerIdlocal integer abilityLevel=GetUnitAbilityLevel(AoeDamageSourceC,'A1T5')local boolean isUpgraded=falseif abilityLevel==0 thenset abilityLevel=GetUnitAbilityLevel(AoeDamageSourceC,'A235')set isUpgraded=trueendifif IsUnitTypeInSetC(GetEnumUnit())==false thenset whichTrigger=CreateTrigger()set triggerId=GetHandleId(whichTrigger)call TriggerRegisterTimerEvent(whichTrigger,3,false)call TriggerRegisterUnitEvent(whichTrigger,GetEnumUnit(),EVENT_UNIT_DEATH)call TriggerAddCondition(whichTrigger,Condition(function OnTimerRemoveDebuffA1T4))call SaveUnitHandle(GameHashtable,(triggerId),(17),(GetEnumUnit()))call SetPlayerAbilityAvailable(GetOwningPlayer(GetEnumUnit()),'A1T4',false)call AddPermanentAbility(GetEnumUnit(),'A1T4')endifif isUpgraded thencall DamageTargetByType(AoeDamageSourceC,GetEnumUnit(),DamageType1,abilityLevel*50+50+75)elsecall DamageTargetByType(AoeDamageSourceC,GetEnumUnit(),DamageType1,abilityLevel*50+50)endifset whichTrigger=nullendfunctionfunction OnCallDownStrikeTick takes nothing returns booleanlocal trigger tickTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(tickTrigger)local unit caster=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local real targetX=(LoadReal(GameHashtable,(triggerId),(6)))local real targetY=(LoadReal(GameHashtable,(triggerId),(7)))local group enemyGrouplocal integer tickCount=GetTriggerEvalCount(tickTrigger)local fogmodifier visionFog=(LoadFogModifierHandle(GameHashtable,(triggerId),(42)))if tickCount==1 thencall DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Calldown_FlyUp.mdx",caster,"chest"))elseif tickCount==2 thencall DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Calldown_FlyUp.mdx",caster,"chest"))elseif tickCount==3 thencall DestroyEffect(AddSpecialEffect("war3mapImported\\Calldown_FlyDown.mdx",targetX,targetY))elseif tickCount==4 thenset enemyGroup=AcquireGroupFromPool()set FilterReferenceUnit_2=casterset AoeDamageSourceC=castercall GroupEnumUnitsInRange(enemyGroup,targetX,targetY,450+25,Condition(function FilterAttackableEnemy))call ForGroup(enemyGroup,function EnumDamageAndApplyA1SS)call ReleaseGroupToPool(enemyGroup)call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\DemolisherFireMissile\\DemolisherFireMissile.mdl",targetX,targetY))elseif tickCount==5 thencall DestroyEffect(AddSpecialEffect("war3mapImported\\Calldown_FlyDown.mdx",targetX,targetY))elseif tickCount==6 thenset enemyGroup=AcquireGroupFromPool()set FilterReferenceUnit_2=casterset AoeDamageSourceC=castercall GroupEnumUnitsInRange(enemyGroup,targetX,targetY,450+25,Condition(function FilterAttackableEnemy))call ForGroup(enemyGroup,function EnumDamageAndApplyA1T4)call ReleaseGroupToPool(enemyGroup)call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\DemolisherFireMissile\\DemolisherFireMissile.mdl",targetX,targetY))call DestroyEffect((LoadEffectHandle(GameHashtable,(triggerId),(32))))call FogModifierStop(visionFog)call DestroyFogModifier(visionFog)call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(tickTrigger)endifset tickTrigger=nullset caster=nullset enemyGroup=nullset visionFog=nullreturn falseendfunctionfunction OnCastCallDownStrike takes nothing returns nothinglocal unit casterUnit=GetTriggerUnit()local real targetX=GetSpellTargetX()local real targetY=GetSpellTargetY()local trigger strikeTrigger=CreateTrigger()local integer triggerId=GetHandleId(strikeTrigger)local string effectPath=""local fogmodifier fogMod=CreateFogModifierRadius(GetOwningPlayer(casterUnit),FOG_OF_WAR_VISIBLE,targetX,targetY,350,true,true)call FogModifierStart(fogMod)if IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(casterUnit)) or IsEitherKeyPlayerActive(GetLocalPlayer())thenset effectPath="war3mapImported\\CallDown_4.mdx"endifcall TriggerRegisterTimerEvent(strikeTrigger,.1,false)call TriggerRegisterTimerEvent(strikeTrigger,.8,false)call TriggerRegisterTimerEvent(strikeTrigger,1.6,false)call TriggerRegisterTimerEvent(strikeTrigger,2,false)call TriggerRegisterTimerEvent(strikeTrigger,3.6,false)call TriggerRegisterTimerEvent(strikeTrigger,4,false)call TriggerAddCondition(strikeTrigger,Condition(function OnCallDownStrikeTick))call SaveUnitHandle(GameHashtable,(triggerId),(2),(casterUnit))call SaveReal(GameHashtable,(triggerId),(6),((targetX)*1.))call SaveReal(GameHashtable,(triggerId),(7),((targetY)*1.))call SaveEffectHandle(GameHashtable,(triggerId),(32),(AddSpecialEffect(effectPath,targetX,targetY)))call SaveFogModifierHandle(GameHashtable,(triggerId),(42),(fogMod))set strikeTrigger=nullset casterUnit=nullset fogMod=nullendfunctionfunction ConditionCallDownStrikeCast takes nothing returns booleanif GetSpellAbilityId()=='A1T5' or GetSpellAbilityId()=='A235' thencall OnCastCallDownStrike()endifreturn falseendfunctionfunction InitCallDownStrikeSpell takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(t,Condition(function ConditionCallDownStrikeCast))set t=nullendfunctionfunction OnFlakCannonDamageWindow takes nothing returns booleanlocal trigger t=GetTriggeringTrigger()local integer triggerId=GetHandleId(t)local unit caster=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local integer attackCountif GetTriggerEventId()==EVENT_UNIT_DAMAGED thenif GetEventDamageSource()==caster and(GetEventDamage()>20 or IsUnitType(GetTriggerUnit(),UNIT_TYPE_STRUCTURE))thenset attackCount=LoadIntByStringKey(GetHandleId(caster),"Count")if attackCount>0 thencall SaveIntByStringKey(GetHandleId(caster),"Count",(attackCount+1))endifcall FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(t)endifelsecall FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(t)endifset t=nullset caster=nullreturn falseendfunctionfunction OnTimerReapplyHexA237 takes nothing returns booleanlocal trigger reapplyTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(reapplyTrigger)local unit hexedUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))if IsUnitHexed(hexedUnit)==false thencall FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(reapplyTrigger)call UnitRemoveAbility(hexedUnit,'A237')call UnitAddAbility(hexedUnit,'A22B')call UnitRemoveAbility(hexedUnit,'A22B')if(UnitItemOfType((hexedUnit),ItemTypeId[RecipeItemIndexGK4])!=null)thencall UnitAddAbility(hexedUnit,'A237')endifendifset reapplyTrigger=nullset hexedUnit=nullreturn falseendfunctionfunction ReapplyFlakCannonAbility takes unit whichUnit returns nothinglocal trigger tlocal integer triggerIdif IsUnitHexed(whichUnit)==false thencall UnitRemoveAbility(whichUnit,'A237')call UnitAddAbility(whichUnit,'A22B')call UnitRemoveAbility(whichUnit,'A22B')if(UnitItemOfType((whichUnit),ItemTypeId[RecipeItemIndexGK4])!=null)thencall UnitAddAbility(whichUnit,'A237')endifelseset t=CreateTrigger()set triggerId=GetHandleId(t)call SaveUnitHandle(GameHashtable,(triggerId),(2),(whichUnit))call TriggerRegisterTimerEvent(t,.1,true)call TriggerAddCondition(t,Condition(function OnTimerReapplyHexA237))set t=nullendifendfunctionfunction OnFlakCannonEndTrigger takes nothing returns booleanlocal trigger t=GetTriggeringTrigger()local integer triggerId=GetHandleId(t)local unit caster=(LoadUnitHandle(GameHashtable,(triggerId),(2)))if caster==null thencall FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(t)return falseendifcall UnitRemoveAbility(caster,'A1TW')call UnitRemoveAbility(caster,'B0DJ')call ReapplyFlakCannonAbility(caster)call FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(t)set t=nullset caster=nullreturn falseendfunctionfunction OnFlakCannonAttackStartCount takes nothing returns nothinglocal unit attacker=GetAttacker()local trigger t=LoadTriggerByStringKey(GetHandleId(attacker),"FlakCannon_EndTrig")local integer triggerIdlocal integer attackCountlocal integer abilityLevelif attacker==null or t==null thenset attacker=nullset t=nullreturnendifset triggerId=GetHandleId(t)set attackCount=LoadIntByStringKey(GetHandleId(attacker),"Count")set abilityLevel=GetUnitAbilityLevel(attacker,'A229')if IsUnitIllusion(GetAttacker()) and GetUnitAbilityLevel(GetAttacker(),'A1TW')>0 thencall ReapplyFlakCannonAbility(GetAttacker())call UnitRemoveAbility(GetAttacker(),'A1TW')endifif GetAttacker()==attacker thenset attackCount=attackCount+1if attackCount>3+abilityLevel thencall UnitRemoveAbility(attacker,'A1TW')call UnitRemoveAbility(attacker,'B0DJ')call ReapplyFlakCannonAbility(attacker)call FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(t)elseset t=CreateTrigger()set triggerId=GetHandleId(t)