llText)call MultiboardSetItemWidth(mbItem,.07)call MultiboardReleaseItem(mbItem)set loopIndex=loopIndex+1endloopset loopIndex=1loopexitwhen loopIndex>teamTwoCountset columnIndex=columnIndex+1set mbItem=MultiboardGetItem(ScoreboardMultiboard_2,rowIndex,columnIndex)set cellText=ExperienceColorCode+"+"+I2S(R2I(GetPlayerHandicapXPBJ(scourgePlayers[loopIndex])-100.))+"%|r - "+GoldColorCode+"+"+I2S(AiAggressionLevel[48+GetPlayerId(scourgePlayers[loopIndex])])+"|r"call MultiboardSetItemStyle(mbItem,true,false)call MultiboardSetItemValue(mbItem,cellText)call MultiboardSetItemWidth(mbItem,.07)call MultiboardReleaseItem(mbItem)set loopIndex=loopIndex+1endloopendfunctionfunction TryConsumeRecentPairRecord takes integer sourceId,integer targetId returns booleanlocal integer scanIndex=RecentEventIndex-1local real elapsedSinceEvent=0local real currentTime=(TimerGetElapsed(GameClockTimer))local integer scanCount=0loopexitwhen scanIndex==RecentEventIndex or elapsedSinceEvent>RecentEventWindowSeconds or scanCount>200if scanIndex==0 thenset scanIndex=8000-1endifset scanCount=scanCount+1set elapsedSinceEvent=currentTime-RecentEventTimestamp[scanIndex]if RecentEventSourceId[scanIndex]==sourceId and RecentEventTargetId[scanIndex]==targetId and elapsedSinceEvent<RecentEventWindowSeconds thenset RecentEventSourceId[scanIndex]=0set RecentEventTargetId[scanIndex]=0return trueendifset scanIndex=scanIndex-1endloopreturn falseendfunctionfunction RecordDamageForAssistLog takes nothing returns nothinglocal integer sourceId=GetPlayerId(GetOwningPlayer(GetEventDamageSource()))local integer targetId=GetPlayerId(GetOwningPlayer(GetTriggerUnit()))local real damage=GetEventDamage()set RecentEventTimestamp[RecentEventIndex]=(TimerGetElapsed(GameClockTimer))set RecentEventSourceId[RecentEventIndex]=sourceIdset RecentEventTargetId[RecentEventIndex]=targetIdset RecentEventIndex=RecentEventIndex+1if RecentEventIndex==8000 thenset RecentEventIndex=1endifendfunctionfunction AwardAssistsAndListNames takes unit victim,unit killer returns stringlocal integer slotIndex=1local integer victimId=GetPlayerId(GetOwningPlayer(victim))local integer killerId=GetPlayerId(GetOwningPlayer(killer))local integer assisterIdlocal string assistNamesText=" "+GetObjectName('n0JY')+" "local boolean hasAssister=falseloopexitwhen slotIndex>5if IsPlayerOnTeamZero(GetOwningPlayer(killer))thenset assisterId=GetPlayerId(SentinelPlayer[slotIndex])elseset assisterId=GetPlayerId(ScourgePlayer[slotIndex])endifif killerId!=assisterId and TryConsumeRecentPairRecord(assisterId,victimId)thenset PlayerAssistCount[assisterId]=PlayerAssistCount[assisterId]+1call StoreAndSyncDataInteger("Assist"+I2S(assisterId),victimId)if hasAssister thenset assistNamesText=assistNamesText+"/"+PlayerColorCode[assisterId]+(PlayerName[GetPlayerId((Player(assisterId)))])+"|r"elseset assistNamesText=assistNamesText+PlayerColorCode[assisterId]+(PlayerName[GetPlayerId((Player(assisterId)))])+"|r"endifset hasAssister=trueendifset slotIndex=slotIndex+1endloopif hasAssister thenreturn assistNamesTextendifreturn" "endfunctionfunction PlayerRecentlyDamagedPlayer takes integer sourceId,integer targetId returns booleanlocal integer scanIndex=RecentEventIndex-1local real elapsedSinceEvent=0local real currentTime=(TimerGetElapsed(GameClockTimer))local integer scanCount=0loopexitwhen scanIndex==RecentEventIndex or elapsedSinceEvent>RecentEventWindowSeconds or scanCount>200if scanIndex==0 thenset scanIndex=8000-1endifset scanCount=scanCount+1set elapsedSinceEvent=currentTime-RecentEventTimestamp[scanIndex]if RecentEventSourceId[scanIndex]==sourceId and RecentEventTargetId[scanIndex]==targetId and elapsedSinceEvent<RecentEventWindowSeconds thenreturn trueendifset scanIndex=scanIndex-1endloopreturn falseendfunctionfunction CollectAssistingPlayers takes unit victim,unit killer returns booleanlocal integer slotIndex=1local integer victimId=GetPlayerId(GetOwningPlayer(victim))local integer killerId=GetPlayerId(GetOwningPlayer(killer))local integer assisterIdlocal string assistNamesText=" Assists: "local boolean hasAssister=falselocal integer assisterIndex=1set RegisteredPlayer[1]=nullset RegisteredPlayer[2]=nullset RegisteredPlayer[3]=nullset RegisteredPlayer[4]=nullset RegisteredPlayer[5]=nullloopexitwhen slotIndex>5if IsPlayerOnTeamZero(GetOwningPlayer(killer))thenset assisterId=GetPlayerId(SentinelPlayer[slotIndex])elseset assisterId=GetPlayerId(ScourgePlayer[slotIndex])endifif killerId!=assisterId and PlayerRecentlyDamagedPlayer(assisterId,victimId)thenset RegisteredPlayer[assisterIndex]=Player(assisterId)set assisterIndex=assisterIndex+1set hasAssister=trueendifset slotIndex=slotIndex+1endloopreturn hasAssisterendfunctionfunction BuildAssisterNamesString takes unit victim,unit killer returns stringlocal integer slotIndex=1local integer victimId=GetPlayerId(GetOwningPlayer(victim))local integer killerId=GetPlayerId(GetOwningPlayer(killer))local integer assisterIdlocal string assistNamesText=""local boolean hasAssister=falseloopexitwhen slotIndex>5if IsPlayerOnTeamZero(GetOwningPlayer(killer))thenset assisterId=GetPlayerId(SentinelPlayer[slotIndex])elseset assisterId=GetPlayerId(ScourgePlayer[slotIndex])endifif killerId!=assisterId and PlayerRecentlyDamagedPlayer(assisterId,victimId)thenif hasAssister thenset assistNamesText=assistNamesText+"/"+PlayerColorCode[assisterId]+(PlayerName[GetPlayerId((Player(assisterId)))])+"|r"elseset assistNamesText=assistNamesText+PlayerColorCode[assisterId]+(PlayerName[GetPlayerId((Player(assisterId)))])+"|r"endifset hasAssister=trueendifset slotIndex=slotIndex+1endloopif hasAssister thenreturn assistNamesTextendifreturn" "endfunctionfunction CountAssistingPlayers takes unit victim,unit killer returns integerlocal integer slotIndex=1local integer victimId=GetPlayerId(GetOwningPlayer(victim))local integer killerId=GetPlayerId(GetOwningPlayer(killer))local integer assisterIdlocal integer assistCount=0loopexitwhen slotIndex>5if IsPlayerOnTeamZero(GetOwningPlayer(killer))thenset assisterId=GetPlayerId(SentinelPlayer[slotIndex])elseset assisterId=GetPlayerId(ScourgePlayer[slotIndex])endifif killerId!=assisterId and PlayerRecentlyDamagedPlayer(assisterId,victimId)thenset assistCount=assistCount+1endifset slotIndex=slotIndex+1endloopreturn assistCountendfunctionfunction IsUnitEitherSpecialType takes unit whichUnit returns booleanreturn GetUnitTypeId(whichUnit)=='H00I' or GetUnitTypeId(whichUnit)=='H00J'endfunctionfunction AnyOwnedHeroHasAbility takes unit whichUnit returns booleanlocal integer ownerId=GetHandleId(GetOwningPlayer(whichUnit))local unit hero1=(LoadUnitHandle(GameHashtable,(ownerId),(699)))local unit hero2=(LoadUnitHandle(GameHashtable,(ownerId),(700)))local unit hero3=(LoadUnitHandle(GameHashtable,(ownerId),(701)))local unit hero4=(LoadUnitHandle(GameHashtable,(ownerId),(702)))local unit hero5=(LoadUnitHandle(GameHashtable,(ownerId),(703)))if GetUnitAbilityLevel(hero1,'A0OV')!=0 or GetUnitAbilityLevel(hero2,'A0OV')!=0 or GetUnitAbilityLevel(hero3,'A0OV')!=0 or GetUnitAbilityLevel(hero4,'A0OV')!=0 or GetUnitAbilityLevel(hero5,'A0OV')!=0 thenreturn trueendifset hero1=nullset hero2=nullset hero3=nullset hero4=nullset hero5=nullreturn falseendfunctionfunction PlayerHeroHasChargedItem takes unit whichUnit returns booleanlocal integer slotIndex=0local integer ownerId=GetHandleId(GetOwningPlayer(whichUnit))local unit hero=(LoadUnitHandle(GameHashtable,(ownerId),(699)))loopexitwhen slotIndex>5if(GetItemTypeId(UnitItemInSlot(hero,slotIndex))==ItemTypeId[ItemIndexCost0Charged] and GetItemCharges(UnitItemInSlot(hero,slotIndex))>0) thenset hero=nullreturn trueendifset slotIndex=slotIndex+1endloopset hero=nullreturn falseendfunctionfunction ReviveAllPlayerHeroes takes unit whichUnit,location reviveLoc returns nothinglocal integer ownerId=GetHandleId(GetOwningPlayer(whichUnit))local unit hero1=(LoadUnitHandle(GameHashtable,(ownerId),(699)))local unit hero2=(LoadUnitHandle(GameHashtable,(ownerId),(700)))local unit hero3=(LoadUnitHandle(GameHashtable,(ownerId),(701)))local unit hero4=(LoadUnitHandle(GameHashtable,(ownerId),(702)))local unit hero5=(LoadUnitHandle(GameHashtable,(ownerId),(703)))if hero1!=null thencall ReviveHeroLoc(hero1,reviveLoc,true)call StripHeroAbilityEffects(hero1)endifif hero2!=null thencall ReviveHeroLoc(hero2,reviveLoc,true)call StripHeroAbilityEffects(hero2)endifif hero3!=null thencall ReviveHeroLoc(hero3,reviveLoc,true)call StripHeroAbilityEffects(hero3)endifif hero4!=null thencall ReviveHeroLoc(hero4,reviveLoc,true)call StripHeroAbilityEffects(hero4)endifif hero5!=null thencall ReviveHeroLoc(hero5,reviveLoc,true)call StripHeroAbilityEffects(hero5)endifset hero5=nullset hero4=nullset hero3=nullset hero2=nullset hero1=nullendfunctionfunction QueueRespawnEntry takes unit whichUnit,real delay,boolean flag returns nothingset ScheduledUnitCount=ScheduledUnitCount+1set ScheduledUnit[ScheduledUnitCount]=whichUnitset ScheduledUnitExpiry[ScheduledUnitCount]=TimerGetElapsed(GameClockTimer)+delayset ScheduledUnitFlag[ScheduledUnitCount]=flagendfunctionfunction ExecuteScheduledRespawn takes integer scheduledIndex returns nothinglocal unit whichUnit=ScheduledUnit[scheduledIndex]local player owner=GetOwningPlayer(whichUnit)local location respawnLocif IsPlayerOnTeamOne(owner)thenset respawnLoc=GetRectCenter(BaseCenterRectA)elseset respawnLoc=GetRectCenter(BaseCenterRectB)endifif ModeSelectionLocked==false and IsUnitDeadOrInvalid(whichUnit)thencall SelectAndPanIfNoneSelected(whichUnit,owner,GetLocationX(respawnLoc),GetLocationY(respawnLoc),true)if IsPickSelectorUnit(whichUnit)==false or GetUnitAbilityLevel(whichUnit,'A0MW')==0 thencall ReviveHeroLoc(whichUnit,respawnLoc,true)elsecall ReviveAllPlayerHeroes(whichUnit,respawnLoc)endifcall SetUnitState(whichUnit,UNIT_STATE_MANA,GetUnitState(whichUnit,UNIT_STATE_MAX_MANA))endifcall RemoveLocation(respawnLoc)call RemoveEntryAndCompactList(scheduledIndex)set whichUnit=nullset owner=nullset respawnLoc=nullendfunctionfunction ProcessRespawnQueue takes nothing returns booleanlocal real elapsedTime=GetElapsedGameTime()local integer queueIndexset queueIndex=1loopexitwhen queueIndex>ScheduledUnitCountif ScheduledUnitExpiry[queueIndex]<elapsedTime and ScheduledUnitExpiry[queueIndex]!=0 thencall ExecuteScheduledRespawn(queueIndex)endifif ScheduledUnitExpiry[queueIndex]!=0 and IsUnitDeadOrInvalid(ScheduledUnit[queueIndex])==false thenset ScheduledUnit[queueIndex]=nullset ScheduledUnitExpiry[queueIndex]=0set ScheduledUnitFlag[queueIndex]=falseendifset queueIndex=queueIndex+1endloopreturn falseendfunctionfunction BuildHeroNameMessage takes unit whichUnit returns stringlocal string message=GetObjectName('n0FO')set message=ReplaceFirstOccurrence(message,"$hero",PlayerColorCode[GetPlayerId(GetOwningPlayer(whichUnit))]+GetUnitName(whichUnit)+"|r")return messageendfunctionfunction AnnounceHeroToNonOwners takes unit whichUnit returns booleanif GetOwningPlayer(whichUnit)!=GetLocalPlayer()thencall DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,15,BuildHeroNameMessage(TrackedSideUnit[GetPlayerId(GetOwningPlayer(whichUnit))]))endifreturn falseendfunctionfunction AwardKillExperience takes unit killer,unit victim returns nothingif WidgetDistanceOrMax(killer,victim)>1300 or(IsUnitDeadOrInvalid(killer)and GetUnitTypeId(killer)=='H00K')thenif IsPlayerAlly(GetOwningPlayer(killer),GetOwningPlayer(victim))==false thencall AddHeroXP(killer,GetHeroLevelValue(victim),true)endifendifendfunctionfunction AddChargeToEnumUnitItem takes nothing returns nothingif UnitItemOfType(GetEnumUnit(),ItemTypeId[ItemIndexCost4900])!=null thencall SetItemCharges(UnitItemOfType(GetEnumUnit(),ItemTypeId[ItemIndexCost4900]),GetItemCharges(UnitItemOfType(GetEnumUnit(),ItemTypeId[ItemIndexCost4900]))+1)endifendfunctionfunction FilterEnemyHeroWithItem takes nothing returns booleanif(GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and IsUnitDeadOrInvalid(GetFilterUnit())==false)and IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO) and IsUnitIllusion(GetFilterUnit())==false thenif IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(FilterReferenceUnit_3))and UnitItemOfType(GetFilterUnit(),ItemTypeId[ItemIndexCost4900])!=null thenreturn trueendifendifreturn falseendfunctionfunction ChargeFirstEnemyHeroItem takes nothing returns booleanlocal item whichItemlocal integer chargesif FilterMatchCount==0 and(GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and IsUnitDeadOrInvalid(GetFilterUnit())==false)and IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO) and IsUnitIllusion(GetFilterUnit())==false and IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(EnemySearchOwnerUnit))thenif UnitItemOfType(GetFilterUnit(),ItemTypeId[ItemIndexCost875_3])!=null thenset FilterMatchCount=FilterMatchCount+1set charges=GetItemCharges(UnitItemOfType(GetFilterUnit(),ItemTypeId[ItemIndexCost875_3]))if charges==0 thenset charges=2elseset charges=charges+1endifcall SetItemCharges(UnitItemOfType(GetFilterUnit(),ItemTypeId[ItemIndexCost875_3]),charges)endifendifset whichItem=nullreturn falseendfunctionfunction AddChargeToNearbyEnemyHeroItems takes unit sourceUnit,unit targetUnit returns nothinglocal group enumGroup=AcquireGroupFromPool()set FilterReferenceUnit_3=sourceUnitcall GroupEnumUnitsInRange(enumGroup,GetUnitX(sourceUnit),GetUnitY(sourceUnit),1625,Condition(function FilterEnemyHeroWithItem))if IsUnitAlly(sourceUnit,GetOwningPlayer(targetUnit))==false thencall GroupAddUnit(enumGroup,targetUnit)endifcall ForGroup(enumGroup,function AddChargeToEnumUnitItem)call ReleaseGroupToPool(enumGroup)set enumGroup=nullendfunctionfunction UpdateSummonPursuit takes nothing returns booleanlocal trigger triggeringTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(triggeringTrigger)local unit summon=(LoadUnitHandle(GameHashtable,(handleId),(335)))local unit master=(LoadUnitHandle(GameHashtable,(handleId),(17)))local real targetXlocal real targetYlocal real angleif GetTriggerEventId()==EVENT_WIDGET_DEATH thencall FlushChildHashtable(GameHashtable,(handleId))call RecycleExpiringTrigger(triggeringTrigger)if GetTriggerUnit()!=summon thencall KillUnit(summon)endifelseset angle=GetUnitFacing(master)*bj_RADTODEGset targetX=GetUnitX(master)+75set targetY=GetUnitY(master)+75call SetUnitX(summon,targetX)call SetUnitY(summon,targetY)call IssueTargetOrderById(summon,851983,master)endifset triggeringTrigger=nullset summon=nullset master=nullreturn falseendfunctionfunction SetupSummonPursuit takes nothing returns booleanlocal trigger whichTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(whichTrigger)local unit caster=(LoadUnitHandle(GameHashtable,(handleId),(2)))local unit master=(LoadUnitHandle(GameHashtable,(handleId),(17)))local unit summonerDummy=(LoadUnitHandle(GameHashtable,(handleId),(19)))local unit summonif GetSummoningUnit()==summonerDummy thencall FlushChildHashtable(GameHashtable,(handleId))call RecycleExpiringTrigger(whichTrigger)set summon=GetSummonedUnit()set whichTrigger=CreateTrigger()set handleId=GetHandleId(whichTrigger)call TriggerRegisterDeathEvent(whichTrigger,summon)call TriggerRegisterDeathEvent(whichTrigger,master)call TriggerRegisterTimerEvent(whichTrigger,.05,true)call TriggerAddCondition(whichTrigger,Condition(function UpdateSummonPursuit))call SaveUnitHandle(GameHashtable,(handleId),(335),(summon))call SaveUnitHandle(GameHashtable,(handleId),(17),(master))call UnitAddAbility(summon,'Aloc')call SetUnitPosition(summon,GetUnitX(master)+100,GetUnitY(master)+100)call IssueTargetOrderById(summon,851983,master)call SetUnitMoveSpeed(summon,522)endifset whichTrigger=nullset master=nullset caster=nullset summonerDummy=nullreturn falseendfunctionfunction SpawnPursuingSummon takes unit caster,unit target returns nothinglocal unit master=targetlocal unit summonerDummylocal trigger whichTrigger=CreateTrigger()local integer handleId=GetHandleId(whichTrigger)if IsHeroWithAbilityA04R(master)thenset master=(TrackedSideUnit[GetPlayerId(GetOwningPlayer((master)))])endifset summonerDummy=CreateUnit(GetOwningPlayer(caster),'e00E',GetUnitX(master),GetUnitY(master),0)call RegisterPlayerUnitEventAllPlayers(whichTrigger,EVENT_PLAYER_UNIT_SUMMON)call TriggerAddCondition(whichTrigger,Condition(function SetupSummonPursuit))call SaveUnitHandle(GameHashtable,(handleId),(2),(caster))call SaveUnitHandle(GameHashtable,(handleId),(17),(master))call SaveUnitHandle(GameHashtable,(handleId),(19),(summonerDummy))call AddPermanentAbility(summonerDummy,'A2E7')call IssueTargetOrderById(summonerDummy,852274,master)set whichTrigger=nullset master=nullset summonerDummy=nullendfunctionfunction FilterAllyHeroWithItem takes nothing returns booleanif(GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and IsUnitDeadOrInvalid(GetFilterUnit())==false)and IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO) and IsUnitIllusion(GetFilterUnit())==false thenif IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(FilterReferenceUnit_3))==false and UnitItemOfType(GetFilterUnit(),ItemTypeId[ItemIndexEnemyCarried])!=null thenendifendifreturn falseendfunctionfunction ScanNearbyAllyHeroesWithItem takes unit sourceUnit returns nothinglocal group whichGroup=AcquireGroupFromPool()set FilterReferenceUnit_3=sourceUnitcall GroupEnumUnitsInRange(whichGroup,GetUnitX(sourceUnit),GetUnitY(sourceUnit),1625,Condition(function FilterAllyHeroWithItem))call ReleaseGroupToPool(whichGroup)set whichGroup=nullendfunctionfunction ScanUnitsNearUnit takes unit sourceUnit returns nothinglocal group whichGroup=AcquireGroupFromPool()set FilterMatchCount=0set EnemySearchOwnerUnit=sourceUnitcall GroupEnumUnitsInRange(whichGroup,GetUnitX(sourceUnit),GetUnitY(sourceUnit),1425,Condition(function ChargeFirstEnemyHeroItem))call ReleaseGroupToPool(whichGroup)set FilterMatchCount=0set whichGroup=nullendfunctionfunction OnTeamAnnouncementTimerExpire takes nothing returns booleanlocal trigger whichTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(whichTrigger)local integer teamId=(LoadInteger(GameHashtable,(handleId),(88)))local integer slotIndex=1local player whichPlayerlocal string messageloopexitwhen slotIndex>5if teamId==0 thenset whichPlayer=SentinelPlayer[slotIndex]set message=PlayerColorCode[GetPlayerId(SentinelPlayer[0])]+(GetObjectName(('n03N')))+"|r "+(GetObjectName(('n03P')))+" "+PlayerColorCode[GetPlayerId(SentinelPlayer[0])]+(GetObjectName(('n03Q')))+"|r"elseset whichPlayer=ScourgePlayer[slotIndex]set message=PlayerColorCode[GetPlayerId(ScourgePlayer[0])]+(GetObjectName(('n03O')))+"|r "+(GetObjectName(('n03P')))+" "+PlayerColorCode[GetPlayerId(ScourgePlayer[0])]+(GetObjectName(('n03Q')))+"|r"endifcall DisplayTimedTextToPlayer(whichPlayer,0,0,10,message)call PlaySoundForPlayerIfUnmuted(SoundOwnage,whichPlayer)set slotIndex=slotIndex+1endloopcall FlushChildHashtable(GameHashtable,handleId)call RecycleExpiringTrigger(whichTrigger)set whichTrigger=nullreturn falseendfunctionfunction ScheduleTeamAnnouncement takes integer teamId returns nothinglocal trigger whichTrigger=CreateTrigger()local integer handleId=GetHandleId(whichTrigger)call TriggerRegisterTimerEvent(whichTrigger,1.5,false)call TriggerAddCondition(whichTrigger,Condition(function OnTeamAnnouncementTimerExpire))call SaveInteger(GameHashtable,(handleId),(88),(teamId))set whichTrigger=nullendfunctionfunction OnDelayedSoundMessageExpire takes nothing returns booleanlocal trigger whichTrigger=GetTriggeringTrigger()local integer 