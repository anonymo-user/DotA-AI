+rangeBonus,Condition(function FilterOwnedItemCarrierPreferHero))if FilterReferenceUnitB==null thenset EnumParamIntA=0call ReleaseGroupToPool(searchGroup)set searchGroup=AcquireGroupFromPool()call GroupEnumUnitsInRange(searchGroup,GetUnitX(ItemCarrierSearchCenterUnit),GetUnitY(ItemCarrierSearchCenterUnit),1100+rangeBonus,Condition(function FilterSharedControlItemCarrier))if EnumParamIntA>1 thenset FilterReferenceUnitB=nullendifendifcall ReleaseGroupToPool(searchGroup)set searchGroup=nullreturn FilterReferenceUnitBendfunctionfunction GiveItemToUnitOrDrop takes player owner,unit sourceUnit,unit searchCenterUnit,integer itemIndex,real dropX,real dropY,integer charges,integer userData returns nothinglocal unit carrierUnitlocal item createdItem=nullset ItemCarrierSearchCenterUnit=searchCenterUnitif GetUnitPointValue(sourceUnit)==200 thenset carrierUnit=FindNearbyItemCarrier(sourceUnit,0)if carrierUnit==null thenset carrierUnit=FindNearbyItemCarrier(sourceUnit,300)endifelseset carrierUnit=sourceUnitendifset TempItemOwnerPlayer=ownerif carrierUnit==null or AttemptRecipeCombine(owner,carrierUnit,ResolveRemappedIndex(itemIndex))==false or ModeEnabledFlag==false thenif IsItemTypeInGroupB(ResolveRemappedIndex(itemIndex))thenif CountEmptyInventorySlots(carrierUnit)==0 or carrierUnit==null thencall ScheduleDeferredPlayerItemCreate(ItemTypeIdTableA[itemIndex],dropX,dropY,owner,true,charges)elseset createdItem=UnitAddItemById(carrierUnit,ItemTypeId[itemIndex])call SetItemCharges(createdItem,charges)call SetItemPlayer(createdItem,owner,true)call SetItemUserData(createdItem,userData)endifelseif IsItemTypeInGroupA(ResolveRemappedIndex(itemIndex))thenif carrierUnit==null or(CountEmptyInventorySlots(carrierUnit)==0 and UnitItemOfType(carrierUnit,ItemTypeId[itemIndex])==null)thencall ScheduleDeferredPlayerItemCreate(ItemTypeIdTableA[itemIndex],dropX,dropY,owner,true,GetItemTypeWeight(itemIndex))elseset createdItem=CreateItem(ItemTypeIdTableA[itemIndex],dropX,dropY)call SetItemPlayer(createdItem,owner,true)call SetItemUserData(createdItem,userData)call SetItemCharges(createdItem,GetItemTypeWeight(itemIndex))call UnitAddItem(carrierUnit,createdItem)endifelseif CountEmptyInventorySlots(carrierUnit)==0 or carrierUnit==null thencall ScheduleDeferredPlayerItemCreate(ItemTypeIdTableA[itemIndex],dropX,dropY,owner,false,0)elseset createdItem=UnitAddItemById(carrierUnit,ItemTypeId[itemIndex])call SetItemPlayer(createdItem,owner,true)call SetItemUserData(createdItem,0)endifendifelseif IsUnitType(carrierUnit,UNIT_TYPE_HERO)==true thenif userData==0 thencall StoreAndSyncDataInteger("PUI_"+I2S(GetPlayerId(GetOwningPlayer(carrierUnit))),ItemTypeId[ResolveRemappedIndex(itemIndex)])endifendifendifif createdItem!=null thenset HeroInventoryItem[288+GetPlayerId(owner)]=createdItemendifset carrierUnit=nullset createdItem=nullendfunctionfunction OnGlyphBuffExpire takes nothing returns booleanlocal trigger expiryTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(expiryTrigger)local unit buffedUnit=(LoadUnitHandle(GameHashtable,(handleId),(134)))if buffedUnit==null thencall FlushChildHashtable(GameHashtable,handleId)call RecycleExpiringTrigger(expiryTrigger)return falseendifif GetTriggerEventId()!=EVENT_UNIT_DEATH thencall UnitRemoveAbility(buffedUnit,'A17R')call UnitRemoveAbility(buffedUnit,'A24F')endifcall DestroyEffect((LoadEffectHandle(GameHashtable,(handleId),(32))))call FlushChildHashtable(GameHashtable,handleId)call RecycleExpiringTrigger(expiryTrigger)set expiryTrigger=nullset buffedUnit=nullreturn falseendfunctionfunction FilterAlliedStructureForGlyph takes nothing returns booleanreturn IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)and GetUnitState(GetFilterUnit(),UNIT_STATE_LIFE)>.5 and IsUnitAlly(GetFilterUnit(),AlliedStructureEnumPlayer) and GetOwningPlayer(GetFilterUnit())!=NeutralPassivePlayer and GetUnitTypeId(GetFilterUnit())!='ncop' and GetUnitTypeId(GetFilterUnit())!='n0FJ' and GetUnitTypeId(GetFilterUnit())!='n0FI' and GetUnitTypeId(GetFilterUnit())!='n0F6' and GetUnitTypeId(GetFilterUnit())!='n0FH'endfunctionfunction EnumApplyGlyphToStructure takes nothing returns nothinglocal trigger buffTrigger=CreateTrigger()local integer triggerId=GetHandleId(buffTrigger)local unit structureUnit=GetEnumUnit()local string effectPathcall UnitAddAbility(structureUnit,'A17R')call UnitAddAbility(structureUnit,'A24F')if IsPlayerOnTeamZero(AlliedStructureEnumPlayer)thenset effectPath="effects\\GlyphSent.mdx"elseset effectPath="effects\\GlyphScourge.mdx"endifcall SaveEffectHandle(GameHashtable,(triggerId),(32),(AddSpecialEffectTarget(effectPath,structureUnit,"origin")))call SaveUnitHandle(GameHashtable,(triggerId),(134),(structureUnit))call TriggerRegisterUnitEvent(buffTrigger,structureUnit,EVENT_UNIT_DEATH)call TriggerRegisterTimerEvent(buffTrigger,InitialTimerDelay,false)call TriggerAddCondition(buffTrigger,Condition(function OnGlyphBuffExpire))set buffTrigger=nullset structureUnit=nullendfunctionfunction OrderTeamBaseStructuresExceptCaster takes unit casterUnit,player owningPlayer returns nothinglocal integer playerSlotif IsPlayerOnTeamZero(owningPlayer)thenset playerSlot=1if casterUnit!=PlayerControlUnit[playerSlot]thencall IssueImmediateOrderById(PlayerControlUnit[playerSlot],852244)endifset playerSlot=2if casterUnit!=PlayerControlUnit[playerSlot]thencall IssueImmediateOrderById(PlayerControlUnit[playerSlot],852244)endifset playerSlot=3if casterUnit!=PlayerControlUnit[playerSlot]thencall IssueImmediateOrderById(PlayerControlUnit[playerSlot],852244)endifset playerSlot=4if casterUnit!=PlayerControlUnit[playerSlot]thencall IssueImmediateOrderById(PlayerControlUnit[playerSlot],852244)endifset playerSlot=5if casterUnit!=PlayerControlUnit[playerSlot]thencall IssueImmediateOrderById(PlayerControlUnit[playerSlot],852244)endifelseset playerSlot=7if casterUnit!=PlayerControlUnit[playerSlot]thencall IssueImmediateOrderById(PlayerControlUnit[playerSlot],852244)endifset playerSlot=8if casterUnit!=PlayerControlUnit[playerSlot]thencall IssueImmediateOrderById(PlayerControlUnit[playerSlot],852244)endifset playerSlot=9if casterUnit!=PlayerControlUnit[playerSlot]thencall IssueImmediateOrderById(PlayerControlUnit[playerSlot],852244)endifset playerSlot=10if casterUnit!=PlayerControlUnit[playerSlot]thencall IssueImmediateOrderById(PlayerControlUnit[playerSlot],852244)endifset playerSlot=11if casterUnit!=PlayerControlUnit[playerSlot]thencall IssueImmediateOrderById(PlayerControlUnit[playerSlot],852244)endifendifendfunctionfunction CastGlyphOfFortification takes nothing returns nothinglocal group structureGrouplocal unit casterUnit=GetTriggerUnit()local player owningPlayer=GetOwningPlayer(casterUnit)if(IsPlayerOnTeamZero(owningPlayer)and TeamZeroActionDone==false)or(IsPlayerOnTeamZero(owningPlayer)==false and TeamOneActionDone==false)thenset structureGroup=AcquireGroupFromPool()set AlliedStructureEnumPlayer=owningPlayercall GroupEnumUnitsInRange(structureGroup,0,0,12000,Condition(function FilterAlliedStructureForGlyph))call ForGroup(structureGroup,function EnumApplyGlyphToStructure)call ReleaseGroupToPool(structureGroup)if IsPlayerOnTeamZero(owningPlayer)thenset TeamZeroActionDone=truecall OrderTeamBaseStructuresExceptCaster(casterUnit,owningPlayer)set TeamZeroActionDone=falsecall StoreRealByName(AiGameCacheKey,"AI|Glyph|Sent",ElapsedGameSeconds+300.)elseset TeamOneActionDone=truecall OrderTeamBaseStructuresExceptCaster(casterUnit,owningPlayer)set TeamOneActionDone=falsecall StoreRealByName(AiGameCacheKey,"AI|Glyph|Scrg",ElapsedGameSeconds+300.)endifendifset structureGroup=nullset casterUnit=nullset owningPlayer=nullendfunctionfunction OnGlyphSpellEffect takes nothing returns nothingif GetSpellAbilityId()=='A141' or GetSpellAbilityId()=='A1WI' thencall CastGlyphOfFortification()endifendfunctionfunction TallyItemBuildScore takes player whichPlayer,integer itemIndex returns nothinglocal integer playerId=GetPlayerId(whichPlayer)if itemIndex==ItemIndexGold50 thenset PlayerKillCount_2[playerId]=PlayerKillCount_2[playerId]+1elseif itemIndex==ItemIndexGold110 thenset PlayerKillCount_2[playerId]=PlayerKillCount_2[playerId]+1elseif itemIndex==ItemIndexGold125 thenset PlayerKillCount_2[playerId]=PlayerKillCount_2[playerId]+4elseif itemIndex==ItemIndexGold150 thenset PlayerKillCount_2[playerId]=PlayerKillCount_2[playerId]+2set PlayerMultiboardScore[playerId]=PlayerMultiboardScore[playerId]+2elseif itemIndex==ItemIndexTruesight thenset PlayerKillCount_2[playerId]=PlayerKillCount_2[playerId]+2set PlayerMultiboardScore[playerId]=PlayerMultiboardScore[playerId]+2elseif itemIndex==ItemIndexGold100A thenset PlayerKillCount_2[playerId]=PlayerKillCount_2[playerId]+1elseif itemIndex==ItemIndexGold100PointUse thenset PlayerKillCount_2[playerId]=PlayerKillCount_2[playerId]+1elseif itemIndex==ItemIndexGold180 thenset PlayerKillCount_2[playerId]=PlayerKillCount_2[playerId]+2elseif itemIndex==ItemIndexGold200A thenset PlayerKillCount_2[playerId]=PlayerKillCount_2[playerId]+2elseif itemIndex==ItemIndexUnclassifiedLB thenset PlayerKillCount_2[playerId]=PlayerKillCount_2[playerId]+2endifendfunctionfunction IsShopPurchaseAllowedForUnit takes unit shopUnit,unit buyerUnit returns booleanlocal integer itemIndexif GetUnitTypeId(buyerUnit)=='N0MM' thenreturn trueendifif(shopUnit==NeutralStockShop or shopUnit==NeutralBuildingC35)and IsUnitAlly(buyerUnit,ScourgePlayer[0])thenreturn falseelseif(shopUnit==NeutralShopWithStock or shopUnit==NeutralShop1)and IsUnitAlly(buyerUnit,SentinelPlayer[0])thenreturn falseendifset itemIndex=IndexOfUnitTypeInTable(buyerUnit)if itemIndex==ItemIndexGold150 or itemIndex==ItemIndexCost900A or itemIndex==ItemIndexGold100B thenreturn trueendifreturn falseendfunctionfunction GetItemReturnPointX takes unit shopUnit,unit heroUnit returns re