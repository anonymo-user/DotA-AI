Count(markedUnit)call DestroyEffect((LoadEffectHandle(GameHashtable,triggerId,(32))))call FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(tickTrigger)endifset tickTrigger=nullset markedUnit=nullreturn falseendfunctionfunction ApplyA2K4Mark takes nothing returns nothinglocal unit casterUnit=GetTriggerUnit()local unit targetUnit=GetSpellTargetUnit()local unit tempUnitlocal integer markStacks=2local real markDuration=4.5local trigger markTrigger=CreateTrigger()local integer triggerId=GetHandleId(markTrigger)if IsUnitType(targetUnit,UNIT_TYPE_MELEE_ATTACKER) thenset markStacks=1set markDuration=3endifcall AddAbunRefCount(targetUnit)call TriggerRegisterTimerEvent(markTrigger,.1,true)call TriggerRegisterDeathEvent(markTrigger,targetUnit)call TriggerAddCondition(markTrigger,Condition(function OnA2K4MarkExpireTick))call SaveUnitHandle(GameHashtable,triggerId,(17),(targetUnit))call SaveInteger(GameHashtable,triggerId,(34),(R2I(markDuration*10)))call SaveEffectHandle(GameHashtable,triggerId,(32),(AddSpecialEffectTarget("Abilities\\Spells\\Other\\TalkToMe\\TalkToMe.mdl",targetUnit,"overhead")))set casterUnit=nullset targetUnit=nullset tempUnit=nullendfunctionfunction OnCastAbilityA2K4 takes nothing returns nothingif GetSpellAbilityId()=='A2K4' and HasAnyMarkedAbility(GetSpellTargetUnit())==false thencall ApplyA2K4Mark()endifendfunctionfunction DealMarkedTargetTierDamage takes integer tierLevel,unit sourceUnit,unit targetUnit returns nothingcall DamageTargetByType(sourceUnit,targetUnit,DamageType1,300+100*tierLevel)endfunctionfunction OnCastMarkedDamageTiers takes nothing returns nothinglocal integer damageTier=0if GetSpellAbilityId()=='A02O' thenset damageTier=1endifif GetSpellAbilityId()=='A08Y' thenset damageTier=2endifif GetSpellAbilityId()=='A08Z' thenset damageTier=3endifif GetSpellAbilityId()=='A090' thenset damageTier=4endifif GetSpellAbilityId()=='A092' thenset damageTier=5endifif damageTier>0 and HasAnyMarkedAbility(GetSpellTargetUnit())==false thencall DealMarkedTargetTierDamage(damageTier,GetTriggerUnit(),GetSpellTargetUnit())endifendfunctionfunction OnCastAbilityA2HQ takes nothing returns nothingif GetSpellAbilityId()=='A2HQ' thencall SpawnPursuingSummon(GetTriggerUnit(),GetSpellTargetUnit())endifendfunctionfunction SpawnTimedSummonAt takes unit ownerUnit,integer summonTypeId,real spawnX,real spawnY returns nothinglocal unit summonUnit=CreateUnit(GetOwningPlayer(ownerUnit),summonTypeId,spawnX,spawnY,0)call UnitApplyTimedLife(summonUnit,'BTLF',15)set summonUnit=nullendfunctionfunction OnCastSummonUnitAtTree takes nothing returns nothinglocal unit summonedUnitlocal real treeXlocal real treeYif GetSpellAbilityId()=='A1ZL' thenset treeX=GetDestructableX(GetSpellTargetDestructable())set treeY=GetDestructableY(GetSpellTargetDestructable())call SpawnTimedSummonAt(GetTriggerUnit(),'n0LM',treeX,treeY)elseif GetSpellAbilityId()=='A1ZM' thenset treeX=GetDestructableX(GetSpellTargetDestructable())set treeY=GetDestructableY(GetSpellTargetDestructable())call SpawnTimedSummonAt(GetTriggerUnit(),'n0LN',treeX,treeY)endifset summonedUnit=nullendfunctionfunction OnA308EnemyBondExpire takes nothing returns booleanlocal trigger tickTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(tickTrigger)local unit casterUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local unit targetUnit=(LoadUnitHandle(GameHashtable,(triggerId),(17)))if casterUnit==null thencall FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(tickTrigger)return falseendifcall UnitRemoveAbility(casterUnit,'A308')call UnitRemoveAbility(targetUnit,'A308')call DestroyEffect((LoadEffectHandle(GameHashtable,(triggerId),(175))))call DestroyEffect((LoadEffectHandle(GameHashtable,(triggerId),(176))))call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(tickTrigger)set tickTrigger=nullset casterUnit=nullset targetUnit=nullreturn falseendfunctionfunction OnA308A309AllyBondExpire takes nothing returns booleanlocal trigger tickTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(tickTrigger)local unit casterUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local unit allyUnit=(LoadUnitHandle(GameHashtable,(triggerId),(17)))if casterUnit==null thencall FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(tickTrigger)return falseendifcall UnitRemoveAbility(casterUnit,'A308')call UnitRemoveAbility(allyUnit,'A309')call DestroyEffect((LoadEffectHandle(GameHashtable,(triggerId),(175))))call DestroyEffect((LoadEffectHandle(GameHashtable,(triggerId),(176))))call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(tickTrigger)set tickTrigger=nullset casterUnit=nullset allyUnit=nullreturn falseendfunctionfunction ApplyA1ZILinkBond takes nothing returns nothinglocal trigger whichTrigger=CreateTrigger()local integer triggerId=GetHandleId(whichTrigger)if IsUnitAlly(GetSpellTargetUnit(),GetOwningPlayer(GetTriggerUnit()))==false thenset whichTrigger=CreateTrigger()set triggerId=GetHandleId(whichTrigger)call TriggerRegisterTimerEvent(whichTrigger,7,false)call TriggerAddCondition(whichTrigger,Condition(function OnA308EnemyBondExpire))call SaveUnitHandle(GameHashtable,(triggerId),(2),(GetTriggerUnit()))call SaveUnitHandle(GameHashtable,(triggerId),(17),(GetSpellTargetUnit()))call SaveEffectHandle(GameHashtable,(triggerId),(175),(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\Cripple\\CrippleTarget.mdl",GetSpellTargetUnit(),"chest")))call SaveEffectHandle(GameHashtable,(triggerId),(176),(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\Cripple\\CrippleTarget.mdl",GetTriggerUnit(),"chest")))call UnitAddAbility(GetTriggerUnit(),'A308')call UnitAddAbility(GetSpellTargetUnit(),'A308')call UnitMakeAbilityPermanent(GetTriggerUnit(),true,'A308')call UnitMakeAbilityPermanent(GetSpellTargetUnit(),true,'A308')elseset whichTrigger=CreateTrigger()set triggerId=GetHandleId(whichTrigger)call TriggerRegisterTimerEvent(whichTrigger,7,false)call TriggerAddCondition(whichTrigger,Condition(function OnA308A309AllyBondExpire))call SaveUnitHandle(GameHashtable,(triggerId),(2),(GetTriggerUnit()))call SaveUnitHandle(GameHashtable,(triggerId),(17),(GetSpellTargetUnit()))call SaveEffectHandle(GameHashtable,(triggerId),(175),(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\Cripple\\CrippleTarget.mdl",GetSpellTargetUnit(),"chest")))call SaveEffectHandle(GameHashtable,(triggerId),(176),(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\Cripple\\CrippleTarget.mdl",GetTriggerUnit(),"chest")))call UnitAddAbility(GetTriggerUnit(),'A308')call UnitAddAbility(GetSpellTargetUnit(),'A309')call UnitMakeAbilityPermanent(GetTriggerUnit(),true,'A308')call UnitMakeAbilityPermanent(GetSpellTargetUnit(),true,'A309')endifset whichTrigger=nullendfunctionfunction OnCastAbilityA1ZI takes nothing returns nothingif GetSpellAbilityId()=='A1ZI' thencall ApplyA1ZILinkBond()endifendfunctionfunction OnCastAIplAIprSelfRedirect takes nothing returns nothinglocal unit casterUnit=GetTriggerUnit()local unit spellTargetUnit=GetSpellTargetUnit()local unit dummyUnitif GetSpellTargetUnit()==null thenif GetSpellAbilityId()=='AIpl' thenset dummyUnit=CreateUnit(GetOwningPlayer(casterUnit),'e00E',GetUnitX(casterUnit),GetUnitY(casterUnit),0)call UnitAddAbility(dummyUnit,'A1WA')call IssueTargetOrderById(dummyUnit,852609,casterUnit)set dummyUnit=nullelseif GetSpellAbilityId()=='AIpr' thenset dummyUnit=CreateUnit(GetOwningPlayer(casterUnit),'e00E',GetUnitX(casterUnit),GetUnitY(casterUnit),0)call UnitAddAbility(dummyUnit,'AIpr')call IssueTargetOrderById(dummyUnit,852609,casterUnit)set dummyUnit=nullendifendifset casterUnit=nullset spellTargetUnit=nullendfunctionfunction OnCastAbilityAIplOrAIpr takes nothing returns nothingif GetSpellAbilityId()=='AIpl' or GetSpellAbilityId()=='AIpr' thencall OnCastAIplAIprSelfRedirect()endifendfunctionfunction OnTrackedTargetDeathAwardBounty takes nothing returns booleanlocal trigger whichTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(whichTrigger)local unit caster=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local unit targetUnit=(LoadUnitHandle(GameHashtable,(triggerId),(17)))local integer targetLevel=(LoadInteger(GameHashtable,(triggerId),(34)))if(GetTriggerEventId()==EVENT_UNIT_DEATH and GetKillingUnit()==caster)or(GetTriggerEventId()==EVENT_UNIT_DAMAGED and GetUnitAbilityLevel(targetUnit,'B0ES')>0)thencall DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl",GetUnitX(targetUnit),GetUnitY(targetUnit)))call AddHeroXP(caster,R2I(GetLevelLookupValue(targetLevel)*2.5),true)call AwardGoldWithFloatingText(GetOwningPlayer(caster),targetUnit,190)set PlayerMinGold[GetPlayerId(GetOwningPlayer(caster))]=PlayerMinGold[GetPlayerId(GetOwningPlayer(caster))]+190set PlayerSavedGold[GetPlayerId(GetOwningPlayer(caster))]=PlayerSavedGold[GetPlayerId(GetOwningPlayer(caster))]+190call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(whichTrigger)call KillUnit(targetUnit)endifset whichTrigger=nullset caster=nullset targetUnit=nullreturn falseendfunctionfunction RegisterTrackBountyWatch takes nothing returns nothinglocal trigger whichTrigger=CreateTrigger()local integer triggerId=GetHandleId(whichTrigger)local unit caster=GetTriggerUnit()local unit targetUnit=GetSpellTargetUnit()local integer targetLevel=GetUnitLevel(targetUnit)call SaveUnitHandle(GameHashtable,(triggerId),(2),(caster))call SaveUnitHandle(GameHashtable,(triggerId),(17),(targetUnit))call SaveInteger(GameHashtable,(triggerId),(34),(targetLevel))call TriggerRegisterUnitEvent(whichTrigger,targetUnit,EVENT_UNIT_DEATH)call TriggerRegisterUnitEvent(whichTrigger,targetUnit,EVENT_UNIT_DAMAGED)call TriggerAddCondition(whichTrigger,Condition(function OnTrackedTargetDeathAwardBounty))set whichTrigger=nullset caster=nullset targetUnit=nullendfunctionfunction OnCastA28YTrack takes nothing returns nothingif GetSpellAbilityId()=='A28Y' thencall RegisterTrackBountyWatch()endifendfunctionfunction OnBorrowedManaTimerReclaimUnused takes nothing returns booleanlocal trigger tickTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(tickTrigger)local unit casterUnit=(LoadUnitHandle(GameHashtable,(handleId),(2)))local real borrowedMana=(LoadReal(GameHashtable,(handleId),(242)))local real reclaimedMana=(LoadReal(GameHashtable,(handleId),(529)))local real remainingBorrowed=(LoadReal(GameHashtable,(handleId),(530)))local real currentMana=GetUnitState(casterUnit,UNIT_STATE_MANA)local real maxMana=GetUnitState(casterUnit,UNIT_STATE_MAX_MANA)local real prevManaPercent=(LoadReal(GameHashtable,(handleId),(668)))local real currentManaPercent=GetUnitStatePercent(casterUnit,UNIT_STATE_MANA,UNIT_STATE_MAX_MANA)local real manaPercentDelta=(prevManaPercent-currentManaPercent)/100if GetTriggerEventId()==EVENT_UNIT_DEATH thencall FlushChildHashtable(GameHashtable,(handleId))call RecycleExpiringTrigger(tickTrigger)elseif GetTriggerEvalCount(tickTrigger)==20*10 thencall FlushChildHashtable(GameHashtable,(handleId))call RecycleExpiringTrigger(tickTrigger)if reclaimedMana<150 thencall SetUnitState(casterUnit,UNIT_STATE_MANA,currentMana-(150-reclaimedMana-remainingBorrowed))endifelseif manaPercentDelta>0 thenset reclaimedMana=reclaimedMana+manaPercentDelta*maxManaif remainingBorrowed>0 thenif manaPercentDelta*maxMana>remainingBorrowed thencall SetUnitState(casterUnit,UNIT_STATE_MANA,currentMana+remainingBorrowed)set remainingBorrowed=0elseif remainingBorrowed>(maxMana-currentMana)thenset remainingBorrowed=remainingBorrowed-(maxMana-currentMana)call SetUnitState(casterUnit,UNIT_STATE_MANA,maxMana)elseset remainingBorrowed=remainingBorrowed-manaPercentDelta*maxManacall SetUnitState(casterUnit,UNIT_STATE_MANA,currentMana+manaPercentDelta*maxMana)endifendifendifendifset prevManaPercent=currentManaPercentcall SaveReal(GameHashtable,(handleId),(668),((prevManaPercent)*1.))call SaveReal(GameHashtable,(handleId),(529),((reclaimedMana)*1.))call SaveReal(GameHashtable,(handleId),(530),((remainingBorrowed)*1.))endifset tickTrigger=nullset casterUnit=nullreturn falseendfunctionfunction GrantTemporaryManaForLife takes nothing returns nothinglocal unit caster=GetTriggerUnit()local real currentLife=GetUnitState(caster,UNIT_STATE_LIFE)local trigger whichTrigger=CreateTrigger()local integer triggerId=GetHandleId(whichTrigger)local real currentMana=GetUnitState(caster,UNIT_STATE_MANA)if currentLife>151 thencall SetUnitState(caster,UNIT_STATE_LIFE,currentLife-150)elsecall SetUnitState(caster,UNIT_STATE_LIFE,1)endifcall CreateTimedEffectOnUnitUntilDeath("Abilities\\Spells\\Orc\\SpiritLink\\SpiritLinkZapTarget.mdl",caster,"origin",2)call SetUnitState(caster,UNIT_STATE_MANA,currentMana+150)call TriggerRegisterTimerEvent(whichTrigger,.05,true)call TriggerRegisterUnitEvent(whichTrigger,caster,EVENT_UNIT_DEATH)call TriggerAddCondition(whichTrigger,Condition(function OnBorrowedManaTimerReclaimUnused))call SaveUnitHandle(GameHashtable,(triggerId),(2),(caster))call SaveReal(GameHashtable,(triggerId),(242),((GetUnitState(caster,UNIT_STATE_MANA))*1.))call SaveReal(GameHashtable,(triggerId),(529),((0)*1.))call SaveReal(GameHashtable,(triggerId),(668),((GetUnitStatePercent(caster,UNIT_STATE_MANA,UNIT_STATE_MAX_MANA))*1.))if(currentMana+150)>GetUnitState(caster,UNIT_STATE_MAX_MANA)thencall SaveReal(GameHashtable,(triggerId),(530),(((currentMana+150)-GetUnitState(caster,UNIT_STATE_MAX_MANA))*1.))endifset caster=nullendfunctionfunction OnCastA1Q8LifeForMana takes nothing returns nothingif GetSpellAbilityId()=='A1Q8' thencall GrantTemporaryManaForLife()endifendfunctionfunction OnTimerRemoveA1QCAndB0CY takes nothing returns booleanlocal trigger expireTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(expireTrigger)local unit buffedUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))if buffedUnit==null thencall FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(expireTrigger)return falseendifif GetTriggerEvalCount(expireTrigger)>30 or GetTriggerEventId()==EVENT_UNIT_DEATH thencall UnitRemoveAbility(buffedUnit,'A1QC')call UnitRemoveAbility(buffedUnit,'B0CY')call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(expireTrigger)endifset buffedUnit=nullset expireTrigger=nullreturn falseendfunctionfunction OnTimerRemoveAetlAbility takes nothing returns booleanlocal trigger tickTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(tickTrigger)local unit ownerUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local integer durationSeconds=(LoadInteger(GameHashtable,(triggerId),(34)))if ownerUnit==null thencall FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(tickTrigger)return falseendifif GetTriggerEvalCount(tickTrigger)>durationSeconds/.1 or GetTriggerEventId()==EVENT_UNIT_DEATH or((LoadInteger(GameHashtable,(GetHandleId((ownerUnit))),((4256))))==1)thencall UnitRemoveAbility(ownerUnit,'Aetl')call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(tickTrigger)endifset ownerUnit=nullset tickTrigger=nullreturn falseendfunctionfunction ApplyTimedAetlAbility takes unit whichUnit,integer abilityLevel returns nothinglocal unit targetUnit=whichUnitlocal trigger whichTrigger=CreateTrigger()local integer triggerId=GetHandleId(whichTrigger)call UnitAddAbility(targetUnit,'Aetl')call UnitMakeAbilityPermanent(targetUnit,true,'Aetl')call SetPlayerAbilityAvailable(GetOwningPlayer(targetUnit),'Aetl',false)call TriggerRegisterTimerEvent(whichTrigger,.1,true)call TriggerRegisterUnitEvent(whichTrigger,targetUnit,EVENT_UNIT_DEATH)call TriggerAddCondition(whichTrigger,Condition(function OnTimerRemoveAetlAbility))call SaveUnitHandle(GameHashtable,(triggerId),(2),(targetUnit))call SaveInteger(GameHashtable,(triggerId),(34),(abilityLevel))set targetUnit=nullset whichTrigger=nullendfunctionfunction OnA1QDProjectileImpact takes nothing returns nothinglocal integer triggerId=GetHandleId(GetTriggeringTrigger())local unit sourceUnit=FilterReferenceUnit_2local unit targetUnit=FilterReferenceUnitBlocal real damageAmount=(LoadReal(GameHashtable,(triggerId),(20)))local trigger buffTriggerlocal integer aetlLevel=3if sourceUnit==targetUnit thenset aetlLevel=4endifif IsPlayerAlly(GetOwningPlayer(targetUnit),GetOwningPlayer(sourceUnit)) and sourceUnit!=targetUnit thencall ApplyTimedAetlAbility(targetUnit,4)elseif sourceUnit!=targetUnit thenset buffTrigger=CreateTrigger()set triggerId=GetHandleId(buffTrigger)call SetPlayerAbilityAvailable(GetOwningPlayer(targetUnit),'A1QC',false)call UnitAddAbility(targetUnit,'A1QC')call UnitMakeAbilityPermanent(targetUnit,true,'A1QC')call TriggerRegisterTimerEvent(buffTrigger,.1,true)call TriggerRegisterUnitEvent(buffTrigger,targetUnit,EVENT_UNIT_DEATH)call TriggerAddCondition(buffTrigger,Condition(function OnTimerRemoveA1QCAndB0CY))call SaveUnitHandle(GameHashtable,(triggerId),(2),(targetUnit))call ApplyTimedAetlAbility(targetUnit,aetlLevel)call CreateTimedTextTagOnUnit("+"+I2S(R2I(damageAmount)),2,targetUnit,.027,3,216,120,216)call DamageTargetByType(sourceUnit,targetUnit,DamageType1,damageAmount)endifcall ApplyTimedAetlAbility(sourceUnit,aetlLevel)set sourceUnit=nullset targetUnit=nullendfunctionfunction LaunchA1QDAttributeProjectile takes nothing returns nothinglocal unit caster=GetTriggerUnit()local unit target=GetSpellTargetUnit()local trigger projectileTrigger=LaunchHomingProjectile(caster,target,'h0BS',"OnA1QDProjectileImpact",1000,false)local integer projectileId=GetHandleId(projectileTrigger)local integer primaryAttribute=GetHeroPrimaryAttributeType(caster)local real