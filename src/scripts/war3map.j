troller(aiPlayer)==MAP_CONTROL_COMPUTER)and(TrackedSideUnit[GetPlayerId(aiPlayer)]==null))thenif(GameModeFlagX)thenset poolStart=CachedLoopIndexset poolEnd=HeroPoolLoopBoundCelseif(IsPlayerOnTeamZero(aiPlayer))thenset poolStart=CachedLoopIndexset poolEnd=HeroPoolLoopBoundAelseset poolStart=HeroPoolLoopStartBset poolEnd=HeroPoolLoopBoundCendifif(IsPlayerOnTeamZero(aiPlayer))thenset spawnX=GetRandomReal(GetRectMinX(BaseCenterRectB),GetRectMaxX(BaseCenterRectB))set spawnY=GetRandomReal(GetRectMinY(BaseCenterRectB),GetRectMaxY(BaseCenterRectB))elseset spawnX=GetRandomReal(GetRectMinX(BaseCenterRectA),GetRectMaxX(BaseCenterRectA))set spawnY=GetRandomReal(GetRectMinY(BaseCenterRectA),GetRectMaxY(BaseCenterRectA))endifset PlayerLaneRole[GetPlayerId(aiPlayer)]=0loopset randomHeroIndex=GetRandomInt(poolStart,poolEnd)if((RestrictedTechId[randomHeroIndex]!=0)and(not PointValueClaimed[randomHeroIndex])and(HeroMatchesRoleCategory(RestrictedTechId[randomHeroIndex],roleCategory)or attempts>20))thenif IsDebugMode thenif GetPlayerId(aiPlayer)==1 thenset randomHeroIndex=59endifendifset TrackedSideUnit[GetPlayerId(aiPlayer)]=CreateUnit(aiPlayer,RestrictedTechId[randomHeroIndex],spawnX,spawnY,bj_UNIT_FACING)endifset attempts=attempts+1exitwhen(TrackedSideUnit[GetPlayerId(aiPlayer)]!=null)endloopif(not(GameModeFlagV or GameModeFlagW or GameModeFlagO9 or GameOverFlag))thencall AdjustPlayerStateBJ(-250,aiPlayer,PLAYER_STATE_RESOURCE_GOLD)endifendifset aiPlayer=nullendfunctionfunction RepickHeroForPlayer takes player whichPlayer,boolean chargeGold returns nothinglocal integer poolStartlocal integer poolEndlocal integer heroIndexlocal integer playerId=GetPlayerId(whichPlayer)local integer aiClass=LoadIntByStringKey(GetHandleId(whichPlayer),"AI|Class")local integer attempts=0if(((IsPlayerOnTeamZero(whichPlayer))and(not GameModeFlagX))or((GameModeFlagX)and(GetRandomInt(1,2)==1)))thenset poolStart=CachedLoopIndexset poolEnd=HeroPoolLoopBoundAelseset poolStart=HeroPoolLoopStartBset poolEnd=HeroPoolLoopBoundCendifif(chargeGold)thenif GameModeFlagX or GameModeFlagF9 thenset GoldCost=100endifcall AdjustPlayerStateBJ(-1*GoldCost,whichPlayer,PLAYER_STATE_RESOURCE_GOLD)endifcall GroupClear(UnitCountEnumGroup)set bj_groupEnumOwningPlayer=whichPlayercall GroupEnumUnitsInRect(UnitCountEnumGroup,GetWorldBounds(),filterGetUnitsInRectOfPlayer)call ForGroup(UnitCountEnumGroup,function EnumRepickCleanupUnits)call RemoveUnitAndFlushData(TrackedSideUnit[playerId])set TrackedSideUnit[playerId]=nullset IsPlayerControlAllowed[playerId]=trueloopset heroIndex=GetRandomInt(poolStart,poolEnd)if(PointValueClaimed[heroIndex]==false and(HeroMatchesRoleCategory(RestrictedTechId[heroIndex],aiClass)or attempts>20))thenset PointValueClaimed[heroIndex]=trueif(IsPlayerOnTeamZero(whichPlayer))thenset TrackedSideUnit[playerId]=CreateUnit(whichPlayer,RestrictedTechId[heroIndex],GetRectCenterX(TeamSpawnRectB),GetRectCenterY(TeamSpawnRectB),bj_UNIT_FACING)elseset TrackedSideUnit[playerId]=CreateUnit(whichPlayer,RestrictedTechId[heroIndex],GetRectCenterX(TeamSpawnRectA),GetRectCenterY(TeamSpawnRectA),bj_UNIT_FACING)endifcall ForbidTechForAllPlayers(RestrictedTechId[heroIndex])endifset attempts=attempts+1exitwhen TrackedSideUnit[playerId]!=nullendloopendfunctionfunction OnRepickChatCommand takes nothing returns nothinglocal string chatString=GetEventPlayerChatString()local player targetPlayer=PlayerFromSlotIndex(S2I(SubString(chatString,9,StringLength(chatString))))if((targetPlayer!=null)and(IsPlayerSlotActive(targetPlayer))and(IsPlayerInForce(targetPlayer,RegisteredHeroPlayersForce)))thenif((IsPlayerAlly(GetTriggerPlayer(),targetPlayer))or(SelectPlayerFromFirstPair(not IsPlayerAlly(GetTriggerPlayer(),SentinelPlayer[0]))==null))thenif((IsPlayerControlAllowed[GetPlayerId(targetPlayer)])or(TrackedSideUnit[GetPlayerId(targetPlayer)]==null))thencall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,"Cannot re-pick your hero")elseif(ElapsedGameSeconds>90.)thencall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,GetObjectName('n050'))elsecall RepickHeroForPlayer(targetPlayer,false)endifelsecall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,"Cannot force an enemy AI that has human teammates to re-pick heroes")endifendifset targetPlayer=nullendfunctionfunction OnPickForAiChatCommand takes nothing returns nothinglocal string chatString=GetEventPlayerChatString()local integer slotIndex=1local boolean isSentinelAlly=IsPlayerAlly(GetTriggerPlayer(),SentinelPlayer[0])local boolean pickForSideFlagif((IsModeSelectionLocked)and((chatString=="-pa")or(chatString=="-pe"))and PlayerPickEnabled[GetPlayerId(GetTriggerPlayer())]==false)thenset PostStartActionDone=trueif(chatString=="-pa")thenset pickForSideFlag=isSentinelAllyelseset pickForSideFlag=not isSentinelAllyendifloopif(IsPlayerPlayingComputer(GetTeamPlayerBySlot(slotIndex,pickForSideFlag))and TrackedSideUnit[GetPlayerId(GetTeamPlayerBySlot(slotIndex,pickForSideFlag))]==null)thenexitwhen trueendifset slotIndex=slotIndex+1exitwhen(slotIndex>5)endloopif((slotIndex<=5)and(SelectPlayerFromSecondPair(isSentinelAlly)==null))thenif((TrackedSideUnit[GetPlayerId(SelectPlayerFromFirstPair(isSentinelAlly))]==null)and(not PlayerPickEnabled[GetPlayerId(SelectPlayerFromFirstPair(isSentinelAlly))]))thenif(isSentinelAlly)thenset PendingSwapPartnerA=GetTeamPlayerBySlot(slotIndex,pickForSideFlag)elseset PendingSwapPartnerB=GetTeamPlayerBySlot(slotIndex,pickForSideFlag)endifif(not GameModeFlagX)thencall SetUnitOwner(AiPrimaryTargetUnit[512+GetPlayerId(SelectPlayerFromFirstPair(isSentinelAlly))],SelectPlayerFromSecondPair(isSentinelAlly),false)call SetUnitOwner(AiPrimaryTargetUnit[512+GetPlayerId(SelectPlayerFromSecondPair(isSentinelAlly))],SelectPlayerFromFirstPair(isSentinelAlly),false)if chatString=="-pe" thenset TempDummyUnitA=CreateUnitAtLoc(SelectPlayerFromFirstPair(isSentinelAlly),'n00C',GetRectCenter(CenterLocationSourceRectA),0)set TempDummyUnitB=CreateUnitAtLoc(SelectPlayerFromFirstPair(isSentinelAlly),'n00C',GetRectCenter(CenterLocationSourceRectB),0)if not GameModeFlagX thencall RefreshTechAllowanceSideA(GetTriggerPlayer())endifendifendifcall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,"Pick a hero for "+PlayerColorCode[GetPlayerId(SelectPlayerFromSecondPair(isSentinelAlly))]+GetPlayerName(SelectPlayerFromSecondPair(isSentinelAlly))+"|r, type "+HighlightColorCode+"-px|r to cancel")elsecall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,5.,"You should pick heroes for the AI before picking your own hero. Randomized instead.")call AiRandomPickHeroByRole(GetPlayerId(GetTeamPlayerBySlot(slotIndex,pickForSideFlag)),0)endifelseif(SelectPlayerFromSecondPair(isSentinelAlly)!=null)thencall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,5.,"Already picked for "+PlayerColorCode[GetPlayerId(SelectPlayerFromSecondPair(isSentinelAlly))]+GetPlayerName(SelectPlayerFromSecondPair(isSentinelAlly))+"|r")endifelseif(chatString=="-px")thenif not GameModeFlagX thencall RefreshTechAllowanceSideB(GetTriggerPlayer())endifif(SelectPlayerFromSecondPair(isSentinelAlly)!=null)thencall SetUnitOwner(AiPrimaryTargetUnit[512+GetPlayerId(SelectPlayerFromFirstPair(isSentinelAlly))],SelectPlayerFromFirstPair(isSentinelAlly),false)call SetUnitOwner(AiPrimaryTargetUnit[512+GetPlayerId(SelectPlayerFromSecondPair(isSentinelAlly))],SelectPlayerFromSecondPair(isSentinelAlly),false)call RemoveUnit(TempDummyUnitA)call RemoveUnit(TempDummyUnitB)set TempDummyUnitA=nullset TempDummyUnitB=nullif(isSentinelAlly)thenset PendingSwapPartnerA=nullelseset PendingSwapPartnerB=nullendifcall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,5.,"Selection cancelled")endifelseif((not IsModeSelectionLocked)and((chatString=="-pa")or(chatString=="-pe")))thencall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,5.,"|c00888888It's too early to pick a hero right now|r")endifendfunctionfunction AnyUserPlayerMissingHero takes nothing returns booleanlocal integer slotIndex=1loopexitwhen slotIndex>5if(IsPlayerPlayingUser(SentinelPlayer[slotIndex])and(TrackedSideUnit[GetPlayerId(SentinelPlayer[slotIndex])]==null))thenreturn trueelseif(IsPlayerPlayingUser(ScourgePlayer[slotIndex])and(TrackedSideUnit[GetPlayerId(ScourgePlayer[slotIndex])]==null))thenreturn trueendifset slotIndex=slotIndex+1endloopreturn falseendfunctionfunction RunAiHeroDraft takes nothing returns nothinglocal integer slotIndex=1local boolean array roleTakenFlagslocal integer roleIndexlocal integer attemptCountif(ElapsedGameSeconds<68.)thenif(((GameModeFlagD9)or(not PostStartActionDone))and(ElapsedGameSeconds>43.))thenelseif(AnyUserPlayerMissingHero()or ElapsedGameSeconds<30.)thenreturnelsecall PolledWait_2(1.)endifendifcall RecycleExpiringTrigger(GetTriggeringTrigger())call DisableTrigger(AiControlToggleTrigger)if(PendingSwapPartnerA!=null)thencall DisplayTimedTextToPlayer(PendingSwapPlayerA,0,0,5.,"Hero selection for the AI has ended.")call SetUnitOwner(AiPrimaryTargetUnit[512+GetPlayerId(PendingSwapPlayerA)],PendingSwapPlayerA,false)call SetUnitOwner(AiPrimaryTargetUnit[512+GetPlayerId(PendingSwapPartnerA)],PendingSwapPartnerA,false)call RemoveUnit(TempDummyUnitA)call RemoveUnit(TempDummyUnitB)set TempDummyUnitA=nullset TempDummyUnitB=nullset PendingSwapPartnerA=nullendifif(PendingSwapPartnerB!=null)thencall DisplayTimedTextToPlayer(PendingSwapPlayerB,0,0,5.,"Hero selection for the AI has ended.")call SetUnitOwner(AiPrimaryTargetUnit[512+GetPlayerId(PendingSwapPlayerB)],PendingSwapPlayerB,false)call SetUnitOwner(AiPrimaryTargetUnit[512+GetPlayerId(PendingSwapPartnerB)],PendingSwapPartnerB,false)call RemoveUnit(TempDummyUnitA)call RemoveUnit(TempDummyUnitB)set TempDummyUnitA=nullset TempDummyUnitB=nullset PendingSwapPartnerB=nullendifif((GameModeFlagV)or(GameModeFlagO9)or(GameModeFlagW)or(GameOverFlag)or(GameModeFlagOL)or(GameModeFlagY_2)or(AiRelatedGameModeFlag)or(GameModeSelectedFlag))thenreturnendifset slotIndex=1loopexitwhen slotIndex>5if TrackedSideUnit[GetPlayerId(SentinelPlayer[slotIndex])]!=null thenset roleTakenFlags[GetHeroPrimaryRoleFlag(GetUnitTypeId(TrackedSideUnit[GetPlayerId(SentinelPlayer[slotIndex])]))]=trueendifif TrackedSideUnit[GetPlayerId(ScourgePlayer[slotIndex])]!=null thenset roleTakenFlags[6+GetHeroPrimaryRoleFlag(GetUnitTypeId(TrackedSideUnit[GetPlayerId(ScourgePlayer[slotIndex])]))]=trueendifset slotIndex=slotIndex+1endloopif TeamOnePlayerCount_2<=4 thenset roleTakenFlags[HeroRoleCategoryThree]=trueendifif TeamOnePlayerCount_2<=3 thenif GetRandomInt(0,2)==0 thenset roleTakenFlags[HeroRoleCategoryFour]=trueelseset roleTakenFlags[HeroRoleCategoryFive]=trueendifendifif TeamOnePlayerCount_2<=2 thenif roleTakenFlags[HeroRoleCategoryFour]thenset roleTakenFlags[HeroRoleCategoryFive]=trueelseset roleTakenFlags[HeroRoleCategoryFour]=trueendifendifif TeamTwoPlayerCount_2<=4 thenset roleTakenFlags[6+HeroRoleCategoryThree]=trueendifif TeamTwoPlayerCount_2<=3 thenif GetRandomInt(0,2)==0 thenset roleTakenFlags[6+HeroRoleCategoryFour]=trueelseset roleTakenFlags[6+HeroRoleCategoryFive]=trueendifendifif TeamTwoPlayerCount_2<=2 thenif roleTakenFlags[HeroRoleCategoryFour]thenset roleTakenFlags[6+HeroRoleCategoryFive]=trueelseset roleTakenFlags[6+HeroRoleCategoryFour]=trueendifendifset slotIndex=1loopexitwhen slotIndex>5if(IsPlayerPlayingComputer(SentinelPlayer[slotIndex])and(TrackedSideUnit[GetPlayerId(SentinelPlayer[slotIndex])]==null))thenset attemptCount=0loopexitwhen attemptCount>5set roleIndex=GetRandomInt(1,5)if roleTakenFlags[roleIndex]thenset roleIndex=0elseexitwhen trueendifset attemptCount=attemptCount+1endloopif roleIndex==0 thenset roleIndex=5loopexitwhen(not roleTakenFlags[roleIndex])or roleIndex==0set roleIndex=roleIndex-1endloopendifcall AiRandomPickHeroByRole(GetPlayerId(SentinelPlayer[slotIndex]),roleIndex)if not(roleIndex==0 or HeroMatchesRoleCategory(GetUnitTypeId(TrackedSideUnit[GetPlayerId(SentinelPlayer[slotIndex])]),roleIndex))thenset roleIndex=GetHeroPrimaryRoleFlag(GetUnitTypeId(TrackedSideUnit[GetPlayerId(SentinelPlayer[slotIndex])]))endifset roleTakenFlags[roleIndex]=truecall SaveIntByStringKey(GetHandleId(SentinelPlayer[slotIndex]),"AI|Class",roleIndex)call PolledWait_2(1.)endifif(IsPlayerPlayingComputer(ScourgePlayer[slotIndex])and(TrackedSideUnit[GetPlayerId(ScourgePlayer[slotIndex])]==null))thenset attemptCount=0loopexitwhen attemptCount>5set roleIndex=GetRandomInt(1,5)if roleTakenFlags[6+roleIndex]thenset roleIndex=0elseexitwhen trueendifset attemptCount=attemptCount+1endloopif roleIndex==0 thenset roleIndex=5loopexitwhen(not roleTakenFlags[6+roleIndex])or roleIndex==0set roleIndex=roleIndex-1endloopendifcall AiRandomPickHeroByRole(GetPlayerId(ScourgePlayer[slotIndex]),roleIndex)if not(roleIndex==0 or HeroMatchesRoleCategory(GetUnitTypeId(TrackedSideUnit[GetPlayerId(ScourgePlayer[slotIndex])]),roleIndex))thenset roleIndex=GetHeroPrimaryRoleFlag(GetUnitTypeId(TrackedSideUnit[GetPlayerId(ScourgePlayer[slotIndex])]))endifset roleTakenFlags[6+roleIndex]=truecall SaveIntByStringKey(GetHandleId(ScourgePlayer[slotIndex]),"AI|Class",roleIndex)call PolledWait_2(1.)endifset slotIndex=slotIndex+1endloopendfunctionfunction ForceLearnHeroSkill takes unit whichUnit,integer abilityId returns nothingcall SetPlayerAbilityAvailable(GetOwningPlayer(whichUnit),abilityId,true)call SelectHeroSkill(whichUnit,abilityId)endfunctionfunction IsListedNeutralUnitType takes integer unitTypeId returns booleanreturn(((unitTypeId=='N016')or(unitTypeId=='N017')or(unitTypeId=='N02B')))endfunctionfunction IsUnitInHeroTypeSetB takes integer unitTypeId returns booleanreturn((unitTypeId=='UC76')or(unitTypeId=='Ntin')or(unitTypeId=='U00P')or(unitTypeId=='Udre')or((unitTypeId=='Hblm')or(unitTypeId=='H06X')or(unitTypeId=='H06Y')or(un