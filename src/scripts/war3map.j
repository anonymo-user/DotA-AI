unction SetupLeapOrderTracking takes nothing returns nothinglocal unit trackedUnit=GetTriggerUnit()local trigger orderTrigger=CreateTrigger()local timer pollTimercall TriggerRegisterUnitEvent(orderTrigger,trackedUnit,EVENT_UNIT_ISSUED_TARGET_ORDER)call TriggerRegisterUnitEvent(orderTrigger,trackedUnit,EVENT_UNIT_ISSUED_POINT_ORDER)call TriggerRegisterUnitEvent(orderTrigger,trackedUnit,EVENT_UNIT_ISSUED_ORDER)call TriggerAddAction(orderTrigger,function RecordUnitOrderForLeap)call TriggerAddCondition(orderTrigger,Condition(function IsOrderNotWindwalk))call SaveTriggerHandle(GameHashtable,(GetHandleId(trackedUnit)),(204),(orderTrigger))set pollTimer=CreateTimer()call SaveUnitHandle(GameHashtable,(GetHandleId(pollTimer)),(14),(trackedUnit))call TimerStart(pollTimer,.3,true,function CheckLeapOrderPointReached)call SaveTimerHandle(GameHashtable,(GetHandleId(trackedUnit)),(205),(pollTimer))set trackedUnit=nullset orderTrigger=nullset pollTimer=nullendfunctionfunction OnLearnA0LNSetupTracking takes nothing returns nothingif GetUnitAbilityLevel(GetTriggerUnit(),'A0LN')==1 thencall SetupLeapOrderTracking()endifendfunctionfunction InitA0LNLeapTriggers takes nothing returns nothinglocal trigger leapTrigger=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(leapTrigger,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(leapTrigger,Condition(function IsSpellA0LN))call TriggerAddAction(leapTrigger,function CastA0LNLeap)set leapTrigger=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(leapTrigger,EVENT_PLAYER_HERO_SKILL)call TriggerAddAction(leapTrigger,function OnLearnA0LNSetupTracking)set leapTrigger=nullendfunctionfunction OnMorphlingTintTimer takes nothing returns nothinglocal unit morphUnit=(LoadUnitHandle(GameHashtable,(GetHandleId(GetTriggeringTrigger())),(326)))local real redTintlocal real greenlocal real bluelocal integer agilitylocal integer strengthlocal real tintValuelocal real rStr2Agiif GetUnitTypeId(morphUnit)!='O00P' thencall DisableTrigger(GetTriggeringTrigger())elseif IsUnitDeadOrInvalid(morphUnit)==false and(LoadBoolean(GameHashtable,(GetHandleId(morphUnit)),(225)))==false thenset agility=GetHeroAgi(morphUnit,true)set strength=GetHeroStr(morphUnit,true)set tintValue=RMaxBJ(75+2*(agility-strength),35)set redTint=tintValueset green=tintValueset blue=tintValuecall SetUnitVertexColorBJ(morphUnit,redTint,green,blue,GetRandomReal(.0,10.))endifset morphUnit=nullendfunctionfunction FilterRealMorphlingEnter takes nothing returns booleanreturn GetUnitTypeId(GetTriggerUnit())=='O00P'and IsUnitIllusion(GetTriggerUnit())==falseendfunctionfunction OnMorphlingEnterInitTint takes nothing returns nothinglocal trigger tintTimerTriggerif((LoadBoolean(GameHashtable,(GetHandleId(GetTriggerUnit())),(327)))==false)thenset tintTimerTrigger=CreateTrigger()call SaveUnitHandle(GameHashtable,(GetHandleId(tintTimerTrigger)),(326),(GetTriggerUnit()))call SaveTriggerHandle(GameHashtable,(GetHandleId(GetTriggerUnit())),(328),(tintTimerTrigger))call TriggerAddAction(tintTimerTrigger,function OnMorphlingTintTimer)call TriggerRegisterTimerEvent(tintTimerTrigger,1.,true)call SaveBoolean(GameHashtable,(GetHandleId(GetTriggerUnit())),(327),(true))call UnitAddItem(GetTriggerUnit(),CreateItem('I00E',GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit())))endifset tintTimerTrigger=nullendfunctionfunction RegisterMorphlingEnterTintTrigger takes nothing returns nothinglocal trigger enterRectTrigger=CreateTrigger()call TriggerRegisterEnterRectSimple(enterRectTrigger,bj_mapInitialPlayableArea)call TriggerAddCondition(enterRectTrigger,Condition(function FilterRealMorphlingEnter))call TriggerAddAction(enterRectTrigger,function OnMorphlingEnterInitTint)set enterRectTrigger=nullendfunctionfunction FilterWaveformCast takes nothing returns booleanreturn GetSpellAbilityId()=='A0FN'endfunctionfunction FilterWaveformDamageTarget takes nothing returns booleanlocal unit filterUnit=GetFilterUnit()if IsUnitInGroup(filterUnit,ActiveEnumGroup)thenset filterUnit=nullreturn falseendifif IsUnitEnemy(filterUnit,GetOwningPlayer(CurrentOrderTarget))and GetUnitAbilityLevel(filterUnit,'A04R')!=1 and GetUnitState(filterUnit,UNIT_STATE_LIFE)>0 and IsUnitType(filterUnit,UNIT_TYPE_STRUCTURE)==false thenset filterUnit=nullreturn trueendifset filterUnit=nullreturn falseendfunctionfunction EnumWaveformDamageUnit takes nothing returns nothingcall UnitDamageTarget(CurrentOrderTarget,GetEnumUnit(),ScratchReal,true,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)endfunctionfunction OnWaveformTick takes nothing returns booleanlocal trigger whichTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(whichTrigger)local unit waveUnit=(LoadUnitHandle(GameHashtable,(triggerId),(221)))local real travelAngle=(LoadReal(GameHashtable,(triggerId),(13)))local integer remainingTicks=(LoadInteger(GameHashtable,(triggerId),(194)))local group hitGroup=(LoadGroupHandle(GameHashtable,(triggerId),(133)))local real unitX=GetUnitX(waveUnit)local real unitY=GetUnitY(waveUnit)local real currentX=(LoadReal(GameHashtable,(triggerId),(23)))local real currentY=(LoadReal(GameHashtable,(triggerId),(24)))local real nextX=currentX+1000*.05*Cos(travelAngle)local real nextY=currentY+1000*.05*Sin(travelAngle)local group tempGrouplocal unit visualUnit=(LoadUnitHandle(GameHashtable,(triggerId),(239)))if waveUnit==null thencall FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(whichTrigger)return falseendifif GetTriggerEventId()==EVENT_UNIT_SPELL_EFFECT thenif GetSpellAbilityId()=='A0GC' or GetSpellAbilityId()==0 thencall RemoveUnit(visualUnit)call SetUnitVertexColor(waveUnit,255,255,255,255)call SaveBoolean(GameHashtable,(GetHandleId(waveUnit)),(225),(false))call SetUnitInvulnerable(waveUnit,false)call SetUnitPathing(waveUnit,true)call ReleaseGroupToPool(hitGroup)call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(whichTrigger)endifreturn falseendifset tempGroup=AcquireGroupFromPool()call SaveReal(GameHashtable,(triggerId),(23),((nextX)*1.))call SaveReal(GameHashtable,(triggerId),(24),((nextY)*1.))set CurrentOrderTarget=waveUnitset ScratchReal=GetUnitAbilityLevel(waveUnit,'A0FN')*75+25set ActiveEnumGroup=hitGroupcall GroupEnumUnitsInRange(tempGroup,unitX,unitY,200+25,Condition(function FilterWaveformDamageTarget))call ForGroup(tempGroup,function EnumWaveformDamageUnit)call GroupAddGroup(tempGroup,hitGroup)call ReleaseGroupToPool(tempGroup)set remainingTicks=remainingTicks-1call SaveInteger(GameHashtable,(triggerId),(194),(remainingTicks))call SetUnitX(waveUnit,ClampXToPlayableArea(nextX))call SetUnitY(waveUnit,ClampYToPlayableArea(nextY))call SetUnitX(visualUnit,GetUnitX(waveUnit))call SetUnitY(visualUnit,GetUnitY(waveUnit))call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl",unitX,unitY))if remainingTicks==0 thencall RemoveUnit(visualUnit)call SetUnitVertexColor(waveUnit,255,255,255,255)call SaveBoolean(GameHashtable,(GetHandleId(waveUnit)),(225),(false))call SetUnitInvulnerable(waveUnit,false)call SetUnitPathing(waveUnit,true)call ReleaseGroupToPool(hitGroup)call FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(whichTrigger)endifset waveUnit=nullset hitGroup=nullset tempGroup=nullset whichTrigger=nullreturn falseendfunctionfunction OnCastWaveform takes nothing returns nothinglocal unit casterUnit=GetTriggerUnit()local real casterX=GetUnitX(casterUnit)local real casterY=GetUnitY(casterUnit)local location targetLoc=GetSpellTargetLoc()local real targetX=GetLocationX(targetLoc)local real targetY=GetLocationY(targetLoc)local trigger tickTrigger=CreateTrigger()local integer handleId=GetHandleId(tickTrigger)local group hitGroup=AcquireGroupFromPool()local integer playerId=GetPlayerId(GetOwningPlayer(casterUnit))local unit dummyUnit=CreateUnit(GetOwningPlayer(casterUnit),'e00E',casterX,casterY,0)call RemoveLocation(targetLoc)if GetSpellTargetUnit()!=null thenset targetX=GetUnitX(GetSpellTargetUnit())set targetY=GetUnitY(GetSpellTargetUnit())endifcall SetUnitVertexColor(casterUnit,255,255,255,0)call SaveBoolean(GameHashtable,(GetHandleId(casterUnit)),(225),(true))call SetUnitInvulnerable(casterUnit,true)call SetUnitPathing(casterUnit,false)call SaveUnitHandle(GameHashtable,(handleId),(221),(casterUnit))call SaveReal(GameHashtable,(handleId),(23),((casterX)*1.))call SaveReal(GameHashtable,(handleId),(24),((casterY)*1.))call SaveGroupHandle(GameHashtable,(handleId),(133),(hitGroup))call SaveReal(GameHashtable,(handleId),(13),((Atan2(targetY-casterY,targetX-casterX))*1.0))call SaveInteger(GameHashtable,(handleId),(194),(IntMax(R2I(SquareRoot((targetX-casterX)*(targetX-casterX)+(targetY-casterY)*(targetY-casterY))/50),1)))call SaveUnitHandle(GameHashtable,(handleId),(239),(dummyUnit))call TriggerRegisterTimerEvent(tickTrigger,.04,true)call TriggerRegisterUnitEvent(tickTrigger,casterUnit,EVENT_UNIT_SPELL_EFFECT)call TriggerAddCondition(tickTrigger,Condition(function OnWaveformTick))call ShowUnit(casterUnit,false)call ShowUnit(casterUnit,true)call SelectUnitAddForPlayer(casterUnit,GetOwningPlayer(casterUnit))set tickTrigger=nullset casterUnit=nullset targetLoc=nullset hitGroup=nullendfunctionfunction RegisterWaveformSpell takes nothing returns nothinglocal trigger spellTrigger=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(spellTrigger,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(spellTrigger,Condition(function FilterWaveformCast))call TriggerAddAction(spellTrigger,function OnCastWaveform)set spellTrigger=nullendfunctionfunction OnTimerStealStrengthForAgiHero takes nothing returns nothinglocal unit u8=(LoadUnitHandle(GameHashtable,(GetHandleId(GetTriggeringTrigger())),(326)))if IsUnitDeadOrInvalid(u8) thenset u8=nullreturnendifif GetHeroStatBJ(1,u8,false)>2*GetUnitAbilityLevel(u8,'A0KX')and GetUnitState(u8,UNIT_STATE_MANA)>=20. and GetUnitState(u8,UNIT_STATE_LIFE)>1. thencall SetUnitManaBJ(u8,GetUnitState(u8,UNIT_STATE_MANA)-20)call ModifyHeroStat(1,u8,1,2*GetUnitAbilityLevel(u8,'A0KX'))call ModifyHeroStat(0,u8,0,2*GetUnitAbilityLevel(u8,'A0KX'))endifset u8=nullendfunctionfunction OnTimerStealAgilityForStrHero takes nothing returns nothinglocal unit u8=(LoadUnitHandle(GameHashtable,(GetHandleId(GetTriggeringTrigger())),(326)))if IsUnitDeadOrInvalid(u8) thenset u8=nullreturnendifif GetHeroStatBJ(0,u8,false)>2*GetUnitAbilityLevel(u8,'A0KX')and GetUnitState(u8,UNIT_STATE_MANA)>=20. and GetUnitState(u8,UNIT_STATE_LIFE)>1. thencall SetUnitManaBJ(u8,GetUnitState(u8,UNIT_STATE_MANA)-20)call ModifyHeroStat(0,u8,1,2*GetUnitAbilityLevel(u8,'A0KX'))call ModifyHeroStat(1,u8,0,2*GetUnitAbilityLevel(u8,'A0KX'))endifset u8=nullendfunctionfunction FilterMorphAutocastOff takes nothing returns booleanreturn(((GetIssuedOrderId()==852550)or(GetIssuedOrderId()==852547))and(GetTriggerUnit()==(LoadUnitHandle(GameHashtable,(GetHandleId(GetTriggeringTrigger())),(326)))))endfunctionfunction OnMorphAutocastOff takes nothing returns nothinglocal integer triggerId=GetHandleId(GetTriggeringTrigger())local trigger morphStrTrigger=LoadTriggerByStringKey(triggerId,"MorphStr")local trigger morphAgiTrigger=LoadTriggerByStringKey(triggerId,"MorphAgi")if(GetIssuedOrderId()==852547)thencall DisableTrigger(morphStrTrigger)elseif(GetIssuedOrderId()==852550)thencall DisableTrigger(morphAgiTrigger)endifset morphStrTrigger=nullset morphAgiTrigger=nullendfunctionfunction FilterMorphAutocastOn takes nothing returns booleanreturn(((GetIssuedOrderId()==852549)or(GetIssuedOrderId()==852546))and(GetTriggerUnit()==(LoadUnitHandle(GameHashtable,(GetHandleId(GetTriggeringTrigger())),(326)))))endfunctionfunction OnMorphAutocastOn takes nothing returns nothinglocal integer triggerId=GetHandleId(GetTriggeringTrigger())local trigger morphStrTrigger=LoadTriggerByStringKey(triggerId,"MorphStr")local trigger morphAgiTrigger=LoadTriggerByStringKey(triggerId,"MorphAgi")if(GetIssuedOrderId()==852546)thencall EnableTrigger(morphStrTrigger)call DisableTrigger(morphAgiTrigger)elseif(GetIssuedOrderId()==852549)thencall DisableTrigger(morphStrTrigger)call EnableTrigger(morphAgiTrigger)endifset morphStrTrigger=nullset morphAgiTrigger=nullendfunctionfunction FilterAiLearnedAttributeShift takes nothing returns booleanreturn GetLearnedSkill()=='A0KX'and IsUnitIllusion(GetTriggerUnit())==false and GetPlayerController(GetOwningPlayer(GetTriggerUnit()))==MAP_CONTROL_COMPUTERendfunctionfunction SetupAiAttributeShift takes nothing returns nothinglocal unit casterUnit=GetTriggerUnit()local trigger autocastOnTriggerlocal trigger autocastOffTriggerlocal trigger strPeriodicTriggerlocal trigger agiPeriodicTriggerif(GetUnitAbilityLevel(casterUnit,'A0KX')==1)thencall AddPermanentAbility(casterUnit,'A0KW')set agiPeriodicTrigger=CreateTrigger()call DisableTrigger(agiPeriodicTrigger)call TriggerRegisterTimerEventPeriodic(agiPeriodicTrigger,1.)call TriggerAddAction(agiPeriodicTrigger,function OnTimerStealAgilityForStrHero)call SaveUnitHandle(GameHashtable,GetHandleId(agiPeriodicTrigger),(326),casterUnit)set strPeriodicTrigger=CreateTrigger()call DisableTrigger(strPeriodicTrigger)call TriggerRegisterTimerEventPeriodic(strPeriodicTrigger,1.)call TriggerAddAction(strPeriodicTrigger,function OnTimerStealStrengthForAgiHero)call SaveUnitHandle(GameHashtable,GetHandleId(strPeriodicTrigger),(326),casterUnit)set autocastOnTrigger=CreateTrigger()call RegisterPlayerUnitEventBothTeams(autocastOnTrigger,EVENT_PLAYER_UNIT_ISSUED_ORDER)call TriggerAddCondition(autocastOnTrigger,Condition(function FilterMorphAutocastOn))call TriggerAddAction(autocastOnTrigger,function OnMorphAutocastOn)call SaveTriggerByStringKey(GetHandleId(autocastOnTrigger),"MorphAgi",agiPeriodicTrigger)call SaveTriggerByStringKey(GetHandleId(autocastOnTrigger),"MorphStr",strPeriodicTrigger)call SaveUnitHandle(GameHashtable,GetHandleId(autocastOnTrigger),(326),casterUnit)set autocastOffTrigger=CreateTrigger()call RegisterPlayerUnitEventBothTeams(autocastOffTrigger,EVENT_PLAYER_UNIT_ISSUED_ORDER)call TriggerAddCondition(autocastOffTrigger,Condition(function FilterMorphAutocastOff))call TriggerAddAction(autocastOffTrigger,function OnMorphAutocastOff)call SaveTriggerByStringKey(GetHandleId(autocastOffTrigger),"MorphAgi",agiPeriodicTrigger)call SaveTriggerByStringKey(GetHandleId(autocastOffTrigger),"MorphStr",strPeriodicTrigger)call SaveUnitHandle(GameHashtable,GetHandleId(autocastOffTrigger),(326),casterUnit)if(GetPlayerController(GetOwningPlayer(casterUnit))!=MAP_CONTROL_USER)thencall SaveTriggerByStringKey(GetHandleId(GetOwningPlayer(casterUnit)),"MorphAgi",agiPeriodicTrigger)call SaveTriggerByStringKey(GetHandleId(GetOwningPlayer(casterUnit)),"MorphStr",strPeriodicTrigger)endifelsecall SetUnitAbilityLevel(casterUnit,'A0KW',GetUnitAbilityLevel(casterUnit,'A0KX'))endifset casterUnit=nullset autocastOnTrigger=nullset autocastOffTrigger=nullset strPeriodicTrigger=nullset agiPeriodicTrigger=nullendfunctionfunction TransferAttributePointsMorph takes unit heroUnit,integer transferMode,real manaCost returns nothinglocal integer agilityValue=GetHeroAgi(heroUnit,false)local integer strengthValue=GetHeroStr(heroUnit,false)local real currentMana=GetUnitState(heroUnit,UNIT_STATE_MANA)if transferMode==0 thenif currentMana>=manaCost and agilityValue>2 and IsUnitDeadOrInvalid(heroUnit)==false thencall SetUnitState(heroUnit,UNIT_STATE_MANA,currentMana-manaCost)call SetHeroAgi(heroUnit,agilityValue-2,true)call SetHeroStr(heroUnit,strengthValue+2,true)endifelseif transferMode==1 thenif currentMana>=manaCost and strengthValue>2 and IsUnitDeadOrInvalid(heroUnit)==false thencall SetUnitState(heroUnit,UNIT_STATE_MANA,currentMana-manaCost)call SetHeroAgi(heroUnit,agilityValue+2,true)call SetHeroStr(heroUnit,strengthValue-2,true)endifendifendfunctionfunction OnMorphAgiTick takes nothing returns booleanlocal trigger whichTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(whichTrigger)local unit whichUnit=(LoadUnitHandle(GameHashtable,(triggerId),(14)))local integer abilityLevel=GetUnitAbilityLevel(whichUnit,'A0KX')call TransferAttributePointsMorph(whichUnit,1,30.0/abilityLevel)set whichTrigger=nullset whichUnit=nullreturn falseendfunctionfunction OnMorphStrTick takes nothing returns booleanlocal trigger whichTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(whichTrigger)local unit whichUnit=(LoadUnitHandle(GameHashtable,(triggerId),(14)))local integer abilityLevel=GetUnitAbilityLevel(whichUnit,'A0KX')call TransferAttributePointsMorph(whichUnit,0,30.0/abilityLevel)set whichTrigger=nullset whichUnit=nullreturn falseendfunctionfunction OnAttributeShiftOrder takes nothing returns booleanlocal trigger orderTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(orderTrigger)local unit heroUnit=GetTriggerUnit()local trigger morphTrigger=(LoadTriggerHandle(GameHashtable,(handleId),(226)))local integer abilityLevel=GetUnitAbilityLevel(heroUnit,'A0KX')local integer lastOrderId=(LoadInteger(GameHashtable,(handleId),(227)))local real tickInterval=1.0/abilityLevelif abilityLevel==4 thenset tickInterval=0.2endifif GetIssuedOrderId()==852549 thenif morphTrigger!=null thencall FlushChildHashtable(GameHashtable,(GetHandleId(morphTrigger)))call RecycleExpiringTrigger(morphTrigger)endifset morphTrigger=CreateTrigger()call TriggerRegisterTimerEvent(morphTrigger,tickInterval,true)call TriggerAddCondition(morphTrigger,Condition(function OnMorphAgiTick))call SaveUnitHandle(GameHashtable,(GetHandleId(morphTrigger)),(14),(heroUnit))call SaveTriggerHandle(GameHashtable,(handleId),(226),(morphTrigger))call SaveInteger(GameHashtable,(handleId),(227),(GetIssuedOrderId()))call UnitAddAbility(heroUnit,'A22L')call UnitRemoveAbility(heroUnit,'A22T')elseif GetIssuedOrderId()==852546 thenif morphTrigger!=null thencall FlushChildHashtable(GameHashtable,(GetHandleId(morphTrigger)))call RecycleExpiringTrigger(morphTrigger)endifset morphTrigger=CreateTrigger()call TriggerRegisterTimerEvent(morphTrigger,tickInterval,true)call TriggerAddCondition(morphTrigger,Condition(function OnMorphStrTick))call SaveUnitHandle(GameHashtable,(GetHandleId(morphTrigger)),(14),(heroUnit))call SaveTriggerHandle(GameHashtable,(handleId),(226),(morphTrigger))call SaveInteger(GameHashtable,(handleId),(227),(GetIssuedOrderId()))call UnitAddAbility(heroUnit,'A22T')call UnitRemoveAbility(heroUnit,'A22L')elseif GetIssuedOrderId()==852550 thenif morphTrigger!=null thencall FlushChildHashtable(GameHashtable,(GetHandleId(morphTrigger)))call RecycleExpiringTrigger(morphTrigger)endifcall SaveTriggerHandle(GameHashtable,(handleId),(226),(null))call SaveInteger(GameHashtable,(handleId),(227),(GetIssuedOrderId()))call UnitRemoveAbility(heroUnit,'A22L')call UnitRemoveAbility(heroUnit,'A22T')elseif GetIssuedOrderId()==852547 thenif morphTrigger!=null thencall FlushChildHashtable(GameHashtable,(GetHandleId(morphTrigger)))call RecycleExpiringTrigger(morphTrigger)endifcall SaveTriggerHandle(GameHashtable,(handleId),(226),(null))call SaveInteger(GameHashtable,(handleId),(227),(GetIssuedOrderId()))call UnitRemoveAbility(heroUnit,'A22L')call UnitRemoveAbility(heroUnit,'A22T')elseif GetIssuedOrderId()==852548 and lastOrderId!=852546 and lastOrderId!=852546 thencall TransferAttributePointsMorph(heroUnit,1,30*tickInterval)elseif GetIssuedOrderId()==852545 and lastOrderId!=852546 and lastOrderId!=852546 thencall TransferAttributePointsMorph(heroUnit,0,30*tickInterval)endifset orderTrigger=nullset heroUnit=nullset morphTrigger=nullreturn falseendfunctionfunction OnLearnAttributeShift takes nothing returns nothinglocal unit heroUnit=GetTriggerUnit()local trigger ord