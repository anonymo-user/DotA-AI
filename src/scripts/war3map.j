gger array AncientRangeTriggerinteger AncientTriggerBaseHandleId=0group EnumUnitsGroup=nullinteger NearbyEnemyHeroCount=0integer AlliedHeroCountThreshold=0hashtable AbilityDataCache=InitHashtable()constant integer ManaCheckModeOne=1constant integer ManaCheckModeTwo=2real RangeCheckDistance=1000.constant integer MinHeroLevelForRoam=8constant real DustToSentryRatio=.5constant real ActionDelaySeconds=2.real BoundingMaxX=.0real BoundsMaxY=.0real BoundsMinX=.0real BoundsMinY=.0location TempLocation=nullgroup BoundsEnumGroupreal SearchRadiusBase=.0real SearchRadiusBonus=.0real PendingDamageAmount_2unit DamageSourceUnit_6boolean array SlotInUsetimer array PooledTimerArraytimer DurationTimer=nullunit array TrackedExpiryUnitinteger array TrackedExpiryKeyreal array TrackedExpiryTimereal array AbilityFieldValueArrayinteger array AbilityLevelArrayreal array MaledictStartLifeinteger array AbilityDataFieldIdunit AiAbilityTargetUnit=nullreal CastOffsetDistance=.0real AllyHealthPercentThreshold=50.unit AiScanSourceUnit=nullconstant integer LinearTableMaxSize=360integer TimerHandleIdBase=0string TimerTableLeakErrorMsg="#Error: Timer-LinearTable leakage. LastFunc: "integer TableIterationIndex=0constant integer AbilityFieldQueryBaseValue=0constant integer AbilityFieldQueryPerLevel=1constant integer AbilityFieldQueryMode2=2constant integer AbilityFieldQueryMode3=3constant integer AbilityFieldQueryMode4=4real MaledictBonusDamage=.0real MaxEstimatedDamage=.0real MaledictDebuffDamage=.0unit EnumSourceUnit_2=nullinteger TempItemTypeIndex=0unit SelectedTargetUnit=nullreal TargetSelectCounter=.0trigger ItemEnumTimerTrigger=nullboolean array PlayerToggleEnabledtimer ElapsedMeasureTimer=nullreal yd_MapMaxX = 0real yd_MapMinX = 0real yd_MapMaxY = 0real yd_MapMinY = 0boolean mu_is_lua_enable = falseboolean mu_damage_dot = falseboolean array mu_has_gagstring mu_temp_string = ""boolean mu_has_init_dummy_player = falseboolexpr mu_sync_dummy_messenger = nullstring mu_lua_string = nullendglobalsfunction MUCall takes string script, string void returns nothingif mu_is_lua_enable thencall CopySaveGame(script, void)endifendfunctionfunction MUPrint takes string message returns nothingset mu_lua_string = messagecall MUCall("print(globals.mu_lua_string)", null)endfunctionfunction YDWECoordinateX takes real x returns realreturn RMinBJ(RMaxBJ(x, yd_MapMinX), yd_MapMaxX)endfunctionfunction YDWECoordinateY takes real y returns realreturn RMinBJ(RMaxBJ(y, yd_MapMinY), yd_MapMaxY)endfunctionfunction MUSetUnitX takes unit targetUnit, real x returns nothingcall SetUnitX(targetUnit, YDWECoordinateX(x))endfunctionfunction MUSetUnitY takes unit targetUnit, real y returns nothingcall SetUnitY(targetUnit, YDWECoordinateY(y))endfunctionfunction MUTransformRelieve takes nothing returns nothinglocal timer expiredTimer = GetExpiredTimer()local unit hero = LoadUnitHandle(GameHashtable, GetHandleId(expiredTimer), 0)local integer abilityId = LoadInteger(GameHashtable, GetHandleId(expiredTimer), 0)call UnitAddAbility(hero, abilityId)call UnitRemoveAbility(hero, abilityId)call FlushChildHashtable(GameHashtable, GetHandleId(expiredTimer))call DestroyTimer(expiredTimer)set expiredTimer = nullset hero = nullendfunctionfunction MUTransformDebug takes unit hero, integer abilityId, real time returns nothinglocal timer transformTimer = CreateTimer()call SaveUnitHandle(GameHashtable, GetHandleId(transformTimer), 0, hero)call SaveInteger(GameHashtable, GetHandleId(transformTimer), 0, abilityId)call TimerStart(transformTimer, time - 0.01, false, function MUTransformRelieve)set transformTimer = nullendfunctionfunction MUPlayerGag takes nothing returns nothinglocal string chat = GetEventPlayerChatString()local integer slotNumberlocal player target_playerlocal integer player_idlocal integer indexlocal string nameif StringCase(SubString(chat, 0, 4), false) != "-jy " thenreturnendifset slotNumber = S2I(SubString(chat, 4, StringLength(chat)))if slotNumber <= 0 or slotNumber > 10 thencall DisplayTimedTextToPlayer(GetTriggerPlayer(), 0, 0, 10, "|cffffcc00Please specify a valid player in slot [1-10]|r")returnendifif slotNumber <= 5 thenset target_player = SentinelPlayer[slotNumber]elseset target_player = ScourgePlayer[slotNumber - 5]endifif target_player == null thencall DisplayTimedTextToPlayer(GetTriggerPlayer(), 0, 0, 10, "|cffffcc00Please specify a valid player in slot [1-10]|r")returnendifset name = GetPlayerName(target_player)if GetTriggerPlayer() == GetLocalPlayer() thenset player_id = GetPlayerId(target_player)set mu_has_gag[player_id] = not mu_has_gag[player_id]if mu_has_gag[player_id] thencall DisplayTimedTextToPlayer(GetTriggerPlayer(), 0, 0, 10, "|cffffcc00You will no longer see " + name + "'s messages. Enter the command again to cancel. (You can still see their messages in the chat log.)|r")set name = mu_temp_string + nameelseset name = SubString(GetPlayerName(target_player), 200, StringLength(GetPlayerName(target_player)))call DisplayTimedTextToPlayer(GetTriggerPlayer(), 0, 0, 10, "|cffffcc00You can now see " + name + "'s messages again.|r")endifendifcall SetPlayerName(target_player, name)set target_player = nullendfunctionfunction MUInitDummyPlayer takes integer sentinelDummyId, integer scourgeDummyId returns nothinglocal integer slotIndexif mu_has_init_dummy_player thenreturnendifset mu_has_init_dummy_player=trueset PlayerColorCode[sentinelDummyId]=PlayerColorCode[0]set PlayerColorCode[scourgeDummyId]=PlayerColorCode[6]call SetPlayerColor(Player(sentinelDummyId), GetPlayerColor(SentinelPlayer[0]))call SetPlayerColor(Player(scourgeDummyId), GetPlayerColor(ScourgePlayer[0]))call SetPlayerName(Player(sentinelDummyId), GetPlayerName(SentinelPlayer[0]))call SetPlayerName(Player(scourgeDummyId), GetPlayerName(ScourgePlayer[0]))set PlayerName[sentinelDummyId]=GetPlayerName(Player(sentinelDummyId))set PlayerName[scourgeDummyId]=GetPlayerName(Player(scourgeDummyId))call SetPlayerTeam(Player(sentinelDummyId), 0)call SetPlayerTeam(Player(scourgeDummyId), 1)set slotIndex = 0loopcall SetPlayerAlliance(Player(sentinelDummyId), SentinelPlayer[slotIndex], ConvertAllianceType(0), true)call SetPlayerAlliance(Player(sentinelDummyId), SentinelPlayer[slotIndex], ConvertAllianceType(1), true)call SetPlayerAlliance(Player(sentinelDummyId), SentinelPlayer[slotIndex], ConvertAllianceType(2), true)call SetPlayerAlliance(Player(sentinelDummyId), SentinelPlayer[slotIndex], ConvertAllianceType(3), true)call SetPlayerAlliance(Player(sentinelDummyId), SentinelPlayer[slotIndex], ConvertAllianceType(4), true)call SetPlayerAlliance(SentinelPlayer[slotIndex], Player(sentinelDummyId), ConvertAllianceType(0), true)call SetPlayerAlliance(SentinelPlayer[slotIndex], Player(sentinelDummyId), ConvertAllianceType(1), true)call SetPlayerAlliance(SentinelPlayer[slotIndex], Player(sentinelDummyId), ConvertAllianceType(2), true)call SetPlayerAlliance(SentinelPlayer[slotIndex], Player(sentinelDummyId), ConvertAllianceType(3), true)call SetPlayerAlliance(SentinelPlayer[slotIndex], Player(sentinelDummyId), ConvertAllianceType(4), true)call SetPlayerAlliance(Player(sentinelDummyId), ScourgePlayer[slotIndex], ConvertAllianceType(0), false)call SetPlayerAlliance(Player(sentinelDummyId), ScourgePlayer[slotIndex], ConvertAllianceType(1), false)call SetPlayerAlliance(Player(sentinelDummyId), ScourgePlayer[slotIndex], ConvertAllianceType(2), false)call SetPlayerAlliance(Player(sentinelDummyId), ScourgePlayer[slotIndex], ConvertAllianceType(3), false)call SetPlayerAlliance(Player(sentinelDummyId), ScourgePlayer[slotIndex], ConvertAllianceType(4), false)call SetPlayerAlliance(ScourgePlayer[slotIndex], Player(sentinelDummyId), ConvertAllianceType(0), false)call SetPlayerAlliance(ScourgePlayer[slotIndex], Player(sentinelDummyId), ConvertAllianceType(1), false)call SetPlayerAlliance(ScourgePlayer[slotIndex], Player(sentinelDummyId), ConvertAllianceType(2), false)call SetPlayerAlliance(ScourgePlayer[slotIndex], Player(sentinelDummyId), ConvertAllianceType(3), false)call SetPlayerAlliance(ScourgePlayer[slotIndex], Player(sentinelDummyId), ConvertAllianceType(4), false)set slotIndex = slotIndex + 1exitwhen slotIndex > 5endloopset slotIndex = 0loopcall SetPlayerAlliance(Player(scourgeDummyId), ScourgePlayer[slotIndex], ConvertAllianceType(0), true)call SetPlayerAlliance(Player(scourgeDummyId), ScourgePlayer[slotIndex], ConvertAllianceType(1), true)call SetPlayerAlliance(Player(scourgeDummyId), ScourgePlayer[slotIndex], ConvertAllianceType(2), true)call SetPlayerAlliance(Player(scourgeDummyId), ScourgePlayer[slotIndex], ConvertAllianceType(3), true)call SetPlayerAlliance(Player(scourgeDummyId), ScourgePlayer[slotIndex], ConvertAllianceType(4), true)call SetPlayerAlliance(ScourgePlayer[slotIndex], Player(scourgeDummyId), ConvertAllianceType(0), true)call SetPlayerAlliance(ScourgePlayer[slotIndex], Player(scourgeDummyId), ConvertAllianceType(1), true)call SetPlayerAlliance(ScourgePlayer[slotIndex], Player(scourgeDummyId), ConvertAllianceType(2), true)call SetPlayerAlliance(ScourgePlayer[slotIndex], Player(scourgeDummyId), ConvertAllianceType(3), true)call SetPlayerAlliance(ScourgePlayer[slotIndex], Player(scourgeDummyId), ConvertAllianceType(4), true)call SetPlayerAlliance(Player(scourgeDummyId), SentinelPlayer[slotIndex], ConvertAllianceType(0), false)call SetPlayerAlliance(Player(scourgeDummyId), SentinelPlayer[slotIndex], ConvertAllianceType(1), false)call SetPlayerAlliance(Player(scourgeDummyId), SentinelPlayer[slotIndex], ConvertAllianceType(2), false)call SetPlayerAlliance(Player(scourgeDummyId), SentinelPlayer[slotIndex], ConvertAllianceType(3), false)call SetPlayerAlliance(Player(scourgeDummyId), SentinelPlayer[slotIndex], ConvertAllianceType(4), false)call SetPlayerAlliance(SentinelPlayer[slotIndex], Player(scourgeDummyId), ConvertAllianceType(0), false)call SetPlayerAlliance(SentinelPlayer[slotIndex], Player(scourgeDummyId), ConvertAllianceType(1), false)call SetPlayerAlliance(SentinelPlayer[slotIndex], Player(scourgeDummyId), ConvertAllianceType(2), false)call SetPlayerAlliance(SentinelPlayer[slotIndex], Player(scourgeDummyId), ConvertAllianceType(3), false)call SetPlayerAlliance(SentinelPlayer[slotIndex], Player(scourgeDummyId), ConvertAllianceType(4), false)set slotIndex = slotIndex + 1exitwhen slotIndex > 5endloopset slotIndex = 0loopcall SetPlayerAlliance(Player(sentinelDummyId), Player(15), ConvertAllianceType(slotIndex), true)call SetPlayerAlliance(Player(15), Player(sentinelDummyId), ConvertAllianceType(slotIndex), true)call SetPlayerAlliance(Player(scourgeDummyId), Player(15), ConvertAllianceType(slotIndex), true)call SetPlayerAlliance(Player(15), Player(scourgeDummyId), ConvertAllianceType(slotIndex), true)set slotIndex = slotIndex + 1exitwhen slotIndex > 5endloopendfunctionfunction NotifyChecksumFailure takes nothing returns nothinglocal integer playerIndex=0if ModeSelectionLocked==false and AiForceAttackOverride==false and ChecksumFailureNotified==false thenset ChecksumFailureNotified=trueloopcall DisplayTimedTextToPlayer(Player(playerIndex),0,0,20,"|c00ff0303An internal checksum has failed|r")call DisplayTimedTextToPlayer(Player(playerIndex),0,0,20,"|c00ff0303This might not be a serious glitch, but it is important for me to get it|r")call DisplayTimedTextToPlayer(Player(playerIndex),0,0,20,"|c00ff0303Please send me the replay for this game to IceFrog@gmail.com|r")set playerIndex=playerIndex+1exitwhen playerIndex==12endloopendifendfunctionfunction ForceDrainExpiringPoolValve takes nothing returns nothinglocal real elapsed=(TimerGetElapsed(GameClockTimer))local integer index=1local integer drained=0local integer countBefore=ExpiringTriggerCountlocal integer expiringTriggerIdloopexitwhen index>ExpiringTriggerCountif TriggerExpiryTime[index]<elapsed thenset expiringTriggerId=GetHandleId(ExpiringTrigger[index])if ExpiringTrigger[index]==null thencall RemoveSavedBoolean(GameHashtable,-1,expiringTriggerId)elseif IsTriggerEnabled(ExpiringTrigger[index]) thencall DisableTrigger(ExpiringTrigger[index])elsecall DestroyTrigger(ExpiringTrigger[index])call RemoveSavedBoolean(GameHashtable,-1,expiringTriggerId)endifif index!=ExpiringTriggerCount thenset ExpiringTrigger[index]=ExpiringTrigger[ExpiringTriggerCount]set TriggerExpiryTime[index]=TriggerExpiryTime[ExpiringTriggerCount]endifset ExpiringTrigger[ExpiringTriggerCount]=nullset TriggerExpiryTime[ExpiringTriggerCount]=0set ExpiringTriggerCount=ExpiringTriggerCount-1set drained=drained+1elseset index=index+1endifendlooploopexitwhen ExpiringTriggerCount<=7000set expiringTriggerId=GetHandleId(ExpiringTrigger[1])if ExpiringTrigger[1]==null thencall RemoveSavedBoolean(GameHashtable,-1,expiringTriggerId)elseif IsTriggerEnabled(ExpiringTrigger[1]) thencall DisableTrigger(ExpiringTrigger[1])elsecall DestroyTrigger(ExpiringTrigger[1])call RemoveSavedBoolean(GameHashtable,-1,expiringTriggerId)endifif 1!=ExpiringTriggerCount thenset ExpiringTrigger[1]=ExpiringTrigger[ExpiringTriggerCount]set TriggerExpiryTime[1]=TriggerExpiryTime[ExpiringTriggerCount]endifset ExpiringTrigger[ExpiringTriggerCount]=nullset TriggerExpiryTime[ExpiringTriggerCount]=0set ExpiringTriggerCount=ExpiringTriggerCount-1set drained=drained+1endloopif drained>0 and countBefore>ExpiringTriggerPeak thenset ExpiringTriggerPeak=countBeforeset index=0loopcall DisplayTimedTextToPlayer(Player(index),0,0,20,"|c00ffcc00[trigger pool] emergency-drained "+I2S(drained)+" parked triggers at count "+I2S(countBefore)+"|r")set index=index+1exitwhen index==12endloopendifendfunctionfunction RecycleExpiringTrigger takes trigger t returns nothingcall DisableTrigger(t)if LoadBoolean(GameHashtable,-1,GetHandleId(t)) thenreturnendifif ExpiringTriggerCount>=8000 thencall ForceDrainExpiringPoolValve()endifcall SaveBoolean(GameHashtable,-1,GetHandleId(t),true)set ExpiringTriggerCount=ExpiringTriggerCount+1set ExpiringTrigger[ExpiringTriggerCount]=tset TriggerExpiryTime[ExpiringTriggerCount]=(TimerGetElapsed(GameClockTimer))+36if ExpiringTriggerCount>8000 thencall NotifyChecksumFailure()endifendfunctionfunction MUCreateDummyMessenger takes unit messenger, player owner, player origin_owner returns nothinglocal unit dummy = CreateUnit(owner, 'e00E', GetUnitX(messenger), GetUnitY(messenger), 0)local trigger syncTrigger = CreateTrigger()if owner != origin_owner thencall UnitSetUsesAltIcon(dummy, true)endifcall SetUnitFlyHeight(dummy, 10000, 0)call UnitAddAbility(dummy, 'Avul')call UnitAddAbility(dummy, 'AInv')call SaveUnitHandle(GameHashtable, GetHandleId(syncTrigger), 1, dummy)call SaveUnitHandle(GameHashtable, GetHandleId(syncTrigger), 2, messenger)call SavePlayerHandle(GameHashtable, GetHandleId(syncTrigger), 3, owner)call SavePlayerHandle(GameHashtable, GetHandleId(syncTrigger), 4, origin_owner)call TriggerRegisterTimerEvent(syncTrigger, 0.1, true)call TriggerRegisterUnitEvent(syncTrigger, messenger, EVENT_UNIT_PICKUP_ITEM)call TriggerRegisterUnitEvent(syncTrigger, messenger, EVENT_UNIT_DROP_ITEM)call TriggerRegisterUnitEvent(syncTrigger, messenger, EVENT_UNIT_CHANGE_OWNER)call TriggerAddCondition(syncTrigger, mu_sync_dummy_messenger)set dummy = nullset syncTrigger = nullendfunctionfunction MUSyncDummyMessenger takes nothing returns nothinglocal trigger syncTrigger = GetTriggeringTrigger()local integer syncTriggerId = GetHandleId(syncTrigger)local unit dummy = LoadUnitHandle(GameHashtable, GetHandleId(syncTrigger), 1)local unit messenger = LoadUnitHandle(GameHashtable, GetHandleId(syncTrigger), 2)local boolean need_sync_items = LoadBoolean(GameHashtable, GetHandleId(syncTrigger), 5)local integer itemSlotlocal item whichItemif dummy == null thencall RecycleExpiringTrigger(syncTrigger)set syncTrigger = nullset dummy = nullset messenger = nullreturnendifif GetTriggerEventId() == EVENT_GAME_TIMER_EXPIRED thencall UnitPauseTimedLife(dummy, true)if IsUnitType(messenger, UNIT_TYPE_DEAD) thencall ShowUnit(dummy, false)elsecall ShowUnit(dummy, true)call SetUnitX(dummy, GetUnitX(messenger))call SetUnitY(dummy, GetUnitY(messenger))endifif IsUnitType(dummy, UNIT_TYPE_DEAD) thencall MUCreateDummyMessenger(messenger, LoadPlayerHandle(GameHashtable, GetHandleId(syncTrigger), 3), LoadPlayerHandle(GameHashtable, GetHandleId(syncTrigger), 4))call FlushChildHashtable(GameHashtable, syncTriggerId)call RecycleExpiringTrigger(syncTrigger)call MUPrint("Courier dummy died")endifelseif GetTriggerEventId() == EVENT_UNIT_CHANGE_OWNER thencall DisableTrigger(ToggleableTrigger)set itemSlot = 0loopset whichItem = UnitItemInSlot(dummy, itemSlot)if whichItem != null thencall RemoveItem(whichItem)endifset itemSlot = itemSlot + 1exitwhen itemSlot > 5endloopset whichItem = nullcall EnableTrigger(ToggleableTrigger)call RemoveUnit(dummy)call FlushChildHashtable(GameHashtable, syncTriggerId)call RecycleExpiringTrigger(syncTrigger)elsecall SaveBoolean(GameHashtable, GetHandleId(syncTrigger), 5, true)endifif need_sync_items and GetTriggerEventId() == EVENT_GAME_TIMER_EXPIRED thencall SaveBoolean(GameHashtable, GetHandleId(syncTrigger), 5, false)call MUCall("performance_statistics_start()", null)call DisableTrigger(ToggleableTrigger)set itemSlot = 0loopset whichItem = UnitItemInSlot(dummy, itemSlot)if whichItem != null thencall RemoveItem(whichItem)endifset itemSlot = itemSlot + 1exitwhen itemSlot > 5endloopset itemSlot = 0loopset whichItem = UnitItemInSlot(messenger, itemSlot)if whichItem == null or (GetTriggerEventId() == EVENT_UNIT_DROP_ITEM and whichItem == GetManipulatedItem()) thenset whichItem = CreateItem('I02M', 0, 0)elseset whichItem = CreateItem(GetItemTypeId(whichItem), 0, 0)endifif not UnitAddItem(dummy, whichItem) thencall RemoveItem(whichItem)endifset itemSlot = itemSlot + 1exitwhen itemSlot > 5endloopset itemSlot = 0loopset whichItem = UnitItemInSlot(dummy, itemSlot)if GetItemTypeId(whichItem) == 'I02M' thencall RemoveItem(whichItem)endifset itemSlot = itemSlot + 1exitwhen itemSlot > 5endloopset whichItem = nullcall EnableTrigger(ToggleableTrigger)call MUCall("performance_statistics_stop()", null)endifset syncTrigger = nullset dummy = nullset messenger = nullendfunctionfunction MUGetMessengerOwner takes unit messenger returns playerreturn LoadPlayerHandle(GameHashtable, GetHandleId(messenger), StringHash("Courier owner"))endfunctionfunction MUIsMessenger takes unit messenger returns booleanreturn MUGetMessengerOwner(messenger) != nullendfunctionfunction MUIsMessengerShared takes unit messenger returns booleanreturn GetOwningPlayer(messenger) != MUGetMessengerOwner(messenger)endfunctionfunction MUIsPlayerMessengerShared takes player target returns booleanreturn LoadBoolean(GameHashtable, GetHandleId(target), StringHash("Courier sharing"))endfunctionfunction MUSetMessengerNotShare takes unit messenger returns nothinglocal player owner = MUGetMessengerOwner(messenger)local integer teammateIndexcall MUPrint("Disable courier sharing:" + I2S(GetHandleId(messenger)))if owner == null thencall MUPrint("Courier owner error")returnendifcall SetUnitOwner(messenger, owner, false)if GetPlayerTeam(owner) == 0 thenset teammateIndex = 1loopif SentinelPlayer[teammateIndex] != owner thencall DisplayTimedTextToPlayer(SentinelPlayer[teammateIndex], 0, 0, 10, "|cffffff11You can no longer control " + PlayerColorCode[GetPlayerId(owner)] + GetPlayerName(owner) + "|cffffff11's courier|r")endifset teammateIndex = teammateIndex + 1exitwhen teammateIndex > 5endloopelseset teammateIndex = 1loopif ScourgePlayer[teammateIndex] != owner thencall DisplayTimedTextToPlayer(ScourgePlayer[teammateIndex], 0, 0, 10, "|cffffff11You can no longer control " + PlayerColorCode[GetPlayerId(owner)] + GetPlayerName(owner) + "|cffffff11's courier|r")endifset teammateIndex = teammateIndex + 1exitwhen teammateIndex > 5endloopendifset owner = nullendfunctionfunction MUSetMessengerShare takes unit messenger returns nothinglocal player owner = MUGetMessengerOwner(messenger)local integer team = GetPlayerTeam(owner)local player target_player = nulllocal string namelocal integer teammateIndexcall MUPrint("Enable courier sharing:" + I2S(GetHandleId(messenger)))if team == 0 thenif SentinelPlayer[0] == Player(0) thenset target_player = Player(13)call MUInitDummyPlayer(13, 14)elseif SentinelPlayer[0] == Player(13) thenset target_player = Player(0)call MUInitDummyPlayer(0, 6)endifelseif team == 1 thenif ScourgePlayer[0] == Player(6) thenset target_player = Player(14)call MUInitDummyPlayer(13, 14)elseif ScourgePlayer[0] == Player(14) thenset target_player = Player(6)call MUInitDummyPlayer(0, 6)endifendifif target_player == null thencall MUPrint("Courier sharing could not find the target player")returnendifcall SavePlayerHandle(GameHashtable, GetHandleId(owner), StringHash("Courier sharing player"), target_player)call UnitSetUsesAltIcon(messenger, true)call SetUnitOwner(messenger, target_player, false)call SetPlayerAbilityAvailable(target_player, 'A1VV', false)call SetPlayerAbilityAvailable(target_player, 'A2XM', false)call SetPlayerAbilityAvailable(target_player, 'A29N', false)set name = GetPlayerName(target_player)call SetPlayerName(target_player, PlayerColorCode[GetPlayerId(target_player)] + "Animal courier|r")if team == 0 thenset teammateIndex = 1loopcall SetPlayerAlliance(target_player, SentinelPlayer[teammateIndex], ALLIANCE_SHARED_CONTROL, true)call UnitShareVision(messenger, SentinelPlayer[teammateIndex], true)call MUCreateDummyMessenger(messenger, SentinelPlayer[teammateIndex], owner)if SentinelPlayer[teammateIndex] != owner thencall DisplayTimedTextToPlayer(SentinelPlayer[teammateIndex], 0, 0, 10, "|cffffff11You can control " + PlayerColorCode[GetPlayerId(owner)] + GetPlayerName(owner) + "|cffffff11's courier|r")endifset teammateIndex = teammateIndex + 1exitwhen teammateIndex > 5endloopelseif team == 1 thenset teammateIndex = 1loopcall SetPlayerAlliance(target_player, ScourgePlayer[teammateIndex], ALLIANCE_SHARED_CONTROL, true)call UnitShareVision(messenger, ScourgePlayer[teammateIndex], true)call MUCreateDummyMessenger(messenger, ScourgePlayer[teammateIndex], owner)if ScourgePlayer[teammateIndex] != owner thencall DisplayTimedTextToPlayer(ScourgePlayer[teammateIndex], 0, 0, 10, "|cffffff11You can control " + PlayerColorCode[GetPlayerId(owner)] + GetPlayerName(owner) + "|cffffff11's courier|r")endifset teammateIndex = teammateIndex + 1exitwhen teammateIndex > 5endloopendifcall SetPlayerName(target_player, name)set target_player = nullset owner = nullendfunctionfunction MUChangeMessengerShare takes player target returns nothinglocal boolean flag = not MUIsPlayerMessengerShared(target)local group temp_group = CreateGroup()local unit enum_unitif flag thencall DisplayTimedTextToPlayer(target, 0, 0, 10, "|cffffff11Courier sharing enabled|r")call GroupEnumUnitsOfPlayer(temp_group, target, null)elsecall DisplayTimedTextToPlayer(target, 0, 0, 10, "|cffffff11Courier sharing disabled|r")call GroupEnumUnitsOfPlayer(temp_group, LoadPlayerHandle(GameHashtable, GetHandleId(target), StringHash("Courier sharing player")), null)endifcall SaveBoolean(GameHashtable, GetHandleId(target), StringHash("Courier sharing"), flag)loopset enum_unit = FirstOfGroup(temp_group)exitwhen enum_unit == nullcall GroupRemoveUnit(temp_group, enum_unit)if MUIsMessenger(enum_unit) thenif flag thenif not MUIsMessengerShared(enum_unit) thencall MUSetMessengerShare(enum_unit)endifelseif MUIsMessengerShared(enum_unit) thencall MUSetMessengerNotShare(enum_unit)endifendifendifendloopcall DestroyGroup(temp_group)set temp_group = nullendfunctionfunction MUInitMessenger takes unit messenger returns nothingcall SavePlayerHandle(GameHashtable, GetHandleId(messenger), StringHash("Courier owner"), GetOwningPlayer(messenger))if MUIsPlayerMessengerShared(GetOwningPlayer(messenger)) thencall MUSetMessengerShare(messenger)endifendfunctionfunction MUSpellFinish takes nothing returns nothinglocal integer skill_id = GetSpellAbilityId()if skill_id == 'A093' thencall MUTransformDebug(GetTriggerUnit(), 'AU00', 18)elseif skill_id == 'A2NE' thencall MUTransformDebug(GetTriggerUnit(), 'AU01', 6)endifendfunctionfunction MUSpellEffect takes nothing returns nothinglocal integer skill_id = GetSpellAbilityId()if skill_id == 'AU02' thencall MUChangeMessengerShare(GetTriggerPlayer())endifendfunctionfunction MUAddMaxLife takes unit target, integer life returns nothinglocal integer array abilityIdslocal integer bitIndex = 15local integer current = 32768local integer abilityLevelif life == 0 thenreturnelseif life > 0 thenset abilityLevel = 3elseset abilityLevel = 2set life = - lifeendifset abilityIds[0]  = 'YDl0'set abilityIds[1]  = 'YDl1'set abilityIds[2]  = 'YDl2'set abilityIds[3]  = 'YDl3'set abilityIds[4]  = 'YDl4'set abilityIds[5]  = 'YDl5'set abilityIds[6]  = 'YDl6'set abilityIds[7]  = 'YDl7'set abilityIds[8]  = 'YDl8'set abilityIds[9]  = 'YDl9'set abilityIds[10] = 'YDla'set abilityIds[11] = 'YDlb'set abilityIds[12] = 'YDlc'set abilityIds[13] = 'YDld'set abilityIds[14] = 'YDle'set abilityIds[15] = 'YDlf'loopexitwhen life == 0 or bitIndex == 0if life >= current thencall UnitAddAbility(target, abilityIds[bitIndex])call SetUnitAbilityLevel(target, abilityIds[bitIndex], abilityLevel)call UnitRemoveAbility(target, abilityIds[bitIndex])set life = life - currentendifset bitIndex = bitIndex - 1set current=current / 2endloopendfunctionfunction InitializeYD takes nothing returns nothinglocal rect world_bounds = nulllocal trigger eventTrigger = nulllocal integer playerIndex = 0call MUPrint("Hello Loli!")set world_bounds = GetWorldBounds()set yd_MapMinX = GetRectMinX(world_bounds)set yd_MapMinY = GetRectMinY(world_bounds)set yd_MapMaxX = GetRectMaxX(world_bounds)set yd_MapMaxY = GetRectMaxY(world_bounds)call RemoveRect(world_bounds)set world_bounds = nullset eventTrigger = CreateTrigger()set playerIndex = 0loopcall TriggerRegisterPlayerUnitEvent(eventTrigger, Player(playerIndex), EVENT_PLAYER_UNIT_SPELL_FINISH , null)set playerIndex = playerIndex + 1exitwhen playerIndex > 15endloopcall TriggerAddCondition(eventTrigger, Condition(function MUSpellFinish))set eventTrigger = nullset eventTrigger = CreateTrigger()set playerIndex = 0loopcall TriggerRegisterPlayerUnitEvent(eventTrigger,Player(playerIndex),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)set playerIndex=playerIndex+1exitwhen playerIndex>15endloopcall TriggerAddCondition(eventTrigger, Condition(function MUSpellEffect))set eventTrigger = nullset eventTrigger = CreateTrigger()set playerIndex = 0loopcall TriggerRegisterPlayerChatEvent(eventTrigger, Player(playerIndex), "-JY ", false)set playerIndex = playerIndex + 1exitwhen playerIndex > 15endloopcall TriggerAddCondition(eventTrigger, Condition(function MUPlayerGag))set eventTrigger = nullset playerIndex = 1loopset mu_temp_string = mu_temp_string + "|r"set playerIndex = playerIndex + 1exitwhen playerIndex > 100endloopset mu_sync_dummy_messenger = Condition(function MUSyncDummyMessenger)endfunctionfunction PolledWaitShared takes real duration returns nothinglocal real remaininglocal real startTime=TimerGetElapsed(ElapsedMeasureTimer)if startTime<=0 thenset ElapsedMeasureTimer=CreateTimer()call TimerStart(ElapsedMeasureTimer,1000000,false,null)endifif(duration>0)thenloopset remaining=duration-TimerGetElapsed(ElapsedMeasureTimer)+startTimeexitwhen remaining<=0if(remaining>bj_POLLED_WAIT_SKIP_THRESHOLD)thencall TriggerSleepAction(.1*remaining)elsecall TriggerSleepAction(bj_POLLED_WAIT_INTERVAL)endifendloopendifendfunctionfunction SelectUnitByFlag takes boolean condition,unit trueUnit,unit falseUnit returns unitif condition thenreturn trueUnitelsereturn falseUnitendifreturn nullendfunctionfunction SelectIntByFlag takes boolean condition,integer trueValue,integer falseValue returns integerif condition thenreturn trueValueelsereturn falseValueendifreturn 0endfunctionfunction SelectStringByFlag takes boolean condition,string trueString,string falseString returns stringif condition thenreturn trueStringelsereturn falseStringendifreturn""endfunctionfunction SelectRealByFlag takes boolean condition,real trueValue,real falseValue returns realif condition thenreturn trueValueelsereturn falseValueendifreturn .0endfunctionfunction UnitsInRangeOfLoc takes real radius,location whichLocation,boolexpr filter returns groupset EnumUnitsGroup=CreateGroup()call GroupEnumUnitsInRangeOfLoc(EnumUnitsGroup,whichLocation,radius,filter)if filter!=null thencall DestroyBoolExpr(filter)endifreturn EnumUnitsGroupendfunctionfunction UnitsInRect takes rect whichRect,boolexpr filter returns groupset EnumUnitsGroup=CreateGroup()call GroupEnumUnitsInRect(EnumUnitsGroup,whichRect,filter)if filter!=null thencall DestroyBoolExpr(filter)endifreturn EnumUnitsGroupendfunctionfunction UnitsInRectOfPlayer takes rect whichRect,player whichPlayer returns groupset EnumUnitsGroup=CreateGroup()set bj_groupEnumOwningPlayer=whichPlayercall GroupEnumUnitsInRect(EnumUnitsGroup,whichRect,filterGetUnitsInRectOfPlayer)return EnumUnitsGroupendfunctionfunction DebugMessageToTriggerPlayer takes string message returns booleanif IsTestBuildEnabled and PlayerTestFeatureEnabled[GetPlayerId(GetTriggerPlayer())]thencall DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,45,message)endifreturn trueendfunctionfunction PruneStaleAttackTargets takes nothing returns booleanlocal integer lastIndex=LoadInteger(AttackTrackingHashtable,AttackRecordParentKey,AttackListTop2Key)-1local unit lastUnitlocal real lastTimelocal integer lastCount=0set AttackRecordChildIndex=0loopexitwhen AttackRecordChildIndex>lastIndexif CurrentElapsedTime-LoadReal(AttackTrackingHashtable,AttackRecordParentKey,AttackRecordChildIndex)>2.5 or IsUnit(LoadUnitHandle(AttackTrackingHashtable,AttackRecordParentKey,AttackRecordChildIndex),null)thenset lastUnit=LoadUnitHandle(AttackTrackingHashtable,AttackRecordParentKey,lastIndex)set lastTime=LoadReal(AttackTrackingHashtable,AttackRecordParentKey,lastIndex)set lastCount=LoadInteger(AttackTrackingHashtable,AttackRecordParentKey,lastIndex)call RemoveSavedBoolean(AttackTrackingHashtable,AttackRecordParentKey,GetHandleId(LoadUnitHandle(AttackTrackingHashtable,AttackRecordParentKey,AttackRecordChildIndex)))call RemoveSavedInteger(AttackTrackingHashtable,AttackRecordParentKey,GetHandleId(LoadUnitHandle(AttackTrackingHashtable,AttackRecordParentKey,AttackRecordChildIndex)))call SaveUnitHandle(AttackTrackingHashtable,AttackRecordParentKey,AttackRecordChildIndex,lastUnit)call SaveReal(AttackTrackingHashtable,AttackRecordParentKey,AttackRecordChildIndex,lastTime)call SaveInteger(AttackTrackingHashtable,AttackRecordParentKey,AttackRecordChildIndex,lastCount)call RemoveSavedHandle(AttackTrackingHashtable,AttackRecordParentKey,lastIndex)call RemoveSavedReal(AttackTrackingHashtable,AttackRecordParentKey,lastIndex)call RemoveSavedInteger(AttackTrackingHashtable,AttackRecordParentKey,lastIndex)call SaveInteger(AttackTrackingHashtable,AttackRecordParentKey,GetHandleId(lastUnit),AttackRecordChildIndex)call SaveInteger(AttackTrackingHashtable,AttackRecordParentKey,AttackListTop2Key,lastIndex)set lastIndex=lastIndex-1endifset AttackRecordChildIndex=AttackRecordChildIndex+1endloopset lastUnit=nullreturn lastIndex==-1endfunctionfunction PruneStaleAttackers takes nothing returns booleanlocal integer lastIndex=LoadInteger(AttackTrackingHashtable,AttackRecordParentKey,AttackListTop1Key)-1local integer lastKey=lastIndex+AttackHashKeylocal unit lastUnitlocal real lastTimelocal integer lastCountset AttackRecordChildIndex=AttackHashKeyloopexitwhen AttackRecordChildIndex>lastKeyif CurrentElapsedTime-LoadReal(AttackTrackingHashtable,AttackRecordParentKey,AttackRecordChildIndex)>=2+SelectRealByFlag(IsUnitType(LoadUnitHandle(AttackTrackingHashtable,AttackRecordParentKey,AttackRecordChildIndex),UNIT_TYPE_HERO),2,.8)or IsUnit(LoadUnitHandle(AttackTrackingHashtable,AttackRecordParentKey,AttackRecordChildIndex),null)thenset lastUnit=LoadUnitHandle(AttackTrackingHashtable,AttackRecordParentKey,lastIndex)set lastTime=LoadReal(AttackTrackingHashtable,AttackRecordParentKey,lastIndex)set lastCount=LoadInteger(AttackTrackingHashtable,AttackRecordParentKey,lastIndex)call RemoveSavedBoolean(AttackTrackingHashtable,AttackRecordParentKey,AttackHashKey+GetHandleId(LoadUnitHandle(AttackTrackingHashtable,AttackRecordParentKey,AttackRecordChildIndex)))call RemoveSavedInteger(AttackTrackingHashtable,AttackRecordParentKey,AttackHashKey+GetHandleId(LoadUnitHandle(AttackTrackingHashtable,AttackRecordParentKey,AttackRecordChildIndex)))call SaveUnitHandle(AttackTrackingHashtable,AttackRecordParentKey,AttackRecordChildIndex,lastUnit)call SaveReal(AttackTrackingHashtable,AttackRecordParentKey,AttackRecordChildIndex,lastTime)call SaveInteger(AttackTrackingHashtable,AttackRecordParentKey,AttackRecordChildIndex,lastCount)call RemoveSavedHandle(AttackTrackingHashtable,AttackRecordParentKey,lastIndex)call RemoveSavedReal(AttackTrackingHashtable,AttackRecordParentKey,lastIndex)call RemoveSavedInteger(AttackTrackingHashtable,AttackRecordParentKey,lastIndex)call SaveInteger(AttackTrackingHashtable,AttackRecordParentKey,GetHandleId(lastUnit),AttackRecordChildIndex)call SaveInteger(AttackTrackingHashtable,AttackRecordParentKey,AttackListTop1Key,lastIndex)set lastIndex=lastIndex-1endifset AttackRecordChildIndex=AttackRecordChildIndex+1endloopset lastUnit=nullreturn lastIndex==-1endfunctionfunction RemoveTrackedUnitIf takes boolean shouldRemove returns nothingif shouldRemove and TrackedUnitCount>0 thencall FlushChildHashtable(AttackTrackingHashtable,AttackRecordParentKey)set AttackListUnit[TrackedUnitLoopIndex]=AttackListUnit[TrackedUnitCount-1]set AttackListCategory[TrackedUnitLoopIndex]=AttackListCategory[TrackedUnitCount-1]set AttackListUnit[TrackedUnitCount-1]=nullset AttackListCategory[TrackedUnitCount-1]=0set TrackedUnitCount=TrackedUnitCount-1endifendfunctionfunction CleanupAttackTargetsForUnit takes nothing returns nothingcall RemoveTrackedUnitIf(PruneStaleAttackTargets())endfunctionfunction CleanupAttackersForUnit takes nothing returns nothingcall RemoveTrackedUnitIf(PruneStaleAttackers())endfunctionfunction UpdateAttackTracking takes nothing returns booleanset TrackedUnitParityCounter=TrackedUnitParityCounter+1set TrackedUnitLoopIndex=0set CurrentElapsedTime=TimerGetElapsed(GameClockTimer)loopexitwhen TrackedUnitLoopIndex>=TrackedUnitCountset AttackRecordParentKey=GetHandleId(AttackListUnit[TrackedUnitLoopIndex])if IsUnit(AttackListUnit[TrackedUnitLoopIndex],null)or GetWidgetLife(AttackListUnit[TrackedUnitLoopIndex])<=.405 thencall RemoveTrackedUnitIf(true)elseif AttackListCategory[TrackedUnitLoopIndex]==TrackedUnitTypeSecondary thencall ExecuteFunc("CleanupAttackTargetsForUnit")elseif AttackListCategory[TrackedUnitLoopIndex]==TrackedUnitTypePrimary and TrackedUnitParityCounter-TrackedUnitParityCounter/2*2==0 thencall ExecuteFunc("CleanupAttackersForUnit")endifset TrackedUnitLoopIndex=TrackedUnitLoopIndex+1endifendloopreturn falseendfunctionfunction RecordAttackerOnTarget takes unit targetUnit,unit attackerUnit returns nothinglocal integer targetId=GetHandleId(targetUnit)local integer slotIndexlocal integer attackerId=GetHandleId(attackerUnit)if not LoadBoolean(AttackTrackingHashtable,targetId,attackerId+AttackHashKey)thenset slotIndex=LoadInteger(AttackTrackingHashtable,targetId,AttackListTop1Key)if slotIndex==0 thenset AttackListUnit[TrackedUnitCount]=(targetUnit)set AttackListCategory[TrackedUnitCount]=TrackedUnitTypePrimaryset TrackedUnitCount=TrackedUnitCount+1endifcall SaveUnitHandle(AttackTrackingHashtable,targetId,AttackHashKey+slotIndex,attackerUnit)call SaveInteger(AttackTrackingHashtable,targetId,AttackListTop1Key,slotIndex+1)call SaveBoolean(AttackTrackingHashtable,targetId,attackerId+AttackHashKey,true)call SaveInteger(AttackTrackingHashtable,targetId,attackerId+AttackHashKey,slotIndex)elseset slotIndex=LoadInteger(AttackTrackingHashtable,targetId,attackerId+AttackHashKey)endifcall SaveReal(AttackTrackingHashtable,targetId,AttackHashKey+slotIndex,TimerGetElapsed(GameClockTimer))call SaveInteger(AttackTrackingHashtable,targetId,AttackHashKey+slotIndex,LoadInteger(AttackTrackingHashtable,targetId,AttackHashKey+slotIndex)+1)endfunctionfunction RecordTargetForAttacker takes unit attackerUnit,unit targetUnit returns nothinglocal integer attackerId=GetHandleId(attackerUnit)local integer slotIndexlocal integer targetId=GetHandleId(targetUnit)if not LoadBoolean(AttackTrackingHashtable,attackerId,targetId)thenset slotIndex=LoadInteger(AttackTrackingHashtable,attackerId,AttackListTop2Key)if slotIndex==0 thenset AttackListUnit[TrackedUnitCount]=(attackerUnit)set TrackedUnitCount=TrackedUnitCount+1endifcall SaveUnitHandle(AttackTrackingHashtable,attackerId,slotIndex,targetUnit)call SaveInteger(AttackTrackingHashtable,attackerId,AttackListTop2Key,slotIndex+1)call SaveBoolean(AttackTrackingHashtable,attackerId,targetId,true)call SaveInteger(AttackTrackingHashtable,attackerId,targetId,slotIndex)elseset slotIndex=LoadInteger(AttackTrackingHashtable,attackerId,targetId)endifcall SaveReal(AttackTrackingHashtable,attackerId,slotIndex,TimerGetElapsed(GameClockTimer))call SaveInteger(AttackTrackingHashtable,attackerId,slotIndex,LoadInteger(AttackTrackingHashtable,attackerId,slotIndex)+1)endfunctionfunction OnUnitAttacked takes nothing returns booleanlocal unit attackerlocal unit triggerUnitlocal integer pointeridset attacker=GetAttacker()set triggerUnit=GetTriggerUnit()call RecordAttackerOnTarget(triggerUnit,attacker)call RecordTargetForAttacker(attacker,triggerUnit)set attacker=nullset triggerUnit=nullreturn falseendfunctionfunction RegisterAttackTracking takes unit trackedUnit returns nothinglocal trigger whichTrigger=nullif IsUnit(trackedUnit,null)==false thenset whichTrigger=CreateTrigger()call TriggerRegisterUnitEvent(whichTrigger,trackedUnit,EVENT_UNIT_ATTACKED)call TriggerAddCondition(whichTrigger,Condition(function OnUnitAttacked))set whichTrigger=nullendifendfunctionfunction GetAttackerCount takes unit unit_2 returns integerreturn LoadInteger(AttackTrackingHashtable,GetHandleId(unit_2),AttackListTop1Key)endfunctionfunction IsAttackedByHeroOrStructure takes unit unit_2 returns booleanlocal integer indexlocal integer endIndexlocal integer handleIdif LoadInteger(AttackTrackingHashtable,GetHandleId(unit_2),AttackListTop1Key)==0 thenreturn falseendifset index=AttackHashKeyset endIndex=AttackHashKey+LoadInteger(AttackTrackingHashtable,GetHandleId(unit_2),AttackListTop1Key)set handleId=GetHandleId(unit_2)loopexitwhen index>=endIndexif IsUnitType(LoadUnitHandle(AttackTrackingHashtable,handleId,index),UNIT_TYPE_HERO) or IsUnitType(LoadUnitHandle(AttackTrackingHashtable,handleId,index),UNIT_TYPE_STRUCTURE) thenreturn trueendifset index=index+1endloopreturn falseendfunctionfunction IsAttackingHeroOrStructure takes unit unit_2 returns booleanlocal integer indexlocal integer countlocal integer handleIdif LoadInteger(AttackTrackingHashtable,GetHandleId(unit_2),AttackListTop2Key)==0 thenreturn falseendifset index=0set count=LoadInteger(AttackTrackingHashtable,GetHandleId(unit_2),AttackListTop2Key)set handleId=GetHandleId(unit_2)loopexitwhen index>=countif IsUnitType(LoadUnitHandle(AttackTrackingHashtable,handleId,index),UNIT_TYPE_HERO) or IsUnitType(LoadUnitHandle(AttackTrackingHashtable,handleId,index),UNIT_TYPE_STRUCTURE) thenreturn trueendifset index=index+1endloopreturn falseendfunctionfunction InitPeriodicTrackerArrays takes nothing returns nothinglocal integer index=0call TriggerRegisterTimerEvent(AttackTrackingTimer,2.5,true)call TriggerAddCondition(AttackTrackingTimer,Condition(function UpdateAttackTracking))loopexitwhen index>1024set AttackListUnit[index]=nullset AttackListCategory[index]=0set index=index+1endloopendfunctionfunction RegisterWatchedAbilities takes nothing returns nothingcall RegisterAttackTracking(TowerLane1Tier1)call RegisterAttackTracking(TowerLane2Tier1)call RegisterAttackTracking(TowerLane3Tier1)call RegisterAttackTracking(TowerLane1Tier2)call RegisterAttackTracking(TowerLane2Tier2)call RegisterAttackTracking(TowerLane3Tier2)call RegisterAttackTracking(TowerLane1Tier3)call RegisterAttackTracking(TowerLane2Tier3)call RegisterAttackTracking(TowerLane3Tier3)call RegisterAttackTracking(TrackedBaseStructureA)call RegisterAttackTracking(TrackedBaseStructureB)call RegisterAttackTracking(LaneTowerJW)call RegisterAttackTracking(LaneTowerJX)call RegisterAttackTracking(LaneTowerJY)call RegisterAttackTracking(LaneTowerJZ)call RegisterAttackTracking(GuardTowerJA4)call RegisterAttackTracking(GuardTowerJB4)call RegisterAttackTracking(GuardTowerJC4)call RegisterAttackTracking(GuardTowerJ34)call RegisterAttackTracking(GuardTowerJ64)call RegisterAttackTracking(GuardTowerJL4)call RegisterAttackTracking(GuardTowerJ14)endfunctionfunction AlwaysTrue takes string text returns booleanreturn trueendfunctionfunction DebugPrintGlobal takes string message returns nothingif(IsDebugMode)and(DebugSelectedPlayer==-1)thencall DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,16.,message)endifendfunctionfunction LogDebugMessageToChannel takes integer playerId,string message returns nothinglocal integer colorIndex=playerIdif not(colorIndex<1 or colorIndex>11 or colorIndex==0 or colorIndex==6)thenset PlayerChatLogLine[ChatLogCapacity*playerId+ChatLogWriteIndex[playerId]]=messageset ChatLogWriteIndex[playerId]=ChatLogWriteIndex[playerId]+1if ChatLogWriteIndex[playerId]>=ChatLogCapacity thenset ChatLogWriteIndex[playerId]=0endifendifset colorIndex=playerIdif colorIndex==6 thenset colorIndex=11elseif colorIndex>11 thenelseif colorIndex>5 thenset colorIndex=colorIndex-1endifset message=PlayerColorCode[playerId]+I2S(colorIndex)+"|r- "+messageif(IsDebugMode)and(DebugSelectedPlayer==-1 or DebugSelectedPlayer==playerId)thencall DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,16.,message)endifendfunctionfunction ShowDebugChannelHistory takes nothing returns booleanlocal string chatString=GetEventPlayerChatString()local integer logPlayerIndex=0local integer lineIndexif StringLength(chatString)>5 and(chatString!="-dbgmode")thenset DebugSelectedPlayer=S2I(SubString(chatString,5,StringLength(chatString)))if not(DebugSelectedPlayer<1 or DebugSelectedPlayer>10)thencall ClearTextMessages()set logPlayerIndex=DebugSelectedPlayerif DebugSelectedPlayer>5 thenset logPlayerIndex=logPlayerIndex+1endifset lineIndex=ChatLogWriteIndex[logPlayerIndex]loopif PlayerChatLogLine[ChatLogCapacity*logPlayerIndex+lineIndex]!=null thencall DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,16.,PlayerColorCode[logPlayerIndex]+I2S(DebugSelectedPlayer)+"|r- "+PlayerChatLogLine[ChatLogCapacity*logPlayerIndex+lineIndex])endifexitwhen(lineIndex==ChatLogWriteIndex[logPlayerIndex]-1)set lineIndex=lineIndex+1if lineIndex>=ChatLogCapacity thenexitwhen(ChatLogWriteIndex[logPlayerIndex]==0)set lineIndex=0endifendloopcall DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,16.,"***Debug messages of |c00ffff00"+PlayerName[logPlayerIndex]+"|r***")endifelseset DebugSelectedPlayer=-1endifreturn falseendfunctionfunction IntToStringSpaced takes integer value returns stringreturn I2S(value)+" "endfunctionfunction BoolToTF takes boolean flag returns stringif flag thenreturn"T "endifreturn"F "endfunctionfunction LocationToString takes location whichLocation returns stringreturn"("+R2S(GetLocationX(whichLocation))+", "+R2S(GetLocationY(whichLocation))+")"endfunctionfunction AsciiCodeToChar takes integer asciiCode returns stringlocal string digits="0123456789"local string upperLetters="ABCDEFGHIJKLMNOPQRSTUVWXYZ"local string lowerLetters="abcdefghijklmnopqrstuvwxyz"if asciiCode>=48 and asciiCode<=57 thenreturn SubString(digits,asciiCode-48,asciiCode-47)elseif asciiCode>=65 and asciiCode<=90 thenreturn SubString(upperLetters,asciiCode-65,asciiCode-64)elseif asciiCode>=97 and asciiCode<='z' thenreturn SubString(lowerLetters,asciiCode-97,asciiCode-96)endifreturn""endfunctionfunction IntToRawcodeString takes integer value returns stringlocal integer byteValuelocal string result=""local integer byteIndex=0loopexitwhen byteIndex>3set byteValue=ModuloInteger(value,256)set value=(value-byteValue)/ 256set result=AsciiCodeToChar(byteValue)+resultset byteIndex=byteIndex+1endloopif StringLength(result)==4 thenreturn resultendifreturn"?"endfunctionfunction AddWatchExpression takes string variableName returns nothinglocal integer tagIndexlocal integer playerIndexset tagIndex=0loopexitwhen tagIndex>MaxWatchVariablesif WatchVariableName[tagIndex]==variableName thenreturnendifset tagIndex=tagIndex+1endloopset WatchVariableName[WatchVariableIndex]=variableNameset playerIndex=0loopexitwhen playerIndex>11if playerIndex==6 thenset playerIndex=7endifif GetPlayerSlotState(Player(playerIndex))==PLAYER_SLOT_STATE_PLAYING thenset tagIndex=playerIndex*MaxWatchVariables+WatchVariableIndexcall DestroyTextTag(WatchTextTag[tagIndex])set WatchTextTag[tagIndex]=CreateTextTag()call SetTextTagText(WatchTextTag[tagIndex]," ",WatchTagTextHeight)call SetTextTagPosUnit(WatchTextTag[tagIndex],TrackedSideUnit[playerIndex],45*WatchVariableIndex)call SetTextTagVisibility(WatchTextTag[tagIndex],true)call SetTextTagPermanent(WatchTextTag[tagIndex],true)call SetTextTagColor(WatchTextTag[tagIndex],PlayerColorRed[playerIndex]+100,PlayerColorGreen[playerIndex]+100,PlayerColorBlue[playerIndex]+100,255)endifset playerIndex=playerIndex+1endloopset WatchVariableIndex=WatchVariableIndex+1if WatchVariableIndex>MaxWatchVariables thenset WatchVariableIndex=0endifendfunctionfunction ClearWatchDisplay takes nothing returns nothinglocal integer indexset index=0loopexitwhen index>MaxWatchVariablesset WatchVariableName[index]=""set index=index+1endloopset WatchVariableIndex=0set index=0loopexitwhen index>12*MaxWatchVariablescall DestroyTextTag(WatchTextTag[index])set WatchTextTag[index]=nullset index=index+1endloopcall DestroyTimer(WatchTagTextTimer)call DestroyTimer(WatchTagPositionTimer)set WatchTagTextTimer=nullset WatchTagPositionTimer=nullendfunctionfunction FormatWatchVariable takes string variableName,integer offset returns stringlocal integer parsedIndex=0local string valueString=""local integer charIndex=0local integer length=StringLength(variableName)loopexitwhen charIndex>=lengthif SubString(variableName,charIndex,charIndex+1)==" " or SubString(variableName,charIndex,charIndex+1)=="[" thenset parsedIndex=S2I(SubString(variableName,charIndex+1,length))set variableName=SubString(variableName,0,charIndex)exitwhen trueendifset charIndex=charIndex+1endloopif charIndex>=length thenreturn"-"endifif variableName=="eY" thenset valueString=I2S(PlayerLaneRole[parsedIndex+offset])elseif variableName=="g_aiItemInt" thenset valueString=I2S(PlayerItemStateData[parsedIndex+offset])elseif variableName=="hG" thenset valueString=I2S(PlayerItemGoldWorth[parsedIndex+offset])elseif variableName=="ga_rSkillCD" thenset valueString=R2S(AiAbilityNextCastTime[parsedIndex+offset])elseif variableName=="G0" thenset valueString=BoolToTF(AiSlotBoolFlagG0[parsedIndex+offset])elseif variableName=="GZ" thenset valueString=BoolToTF(AiSlotBoolFlagGZ[parsedIndex+offset])elseif variableName=="g_aiItemBool" thenset valueString=BoolToTF(PlayerAiFlag[parsedIndex+offset])elseif variableName=="h4" thenif AiPrimaryTargetUnit[parsedIndex+offset]==null thenset valueString="<>"elseset valueString=GetUnitName(AiPrimaryTargetUnit[parsedIndex+offset])endifelseif variableName=="h9" thenif AiSurroundTargetUnit[parsedIndex+offset]==null thenset valueString="?"endifset valueString=I2S(GetUnitUserData(AiSurroundTargetUnit[parsedIndex+offset]))elseif variableName=="h8" thenif AiAssignedUnit[parsedIndex+offset]==null thenset valueString="?"endifset valueString=I2S(GetUnitUserData(AiAssignedUnit[parsedIndex+offset]))elseif variableName=="debugStr" thenset valueString=PlayerChatLogLine[parsedIndex+offset]endifif valueString!="" thenreturn variableName+"["+I2S(parsedIndex)+"+"+I2S(offset)+"] = "+valueStringendifreturn"-"endfunctionfunction RefreshWatchTagText takes nothing returns nothinglocal integer varIndex=0local integer sideIndex=0loopexitwhen varIndex>MaxWatchVariablesif WatchVariableName[varIndex]!="" thenset sideIndex=0loopexitwhen sideIndex>11if sideIndex==6 thenset sideIndex=7endifif WatchTextTag[sideIndex*MaxWatchVariables+varIndex]!=null thencall SetTextTagText(WatchTextTag[sideIndex*MaxWatchVariables+varIndex],FormatWatchVariable(WatchVariableName[varIndex],sideIndex),WatchTagTextHeight)endifset sideIndex=sideIndex+1endloopendifset varIndex=varIndex+1endloopendfunctionfunction RefreshWatchTagPositions takes nothing returns nothinglocal integer varIndex=0local integer sideIndex=0loopexitwhen varIndex>MaxWatchVariablesif WatchVariableName[varIndex]!="" thenset sideIndex=0loopexitwhen sideIndex>11if sideIndex==6 thenset sideIndex=7endifif WatchTextTag[sideIndex*MaxWatchVariables+varIndex]!=null thencall SetTextTagPosUnit(WatchTextTag[sideIndex*MaxWatchVariables+varIndex],TrackedSideUnit[sideIndex],45*varIndex)endifset sideIndex=sideIndex+1endloopendifset varIndex=varIndex+1endloopendfunctionfunction HandleWatchCommand takes nothing returns nothinglocal string chatString=GetEventPlayerChatString()local integer prefixLength=StringLength(GetEventPlayerChatStringMatched())+1if prefixLength<StringLength(chatString)thenset chatString=SubString(chatString,prefixLength,255)if FormatWatchVariable(chatString,1)=="-" thencall DisplayTextToPlayer(GetTriggerPlayer(),0,0,"Watcher parameter not yet supported: "+chatString)returnendifcall DisplayTextToPlayer(GetTriggerPlayer(),0,0,"Watcher activated for |c00ffcc00"+chatString+"|r")call AddWatchExpression(chatString)if WatchTagTextTimer==null thenset WatchTagTextTimer=CreateTimer()call TimerStart(WatchTagTextTimer,WatchTagTextRefreshInterval,true,function RefreshWatchTagText)call RefreshWatchTagText()set WatchTagPositionTimer=CreateTimer()call TimerStart(WatchTagPositionTimer,WatchTagPositionRefreshInterval,true,function RefreshWatchTagPositions)endifreturnendifcall DisplayTextToPlayer(GetTriggerPlayer(),0,0,"Watcher deactivated")call ClearWatchDisplay()endfunctionfunction PrintTimedTextLocal takes string message returns nothingcall DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,16.,message)endfunctionfunction HandleOrderCheatSetLifeLow takes nothing returns booleancall SetUnitState(TrackedSideUnit[2],UNIT_STATE_LIFE,10)call SetUnitState(TrackedSideUnit[1],UNIT_STATE_LIFE,10)return trueendfunctionfunction EnableSharedControlAndOrderCommand takes boolean enable returns nothinglocal trigger orderTrigger=CreateTrigger()local integer playerIndex=0loopexitwhen playerIndex>11if IsPlayerAlly(Player(playerIndex),GetTriggerPlayer())and Player(playerIndex)!=GetTriggerPlayer() and Player(playerIndex)!=SentinelPlayer[0] and Player(playerIndex)!=ScourgePlayer[0] thencall SetPlayerAlliance(Player(playerIndex),GetTriggerPlayer(),ALLIANCE_SHARED_CONTROL,enable)call SetPlayerAlliance(Player(playerIndex),GetTriggerPlayer(),ALLIANCE_SHARED_ADVANCED_CONTROL,enable)endifset playerIndex=playerIndex+1endloopcall TriggerRegisterPlayerChatEvent(orderTrigger,GetTriggerPlayer(),"-order",false)call TriggerAddCondition(orderTrigger,Condition(function HandleOrderCheatSetLifeLow))endfunctionfunction GetScaledUnitLife takes unit targetUnit returns realreturn GetWidgetLife(targetUnit)*AiPlayerTimeThreshold[752+GetPlayerId(GetOwningPlayer(targetUnit))]endfunctionfunction UnitManaMeetsThreshold takes unit targetUnit,real manaPercentThreshold,real manaValueThreshold,integer checkMode returns booleanif checkMode==ManaCheckModeTwo thenreturn GetUnitManaPercent(targetUnit)>=manaPercentThreshold or GetUnitState(targetUnit,UNIT_STATE_MANA)>=manaValueThresholdendifreturn GetUnitManaPercent(targetUnit)<=manaPercentThreshold or GetUnitState(targetUnit,UNIT_STATE_MANA)<=manaValueThresholdendfunctionfunction UnitManaMeetsThresholdAlt takes unit targetUnit,real manaPercentThreshold,real manaValueThreshold,integer checkMode returns booleanif checkMode==ManaCheckModeTwo thenreturn GetUnitManaPercent(targetUnit)>=manaPercentThreshold or GetUnitState(targetUnit,UNIT_STATE_MANA)>=manaValueThresholdendifreturn GetUnitManaPercent(targetUnit)<=manaPercentThreshold or GetUnitState(targetUnit,UNIT_STATE_MANA)<=manaValueThresholdendfunctionfunction AngleBetweenUnits takes unit fromUnit,unit toUnit returns realreturn bj_RADTODEG*Atan2(GetUnitY(toUnit)-GetUnitY(fromUnit),GetUnitX(toUnit)-GetUnitX(fromUnit))endfunctionfunction AngleBetweenCoords takes real fromX,real fromY,real targetX,real targetY returns realreturn bj_RADTODEG*Atan2(targetY-fromY,targetX-fromX)endfunctionfunction GetAIDifficultyLabel takes player aiPlayer returns stringif(AiAggressionLevel[GetPlayerId(aiPlayer)]==AiAggressionLow)thenreturn"E "elseif(AiAggressionLevel[GetPlayerId(aiPlayer)]==AiAggressionMedium)thenreturn"N "elsereturn"I "endifendfunctionfunction CacheAIDifficultyLevel takes player aiPlayer returns nothingif GetAIDifficulty(aiPlayer)==AI_DIFFICULTY_NEWBIE thenset AiAggressionLevel[GetPlayerId(aiPlayer)]=AiAggressionLowelseif GetAIDifficulty(aiPlayer)==AI_DIFFICULTY_NORMAL thenset AiAggressionLevel[GetPlayerId(aiPlayer)]=AiAggressionMediumelseif GetAIDifficulty(aiPlayer)==AI_DIFFICULTY_INSANE thenset AiAggressionLevel[GetPlayerId(aiPlayer)]=AiAggressionHighelseset AiAggressionLevel[GetPlayerId(aiPlayer)]=AiAggressionNoneendifendfunctionfunction GetHeroPrimaryRoleFlag takes integer heroTypeId returns integerif(heroTypeId=='HC49' or heroTypeId=='HC92' or heroTypeId=='N01O' or heroTypeId=='Nbbc' or heroTypeId=='Huth' or heroTypeId=='Ogrh' or heroTypeId=='E005' or heroTypeId=='N016' or heroTypeId=='Nbrn' or heroTypeId=='Eevi' or heroTypeId=='U006' or heroTypeId=='Ewar' or heroTypeId=='E004' or heroTypeId=='EC45' or heroTypeId=='EC77' or heroTypeId=='Nfir' or heroTypeId=='Hvsh' or heroTypeId=='E01B' or heroTypeId=='H00I' or heroTypeId=='H071')thenreturn HeroRoleCategoryOneendifif(heroTypeId=='Hvwd' or heroTypeId=='O00P' or heroTypeId=='H001' or heroTypeId=='HC49' or heroTypeId=='HC92' or heroTypeId=='N01O' or heroTypeId=='Nbbc' or heroTypeId=='Huth' or heroTypeId=='Ogrh' or heroTypeId=='E005' or heroTypeId=='Usyl' or heroTypeId=='H008' or heroTypeId=='Naka' or heroTypeId=='Hlgr' or heroTypeId=='Edem' or heroTypeId=='Nbrn' or heroTypeId=='H00D' or heroTypeId=='N01V' or heroTypeId=='H00Q' or heroTypeId=='E01Y' or heroTypeId=='H00T' or heroTypeId=='H06S' or heroTypeId=='Eevi' or heroTypeId=='EC57' or heroTypeId=='UC11' or heroTypeId=='U00A' or heroTypeId=='U008' or heroTypeId=='U006' or heroTypeId=='H00V' or heroTypeId=='Udre' or heroTypeId=='UC42' or heroTypeId=='U000' or heroTypeId=='UC91' or heroTypeId=='EC45' or heroTypeId=='EC77' or heroTypeId=='E002' or heroTypeId=='U00C' or heroTypeId=='O00J' or heroTypeId=='Ubal' or heroTypeId=='Nfir' or heroTypeId=='U00K' or heroTypeId=='Hvsh' or heroTypeId=='E01B' or heroTypeId=='H00I' or heroTypeId=='H071' or heroTypeId=='E02I' or heroTyp