evel(targetUnit,0,0)endifcall FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(triggeringTrigger)set triggeringTrigger=nullset casterUnit=nullset targetUnit=nullreturn falseendfunctionfunction EnumApplyStickyNapalmStack takes nothing returns nothinglocal unit caster=GetTriggerUnit()local unit target=GetEnumUnit()local trigger stackTriggerlocal integer triggerIdlocal integer abilityLevel=GetUnitAbilityLevel(caster,'A1EL')local integer stackCount=IMinBJ((LoadInteger(GameHashtable,(GetHandleId(target)),(281)))+1,10)if UnitHasAnyImmunityAbilityOrFlag(target)thenset caster=nullset target=nullreturnendifcall SetTieredAbilityLevel(target,abilityLevel,stackCount)call SaveInteger(GameHashtable,(GetHandleId(target)),(281),(stackCount))call SaveReal(GameHashtable,(GetHandleId(target)),(675),(((TimerGetElapsed(GameClockTimer)))*1.0))call SetUnitTurnSpeed(target,GetUnitDefaultTurnSpeed(target)*.3)if IsUnitType(target,UNIT_TYPE_HERO) thencall CreateTimedTextTagForAllies(GetOwningPlayer(caster),I2S(stackCount)+"!",2,target,.026,50,0,255,216)endifif stackCount==1 thenset stackTrigger=CreateTrigger()set triggerId=GetHandleId(stackTrigger)call SaveUnitHandle(GameHashtable,(triggerId),(2),(caster))call SaveUnitHandle(GameHashtable,(triggerId),(17),(target))call SaveBoolean(GameHashtable,(triggerId),(280),(false))call TriggerRegisterUnitEvent(stackTrigger,target,EVENT_UNIT_DAMAGED)call TriggerRegisterUnitEvent(stackTrigger,target,EVENT_UNIT_DEATH)call TriggerRegisterTimerEvent(stackTrigger,1,true)call TriggerAddCondition(stackTrigger,Condition(function OnStickyNapalmDamageAmplify))endifset stackTrigger=CreateTrigger()set triggerId=GetHandleId(stackTrigger)call TriggerRegisterTimerEvent(stackTrigger,8,false)call TriggerAddCondition(stackTrigger,Condition(function OnStickyNapalmStackExpire))call SaveUnitHandle(GameHashtable,(triggerId),(2),(caster))call SaveUnitHandle(GameHashtable,(triggerId),(17),(target))set stackTrigger=nullset caster=nullset target=nullendfunctionfunction CastStickyNapalm takes nothing returns nothinglocal group enumGroup=AcquireGroupFromPool()local location targetLoc=GetSpellTargetLoc()local real targetX=GetLocationX(targetLoc)local real targetY=GetLocationY(targetLoc)local unit casterUnit=GetTriggerUnit()call GroupEnumUnitsInRange(enumGroup,targetX,targetY,400,Condition(function FilterEnemyTargetAncientAware))call ForGroup(enumGroup,function EnumApplyStickyNapalmStack)call GrantTimedVisionAt(GetOwningPlayer(casterUnit),2,targetX,targetY,500)call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\UndeadBlood\\UndeadBloodGargoyle.mdl",targetX,targetY))call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\UndeadBlood\\UndeadBloodGargoyle.mdl",targetX,targetY+184))call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\UndeadBlood\\UndeadBloodGargoyle.mdl",targetX,targetY-184))call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\UndeadBlood\\UndeadBloodGargoyle.mdl",targetX+184,targetY))call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\UndeadBlood\\UndeadBloodGargoyle.mdl",targetX+130,targetY+130))call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\UndeadBlood\\UndeadBloodGargoyle.mdl",targetX+130,targetY-130))call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\UndeadBlood\\UndeadBloodGargoyle.mdl",targetX-184,targetY))call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\UndeadBlood\\UndeadBloodGargoyle.mdl",targetX-130,targetY+130))call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\UndeadBlood\\UndeadBloodGargoyle.mdl",targetX-130,targetY-130))call RemoveLocation(targetLoc)call ReleaseGroupToPool(enumGroup)set enumGroup=nullset targetLoc=nullset casterUnit=nullendfunctionfunction OnCastStickyNapalm takes nothing returns booleanif GetSpellAbilityId()=='A1EL' thencall CastStickyNapalm()endifreturn falseendf