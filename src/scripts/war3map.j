(),UNIT_TYPE_HERO)thencall AiHeroFountainShopRoutine(GetTriggerUnit())elseif false and(ElapsedGameSeconds>=PlayerItemStateData[160+playerId])and(ElapsedGameSeconds>PlayerItemStateData[176+playerId])and(IsUnitInSpecialTypeSet(GetTriggerUnit()))thenset heroUnit=GetTriggerUnit()set PlayerItemStateData[160+playerId]=R2I(ElapsedGameSeconds)+AiActionDelaySecondscall InvokeAiReinitItemInventory(playerId,heroUnit)set slotIndex=6set lastIndex=PlayerItemStateData[128+playerId]-1loopexitwhen slotIndex>lastIndexif HeroInventoryItem[playerId*24+slotIndex]!=null and(LoadBoolean(AiAbilityDataHashtable,PlayerItemStateData[256+playerId],GetHandleId(HeroInventoryItem[playerId*24+slotIndex])))thenset insertedSlot=InsertItemEvictingLowestValue(playerId,heroUnit,HeroItemTypeIndex[playerId*24+slotIndex],HeroInventoryItem[playerId*24+slotIndex],false,true,false)if insertedSlot!=-1 and insertedSlot<6 thenset HeroInventoryItem[playerId*24+insertedSlot]=HeroInventoryItem[playerId*24+slotIndex]set HeroItemTypeIndex[playerId*24+insertedSlot]=HeroItemTypeIndex[playerId*24+slotIndex]endifcall SetItemVisible(HeroInventoryItem[playerId*24+slotIndex],ItemHiddenVisibility)set HeroInventoryItem[playerId*24+slotIndex]=nullendifset slotIndex=slotIndex+1endloopset heroUnit=nullset PlayerItemStateData[160+playerId]=0endifendfunctionfunction AiRunShoppingChecksForAllPlayers takes nothing returns nothinglocal integer playerId=1local integer maxPlayerId=11local boolean canBuy=falselocal boolean purchased=truelocal integer actionDeadline=R2I(ElapsedGameSeconds)+AiActionDelaySecondsloopexitwhen playerId>maxPlayerIdif playerId==6 thenset playerId=7endifset canBuy=trueset purchased=falseif IsPlayerPlayingComputer(Player(playerId))and TrackedSideUnit[playerId]!=null and(ElapsedGameSeconds>PlayerItemStateData[160+playerId])and(ElapsedGameSeconds>PlayerItemStateData[176+playerId])and(DistanceBetweenWidgets(TrackedSideUnit[playerId],AiSurroundTargetUnit[16+playerId])>1200)then