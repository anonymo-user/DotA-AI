l UnitRemoveAbility(heroUnit,detectedAbilityId)return grantedAbilityIdendifset detectedAbilityId='B0B7'set grantedAbilityId='A19G'if GetUnitAbilityLevel(heroUnit,detectedAbilityId)>0 thencall UnitRemoveAbility(heroUnit,detectedAbilityId)return grantedAbilityIdendifset detectedAbilityId='B0B2'set grantedAbilityId='A19G'if GetUnitAbilityLevel(heroUnit,detectedAbilityId)>0 thencall UnitRemoveAbility(heroUnit,detectedAbilityId)return grantedAbilityIdendifreturn'A19I'elseif abilityLevel==3 thenset detectedAbilityId='B0B3'set grantedAbilityId='A19E'if GetUnitAbilityLevel(heroUnit,detectedAbilityId)>0 thencall UnitRemoveAbility(heroUnit,detectedAbilityId)return grantedAbilityIdendifset detectedAbilityId='B0B9'set grantedAbilityId='A19D'if GetUnitAbilityLevel(heroUnit,detectedAbilityId)>0 thencall UnitRemoveAbility(heroUnit,detectedAbilityId)return grantedAbilityIdendifset detectedAbilityId='B0B6'set grantedAbilityId='A19D'if GetUnitAbilityLevel(heroUnit,detectedAbilityId)>0 thencall UnitRemoveAbility(heroUnit,detectedAbilityId)return grantedAbilityIdendifreturn'A19K'elseif abilityLevel==4 thenset detectedAbilityId='B0B5'set grantedAbilityId='A196'if GetUnitAbilityLevel(heroUnit,detectedAbilityId)>0 thencall UnitRemoveAbility(heroUnit,detectedAbilityId)return grantedAbilityIdendifset detectedAbilityId='B0B4'set grantedAbilityId='A195'if GetUnitAbilityLevel(heroUnit,detectedAbilityId)>0 thencall UnitRemoveAbility(heroUnit,detectedAbilityId)return grantedAbilityIdendifset detectedAbilityId='B0BA'set grantedAbilityId='A195'if GetUnitAbilityLevel(heroUnit,detectedAbilityId)>0 thencall UnitRemoveAbility(heroUnit,detectedAbilityId)return grantedAbilityIdendifreturn'A19L'endifreturn 0endfunctionfunction CastIllusionMorphDummy takes nothing returns nothinglocal unit heroUnit=GetTriggerUnit()local integer abilityLevel=GetUnitAbilityLevel(heroUnit,'A18X')local integer morphAbilityId=ResolveIllusionAbilityByLevel(heroUnit,a