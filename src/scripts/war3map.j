alse)call SetPlayerAbilityAvailable(tempPlayer,'A1C9',false)call SetPlayerAbilityAvailable(tempPlayer,'A1CB',false)call SetPlayerAbilityAvailable(tempPlayer,'A1CC',false)set playerIndex=playerIndex+1endloopset auraTrigger=nullset caster=nullendfunctionfunction OnLearnAuraA1CD takes nothing returns booleanif GetLearnedSkill()=='A1CD' and GetUnitAbilityLevel(GetTriggerUnit(),'A1CD')==1 and IsUnitIllusion(GetTriggerUnit())==false thencall BeginAuraA1CD(GetTriggerUnit(),false)endifreturn falseendfunctionfunction RegisterAuraA1CDTrigger takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_HERO_SKILL)call TriggerAddCondition(t,Condition(function OnLearnAuraA1CD))set t=nullendfunctionfunction OnReleaseAbunRefExpire takes nothing returns booleanlocal trigger whichTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(whichTrigger)local unit casterUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local unit targetUnit=(LoadUnitHandle(GameHashtable,(triggerId),(17)))call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(whichTrigger)call ReleaseAbunRefCount(targetUnit)set whichTrigger=nullset casterUnit=nullset targetUnit=nullreturn falseendfunctionfunction EnumShoveUnitOntoQuakeLine takes nothing returns nothinglocal real lineStartX=TempSwapX1local real lineStartY=TempSwapY1local real lineEndX=TempSwapX2local real lineEndY=TempSwapY2local real unitX=GetUnitX(GetEnumUnit())local real unitY=GetUnitY(GetEnumUnit())local real projFactor=((unitX-lineStartX)*(lineEndX-lineStartX)+(unitY-lineStartY)*(lineEndY-lineStartY))/((lineStartX-lineEndX)*(lineStartX-lineEndX)+(lineStartY-lineEndY)*(lineStartY-lineEndY))local real projectedX=lineStartX+projFactor*(lineEndX-lineStartX)local real projectedY=lineStartY+projFactor*(lineEndY-lineStartY)local real damageAmount=GetUnitState(GetEnumUnit(),UNIT_STATE_MAX_LIFE)*.35/2local trigger castTriggerlocal integer handleIdlocal integer abilityLevel=GetUnitAbilityLevel(SpellCasterUnit_3,'A2ZH')if IsUnitType(GetEnumUnit(),UNIT_TYPE_HERO) thencall SetUnitPosition(GetEnumUnit(),projectedX,projectedY)elsecall SetUnitX(GetEnumUnit(),projectedX)call SetUnitY(GetEnumUnit(),projectedY)endifif abilityLevel>0 thenset castTrigger=CreateTrigger()set handleId=GetHandleId(castTrigger)call AddAbunRefCount(GetEnumUnit())call TriggerRegisterTimerEvent(castTrigger,abilityLevel+3,false)call TriggerRegisterDeathEvent(castTrigger,GetEnumUnit())call TriggerAddCondition(castTrigger,Condition(function OnReleaseAbunRefExpire))call SaveUnitHandle(GameHashtable,(handleId),(2),(SpellCasterUnit_3))call SaveUnitHandle(GameHashtable,(handleId),(17),(GetEnumUnit()))set castTrigger=nullendifcall IssueTargetOrderById(DummyOrderCaster,852075,GetEnumUnit())call DamageTargetByType(SpellCasterUnit_3,GetEnumUnit(),DamageType1,damageAmount)call DamageTargetByType(SpellCasterUnit_3,GetEnumUnit(),DamageType2,damageAmount)endfunctionfunction OnEarthquakeWaveTick takes nothing returns booleanlocal trigger quakeTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(quakeTrigger)local unit casterUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local real originX=(LoadReal(GameHashtable,(triggerId),(282)))local real originY=(LoadReal(GameHashtable,(triggerId),(283)))local real waveAngle=(LoadReal(GameHashtable,(triggerId),(341)))local integer loopIndex=0local real segmentXlocal real segmentYlocal group enumGroup=AcquireGroupFromPool()local group hitGroup=AcquireGroupFromPool()local integer abilityLevel=GetUnitAbilityLevel(casterUnit,'A1A1')local integer segmentCount=(LoadInteger(GameHashtable,(triggerId),(34)))local integer dummyAbilityId='A1CE'if abilityLevel==0 thenset abilityLevel=GetUnitAbilityLevel(casterUnit,'A2ZH')set dummyAbilityId='A2ZI'endifcall FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(quakeTrigger)set FilterReferenceUnit_2=casterUnitset SpellCasterUnit_3=casterUnitset DummyOrderCaster=CreateUnit(GetOwningPlayer(casterUnit),'e00E',originX,originY,0)call AddPermanentAbility(DummyOrderCaster,dummyAbilityId)call SetUnitAbilityLevel(DummyOrderCaster,dummyAbilityId,abilityLevel)loopexitwhen loopIndex>segmentCountset segmentX=originX+loopIndex*200*Cos(waveAngle)set segmentY=originY+loopIndex*200*Sin(waveAngle)call CreateTimedEffectAtPoint("Abilities\\Spells\\Orc\\EarthQuake\\EarthQuakeTarget.mdl",segmentX,segmentY,1.6)call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",segmentX,segmentY-250))call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",segmentX,segmentY))call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",segmentX+250,segmentY))call KillTreesInArea(segmentX,segmentY,300)call GroupEnumUnitsInRange(enumGroup,segmentX,segmentY,325,Condition(function FilterAttackableEnemy))call GroupAddGroup(enumGroup,hitGroup)call GroupClear(enumGroup)set loopIndex=loopIndex+1endloopset TempSwapX1=originXset TempSwapY1=originYset TempSwapX2=segmentXset TempSwapY2=segmentYcall ForGroup(hitGroup,function EnumShoveUnitOntoQuakeLine)call ReleaseGroupToPool(hitGroup)call ReleaseGroupToPool(enumGroup)set quakeTrigger=nullset casterUnit=nullreturn falseendfunctionfunction OnEarthquakeChargeTick takes nothing returns booleanlocal trigger tickTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(tickTrigger)local unit caster=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local real angleRad=(LoadReal(GameHashtable,(triggerId),(137)))local real originX=(LoadReal(GameHashtable,(triggerId),(282)))local real originY=(LoadReal(GameHashtable,(triggerId),(283)))local real storedAnglelocal real effectX1local real effectY1local real effectX2local real effectY2local real effectX3local real effectY3local real effectX4local real effectY4local real effectX5local real effectY5local real effectX6local real effectY6local real waveXlocal real waveYlocal ubersplat groundSplatlocal integer tickCount=GetTriggerEvalCount(tickTrigger)local integer maxTicks=(LoadInteger(GameHashtable,(triggerId),(34)))set waveX=originX+200*tickCount*Cos(angleRad)set waveY=originY+200*tickCount*Sin(angleRad)set groundSplat=CreateUbersplat(waveX,waveY,"THNE",255,255,255,255,false,false)call SetUbersplatRenderAlways(groundSplat,true)set effectX1=waveX+250*Cos(bj_DEGTORAD*(angleRad*bj_RADTODEG-45))set effectY1=waveY+250*Sin(bj_DEGTORAD*(angleRad*bj_RADTODEG-45))set effectX2=waveX+250*Cos(bj_DEGTORAD*(angleRad*bj_RADTODEG+45))set effectY2=waveY+250*Sin(bj_DEGTORAD*(angleRad*bj_RADTODEG+45))set effectX3=waveX-125*Cos(bj_DEGTORAD*(angleRad*bj_RADTODEG-45))set effectY3=waveY-125*Sin(bj_DEGTORAD*(angleRad*bj_RADTODEG-45))set effectX4=waveX-125*Cos(bj_DEGTORAD*(angleRad*bj_RADTODEG+45))set effectY4=waveY-125*Sin(bj_DEGTORAD*(angleRad*bj_RADTODEG+45))set effectX5=waveXset effectY5=waveYset effectX6=waveXset effectY6=waveYcall GrantTimedVisionAt(GetOwningPlayer(caster),4,waveX,waveY,500)call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",effectX1,effectY1))call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",effectX2,effectY2))call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",effectX3,effectY3))call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",effectX4,effectY4))call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",effectX5,effectY5))call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",effectX6,effectY6))if GetTriggerEvalCount(tickTrigger)>maxTicks thenset originX=(LoadReal(GameHashtable,(triggerId),(282)))set originY=(LoadReal(GameHashtable,(triggerId),(283)))set storedAngle=(LoadReal(GameHashtable,(triggerId),(341)))call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(tickTrigger)set tickTrigger=CreateTrigger()set triggerId=GetHandleId(tickTrigger)call TriggerRegisterTimerEvent(tickTrigger,.5,false)call TriggerAddCondition(tickTrigger,Condition(function OnEarthquakeWaveTick))call SaveUnitHandle(GameHashtable,(triggerId),(2),(caster))call SaveReal(GameHashtable,(triggerId),(282),((originX)*1.))call SaveReal(GameHashtable,(triggerId),(283),((originY)*1.))call SaveReal(GameHashtable,(triggerId),(341),((storedAngle)*1.))call SaveInteger(GameHashtable,(triggerId),(34),(maxTicks))endifset tickTrigger=nullset caster=nullreturn falseendfunctionfunction BeginEarthquakeWave takes nothing returns nothinglocal trigger newTrigger=CreateTrigger()local integer triggerId=GetHandleId(newTrigger)local unit caster=GetTriggerUnit()local location targetLoc=GetSpellTargetLoc()local real targetX=GetLocationX(targetLoc)local real targetY=GetLocationY(targetLoc)local real angle=Atan2(targetY-GetUnitY(caster),targetX-GetUnitX(caster))local integer waveCount=11call TriggerRegisterTimerEvent(newTrigger,.22,true)call TriggerAddCondition(newTrigger,Condition(function OnEarthquakeChargeTick))call SaveUnitHandle(GameHashtable,(triggerId),(2),(caster))call SaveReal(GameHashtable,(triggerId),(6),((GetUnitX(caster))*1.))call SaveReal(GameHashtable,(triggerId),(7),((GetUnitY(caster))*1.))call SaveReal(GameHashtable,(triggerId),(137),((angle)*1.))call SaveReal(GameHashtable,(triggerId),(282),((GetUnitX(caster))*1.))call SaveReal(GameHashtable,(triggerId),(283),((GetUnitY(caster))*1.))call SaveReal(GameHashtable,(triggerId),(341),((angle)*1.))call SaveInteger(GameHashtable,(triggerId),(34),(waveCount))call RemoveLocation(targetLoc)set targetLoc=nullset newTrigger=nullset caster=nullendfunctionfunction OnCastEarthquakeWave takes nothing returns booleanif GetSpellAbilityId()=='A1A1' or GetSpellAbilityId()=='A2ZH' thencall BeginEarthquakeWave()endifreturn falseendfunctionfunction RegisterEarthquakeWaveSpell takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(t,Condition(function OnCastEarthquakeWave))set t=nullendfunctionfunction OnReaddAbilityA2NITimer takes nothing returns booleanlocal trigger readdTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(readdTrigger)local unit storedUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))call UnitRemoveAbility(storedUnit,'A2NI')call UnitAddAbility(storedUnit,'A2NI')call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(readdTrigger)set readdTrigger=nullset storedUnit=nullreturn falseendfunctionfunction ScheduleReaddAbilityA2NI takes unit whichUnit returns nothinglocal trigger readdTrigger=CreateTrigger()local integer triggerId=GetHandleId(readdTrigger)call TriggerRegisterTimerEvent(readdTrigger,0,false)call TriggerAddCondition(readdTrigger,Condition(function OnReaddAbilityA2NITimer))call SaveUnitHandle(GameHashtable,(triggerId),(2),(whichUnit))set readdTrigger=nullendfunctionfunction OnAncestralChargeStunExpire takes nothing returns booleanlocal trigger expireTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(expireTrigger)local unit stunnedUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))call DestroyEffect((LoadEffectHandle(GameHashtable,(triggerId),(32))))call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(expireTrigger)call SetUnitAbilityBitflags(stunnedUnit,0)set expireTrigger=nullset stunnedUnit=nullreturn falseendfunctionfunction ApplyAncestralChargeImpact takes unit caster,unit spiritUnit,unit secondUnit,integer abil