onusGoldKill takes nothing returns nothinglocal trigger firedTrigger=GetTriggeringTrigger()local player killerOwner=GetOwningPlayer(GetKillingUnit())local player victimOwner=GetOwningPlayer(GetTriggerUnit())local string announceTextlocal integer assisterCount=CountAssistingPlayers(GetTriggerUnit(),GetKillingUnit())if killerOwner==SentinelPlayer[0]or killerOwner==ScourgePlayer[0]thencall DistributeGoldAmongAssisters(GetTriggerUnit(),GetKillingUnit(),150)set announceText=BuildAssisterNamesString(GetTriggerUnit(),GetKillingUnit())+" "+(GetObjectName(('n04W')))+" |c00ff0303"+(GetObjectName(('n04Y')))+(GetObjectName(('n049')))+"|r "if assisterCount>1 thenset announceText=announceText+"(+150 "+(GetObjectName(('n044')))+")"elseset announceText=announceText+"(+150 "+(GetObjectName(('n045')))+")"endifelseset announceText=PlayerColorCode[GetPlayerId(killerOwner)]+(PlayerName[GetPlayerId((killerOwner))])+"|r "+(GetObjectName(('n04W')))+" |c00ff0303"+(GetObjectName(('n04Y')))+(GetObjectName(('n049')))+"|r "set announceText=announceText+"(+150 "+(GetObjectName(('n045')))+")"call AwardGoldWithFloatingText_3(killerOwner,150,TrackedSideUnit[GetPlayerId(killerOwner)])set PlayerMinGold[GetPlayerId(killerOwner)]=PlayerMinGold[GetPlayerId(killerOwner)]+150set PlayerSavedGold[GetPlayerId(killerOwner)]=PlayerSavedGold[GetPlayerId(killerOwner)]+150endifcall DisplayTimedTextToForceMembers(ReplayRequestForce,10,announceText)call PlaySoundIfUnmuted(FirstBloodSound)call RecycleExpiringTrigger(firedTrigger)set killerOwner=nullset victimOwner=nullset firedTrigger=nullendfunctionfunction FilterHeroKillForBounty takes nothing returns booleanif GetOwningPlayer(GetKillingUnit())!=CreepControlPlayer and GetKillingUnit()!=null and IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO) and IsPlayerEnemy(GetOwningPlayer(GetTriggerUnit()),GetOwningPlayer(GetKillingUnit())) thenif GetOwningPlayer(GetKillingUnit())==SentinelPlayer[0]or GetOwningPlayer(GetKillingUnit())==ScourgePlayer[0]thenif CountAssistingPlayers(GetTriggerUnit(),GetKillingUnit())>0 thencall AnnounceBonusGoldKill()endifelsecall AnnounceBonusGoldKill()endifendifreturn falseendfunctionfunction RoshanGrowAndLeashTick takes nothing returns booleanlocal trigger firedTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(firedTrigger)local unit roshanlocal region boundsRegionlocal integer growthLevel=1+R2I((TimerGetElapsed(GameClockTimer))/240)if GetTriggerEventId()==EVENT_UNIT_DEATH thencall FlushChildHashtable(GameHashtable,handleId)call RecycleExpiringTrigger(firedTrigger)elseset roshan=(LoadUnitHandle(GameHashtable,(handleId),(53)))if roshan==null thencall FlushChildHashtable(GameHashtable,handleId)call RecycleExpiringTrigger(firedTrigger)set firedTrigger=nullreturn falseendifcall SetUnitAbilityLevel(roshan,'ACtc',growthLevel)set boundsRegion=CreateRegion()call RegionAddRect(boundsRegion,RegionRRect2)call RegionAddRect(boundsRegion,RegionRRect3)call RegionAddRect(boundsRegion,RegionRRect4)if IsUnitInRegion(boundsRegion,roshan)==false thenif(LoadBoolean(GameHashtable,(handleId),(91)))==true thencall SaveBoolean(GameHashtable,(handleId),(91),(false))elsecall SetUnitX(roshan,GetRectCenterX(BaseFountainRect))call SetUnitY(roshan,GetRectCenterY(BaseFountainRect))call SaveBoolean(GameHashtable,(handleId),(91),(true))endifendifcall RemoveRegion(boundsRegion)set roshan=nullset boundsRegion=nullendifset firedTrigger=nullreturn falseendfunctionfunction StartRoshanLeashTick takes unit roshan returns nothinglocal trigger leashTrigger=CreateTrigger()local integer handleId=GetHandleId(leashTrigger)call TriggerRegisterUnitEvent(leashTrigger,roshan,EVENT_UNIT_DEATH)call TriggerRegisterTimerEvent(leashTrigger,10.,true)call TriggerAddCondition(leashTrigger,Condition(function RoshanGrowAndLeashTick))call SaveUnitHandle(GameHashtable,(handleId),(53),(roshan))call SaveBoolean(GameHashtable,(handleId),(91),(true))set leashTrigger=nullendfunctionfunction RoshanRespawnWarningTick takes nothing returns booleanlocal item aegisItemlocal integer evalCount=GetTriggerEvalCount(GetTriggeringTrigger())if evalCount==NextTimedEventTick thencall RecycleExpiringTrigger(GetTriggeringTrigger())endifif evalCount==NextTimedEventTick-180 or evalCount==NextTimedEventTick-60 thenif PendingRecipeUnit!=null thenset aegisItem=UnitItemOfType(PendingRecipeUnit,ItemTypeId[ItemIndexCost0Charged])if aegisItem!=null thenif evalCount==NextTimedEventTick-180 thenif IsPlayerOnTeamZero(GetOwningPlayer(PendingRecipeUnit))thencall DisplayTimedTextToForceMembers(TeamOneForce,15,GetObjectName('n0E9')+" |c00ff0303"+(GetObjectName(('n0E7')))+"|r")elsecall DisplayTimedTextToForceMembers(TeamTwoForce,15,GetObjectName('n0E9')+" |c00ff0303"+(GetObjectName(('n0E7')))+"|r")endifelseif IsPlayerOnTeamZero(GetOwningPlayer(PendingRecipeUnit))thencall DisplayTimedTextToForceMembers(TeamOneForce,15,GetObjectName('n0E9')+" |c00ff0303"+(GetObjectName(('n0DX')))+"|r")elsecall DisplayTimedTextToForceMembers(TeamTwoForce,15,GetObjectName('n0E9')+" |c00ff0303"+(GetObjectName(('n0DX')))+"|r")endifendifendifendifendifset aegisItem=nullreturn falseendfunctionfunction StartRoshanRespawnWarningTimer takes nothing returns nothinglocal trigger warningTrigger=CreateTrigger()call TriggerRegisterTimerEvent(warningTrigger,1.,true)call TriggerAddCondition(warningTrigger,Condition(function RoshanRespawnWarningTick))call TriggerEvaluate(warningTrigger)set warningTrigger=nullendfunctionfunction RoshanScaleUpTick takes nothing returns booleanset LifeUpgradeLevel=GetTriggerEvalCount(GetTriggeringTrigger())if UpgradeRecipientUnit!=null and GetUnitState(UpgradeRecipientUnit,UNIT_STATE_LIFE)>1 thencall SetPlayerTechResearched(GetOwningPlayer(UpgradeRecipientUnit),'R00F',LifeUpgradeLevel)call MUAddMaxLife(UpgradeRecipientUnit, 600)if GetUnitAbilityLevel(UpgradeRecipientUnit,'A142')==0 thencall UnitAddAbility(UpgradeRecipientUnit,'A142')endifcall SetUnitAbilityLevel(UpgradeRecipientUnit,'A142',LifeUpgradeLevel+1)endifreturn falseendfunctionfunction PercentRegenUntilDamagedTick takes nothing returns booleanlocal trigger triggeringTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(triggeringTrigger)local unit regenUnit=(LoadUnitHandle(GameHashtable,(handleId),(2)))local integer tickCount=(LoadInteger(GameHashtable,(handleId),(34)))if GetTriggerEventId()!=EVENT_UNIT_DAMAGED thenset tickCount=tickCount+1call SaveInteger(GameHashtable,(handleId),(34),(tickCount))endifif tickCount>4 or(GetTriggerEventId()==EVENT_UNIT_DAMAGED and GetEventDamage()>0)thencall FlushChildHashtable(GameHashtable,(handleId))call RecycleExpiringTrigger(triggeringTrigger)endifcall SetUnitState(regenUnit,UNIT_STATE_LIFE,GetUnitState(regenUnit,UNIT_STATE_LIFE)+0.2*GetUnitState(regenUnit,UNIT_STATE_MAX_LIFE))call SetUnitState(regenUnit,UNIT_STATE_MANA,GetUnitState(regenUnit,UNIT_STATE_MANA)+0.2*GetUnitState(regenUnit,UNIT_STATE_MAX_MANA))set triggeringTrigger=nullset regenUnit=nullreturn falseendfunctionfunction StartRegenUntilDamaged takes unit regenUnit returns nothinglocal trigger regenTrigger=CreateTrigger()local integer handleId=GetHandleId(regenTrigger)call TriggerRegisterTimerEvent(regenTrigger,1.0,true)call TriggerAddCondition(regenTrigger,Condition(function PercentRegenUntilDamagedTick))call TriggerRegisterUnitEvent(regenTrigger,regenUnit,EVENT_UNIT_DAMAGED)call SaveUnitHandle(GameHashtable,(handleId),(2),(regenUnit))set regenTrigger=nullendfunctionfunction RevokeAllAegisCharges takes nothing returns nothinglocal integer slotIndex=1local unit heroUnitset PendingRecipeUnit=nullloopexitwhen slotIndex>5set heroUnit=TrackedSideUnit[GetPlayerId(SentinelPlayer[slotIndex])]if heroUnit!=null and UnitItemOfType(heroUnit,ItemTypeId[ItemIndexCost0Charged])!=null thencall DisableTrigger(ToggleableTrigger)call StoreAndSyncDataInteger("AegisOff",GetPlayerId(GetOwningPlayer(heroUnit)))call RemoveItem(UnitItemOfType(heroUnit,ItemTypeId[ItemIndexCost0Charged]))call StartRegenUntilDamaged(heroUnit)call EnableTrigger(ToggleableTrigger)endifset heroUnit=TrackedSideUnit[GetPlayerId(ScourgePlayer[slotIndex])]if heroUnit!=null and UnitItemOfType(heroUnit,ItemTypeId[ItemIndexCost0Charged])!=null thencall DisableTrigger(ToggleableTrigger)call StoreAndSyncDataInteger("AegisOff",GetPlayerId(GetOwningPlayer(heroUnit)))call RemoveItem(UnitItemOfType(heroUnit,ItemTypeId[ItemIndexCost0Charged]))call StartRegenUntilDamaged(heroUnit)call EnableTrigger(ToggleableTrigger)endifset slotIndex=slotIndex+1endloopset heroUnit=nullendfunctionfunction FormatDualTeamMessage takes string firstTeam,string secondTeam returns stringlocal string message=(GetObjectName(('n0CA')))set message=ReplaceFirstOccurrence(message,"$team",firstTeam)set message=ReplaceFirstOccurrence(message,"$team",secondTeam)return messageendfunctionfunction IsDyingUnitRoshan takes nothing returns booleanreturn GetUnitTypeId(GetDyingUnit())=='n00L'endfunctionfunction SpawnRoshanOnTimer takes nothing returns booleanlocal trigger triggeringTrigger=GetTriggeringTrigger()local location spawnPointlocal real unusedRealif GetTriggerEvalCount(triggeringTrigger)==NextSpawnEvalCount or TriggerEvalOverrideFlag thenset TriggerEvalOverrideFlag=falseset spawnPoint=GetRectCenter(BaseFountainRect)call RevokeAllAegisCharges()set RoshanScaleTickCount=RoshanScaleTickCount+1set UpgradeRecipientUnit=CreateUnitAtLoc(Player(12),'n00L',spawnPoint,bj_UNIT_FACING)call SetUnitAcquireRange(UpgradeRecipientUnit,150)call StartRoshanLeashTick(UpgradeRecipientUnit)call UnitAddAbility(UpgradeRecipientUnit,'A142')call SetPlayerTechResearched(GetOwningPlayer(UpgradeRecipientUnit),'R00F',LifeUpgradeLevel)call MUAddMaxLife(UpgradeRecipientUnit, LifeUpgradeLevel * 600)call SetUnitAbilityLevel(UpgradeRecipientUnit,'A142',LifeUpgradeLevel+1)call RemoveLocation(spawnPoint)if RoshanScaleTickCount>1 thencall UnitRemoveAbility(UpgradeRecipientUnit,'A0K2')call UnitAddAbility(UpgradeRecipientUnit,'A0Q6')call UnitAddItem(UpgradeRecipientUnit,CreateItem(ItemTypeId[ItemIndexGold1000Recipe],0,0))endifcall UnitAddItem(UpgradeRecipientUnit,CreateItem(ItemTypeId[ItemIndexCost0Charged],0,0))call RecycleExpiringTrigger(triggeringTrigger)set UpgradeCheckExpireTime=99999999.elseif GetTriggerEvalCount(triggeringTrigger)==NextTimedEventTick thencall RevokeAllAegisCharges()set UpgradeCheckExpireTime=99999999.endifset triggeringTrigger=nullset spawnPoint=nullreturn falseendfunctionfunction OnRoshanKilled takes nothing returns nothinglocal trigger timerTrigger=CreateTrigger()call TriggerRegisterTimerEvent(timerTrigger,1,true)call TriggerAddCondition(timerTrigger,Condition(function SpawnRoshanOnTimer))set TriggerEvalOverrideFlag=falseset NextSpawnEvalCount=GetRandomInt(480,660)call StartRoshanRespawnWarningTimer()set AllowRecipeAssembly=falseif(IsPlayerOnTeamZero(GetOwningPlayer(GetKillingUnit())))thencall StoreAndSyncDataInteger("Roshan",0)call DisplayTimedTextToForceMembers(bj_FORCE_ALL_PLAYERS,10.,FormatDualTeamMessage("|c00ff0000"+(GetObjectName(('n065')))+"|r",(GetObjectName(('n065')))))call AdjustPlayerStateBJ(200,SentinelPlayer[1],PLAYER_STATE_RESOURCE_GOLD)call AdjustPlayerStateBJ(200,SentinelPlayer[2],PLAYER_STATE_RESOURCE_GOLD)call AdjustPlayerStateBJ(200,SentinelPlayer[3],PLAYER_STATE_RESOURCE_GOLD)call AdjustPlayerStateBJ(200,SentinelPlayer[4],PLAYER_STATE_RESOURCE_GOLD)call AdjustPlayerStateBJ(200,SentinelPlayer[5],PLAYER_STATE_RESOURCE_GOLD)endifif(IsPlayerOnTeamOne(GetOwningPlayer(GetKillingUnit())))thencall StoreAndSyncDataInteger("Roshan",1)call DisplayTimedTextToForceMembers(bj_FORCE_ALL_PLAYERS,10.,FormatDualTeamMessage("|c00004000"+(GetObjectName(('n06C')))+"|r",(GetObjectName(('n06C')))))call AdjustPlayerStateBJ(200,ScourgePlayer[1],PLAYER_STATE_RESOURCE_GOLD)call AdjustPlayerStateBJ(200,ScourgePlayer[2],PLAYER_STATE_RESOURCE_GOLD)call AdjustPlayerStateBJ(200,ScourgePlayer[3],PLAYER_STATE_RESOURCE_GOLD)call AdjustPlayerStateBJ(200,ScourgePlayer[4],PLAYER_STATE_RESOURCE_GOLD)call AdjustPlayerStateBJ(200,ScourgePlayer[5],PLAYER_STATE_RESOURCE_GOLD)endifset timerTrigger=nullendfunctionfunction ShowKillGoldTextTag takes nothing returns nothinglocal texttag goldTag=CreateTextTag()local unit killedUnit=GetTriggerUnit()local player killerOwner=GetOwningPlayer(GetKillingUnit())call SetTextTagText(goldTag,"$",.027)call SetTextTagPosUnit(goldTag,killedUnit,0)call SetTextTagColorBJ(goldTag,PlayerColorRed[GetPlayerId(killerOwner)],PlayerColorGreen[GetPlayerId(killerOwner)],PlayerColorBlue[GetPlayerId(killerOwner)],15)call SetTextTagVelocity(goldTag,0,.035)call SetTextTagFadepoint(goldTag,3)call SetTextTagLifespan(goldTag,1.5)call SetTextTagPermanent(goldTag,false)call SetTextTagVisibility(goldTag,false)if GetLocalPlayer()==ViewModePlayerLeft or GetLocalPlayer()==ViewModePlayerRight thencall SetTextTagVisibility(goldTag,true)endifset goldTag=nullset killedUnit=nullset killerOwner=nullendfunctionfunction ShowDenyTextTag takes unit whichUnit,player whichPlayer returns nothinglocal texttag textTag=CreateTextTag()call SetTextTagText(textTag,"!",.03)call SetTextTagPosUnit(textTag,whichUnit,0)call SetTextTagColorBJ(textTag,PlayerColorRed[GetPlayerId(whichPlayer)],PlayerColorGreen[GetPlayerId(whichPlayer)],PlayerColorBlue[GetPlayerId(whichPlayer)],15)call SetTextTagVelocity(textTag,0,.035)call SetTextTagFadepoint(textTag,3)call SetTextTagLifespan(textTag,1.5)call SetTextTagPermanent(textTag,false)call SetTextTagVisibility(textTag,false)if PlayerViewFlag[GetPlayerId(GetLocalPlayer())] or(TwoPlayerViewModeActive and(GetLocalPlayer()==ViewModePlayerLeft or GetLocalPlayer()==ViewModePlayerRight))thencall SetTextTagVisibility(textTag,true)endifset textTag=nullendfunctionfunction AwardSharedXpByAttackType takes nothing returns nothingif IsUnitType(GetEnumUnit(),UNIT_TYPE_MELEE_ATTACKER) thencall AddHeroXP(GetEnumUnit(),EnumParamIntC/ EnumParamIntA,true)elsecall AddHeroXP(GetEnumUnit(),EnumParamIntB/ EnumParamIntA,true)endifendfunctionfunction DistributeDenyXp takes nothing returns nothinglocal group tempGroup=AcquireGroupFromPool()local integer enemyHeroCountlocal integer baseXp=20local integer xpBonus=31call GroupEnumUnitsInRange(tempGroup,GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit()),1300+25,Condition(function FilterTriggerEnemyHero))set enemyHeroCount=CountGroupUnits(tempGroup)set EnumParamIntA=enemyHeroCountset EnumParamIntB=baseXpset EnumParamIntC=xpBonuscall ForGroup(tempGroup,function AwardSharedXpByAttackType)call ReleaseGroupToPool(tempGroup)call ShowDenyTextTag(GetDyingUnit(),GetOwningPlayer(GetKillingUnit()))set tempGroup=nullendfunctionfunction HandleUnitDeathDenyOrKill takes nothing returns booleanif IsUnitAlly(GetKillingUnit(),GetOwningPlayer(GetTriggerUnit())) thencall DistributeDenyXp()elseif TwoPlayerViewModeActive and IsPlayerInHeroSlot(GetOwningPlayer(GetKillingUnit()))thencall ShowKillGoldTextTag()endifendifreturn falseendfunctionfunction FormatDeathGoldMessage takes player deadPlayer,player killerPlayer returns stringlocal string message=(GetObjectName(('n0AP')))set message=ReplaceFirstOccurrence(message,"$dead",(PlayerName[GetPlayerId((deadPlayer))]))return messageendfunctionfunction RestoreTerrainWalkabilityTick takes nothing returns booleanlocal trigger expiredTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(expiredTrigger)local real restoreX=(LoadReal(GameHashtable,(handleId),(6)))local real restoreY=(LoadReal(GameHashtable,(handleId),(7)))call SetTerrainPathable(restoreX,restoreY,PATHING_TYPE_WALKABILITY,false)call FlushChildHashtable(GameHashtable,(handleId))call RecycleExpiringTrigger(expiredTrigger)set expiredTrigger=nullreturn falseendfunctionfunction MakeUnitSpotWalkable takes unit whichUnit returns nothinglocal trigger timerTrigger=CreateTrigger()local integer handleId=GetHandleId(timerTrigger)local real spotX=GetUnitX(whichUnit)local real spotY=GetUnitY(whichUnit)call SetTerrainPathable(spotX,spotY,PATHING_TYPE_WALKABILITY,true)call TriggerRegisterTimerEvent(timerTrigger,0,false)call TriggerAddCondition(timerTrigger,Condition(function RestoreTerrainWalkabilityTick))call SaveReal(GameHashtable,(handleId),(6),((spotX)*1.))call SaveReal(GameHashtable,(handleId),(7),((spotY)*1.))set whichUnit=nullset timerTrigger=nullendfunctionfunction OnCourierRespawnCountdownTick takes nothing returns booleanlocal trigger timerTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(timerTrigger)local unit courier=(LoadUnitHandle(GameHashtable,(handleId),(2)))local integer elapsedTicks=GetTriggerEvalCount(timerTrigger)local integer secondsRemaininglocal integer slotIndex=1local integer playerIdlocal real respawnX=(LoadReal(GameHashtable,(handleId),(6)))local real respawnY=(LoadReal(GameHashtable,(handleId),(7)))local integer respawnTime=140if IsUnitTypeInSetB(courier)thenset respawnTime=180endifset secondsRemaining=respawnTime-elapsedTicksloopexitwhen slotIndex>5if IsPlayerAlly(GetOwningPlayer(courier),SentinelPlayer[0])thenset playerId=GetPlayerId(SentinelPlayer[slotIndex])elseset playerId=GetPlayerId(ScourgePlayer[slotIndex])endifset slotIndex=slotIndex+1if secondsRemaining==0 thencall LeaderboardDisplay(PlayerLeaderboard[playerId],false)if IsPlayerAlly(SentinelPlayer[0],Player(playerId))thenset TeamProcessedFlag[GetPlayerId(SentinelPlayer[0])]=falseendifif IsPlayerAlly(ScourgePlayer[0],Player(playerId))thenset TeamProcessedFlag[GetPlayerId(ScourgePlayer[0])]=falseendifelseif IsUnitDeadOrInvalid(TrackedSideUnit[playerId])==false thencall PlayerSetLeaderboard(Player(playerId),PlayerLeaderboard[playerId])call LeaderboardDisplay(PlayerLeaderboard[playerId],true)call LeaderboardSetLabel(PlayerLeaderboard[playerId],"    "+GetObjectName('n0LZ')+" "+I2S(secondsRemaining))endifendifendloopif secondsRemaining==2 thencall SetUnitPosition(courier,respawnX,respawnY)endifif secondsRemaining==0 thencall StoreBooleanByName(GetHandleId(courier),"aiCrow|Alive",true)call FlushChildHashtable(GameHashtable,(handleId))call RecycleExpiringTrigger(timerTrigger)endifset timerTrigger=nullset courier=nullreturn falseendfunctionfunction AwardGoldWithFloatingText_2 takes player whichPlayer,integer goldAmount returns nothinglocal texttag textTagif goldAmount>0 thenset textTag=CreateTextTag()call SetPlayerState(whichPlayer,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(whichPlayer,PLAYER_STATE_RESOURCE_GOLD)+goldAmount)call SetTextTagText(textTag,"+"+I2S(goldAmount),.025)call SetTextTagPosUnit(textTag,TrackedSideUnit[GetPlayerId(whichPlayer)],0)call SetTextTagColor(textTag,255,220,0,255)call SetTextTagVelocity(textTag,0,.03)if GetLocalPlayer()==whichPlayer thencall SetTextTagVisibility(textTag,true)elsecall SetTextTagVisibility(textTag,false)endifcall SetTextTagFadepoint(textTag,2)call SetTextTagLifespan(textTag,3)call SetTextTagPermanent(textTag,false)endifendfunctionfunction OnCourierDeath takes nothing returns booleanlocal real baseXlocal real baseYlocal unit courier=GetTriggerUnit()local integer slotIndex=1local integer goldReward=175local trigger respawnTrigger=CreateTrigger()local integer handleId=GetHandleId(respawnTrigger)call StoreBooleanByName(GetHandleId(courier),"aiCrow|Alive",false)if IsUnitTypeInSetB(courier)==false thenset goldReward=150endifcall StoreAndSyncDataInteger("Courier"+I2S(GetPlayerId(GetOwningPlayer(GetTriggerUnit()))),GetPlayerId(GetOwningPlayer(GetKillingUnit())))call DisplayTimedTextToForceMembers(ReplayRequestForce,10.,FormatDeathGoldMessage(GetOwningPlayer(GetTriggerUnit()),GetOwningPlayer(GetKillingUnit())))call PingMinimapEx(GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit()),6,255,0,0,false)call TriggerRegisterTimerEvent(respawnTrigger,1,true)call TriggerAddCondition(respawnTrigger,Condition(function OnCourierRespawnCountdownTick))call SaveUnitHandle(GameHashtable,(handleId),(2),(courier))if IsPlayerAlly(GetOwningPlayer(courier),SentinelPlayer[0])and TeamProcessedFlag[GetPlayerId(SentinelPlayer[0])]==false thenset TeamProcessedFlag[GetPlayerId(SentinelPlayer[0])]=trueloopexitwhen slotIndex>5call AwardGoldWithFloatingText_2(ScourgePlayer[slotIndex],goldReward)set slotIndex=slotIndex+1endloopendifset slotIndex=1if IsPlayerAlly(GetOwningPlayer(courier),ScourgePlayer[0])and TeamProcessedFlag[GetPlayerId(ScourgePlayer[0])]==false thenset TeamProcessedFlag[GetPlayerId(ScourgePlayer[0])]=trueloopexitwhen slotIndex>5call AwardGoldWithFloatingText_2(SentinelPlayer[slotIndex],goldReward)set slotIndex=slotIndex+1endloopendifif GetPlayerTeam(GetOwningPlayer(courier))==0 thenset baseX=GetRectCenterX(BaseCenterRectB)set baseY=GetRectCenterY(BaseCenterRectB)elseset baseX=GetRectCenterX(BaseCenterRectA)set baseY=GetRectCenterY(BaseCenterRectA)endifcall SaveReal(GameHashtable,(handleId),(6),((baseX)*1.))call SaveReal(GameHashtable,(handleId),(7),((baseY)*1.))if IsTerrainPathable(GetUnitX(courier),GetUnitY(courier),PATHING_TYPE_WALKABILITY)thencall MakeUnitSpotWalkable(courier)endifset respawnTrigger=nullreturn falseendfunctionfunction UpdateCourierFountainInvulnerability takes nothing returns booleanlocal trigger timerTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(timerTrigger)local unit courier=(LoadUnitHandle(GameHashtable,(handleId),(2)))local real fountainX=RegenShopTeam0Xlocal real fountainY=RegenShopTeam0Yif IsPlayerOnTeamOne(GetOwningPlayer(courier))thenset fountainX=NdflSpawnXset fountainY=NdflSpawnYendifif IsUnitDeadOrInvalid(courier)==false thenif DistanceBetweenCoords(GetUnitX(courier),GetUnitY(courier),fountainX,fountainY)<800 thencall AddPermanentAbility(courier,'Avul')elsecall UnitRemoveAbility(courier,'Avul')endifendifset timerTrigger=nullset courier=nullreturn falseendfunctionfunction InitCourier takes unit courier returns nothinglocal trigger deathTrigger=CreateTrigger()local integer handleId=GetHandleId(deathTrigger)call MUInitMessenger(courier)call SetPlayerAbilityAvailable(GetOwningPlayer(courier),'A29N',false)call SetPlayerAbilityAvailable(GetOwningPlayer(courier),'A2XM',false)call UnitMakeAbilityPermanent(courier,true,'A29M')call TriggerRegisterDeathEvent(deathTrigger,courier)call TriggerAddCondition(deathTrigger,Condition(function OnCourierDeath))set deathTrigger=CreateTrigger()set handleId=GetHandleId(deathTrigger)call TriggerRegisterTimerEvent(deathTrigger,.5,true)call TriggerAddCondition(deathTrigger,Condition(function UpdateCourierFountainInvulnerability))call SaveUnitHandle(GameHashtable,(handleId),(2),(courier))set deathTrigger=nullendfunctionfunction AnnounceCourierKill takes nothing returns nothingif IsUnitTypeInEitherSet(GetTriggerUnit())and IsUnitIllusion(GetTriggerUnit())==false thencall StoreAndSyncDataInteger("Courier"+I2S(GetPlayerId(GetOwningPlayer(GetTriggerUnit()))),GetPlayerId(GetOwningPlayer(GetKillingUnit())))call DisplayTimedTextToForceMembers(ReplayRequestForce,10.,FormatDeathGoldMessage(GetOwningPlayer(GetTriggerUnit()),GetOwningPlayer(GetKillingUnit())))call PingMinimapEx(GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit()),6,255,0,0,false)endifendfunctionfunction InitCourierRespawnLeaderboards takes nothing returns booleancall RecycleExpiringTrigger(GetTriggeringTrigger())set TeamProcessedFlag[GetPlayerId(SentinelPlayer[0])]=falseset TeamProcessedFlag[GetPlayerId(ScourgePlayer[0])]=falseset PlayerLeaderboard[GetPlayerId(SentinelPlayer[1])]=CreateLeaderboard()set PlayerLeaderboard[GetPlayerId(SentinelPlayer[2])]=CreateLeaderboard()set PlayerLeaderboard[GetPlayerId(SentinelPlayer[3])]=CreateLeaderboard()set PlayerLeaderboard[GetPlayerId(SentinelPlayer[4])]=CreateLeaderboard()set PlayerLeaderboard[GetPlayerId(SentinelPlayer[5])]=CreateLeaderboard()