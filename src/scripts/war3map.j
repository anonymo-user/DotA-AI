return trueendifreturn falseendfunctionfunction CorpseExplosionMoveTimerCallback takes nothing returns booleanlocal trigger tickTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(tickTrigger)local unit casterUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local integer corpseCount=(LoadInteger(GameHashtable,(triggerId),(34)))local integer abilityLevel=GetUnitAbilityLevel(casterUnit,'A261')local integer loopIndex=1local unit corpseUnitlocal real targetX=(LoadReal(GameHashtable,(triggerId),(47)))local real targetY=(LoadReal(GameHashtable,(triggerId),(48)))local real posXlocal real posYlocal real angle=(LoadReal(GameHashtable,(triggerId),(137)))local boolean reachedDetonate=(LoadBoolean(GameHashtable,(triggerId),(688)))local boolean effectsSpawned=(LoadBoolean(GameHashtable,(triggerId),(689)))local real leadX=(LoadReal(GameHashtable,(triggerId),(549)))local real leadY=(LoadReal(GameHashtable,(triggerId),(567)))set leadX=ClampXToPlayableArea(leadX+10*Cos(angle))set leadY=ClampYToPlayableArea(leadY+10*Sin(angle))call SaveReal(GameHashtable,(triggerId),(549),((leadX)*1.))call SaveReal(GameHashtable,(triggerId),(567),((leadY)*1.))if reachedDetonate==false thenset reachedDetonate=IsNearCorpseDetonatePoint(casterUnit,leadX,leadY)if reachedDetonate thencall SaveBoolean(GameHashtable,(triggerId),(688),(reachedDetonate))endifendifif reachedDetonate and effectsSpawned==false thenset effectsSpawned=truecall SaveBoolean(GameHashtable,(triggerId),(689),(effectsSpawned))loopexitwhen loopIndex>corpseCountset corpseUnit=(LoadUnitHandle(GameHashtable,(triggerId),(393+loopIndex)))call SaveEffectHandle(GameHashtable,(triggerId),(609+loopIndex),(AddSpecialEffectTarget("war3mapImported\\CorpseFire.mdx",corpseUnit,"origin")))set loopIndex=loopIndex+1endloopendifset loopIndex=1if DistanceBetweenCoords(leadX,leadY,targetX,targetY)<15 thenloopexitwhen loopIndex>corpseCountif reachedDetonate thencall DestroyEffect((LoadEffectHandle(GameHashtable,(triggerId),(609+loopIndex))))endifcall KillUnit((LoadUnitHandle(GameHashtable,(triggerId),(393+loopIndex))))set loopIndex=loopIndex+1endloopcall FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(tickTrigger)call CorpseExplosionDamageArea(casterUnit,abilityLevel,targetX,targetY,corpseCount,reachedDetonate)elseloopexitwhen loopIndex>corpseCountset corpseUnit=(LoadUnitHandle(GameHashtable,(triggerId),(393+loopIndex)))set posX=(LoadReal(GameHashtable,(triggerId),(549+loopIndex)))set posY=(LoadReal(GameHashtable,(triggerId),(567+loopIndex)))set posX=ClampXToPlayableArea(posX+10*Cos(angle))set posY=ClampYToPlayableArea(posY+10*Sin(angle))call SaveReal(GameHashtable,(triggerId),(549+loopIndex),((posX)*1.))call SaveReal(GameHashtable,(triggerId),(567+loopIndex),((posY)*1.))call SetUnitX(corpseUnit,posX)call SetUnitY(corpseUnit,posY)set loopIndex=loopIndex+1endloopendifset tickTrigger=nullset corpseUnit=nullset casterUnit=nullreturn falseendfunctionfunction CastCorpseExplosion takes nothing returns nothinglocal unit casterUnit=GetTriggerUnit()local real targetX=GetSpellTargetX()local real targetY=GetSpellTargetY()local integer abilityLevel=GetUnitAbilityLevel(casterUnit,'A261')local integer corpseCount=(LoadInteger(GameHashtable,(GetHandleId(casterUnit)),(687)))local integer loopIndex=1local unit corpseUnitlocal trigger castTrigger=CreateTrigger()local integer handleId=GetHandleId(castTrigger)local real casterX=GetUnitX(casterUnit)local real casterY=GetUnitY(casterUnit)local real angle=AngleBetweenCoords(GetUnitX(casterUnit),GetUnitY(casterUnit),targetX,targetY)*bj_DEGTORADcall SaveUnitHandle(GameHashtable,(handleId),(2),(casterUnit))call SaveInteger(GameHashtable,(handleId),(34),(corpseCount))call SaveReal(GameHashtable,(handleId),(47),((targetX)*1.))call SaveReal(GameHashtable,(handleId),(48),((targetY)*1.))call SaveReal(GameHashtable,(handleId),(137),((angle)*1.))call SaveReal(GameHashtable,(handleId),(549),((casterX)*1.))call SaveReal(GameHashtable,(handleId),(567),((casterY)*1.))call SaveBoolean(GameHashtable,(handleId),(688),(false))call SaveBoolean(GameHashtable,(handleId),(689),(false))loopexitwhen loopIndex>corpseCountset corpseUnit=CreateUnit(GetOwningPlayer(casterUnit),'h0D7',casterX+GetRandomInt(-200,200),casterY+GetRandomInt(-200,200),0)call SaveUnitHandle(GameHashtable,(handleId),(393+loopIndex),(corpseUnit))call SaveReal(GameHashtable,(handleId),(549+loopIndex),((GetUnitX(corpseUnit))*1.))call SaveReal(GameHashtable,(handleId),(567+loopIndex),((GetUnitY(corpseUnit))*1.))set loopIndex=loopIndex+1endloopcall TriggerRegisterTimerEvent(castTrigger,.02,true)call TriggerAddCondition(castTrigger,Condition(function CorpseExplosionMoveTimerCallback))call SetCorpseCollectorCharges(casterUnit,0)set casterUnit=nullset castTrigger=nullset corpseUnit=nullendfunctionfunction FilterCastCorpseExplosion_2 takes nothing returns booleanif GetSpellAbilityId()=='A261' thencall CastCorpseExplosion()endifreturn falseendfunctionfunction OnLearnCorpseCollectorSkill takes nothing returns booleanif GetLearnedSkill()=='A261' and GetUnitAbilityLevel(GetTriggerUnit(),'A261')==1 and IsUnitIllusion(GetTriggerUnit())==false thencall StartCorpseCollectorTimer()endifreturn falseendfunctionfunction InitCorpseExplosionTriggers takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(t,Condition(function FilterCastCorpseExplosion_2))set t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_HERO_SKILL)call TriggerAddCondition(t,Condition(function OnLearnCorpseCollectorSkill))set t=nullendfunctionfunction SummonMovementToggleTimerCallback takes nothing returns booleanlocal trigger tickTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(tickTrigger)local unit summonUnit=(LoadUnitHandle(GameHashtable,(handl