layer(caster),abilityId,false)return falseendfunctionfunction MoveLocationNonZero takes location whichLocation,real newX,real newY returns locationif newX==0 thenset newX=.01endifif newY==0 thenset newY=.01endifcall MoveLocation(whichLocation,newX,newY)return whichLocationendfunctionfunction MoveLocationToLivingUnit takes location whichLocation,unit whichUnit returns locationlocal real unitX=GetWidgetX(whichUnit)local real unitY=GetWidgetY(whichUnit)if IsUnitType(whichUnit,UNIT_TYPE_DEAD) or IsUnit(whichUnit,null)thencall MoveLocation(whichLocation,0,0)return whichLocationendifif unitX==0 thenset unitX=.01endifif unitY==0 thenset unitY=.01endifcall MoveLocation(whichLocation,unitX,unitY)return whichLocationendfunctionfunction ClearUnitStoneCombo takes unit whichUnit returns booleanlocal integer handleId=GetHandleId(whichUnit)if not HaveSavedInteger(GameHashtable,handleId,StringHash("Stone|Combo"))thenreturn falseendifcall RemoveSavedInteger(GameHashtable,handleId,StringHash("Stone|Combo"))call RemoveSavedHandle(GameHashtable,handleId,StringHash("Stone|Combo"))return trueendfunctionfunction TryQueueStoneComboMove takes unit caster,real targetX,real targetY,unit target,integer abilityId returns booleanlocal integer handleId=GetHandleId(caster)local integer abilitySlot=0local integer playerId=GetPlayerId(GetOwningPlayer(caster))local real distance=DistanceBetweenCoords(GetUnitX(caster),GetUnitY(caster),targetX,targetY)if abilityId=='A2UU' thenset abilitySlot=16elseif abilityId=='A2TJ' thenset abilitySlot=32elseif abilityId=='A2QI' thenset abilitySlot=48elseif abilityId=='A2TI' thenset abilitySlot=0elseset abilitySlot=-1endifcall SaveBoolean(GameHashtable,handleId,StringHash("Stone|Combo"),true)call SaveInteger(GameHashtable,handleId,StringHash("Stone|Combo"),abilityId)call SaveUnitHandle(GameHashtable,handleId,StringHash("Stone|Combo"),target)if abilitySlot==-1 or GetUnitAbilityLevel(caster,abilityId)<1 or UnitHasAnyOfAbilityListA(caster)or DistanceBetweenCoords(GetUnitX(caster),GetUnitY(caster),targetX,targetY)>=1700. or AiAbilityNextCastTime[abilitySlot+playerId]>=ElapsedGameSeconds or LoadInteger(AiAbilityDataHashtable,abilityId,3+GetUnitAbilityLevel(caster,abilityId))>GetUnitState(caster,UNIT_STATE_MANA)or(GetUnitStoredIntegerSlot800(caster)<=0)or distance>=1600 or IssuePointOrderById(caster,852095,targetX,targetY)==false thencall RemoveSavedInteger(GameHashtable,handleId,StringHash("Stone|Combo"))call RemoveSavedHandle(GameHashtable,handleId,StringHash("Stone|Combo"))call RemoveSavedBoolean(GameHashtable,handleId,StringHash("Stone|Combo"))return falseendifreturn trueendfunctionfunction IsStoneComboAbilityAligned takes unit caster,integer abilityId,unit target returns booleanlocal real cosAngle=CosBJ(RAbsBJ(AngleBetweenUnits(caster,AiAbilityTargetUnit)-AngleBetweenUnits(AiAbilityTargetUnit,target)))if abilityId=='A2TI' thenreturn CountUnitsInRangeOfUnit(SelectRealByFlag(CountUnitsInRangeOfUnit(300,caster,Condition(function FilterEnemyBasicCreep))<=0,300,600),caster,Condition(function FilterTargetableEnemyHero))>0elseif abilityId=='A2UU' thenreturn cosAngle>=0 or IsUnitInRange(caster,target,150)elseif abilityId=='A2QI' thenreturn cosAngle<=0 or IsUnitInRange(caster,target,180)endifreturn trueendfunctionfunction ExecuteQueuedStoneCombo takes unit caster returns booleanlocal integer handleId=GetHandleId(caster)local integer abilityId=LoadInteger(GameHashtable,handleId,StringHash("Stone|Combo"))local unit target=LoadUnitHandle(GameHashtable,handleId,StringHash("Stone|Combo"))local boolean aligned=falselocal real range=300local integer orderId=0call TriggerSleepAction(.0)call RemoveSavedBoolean(GameHashtable,handleId,StringHash("Stone|Combo"))call RemoveSavedInteger(GameHashtable,handleId,StringHash("Stone|Combo"))if(IsUnit(AiAbilityTargetUnit,null))or abilityId==0 thenset target=nullcall ClearUnitStoneCombo(caster)return falseendifset aligned=(target==null)or IsStoneComboAbilityAligned(caster,abilityId,target)if abilityId=='A2TI' thenset target=nullcall ClearUnitStoneCombo(caster)return aligned and IssueImmediateOrderById(caster,852551)elseif abilityId=='A2UU' thenset range=200+SelectRealByFlag(UnitIsStunnedOrDisabled(target)or GetUnitMoveSpeed(caster)>1.5*GetUnitMoveSpeed(target),175,50)+GetRandomReal(0,25)set orderId=852600elseif abilityId=='A2QI' thenset range=1400set orderId=852096elseif abilityId=='A2TJ' thenset range=1000set orderId=852662elseset target=nullreturn falseendifset target=nullcall ClearUnitStoneCombo(caster)if abilityId!='A2UU' thenreturn aligned and(AiAbilityTargetUnit!=null)and IsUnitInRange(caster,AiAbilityTargetUnit,range)and IssueTargetOrderById(caster,orderId,AiAbilityTargetUnit)endifreturn aligned and(AiAbilityTargetUnit!=null)and IsUnitInRange(caster,AiAbilityTargetUnit,range)and IssueAiTargetAbilityOrder(caster,orderId,'A2UU',AiAbilityTargetUnit)endifcall ClearUnitStoneCombo(caster)set target=nullreturn falseendfunctionfunction StoreKaolinComboTarget takes boolean shouldStore,unit caster,unit target,integer abilityId returns booleanif not shouldStore thenreturn falseendifcall SaveInteger(GameHashtable,GetHandleId(caster)+StringHash("KaolinComboData"),StringHash("KaolinTarget"),abilityId)return SaveUnitHandle(GameHashtable,GetHandleId(caster)+StringHash("KaolinComboData"),StringHash("KaolinTarget"),target)endfunctionfunction CastKaolinComboAtTarget takes unit caster,boolean queueMove,boolean clearData returns booleanlocal unit target=GetKaolinComboTarget(caster)local integer abilityId=GetKaolinComboTargetId(caster)local boolean ordered=falselocal integer orderId=0local boolean Check=falselocal real casterX=GetUnitX(caster)local real casterY=GetUnitY(caster)local real targetX=GetUnitX(target)local real targetY=GetUnitY(target)local real angle=Atan2(targetY-casterY,targetX-casterX)if target==null or abilityId==0 thencall ClearKaolinComboData(caster)return falseendifif abilityId=='A2TI' thenset ordered=IssueImmediateOrderById(caster,852551)elseif abilityId=='A2QI' thenset ordered=(target!=null)and IsUnitInRange(caster,target,1300)and((queueMove and TryQueueStoneComboMove(caster,targetX+75*Cos(angle),targetY+75*Sin(angle),null,'A2QI'))or(IssueTargetOrderById(caster,852096,target)))elseif abilityId=='A2TJ' thenset ordered=(target!=null)and((queueMove and TryQueueStoneComboMove(caster,casterX+75*Cos(angle),casterY+75*Sin(angle),null,'A2TJ'))or(IssueTargetOrderById(caster,852662,target)))elseif abilityId=='A2UU' thenset ordered=(target!=null)and((queueMove and TryQueueStoneComboMove(caster,casterX+75*Cos(angle),casterY+75*Sin(angle),null,'A2UU'))or(IssueTargetOrderById(caster,852600,target)))endifif clearData thencall ClearKaolinComboData(caster)endifreturn orderedendfunctionfunction IsBootsFamilyItem takes integer itemTypeId returns booleanreturn(itemTypeId==ItemTypeId[ItemIndexCost3975A]or itemTypeId==ItemTypeId[ItemIndexCost3975B]or itemTypeId==ItemTypeId[ItemIndexCost3975C]or itemTypeId==ItemTypeId[ItemIndexCost3975D]or itemTypeId==ItemTypeId[ItemIndexCost3975E]or itemTypeId==ItemTypeId[ItemIndexCost3975F]or itemTypeId==ItemTypeId[ItemIndexCost3975G])endfunctionfunction AreItemTypesEquivalent takes integer itemIndexA,integer itemIndexB,boolean treatUpgradesEquivalent returns booleanif itemIndexA==itemIndexB thenreturn trueelseif(itemIndexA==ItemIndexCost550Ranged or itemIndexA==ItemIndexCost550Melee)and(itemIndexB==ItemIndexCost550Ranged or itemIndexB==ItemIndexCost550Melee)thenreturn trueelseif(itemIndexA==ItemIndexCost250A or itemIndexA==ItemIndexCost250B)and(itemIndexB==ItemIndexCost250A or itemIndexB==ItemIndexCost250B)thenreturn trueelseif(itemIndexA==ItemIndexCost225Ranged or itemIndexA==ItemIndexCost225Melee)and(itemIndexB==ItemIndexCost225Ranged or itemIndexB==ItemIndexCost225Melee)thenreturn trueelseif(itemIndexA==ItemIndexCost2950A or itemIndexA==ItemIndexCost2950B)and(itemIndexB==ItemIndexCost2950A or itemIndexB==ItemIndexCost2950B)thenreturn trueelseif(itemIndexA==ItemIndexCost775 or itemIndexA==ItemIndexGold775)and(itemIndexB==ItemIndexCost775 or itemIndexB==ItemIndexGold775)thenreturn trueelseif(itemIndexA==ItemIndexCost4950A or itemIndexA==ItemIndexCost4950B)and(itemIndexB==ItemIndexCost4950A or itemIndexB==ItemIndexCost4950B)thenreturn trueelseif(itemIndexA==ItemIndexCost5675A or itemIndexA==ItemIndexCost5675B)and(itemIndexB==ItemIndexCost5675A or itemIndexB==ItemIndexCost5675B)thenreturn trueelseif(itemIndexA==ItemIndexCost2225A or itemIndexA==ItemIndexCost2225B)and(itemIndexB==ItemIndexCost2225A or itemIndexB==ItemIndexCost2225B)thenreturn trueelseif(itemIndexA==ItemIndexCost700A or itemIndexA==ItemIndexCost700B or itemIndexA==ItemIndexCost700C or itemIndexA==ItemIndexCost700D or itemIndexA==ItemIndexCost700E or itemIndexA==ItemIndexCost700F or itemIndexA==ItemIndexCost700G or itemIndexA==ItemIndexCost700H or itemIndexA==ItemIndexCost700I or itemIndexA==ItemIndexCost700J )and(itemIndexB==ItemIndexCost700A or itemIndexB==ItemIndexCost700B or itemIndexB==ItemIndexCost700C or itemIndexB==ItemIndexCost700D or itemIndexB==ItemIndexCost700E or itemIndexB==ItemIndexCost700F or itemIndexB==ItemIndexCost700G or itemIndexB==ItemIndexCost700H or itemIndexB==ItemIndexCost700I or itemIndexB==ItemIndexCost700J )thenreturn trueelseif(itemIndexA==ItemIndexGold1850A or itemIndexA==ItemIndexGold1850B)and(itemIndexB==ItemIndexGold1850A or itemIndexB==ItemIndexGold1850B)thenreturn trueelseif(itemIndexA==ItemIndexCost1400B or itemIndexA==ItemIndexCost1400C or itemIndexA==ItemIndexCost1400D)and(itemIndexB==ItemIndexCost1400B or itemIndexB==ItemIndexCost1400C or itemIndexB==ItemIndexCost1400D)thenreturn trueelseif(itemIndexA==ItemIndexCost875_3 or itemIndexA==ItemIndexUnclassifiedDF4)and(itemIndexB==ItemIndexCost875_3 or itemIndexB==ItemIndexUnclassifiedDF4)thenreturn trueelseif treatUpgradesEquivalent and((itemIndexA==ItemIndexCost3150A or itemIndexA==ItemIndexCost3150B or itemIndexA==ItemIndexCost3850A or itemIndexA==ItemIndexCost3850B)and(itemIndexB==ItemIndexCost3150A or itemIndexB==ItemIndexCost3150B or itemIndexB==ItemIndexCost3850A or itemIndexB==ItemIndexCost3850B))thenreturn trueelseif(itemIndexA==ItemIndexCost3150A or itemIndexA==ItemIndexCost3150B)and(itemIndexB==ItemIndexCost3150A or itemIndexB==ItemIndexCost3150B)thenreturn trueelseif(itemIndexA==ItemIndexCost3850A or itemIndexA==ItemIndexCost3850B)and(itemIndexB==ItemIndexCost3850A or itemIndexB==ItemIndexCost3850B)thenreturn trueelseif treatUpgradesEquivalent and((itemIndexA==ItemIndexCost2720 or itemIndexA==ItemIndexCost3970 or itemIndexA==ItemIndexCost5220 or itemIndexA==ItemIndexCost6470 or itemIndexA==ItemIndexCost7720)and(itemIndexB==ItemIndexCost2720 or itemIndexB==ItemIndexCost3970 or itemIndexB==ItemIndexCost5220 or itemIndexB==ItemIndexCost6470 or itemIndexB==ItemIndexCost7720))thenreturn trueelseif treatUpgradesEquivalent and((itemIndexA==ItemIndexCost2700B or itemIndexA==ItemIndexCost3950 or itemIndexA==ItemIndexCost5200)and(itemIndexB==ItemIndexCost2700B or itemIndexB==ItemIndexCost3950 or itemIndexB==ItemIndexCost5200))thenreturn trueelseif(itemIndexA==ItemIndexCost3975A or itemIndexA==ItemIndexCost3975B or itemIndexA==ItemIndexCost3975C or itemIndexA==ItemIndexCost3975D or itemIndexA==ItemIndexCost3975E or itemIndexA==ItemIndexCost3975F or itemIndexA==ItemIndexCost3975G)and(itemIndexB==ItemIndexCost3975A or itemIndexB==ItemIndexCost3975B or itemIndexB==ItemIndexCost3975C or itemIndexB==ItemIndexCost3975D or itemIndexB==ItemIndexCost3975E or itemIndexB==ItemIndexCost3975F or itemIndexB==ItemIndexCost3975G)thenreturn trueelseif(itemIndexA==ItemIndexCost525A or itemIndexA==ItemIndexCost525B)and(itemIndexB==ItemIndexCost525A or itemIndexB==ItemIndexCost525B)thenreturn trueelseif(itemIndexA==ItemIndexGold1010A or itemIndexA==ItemIndexGold1010B)and(itemIndexB==ItemIndexGold1010A or itemIndexB==ItemIndexGold1010B)thenreturn trueelseif(itemIndexA==ItemIndexCost5150A or itemIndexA==ItemIndexCost5150B)and(itemIndexB==ItemIndexCost5150A or itemIndexB==ItemIndexCost5150B)thenreturn trueelseif(itemIndexA==ItemIndexCost5400A or itemIndexA==ItemIndexCost5400B)and(itemIndexB==ItemIndexCost5400A or itemIndexB==ItemIndexCost5400B)thenreturn trueelseif(itemIndexA==ItemIndexCost5500A or itemIndexA==ItemIndexCost5500B)and(itemIndexB==ItemIndexCost5500A or itemIndexB==ItemIndexCost5500B)thenreturn trueelseif(itemIndexA==ItemIndexArmlet or itemIndexA==ItemIndexCost2400B or itemIndexA==ItemIndexCost2400C or itemIndexA==ItemIndexCost2400D)and(itemIndexB==ItemIndexArmlet or itemIndexB==ItemIndexCost2400B or itemIndexB==ItemIndexCost2400C or itemIndexB==ItemIndexCost2400D)thenreturn trueelseif(itemIndexA==ItemIndexGold100A or itemIndexA==ItemIndexGold100PointUse)and(itemIndexB==ItemIndexGold100A or itemIndexB==ItemIndexGold100PointUse)thenreturn trueelseif(itemIndexA==ItemIndexCost5175A or itemIndexA==ItemIndexCost5175B)and(itemIndexB==ItemIndexCost5175A or itemIndexB==ItemIndexCost5175B)thenreturn trueelseif(itemIndexA==ItemIndexCost7800 or itemIndexA==ItemIndexCost7800B)and(itemIndexB==ItemIndexCost7800 or itemIndexB==ItemIndexCost7800B)thenreturn trueelseif(itemIndexA==ItemIndexCost1850A or itemIndexA==ItemIndexCost1850B)and(itemIndexB==ItemIndexCost1850A or itemIndexB==ItemIndexCost1850B)thenreturn trueelseif(itemIndexA==ItemIndexCost900A or itemIndexA==ItemIndexCost900B)and(itemIndexB==ItemIndexCost900A or itemIndexB==ItemIndexCost900B)thenreturn trueelseif(itemIndexA==ItemIndexCost2050A or itemIndexA==ItemIndexRecipeLC)and(itemIndexB==ItemIndexCost2050A or itemIndexB==ItemIndexRecipeLC)thenreturn trueelseif(itemIndexA==ItemIndexCost4700A or itemIndexA==ItemIndexCost4700B)and(itemIndexB==ItemIndexCost4700A or itemIndexB==ItemIndexCost4700B)thenreturn trueendifreturn falseendfunctionfunction FindUnitItemByType takes unit whichUnit,integer itemTypeId returns booleanlocal integer index=0local item whichItemlocal integer itemTypeIndexlocal boolean found=falseset index=0loopexitwhen index>ItemTypeIndexCounterif ItemTypeIdTableA[index]==itemTypeId or ItemTypeId[index]==itemTypeId or ItemTypeIdTableC[index]==itemTypeId thenset itemTypeId=indexexitwhen trueendifset index=index+1endloopif index>ItemTypeIndexCounter thenreturn falseendifset index=0set bj_lastCreatedItem=nullloopset whichItem=UnitItemInSlot(whichUnit,index)if whichItem!=null thenset itemTypeIndex=FindItemTypeIndexAllTables(whichItem)if AreItemTypesEquivalent(itemTypeIndex,itemTypeId,true)thenset bj_lastCreatedItem=whichItemset whichItem=nullreturn trueendifendifset index=index+1exitwhen index>=bj_MAX_INVENTORYendloopset whichItem=nullreturn falseendfunctionfunction FindUnitItemOfPair takes unit whichUnit returns booleanlocal integer slotIndex=0local item whichItemset bj_lastCreatedItem=nullloopset whichItem=UnitItemInSlot(whichUnit,slotIndex)if((whichItem!=null)and(GetItemTypeId(whichItem)==ItemTypeId[ItemIndexCost500_2]or GetItemTypeId(whichItem)==ItemTypeId[ItemIndexCost200_2]))thenset bj_lastCreatedItem=whichItemset whichItem=nullreturn trueendifset slotIndex=slotIndex+1exitwhen slotIndex>=bj_MAX_INVENTORYendloopset whichItem=nullreturn falseendfunctionfunction UseUnitItemOfType takes unit whichUnit,integer itemTypeId returns booleanlocal boolean used=falselocal integer playerIdif(FindUnitItemByType(whichUnit,itemTypeId))thenset playerId=GetPlayerId(GetOwningPlayer(whichUnit))set AiSlotBoolFlagGZ[224+playerId]=trueset used=UnitUseItem(whichUnit,bj_lastCreatedItem)set AiSlotBoolFlagGZ[224+playerId]=falseendifreturn usedendfunctionfunction AiManageDagon takes unit hero,unit target returns booleanlocal boolean success=falselocal integer playerId=GetPlayerId(GetOwningPlayer(hero))if((AiDefensiveItemEnabled)and(not HasTempDefensiveItem[playerId])and(GetUnitTypeId(hero)!='H00J')and(not IsUnitIllusion(hero))and(ElapsedGameSeconds>NextDefensiveItemTime[playerId])and(target!=null)and(GetUnitLevel(hero)>5)and(GetUnitState(hero,UNIT_STATE_MANA)>300)and(not UnitHasItemOfType_2(hero,ItemTypeId[ItemIndexCost2720]))and(not UnitHasItemOfType_2(hero,ItemTypeId[ItemIndexCost3970]))and(not UnitHasItemOfType_2(hero,ItemTypeId[ItemIndexCost5220]))and(not UnitHasItemOfType_2(hero,ItemTypeId[ItemIndexCost6470]))and(not UnitHasItemOfType_2(hero,ItemTypeId[ItemIndexCost7720]))and(GetRandomInt(1,4)!=4))thenif(GetUnitLevel(hero)>12 and GetUnitLevel(hero)<20)thenset DefensiveItemChoice=GetRandomInt(3,5)elseif(GetUnitLevel(hero)>19 and GetUnitLevel(hero)<25)thenset DefensiveItemChoice=GetRandomInt(4,5)elseif(GetUnitLevel(hero)>24)thenset DefensiveItemChoice=5elseset DefensiveItemChoice=GetRandomInt(1,5)endifset TempDefensiveItem[playerId]=CreateItem(DefensiveItemTypeId[DefensiveItemChoice],9999,-9999)set HasTempDefensiveItem[playerId]=falseif(TempDefensiveItem[playerId]!=null)thenset SavedInventorySlotItem[playerId]=UnitItemInSlot(hero,5)if(SavedInventorySlotItem[playerId]!=null)thencall DisableTrigger(ToggleableTrigger)call UnitRemoveItem(hero,SavedInventorySlotItem[playerId])call SetItemPosition(SavedInventorySlotItem[playerId],9999,-9999)call EnableTrigger(ToggleableTrigger)endifcall PolledWait_2(.2)set HasTempDefensiveItem[playerId]=(UnitAddItem(hero,TempDefensiveItem[playerId]))call SetItemPlayer(TempDefensiveItem[playerId],GetOwningPlayer(hero),true)endifif(HasTempDefensiveItem[playerId])thencall DebugPrintGlobal("Dagon was added successfully for |c00ffff00"+GetUnitName(hero)+"|r")elsecall DebugPrintGlobal("Dagon FAILED to add for |c00ffff00"+GetUnitName(hero)+"|r")if(SavedInventorySlotItem[playerId]!=null)thencall PolledWait_2(.2)call UnitAddItem(hero,SavedInventorySlotItem[playerId])call RemoveItemSilently(TempDefensiveItem[playerId])endifset HasTempDefensiveItem[playerId]=falseset TempDefensiveItem[playerId]=nullset SavedInventorySlotItem[playerId]=nullendifelseif((UnitHasItemOfType_2(hero,ItemTypeId[ItemIndexCost7720]))and(not IsUnitIllusion(target))and(IsUnitInRange(hero,target,800.))and((GetUnitState(target,UNIT_STATE_LIFE)>10.)and(GetUnitState(target,UNIT_STATE_LIFE)<1000.)))thenset success=(target!=null)and(UnitUseItemTarget(hero,bj_lastCreatedItem,target))elseif((UnitHasItemOfType_2(hero,ItemTypeId[ItemIndexCost6470]))and(not IsUnitIllusion(target))and(IsUnitInRange(hero,target,750.))and((GetUnitState(target,UNIT_STATE_LIFE)>10.)and(GetUnitState(target,UNIT_STATE_LIFE)<850.)))thenset success=(target!=null)and(UnitUseItemTarget(hero,bj_lastCreatedItem,target))elseif((UnitHasItemOfType_2(hero,ItemTypeId[ItemIndexCost5220]))and(not IsUnitIllusion(target))and(IsUnitInRange(hero,target,700.))and((GetUnitState(target,UNIT_STATE_LIFE)>10.)and(GetUnitState(target,UNIT_STATE_LIFE)<700.)))thenset success=(target!=null)and(UnitUseItemTarget(hero,bj_lastCreatedItem,target))elseif((UnitHasItemOfType_2(hero,ItemTypeId[ItemIndexCost3970]))and(not IsUnitIllusion(target))and(IsUnitInRange(hero,target,650.))and((GetUnitState(target,UNIT_STATE_LIFE)>10.)and(GetUnitState(target,UNIT_STATE_LIFE)<550.)))thenset success=(target!=null)and(UnitUseItemTarget(hero,bj_lastCreatedItem,target))elseif((UnitHasItemOfType_2(hero,ItemTypeId[ItemIndexCost2720]))and(not IsUnitIllusion(target))and(IsUnitInRange(hero,target,600.))and((GetUnitState(target,UNIT_STATE_LIFE)>10.)and(GetUnitState(target,UNIT_STATE_LIFE)<400.)))thenset success=(target!=null)and(UnitUseItemTarget(hero,bj_lastCreatedItem,target))endifendifreturn successendfunctionfunction ForGroupAndDestroy takes group whichGroup,code callback returns nothingcall ForGroup(whichGroup,callback)call DestroyGroup(whichGroup)endfunctionfunction WidgetPositionLoc takes widget whichWidget returns locationcall MoveLocation(TempOrderLocation,GetWidgetX(whichWidget),GetWidgetY(whichWidget))return TempOrderLocationendfunctionfunction IssueSurroundPointOrder takes unit whichUnit,integer orderId,unit target returns booleanlocal integer userData=0local integer playerId=0if(CandidateUnitByIndex[GetUnitUserData(target)]!=target)or(orderId!=851983 and orderId!=851986 and orderId!=851971)thenreturn IssuePointOrderById(whichUnit,orderId,GetUnitX(target),GetUnitY(target))endifset userData=GetUnitUserData(target)if userData<=0 or userData>=100 thenreturn IssuePointOrderById(whichUnit,orderId,GetUnitX(target),GetUnitY(target))elseset OrbitApproachAngle=AngleBetweenUnits(whichUnit,target)-90set playerId=GetPlayerId(GetOwningPlayer(whichUnit))return IssuePointOrderById(whichUnit,orderId,GetUnitX(target)+AiPlayerTimeThreshold[864+playerId]*Cos(OrbitApproachAngle*bj_DEGTORAD),GetUnitY(target)+AiPlayerTimeThreshold[864+playerId]*Sin(OrbitApproachAngle*bj_DEGTORAD))endifendfunctionfunction DistanceUnitToRectCenter takes unit whichUnit,rect whichRect returns reallocal real deltaX=GetRectCenterX(whichRect)-GetUnitX(whichUnit)local real deltaY=GetRectCenterY(whichRect)-GetUnitY(whichUnit)return SquareRoot(deltaX*deltaX+deltaY*deltaY)endfunctionfunction AiCastTargetOrderSilently takes unit caster,integer orderId,integer abilityId,integer secondaryAbilityId,unit target returns booleanlocal integer playerId=GetPlayerId(GetOwningPlayer(caster))if(not PlayerHeroControlEnabled[playerId]or abilityId==0)or(GetPlayerController(GetOwningPlayer(caster))!=MAP_CONTROL_COMPUTER)thenreturn falseendifcall SetPlayerAbilityAvailable(GetOwningPlayer(caster),abilityId,(true))call SetPlayerAbilityAvailable(GetOwningPlayer(caster),secondaryAbilityId,(true))call DisableTrigger(PerPlayerAiControlTrigger[playerId])if(IssueTargetOrderById(caster,orderId,target))thencall EnableTrigger(PerPlayerAiControlTrigger[playerId])return trueendifcall EnableTrigger(PerPlayerAiControlTrigger[playerId])call SetPlayerAbilityAvailable(GetOwningPlayer(caster),abilityId,false)call SetPlayerAbilityAvailable(GetOwningPlayer(caster),secondaryAbilityId,false)return falseendfunctionfunction AiCastPointOrderSilently takes unit caster,integer orderId,integer abilityId,integer secondaryAbilityId,real targetX,real targetY returns booleanlocal integer playerId=GetPlayerId(GetOwningPlayer(caster))if(not PlayerHeroControlEnabled[playerId]or abilityId==0)or(GetPlayerController(GetOwningPlayer(caster))!=MAP_CONTROL_COMPUTER)thenreturn falseendifcall SetPlayerAbilityAvailable(GetOwningPlayer(caster),abilityId,true)call SetPlayerAbilityAvailable(GetOwningPlayer(caster),secondaryAbilityId,true)call DisableTrigger(PerPlayerAiControlTrigger[playerId])if(IssuePointOrderById(caster,orderId,targetX,targetY))thencall EnableTrigger(PerPlayerAiControlTrigger[playerId])return trueendifcall EnableTrigger(PerPlayerAiControlTrigger[playerId])call SetPlayerAbilityAvailable(GetOwningPlayer(caster),abilityId,false)call SetPlayerAbilityAvailable(GetOwningPlayer(caster),secondaryAbilityId,false)return falseendfunctionfunction MarkUnitOrderIssued takes unit whichUnit returns booleancall SaveInteger(AiAbilityDataHashtable,AiDummyStateKey,GetHandleId(whichUnit),1)return trueendfunctionfunction IssueTargetOrderAndMark takes unit orderedUnit,string orderString,widget target returns booleanreturn IssueTargetOrder(orderedUnit,orderString,target)and MarkUnitOrderIssued(orderedUnit)endfunctionfunction AiCastImmediateOrderSilently takes unit caster,integer orderId,integer abilityId returns booleanlocal integer playerId=GetPlayerId(GetOwningPlayer(caster))if(not PlayerHeroControlEnabled[playerId]or abilityId==0)or(GetPlayerController(GetOwningPlayer(caster))!=MAP_CONTROL_COMPUTER)thenreturn falseendifcall SetPlayerAbilityAvailable(GetOwningPlayer(caster),abilityId,true)call DisableTrigger(PerPlayerAiControlTrigger[16+playerId])if(IssueImmediateOrderById(caster,orderId))thencall EnableTrigger(PerPlayerAiControlTrigger[16+playerId])return trueendifcall EnableTrigger(PerPlayerAiControlTrigger[16+playerId])call SetPlayerAbilityAvailable(GetOwningPlayer(caster),abilityId,false)return falseendfunctionfunction MarkUnitFlagBoolean takes unit whichUnit returns nothingcall SaveBoolean(AiAbilityDataHashtable,AiDummyStateKey,GetHandleId(whichUnit),true)endfunctionfunction AiDifficultyChanceRoll takes unit whichUnit returns booleanreturn ((AiAggressionLevel[GetPlayerId(GetOwningPlayer(whichUnit))]!=AiAggressionLow)or(GetRandomInt(1,5)<=2))endfunctionfunction GetSideReferenceHero takes unit whichUnit returns unitif(IsUnitAlly(whichUnit,SentinelPlayer[0]))thenreturn CandidateUnitByIndex[1]elsereturn CandidateUnitByIndex['e']endifendfunctionfunction GetSideBaseUnitG8 takes unit whichUnit returns unitif(IsUnitAlly(whichUnit,SentinelPlayer[0]))thenreturn CandidateUnitByIndex[0]elsereturn CandidateUnitByIndex[100]endifendfunctionfunction GetSideBaseUnitN8 takes unit whichUnit returns unitif(IsUnitAlly(whichUnit,ScourgePlayer[0]))thenreturn CandidateUnitByIndex[0]elsereturn CandidateUnitByIndex[100]endifendfunctionfunction SelectIntegerByFlag takes boolean isTeamTwo returns integerif(isTeamTwo)thenreturn TeamTwoPlayerCount_2elsereturn TeamOnePlayerCount_2endifendfunctionfunction GetTeamPlayerBySlot takes integer slot,boolean isSentinel returns playerif(isSentinel)thenreturn SentinelPlayer[slot]elsereturn ScourgePlayer[slot]endifendfunctionfunction SelectPlayerFromFirstPair takes boolean useFirst returns playerif(useFirst)thenreturn PendingSwapPlayerAelsereturn PendingSwapPlayerBendifendfunctionfunction SelectPlayerFromSecondPair takes boolean useFirst returns playerif(useFirst)thenreturn PendingSwapPartnerAelsereturn PendingSwapPartnerBendifendfunctionfunction RemoveStoredValueByName takes integer parentKey,string name_2 returns nothingcall RemoveSavedHandle(GameHashtable,parentKey,StringHash(name_2))endfunctionfunction SaveIntByStringKey takes integer Gu,string keyString,integer Gy returns nothingcall SaveInteger(GameHashtable,Gu,StringHash(keyString),Gy)endfunctionfunction StoreRealByName takes integer parentKey,string name_2,real value returns nothingcall SaveReal(GameHashtable,parentKey,StringHash(name_2),value)endfunctionfunction StoreStringByName takes integer parentKey,string name_2,string value returns nothingcall SaveStr(GameHashtable,parentKey,StringHash(name_2),value)endfunctionfunction StoreBooleanByName takes integer parentKey,string name_2,boolean value returns nothingcall SaveBoolean(GameHashtable,parentKey,StringHash(name_2),value)endfunctionfunction StoreUnitByName takes integer parentKey,string name_2,unit value returns nothingcall SaveUnitHandle(GameHashtable,parentKey,StringHash(name_2),value)endfunctionfunction StoreEffectByName takes integer parentKey,string name_2,effect value returns nothingcall SaveEffectHandle(GameHashtable,parentKey,StringHash(name_2),value)endfunctionfunction SaveTriggerByStringKey takes integer Gu,string keyString,trigger Gy returns nothingcall SaveTriggerHandle(GameHashtable,Gu,StringHash(keyString),Gy)endfunctionfunction StoreDestructableByName takes integer parentKey,string name_2,destructable value returns nothingcall SaveDestructableHandle(GameHashtable,parentKey,StringHash(name_2),value)endfunctionfunction StorePlayerByName takes integer parentKey,string name_2,player value returns nothingcall SavePlayerHandle(GameHashtable,parentKey,StringHash(name_2),value)endfunctionfunction StoreGroupByName takes integer parentKey,string name_2,group value returns nothingcall SaveGroupHandle(GameHashtable,parentKey,StringHash(name_2),value)endfunctionfunction StoreLocationByName takes integer parentKey,string name_2,location value returns nothingcall SaveLocationHandle(GameHashtable,parentKey,StringHash(name_2),value)endfunctionfunction StoreBoolExprByName takes integer parentKey,string name_2,boolexpr value returns nothingcall SaveBooleanExprHandle(GameHashtable,parentKey,StringHash(name_2),value)endfunctionfunction StoreButtonByName takes integer parentKey,string name_2,button value returns nothingcall SaveButtonHandle(GameHashtable,parentKey,StringHash(name_2),value)endfunctionfunction StoreForceByName takes integer parentKey,string name_2,force value returns nothingcall SaveForceHandle(GameHashtable,parentKey,StringHash(name_2),value)endfunctionfunction GetDestructableByName takes integer parentKey,string name_2 returns destructablereturn LoadDestructableHandle(GameHashtable,parentKey,StringHash(name_2))endfunctionfunction GetUnitByName takes integer parentKey,string name_2 returns unitreturn LoadUnitHandle(GameHashtable,parentKey,StringHash(name_2))endfunctionfunction GetPlayerByName takes integer parentKey,string name_2 returns playerreturn LoadPlayerHandle(GameHashtable,parentKey,StringHash(name_2))endfunctionfunction LoadTriggerByStringKey takes integer Gu,string keyString returns triggerreturn LoadTriggerHandle(GameHashtable,Gu,StringHash(keyString))endfunctionfunction GetGroupByName takes integer parentKey,string name_2 returns groupreturn LoadGroupHandle(GameHashtable,parentKey,StringHash(name_2))endfunctionfunction GetEffectByName takes integer parentKey,string name_2 returns effectreturn LoadEffectHandle(GameHashtable,parentKey,StringHash(name_2))endfunctionfunction GetLocationByName takes integer parentKey,string name_2 returns locationreturn LoadLocationHandle(GameHashtable,parentKey,StringHash(name_2))endfunctionfunction LoadIntByStringKey takes integer Gu,string keyString returns integerreturn LoadInteger(GameHashtable,Gu,StringHash(keyString))endfunctionfunction GetRealByName takes integer parentKey,string name_2 returns realreturn LoadReal(GameHashtable,parentKey,StringHash(name_2))endfunctionfunction GetBooleanByName takes integer parentKey,string name_2 returns booleanreturn LoadBoolean(GameHashtable,parentKey,StringHash(name_2))endfunctionfunction GetStringByName takes integer key,string name_2 returns stringreturn LoadStr(GameHashtable,key,StringHash(name_2))endfunctionfunction LoadButtonByTag takes integer parentKey,string childTag returns buttonreturn LoadButtonHandle(GameHashtable,parentKey,StringHash(childTag))endfunctionfunction LoadBoolExprByTag takes integer parentKey,string childTag returns boolexprreturn LoadBooleanExprHandle(GameHashtable,parentKey,StringHash(childTag))endfunctionfunction LoadForceByTag takes integer parentKey,string childTag returns forcereturn LoadForceHandle(GameHashtable,parentKey,StringHash(childTag))endfunctionfunction IsUnitStateFlagActive takes unit whichUnit,string stateName returns booleanreturn LoadInteger(GameHashtable,GetHandleId(whichUnit),StringHash("state"+stateName))==1endfunctionfunction SetUnitStateFlagActive takes unit whichUnit,string stateName returns nothingcall SaveInteger(GameHashtable,GetHandleId(whichUnit),StringHash("state"+stateName),1)endfunctionfunction SetUnitStateFlagDone takes unit whichUnit,string stateName returns nothingcall SaveInteger(GameHashtable,GetHandleId(whichUnit),StringHash("state"+stateName),2)endfunctionfunction OnUnitFlagTimerExpire takes nothing returns nothinglocal timer whichTimer=GetExpiredTimer()local integer timerId=GetHandleId(whichTimer)call SaveInteger(GameHashtable,(GetHandleId(((LoadUnitHandle(GameHashtable,(timerId),(14)))))),(((LoadInteger(GameHashtable,(timerId),(33))))),(2))call PauseTimer(whichTimer)call FlushChildHashtable(GameHashtable,timerId)call DestroyTimer(whichTimer)set whichTimer=nullendfunctionfunction StartUnitFlagTimer takes unit whichUnit,integer stateKey,real duration returns nothinglocal timer whichTimer=CreateTimer()call SaveInteger(GameHashtable,(GetHandleId((whichUnit))),((stateKey)),(1))call SaveUnitHandle(GameHashtable,(GetHandleId(whichTimer)),(14),(whichUnit))call SaveInteger(GameHashtable,(GetHandleId(whichTimer)),(33),(stateKey))call TimerStart(whichTimer,duration,false,function OnUnitFlagTimerExpire)set whichTimer=nullendfunctionfunction OnHeroStateTimerExpire takes nothing returns booleanlocal trigger whichTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(whichTrigger)call SetUnitStateFlagDone(GetUnitByName(triggerId,"hero"),GetStringByName(triggerId,"state"))call FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(whichTrigger)set whichTrigger=nullreturn falseendfunctionfunction StartHeroStateTimer takes unit hero,string stateName,real duration returns nothinglocal trigger whichTrigger=CreateTrigger()call TriggerAddCondition(whichTrigger,Condition(function OnHeroStateTimerExpire))call TriggerRegisterTimerEvent(whichTrigger,duration,false)call SetUnitStateFlagActive(hero,stateName)call StoreUnitByName(GetHandleId(whichTrigger),"hero",hero)call StoreStringByName(GetHandleId(whichTrigger),"state",stateName)set whichTrigger=nullendfunctionfunction GroupUnitCount takes group whichGroup returns integerset bj_groupCountUnits=0call ForGroup(whichGroup,function CountUnitsInGroupEnum)return bj_groupCountUnitsendfunctionfunction CopyPlayersIntoForce takes force sourceForce,force destForce returns forcelocal integer playerIndex=0loopexitwhen playerIndex>11if IsPlayerInForce(Player(playerIndex),sourceForce)thencall ForceAddPlayer(destForce,Player(playerIndex))endifset playerIndex=playerIndex+1endloopreturn destForceendfunctionfunction GetHeroNameByPointValue takes unit whichUnit returns stringif whichUnit==null thenreturn(GetObjectName(('n09T')))endifreturn(GetObjectName((HeroTypeByPointValue[GetUnitPointValue(whichUnit)])))endfunctionfunction FormatNameWithHero takes integer pid,unit hero returns stringreturn PlayerName[pid]endfunctionfunction ShowHeroChatMessageToPlayer takes unit speaker,string message,player receiver returns nothinglocal integer receiverId=0local integer speakerPlayerId=0local unit trackedUnit=nulllocal real distance=0local string colorPrefix=""local string formattedMessage=""set receiverId=GetPlayerId(receiver)set trackedUnit=TrackedSideUnit[receiverId]if speaker!=null thenset speakerPlayerId=GetPlayerId(GetOwningPlayer(speaker))elseset speakerPlayerId=15endifif not(speakerPlayerId==0 or speakerPlayerId==6 or speakerPlayerId==15)thenif trackedUnit!=null and GetWidgetLife(trackedUnit)>.405 and speaker!=null thenset distance=DistanceBetweenWidgets(speaker,trackedUnit)if distance<=1500 thenset colorPrefix=""elseif distance<=3000. thenset colorPrefix=""elseset colorPrefix=""endifendifset formattedMessage="|r"+PlayerColorCode[speakerPlayerId]+FormatNameWithHero(speakerPlayerId,speaker)+"|r: "+colorPrefix+message+"|r"elseif speakerPlayerId==GetPlayerId(SentinelPlayer[0])thenset formattedMessage="[AI] "+PlayerColorCode[speakerPlayerId]+"The Sentinel|r: "+messageelseif speakerPlayerId==GetPlayerId(ScourgePlayer[0])thenset formattedMessage="[AI] "+PlayerColorCode[speakerPlayerId]+"The Scourge|r: "+messageelseif speakerPlayerId==12 thenset formattedMessage="[AI]: "+message+"|r"endifif PlayerMultiboardToggle[receiverId]and receiver==GetLocalPlayer()thencall DisplayTimedTextToPlayer(receiver,0,0,10,formattedMessage)endifset trackedUnit=nullset colorPrefix=""endfunctionfunction AnnounceHeroGroupMessageToForce takes group heroGroup,string message,force targetForce returns nothinglocal integer playerId=0local unit hero=nulllocal string nameList="|r"local integer slotIndex=1loopexitwhen slotIndex>10set hero=TrackedSideUnit[GetPlayerId(PlayerFromSlotIndex(slotIndex))]if IsUnitInGroup(hero,heroGroup)thencall GroupRemoveUnit(heroGroup,hero)set playerId=GetPlayerId(GetOwningPlayer(hero))if nameList!="|r" thenset nameList=nameList+", "endifset nameList=nameList+PlayerColorCode[playerId]+FormatNameWithHero(playerId,hero)+"|r"endifset slotIndex=slotIndex+1endlooploopset hero=FirstOfGroup(heroGroup)exitwhen hero==nullcall GroupRemoveUnit(heroGroup,hero)set playerId=GetPlayerId(GetOwningPlayer(hero))if nameList!="|r" thenset nameList=nameList+", "endifset nameList=nameList+PlayerColorCode[playerId]+FormatNameWithHero(playerId,hero)+"|r"endloopset nameList=nameList+": "if(IsPlayerInForce(GetLocalPlayer(),targetForce))or(IsTestBuildEnabled and GetLocalPlayer()==SentinelPlayer[0])thencall DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,10.,nameList+message)endifendfunctionfunction DispatchQueuedChatOnTimer takes nothing returns nothinglocal timer whichTimer=GetExpiredTimer()local force targetForce=nulllocal integer playerIndex=1local unit heroOwner=nulllocal group heroGroup=nulllocal integer dataKey=GetHandleId(whichTimer)local string message=""if GetBooleanByName(dataKey,"Personal")thenset targetForce=LoadForceByTag(dataKey,"Target")set message=GetStringByName(dataKey,"SubTag")set heroOwner=GetUnitByName(dataKey,"Owner")loopexitwhen playerIndex>11if IsPlayerInForce(Player(playerIndex),targetForce)thenif message==" " thencall DisplayTimedTextToPlayer(Player(playerIndex),0,0,10,message)elsecall ShowHeroChatMessageToPlayer(heroOwner,message,Player(playerIndex))endifendifset playerIndex=playerIndex+1endloopcall FlushChildHashtable(GameHashtable,dataKey)call DestroyTimer(whichTimer)elseset message=GetStringByName(dataKey,"SubTag")set dataKey=StringHash("cAI|Re"+message)set targetForce=LoadForceByTag(dataKey,"Target")set heroGroup=GetGroupByName(dataKey,"Owner")if LoadIntByStringKey(dataKey,"CountDn")==0 thencall PauseTimer(whichTimer)if GroupUnitCount(heroGroup)==1 thenset heroOwner=FirstOfGroup(heroGroup)loopexitwhen playerIndex>11if IsPlayerInForce(Player(playerIndex),targetForce)thencall ShowHeroChatMessageToPlayer(heroOwner,message,Player(playerIndex))endifset playerIndex=playerIndex+1endloopelsecall AnnounceHeroGroupMessageToForce(heroGroup,message,targetForce)endifcall DestroyGroup(heroGroup)call FlushChildHashtable(GameHashtable,dataKey)call DestroyTimer(whichTimer)elsecall SaveIntByStringKey(dataKey,"CountDn",LoadIntByStringKey(dataKey,"CountDn")-1)endifendifset heroGroup=nullset targetForce=nullendfunctionfunction QueueHeroChatForForce takes unit hero,force targetForce,string message returns nothinglocal force storedForce=nulllocal group ownerGroup=nulllocal timer whichTimer=nulllocal integer playerIndex=1local boolean canReuseQueue=truelocal boolean needTimer=falselocal integer dataKey=0if hero==null thenset hero=PlayerControlUnit[bj_forLoopAIndex]endifset dataKey=StringHash("cAI|Re"+message)set storedForce=LoadForceByTag(dataKey,"Target")if storedForce==null and message!=" " thenset needTimer=trueset storedForce=CopyPlayersIntoForce(targetForce,CreateForce())call StoreForceByName(dataKey,"Target",storedForce)set whichTimer=CreateTimer()call StoreStringByName(GetHandleId(whichTimer),"SubTag",message)set ownerGroup=CreateGroup()call GroupAddUnit(ownerGroup,hero)call StoreGroupByName(dataKey,"Owner",ownerGroup)elseif message==" " thenset canReuseQueue=falseelseset canReuseQueue=trueset playerIndex=1loopexitwhen playerIndex>11if IsPlayerInForce(Player(playerIndex),targetForce)thenif not IsPlayerInForce(Player(playerIndex),storedForce)thenset canReuseQueue=falseset playerIndex=11endifendifset playerIndex=playerIndex+1endloopendifif canReuseQueue thenset ownerGroup=GetGroupByName(dataKey,"Owner")call GroupAddUnit(ownerGroup,hero)elseset needTimer=trueset whichTimer=CreateTimer()set dataKey=GetHandleId(whichTimer)call StoreStringByName(dataKey,"SubTag",message)set storedForce=CopyPlayersIntoForce(targetForce,CreateForce())call StoreForceByName(dataKey,"Target",storedForce)call StoreUnitByName(dataKey,"Owner",hero)call StoreBooleanByName(dataKey,"Personal",true)endifendifif needTimer thenif message==" " thencall TimerStart(whichTimer,.1,false,function DispatchQueuedChatOnTimer)elsecall TimerStart(whichTimer,.01,true,function DispatchQueuedChatOnTimer)endifendifset storedForce=nullset ownerGroup=nullendfunctionfunction PingMinimapForForceMembers takes force targetForce,real pingX,real pingY,integer playerId returns nothingif(IsPlayerInForce(GetLocalPlayer(),targetForce))thenif GetAllyColorFilterState()==2 thencall PingMinimapEx(pingX,pingY,5.,48,230,185,true)elsecall PingMinimapEx(pingX,pingY,5.,PlayerColorRed[playerId],PlayerColorGreen[playerId],PlayerColorBlue[playerId],true)endifendifendfunctionfunction PingUnitOrFountainForForce takes unit whichUnit,force targetForce returns nothingif whichUnit!=null thenif GetUnitState(whichUnit,UNIT_STATE_LIFE)>0 thenif(IsPlayerInForce(GetLocalPlayer(),targetForce))thencall PingMinimap(GetUnitX(whichUnit),GetUnitY(whichUnit),5.)endifelseif IsUnitAlly(whichUnit,SentinelPlayer[0])thenset whichUnit=SentinelBaseStructureelseset whichUnit=ScourgeFountainendifif(IsPlayerInForce(GetLocalPlayer(),targetForce))thencall PingMinimap(GetUnitX(whichUnit),GetUnitY(whichUnit),5.)endifendifendifendfunctionfunction AlertNearbyAlliesAndPing takes unit hero,string message returns nothinglocal integer playerIndex=1local real distanceset SinglePlayerForce=CreateForce()loopexitwhen playerIndex>11if playerIndex==6 thenset playerIndex=7endifif IsUnitAlly(hero,Player(playerIndex))thenif TrackedSideUnit[playerIndex]==null or GetWidgetLife(TrackedSideUnit[playerIndex])<.405 thencall ForceAddPlayer(SinglePlayerForce,Player(playerIndex))elseset distance=DistanceBetweenWidgets(hero,TrackedSideUnit[playerIndex])if distance<=3000. thencall ForceAddPlayer(SinglePlayerForce,Player(playerIndex))endifendifendifset playerIndex=playerIndex+1endloopcall QueueHeroChatForForce(hero,SinglePlayerForce,message)call PingUnitOrFountainForForce(hero,SinglePlayerForce)call DestroyForce(SinglePlayerForce)set SinglePlayerForce=nullendfunctionfunction UseActivationItemsThenOrder takes unit hero returns nothingif((UnitHasItemOfType_2(hero,ItemTypeId[ItemIndexCost800]))and(UnitUseItem(hero,bj_lastCreatedItem)))thencall PolledWait_2(.3)endifif((UnitHasItemOfType_2(hero,ItemTypeId[ItemIndexCost2300]))and(UnitUseItem(hero,bj_lastCreatedItem)))thencall PolledWait_2(.3)endifif((UnitHasItemOfType_2(hero,ItemTypeId[ItemIndexRecipeA]))and(UnitUseItem(hero,bj_lastCreatedItem)))thencall PolledWait_2(.3)endifcall IssueImmediateOrderById(hero,851972)endfunctionfunction FilterAllyBuildingTarget takes nothing returns booleanreturn(IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)and GetUnitState(GetFilterUnit(),UNIT_STATE_LIFE)>0 and GetUnitAbilityLevel(GetFilterUnit(),'Asud')==0 and IsUnitAlly(GetFilterUnit(),GetOwningPlayer(bj_lastLoadedUnit)) and GetUnitTypeId(GetFilterUnit())!='u00S' and GetUnitTypeId(GetFilterUnit())!='ncop' and IsUnitType(GetFilterUnit(),UNIT_TYPE_ANCIENT)==false)endfunctionfunction AttemptTeleportOrBlinkToTarget takes unit hero,unit target returns booleanlocal item whichItem=nulllocal boolean canBuyItem=falselocal item purchasedItem=nulllocal integer playerId=GetPlayerId(GetOwningPlayer(hero))local boolean isComputer=(GetPlayerController(GetOwningPlayer(hero))==MAP_CONTROL_COMPUTER)local boolean itemUsed=falselocal boolean canTeleportToTarget=falselocal real angle=0local real targetX=0local real targetY=0if GetUnitByName((GetHandleId(hero)),"AI|TetherSource")!=null thenreturn falseelseif(GetUnitTypeId(hero)=='H00J')thenreturn falseendifif(target==SentinelBaseStructure or target==ScourgeFountain)thenif AiSlotBoolFlagG0[352+playerId]or(DistanceBetweenWidgets(hero,target)<3000)thenreturn falseendifelseif(DistanceBetweenWidgets(hero,target)<2000)thenreturn falseendifif target==SentinelBaseStructure or target==ScourgeFountain thenset targetX=GetUnitX(target)set targetY=GetUnitY(target)elseset bj_lastLoadedUnit=GetSideBaseUnitG8(hero)set angle=Atan2(GetUnitY(bj_lastLoadedUnit)-GetUnitY(target),GetUnitX(bj_lastLoadedUnit)-GetUnitX(target))+GetRandomReal(-AiAimSpreadRadians,AiAimSpreadRadians)set targetX=GetUnitX(target)+500.*Cos(angle)set targetY=GetUnitY(target)+500.*Sin(angle)endifif((GetUnitAbilityLevel(hero,'A01O')>0)and(ElapsedGameSeconds>AiAbilityNextCastTime[32+playerId]))thenif IssuePointOrderById(hero,852525,targetX,targetY)thenreturn trueendifendifif((GetUnitAbilityLevel(hero,'A0R0')>0)and(ElapsedGameSeconds>AiAbilityNextCastTime[playerId]))thenif IssuePointOrderById(hero,852600,targetX,targetY)thenreturn trueendifendifif not(PlayerLaneRole[224+playerId]<R2I(ElapsedGameSeconds)and GetUnitState(hero,UNIT_STATE_MANA)>MinManaForItemUse)thenreturn falseendifif not IsUnitType(target,UNIT_TYPE_STRUCTURE)thenset bj_lastLoadedUnit=heroset bj_lastLoadedUnit=FirstUnitInRangeOfLoc(2000.,WidgetPositionLoc(target),Condition(function FilterAllyBuildingTarget))set canTeleportToTarget=((bj_lastLoadedUnit!=null)and(DistanceBetweenWidgets(hero,target)>DistanceBetweenWidgets(bj_lastLoadedUnit,target)))elseset canTeleportToTarget=trueendifif(isComputer and HasTempDefensiveItem[playerId])thenif(UnitHasItemOfType_2(hero,GetItemTypeId(TempDefensiveItem[playerId])))thencall DisableTrigger(ToggleableTrigger)call UnitRemoveItem(hero,UnitItemOfType(hero,GetItemTypeId(TempDefensiveItem[playerId])))call RemoveItem(TempDefensiveItem[playerId])call EnableTrigger(ToggleableTrigger)endifif(SavedInventorySlotItem[playerId]!=null)thencall PolledWait_2(.2)call UnitAddItem(hero,SavedInventorySlotItem[playerId])endifset HasTempDefensiveItem[playerId]=falseset TempDefensiveItem[playerId]=nullset SavedInventorySlotItem[playerId]=nullendifif(UnitHasItemOfType_2(hero,ItemTypeId[ItemIndexGold100PointUse]))and canTeleportToTarget thenif((GetUnitAbilityLevel(hero,'B07T')==0)and(GetUnitAbilityLevel(hero,'B068')==0)and(GetUnitAbilityLevel(hero,'B00K')==0)and(GetUnitAbilityLevel(hero,'B039')==0))thencall UseActivationItemsThenOrder(hero)set itemUsed=UnitUseItemPoint(hero,UnitItemOfType(hero,ItemTypeId[ItemIndexGold100PointUse]),targetX,targetY)endifelseif(UnitHasItemOfType_2(hero,ItemTypeId[ItemIndexCost2450]))thencall UseActivationItemsThenOrder(hero)set itemUsed=UnitUseItemPoint(hero,UnitItemOfType(hero,ItemTypeId[ItemIndexCost2450]),GetUnitX(target),GetUnitY(target))elseif(not PlayerAiFlag[playerId])thenif(GetUnitTypeId(hero)=='H00J' or IsUnitIllusion(hero))or(not canTeleportToTarget)thenreturn falseendifset canBuyItem=falseif((not IsInventoryFull(hero)))thenset canBuyItem=trueelseif(UnitHasItemOfType_2(hero,ItemTypeId[ItemIndexGold110]))thenset purchasedItem=bj_lastCreatedItemset canBuyItem=trueelseif(UnitHasItemOfType_2(hero,ItemTypeId[ItemIndexGold125]))thenset purchasedItem=bj_lastCreatedItemset canBuyItem=trueelseif(UnitHasItemOfType_2(hero,ItemTypeId[ItemIndexTruesight]))thenset purchasedItem=bj_lastCreatedItemset canBuyItem=trueelseif(UnitHasItemOfType_2(hero,ItemTypeId[ItemIndexGold50]))thenset purchasedItem=bj_lastCreatedItemset canBuyItem=trueelseif(UnitHasItemOfType_2(hero,ItemTypeId[ItemIndexGold150]))thenset purchasedItem=bj_lastCreatedItemset canBuyItem=trueendifif canBuyItem thenif purchasedItem!=null thencall RemoveItemSilently(purchasedItem)endifset whichItem=CreateItem(ItemTypeId[ItemIndexGold100PointUse],GetUnitX(hero),GetUnitY(hero))set canBuyItem=UnitAddItem(hero,whichItem)call PolledWait_2(.3)elseif(UnitHasItemOfType_2(hero,ItemTypeId[ItemIndexCost450A]))thenset TempSwappedItem[playerId]=bj_lastCreatedItemset canBuyItem=truecall DebugPrintGlobal("Air system get1")endifif canBuyItem thencall DisableTrigger(ToggleableTrigger)call UnitRemoveItem(hero,TempSwappedItem[playerId])call SetItemPosition(TempSwappedItem[playerId],9999,-9999)call EnableTrigger(ToggleableTrigger)set whichItem=CreateItem(ItemTypeId[ItemIndexGold100PointUse],GetUnitX(hero),GetUnitY(hero))set canBuyItem=UnitAddItem(hero,whichItem)set AiFlagVN[playerId]=truecall PolledWait_2(.3)endifendifset purchasedItem=nullif(not canBuyItem)thencall RemoveItemSilently(whichItem)call PolledWait_2(.2)if((not IsInventoryFull(hero)))thencall UnitAddItem(hero,TempSwappedItem[playerId])call DebugPrintGlobal("Air system return1")set AiFlagVN[playerId]=falseset TempSwappedItem[playerId]=nullendifendifif(UnitHasItemOfType_2(hero,ItemTypeId[ItemIndexGold100PointUse]))thencall UseActivationItemsThenOrder(hero)set canBuyItem=UnitUseItemPoint(hero,UnitItemOfType(hero,ItemTypeId[ItemIndexGold100PointUse]),targetX,targetY)call PolledWait_2(.5)set whichItem=nullset itemUsed=canBuyItemif not itemUsed thencall PolledWait_2(.01)set itemUsed=(PlayerLaneRole[224+playerId]>R2I(ElapsedGameSeconds)+1)endifendifendifif itemUsed thenset PlayerLaneRole[224+playerId]=R2I(ElapsedGameSeconds)+ManaItemDelaySecondsset PlayerLaneRole[208+playerId]=0set AiAssignedUnit[144+playerId]=nullelseif not canBuyItem thenset PlayerLaneRole[208+playerId]=0set AiAssignedUnit[144+playerId]=nullendifif TempSwappedItem[playerId]!=null thencall DisableTrigger(ToggleableTrigger)call RemoveItem(UnitItemOfType(hero,ItemTypeId[ItemIndexGold100PointUse]))call UnitAddItem(hero,TempSwappedItem[playerId])call EnableTrigger(ToggleableTrigger)call DebugPrintGlobal("Air system return1")set TempSwappedItem[playerId]=nullset AiFlagVN[playerId]=falseendifendifreturn itemUsedendfunctionfunction CommandHeroRetreat takes unit hero,boolean forceRetreat returns nothinglocal integer playerId=GetPlayerId(GetOwningPlayer(hero))local real nearbyEnemyCount=.0if((not IsSlotTargetFinishable(playerId))or(forceRetreat))thenif(GetUnitTypeId(hero)!='H00J')thenset AiSlotBoolFlagG0[32+playerId]=trueif(not AiSlotBoolFlagGZ[160+playerId])and(GetUnitLifePercent(hero)<25)thenif IsTestBuildEnabled thencall AlertNearbyAlliesAndPing(hero,DebugContextLabel+" Retreating")elsecall AlertNearbyAlliesAndPing(hero,"Retreating")endifendifset AiPrimaryTargetUnit[playerId]=nullset AiPlayerTimeThreshold[512+playerId]=.0set AiSlotBoolFlagGZ[128+playerId]=falseset AiSlotBoolFlagGZ[160+playerId]=trueendifif(IsUnitOrderInterruptible(hero)and GetUnitAbilityLevel(hero,'A0IH')<1)thencall IssueSurroundPointOrder(hero,851986,AiSurroundTargetUnit[playerId])if(UnitHasItemOfType_2(hero,ItemTypeId[ItemIndexCost2800_2]))thencall UnitUseItem(hero,bj_lastCreatedItem)endifelseif IsUnitOrderInterruptible(hero)and GetUnitAbilityLevel(hero,'A0IH')>=1 thenset AiScanSourceUnit=heroset nearbyEnemyCount=CountUnitsInRangeOfUnit(700,hero,Condition(function FilterTargetableEnemyHeroForTI7))if nearbyEnemyCount<2 and GetWidgetLife(hero)>500. thencall AttemptTeleportOrBlinkToTarget(hero,SelectUnitByFlag(IsUnitAlly(hero,SentinelPlayer[0]),SentinelBaseStructure,ScourgeFountain))elsecall IssueImmediateOrderById(hero,851993)endifendifendifendfunctionfunction UnitHasAnyPursuitBuff takes unit whichUnit returns booleanreturn((GetUnitAbilityLevel(whichUnit,'B07T')>0)or(GetUnitAbilityLevel(whichUnit,'B076')>0)or(GetUnitAbilityLevel(whichUnit,'B068')>0)or(GetUnitAbilityLevel(whichUnit,'BHfs')>0)or(GetUnitAbilityLevel(whichUnit,'B00K')>0)or(GetUnitAbilityLevel(whichUnit,'B021')>0)or(GetUnitAbilityLevel(whichUnit,'B01Q')>0)or(GetUnitAbilityLevel(whichUnit,'B039')>0)or(GetUnitAbilityLevel(whichUnit,'A00J')>0)or(GetUnitAbilityLevel(whichUnit,'A0KT')>0)or(GetUnitAbilityLevel(whichUnit,'A021')>0)or(GetUnitAbilityLevel(whichUnit,'BOwk')>0))endfunctionfunction GetTeamTagOfUnit takes unit whichUnit returns stringif(IsUnitAlly(whichUnit,SentinelPlayer[0]))thenreturn"Sent"elsereturn"Scrg"endifendfunctionfunction AiPursueTargetWithItemsCallback takes nothing returns booleanlocal integer playerId=LoadIntByStringKey(GetHandleId(GetTriggeringTrigger()),"pID")local integer targetPlayerId=GetPlayerId(GetOwningPlayer(AiPrimaryTargetUnit[playerId]))if(GetWidgetLife(TrackedSideUnit[playerId])<.405)or(ElapsedGameSeconds>AiPlayerTimeThreshold[608+playerId])or(AiPrimaryTargetUnit[playerId]==null)or(GetWidgetLife(AiPrimaryTargetUnit[playerId])<.405)or(PlayerLaneRole[32+targetPlayerId]<=0)thencall DisableTrigger(GetTriggeringTrigger())return falseelseif(IsUnitVisible(AiPrimaryTargetUnit[playerId],Player(playerId)))thenif IsUnitExecutingOrderExt(TrackedSideUnit[playerId])thencall IssueTargetOrderById(TrackedSideUnit[playerId],851983,AiPrimaryTargetUnit[playerId])endifcall DisableTrigger(GetTriggeringTrigger())return falseendifif IsUnitOrderInterruptible(TrackedSideUnit[playerId])thenif(((IsVisibleToPlayer(GetUnitX(AiPrimaryTargetUnit[playerId]),GetUnitY(AiPrimaryTargetUnit[playerId]),Player(playerId)))and(not IsUnitHidden(AiPrimaryTargetUnit[playerId])))or((PlayerLaneRole[32+targetPlayerId]<2)and(UnitHasAnyPursuitBuff(AiPrimaryTargetUnit[playerId]))))thenif(UnitHasItemOfType_2(TrackedSideUnit[playerId],ItemTypeId[ItemIndexCost5200]))thencall UnitUseItem(TrackedSideUnit[playerId],bj_lastCreatedItem)elseif(UnitHasItemOfType_2(TrackedSideUnit[playerId],ItemTypeId[ItemIndexGold180]))and(DistanceBetweenWidgets(TrackedSideUnit[playerId],AiPrimaryTargetUnit[playerId])<=600)thencall UnitUseItem(TrackedSideUnit[playerId],bj_lastCreatedItem)elseif(UnitHasItemOfType_2(TrackedSideUnit[playerId],ItemTypeId[ItemIndexTruesight]))and((GetUnitX(AiPrimaryTargetUnit[playerId])!=0)or(GetUnitY(AiPrimaryTargetUnit[playerId])!=0))thencall UnitUseItemPoint(TrackedSideUnit[playerId],bj_lastCreatedItem,GetUnitX(AiPrimaryTargetUnit[playerId]),GetUnitY(AiPrimaryTargetUnit[playerId]))elseif(not GetBooleanByName(AiGameCacheKey,GetTeamTagOfUnit(TrackedSideUnit[playerId])+"|W"))thencall StoreBooleanByName(AiGameCacheKey,GetTeamTagOfUnit(TrackedSideUnit[playerId])+"|W",true)endifcall DisableTrigger(GetTriggeringTrigger())return falseendifendifif PlayerLaneRole[464+targetPlayerId]==851986 or PlayerLaneRole[464+targetPlayerId]==851971 or PlayerLaneRole[464+targetPlayerId]==851990 thencall IssuePointOrderById(TrackedSideUnit[playerId],851986,I2R(PlayerLaneRole[480+targetPlayerId]),I2R(PlayerLaneRole[496+targetPlayerId]))elsecall IssueSurroundPointOrder(TrackedSideUnit[playerId],851986,AiPrimaryTargetUnit[playerId])endifendifreturn falseendfunctionfunction AiIssueHeroCombatOrder takes unit hero,boolean aggressive returns nothinglocal integer playerId=GetPlayerId(GetOwningPlayer(hero))local boolean orderIssued=falselocal real enemyHeroCount=.0if(GetUnitAbilityLevel(hero,'A0IH')>0)and CountUnitsInRangeOfUnit(900.,hero,Condition(function FilterEnemyAliveTower))==0 thenset AiScanSourceUnit=heroset enemyHeroCount=CountUnitsInRangeOfUnit(900,hero,Condition(function FilterTargetableEnemyHeroForTI7))set orderIssued=IsUnitOrderInterruptible(hero)and(enemyHeroCount>=2 or GetUnitLifePercent(hero)<=87. or GetWidgetLife(hero)<=700.)and IssueImmediateOrderById(hero,851993)returnendifif(IsHeroLowHealthOrMana(hero))thenif(aggressive)thenif(not IsSlotTargetFinishable(playerId))thencall CommandHeroRetreat(hero,true)elseif((IsUnitAliveAndValidTarget(AiPrimaryTargetUnit[playerId]))and(GetUnitAbilityLevel(AiPrimaryTargetUnit[playerId],'B02F')==0))thencall IssueTargetOrderById(hero,851983,AiPrimaryTargetUnit[playerId])endifelsecall CommandHeroRetreat(hero,false)endifelseif(AiSlotBoolFlagG0[272+playerId]or IsUnitOrderInterruptible(hero))and((aggressive)or(((not AiSlotBoolFlagGZ[128+playerId])or((GetUnitCurrentOrder(hero)!=851983)and(GetUnitCurrentOrder(hero)!=851993)))and(CanAICommandUnit(hero))))thenif((AiSlotBoolFlagG0[playerId])or(AiSlotBoolFlagG0[48+playerId])or(not AiSlotBoolFlagG0[128+playerId]))thenset orderIssued=IssueSurroundPointOrder(hero,851986,AiSurroundTargetUnit[playerId])endifif(AiPrimaryTargetUnit[96+playerId]!=null)and(GetUnitTypeId(AiPrimaryTargetUnit[96+playerId])=='u00S')thenset orderIssued=IssueTargetOrderById(hero,851983,AiPrimaryTargetUnit[96+playerId])endifif((not orderIssued)and(AiPrimaryTargetUnit[playerId]!=null)and(IsUnitAliveAndValidTarget(AiPrimaryTargetUnit[playerId]))and(GetUnitAbilityLevel(AiPrimaryTargetUnit[playerId],'B02F')==0))thenif IsUnitVisible(AiPrimaryTargetUnit[playerId],GetOwningPlayer(hero))thenset bj_lastLoadedUnit=heroif GetBooleanByName(GetHandleId(AiPrimaryTargetUnit[playerId]),"XMarked")thencall MoveLocation(TempOrderLocation,GetRealByName(GetHandleId(AiPrimaryTargetUnit[playerId]),"AI|XMark|X"),GetRealByName(GetHandleId(AiPrimaryTargetUnit[playerId]),"AI|XMark|Y"))if(not IsUnitInRangeLoc(AiPrimaryTargetUnit[playerId],TempOrderLocation,600.))thenset orderIssued=IssuePointOrderByIdLoc(hero,851986,TempOrderLocation)elseset orderIssued=IssueTargetOrderById(hero,851983,AiPrimaryTargetUnit[playerId])endifelseif IsUnitStateFlagActive(hero,"AI|Lasso")thenset orderIssued=IssueTargetOrderById(hero,851986,AiSurroundTargetUnit[playerId])elseif(GetUnitTypeId(hero)=='Ekee' and GetHeroLevel(hero)>=6)and(PlayerLaneRole[320+playerId]>=0)and(not IsUnitInRange(hero,AiPrimaryTargetUnit[playerId],300))and((GetUnitLifePercent(hero)>80)or(GetUnitLifePercent(hero)>(GetUnitLifePercent(AiPrimaryTargetUnit[playerId])+30)))and(GetUnitManaPercent(hero)>20)and(AiPrimaryTargetUnit[304+playerId]==null)and(CountUnitsInRangeOfUnit(900,AiPrimaryTargetUnit[playerId],Condition(function IsEnemyTowerOrBuildingFilter))==0)thenset orderIssued=IssueTargetOrderById(hero,851986,AiPrimaryTargetUnit[playerId])elseset orderIssued=IssueTargetOrderById(hero,851983,AiPrimaryTargetUnit[playerId])endifset AiPlayerTimeThreshold[608+playerId]=ElapsedGameSeconds+AiTaskDelay10SecCelseif AiPlayerTimeThreshold[608+playerId]>ElapsedGameSeconds and PlayerLaneRole[32+GetPlayerId(GetOwningPlayer(AiPrimaryTargetUnit[playerId]))]>0 thenif not IsVisibleToPlayer(GetUnitX(AiPrimaryTargetUnit[playerId]),GetUnitY(AiPrimaryTargetUnit[playerId]),GetOwningPlayer(hero))thencall EnableTrigger(PerPlayerAiControlTrigger[96+playerId])set orderIssued=IssueSurroundPointOrder(hero,851986,AiPrimaryTargetUnit[playerId])endifelsecall DisableTrigger(PerPlayerAiControlTrigger[96+playerId])endifendifset TetherTargetUnit=LoadUnitHandle(GameHashtable,(GetHandleId(hero)),(652))set TetherSourceUnit=GetUnitByName((GetHandleId(hero)),"AI|TetherSource")if(orderIssued)thenelseif(TetherTargetUnit!=null)and(not IsUnitInRange(hero,TetherTargetUnit,700)and(IsUnitType(TetherTargetUnit,UNIT_TYPE_HERO)))thencall IssueSurroundPointOrder(hero,851986,TetherTargetUnit)elseif(TetherSourceUnit!=null)and(not IsUnitInRange(hero,TetherSourceUnit,700))thencall IssueSurroundPointOrder(hero,851986,TetherSourceUnit)elseif((PlayerLaneRole[playerId]>=9))thenif PlayerLaneRole[272+playerId]<=2 thenif((AiSlotBoolFlagG0[176+playerId])or(AiAssignedUnit[48+playerId]!=AiAssignedUnit[32+playerId]))thencall IssueSurroundPointOrder(hero,851983,AiAssignedUnit[48+playerId])elsecall IssueSurroundPointOrder(hero,851986,AiSurroundTargetUnit[playerId])endifendifelseif((PlayerLaneRole[playerId]==3)or(PlayerLaneRole[playerId]==4))thenelseif AiSlotBoolFlagGZ[160+playerId]or(not AiSlotBoolFlagG0[128+playerId])thencall IssueSurroundPointOrder(hero,851986,AiSurroundTargetUnit[playerId])elsecall IssueSurroundPointOrder(hero,851983,AiAssignedUnit[playerId])endifendifendfunctionfunction AiResumeCombatRestoreAbilityLogged takes integer playerId,unit hero,integer abilityId returns nothingcall LogDebugMessageToChannel(playerId,"AI disabled ability "+DebugContextLabel+" "+GetObjectName(abilityId))call DisableTrigger(PerPlayerAiControlTrigger[playerId])if((not IsHeroLowHealthOrMana(hero))and(not AiSlotBoolFlagG0[playerId])and(not AiSlotBoolFlagG0[64+playerId])and(AiSlotBoolFlagG0[128+playerId])and(AiPrimaryTargetUnit[playerId]!=null)and(IsUnitAliveAndValidTarget(AiPrimaryTargetUnit[playerId]))and(IsUnitVisible(AiPrimaryTargetUnit[playerId],GetOwningPlayer(hero))))thencall IssueTargetOrderById(hero,851983,AiPrimaryTargetUnit[playerId])set AiSlotBoolFlagGZ[48+playerId]=trueelsecall AiIssueHeroCombatOrder(hero,true)endifcall EnableTrigger(PerPlayerAiControlTrigger[playerId])if(abilityId!=0)thencall SetPlayerAbilityAvailable(GetOwningPlayer(hero),abilityId,not(GetPlayerController(Player(playerId))==MAP_CONTROL_COMPUTER))endifendfunctionfunction AiResumeCombatRestoreTwoAbilities takes integer playerId,unit hero,integer abilityId,integer secondAbilityId returns nothingcall AiResumeCombatRestoreAbilityLogged(playerId,hero,abilityId)call SetPlayerAbilityAvailable(GetOwningPlayer(hero),secondAbilityId,not((GetPlayerController(GetOwningPlayer(hero))==MAP_CONTROL_COMPUTER)))endfunctionfunction AiResumeCombatRestoreAbility takes integer playerId,unit hero,integer abilityId returns nothingcall DisableTrigger(PerPlayerAiControlTrigger[playerId])if((not IsHeroLowHealthOrMana(hero))and(not AiSlotBoolFlagG0[playerId])and(not AiSlotBoolFlagG0[64+playerId])and(AiSlotBoolFlagG0[128+playerId])and(AiPrimaryTargetUnit[playerId]!=null)and(IsUnitAliveAndValidTarget(AiPrimaryTargetUnit[playerId]))and(IsUnitVisible(AiPrimaryTargetUnit[playerId],GetOwningPlayer(hero))))thencall IssueTargetOrderById(hero,851983,AiPrimaryTargetUnit[playerId])set AiSlotBoolFlagGZ[48+playerId]=trueelsecall AiIssueHeroCombatOrder(hero,true)endifcall EnableTrigger(PerPlayerAiControlTrigger[playerId])call SetPlayerAbilityAvailable(GetOwningPlayer(hero),abilityId,not(GetPlayerController(GetOwningPlayer(hero))==MAP_CONTROL_COMPUTER))endfunctionfunction ClearAttackCommitAndReturn takes integer playerId,boolean result returns booleanset AiSlotBoolFlagGZ[playerId]=falsereturn resultendfunctionfunction IsUnitNearOwnFountain takes unit whichUnit returns booleanif(IsUnitAlly(whichUnit,SentinelPlayer[0]))thenreturn(IsUnitInRange(whichUnit,SentinelBaseStructure,1000.))elsereturn(IsUnitInRange(whichUnit,ScourgeFountain,1000.))endifendfunctionfunction IsUnitFartherFromBaseByMargin takes unit unitA,unit unitB,real margin returns booleanif(IsUnitAlly(unitB,SentinelPlayer[0]))thenreturn(DistanceBetweenWidgets(unitA,CandidateUnitByIndex[0])-DistanceBetweenWidgets(unitB,CandidateUnitByIndex[0]))>marginelsereturn(DistanceBetweenWidgets(unitA,CandidateUnitByIndex[100])-DistanceBetweenWidgets(unitB,CandidateUnitByIndex[100]))>marginendifendfunctionfunction CountEffectiveUnitsInGroup takes boolean includeOptional,group whichGroup returns integerlocal unit whichUnitlocal integer count=0local boolean sawOptionalUnit=falselocal boolean sawPrimaryUnit=falseloopset whichUnit=FirstOfGroup(whichGroup)exitwhen(whichUnit==null)if(GetUnitTypeId(whichUnit)=='H00I')thenset count=count+1set sawPrimaryUnit=trueelseif(GetUnitTypeId(whichUnit)!='H00J')thenset count=count+1elseif(not sawOptionalUnit)thenset sawOptionalUnit=trueendifcall GroupRemoveUnit(whichGroup,whichUnit)endloopif((sawOptionalUnit)and((not sawPrimaryUnit)or(includeOptional)))thenset count=count+1endifreturn countendfunctionfunction FindLastIndexOfSubstring takes string source,string target returns integerlocal integer index=StringLength(source)local integer minIndex=0loopexitwhen index<=minIndexif(SubString(source,index,index+1)==target)thenreturn indexendifset index=index-1endloopreturn-1endfunctionfunction IndexOfFirstComma takes string source returns integerlocal integer index=0local integer length=StringLength(source)loopexitwhen index>=lengthif(SubString(source,index,index+1)==",")thenreturn indexendifset index=index+1endloopreturn-1endfunctionfunction MarkDestructableFound takes nothing returns nothingset OffensiveSpellCastResult=falseendfunctionfunction IsAreaClearOfDestructables takes real centerX,real centerY returns booleanset OffensiveSpellCastResult=truecall SetRect(TempDestructableEnumRect,centerX-180.,centerY-180.,centerX+180.,centerY+180.)call EnumDestructablesInRect(TempDestructableEnumRect,NullBoolFilter,function MarkDestructableFound)return OffensiveSpellCastResultendfunctionfunction FindClearPointTowardUnit takes unit source,real distance,unit target returns locationlocal integer attempts=0local real angle=Atan2(GetUnitY(target)-GetUnitY(source),GetUnitX(target)-GetUnitX(source))loopif(IsAreaClearOfDestructables(GetUnitX(source)+distance*Cos(angle),GetUnitY(source)+distance*Sin(angle)))thencall MoveLocation(TempOffsetLocation,GetUnitX(source)+distance*Cos(angle),GetUnitY(source)+distance*Sin(angle))return TempOffsetLocationendifset attempts=attempts+1set distance=distance-50.exitwhen(attempts>5)endloopreturn nullendfunctionfunction FindClearPointAlongTargetHomeDirection takes unit whichUnit,unit target,real extraDistance returns locationlocal real distance=DistanceBetweenCoords(GetUnitX(whichUnit),GetUnitY(whichUnit),GetUnitX(target),GetUnitY(target))+extraDistancelocal real angle=0local integer attemptIndex=0set attemptIndex=GetPlayerId(GetOwningPlayer(target))set angle=Atan2(GetUnitY(AiSurroundTargetUnit[attemptIndex])-GetUnitY(target),GetUnitX(AiSurroundTargetUnit[attemptIndex])-GetUnitX(target))set attemptIndex=0loopif(IsAreaClearOfDestructables(GetUnitX(whichUnit)+distance*Cos(angle),GetUnitY(whichUnit)+distance*Sin(angle)))thencall MoveLocation(TempOffsetLocation,GetUnitX(whichUnit)+distance*Cos(angle),GetUnitY(whichUnit)+distance*Sin(angle))return TempOffsetLocationendifset attemptIndex=attemptIndex+1set distance=distance-50.exitwhen(attemptIndex>5)endloopreturn nullendfunctionfunction IsUnitTargetableNonLocust takes unit whichUnit returns booleanreturn((GetUnitAbilityLevel(whichUnit,'A04R')==0)and(GetUnitAbilityLevel(whichUnit,'Aloc')==0))endfunctionfunction IsUnitTargetableNonLocustNonWard takes unit whichUnit returns booleanreturn((GetUnitAbilityLevel(whichUnit,'A04R')==0)and(GetUnitAbilityLevel(whichUnit,'Aloc')==0)and(GetUnitTypeId(whichUnit)!='ushd')and(GetUnitTypeId(whichUnit)!='n01Q')and(GetUnitTypeId(whichUnit)!='n01R'))endfunctionfunction IsMeleeUnit takes unit whichUnit returns booleanreturn(IsUnitType(whichUnit,UNIT_TYPE_MELEE_ATTACKER))endfunctionfunction GetItemTypeOfOrderedSlot takes unit whichUnit returns integerreturn(GetItemTypeId(UnitItemInSlot(whichUnit,GetIssuedOrderId()-852008)))endfunctionfunction MatchesTrackedAbilityId takes integ