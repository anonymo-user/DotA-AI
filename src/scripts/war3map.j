x==ItemIndexCost470)thenreturn 6elseif(itemTypeIndex==ItemIndexCost600)or(itemTypeIndex==ItemIndexCost800)thenreturn 5elseif(itemTypeIndex==ItemIndexCost500)or(itemTypeIndex==ItemIndexCost450B)or(itemTypeIndex==ItemIndexCost450C)or(itemTypeIndex==ItemIndexCost450)or(itemTypeIndex==ItemIndexCost450D)or(itemTypeIndex==ItemIndexCost550)thenreturn 4elseif(itemTypeIndex==ItemIndexCost225Melee)or(itemTypeIndex==ItemIndexCost350)or(itemTypeIndex==ItemIndexCost325)or(itemTypeIndex==ItemIndexCost250A or itemTypeIndex==ItemIndexCost250B)thenreturn 3elseif(itemTypeIndex==ItemIndexCost165)or(itemTypeIndex==ItemIndexCost150A)or(itemTypeIndex==ItemIndexCost150B)or(itemTypeIndex==ItemIndexCost150)or(itemTypeIndex==ItemIndexCost200)thenreturn 2elseif(itemTypeIndex==ItemIndexGold50)or(itemTypeIndex==ItemIndexGold110)or(itemTypeIndex==ItemIndexGold125)or(itemTypeIndex==ItemIndexGold120)or(itemTypeIndex==ItemIndexGold1000Recipe)or(itemTypeIndex==ItemIndexCost340)thenreturn 1elseif(itemTypeIndex==ItemIndexCost50)thenreturn 0elseif(itemTypeIndex>=ItemIndexCost200RangeStart and itemTypeIndex<=ItemIndexRangeEnd)thenreturn-1elseif(itemTypeIndex==ItemIndexCost775 or itemTypeIndex==ItemIndexGold775)or(itemTypeIndex==ItemIndexGold200A)or(itemTypeIndex==ItemIndexGold0)or(itemTypeIndex==ItemIndexUnclassifiedLB)or(itemTypeIndex==ItemIndexUnclassifiedW5)thenreturn-1endifreturn-1endfunctionfunction CountFreeOrLowPriorityInventorySlots takes integer playerId,unit heroUnit,boolean includeLowPriority returns integerlocal integer slotIndex=0local integer freeCount=0local item slotItem=nullloopexitwhen slotIndex>5set slotItem=UnitItemInSlot(heroUnit,slotIndex)if slotItem==null thenset freeCount=freeCount+1elseif includeLowPriority thenif(GetAiItemPriorityScore(playerId,heroUnit,slotItem,FindItemTypeIndexAllTables(slotItem),false)<99)thenset freeCount=freeCount+1endifendifset slotIndex=slotIndex+1endloopset slotItem=nullreturn freeCountendfunctionfunction AddItemToUnitHandlingPowerup takes integer playerId,unit whichUnit,item whichItem,integer itemTypeIndex returns booleanif(IsItemPowerup(whichItem))thenif itemTypeIndex==0 thenset itemTypeIndex=FindItemTypeIndexAllTables(whichItem)endifset bj_lastCreatedItem=CreateItem(ItemTypeId[itemTypeIndex],GetUnitX(whichUnit),GetUnitY(whichUnit))call SetItemVisible(bj_lastCreatedItem,ItemHiddenVisibility)call SetItemPlayer(bj_lastCreatedItem,Player(playerId),false)call SetItemCharges(bj_lastCreatedItem,GetItemCharges(whichItem))call RemoveItem(whichItem)set whichItem=bj_lastCreatedItemendifset TempFilterBool=UnitAddItem(whichUnit,whichItem)return TempFilterBoolendfunctionfunction EnumGiveOwnedItemToUnit takes nothing returns nothinglocal item enumItem=GetEnumItem()local unit controlUnit=TempControlUnitlocal player owner=GetOwningPlayer(controlUnit)local integer playerId=GetPlayerId(owner)if GetWidgetLife(enumItem)>0 and GetItemPlayer(enumItem)==owner thencall SetItemPosition(enumItem,PlayerControlUnitX[playerId],PlayerControlUnitY[playerId])call SetItemVisible(enumItem,ItemHiddenVisibility)call AddItemToUnitHandlingPowerup(playerId,PlayerControlUnit[playerId],enumItem,0)endifset enumItem=nullset controlUnit=nullset owner=nullendfunctionfunction FilterUnitInSetAOrB takes nothing returns booleanreturn IsUnitTypeInSetA(GetFilterUnit())or IsUnitTypeInSetB(GetFilterUnit())endfunctionfunction ConsolidatePlayerItemsToStash takes integer playerId returns nothinglocal integer slotIndex=0local unit whichUnit=nulllocal item slotItem=nullcall GroupEnumUnitsInRange(UnitCountEnumGroup,GetUnitX(PlayerControlUnit[32+playerId]),GetUnitY(PlayerControlUnit[32+playerId]),1300,Condition(function FilterUnitInSetAOrB))loopset whichUnit=FirstOfGroup(UnitCountEnumGroup)exitwhen whichUnit==nullcall GroupRemoveUnit(UnitCountEnumGroup,whichUnit)set slotIndex=0loopexitwhen slotIndex>5set slotItem=UnitItemInSlot(whichUnit,slotIndex)if slotItem!=null and GetItemPlayer(slotItem)==Player(playerId)thencall UnitRemoveItem(whichUnit,slotItem)call SetItemPosition(slotItem,PlayerControlUnitX[playerId],PlayerControlUnitY[playerId])if not UnitAddItem(PlayerControlUnit[32+playerId],slotItem)thencall SetItemVisible(slotItem,ItemHiddenVisibility)endifendifset slotIndex=slotIndex+1endloopendloopset TempControlUnit=PlayerControlUnit[32+playerId]if IsPlayerAlly(Player(playerId),SentinelPlayer[0])thencall EnumItemsInRect(TeamOneStashRect,Condition(function FilterAlwaysTrue),function EnumGiveOwnedItemToUnit)elsecall EnumItemsInRect(TeamTwoStashRect,Condition(function FilterAlwaysTrue),function EnumGiveOwnedItemToUnit)endifset whichUnit=nullset slotItem=nullendfunctionfunction SetPlayerItemCacheUserData takes integer playerId,integer userDataValue returns nothinglocal integer slotIndexset slotIndex=0loopexitwhen slotIndex>23if HeroInventoryItem[playerId*24+slotIndex]!=null thencall SetItemUserData(HeroInventoryItem[playerId*24+slotIndex],userDataValue)endifset slotIndex=slotIndex+1endloopendfunctionfunction AiReinitItemInventoryState takes nothing returns nothinglocal integer slotIndexlocal integer freeSlotCountlocal integer tempIndexlocal unit heroUnit=UnitParamSlotlocal integer playerId=PlayerIndexParamif heroUnit==null thenset heroUnit=TrackedSideUnit[playerId]endifif(IsDebugMode)thenset slotIndex=0set ScratchString="aiReinitA "loopexitwhen slotIndex>PlayerItemStateData[128+playerId]if HeroInventoryItem[playerId*24+slotIndex]!=null thenset ScratchString=ScratchString+IntToStringSpaced(slotIndex)+GetItemName(HeroInventoryItem[playerId*24+slotIndex])+"# "endifset slotIndex=slotIndex+1endloopendifset slotIndex=12set freeSlotCount=CountFreeOrLowPriorityInventorySlots(playerId,PlayerControlUnit[32+playerId],false)set PlayerLaneRole[512+playerId]=1loopexitwhen(slotIndex>=PlayerItemStateData[128+playerId])or(freeSlotCount<=0)if(HeroInventoryItem[playerId*24+slotIndex]!=null)thenif(GetWidgetLife(HeroInventoryItem[playerId*24+slotIndex])>0)and(not IsItemOwned(HeroInventoryItem[playerId*24+slotIndex]))thencall AddItemToUnitHandlingPowerup(playerId,PlayerControlUnit[32+playerId],HeroInventoryItem[playerId*24+slotIndex],HeroItemTypeIndex[playerId*24+slotIndex])set freeSlotCount=freeSlotCount-1endifset HeroInventoryItem[playerId*24+slotIndex]=nullendifset slotIndex=slotIndex+1endloopset slotIndex=0loopexitwhen slotIndex>5set HeroInventoryItem[playerId*24+slotIndex]=UnitItemInSlot(heroUnit,slotIndex)set HeroItemTypeIndex[playerId*24+slotIndex]=FindItemTypeIndexAllTables(HeroInventoryItem[playerId*24+slotIndex])if(HeroInventoryItem[304+playerId]==null or GetWidgetLife(HeroInventoryItem[304+playerId])<=0 or HeroItemTypeIndex[playerId*24+slotIndex]==ItemIndexCost2450)and(HeroItemTypeIndex[playerId*24+slotIndex]==ItemIndexCost450A or HeroItemTypeIndex[playerId*24+slotIndex]==ItemIndexCost1400B or HeroItemTypeIndex[playerId*24+slotIndex]==ItemIndexCost1400C or HeroItemTypeIndex[playerId*24+slotIndex]==ItemIndexCost1400D or HeroItemTypeIndex[playerId*24+slotIndex]==ItemIndexCost1350 or HeroItemTypeIndex[playerId*24+slotIndex]==ItemIndexGold1000A or HeroItemTypeIndex[playerId*24+slotIndex]==ItemIndexGold1000B or HeroItemTypeIndex[playerId*24+slotIndex]==ItemIndexCost1450 or HeroItemTypeIndex[playerId*24+slotIndex]==ItemIndexCost2450)and(IsUnitType(heroUnit,UNIT_TYPE_HERO))thenset HeroInventoryItem[304+playerId]=HeroInventoryItem[playerId*24+slotIndex]set HeroItemTypeIndex[304+playerId]=HeroItemTypeIndex[playerId*24+slotIndex]endifset HeroInventoryItem[playerId*24+6+slotIndex]=UnitItemInSlot(PlayerControlUnit[32+playerId],slotIndex)set HeroItemTypeIndex[playerId*24+6+slotIndex]=FindItemTypeIndexAllTables(HeroInventoryItem[playerId*24+6+slotIndex])set slotIndex=slotIndex+1endloopset slotIndex=12set freeSlotCount=12loopexitwhen slotIndex>23if HeroInventoryItem[playerId*24+slotIndex]!=null thenif slotIndex!=freeSlotCount thenset HeroInventoryItem[playe