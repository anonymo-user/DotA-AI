n0HB')))+" "+GetObjectName(GetLearnedSkill())+" ("+(GetObjectName(('n0HC')))+" "+I2S(GetUnitAbilityLevel(GetTriggerUnit(),GetLearnedSkill()))+")"call DisplayTimedTextToPlayer(ViewModePlayerLeft,0,0,3,message)call DisplayTimedTextToPlayer(ViewModePlayerRight,0,0,3,message)endifreturn falseendfunctionfunction RegisterHeroSkillLearnTrigger takes nothing returns nothinglocal trigger whichTrigger=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(whichTrigger,EVENT_PLAYER_HERO_SKILL)call TriggerAddCondition(whichTrigger,Condition(function AnnounceHeroSkillLearn))set whichTrigger=nullendfunctionfunction BroadcastPlayerLeaveNotice takes nothing returns nothingcall DisplayTimedTextToForceMembers(bj_FORCE_ALL_PLAYERS,25.,(PlayerName[GetPlayerId((GetTriggerPlayer()))])+"|c00ff0303 "+(GetObjectName(('n02D')))+"|r")endfunctionfunction DistributeLeaverGoldTick takes nothing returns booleanlocal trigger triggeringTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(triggeringTrigger)local player leaverPlayer=(LoadPlayerHandle(GameHashtable,(handleId),(78)))local integer slotIndex=1local integer teammateCountlocal integer leaverGold=GetPlayerState(leaverPlayer,PLAYER_STATE_RESOURCE_GOLD)if leaverGold>20 thencall SetPlayerState(leaverPlayer,PLAYER_STATE_RESOURCE_GOLD,0)set PlayerMinGold[GetPlayerId(leaverPlayer)]=0if IsPlayerOnTeamZero(leaverPlayer)thenset teammateCount=CountForcePlayersPassingFilter(TeamOneForce)elseset teammateCount=CountForcePlayersPassingFilter(TeamTwoForce)endifif IsPlayerOnTeamZero(leaverPlayer)thenloopexitwhen slotIndex>5if IsPlayerSlotActive(SentinelPlayer[slotIndex])thencall SetPlayerState(SentinelPlayer[slotIndex],PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(SentinelPlayer[slotIndex],PLAYER_STATE_RESOURCE_GOLD)+leaverGold/teammateCount)endifset slotIndex=slotIndex+1endloopelseloopexitwhen slotIndex>5if IsPlayerSlotActive(ScourgePlayer[slotIndex])thencall SetPlayerState(ScourgePlayer[slotIndex],PLAYER_S