rCode+GetObjectName('n0EY'))call MultiboardSetItemWidth(boardItem,.035)call MultiboardReleaseItem(boardItem)set currentRow=maxSlot-1set boardItem=MultiboardGetItem(ScoreboardMultiboard_3,column,currentRow)call MultiboardSetItemStyle(boardItem,true,false)if TimerGetElapsed(GameClockTimer)<15 thencall MultiboardSetItemValue(boardItem,GrayTextColorCode+GetObjectName('n0F1'))elseif TeamDisplayMode==2 thencall MultiboardSetItemValue(boardItem,GetObjectName('n0F4'))elseif TeamDisplayMode==1 thencall MultiboardSetItemValue(boardItem,GrayTextColorCode+GetObjectName('n0F1'))elsecall MultiboardSetItemValue(boardItem,GrayTextColorCode+GetObjectName('n0F2'))endifcall MultiboardSetItemWidth(boardItem,.035)call MultiboardReleaseItem(boardItem)return falseendfunctionfunction CreateItemMultiboardWithTimer takes nothing returns nothinglocal integer rowCount=12local integer columnCount=14local trigger refreshTrigger=CreateTrigger()local integer columnIndexlocal multiboarditem boardItemcall TriggerRegisterTimerEvent(refreshTrigger,.5,true)call TriggerAddCondition(refreshTrigger,Condition(function OnTimerRefreshItemMultiboard))set ScoreboardMultiboard_3=CreateMultiboard()call MultiboardSetItemsWidth(ScoreboardMultiboard_3,.015)call MultiboardSetRowCount(ScoreboardMultiboard_3,rowCount)call MultiboardSetColumnCount(ScoreboardMultiboard_3,columnCount)call MultiboardSetTitleText(ScoreboardMultiboard_3,GetObjectName('n0K6'))call MultiboardSetItemsStyle(ScoreboardMultiboard_3,false,false)call MultiboardMinimize(ScoreboardMultiboard_3,false)call MultiboardDisplay(ScoreboardMultiboard_3,true)set columnIndex=0loopexitwhen columnIndex>columnCountset boardItem=MultiboardGetItem(ScoreboardMultiboard_3,0,columnIndex)call MultiboardSetItemWidth(boardItem,.015)call MultiboardReleaseItem(boardItem)set columnIndex=columnIndex+1endloopset refreshTrigger=nullset boardItem=nullendfunctionfunction OnPickUnitSoldCreateHero takes nothing returns booleanlocal unit soldUnit=GetSoldUnit()local player owner=GetOwningPlayer(soldUnit)local integer heroTypeIdlocal real spawnXlocal real spawnYlocal real facingif GetUnitTypeId(soldUnit)=='h06N' and IsPlayerAlly(GetOwningPlayer(soldUnit),GetOwningPlayer(GetSellingUnit()))thenif TrackedSideUnit[GetPlayerId(owner)]!=null thencall ShowErrorMessageToPlayer(owner,GetObjectName('n0F3'))call KillUnit(soldUnit)set soldUnit=nullset owner=nullreturn falseendifset spawnX=GetUnitX(GetSellingUnit())set spawnY=GetUnitY(GetSellingUnit())set heroTypeId=LookupValueForKey(GetUnitTypeId(GetSellingUnit()))set facing=GetUnitFacing(GetSellingUnit())call RemoveUnit(GetSellingUnit())call CreateUnit(owner,heroTypeId,spawnX,spawnY,facing)endifif GetUnitTypeId(soldUnit)=='h06N' thencall KillUnit(soldUnit)endifif TrackedSideUnit[GetPlayerId(SentinelPlayer[1])]!=null and TrackedSideUnit[GetPlayerId(SentinelPlayer[2])]!=null and TrackedSideUnit[GetPlayerId(SentinelPlayer[3])]!=null and TrackedSideUnit[GetPlayerId(SentinelPlayer[4])]!=null and TrackedSideUnit[GetPlayerId(SentinelPlayer[5])]!=null and TrackedSideUnit[GetPlayerId(ScourgePlayer[1])]!=null and TrackedSideUnit[GetPlayerId(ScourgePlayer[2])]!=null and TrackedSideUnit[GetPlayerId(ScourgePlayer[3])]!=null and TrackedSideUnit[GetPlayerId(ScourgePlayer[4])]!=null and TrackedSideUnit[GetPlayerId(ScourgePlayer[5])]!=null thencall RecycleExpiringTrigger(GetTriggeringTrigger())endifset soldUnit=nullset owner=nullreturn falseendfunctionfunction ToggleScoreboardColumn15ForPlayer takes player whichPlayer,boolean forceEnable returns nothinglocal integer playerId=GetPlayerId(whichPlayer)local integer rowIndexlocal integer rowCountif not forceEnable thenset PlayerMultiboardToggle[64+playerId]=(not PlayerMultiboardToggle[64+playerId])call DisplayTimedTextToPlayer(whichPlayer,0,0,10.,GetObjectName('Y094')+SelectStringByFlag(PlayerMultiboardToggle[64+playerId],GetObjectName('Y1ON'),GetObjectName('YOOF')))if not PlayerMultiboardTog