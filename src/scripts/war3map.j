if IsUnitTypeInEitherSet(GetEnumUnit())and IsUnitAlly(GetEnumUnit(),SentinelPlayer[0])==false and GetUnitState(GetEnumUnit(),UNIT_STATE_LIFE)>.5 thencall UnitRemoveAbility(GetEnumUnit(),'B08H')call DamageTargetByType(SentinelBaseStructure,GetEnumUnit(),DamageType2,500)endifendfunctionfunction EnumApplyEffectToEnemiesOfScourge takes nothing returns nothingif IsUnitTypeInEitherSet(GetEnumUnit())and IsUnitAlly(GetEnumUnit(),ScourgePlayer[0])==false and GetUnitState(GetEnumUnit(),UNIT_STATE_LIFE)>.5 thencall UnitRemoveAbility(GetEnumUnit(),'B08H')call DamageTargetByType(ScourgeFountain,GetEnumUnit(),DamageType2,500)endifendfunctionfunction ApplyEffectToEnemyHeroesInBases takes nothing returns booleanlocal group tempGroup=AcquireGroupFromPool()call GroupEnumUnitsInRect(tempGroup,TeamOneStashRect,Condition(function FilterAlwaysTrue))call ForGroup(tempGroup,function EnumApplyEffectToEnemiesOfSentinel)call ReleaseGroupToPool(tempGroup)set tempGroup=AcquireGroupFromPool()call GroupEnumUnitsInRect(tempGroup,TeamTwoStashRect,Condition(function FilterAlwaysTrue))call ForGroup(tempGroup,function EnumApplyEffectToEnemiesOfScourge)call ReleaseGroupToPool(tempGroup)set tempGroup=nullreturn falseendfunctionfunction UnitHasStunOrDisableBuff takes unit whichUnit returns booleanreturn(GetUnitAbilityLevel((whichUnit),('B00H'))>0)or(GetUnitAbilityLevel((whichUnit),('BOhx'))>0)or(GetUnitAbilityLevel((whichUnit),('BPSE'))>0)or(GetUnitAbilityLevel((whichUnit),('B099'))>0)or(GetUnitAbilityLevel((whichUnit),('BSTN'))>0)or(GetUnitAbilityLevel((whichUnit),('B0CF'))>0)or(GetUnitAbilityLevel((whichUnit),('B0BM'))>0)or(GetUnitAbilityLevel((whichUnit),('B06M'))>0)or(GetUnitAbilityLevel((whichUnit),('B07N'))>0)or(GetUnitAbilityLevel((whichUnit),('B08S'))>0)or(GetUnitAbilityLevel((whichUnit),('B00Q'))>0)or(GetUnitAbilityLevel((whichUnit),('B04V'))>0)or(GetUnitAbilityLevel((whichUnit),('B072'))>0)or(GetUnitAbilityLevel((whichUnit),('BUan'))>0)or(GetUnitAbilityLevel((whichUnit),('B095'))>0)or(GetUnitAbilityLevel((whichUnit),('B03I'))>0)or(GetUnitAbilityLevel((whichUnit),('B0AD'))>0)or(GetUnitAbilityLevel((whichUnit),('B0AE'))>0)or(GetUnitAbilityLevel((whichUnit),('B0BE'))>0)or(GetUnitAbilityLevel((whichUnit),('B0BF'))>0)or(GetUnitAbilityLevel((whichUnit),('B008'))>0)or(GetUnitAbilityLevel((whichUnit),('B04B'))>0)or(GetUnitAbilityLevel((whichUnit),('B02F'))>0)or(GetUnitAbilityLevel((whichUnit),('BUsp'))>0)or(GetUnitAbilityLevel((whichUnit),('BUst'))>0)or(GetUnitAbilityLevel((whichUnit),('B0DD'))>0)or((LoadInteger(GameHashtable,(GetHandleId((whichUnit))),((4293))))==1)==true or((LoadInteger(GameHashtable,(GetHandleId((whichUnit))),((4303))))==1)or(GetUnitAbilityLevel((whichUnit),('B0C2'))>0)or(GetUnitAbilityLevel((whichUnit),('B06S'))>0)or(GetUnitAbilityLevel((whichUnit),('B02S'))>0)or(GetUnitAbilityLevel((whichUnit),('B07E'))>0)endfunctionfunction IsUnitDisabled takes unit whichUnit returns booleanreturn UnitHasStunOrDisableBuff(whichUnit)or UnitHasAnyDisableDebuff(whichUnit)or IsUnitPaused(whichUnit)or IsUnitCycloned(whichUnit)endfunctionfunction IsUnitImmobilized takes unit whichUnit returns booleanreturn(IsUnitType(whichUnit,UNIT_TYPE_STUNNED)or IsUnitType(whichUnit,UNIT_TYPE_SNARED)or IsUnitType(whichUnit,UNIT_TYPE_POLYMORPHED)or GetUnitMoveSpeed(whichUnit)<290 or IsUnitPaused(whichUnit))or UnitHasStunOrDisableBuff(whichUnit)or UnitHasAnyDisableDebuff(whichUnit)endfunctionfunction SetAllPlayersLumberAndFood takes integer lumber,integer foodUsed,boolean extraColor returns nothinglocal integer playerIndex=0loopexitwhen playerIndex>15call SetPlayerState(Player(playerIndex),PLAYER_STATE_RESOURCE_LUMBER,lumber)call SetPlayerState(Player(playerIndex),PLAYER_STATE_RESOURCE_FOOD_USED,foodUsed)set playerIndex=playerIndex+1endloopendfunctionfunction IsUnitTypeInSetC takes unit whichUnit returns booleanlocal integer unitTypeId=GetUnitTypeId(whichUnit)return unitTypeId=='n027' or unitTypeId=='u014' or unitTypeId=='u015' or unitTypeId=='u016' or unitTypeId=='u01D' or unitTypeId=='u01E' or unitTypeId=='u01F' or unitTypeId=='u017' or unitTypeId=='u019' or unitTypeId=='u018' or unitTypeId=='u01A' or unitTypeId=='u01B' or unitTypeId=='u01C'endfunctionfunction SetUnitInvulnerableTracked takes unit whichUnit,boolean invulnerable returns nothingcall SetUnitInvulnerable(whichUnit,invulnerable)call SaveBoolean(GameHashtable,(GetHandleId(whichUnit)),(509),(invulnerable))endfunctionfunction IsUnitInvulnerableTracked takes unit whichUnit returns booleanreturn(LoadBoolean(GameHashtable,(GetHandleId(whichUnit)),(509)))or GetUnitAbilityLevel(whichUnit,'Avul')>0endfunctionfunction FindLocationOutsideRegion takes real originX,real originY returns locationlocal real testXlocal real testYlocal integer step=0loopexitwhen step>40set testX=originX+step*20set testY=originY+step*20if IsPointInRegion(PlayableMapRegion,testX,testY)==false thenreturn Location(testX,testY)endifset testX=originX+step*20set testY=originY-step*20if IsPointInRegion(PlayableMapRegion,testX,testY)==false thenreturn Location(testX,testY)endifset testX=originX-step*20set testY=originY+step*20if IsPointInRegion(PlayableMapRegion,testX,testY)==false thenreturn Location(testX,testY)endifset testX=originX-step*20set testY=originY-step*20if IsPointInRegion(PlayableMapRegion,testX,testY)==false thenreturn Location(testX,testY)endifset step=step+1endloopreturn Location(originX,originY)endfunctionfunction SetTieredAbilityLevel takes unit whichUnit,integer spellSlot,integer rank returns nothinglocal integer loopIndexif whichUnit==null or IsUnitDeadOrInvalid(whichUnit) thenreturnendifif Spell1RankAbilityId[1]==0 thenreturnendifset loopIndex=1loopexitwhen loopIndex>10call UnitRemoveAbility(whichUnit,Spell1RankAbilityId[loopIndex])set loopIndex=loopIndex+1endloopset loopIndex=1loopexitwhen loopIndex>10call UnitRemoveAbility(whichUnit,Spell2RankAbilityId[loopIndex])set loopIndex=loopIndex+1endloopset loopIndex=1loopexitwhen loopIndex>10call UnitRemoveAbility(whichUnit,Spell3RankAbilityId[loopIndex])set loopIndex=loopIndex+1endloopset loopIndex=1loopexitwhen loopIndex>10call UnitRemoveAbility(whichUnit,Spell4RankAbilityId[loopIndex])set loopIndex=loopIndex+1endloopcall UnitRemoveAbility(whichUnit,'B0BS')if spellSlot==1 thencall UnitAddAbility(whichUnit,Spell1RankAbilityId[rank])elseif spellSlot==2 thencall UnitAddAbility(whichUnit,Spell2RankAbilityId[rank])elseif spellSlot==3 thencall UnitAddAbility(whichUnit,Spell3RankAbilityId[rank])elseif spellSlot==4 thencall UnitAddAbility(whichUnit,Spell4RankAbilityId[rank])endifendfunctionfunction AddAbilityToRemovalList takes integer abilityId returns nothingset AbilityRemovalCount=AbilityRemovalCount+1set AbilityRemovalList[AbilityRemovalCount]=abilityIdendfunctionfunction RemoveRegisteredAbilities takes unit whichUnit returns nothinglocal integer abilityIndex=1loopexitwhen abilityIndex>AbilityRemovalCountcall UnitRemoveAbility(whichUnit,AbilityRemovalList[abilityIndex])set abilityIndex=abilityIndex+1endloopendfunctionfunction IsSpecialAbilityId_2 takes integer abilityId returns booleanreturn abilityId=='AIpg' or abilityId=='A02V' or abilityId=='ACpu' or abilityId=='A18D' or abilityId=='A1OU' or abilityId=='AIcy' or abilityId=='A1SA' or abilityId=='A2T2'endfunctionfunction StripUnitTierAbilities takes unit whichUnit returns nothingcall UnitRemoveAbility(whichUnit,'Aetl')call UnitRemoveAbility(whichUnit,'BHtc')call UnitRemoveAbility(whichUnit,'A1W3')call UnitRemoveAbility(whichUnit,'B0DO')call UnitRemoveAbility(whichUnit,'B02U')call SetTieredAbilityLevel(whichUnit,0,0)endfunctionfunction OnSpellCastHandleTarget takes nothing returns booleanif IsSpecialAbilityId_2(GetSpellAbilityId())thencall StripUnitTierAbilities(GetSpellTargetUnit())endifreturn falseendfunctionfunction ResolveRemappedIndex takes integer index returns integerif ItemMappingTarget[index]==0 thenreturn indexelsereturn ItemMappingTarget[index]endifendfunctionfunction UpdateGameClockDisplay takes nothing returns nothinglocal integer totalSeconds=R2I(TimerGetElapsed(GameClockTimer)-LastGameClockSnapshot)local integer minutes=totalSeconds/60-1/2local integer seconds=ModuloInteger(totalSeconds,60)if OneTimeInitFlag_2 thencall SetAllPlayersLumberAndFood(minutes,seconds,false)elseif HasAnnouncedFlag==false thenset totalSeconds=R2I(16-TimerGetElapsed(GameClockTimer))set minutes=totalSeconds/ 60-1/ 2set seconds=ModuloInteger(totalSeconds,60)call SetAllPlayersLumberAndFood(minutes,seconds,true)endifset ElapsedGameSeconds=R2I(TimerGetElapsed(GameClockTimer)-NextSecondSnapshot)set ClockMinutes=minutesset ClockSeconds=secondsif IsTestBuildEnabled thenset totalSeconds=0loopexitwhen totalSeconds>11set ChatLogWriteIndex[16+totalSeconds]=0set totalSeconds=totalSeconds+1endloopendifendfunctionfunction GetLearnedAbilityIndexForSlot takes unit whichUnit,integer slotNumber returns integerlocal integer abilityIndexif slotNumber==1 thenif GetUnitAbilityLevel(whichUnit,'A500')>0 thenreturn 500endifset abilityIndex=CachedLoopIndexloopexitwhen abilityIndex>HeroPoolLoopBoundCif GetUnitAbilityLevel(whichUnit,AbilityIdSetA[abilityIndex])>0 thenreturn abilityIndexendifset abilityIndex=abilityIndex+1endloopreturn 0elseif slotNumber==2 thenif GetUnitAbilityLevel(whichUnit,'A501')>0 thenreturn 500endifset abilityIndex=CachedLoopIndexloopexitwhen abilityIndex>HeroPoolLoopBoundCif GetUnitAbilityLevel(whichUnit,AbilityIdSetB[abilityIndex])>0 thenreturn abilityIndexendifset abilityIndex=abilityIndex+1endloopreturn 0elseif slotNumber==3 thenif GetUnitAbilityLevel(whichUnit,'A502')>0 thenreturn 500endifset abilityIndex=CachedLoopIndexloopexitwhen abilityIndex>HeroPoolLoopBoundCif GetUnitAbilityLevel(whichUnit,AbilityIdSetC[abilityIndex])>0 thenreturn abilityIndexendifset abilityIndex=abilityIndex+1endloopreturn 0elseif slotNumber==