+playerId]thenreturn GetObjectName('Y110')elseif AiPrimaryTargetUnit[playerId]!=null thenif useAltPhrasing thenreturn GetObjectName('Y122')+PlayerColorCode[GetPlayerId(GetOwningPlayer(AiPrimaryTargetUnit[playerId]))]+GetUnitHeroOrColorName(AiPrimaryTargetUnit[playerId])+"|r"elsereturn GetObjectName('Y121')+PlayerColorCode[GetPlayerId(GetOwningPlayer(AiPrimaryTargetUnit[playerId]))]+GetUnitHeroOrColorName(AiPrimaryTargetUnit[playerId])+"|r"endifelseif AiSurroundTargetUnit[64+playerId]!=null thenreturn GetObjectName('Y111')+GetRoleNameByIndex(PlayerLaneRole[80+playerId],false)elseif PlayerLaneRole[80+playerId]<=2 thenreturn GetObjectName('Y112')+GetRoleNameByIndex(PlayerLaneRole[80+playerId],false)elsereturn GetObjectName('Y112')endifelseif PlayerLaneRole[playerId]==2 thenreturn GetObjectName('Y113')elseif PlayerLaneRole[playerId]==3 thenreturn GetObjectName('Y114')+GetRoleNameByIndex(AiSelectionCountData[64+playerId],true)elseif PlayerLaneRole[playerId]==4 thenreturn GetObjectName('Y115')+GetRoleNameByIndex(AiSelectionCountData[64+playerId],true)elseif PlayerLaneRole[playerId]==9 thenif PlayerLaneRole[272+playerId]==0 thenreturn GetObjectName('Y116')+GetRoleNameByIndex(PlayerLaneRole[288+playerId],false)elseif AiAssignedUnit[96+playerId]!=null thenset bj_forLoopAIndex=GetPlayerId(GetOwningPlayer(AiAssignedUnit[96+playerId]))return GetObjectName('Y117')+PlayerColorCode[bj_forLoopAIndex]+I2S(bj_forLoopAIndex)+"|r"elsereturn GetObjectName('Y011')+GetRoleNameByIndex(PlayerLaneRole[288+playerId],false)endifelseif PlayerLaneRole[playerId]==10 thenreturn GetObjectName('Y118')elseif PlayerLaneRole[playerId]==11 thenif useAltPhrasing thenreturn GetObjectName('Y119')elsereturn GetObjectName('Y120')endifendifreturn" "endfunctionfunction UpdateScoreboardStats takes nothing returns nothinglocal integer rowIndexlocal integer playerCountlocal string statusTextcall SetMultiboardItemText(ScoreboardMultiboard,4,2,KillsColorCode+I2S(PlayerMultiboardStat[GetPlayerId(SentinelPlayer[0])])+"|r")call SetMultiboardItemText(ScoreboardMultiboard,5,2,DeathsColorCode+I2S(PlayerDeaths[GetPlayerId(SentinelPlayer[0])])+"|r")call SetMultiboardItemText(ScoreboardMultiboard,4,3+TeamOnePlayerCount_2,KillsColorCode+I2S(PlayerMultiboardStat[GetPlayerId(ScourgePlayer[0])])+"|r")call SetMultiboardItemText(ScoreboardMultiboard,5,3+TeamOnePlayerCount_2,DeathsColorCode+I2S(PlayerDeaths[GetPlayerId(ScourgePlayer[0])])+"|r")set rowIndex=1set playerCount=TeamOnePlayerCount_2loopexitwhen rowIndex>playerCountcall SetMultiboardItemText(ScoreboardMultiboard,4,(rowIndex+2),KillsColorCode+I2S(PlayerMultiboardStat[GetPlayerId(MultiboardTeamOnePlayer[rowIndex])])+"|r")call SetMultiboardItemText(ScoreboardMultiboard,5,(rowIndex+2),DeathsColorCode+I2S(PlayerDeaths[GetPlayerId(MultiboardTeamOnePlayer[rowIndex])])+"|r")call SetMultiboardItemText(ScoreboardMultiboard,6,(rowIndex+2),AssistsColorCode+I2S(PlayerAssistCount[GetPlayerId(MultiboardTeamOnePlayer[rowIndex])])+"|r")set statusText=GetAiStatusText(GetPlayerId(MultiboardTeamOnePlayer[rowIndex]),false)if MultiboardTeamOnePlayer[rowIndex]==PendingSwapPlayerA and(not IsDebugMode)thenset statusText=TempMenuLineTextendifif(not PlayerMultiboardToggle[32+GetPlayerId(GetLocalPlayer())])thenset statusText=" "elseif(not(IsPlayerAlly(GetLocalPlayer(),SentinelPlayer[0])or IsDebugMode))thenset statusText=" "endifcall SetMultiboardItemText(ScoreboardMultiboard,15,rowIndex+2,statusText)set statusText=" "if PlayerMultiboardToggle[80+GetPlayerId(GetLocalPlayer())]and IsPlayerPlayingComputer(MultiboardTeamOnePlayer[rowIndex])thenif GameModeFlagEU thenset statusText=ExperienceColorCode+"+"+I2S(R2I(GetPlayerHandicapXPBJ(MultiboardTeamOnePlayer[rowIndex])-100.))+"%|r"endifif GameModeFlagEU and GameModeFlagFU thenset statusText=statusText+" - "endifif GameModeFlagFU thenset statusText=statusText+GoldColorCode+"+"+I2S(AiAggressionLevel[48+GetPlayerId(MultiboardTeamOnePlayer[rowIndex])])+"|r"endifendifcall SetMultiboardItemText(ScoreboardMultiboard,14,(rowIndex+2),statusText)set rowIndex=rowIndex+1endloopset rowIndex=1set playerCount=TeamTwoPlayerCount_2loopexitwhen rowIndex>playerCountcall SetMultiboardItemText(ScoreboardMultiboard,4,(rowIndex+3+TeamOnePlayerCount_2),KillsColorCode+I2S(PlayerMultiboardStat[GetPlayerId(MultiboardTeamTwoPlayer[rowIndex])])+"|r")call SetMultiboardItemText(ScoreboardMultiboard,5,(rowIndex+3+TeamOnePlayerCount_2),DeathsColorCode+I2S(PlayerDeaths[GetPlayerId(MultiboardTeamTwoPlayer[rowIndex])])+"|r")call SetMultiboardItemText(ScoreboardMultiboard,6,(rowIndex+3+TeamOnePlayerCount_2),AssistsColorCode+I2S(PlayerAssistCount[GetPlayerId(MultiboardTeamTwoPlayer[rowIndex])])+"|r")set statusText=GetAiStatusText(GetPlayerId(MultiboardTeamTwoPlayer[rowIndex]),false)if MultiboardTeamTwoPlayer[rowIndex]==PendingSwapPlayerB and(not IsDebugMode)thenset statusText=TempMenuLineTextendifif(not PlayerMultiboardToggle[32+GetPlayerId(GetLocalPlayer())])thenset statusText=" "elseif(not(IsPlayerAlly(GetLocalPlayer(),ScourgePlayer[0])or IsDebugMode))thenset statusText=" "endifcall SetMultiboardItemText(ScoreboardMultiboard,15,(rowIndex+3+TeamOnePlayerCount_2),statusText)set statusText=" "if PlayerMultiboardToggle[80+GetPlayerId(GetLocalPlayer())]and IsPlayerPlayingComputer(MultiboardTeamTwoPlayer[rowIndex])thenif GameModeFlagEU thenset statusText=ExperienceColorCode+"+"+I2S(R2I(GetPlayerHandicapXPBJ(MultiboardTeamTwoPlayer[rowIndex])-100.))+"%|r"endifif GameModeFlagEU and GameModeFlagFU thenset statusText=statusText+" - "endifif GameModeFlagFU thenset statusText=statusText+GoldColorCode+"+"+I2S(AiAggressionLevel[48+GetPlayerId(MultiboardTeamTwoPlayer[rowIndex])])+"|r"endifendifcall SetMultiboardItemText(ScoreboardMultiboard,14,(rowIndex+3+TeamOnePlayerCount_2),statusText)set rowIndex=rowIndex+1endloopendfunctionfunction IsSentinelCreepType takes nothing returns booleanreturn(GetUnitTypeId(GetTrig