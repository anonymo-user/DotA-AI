gle)set pointY=casterY+distance*loopIndex/8*Sin(angle)call GroupEnumUnitsInRange(enumGroup,pointX,pointY,100,Condition(function FilterAttackableEnemy))call ForGroup(enumGroup,function EnumGrantA2TPTimedSlow)call GroupClear(enumGroup)set loopIndex=loopIndex+1endloopcall ReleaseGroupToPool(enumGroup)set enumGroup=nullendfunctionfunction IsUnitRecallStateActive takes unit whichUnit,unit otherUnit returns booleanreturn((LoadInteger(GameHashtable,(GetHandleId((whichUnit))),((4294))))==1)endfunctionfunction A1TATetherLeashPeriodic takes nothing returns booleanlocal trigger whichTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(whichTrigger)local unit tetheredUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local unit anchorUnit=(LoadUnitHandle(GameHashtable,(triggerId),(17)))local real distance=DistanceBetweenWidgets(tetheredUnit,anchorUnit)local real angle=AngleBetweenUnits(tetheredUnit,anchorUnit)*bj_DEGTORADlocal real tetherX=GetUnitX(tetheredUnit)+20*Cos(angle)local real tetherY=GetUnitY(tetheredUnit)+20*Sin(angle)local location tempLocif distance<300 or distance>2150 thenset tempLoc=FindLocationOutsideRegion(tetherX,tetherY)set tetherX=GetLocationX(tempLoc)set tetherY=GetLocationY(tempLoc)call SetUnitX(tetheredUnit,ClampXToPlayableArea(tetherX))call SetUnitY(tetheredUnit,ClampXToPlayableArea(tetherY))call KillTreesInArea(tetherX,tetherY,350)call RemoveLocation(tempLoc)set tempLoc=nullcall DestroyEffect((LoadEffectHandle(GameHashtable,(triggerId),(32))))call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(whichTrigger)call SaveInteger(GameHashtable,(GetHandleId((tetheredUnit))),((4295)),(2))elsecall SetUnitX(tetheredUnit,tetherX)call SetUnitY(tetheredUnit,tetherY)endifset whichTrigger=nullset tetheredUnit=nullset anchorUnit=nullreturn falseendfunctionfunction A1TATetherSharePeriodic takes nothing returns booleanlocal trigger tickTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(tickTrigger)local unit casterUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local unit targetUnit=(LoadUnitHandle(GameHashtable,(triggerId),(17)))local group tetherGroup=(LoadGroupHandle(GameHashtable,(triggerId),(133)))local lightning tetherLightning=(LoadLightningHandle(GameHashtable,(triggerId),(196)))local integer tickCount=GetTriggerEvalCount(tickTrigger)local real distance=DistanceBetweenWidgets(casterUnit,targetUnit)local real lightningAlpha=1local real casterLife=GetUnitState(casterUnit,UNIT_STATE_LIFE)local real casterMana=GetUnitState(casterUnit,UNIT_STATE_MANA)local real prevLifeRatio=(LoadReal(GameHashtable,(triggerId),(670)))local real prevManaRatio=(LoadReal(GameHashtable,(triggerId),(667)))local real lifeRatiolocal real manaRatiolocal real shareFactor=1.5if casterUnit==null thencall FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(tickTrigger)return falseendifif targetUnit==null or casterUnit==null or IsUnitDeadOrInvalid(casterUnit) or(tickCount>600 and IsUnitRecallStateActive(casterUnit,targetUnit)==false and((LoadInteger(GameHashtable,(GetHandleId((casterUnit))),((4295))))==1)==false)or(distance>925 and((LoadInteger(GameHashtable,(GetHandleId((casterUnit))),((4295))))==1)==false)or GetTriggerEventId()==EVENT_UNIT_DEATH or(GetTriggerEventId()==EVENT_UNIT_SPELL_EFFECT and GetSpellAbilityId()=='A1TU')thencall ReleaseGroupToPool(tetherGroup)call DestroyLightning(tetherLightning)call UnitRemoveAbility(targetUnit,'A1TH')call UnitRemoveAbility(targetUnit,'A1TI')call UnitRemoveAbility(targetUnit,'A1TG')call UnitRemoveAbility(targetUnit,'A1TJ')call UnitRemoveAbility(targetUnit,'B0DH')call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(tickTrigger)call UnitRemoveAbility(casterUnit,'A1TH')call UnitRemoveAbility(casterUnit,'A1TI')call UnitRemoveAbility(casterUnit,'A1TG')call UnitRemoveAbility(casterUnit,'A1TJ')call UnitRemoveAbility(casterUnit,'B0DH')call UnitRemoveAbility(casterUnit,'A1TU')if(LoadInteger(GameHashtable,(GetHandleId(casterUnit)),(704)))==0 or(LoadInteger(GameHashtable,(GetHandleId(casterUnit)),(704)))=='A1TA' thencall SetPlayerAbilityAvailable(GetOwningPlayer(casterUnit),'A1TA',true)endifcall RemoveSavedHandle(GameHashtable,GetHandleId(casterUnit),652)call RemoveSavedHandle(GameHashtable,GetHandleId(targetUnit),StringHash("AI|TetherSource"))elseset lifeRatio=casterLife/GetUnitState(casterUnit,UNIT_STATE_MAX_LIFE)set manaRatio=casterMana/GetUnitState(casterUnit,UNIT_STATE_MAX_MANA)if lifeRatio-prevLifeRatio>0 and(lifeRatio-prevLifeRatio)<.5 thenif((LoadInteger(GameHashtable,(GetHandleId((casterUnit))),((4298))))==1)==false thencall SetUnitState(targetUnit,UNIT_STATE_LIFE,GetUnitState(targetUnit,UNIT_STATE_LIFE)+shareFactor*(lifeRatio-prevLifeRatio)*GetUnitState(casterUnit,UNIT_STATE_MAX_LIFE))endifendifif manaRatio-prevManaRatio>0 and(manaRatio-prevManaRatio)<.5 thencall SetUnitState(targetUnit,UNIT_STATE_MANA,GetUnitState(targetUnit,UNIT_STATE_MANA)+shareFactor*(manaRatio-prevManaRatio)*GetUnitState(casterUnit,UNIT_STATE_MAX_MANA))endifcall SaveReal(GameHashtable,(triggerId),(670),((GetUnitState(casterUnit,UNIT_STATE_LIFE)/GetUnitState(casterUnit,UNIT_STATE_MAX_LIFE))*1.))call SaveReal(GameHashtable,(triggerId),(667),((GetUnitState(casterUnit,UNIT_STATE_MANA)/GetUnitState(casterUnit,UNIT_STATE_MAX_MANA))*1.))call MoveLightning(tetherLightning,true,GetUnitX(casterUnit),GetUnitY(casterUnit),GetUnitX(targetUnit),GetUnitY(targetUnit))call ApplyA2TPAlongTetherLine(casterUnit,targetUnit,tetherGroup)if IsUnitVisible(casterUnit,GetLocalPlayer())==false and IsUnitVisible(targetUnit,GetLocalPlayer())==false thenset lightningAlpha=0endifif IsEitherKeyPlayerActive(GetLocalPlayer())thenset lightningAlpha=1endifif distance<700 or((LoadInteger(GameHashtable,(GetHandleId((casterUnit))),((4295))))==1) thencall SetLightningColor(tetherLightning,.0,1.,1.,lightningAlpha)elsecall SetLightningColor(tetherLightning,.8,.7,.4,lightningAlpha)endifendifset tickTrigger=nullset casterUnit=nullset targetUnit=nullset tetherGroup=nullset tetherLightning=nullreturn falseendfunctionfunction OnCastA1TATether takes nothing returns nothinglocal unit casterUnit=GetTriggerUnit()local unit targetUnit=GetSpellTargetUnit()local trigger tetherTrigger=CreateTrigger()local integer handleId=GetHandleId(tetherTrigger)local lightning tetherLightning=AddLightning("CHIM",true,GetUnitX(casterUnit),GetUnitY(casterUnit),GetUnitX(targetUnit),GetUnitY(targetUnit))local integer abilityLevel=GetUnitAbilityLevel(casterUnit,'A1TA')local integer tetherAbilityIdlocal real distance=DistanceBetweenWidgets(casterUnit,targetUnit)local real angle=AngleBetweenUnits(casterUnit,targetUnit)*bj_DEGTORADlocal location tempLoclocal real tempXlocal real tempYcall SetLightningColor(tetherLightning,.0,1.,1.,1)call AddPermanentAbility(casterUnit,'A1TU')if abilityLevel==1 thenset tetherAbilityId='A1TH'elseif abilityLevel==2 thenset tetherAbilityId='A1TI'elseif abilityLevel==3 thenset tetherAbilityId='A1TG'elseif abilityLevel==4 thenset tetherAbilityId='A1TJ'endifcall SetPlayerAbilityAvailable(GetOwningPlayer(casterUnit),'A1TA',false)call AddPermanentAbility(casterUnit,tetherAbilityId)call SetPlayerAbilityAvailable(GetOwningPlayer(casterUnit),tetherAbilityId,false)call AddPermanentAbility(targetUnit,tetherAbilityId)call SetPlayerAbilityAvailable(GetOwningPlayer(targetUnit),tetherAbilityId,false)call SaveUnitHandle(GameHashtable,(handleId),(2),(casterUnit))call SaveUnitHandle(GameHashtable,(handleId),(17),(targetUnit))call SaveGroupHandle(GameHashtable,(handleId),(133),(AcquireGroupFromPool()))call SaveLightningHandle(GameHashtable,(handleId),(196),(tetherLightning))call SaveReal(GameHashtable,(handleId),(670),((GetUnitState(casterUnit,UNIT_STATE_LIFE)/GetUnitState(casterUnit,UNIT_STATE_MAX_LIFE))*1.))call SaveReal(GameHashtable,(handleId),(667),((GetUnitState(casterUnit,UNIT_STATE_MANA)/GetUnitState(casterUnit,UNIT_STATE_MAX_MANA))*1.))call TriggerRegisterTimerEvent(tetherTrigger,.02,true)call TriggerRegisterUnitEvent(tetherTrigger,casterUnit,EVENT_UNIT_DEATH)call TriggerRegisterUnitEvent(tetherTrigger,targetUnit,EVENT_UNIT_DEATH)call TriggerRegisterUnitEvent(tetherTrigger,casterUnit,EVENT_UNIT_SPELL_EFFECT)call TriggerAddCondition(tetherTrigger,Condition(function A1TATetherSharePeriodic))call SaveUnitHandle(GameHashtable,(GetHandleId(casterUnit)),(652),(targetUnit))if IsUnitType(targetUnit,UNIT_TYPE_HERO)thencall StoreUnitByName((GetHandleId(targetUnit)),"AI|TetherSource",casterUnit)endifif distance>700 thenset tetherTrigger=CreateTrigger()set handleId=GetHandleId(tetherTrigger)call SaveUnitHandle(GameHashtable,(handleId),(2),(casterUnit))call SaveUnitHandle(GameHashtable,(handleId),(17),(targetUnit))call SaveEffectHandle(GameHashtable,(handleId),(32),(AddSpecialEffectTarget("Abilities\\Weapons\\DragonHawkMissile\\DragonHawkMissile.mdl",casterUnit,"chest")))call TriggerRegisterTimerEvent(tetherTrigger,.02,true)call TriggerAddCondition(tetherTrigger,Condition(function A1TATetherLeashPeriodic))call SaveInteger(GameHashtable,(GetHandleId((casterUnit))),((4295)),(1))endifset casterUnit=nullset targetUnit=nullset tetherTrigger=nullset tempLoc=nullendfunctionfunction OnSpellEffectA1TA takes nothing returns booleanif GetSpellAbilityId()=='A1TA' thencall OnCastA1TATether()endifreturn falseendfunctionfunction RegisterA1TATetherTrigger takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(t,Condition(function OnSpellEffectA1TA))set t=nullendfunctionfunction CanBlinkToPoint takes unit whichUnit,real targetX,real targetY returns booleanlocal boolean canBlink=falselocal player owner=GetOwningPlayer(whichUnit)local unit dummyUnit=CreateUnit(owner,'e02Q',GetUnitX(whichUnit),GetUnitY(whichUnit),0)call AddPermanentAbility(dummyUnit,'A1V4')if IssuePointOrderById(dummyUnit,852525,targetX,targetY) thencall KillUnit(dummyUnit)set dummyUnit=nullreturn trueelsecall KillUnit(dummyUnit)set dummyUnit=nullreturn falseendifendfunctionfunction ShowBlueCountdownTag takes string tagText,unit whichUnit returns nothinglocal texttag countdownTag=CreateTextTag()call SetTextTagText(countdownTag,tagText,.033)call SetTextTagPosUnit(countdownTag,whichUnit,64)call SetTextTagColor(countdownTag,0,50,255,255)call SetTextTagVelocity(countdownTag,0,.0355)call SetTextTagFadepoint(countdownTag,.15)call SetTextTagPermanent(countdownTag,false)call SetTextTagLifespan(countdownTag,.85)call SetTextTagVisibility(countdownTag,true)set countdownTag=nullendfunctionfunction A1TBRecallCountdownPeriodic takes nothing returns booleanlocal trigger whichTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(whichTrigger)local unit casterUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local integer tickCount=GetTriggerEvalCount(whichTrigger)if IsUnitDeadOrInvalid(casterUnit)==false and tickCount<12 thencall ShowBlueCountdownTag(I2S(12-tickCount),casterUnit)endifif tickCount==12 thencall FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(whichTrigger)endifset whichTrigger=nullset casterUnit=nullreturn falseendfunctionfunction A1TBRecallTeleportPeriodic takes nothing returns booleanlocal trigger whichTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(whichTrigger)local unit caster=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local unit allyUnit=(LoadUnitHandle(GameHashtable,(GetHandleId(caster)),(652)))local real destX=(LoadReal(GameHashtable,(triggerId),(47)))local real destY=(LoadReal(GameHashtable,(triggerId),(48)))local real originX=(LoadReal(GameHashtable,(triggerId),(189)))local real originY=(LoadReal(GameHashtable,(triggerId),(190)))local fogmodifier fogMod=(LoadFogModifierHandle(GameHashtable,(trigger