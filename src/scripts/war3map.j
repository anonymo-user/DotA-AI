,0)endifset slotIndex=slotIndex+1endloopendfunctionfunction RandomHeroPointValueByAttribute takes integer attributeType returns integerlocal integer pointValueif attributeType==1 thenset pointValue=GetUnitPointValueByType(RandomHeroTypePoolA[GetRandomInt(1,RandomHeroTypePoolACount)])elseif attributeType==2 thenset pointValue=GetUnitPointValueByType(RandomHeroTypePoolB[GetRandomInt(1,RandomHeroTypePoolBCount)])elseif attributeType==3 thenset pointValue=GetUnitPointValueByType(RandomHeroTypePoolC[GetRandomInt(1,RandomHeroTypePoolCCount)])endifreturn pointValueendfunctionfunction PickUniqueHeroForSingleDraft takes integer excludedValueA,integer excludedValueB,integer attributeType returns integerlocal integer candidateValueset candidateValue=RandomHeroPointValueByAttribute(attributeType)if GameModeFlagE9 and excludedValueA!=candidateValue and excludedValueB!=candidateValue thenreturn candidateValueendifloopexitwhen PointValueClaimed[candidateValue]==false and excludedValueA!=candidateValue and excludedValueB!=candidateValueset candidateValue=RandomHeroPointValueByAttribute(attributeType)endloopset PointValueClaimed[candidateValue]=truereturn candidateValueendfunctionfunction InitSingleDraftMode takes nothing returns nothinglocal player whichPlayerlocal integer index=1local integer heroPick1local integer heroPick2local integer heroPick3local trigger tempTriggerlocal integer tempHandleIdset GameModeFlagVT=trueset TimeThresholdSeconds=120set ModeToggleFlagW=falseset ModeToggleFlagX=falsecall PauseUnit(PausedMapUnitSlot1,true)call PauseUnit(PausedMapUnitSlot2,true)call PauseUnit(PausedMapUnitSlot3,true)call PauseUnit(PausedMapUnitSlot4,true)call PauseUnit(PausedMapUnitSlot5,true)call PauseUnit(ColoredPausedUnitSlot6,true)call PauseUnit(ColoredPausedUnitSlot7,true)call PauseUnit(ColoredPausedUnitSlot8,true)call PauseUnit(ColoredPausedUnitSlot9,true)call PauseUnit(ColoredPausedUnitSlot10,true)call PauseUnit(ColoredPausedUnit