ible))call SaveInteger(GameHashtable,(handleId),(34),(tickCount))endifif isInvisible thenset tickCount=0call SaveInteger(GameHashtable,(handleId),(34),(tickCount))call SaveInteger(GameHashtable,(GetHandleId((caster))),((4302)),(1))call SetBlurAbilityState(caster,true)call SetUnitVertexColorBJ(caster,100,100,100,75)if IsPlayerEnemy(GetOwningPlayer(caster),GetLocalPlayer()) and IsEitherKeyPlayerActive(GetLocalPlayer())==false thencall UnitSetUsesAltIcon(caster,true)elsecall UnitSetUsesAltIcon(caster,false)endifendifendifcall ReleaseGroupToPool(enumGroup)set enumGroup=nullendifset tickTrigger=nullset caster=nullreturn falseendfunctionfunction StartBlurTracking takes nothing returns nothinglocal trigger blurTrigger=CreateTrigger()local integer triggerId=GetHandleId(blurTrigger)local unit trackedUnit=GetTriggerUnit()call TriggerRegisterTimerEvent(blurTrigger,.1,true)call TriggerAddCondition(blurTrigger,Condition(function UpdateBlurInvisibility))call SaveUnitHandle(GameHashtable,(triggerId),(2),(trackedUnit))call SaveInteger(GameHashtable,(triggerId),(34),(0))call SaveBoolean(GameHashtable,(triggerId),(674),(false))set blurTrigger=nullset trackedUnit=nullendfunctionfunction OnLearnGraveFieldSkill takes nothing returns booleanif GetLearnedSkill()=='A03P' and IsUnitIllusion(GetTriggerUnit())==false and GetUnitAbilityLevel(GetTriggerUnit(),'A03P')==1 thencall StartBlurTracking()endifreturn falseendfunctionfunction RegisterGraveFieldLearnTrigger takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_HERO_SKILL)call TriggerAddCondition(t,Condition(function OnLearnGraveFieldSkill))set t=nullendfunctionfunction EnumSpawnGraveCasterOnEnemy takes nothing returns nothinglocal unit graveCasterif IsUnitInGroup(GetEnumUnit(),EnumCollectGroup_2)==false thencall GroupAddUnit(EnumCollectGroup_2,GetEnumUnit())set graveCaster=CreateUnit(GetOwningPlayer(GetEnumUnit()),'e00E',GetUnit