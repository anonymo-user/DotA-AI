set periodicTrigger=nullset armorEffect=nullendfunctionfunction OnA0QGSpellEffectCondition takes nothing returns booleanif GetSpellAbilityId()=='A0QG' thencall StartA0QGSoulArmor()endifreturn falseendfunctionfunction InitA0QGSoulArmorTrigger takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(t,Condition(function OnA0QGSpellEffectCondition))set t=nullendfunctionfunction IsUnitCyclonedOrDisabled takes unit u returns booleanreturn GetUnitAbilityLevel(u,'B02J')>0 or GetUnitAbilityLevel(u,'BUsp')>0 or GetUnitAbilityLevel(u,'Bust')>0 or IsUnitCycloned(u)endfunctionfunction OnA0QEPullTick takes nothing returns booleanlocal trigger whichTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(whichTrigger)local real originX=(LoadReal(GameHashtable,(handleId),(6)))local real originY=(LoadReal(GameHashtable,(handleId),(7)))local integer abilityLevellocal unit casterUnitlocal unit targetUnitlocal real newXlocal real newYlocal real distancelocal real angleif GetTriggerEventId()==EVENT_UNIT_DEATH thencall FlushChildHashtable(GameHashtable,handleId)call RecycleExpiringTrigger(whichTrigger)elseset targetUnit=(LoadUnitHandle(GameHashtable,(handleId),(17)))set distance=(LoadReal(GameHashtable,(handleId),(138)))set originX=(LoadReal(GameHashtable,(handleId),(6)))set originY=(LoadReal(GameHashtable,(handleId),(7)))set angle=(LoadReal(GameHashtable,(handleId),(137)))set newX=GetUnitX(targetUnit)+distance/ 12*Cos(angle)set newY=GetUnitY(targetUnit)+distance/ 12*Sin(angle)if IsUnitType(targetUnit,UNIT_TYPE_HERO) thencall SetUnitPosition(targetUnit,newX,newY)elsecall SetUnitX(targetUnit,newX)call SetUnitY(targetUnit,newY)endifif GetTriggerEvalCount(whichTrigger)>19 thenset casterUnit=(LoadUnitHandle(GameHashtable,(handleId),(2)))set abilityLevel=(LoadInteger(GameHashtable,(handleId),(5)))call FlushChildHashtable(GameHashtable,handleId)call RecycleExpiringTrigger(whichTrigger)call DamageTargetByType(casterUnit,targetUnit,DamageType1,abilityLevel*40)set casterUnit=nullendifset targetUnit=nullendifset whichTrigger=nullreturn falseendfunctionfunction EnumStartA0QEPull takes nothing returns nothinglocal trigger pullTriggerlocal integer handleIdlocal unit caster=GetTriggerUnit()local unit enumUnit=GetEnumUnit()if IsUnitCyclonedOrDisabled(enumUnit)==false thenset pullTrigger=CreateTrigger()set handleId=GetHandleId(pullTrigger)call TriggerRegisterUnitEvent(pullTrigger,enumUnit,EVENT_UNIT_DEATH)call TriggerRegisterTimerEvent(pullTrigger,.025,true)call TriggerAddCondition(pullTrigger,Condition(function OnA0QEPullTick))call SaveReal(GameHashtable,(handleId),(6),((StoredUnitX)*1.0))call SaveReal(GameHashtable,(handleId),(7),((StoredUnitY)*1.0))call SaveReal(GameHashtable,(handleId),(138),((DistanceBetweenCoords(StoredUnitX,StoredUnitY,GetUnitX(enumUnit),GetUnitY(enumUnit)))*1.0))call SaveReal(GameHashtable,(handleId),(137),((Atan2(StoredUnitY-GetUnitY(enumUnit),StoredUnitX-GetUnitX(enumUnit)))*1.0))call SaveInteger(GameHashtable,(handleId),(5),(StoredIntegerValue))call SaveUnitHandle(GameHashtable,(handleId),(2),(caster))call SaveUnitHandle(GameHashtable,(handleId),(17),(enumUnit))endifset pullTrigger=nullset caster=nullset enumUnit=nullendfunctionfunction OnCastA0QEVortex takes nothing returns nothinglocal group enemyGroup=AcquireGroupFromPool()local location targetLoc=GetSpellTargetLoc()local real centerX=GetLocationX(targetLoc)local real centerY=GetLocationY(targetLoc)local integer abilityLevel=GetUnitAbilityLevel(GetTriggerUnit(),'A0QE')local real radius=150+100*abilityLevel+25set FilterReferenceUnit_2=GetTriggerUnit()call PlaySoundAtPoint(SndDivineShieldDeath,centerX,centerY)call DestroyEffect(AddSpecialEffect("war3mapImported\\Star Aura.mdx",centerX,centerY))call GroupEnumUnitsInRange(enemyGroup,centerX,centerY,radius,Condition(function FilterEnemyAttackableTarget))set StoredUnitX=centerXset StoredUnitY=centerYset StoredIntegerValue=abilityLevelcall ForGroup(enemyGroup,function EnumStartA0QEPull)call KillTreesInArea(centerX,centerY,200)call RemoveLocation(targetLoc)call ReleaseGroupToPool(enemyGroup)set targetLoc=nullset enemyGroup=nullendfunctionfunction DispatchA0QEVortexOnSpellEffect takes nothing returns booleanif GetSpellAbilityId()=='A0QE' thencall OnCastA0QEVortex()endifreturn falseendfunctionfunction ValidateA0QEVortexTargetLoc takes nothing returns nothinglocal location targetLoc=GetSpellTargetLoc()local real targetX=GetLocationX(targetLoc)local real targetY=GetLocationY(targetLoc)if IsPointUnwalkable(targetX,targetY)==false or(IsPointInRegion(PlayableMapRegion,((targetX)*1.),((targetY)*1.)))thencall ForceStopUnit(GetTriggerUnit())call ShowErrorMessageToPlayer(GetOwningPlayer(GetTriggerUnit()),(GetObjectName(('n03K'))))endifcall RemoveLocation(targetLoc)set targetLoc=nullendfunctionfunction DispatchA0QEVortexCastValidation takes nothing returns booleanif GetSpellAbilityId()=='A0QE' thencall ValidateA0QEVortexTargetLoc()endifreturn falseendfunctionfunction InitA0QEVortexSpell takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(t,Condition(function DispatchA0QEVortexOnSpellEffect))set t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_CAST)call TriggerAddCondition(t,Condition(function DispatchA0QEVortexCastValidation))set t=nullendfunctionfunction OnA0R7SurgeExpireRemoveBuffs takes nothing returns booleanlocal trigger triggeringTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(triggeringTrigger)local unit targetUnit=(LoadUnitHandle(GameHashtable,(handleId),(17)))call UnitRemoveAbility(targetUnit,'B07W')call UnitRemoveAbility(targetUnit,'Bblo')call UnitRemoveAbility(targetUnit,'B062')call UnitRemoveAbility(ta