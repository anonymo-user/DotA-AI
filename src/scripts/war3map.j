rval=.45-abilityLevel*.15endifcall SetPlayerAbilityAvailable(GetOwningPlayer(casterUnit),'A12R',false)call AddPermanentAbility(casterUnit,'A12R')call IssueTargetOrder(casterUnit,"attack",targetUnit)call SaveUnitHandle(GameHashtable,(triggerId),(2),(casterUnit))call SaveBoolean(GameHashtable,(triggerId),(15),(isUltimate))call SaveInteger(GameHashtable,(triggerId),(30),(RegisterUnitHandleSlot(targetUnit)))call SaveReal(GameHashtable,(triggerId),(193),((attackInterval)*1.))call SaveInteger(GameHashtable,(triggerId),(361),(0))call TriggerRegisterTimerEvent(focusTrigger,20,false)call SaveTriggerByStringKey(GetHandleId(casterUnit),"FocusFireTrig",focusTrigger)call TriggerRegisterUnitEvent(focusTrigger,targetUnit,EVENT_UNIT_DAMAGED)call TriggerRegisterUnitEvent(focusTrigger,casterUnit,EVENT_UNIT_DEATH)call TriggerRegisterUnitEvent(focusTrigger,targetUnit,EVENT_UNIT_DEATH)call TriggerAddCondition(focusTrigger,Condition(function OnFocusFireEvent))set casterUnit=nullset targetUnit=nullset focusTrigger=nullendfunctionfunction FilterCastFocusFire takes nothing returns booleanif(GetSpellAbilityId()=='A12P' or GetSpellAbilityId()=='A1D6')and HasAnyMarkedAbility(GetSpellTargetUnit())==false thencall CastFocusFire()endifreturn falseendfunctionfunction CleanupFocusFireForUnit takes unit whichUnit returns nothinglocal trigger t=LoadTriggerByStringKey(GetHandleId(whichUnit),"FocusFireTrig")local integer triggerIdlocal integer targetIndexlocal unit focusTargetlocal integer abilityLevelif t==null thenreturnendifset triggerId=GetHandleId(t)set targetIndex=(LoadInteger(GameHashtable,(triggerId),(30)))set focusTarget=UnitByIndex(targetIndex)if GetTriggerUnit()==focusTarget thencall DestroyEffect(AddSpecialEffectTarget("effects\\Tornado.mdx",whichUnit,"hand,left"))call DestroyEffect(AddSpecialEffectTarget("effects\\Tornado.mdx",whichUnit,"hand,right"))if GetUnitAbilityLevel(whichUnit,'A12R')==0 thencall AddPermanentAbility(whichUnit,'A12R')set abil