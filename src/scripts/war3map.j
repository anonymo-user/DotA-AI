temIndexCost700E],itemSlot)call SetItemPlayer(TempCreatedItem,ItemOwnerPlayer_2,false)call SetItemUserData(TempCreatedItem,1)call FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(expireTrigger)call UnitAddItem(carrierUnit,spawnedItem)call UnitRemoveAbility(carrierUnit,'B0GI')endifset expireTrigger=nullset carrierUnit=nullset heldItem=nullset spawnedItem=nullreturn falseendfunctionfunction ScheduleReservedItemHoldTimer takes unit whichUnit,item heldItem returns nothinglocal trigger holdTimer=CreateTrigger()local integer timerId=GetHandleId(holdTimer)local integer slotIndex=GetUnitItemSlotIndex(whichUnit,heldItem)call SaveInteger(GameHashtable,(timerId),(98),(slotIndex))call SaveInteger(GameHashtable,(timerId),(105),(GetHandleId(heldItem)))call SaveUnitHandle(GameHashtable,(timerId),(26),(whichUnit))call TriggerRegisterTimerEvent(holdTimer,120.,true)call TriggerAddCondition(holdTimer,Condition(function OnReservedItemHoldTimerExpire))set holdTimer=nullendfunctionfunction OnPickupConvertItemForms takes nothing returns nothinglocal unit triggerUnit=GetTriggerUnit()local item pickedItem=GetManipulatedItem()local integer itemTypeIndex=FindItemTypeIndexAllTables(pickedItem)local unit linkedUnitlocal integer reservedItemIdlocal boolean TargetFroglocal integer itemSlotlocal item newItemlocal integer mappedSlotIdif itemTypeIndex==ItemIndexCost700B thenset itemSlot=GetUnitItemSlotIndex(triggerUnit,pickedItem)set linkedUnit=(LoadUnitHandle(GameHashtable,(GetHandleId(triggerUnit)),(103)))set reservedItemId=(LoadInteger(GameHashtable,(GetHandleId(triggerUnit)),(104)))if GetUnitTypeId(linkedUnit)=='nfoh' or GetUnitTypeId(linkedUnit)=='ndfl' thencall DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\ReplenishMana\\SpiritTouchTarget.mdl",triggerUnit,"overhead"))call PlaySoundFileForPlayer(GetOwningPlayer(triggerUnit),"Abilities\\Spells\\Human\\Heal\\HealTarget.wav")set ItemOwnerPlayer_2=GetItemPlayer(pick