ralDagger)call CreateSound("Sounds\\Spectral Dagger.mp3",false,false,false,10,10,"DefaultEAXON")call PreloadAbilityOnDummy('A0I2')call PreloadAbilityOnDummy('A0HY')set t=nullendfunctionfunction FilterAttackedHeroByA0FXAttacker takes nothing returns booleanreturn IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO)and GetUnitAbilityLevel(GetAttacker(),'A0FX')>0endfunctionfunction FilterAllyAliveNonStructureWithoutA04R takes nothing returns booleanreturn IsUnitAlly(GetFilterUnit(),GetOwningPlayer(GetTriggerUnit()))and GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and GetUnitState(GetFilterUnit(),UNIT_STATE_LIFE)>1 and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==falseendfunctionfunction OnAttackA0FXBonusDamageIfTargetIsolated takes nothing returns nothinglocal unit attacker=GetAttacker()local unit targetUnit=GetTriggerUnit()local group nearbyGroup=AcquireGroupFromPool()local boolexpr allyFilter=Condition(function FilterAllyAliveNonStructureWithoutA04R)local integer attackerIdcall GroupEnumUnitsInRange(nearbyGroup,GetUnitX(targetUnit),GetUnitY(targetUnit),325+25,allyFilter)call GroupRemoveUnit(nearbyGroup,targetUnit)if FirstOfGroup(nearbyGroup)==null thenset attackerId=GetHandleId(attacker)if ((LoadInteger(GameHashtable,(GetHandleId((attacker))),((4275))))==1)==false thencall UnitDamageTarget(attacker,targetUnit,5+15*GetUnitAbilityLevel(attacker,'A0FX'),true,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_DIVINE,WEAPON_TYPE_WHOKNOWS)call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DeathandDecay\\DeathandDecayTarget.mdl",targetUnit,"overhead"))call StartUnitFlagTimer(attacker,4275,0.3)endifendifcall ReleaseGroupToPool(nearbyGroup)call DestroyBoolExpr(allyFilter)set attacker=nullset targetUnit=nullset nearbyGroup=nullset allyFilter=nullendfunctionfunction RegisterA0FXIsolationAttackTrigger takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventBothTeams(t,EVENT_PLAYER_UNIT_ATTACKED)call TriggerAddC