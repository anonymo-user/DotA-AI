AbilityLevel(wardUnit,'A019',abilityLevel)elsecall AddPermanentAbility(wardUnit,'A0E7')call SetUnitAbilityLevel(wardUnit,'A0E7',abilityLevel)endifcall IssuePointOrderById(wardUnit,852473,targetX,targetY)call RemoveLocation(targetLoc)set casterUnit=nullset targetLoc=nullset wardUnit=nullendfunctionfunction FilterCastA0RG takes nothing returns booleanif GetSpellAbilityId()=='A0RG' thencall OnCastSpawnTeamAuraWardA0RG()endifreturn falseendfunctionfunction RegisterEgeSpellEffectHandler takes nothing returns nothinglocal trigger spellTrigger=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(spellTrigger,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(spellTrigger,Condition(function FilterCastA0RG))set spellTrigger=nullendfunctionfunction OnBlinkStrikeChaseAttackTick takes nothing returns booleanlocal trigger whichTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(whichTrigger)if IsHeroLowHealthOrMana(LoadUnitHandle(GameHashtable,triggerId,'attk'))or GetTriggerEvalCount(whichTrigger)>=11 thencall FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(whichTrigger)elsecall IssueTargetOrderById(LoadUnitHandle(GameHashtable,triggerId,'attk'),851983,LoadUnitHandle(GameHashtable,triggerId,'targ'))endifset whichTrigger=nullreturn falseendfunctionfunction IsBlinkStrikeChargeAbility takes integer abilityId returns booleanreturn abilityId=='A2YZ' or abilityId=='A2YW' or abilityId=='A2YV' or abilityId=='A2YY' or abilityId=='A2YX' or abilityId=='A2Z0' or abilityId=='A2ZL'endfunctionfunction OnBlinkStrikeCast takes nothing returns nothinglocal unit caster=GetTriggerUnit()local unit targetUnit=GetSpellTargetUnit()local real damageAmount=10+30*GetUnitAbilityLevel(caster,'A0K9')local trigger tempTriggerlocal integer tempHandleIdlocal real blinkX=GetUnitX(targetUnit)-75*Cos(GetUnitFacing(targetUnit)*bj_DEGTORAD)local real blinkY=GetUnitY(targetUnit)-75*Sin(GetUnitFacing(targetUnit)*bj_DEGTORAD)local integer chargeCount=(LoadInteger(GameHashtable,(GetHandleId(caster)),(828)))local trigger chaseTriggerlocal integer chaseHandleIdif chargeCount>0 thencall SetUnitX(caster,blinkX)call SetUnitY(caster,blinkY)call SetUnitFacing(caster,GetUnitFacing(targetUnit))call DestroyEffect(AddSpecialEffect("war3mapImported\\BlinkStrike.mdx",blinkX,blinkY))if IsUnitEnemy(targetUnit,GetOwningPlayer(caster))thencall DamageTargetByType(caster,targetUnit,DamageType1,damageAmount)call SaveBoolean(GameHashtable,(GetHandleId(caster)),(332),(true))call IssueTargetOrderById(caster,851983,targetUnit)if(GetPlayerController(GetOwningPlayer(caster))!=MAP_CONTROL_USER)thenif CountUnitsInRangeOfUnit(700,caster,Condition(function FilterTargetableEnemyHero))<1 thenset chaseTrigger=CreateTrigger()set chaseHandleId=GetHandleId(chaseTrigger)call SaveUnitHandle(GameHashtable,chaseHandleId,'targ',targetUnit)call SaveUnitHandle(GameHashtable,chaseHandleId,'attk',caster)call TriggerAddCondition(chaseTrigger,Condition(function OnBlinkStrikeChaseAttackTick))call TriggerRegisterTimerEvent(chaseTrigger,.4,true)set chaseTrigger=nullendifcall PolledWait_2(.3)call IssueTargetOrderById(caster,851983,targetUnit)endifendifcall UnitRemoveAbility(caster,RemovableAbilityIdSetB[chargeCount])set chargeCount=chargeCount-1call SaveInteger(GameHashtable,(GetHandleId(caster)),(828),(chargeCount))call AddPermanentAbility(caster,RemovableAbilityIdSetB[chargeCount])elsecall ShowErrorMessageToPlayer(GetOwningPlayer(GetTriggerUnit()),GetObjectName('n0NY'))endifset caster=nullset targetUnit=nullset tempTrigger=nullendfunctionfunction OnBlinkStrikeSpellEffect takes nothing returns nothingif IsBlinkStrikeChargeAbility(GetSpellAbilityId()) thencall OnBlinkStrikeCast()endifreturnendfunctionfunction OnBlinkStrikeCastVisual takes nothing returns booleanif IsBlinkStrikeChargeAbility(GetSpellAbilityId()) thencall DestroyEffect(AddSpecialEffect("war3mapImported\\BlinkStrike.mdx",GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit())))endifreturn falseendfunctionfunction OnBlinkStrikeChargeRegenTick takes nothing returns booleanlocal trigger rechargeTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(rechargeTrigger)local unit heroUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local integer currentCharges=(LoadInteger(GameHashtable,(GetHandleId(heroUnit)),(828)))local integer rechargeCountdown=(LoadInteger(GameHashtable,(triggerId),(34)))local integer maxCharges=3+GetUnitAbilityLevel(heroUnit,'A0K9')if currentCharges<maxCharges thenset rechargeCountdown=rechargeCountdown-1call SaveInteger(GameHashtable,(triggerId),(34),(rechargeCountdown))if rechargeCountdown==0 thencall UnitRemoveAbility(heroUnit,RemovableAbilityIdSetB[currentCharges])set rechargeCountdown=35call SaveInteger(GameHashtable,(triggerId),(34),(rechargeCountdown))set currentCharges=currentCharges+1call SaveInteger(GameHashtable,(GetHandleId(heroUnit)),(828),(currentCharges))call AddPermanentAbility(heroUnit,RemovableAbilityIdSetB[currentCharges])endifendifset rechargeTrigger=nullset heroUnit=nullreturn falseendfunctionfunction StartBlinkStrikeChargeRegen takes nothing returns nothinglocal unit heroUnit=GetTriggerUnit()local trigger regenTrigger=CreateTrigger()local integer triggerId=GetHandleId(regenTrigger)call SaveInteger(GameHashtable,(GetHandleId(heroUnit)),(828),(4))call AddPermanentAbility(heroUnit,RemovableAbilityIdSetB[4])call TriggerRegisterTimerEvent(regenTrigger,1,true)call TriggerAddCondition(regenTrigger,Condition(function OnBlinkStrikeChargeRegenTick))call SaveUnitHandle(GameHashtable,(triggerId),(2),(heroUnit))call SaveInteger(GameHashtable,(triggerId),(34),(35))set heroUnit=nullset regenTrigger=nullendfunctionfunction OnBlinkStrikeLearned takes nothing returns booleanif GetLearnedSkill()=='A0K9' and IsUnitIllusion(GetTriggerUnit())==false thenif GetUnitAbilityLevel(GetTriggerUnit(),'A0K9')==1 thencall StartBlinkStrikeChargeRegen()endifendifreturn falseendfunctionfunction InitBlinkStrikeAbility takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddAction(t,function OnBlinkStrikeSpellEffect)set t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_CAST)call TriggerAddCondition(t,Condition(function OnBlinkStrikeCastVisual))set t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_HERO_SKILL)call TriggerAddCondition(t,Condition(function OnBlinkStrikeLearned))set t=nullset RemovableAbilityIdSetB[0]='A2YZ'set RemovableAbilityIdSetB[1]='A2YW'set RemovableAbilityIdSetB[2]='A2YV'set RemovableAbilityIdSetB[3]='A2YY'set RemovableAbilityIdSetB[4]='A2YX'set RemovableAbilityIdSetB[5]='A2Z0'set RemovableAbilityIdSetB[6]='A2ZL'endfunctionfunction OnRevenantDeathAnimSecondStage takes nothing returns booleanlocal trigger expiredTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(expiredTrigger)local unit revenantUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))call SetUnitAnimationByIndex(revenantUnit,8)call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(expiredTrigger)set expiredTrigger=nullset revenantUnit=nullreturn falseendfunctionfunction PlayRevenantDeathAnimation takes nothing returns nothinglocal unit revenantUnit=GetTriggerUnit()local trigger animTrigger=CreateTrigger()local integer triggerId=GetHandleId(animTrigger)call SetUnitAnimationByIndex(revenantUnit,7)call TriggerRegisterTimerEvent(animTrigger,2.5,false)call TriggerAddCondition(animTrigger,Condition(function OnRevenantDeathAnimSecondStage))call SaveUnitHandle(GameHashtable,(triggerId),(2),(revenantUnit))set animTrigger=nullset revenantUnit=nullendfunctionfunction OnRevenantUnitDeath takes nothing returns booleanif GetUnitTypeId(GetTriggerUnit())=='N0M0' thencall PlayRevenantDeathAnimation()endifreturn falseendfunctionfunction InitRevenantDeathAnimTrigger takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_DEATH)call TriggerAddCondition(t,Condition(function OnRevenantUnitDeath))set t=nullendfunctionfunction EnumLightningRemnantDamage takes nothing returns nothingcall DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\ChimaeraLightningMissile\\ChimaeraLightningMissile.mdl",GetUnitX(GetEnumUnit()),GetUnitY(GetEnumUnit())))call DamageTargetByType(EffectSourceUnit,GetEnumUnit(),DamageType1,EffectDamageAmount)endfunctionfunction OnStaticRemnantProximityDetonate takes nothing returns booleanlocal trigger triggeringTrigger=GetTriggeringTrigger()local integer deathTriggerId=GetHandleId(triggeringTrigger)local trigger proximityTrigger=(LoadTriggerHandle(GameHashtable,(deathTriggerId),(9)))local integer proximityTriggerId=GetHandleId(proximityTrigger)local unit remnantUnit=(LoadUnitHandle(GameHashtable,(deathTriggerId),(8)))local group tempGrouplocal integer abilityLevel=(LoadInteger(GameHashtable,(deathTriggerId),(5)))if remnantUnit==null thencall FlushChildHashtable(GameHashtable,deathTriggerId)call RecycleExpiringTrigger(triggeringTrigger)return falseendifif GetTriggerEventId()==EVENT_UNIT_DEATH thencall ShowUnit(remnantUnit,false)call KillUnit(remnantUnit)call FlushChildHashtable(GameHashtable,proximityTriggerId)call RecycleExpiringTrigger(proximityTrigger)call FlushChildHashtable(GameHashtable,deathTriggerId)call RecycleExpiringTrigger(triggeringTrigger)elseif IsUnitEnemy(GetTriggerUnit(),GetOwningPlayer(remnantUnit)) and IsUnitType(GetTriggerUnit(),UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(GetTriggerUnit(),'A04R')==0 thenset tempGroup=AcquireGroupFromPool()set FilterReferenceUnit_2=remnantUnitset EffectSourceUnit=remnantUnitset EffectDamageAmount=100+40*abilityLevelcall GroupEnumUnitsInRange(tempGroup,GetUnitX(remnantUnit),GetUnitY(remnantUnit),285,Condition(function FilterAttackableEnemy))call ForGroup(tempGroup,function EnumLightningRemnantDamage)call ReleaseGroupToPool(tempGroup)call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\Bolt\\BoltImpact.mdl",GetUnitX(remnantUnit),GetUnitY(remnantUnit)))call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\Bolt\\BoltImpact.mdl",GetUnitX(remnantUnit),GetUnitY(remnantUnit)))call ShowUnit(remnantUnit,false)call KillUnit(remnantUnit)call FlushChildHashtable(GameHashtable,proximityTriggerId)call RecycleExpiringTrigger(proximityTrigger)call FlushChildHashtable(GameHashtable,deathTriggerId)call RecycleExpiringTrigger(triggeringTrigger)endifset proximityTrigger=nullset triggeringTrigger=nullset remnantUnit=nullset tempGroup=nullreturn falseendfunctionfunction OnStaticRemnantSpawnTick takes nothing returns booleanlocal trigger whichTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(whichTrigger)local trigger proximityTriggerlocal integer newHandleIdlocal unit remnantUnitlocal integer abilityLevellocal real spawnX=(LoadReal(GameHashtable,(handleId),(6)))local real spawnY=(LoadReal(GameHashtable,(handleId),(7)))local real facinglocal integer tickCount=GetTriggerEvalCount(whichTrigger)if tickCount==1 thencall DestroyEffect((LoadEffectHandle(GameHashtable,(handleId),(3))))elseif tickCount==2 thencall DestroyEffect((LoadEffectHandle(GameHashtable,(handleId),(4))))set proximityTrigger=CreateTrigger()set newHandleId=GetHandleId(proximityTrigger)set abilityLevel=(LoadInteger(GameHashtable,(handleId),(5)))set facing=(LoadReal(GameHashtable,(handleId),(1)))set remnantUnit=CreateUnit(GetOwningPlayer((LoadUnitHandle(GameHashtable,(handleId),(2)))),'h07F',spawnX,spawnY,facing)call SetUnitVertexColor(remnantUnit,255,255,255,100)call UnitApplyTimedLife(remnantUnit,'BTLF',12)call SaveUnitHandle(GameHashtable,(handleId),(8),(remnantUnit))call SaveUnitHandle(GameHashtable,(newHandleId),(8),(remnantUnit))call SaveTriggerHandle(GameHashtable,(newHandleId),(9),(whichTrigger))call SaveInteger(GameHashtable,(newHandleId),(5),(abilityLevel))call TriggerRegisterUnitInRange(proximityTrigger,remnantUnit,235,Condition(function FilterAlwaysTrue))call TriggerRegisterUnitEvent(proximityTrigger,remnantUnit,EVENT_UNIT_DEATH)call TriggerAddCondition(proximityTrigger,Condition(function OnStaticRemnantProximityDetonate))call DestroyEffect(AddSpecialEffectTarget("effects\\ManaFlareBoltImpact_NoSound.mdx",remnantUnit,"origin"))elseif tickCount>2 thenset remnantUnit=(LoadUnitHandle(GameHashtable,(handleId),(8)))call DestroyEffect(AddSpecialEffectTarget("effects\\ManaFlareBoltImpact_NoSound.mdx",remnantUnit,"origin"))endifset whichTrigger=nullset proximityTrigger=nullset remnantUnit=nullreturn falseendfunctionfunction OnStaticRemnantCast takes nothing returns nothinglocal unit casterUnit=GetTriggerUnit()local trigger spawnTrigger=CreateTrigger()local integer triggerId=GetHandleId(spawnTrigger)local real casterX=GetUnitX(casterUnit)local real casterY=GetUnitY(casterUnit)call TriggerRegisterTimerEvent(spawnTrigger,.5,true)call TriggerAddCondition(spawnTrigger,Condition(function OnStaticRemnantSpawnTick))call SaveReal(GameHashtable,(triggerId),(6),((casterX)*1.0))call SaveReal(GameHashtable,(triggerId),(7),((casterY)*1.0))call SaveInteger(GameHashtable,(triggerId),(5),(GetUnitAbilityLevel(casterUnit,'A14P')))call SaveUnitHandle(GameHashtable,(triggerId),(2),(casterUnit))call SaveReal(GameHashtable,(triggerId),(1),((GetUnitFacing(casterUnit))*1.0))call SaveEffectHandle(GameHashtable,(triggerId),(3),(AddSpecialEffect("Abilities\\Spells\\Orc\\LightningShield\\LightningShieldTarget.mdl",casterX,casterY)))call SaveEffectHandle(GameHashtable,(triggerId),(4),(AddSpecialEffect("effects\\Static_Remnant_FX.mdx",casterX,casterY)))set casterUnit=nullset spawnTrigger=nullendfunctionfunction OnStaticRemnantSpellEffect takes nothing returns booleanif GetSpellAbilityId()=='A14P' thencall OnStaticRemnantCast()endifreturn falseendfunctionfunction InitStaticRemnantTrigger takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(t,Condition(function OnStaticRemnantSpellEffect))set t=nullendfunctionfunction OnMagicLeashPullTick takes nothing returns booleanlocal trigger thisTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(thisTrigger)local unit pulledUnit=(LoadUnitHandle(GameHashtable,(triggerId),(17)))local real angle=(LoadReal(GameHashtable,(triggerId),(13)))local real newX=0local real newY=0local integer abilityLevel=(LoadInteger(GameHashtable,(triggerId),(5)))local real anchorX=(LoadReal(GameHashtable,(triggerId),(6)))local real anchorY=(LoadReal(GameHashtable,(triggerId),(7)))if pulledUnit==null or GetUnitTypeId(pulledUnit)<1 thencall FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(thisTrigger)set thisTrigger=nullset pulledUnit=nullreturn falseendifset newX=GetUnitX(pulledUnit)-5*Cos(angle)set newY=GetUnitY(pulledUnit)-5*Sin(angle)if((anchorX-newX)*(anchorX-newX))+((anchorY-newY)*(anchorY-newY))<100 thenset newX=anchorXset newY=anchorYendifcall SetUnitX(pulledUnit,newX)call SetUnitY(pulledUnit,newY)if GetTriggerEvalCount(thisTrigger)==(10+10*abilityLevel)or GetTriggerEventId()==EVENT_UNIT_DEATH thencall FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(thisTrigger)endifset thisTrigger=nullset pulledUnit=nullreturn falseendfunctionfunction OnMagicLeashCast takes nothing returns nothinglocal unit casterUnit=GetTriggerUnit()local unit targetUnit=GetSpellTargetUnit()local unit dummyUnit=CreateUnit(GetOwningPlayer(casterUnit),'u00X',GetUnitX(casterUnit),GetUnitY(casterUnit),GetUnitFacing(casterUnit))local integer abilityLevel=GetUnitAbilityLevel(casterUnit,'A14R')local trigger pullTrigger=CreateTrigger()local integer triggerId=GetHandleId(pullTrigger)call TriggerRegisterTimerEvent(pullTrigger,.05,true)call TriggerRegisterUnitEvent(pullTrigger,targetUnit,EVENT_UNIT_DEATH)call TriggerAddCondition(pullTrigger,Condition(function OnMagicLeashPullTick))call SaveUnitHandle(GameHashtable,(triggerId),(17),(targetUnit))call SaveReal(GameHashtable,(triggerId),(13),Atan2(GetUnitY(targetUnit)-GetUnitY(casterUnit),GetUnitX(targetUnit)-GetUnitX(casterUnit)))call SaveInteger(GameHashtable,(triggerId),(5),(abilityLevel))call SaveReal(GameHashtable,(triggerId),(6),((GetUnitX(casterUnit))*1.0))call SaveReal(GameHashtable,(triggerId),(7),((GetUnitY(casterUnit))*1.0))call AddPermanentAbility(dummyUnit,'A14Q')call SetUnitAbilityLevel(dummyUnit,'A14Q',abilityLevel)call IssueTargetOrder(dummyUnit,"magicleash",targetUnit)if not IsPlayerPlayingComputer(GetOwningPlayer(casterUnit))thencall UnitApplyTimedLife(dummyUnit,'BTLF',.5+.5*abilityLevel)endifset dummyUnit=CreateUnit(GetOwningPlayer(casterUnit),'e00E',GetUnitX(casterUnit),GetUnitY(casterUnit),GetUnitFacing(casterUnit))call AddPermanentAbility(dummyUnit,'A14S')call IssueTargetOrderById(dummyUnit,852075,casterUnit)set casterUnit=nullset targetUnit=nullset dummyUnit=nullset pullTrigger=nullendfunctionfunction OnMagicLeashSpellEffect takes nothing returns booleanif GetSpellAbilityId()=='A14R' and GetUnitTypeId(GetSpellTargetUnit())!='n00L' and HasAnyMarkedAbility(GetSpellTargetUnit())==false thencall OnMagicLeashCast()endifreturn falseendfunctionfunction InitMagicLeashTrigger takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(t,Condition(function OnMagicLeashSpellEffect))set t=nullendfunctionfunction EnumA0S5AoeDamage takes nothing returns nothinglocal unit dummyCaster=CreateUnit(GetOwningPlayer(SummonOwnerUnit_2),'e00E',GetUnitX(GetEnumUnit()),GetUnitY(GetEnumUnit()),0)call AddPermanentAbility(dummyCaster,'A0S5')call IssueTargetOrderById(dummyCaster,852075,GetEnumUnit())call DamageTargetByType(SummonOwnerUnit_2,GetEnumUnit(),DamageType1,EnumDamageAmountA0QW)set dummyCaster=nullendfunctionfunction DetonateEmpoweredThunderclap takes unit sourceUnit,unit targetUnit returns nothinglocal integer sourceId=GetHandleId(sourceUnit)local group enemyGroup=AcquireGroupFromPool()call DestroyEffect((LoadEffectHandle(GameHashtable,(sourceId),(200))))call DestroyEffect((LoadEffectHandle(GameHashtable,(sourceId),(201))))call SaveInteger(GameHashtable,(GetHandleId((sourceUnit))),((4264)),(2))set FilterReferenceUnit_2=sourceUnitset SummonOwnerUnit_2=sourceUnitset EnumDamageAmountA0QW=GetUnitAbilityLevel(sourceUnit,'A0QW')*20+10call GroupEnumUnitsInRange(enemyGroup,GetUnitX(targetUnit),GetUnitY(targetUnit),300,Condition(function FilterAttackableEnemy))call ForGroup(enemyGroup,function EnumA0S5AoeDamage)call ReleaseGroupToPool(enemyGroup)call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",GetUnitX(targetUnit),GetUnitY(targetUnit)))set enemyGroup=nullendfunctionfunction OnEmpoweredAttackDamageOrTimeout takes nothing returns booleanlocal trigger eventTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(eventTrigger)local integer targetIndex=(LoadInteger(GameHashtable,(triggerId),(30)))local unit targetUnit=UnitByIndex(targetIndex)local unit casterUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local trigger linkedTrigger=(LoadTriggerHandle(GameHashtable,(triggerId),(202)))if GetTriggerEventId()==EVENT_UNIT_DAMAGED thenif GetEventDamageSource()==casterUnit and((LoadInteger(GameHashtable,(GetHandleId((casterUnit))),((4264))))==1)==true thencall DisableTrigger(eventTrigger)call DetonateEmpoweredThunderclap(casterUnit,targetUnit)call ClearUnitHandleSlot(targetIndex)call FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(eventTrigger)call FlushChildHashtable(GameHashtable,GetHandleId(linkedTrigger))call RecycleExpiringTrigger(linkedTrigger)endifelsecall ClearUnitHandleSlot(targetIndex)call FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(eventTrigger)endifset eventTrigger=nullset targetUnit=nullset casterUnit=nullset linkedTrigger=nullreturn falseendfunctionfunction ArmEmpoweredAttackDamageWatch takes nothing returns nothinglocal trigger watchTrigger=CreateTrigger()local unit targetUnit=GetTriggerUnit()local unit attackerUnit=GetAttacker()local integer triggerId=GetHandleId(watchTrigger)call TriggerRegisterUnitEvent(watchTrigger,targetUnit,EVENT_UNIT_DAMAGED)call TriggerRegisterTimerEvent(watchTrigger,2.5,false)call TriggerAddCondition(watchTrigger,Condition(function OnEmpoweredAttackDamageOrTimeout))call SaveInteger(GameHashtable,(triggerId),(30),(RegisterUnitHandleSlot(targetUnit)))call SaveUnitHandle(GameHashtable,(triggerId),(2),(attackerUnit))call SaveTriggerHandle(GameHashtable,(triggerId),(202),(GetTriggeringTrigger()))set watchTrigger=nullset targetUnit=nullset attackerUnit=nullendfunctionfunction OnEmpoweredCarrierAttack takes nothing returns booleanif GetAttacker()==(LoadUnitHandle(GameHashtable,(GetHandleId(GetTriggeringTrigger())),(2)))and IsUnitType(GetTriggerUnit(),UNIT_TYPE_STRUCTURE)==false and IsUnitAlly(GetAttacker(),GetOwningPlayer(GetTriggerUnit()))==false thencall ArmEmpoweredAttackDamageWatch()endifreturn falseendfunctionfunction AttachEmpowerHandEffectsAndWatchAttacks takes nothing returns nothinglocal trigger attackTrigger=CreateTrigger()local unit carrierUnit=GetTriggerUnit()local integer unitId=GetHandleId(carrierUnit)local string effectPath=""if IsUnitAlly(carrierUnit,GetLocalPlayer())or IsEitherKeyPlayerActive(GetLocalPlayer())thenset effectPath="Abilities\\Weapons\\FarseerMissile\\FarseerMissile.mdl"endifcall SaveEffectHandle(GameHashtable,(unitId),(200),(AddSpecialEffectTarget(effectPath,carrierUnit,"right hand")))call SaveEffectHandle(GameHashtable,(unitId),(201),(AddSpecialEffectTarget(