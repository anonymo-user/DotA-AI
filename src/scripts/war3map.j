trlocal integer stolenIntlocal real durationif primaryAttribute==2 thenset stolenAgi=IMinBJ(GetHeroAgi(targetUnit,false)-1,1)set stolenStr=IMinBJ(GetHeroStr(targetUnit,false)-1,1)set stolenInt=IMinBJ(GetHeroInt(targetUnit,false)-1,1)elseif primaryAttribute==3 thenset stolenAgi=IMinBJ(GetHeroAgi(targetUnit,false)-1,1)set stolenStr=IMinBJ(GetHeroStr(targetUnit,false)-1,1)set stolenInt=IMinBJ(GetHeroInt(targetUnit,false)-1,1)elseif primaryAttribute==1 thenset stolenAgi=IMinBJ(GetHeroAgi(targetUnit,false)-1,1)set stolenStr=IMinBJ(GetHeroStr(targetUnit,false)-1,1)set stolenInt=IMinBJ(GetHeroInt(targetUnit,false)-1,1)endifcall SetHeroAgi(caster,GetHeroAgi(caster,false)+stolenAgi+stolenInt+stolenStr,true)call SetHeroAgi(targetUnit,GetHeroAgi(targetUnit,false)-stolenAgi,true)call SetHeroStr(targetUnit,GetHeroStr(targetUnit,false)-stolenStr,true)call SetHeroInt(targetUnit,GetHeroInt(targetUnit,false)-stolenInt,true)call SaveInteger(GameHashtable,(triggerId),(422),(stolenAgi))call SaveInteger(GameHashtable,(triggerId),(424),(stolenInt))call SaveInteger(GameHashtable,(triggerId),(423),(stolenStr))call SaveUnitHandle(GameHashtable,(triggerId),(2),(caster))call SaveUnitHandle(GameHashtable,(triggerId),(17),(targetUnit))call SaveBoolean(GameHashtable,(triggerId),(276),(false))call SaveBoolean(GameHashtable,(triggerId),(277),(false))if abilityLevel==1 thenset duration=15elseif abilityLevel==2 thenset duration=30elseif abilityLevel==3 thenset duration=60elseif abilityLevel==4 thenset duration=120endifcall TriggerRegisterTimerEvent(expireTrigger,duration,false)call TriggerRegisterUnitEvent(expireTrigger,caster,EVENT_UNIT_DEATH)call TriggerRegisterUnitEvent(expireTrigger,targetUnit,EVENT_UNIT_DEATH)call TriggerAddCondition(expireTrigger,Condition(function OnStatStealExpireRevert))set expireTrigger=nullendfunctionfunction OnStatStealDelayedApply takes nothing returns booleanlocal trigger applyTrigger=GetTriggeringTrigger()local integer trigH