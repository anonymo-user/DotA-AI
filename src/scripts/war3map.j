argeTrigger,0.001,true)call TriggerRegisterUnitEvent(chargeTrigger,caster,EVENT_UNIT_DEATH)call TriggerRegisterUnitEvent(chargeTrigger,targetUnit,EVENT_UNIT_DEATH)call TriggerAddCondition(chargeTrigger,Condition(function ChargeToTargetTimer))call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'A179',false)set chargeTrigger=nullset caster=nullset targetUnit=nullendfunctionfunction PlaySpellMorphAnimTimer takes nothing returns booleanlocal trigger triggerRef=GetTriggeringTrigger()local integer trigHandleId=GetHandleId(triggerRef)local unit whichUnit=(LoadUnitHandle(GameHashtable,(trigHandleId),(2)))call SetUnitAnimation(whichUnit,"spell morph")call FlushChildHashtable(GameHashtable,(trigHandleId))call RecycleExpiringTrigger(triggerRef)set triggerRef=nullset whichUnit=nullreturn falseendfunctionfunction RevokeChargeVisionTimer takes nothing returns booleanlocal trigger visionTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(visionTrigger)local unit ownerUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local unit visionUnit=(LoadUnitHandle(GameHashtable,(triggerId),(17)))call UnitShareVision(visionUnit,GetOwningPlayer(ownerUnit),false)call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(visionTrigger)set visionTrigger=nullset ownerUnit=nullset visionUnit=nullreturn falseendfunctionfunction BeginChargeChannelSetup takes nothing returns nothinglocal trigger timerTrig=CreateTrigger()local integer trigHandleId=GetHandleId(timerTrig)local unit casterUnit=GetTriggerUnit()call SaveUnitHandle(GameHashtable,(trigHandleId),(2),(casterUnit))call TriggerRegisterTimerEvent(timerTrig,0.,true)call TriggerAddCondition(timerTrig,Condition(function PlaySpellMorphAnimTimer))set timerTrig=CreateTrigger()set trigHandleId=GetHandleId(timerTrig)call SaveUnitHandle(GameHashtable,(trigHandleId),(2),(casterUnit))call SaveUnitHandle(GameHashtable,(trigHandleId),(17),(GetSpellTargetUnit()))call TriggerRegisterTimerEvent(timerTrig,1.,true)call TriggerAddCondition(timerTrig,Condition(function RevokeChargeVisionTimer))call UnitShareVision(GetSpellTargetUnit(),GetOwningPlayer(casterUnit),true)set timerTrig=nullset casterUnit=nullendfunctionfunction DispatchChargeSpellEvent takes nothing returns booleanif(GetSpellAbilityId()=='A0G4' or GetSpellAbilityId()=='A1D8')and HasAnyMarkedAbility(GetSpellTargetUnit())==false thenif GetTriggerEventId()==EVENT_PLAYER_UNIT_SPELL_EFFECT thencall BeginChargeToTarget()elsecall BeginChargeChannelSetup()endifendifreturn falseendfunctionfunction InitChargeSpellTrigger takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_CHANNEL)call TriggerAddCondition(t,Condition(function DispatchChargeSpellEvent))set t=nullendfunctionfunction GrantA275TierAbility takes nothing returns nothinglocal unit whichUnit=GetTriggerUnit()local integer abilityLevel=GetUnitAbilityLevel(whichUnit,'A275')if abilityLevel==1 thencall AddPermanentAbility(whichUnit,'A276')elseif abilityLevel==2 thencall UnitRemoveAbility(whichUnit,'A276')call AddPermanentAbility(whichUnit,'A279')elseif abilityLevel==3 thencall UnitRemoveAbility(whichUnit,'A276')call UnitRemoveAbility(whichUnit,'A279')call AddPermanentAbility(whichUnit,'A277')elseif abilityLevel==4 thencall UnitRemoveAbility(whichUnit,'A276')call UnitRemoveAbility(whichUnit,'A279')call UnitRemoveAbility(whichUnit,'A277')call AddPermanentAbility(whichUnit,'A278')endifset whichUnit=nullendfunctionfunction OnLearnA275Skill takes nothing returns booleanif GetLearnedSkill()=='A275' and IsUnitIllusion(GetTriggerUnit())==false thencall GrantA275TierAbility()endifreturn falseendfunctionfunction InitA275SkillLearnTrigger takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_HERO_SKIL