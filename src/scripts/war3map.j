rPrefix+"Mini Heroes"+"|r:           "+(GetObjectName(('n0EC'))))endifif OnceGuardFlagBS thencall DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,colorPrefix+"Fast Respawn"+"|r:           "+(GetObjectName(('n0DP'))))endifif GameModeSelectedFlag thencall DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,colorPrefix+"Captains Mode"+"|r:           "+(GetObjectName(('n0ED'))))endifif OnceGuardFlagCS thencall DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,colorPrefix+"Experimental Runes"+"|r:           "+(GetObjectName(('n0G6'))))endifif GameModeFlagO1 thencall DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,colorPrefix+"Captains Draft"+"|r:           "+(GetObjectName(('n0GF'))))endifif GameModeFlagF9 thencall DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,colorPrefix+"Normal Mode"+"|r:        "+(GetObjectName(('n07P'))))endifif GameModeFlagZT thencall DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,HighlightColorCode+"Super Tower|r:         Towers regenerate HP")endifif GameModeFlagAT thencall DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,HighlightColorCode+"Modified Super Creeps|r:  An improved version of Super Creeps")endifif GameModeFlagBT thencall DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,HighlightColorCode+"High Exp AI|r:            The AI has increased experience gain.")endifif GameModeFlagLT thencall DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,HighlightColorCode+"Normal Exp AI|r:       The AI receives the default amount of experience.")endifif GameModeFlagEU thencall DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,HighlightColorCode+"Dynamic Exp AI|r:       AI gets bonus exp rate on death or on a period without death/kill/assist. Bonus exp is reduced on kill/assist.")endifif GameModeFlagCT thencall DisplayTimedTextToPlayer(triggerPlayer,0,MessageDisplayY,20,HighlightColorCode+"High Gold AI|r:         