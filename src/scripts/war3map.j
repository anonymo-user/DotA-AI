 and itemIndex<=ItemIndexCost3850B)or(itemIndex==ItemIndexCost4100B)or(itemIndex==ItemIndexCost5675A or itemIndex==ItemIndexCost5675B)or(itemIndex==ItemIndexCost275A or itemIndex==ItemIndexCost275B))endfunctionfunction CanUnitUseOrbOrBuffItem takes integer playerId,unit heroUnit,integer itemTypeIndex returns booleanlocal boolean isOrbEffect=IsOrbEffectItemType(heroUnit,itemTypeIndex)local boolean isBuffPlacer=IsBuffPlacerItemType(heroUnit,itemTypeIndex)local integer unitTypeId=GetUnitTypeId(heroUnit)if(unitTypeId=='EC77')or(unitTypeId=='E004')or(unitTypeId=='U00P')or(unitTypeId=='Nbrn')or(unitTypeId=='Emoo')or(unitTypeId=='N01A')or(unitTypeId=='H00Q')or(unitTypeId=='U006' or unitTypeId=='U00K' or unitTypeId=='Huth')thenreturn(not(isOrbEffect or isBuffPlacer))elseif(unitTypeId=='Edem' or unitTypeId=='Ubal')thenreturn(not(isOrbEffect))elseif(unitTypeId=='Udea' or unitTypeId=='H00I')thenreturn(not(isBuffPlacer))elseif(PlayerAiFlag[16+playerId]and isOrbEffect)thenreturn falseelseif(PlayerAiFlag[32+playerId]and isBuffPlacer)thenreturn falseelseif(itemTypeIndex==ItemIndexCost225Ranged or itemTypeIndex==ItemIndexCost225Melee)and(unitTypeId=='H06S')thenreturn falseelseif isOrbEffect and GetBooleanByName('CItm',"Orb|"+I2S(GetHandleId(heroUnit)))thenreturn falseelseif isBuffPlacer and GetBooleanByName('CItm',"Buff|"+I2S(GetHandleId(heroUnit)))thenreturn falseendifreturn trueendfunctionfunction IsSendTrackedItemType takes integer itemTypeId returns booleanreturn((itemTypeId==ItemIndexCost2670)or(itemTypeId==ItemIndexCost2700B or itemTypeId==ItemIndexCost3950 or itemTypeId==ItemIndexCost5200)or(itemTypeId==ItemIndexCost5150A or itemTypeId==ItemIndexCost5150B)or(itemTypeId==ItemIndexCost2075)or(itemTypeId==ItemIndexCost5250)or(itemTypeId==ItemIndexCost4700A or itemTypeId==ItemIndexCost4700B)or(itemTypeId==ItemIndexCost3525)or(itemTypeId==ItemIndexCost2300)or(itemTypeId==ItemIndexRecipeA)or(itemTypeId==ItemIndexCost875_3 or itemTypeId==ItemIndexUnclassifiedDF4))endfunctionfunction IsItemTypeHL takes integer itemIndex returns booleanreturn((itemIndex==ItemIndexCost4350))endfunctionfunction IsSellableItemType takes integer playerIndex,integer itemIndex returns booleanif(itemIndex==ItemIndexCost2225A or itemIndex==ItemIndexCost2225B)thenreturn trueelseif(itemIndex==ItemIndexGold150)or(itemIndex==ItemIndexTruesight)or(itemIndex==ItemIndexCost900A or itemIndex==ItemIndexCost900B)or(itemIndex==ItemIndexGold100A or itemIndex==ItemIndexGold100PointUse)or(itemIndex==ItemIndexGold180)or(itemIndex==ItemIndexGold100B)or(itemIndex==ItemIndexGold50)or(itemIndex==ItemIndexGold110)or(itemIndex==ItemIndexGold125)or(itemIndex==ItemIndexGold120)or(itemIndex==ItemIndexGold1000Recipe)or(itemIndex==ItemIndexCost340)thenif(itemIndex==PlayerItemStateData[playerIndex]or itemIndex==PlayerItemStateData[16+playerIndex])thenelsereturn trueendifelseif(itemIndex==ItemIndexCost2050A or itemIndex==ItemIndexRecipeLC)or(itemIndex==ItemIndexCost2300)or(itemIndex==ItemIndexRecipeA)or(itemIndex==ItemIndexCost875_3 or itemIndex==ItemIndexUnclassifiedDF4)thenreturn trueelseif(itemIndex==ItemIndexGold1850A or itemIndex==ItemIndexGold1850B)thenreturn trueelseif(itemIndex>=ItemIndexCost700A and itemIndex<=ItemIndexCost700F)thenreturn trueelseif(itemIndex==ItemIndexGold1200)thenreturn trueelseif(itemIndex==ItemIndexCost200_2)or(itemIndex==ItemIndexCost500_2)or(itemIndex==ItemIndexPurchasableEP4)thenreturn trueelseif(itemIndex==ItemIndexCost225Ranged or itemIndex==ItemIndexCost225Melee)or(itemIndex==ItemIndexCost550Ranged or itemIndex==ItemIndexCost550Melee)thenreturn trueelseif(itemIndex==ItemIndexCost525C or itemIndex==ItemIndexCost485 or itemIndex==ItemIndexCost470)thenreturn trueendifreturn falseendfunctionfunction GetOrSummonAiBearUnit takes unit heroUnit,boolean forceOrder returns unitlocal integer playerId=GetPlayerId(GetOwningPlayer(heroUnit))local unit bearUnitif(not PlayerAiFlag['p'+playerId])thenreturn nullendifset bearUnit=(LoadUnitHandle(GameHashtable,(GetHandleId(Player(playerId))),(333)))if forceOrder thenif(bearUnit==null or GetUnitState(bearUnit,UNIT_STATE_LIFE)<=0)thencall SelectHeroSkill(heroUnit,'A0A5')call PolledWait_2(.1)if IssueImmediateOrderById(heroUnit,852594)thencall PolledWait_2(1.)set bearUnit=(LoadUnitHandle(GameHashtable,(GetHandleId(Player(playerId))),(333)))endifelseif GetUnitTypeId(bearUnit)!='n004' thencall SetUnitX(bearUnit,GetUnitX(heroUnit))call SetUnitY(bearUnit,GetUnitY(heroUnit))endifcall IssueTargetOrderById(bearUnit,851986,heroUnit)endifif(bearUnit==null or GetUnitState(bearUnit,UNIT_STATE_LIFE)<=0)thenset bearUnit=(LoadUnitHandle(GameHashtable,(GetHandleId(Player(playerId))),(334)))if bearUnit==null thenif IsPlayerOnTeamZero(GetOwningPlayer(heroUnit))thenset bearUnit=CreateUnit(Player(playerId),'e01F',-6390,-5615,0)elseset bearUnit=CreateUnit(Player(playerId),'e01F',5875,5000,0)endifcall SaveUnitHandle(GameHashtable,(GetHandleId(Player(playerId))),(334),(bearUnit))endifendifset bj_lastReplacedUnit=bearUnitset bearUnit=nullreturn bj_lastReplacedUnitendfunctionfunction GetOrCreateAiBearDummyUnit takes integer playerId,unit heroUnit,boolean forceSummon returns unitlocal unit dummyUnitlocal unit bearUnitif(not PlayerAiFlag['p'+playerId])thenreturn nullendifset dummyUnit=GetUnitByName(GetHandleId(Player(playerId)),"aiBearDummy")if(dummyUnit==null)thenif IsPlayerOnTeamZero(GetOwningPlayer(heroUnit))thenset dummyUnit=CreateUnit(Player(playerId),'e01F',-6390,-5615,0)elseset dummyUnit=CreateUnit(Player(playerId),'e01F',5875,5000,0)endifcall StoreUnitByName(GetHandleId(Player(playerId)),"aiBearDummy",dummyUnit)call ShowUnit(dummyUnit,true)endifif not(PlayerAiFlag[48+playerId])thenset bearUnit=GetOrSummonAiBearUnit(heroUnit,forceSummon)if not(bearUnit==null or GetUnitState(bearUnit,UNIT_STATE_LIFE)<=0)thencall SetUnitPosition(dummyUnit,GetUnitX(bearUnit),GetUnitY(bearUnit))endifendifset bj_lastReplacedUnit=dummyUnitset bearUnit=nullset dummyUnit=nullreturn bj_lastReplacedUnitendfunctionfunction MirrorHeroItemsToAiBearUnit takes integer playerId,unit heroUnit returns nothinglocal unit bearUnit=GetOrSummonAiBearUnit(heroUnit,false)local item bearItemlocal integer slotIndex=0if bearUnit!=null and GetUnitState(bearUnit,UNIT_STATE_LIFE)>0 thenloopexitwhen slotIndex>5set bj_lastCreatedItem=UnitItemInSlot(heroUnit,slotIndex)if bj_lastCreatedItem!=null thenset bearItem=UnitItemInSlot(bearUnit,slotIndex)if bearItem==null or GetItemTypeId(bj_lastCreatedItem)!=GetItemTypeId(bearItem)thencall RemoveItem(bearItem)set bearItem=CreateItem(GetItemTypeId(bj_lastCreatedItem),GetUnitX(bearUnit),GetUnitY(bearUnit))call SetItemVisible(bearItem,ItemHiddenVisibility)call SetItemPlayer(bearItem,Player(playerId),false)call SetItemCharges(bearItem,GetItemCharges(bj_lastCreatedItem))call SetItemUserData(bearItem,0)call UnitAddItem(bearUnit,bearItem)endifelsecall RemoveItem(UnitItemInSlot(bearUnit,slotIndex))endifset slotIndex=slotIndex+1endloopendifset bearUnit=nullset bearItem=nullendfunctionfunction SyncAndRepositionAiBearDummy takes integer playerId,unit heroUnit returns nothinglocal unit bearUnitlocal integer loopIndex=0if(not PlayerAiFlag[192+playerId])or(PlayerAiFlag[48+playerId])thenreturnendifif(heroUnit!=null)thenif GetUnitTypeId(heroUnit)=='e01F' thenset bearUnit=(LoadUnitHandle(GameHashtable,(GetHandleId(Player(playerId))),(333)))if bearUnit!=null and GetUnitState(bearUnit,UNIT_STATE_LIFE)>0 thencall SetUnitPosition(heroUnit,GetUnitX(bearUnit),GetUnitY(bearUnit))endifendifelseset bearUnit=GetUnitByName(GetHandleId(Player(playerId)),"aiBearDummy")if IsPlayerOnTeamZero(Player(playerId))thencall SetUnitPosition(bearUnit,-6390,-5615)elsecall SetUnitPosition(bearUnit,5875,5000)endifcall MirrorHeroItemsToAiBearUnit(playerId,bearUnit)endifset bearUnit=nullendfunctionfunction FindLowestValueSellableItemSlot takes integer playerId,boolean carriedOnly,boolean mustBeSellable returns integerlocal integer lowestScore=999local integer maxSlot=5local integer slotIndex=0local integer bestSlot=0local integer itemScore=0local integer tempIntif not carriedOnly thenset maxSlot=23endifloopexitwhen(slotIndex>maxSlot)if(HeroInventoryItem[playerId*24+slotIndex]!=null)thenif(HeroItemTypeIndex[playerId*24+slotIndex]==ItemIndexCost500_2 and PlayerItemStateData[144+playerId]!=ShopBuyStateActive)thenelseset itemScore=GetAiItemPriorityScore(playerId,TrackedSideUnit[playerId],HeroInventoryItem[playerId*24+slotIndex],HeroItemTypeIndex[playerId*24+slotIndex],false)if(itemScore<=lowestScore)and(itemScore!=-1)and(itemScore<99)and(not GetBooleanByName('CItm',"NoSell|"+I2S(GetHandleId(TrackedSideUnit[playerId]))+I2S(HeroItemTypeIndex[playerId*24+slotIndex])))and(LoadInteger(AiAbilityDataHashtable,PlayerItemStateData[224+playerId],GetHandleId(HeroInventoryItem[playerId*24+slotIndex]))==0)and(not LoadBoolean(AiAbilityDataHashtable,PlayerItemStateData[256+playerId],GetHandleId(HeroInventoryItem[playerId*24+slotIndex])))thenset lowestScore=itemScoreset bestSlot=slotIndexendifendifendifset slotIndex=slotIndex+1endloopif lowestScore<99 and((not mustBeSellable)or(IsSellableItemType(playerId,HeroItemTypeIndex[playerId*24+bestSlot])))thenreturn bestSlotendifreturn-1endfunctionfunction CountSellableInventoryItems takes integer playerId,boolean includeGroupA returns integerlocal integer slotIndex=0local integer sellableCount=0local integer itemTypeIndex=0local item slotItem=nullloopexitwhen slotIndex>23set slotItem=HeroInventoryItem[playerId*24+slotIndex]set itemTypeIndex=HeroItemTypeIndex[playerId*24+slotIndex]if slotItem==null or(GetWidgetLife(slotItem)<=0)thenset slotItem=nullset itemTypeIndex=0if slotIndex<=5 thenset slotItem=UnitItemInSlot(TrackedSideUnit[playerId],slotIndex)elseif slotIndex<=11 thenset slotItem=UnitItemInSlot(PlayerControlUnit[32+playerId],slotIndex-6)endifendif