wnerUnit returns nothingif IsUnitVisible(observerUnit,GetOwningPlayer(ownerUnit))==false and GetRandomInt(1,100)<10 thencall PlaySoundOnUnitBJ(CryptFiendPissedSound,100,ownerUnit)endifendfunctionfunction EnumRefillBottleCharges takes nothing returns nothinglocal unit bottleCarrier=GetEnumUnit()local integer slotIndex=0loopexitwhen slotIndex>5if IsUnitVisible(GetTriggerUnit(),GetOwningPlayer(GetEnumUnit())) thenif FindItemTypeIndexBaseTables(UnitItemInSlot(bottleCarrier,slotIndex))==ItemIndexCost200_2 or FindItemTypeIndexBaseTables(UnitItemInSlot(bottleCarrier,slotIndex))==ItemIndexCost500_2 thenif FindItemTypeIndexBaseTables(UnitItemInSlot(bottleCarrier,slotIndex))==ItemIndexCost500_2 thenif GetItemCharges(UnitItemInSlot(bottleCarrier,slotIndex))==17 thencall MaybeAlertFullBottleSound(GetTriggerUnit(),bottleCarrier)endifcall StoreBottleChargeState(bottleCarrier,IntMin(GetItemCharges(UnitItemInSlot(bottleCarrier,slotIndex))+1,17))call SetItemCharges(UnitItemInSlot(bottleCarrier,slotIndex),IntMin(GetItemCharges(UnitItemInSlot(bottleCarrier,slotIndex))+1,17))elseif GetItemCharges(UnitItemInSlot(bottleCarrier,slotIndex))==10 thencall MaybeAlertFullBottleSound(GetTriggerUnit(),bottleCarrier)endifcall StoreBottleChargeState(bottleCarrier,IntMin(GetItemCharges(UnitItemInSlot(bottleCarrier,slotIndex))+1,10))call SetItemCharges(UnitItemInSlot(bottleCarrier,slotIndex),IntMin(GetItemCharges(UnitItemInSlot(bottleCarrier,slotIndex))+1,10))endifcall DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\ReplenishMana\\SpiritTouchTarget.mdl",bottleCarrier,"chest"))set slotIndex=5endifendifset slotIndex=slotIndex+1endloopset bottleCarrier=nullendfunctionfunction RefillEnemyHeroBottlesInRange takes nothing returns nothinglocal group nearbyGroup=AcquireGroupFromPool()local unit triggerUnit=GetTriggerUnit()local real unitX=GetUnitX(triggerUnit)local real unitY=GetUnitY(triggerUnit)call GroupEnumUnitsInRange(nearbyGroup,unitX,unitY,1225,C