T_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(GetFilterUnit(),'A04R')!=1 and GetUnitState(GetFilterUnit(),UNIT_STATE_LIFE)>1endfunctionfunction EnumApplyBloodstoneHeal takes nothing returns nothingcall SetUnitState(GetEnumUnit(),UNIT_STATE_LIFE,GetUnitState(GetEnumUnit(),UNIT_STATE_LIFE)+ScratchReal)call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodstoneHealTarget.mdx",GetEnumUnit(),"origin"))endfunctionfunction ApplyBloodstoneDeathHeal takes nothing returns nothinglocal group unitGroup=AcquireGroupFromPool()call GroupEnumUnitsInRange(unitGroup,GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit()),1700,Condition(function FilterBloodstoneHealTarget))set ScratchReal=500+30*GetItemCharges(UnitItemOfType(GetTriggerUnit(),ItemTypeId[ItemIndexCost4900]))call ForGroup(unitGroup,function EnumApplyBloodstoneHeal)call ReleaseGroupToPool(unitGroup)set unitGroup=nullendfunctionfunction SpawnBloodstoneWardAndHeal takes nothing returns nothinglocal unit triggerUnit=GetTriggerUnit()local unit ward=CreateUnit(GetOwningPlayer(triggerUnit),'H00M',GetUnitX(triggerUnit),GetUnitY(triggerUnit),GetUnitFacing(triggerUnit))set PlayerStoredHero[GetPlayerId(GetOwningPlayer(triggerUnit))]=wardcall ApplyBloodstoneDeathHeal()set ward=nullset triggerUnit=nullendfunctionfunction RestoreBloodstoneManaForUnit takes unit whichUnit returns nothinglocal integer charges=GetItemCharges(UnitItemOfType(whichUnit,ItemTypeId[ItemIndexCost4900]))if charges>0 thencall SetUnitState(whichUnit,UNIT_STATE_MANA,GetUnitState(whichUnit,UNIT_STATE_MANA)+charges)endifendfunctionfunction TickBloodstoneManaRegenAllHeroes takes nothing returns booleanlocal integer index=1local unit whichUnitlocal integer playerIdif PendingActionCountB>0 thenloopexitwhen index>5set playerId=GetPlayerId(SentinelPlayer[index])set whichUnit=TrackedSideUnit[playerId]if BuffCounterSO4[playerId]>0 and whichUnit!=null and GetUnitTypeId(whichUnit)>1 and IsUnitType(whichUnit,UNIT_TYPE_DEAD)==false thencall RestoreBloodstoneManaForUnit(whichUnit)endifset playerId=GetPlayerId(ScourgePlayer[index])set whichUnit=TrackedSideUnit[playerId]if BuffCounterSO4[playerId]>0 and whichUnit!=null and GetUnitTypeId(whichUnit)>1 and IsUnitType(whichUnit,UNIT_TYPE_DEAD)==false thencall RestoreBloodstoneManaForUnit(whichUnit)endifset index=index+1endloopendifset whichUnit=nullreturn falseendfunctionfunction IsShieldDamageSourceEligible takes unit whichUnit,real damage returns booleanif IsUnitType(whichUnit,UNIT_TYPE_HERO)or GetUnitAbilityLevel(whichUnit,'A04R')>0 thenreturn damage>5endifreturn trueendfunctionfunction EnumCastForkedLightningAtUnit takes nothing returns nothinglocal unit dummyif g_abilityChargeCounter>0 thenset g_abilityChargeCounter=g_abilityChargeCounter-1set dummy=CreateUnit(GetOwningPlayer(SpawnOwnerUnit),'e00E',GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit()),0)call UnitAddAbility(dummy,'A0K6')call IssueTargetOrder(dummy,"forkedlightning",GetEnumUnit())endifset dummy=nullendfunctionfunction OnLightningShieldDamaged takes nothing returns nothinglocal trigger triggeringTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(triggeringTrigger)local unit dummylocal unit shieldCasterlocal group nearbyGroupif GetTriggerEventId()!=EVENT_UNIT_DAMAGED thencall DestroyEffect((LoadEffectHandle(GameHashtable,(handleId),(32))))call FlushChildHashtable(GameHashtable,handleId)call RecycleExpiringTrigger(triggeringTrigger)elsecall StartUnitFlagTimer(GetTriggerUnit(),4257,1)set shieldCaster=(LoadUnitHandle(GameHashtable,(handleId),(2)))if shieldCaster==null thencall FlushChildHashtable(GameHashtable,handleId)call RecycleExpiringTrigger(triggeringTrigger)set triggeringTrigger=nullreturnendifset dummy=CreateUnit(GetOwningPlayer(shieldCaster),'e00E',GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit()),0)call UnitAddAbility(dummy,'A0K6')set SpawnOwnerUnit=shieldCasterset FilterReferenceUnit_2=shieldCasterset nearbyGroup=AcquireGroupFromPool()call GroupEnumUnitsInRange(nearbyGroup,GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit()),925,Condition(function FilterAttackableEnemy))set g_abilityChargeCounter=5if DistanceBetweenWidgets(GetTriggerUnit(),GetEventDamageSource())<900 thenset g_abilityChargeCounter=g_abilityChargeCounter-1call IssueTargetOrder(dummy,"forkedlightning",GetEventDamageSource())endifcall GroupRemoveUnit(nearbyGroup,GetEventDamageSource())call ForGroup(nearbyGroup,function EnumCastForkedLightningAtUnit)call ReleaseGroupToPool(nearbyGroup)endifset triggeringTrigger=nullset dummy=nullset shieldCaster=nullendfunctionfunction LightningShieldProcCondition takes nothing returns booleanif(GetTriggerEventId()==EVENT_UNIT_DAMAGED and IsShieldDamageSourceEligible(GetEventDamageSource(),GetEventDamage())and GetRandomInt(1,100)<21 and ((LoadInteger(GameHashtable,(GetHandleId((GetTriggerUnit()))),((4257))))==1)==false)or GetTriggerEventId()!=EVENT_UNIT_DAMAGED thencall OnLightningShieldDamaged()endifreturn falseendfunctionfunction ApplyLightningShield takes nothing returns nothinglocal unit caster=GetTriggerUnit()local unit target=GetSpellTargetUnit()local trigger shieldTrigger=CreateTrigger()local integer handleId=GetHandleId(shieldTrigger)if target==null thenset target=casterendifcall StartUnitFlagTimer(target,4279,15)call TriggerRegisterTimerEvent(shieldTrigger,15.,false)call TriggerRegisterUnitEvent(shieldTrigger,target,EVENT_UNIT_DAMAGED)call TriggerAddCondition(shieldTrigger,Condition(function LightningShieldProcCondition))call SaveEffectHandle(GameHashtable,(handleId),(32),(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\LightningShield\\LightningShieldTarget.mdl",target,"origin")))call SaveUnitHandle(GameHashtable,(handleId),(2),(caster))set shieldTrigger=nullset caster=nullset target=nullendfunctionfunction OnLightningShieldSpellCast takes nothing returns nothingif GetSpellAbilityId()=='A0JL' and((LoadInteger(GameHashtable,(GetHandleId((GetSpellTargetUnit()))),((4279))))==1)==false thencall ApplyLightningShield()endifendfunctionfunction IsPickupRestrictedItemType takes integer itemTypeId returns booleanreturn itemTypeId=='I006' or itemTypeId=='I008' or itemTypeId=='I00J' or itemTypeId=='I00K' or itemTypeId=='I007' or itemTypeId=='I0RC'endfunctionfunction ReflectMeleeDamageCondition takes nothing returns booleanif IsUnitType(GetEventDamageSource(),UNIT_TYPE_MELEE_ATTACKER)==true thencall DisableTrigger(GetTriggeringTrigger())call DamageTargetByType(GetEventDamageSource(),GetTriggerUnit(),3,GetEventDamage()*0.5)call EnableTrigger(GetTriggeringTrigger())endifreturn falseendfunctionfunction BlockRestrictedItemPickup takes nothing returns booleanif GetIssuedOrderId()==851971 thenif GetOrderTargetItem()!=null and IsPickupRestrictedItemType(GetItemTypeId(GetOrderTargetItem()))thencall ForceStopUnit(GetTriggerUnit())call ShowErrorMessageToPlayer(GetOwningPlayer(GetTriggerUnit()),GetObjectName('n0LU'))endifendifreturn falseendfunctionfunction RegisterCourierProtectionTriggers takes unit courier returns nothinglocal trigger trig=CreateTrigger()call TriggerRegisterUnitEvent(trig,courier,EVENT_UNIT_ISSUED_TARGET_ORDER)call TriggerAddCondition(trig,Condition(function BlockRestrictedItemPickup))set trig=CreateTrigger()call TriggerRegisterUnitEvent(trig,courier,EVENT_UNIT_DAMAGED)call TriggerAddCondition(trig,Condition(function ReflectMeleeDamageCondition))set trig=nullendfunctionfunction RandomCourierSkinByTeam takes player whichPlayer returns integerlocal integer roll=GetRandomInt(1,6)if IsPlayerOnTeamZero(whichPlayer)thenif roll==1 thenreturn UnitTypeIdN00Ielseif roll==2 thenreturn UnitTypeIdN022elseif roll==3 thenreturn UnitTypeIdN021elseif roll==4 thenreturn UnitTypeIdN0KYelseif roll==5 thenreturn NeutralUnitTypeN0KZelsereturn NeutralUnitTypeN0LEendifelseif roll==1 thenreturn NeutralUnitTypeN023elseif roll==2 thenreturn NeutralUnitTypeN024elseif roll==3 thenreturn NeutralUnitTypeN025elseif roll==4 thenreturn NeutralUnitTypeN0L0elseif roll==5 thenreturn NeutralUnitTypeN0L1elsereturn NeutralUnitTypeN0M4endifendifreturn 0endfunctionfunction RandomAltCourierSkinByTeam takes player whichPlayer returns integerif GetRandomInt(1,3)==1 thenreturn ScaledUnitTypeE02Relseif IsPlayerOnTeamZero(whichPlayer)thenreturn UnitTypeIdE01Helsereturn ElfUnitTypeE01Zendifreturn 0endfunctionfunction SpawnRandomCourier takes nothing returns nothinglocal unit courier=CreateUnit(GetOwningPlayer(GetTriggerUnit()),RandomCourierSkinByTeam(GetOwningPlayer(GetTriggerUnit())),GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit()),GetUnitFacing(GetTriggerUnit()))local real spawnX=GetUnitX(GetTriggerUnit())local real spawnY=GetUnitY(GetTriggerUnit())local real facing=GetUnitFacing(GetTriggerUnit())call InitCourier(courier)call SetUnitPosition(courier,spawnX+25*Cos(facing*bj_DEGTORAD),spawnY+25*Sin(facing*bj_DEGTORAD))if PlayerStateFlagKT[GetPlayerId(GetOwningPlayer(courier))]==false thencall UnitRemoveType(courier,UNIT_TYPE_PEON)elsecall UnitAddType(courier,UNIT_TYPE_PEON)endifset courier=nullendfunctionfunction CrowDeliverItemsToOwner takes unit crow returns nothinglocal integer slotIndex=0local integer crowId=GetHandleId(crow)local integer ownerId=LoadIntByStringKey(crowId,"aiCrow|CurrentOwner")set ScratchInventoryItem=nullcall DisableTrigger(ToggleableTrigger)loopexitwhen slotIndex>5set ScratchInventoryItem=UnitItemInSlot(crow,slotIndex)if ScratchInventoryItem!=null thencall UnitAddItem(PlayerControlUnit[ownerId],ScratchInventoryItem)endifset slotIndex=slotIndex+1endloopcall EnableTrigger(ToggleableTrigger)set PlayerAiFlag[224+ownerId]=falsecall SaveIntByStringKey(crowId,"aiCrow|CurrentOwner",LoadIntByStringKey(crowId,"aiCrow|TrueOwner"))call StoreBooleanByName(crowId,"aiCrow|Active",false)call SaveTriggerByStringKey(crowId,"aiCrow|DeliverTrigger",null)call SaveIntByStringKey(crowId,"aiCrow|GoHomeWpt",0)set AiPlayerTimeThreshold[896+ownerId]=ElapsedGameSeconds+15if(EnableTeamRestrictedControl)thencall SetUnitOwner(PlayerControlUnit[16+ownerId],Player(LoadIntByStringKey(crowId,"aiCrow|TrueOwner")),false)endifendfunctionfunction SendCrowToBase takes unit crow returns nothinglocal real baseXlocal real baseYif GetPlayerTeam(GetOwningPlayer(crow))==0 thenset baseX=GetRectCenterX(BaseCenterRectB)set baseY=GetRectCenterY(BaseCenterRectB)elseset baseX=GetRectCenterX(BaseCenterRectA)set baseY=GetRectCenterY(BaseCenterRectA)endifcall IssuePointOrderById(crow,851986,baseX,baseY)call StoreBooleanByName(GetHandleId(crow),"aiCrow|Away",false)endfunctionfunction CrowAiTick takes nothing returns booleanlocal trigger trig=GetTriggeringTrigger()local unit crow=(LoadUnitHandle(GameHashtable,GetHandleId(trig),(2)))local integer crowId=GetHandleId(crow)local real targetX=0local real targetY=0local effect tempEffect=nulllocal integer waypoint=0local integer index=0local integer ownerId=LoadIntByStringKey(crowId,"aiCrow|CurrentOwner")if IsUnitDeadOrInvalid(crow)==false thenif(not GetBooleanByName(crowId,"aiCrow|Alive"))thencall StoreBooleanByName(crowId,"aiCrow|Alive",true)endifif IsPlayerOnTeamOne(GetOwningPlayer(crow))thenset targetX=NdflSpawnXset targetY=NdflSpawnYelseset targetX=RegenShopTeam0Xset targetY=RegenShopTeam0Yendifif DistanceBetweenCoords(GetUnitX(crow),GetUnitY(crow),targetX,targetY)<800 thenif GetBooleanByName(crowId,"aiCrow|Active")thenif PlayerHeroDead[ownerId]or GetBooleanByName(crowId,"aiCrow|Away")==false thencall CrowDeliverItemsToOwner(crow)if IsPlayerOnTeamOne(GetOwningPlayer(crow))thencall IssuePointOrderById(crow,851986,targetX,targetY)elsecall IssuePointOrderById(crow,851986,targetX,targetY)endifelseif GetUnitCurrentOrder(crow)!=851986 thencall IssueNeutralImmediateOrderById(Player(ownerId),crow,'h085')endifendifendifelseif GetBooleanByName(crowId,"aiCrow|Active")thenif Get