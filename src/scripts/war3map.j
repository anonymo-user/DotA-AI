tem(whichUnit,newItem)if wasAdded==false thencall RemoveItem(newItem)endifreturn wasAddedendfunctionfunction ForceItemIntoInventorySlot takes unit whichUnit,item whichItem,integer targetSlot returns itemlocal real stashX=GetTeamStashCenterX(whichUnit)local real stashY=GetTeamStashCenterY(whichUnit)local integer slotIndex=0local boolean array slotWasFilledlocal item fillerItemloopexitwhen slotIndex>(UnitInventorySize(whichUnit)-1)if UnitItemInSlot(whichUnit,slotIndex)==null and slotIndex!=targetSlot thenset fillerItem=CreateItem('I02M',stashX,stashY)call UnitAddItem(whichUnit,fillerItem)set slotWasFilled[slotIndex]=trueelseset slotWasFilled[slotIndex]=falseendifif slotIndex==targetSlot thencall UnitAddItem(whichUnit,whichItem)endifset slotIndex=slotIndex+1endloopset slotIndex=0loopexitwhen slotIndex>5if slotWasFilled[slotIndex] thencall RemoveItem(UnitItemInSlot(whichUnit,slotIndex))endifset slotIndex=slotIndex+1endloopset TempCreatedItem=whichItemset fillerItem=nullreturn TempCreatedItemendfunctionfunction ConvertInventoryItemFormViaDummyUse takes unit heroUnit,integer newItemFormIndex returns nothinglocal integer slotIndex=0local item slotItemlocal integer itemTypeIndexlocal unit dummyUnitlocal item newItemif IsUnitDeadOrInvalid(heroUnit)thenreturnendifcall DisableTrigger(ToggleableTrigger)if Item5175CarrierCount[GetPlayerId(GetOwningPlayer(heroUnit))]>0 and newItemFormIndex==ItemIndexCost5175A thencall TryAddItemByIdToUnit(heroUnit,'I0HM')endifloopexitwhen slotIndex>5set slotItem=UnitItemInSlot(heroUnit,slotIndex)set itemTypeIndex=FindItemTypeIndexBaseTables(slotItem)if itemTypeIndex==ItemIndexCost5175B or itemTypeIndex==ItemIndexCost5175A thenset ItemOwnerPlayer_2=GetItemPlayer(slotItem)call RemoveItem(slotItem)set dummyUnit=CreateUnit(GetOwningPlayer(heroUnit),'e00E',GetUnitX(heroUnit),GetUnitY(heroUnit),0)call UnitAddAbility(dummyUnit,'AInv')set newItem=UnitAddItemById(dummyUnit,ItemTypeId[newItemFormI