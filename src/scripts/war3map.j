uareRoot((newX-targetX)*(newX-targetX)+(newY-targetY)*(newY-targetY))local real maxDistance=700local real maxHeight=175local real flyHeight=(1-distanceToTarget/ maxDistance)*maxHeight*2local group tempGroup=AcquireGroupFromPool()local unit hitUnitif tickCount==1 thencall SetUnitAnimationByIndex(caster,5)call SetUnitTimeScale(caster,1.5)endifif flyHeight>maxHeight thencall SetUnitAnimationByIndex(caster,5)set flyHeight=maxHeight*2-flyHeightendifcall SetUnitFlyHeight(caster,RealMax(flyHeight,0),0)call SetUnitX(caster,ClampXToPlayableArea(newX))call SetUnitY(caster,ClampYToPlayableArea(newY))call SetUnitFacing(caster,leapAngleDeg)set FilterReferenceUnit_2=castercall GroupEnumUnitsInRange(tempGroup,newX,newY,120,Condition(function FilterEnemyHeroTarget))set hitUnit=FirstOfGroup(tempGroup)call ReleaseGroupToPool(tempGroup)if distanceToTarget<30 or hitUnit!=null or GetTriggerEvalCount(tickTrigger)>75 thencall SetUnitFlyHeight(caster,0,0)call SetUnitFacing(caster,leapAngleDeg)call SetUnitTimeScale(caster,1)call SetUnitAnimation(caster,"stand")call SetUnitPathing(caster,true)call UnitRemoveAbility(caster,'A1J6')call KillTreesInArea(GetUnitX(caster),GetUnitY(caster),100)if hitUnit!=null and UnitHasAnyImmunityAbilityOrFlag(hitUnit)==false thencall StartUnitFlagTimer(hitUnit,4408,5)call StartPounceLeash(caster,hitUnit,abilityLevel)endifcall FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(tickTrigger)endifset tickTrigger=nullset caster=nullset hitUnit=nullset tempGroup=nullreturn falseendfunctionfunction OnCastPounceA1J7 takes nothing returns nothinglocal unit caster=GetTriggerUnit()local integer abilityLevel=GetUnitAbilityLevel(caster,'A1J7')local trigger periodicTrigger=CreateTrigger()local integer triggerId=GetHandleId(periodicTrigger)local real leapRange=700local real facing=GetUnitFacing(caster)local real startX=GetUnitX(caster)local real startY=GetUnitY(caster)local real destX=ClampXToPlayableArea