ClampInt_2(31,waypointOrderCode,39))elseif(((laneDirection==-1)and((PlayerSkillData[256+waypointNum]==60)or(PlayerSkillData[waypointNum]==50)))or(laneDirection==2))thenset waypointOrderCode=49+SideShopSelectionBcall SetHeroLanePushOrRetreatOrders(heroUnit,ClampInt_2(51,waypointOrderCode,59))endifelseset waypointNum=PlayerSkillData[512+waypointNum]if(((laneDirection==-1)and((PlayerSkillData[256+waypointNum]=='v')or(PlayerSkillData[waypointNum]=='n')))or(laneDirection==0))thenset waypointOrderCode='u'-MenuSelectionIndexAcall SetHeroLanePushOrRetreatOrders(heroUnit,ClampInt_2('o',waypointOrderCode,'u'))elseif(((laneDirection==-1)and((PlayerSkillData[256+waypointNum]==140)or(PlayerSkillData[waypointNum]==130)))or(laneDirection==1))thenset waypointOrderCode=139-SideShopSelectionAcall SetHeroLanePushOrRetreatOrders(heroUnit,ClampInt_2(131,waypointOrderCode,139))elseif(((laneDirection==-1)and((PlayerSkillData[256+waypointNum]==160)or(PlayerSkillData[waypointNum]==150)))or(laneDirection==2))thenset waypointOrderCode=159-SideShopSelectionBcall SetHeroLanePushOrRetreatOrders(heroUnit,ClampInt_2(151,waypointOrderCode,159))endifendifendfunctionfunction ResetHeroAndHealAtFountain takes unit heroUnit,unit fountainUnit returns nothinglocal integer playerId=GetPlayerId(GetOwningPlayer(heroUnit))local integer unitTypeId=GetUnitTypeId(heroUnit)local real healDeadline=ElapsedGameSeconds+10if(unitTypeId!='H00J')thenset AiSurroundTargetUnit[16+playerId]=GetSideBaseUnitG8(heroUnit)set AiSurroundTargetUnit[playerId]=GetSideBaseUnitG8(heroUnit)call AssignLaneTargetByTeam(heroUnit,playerId)set AiSlotBoolFlagG0[32+playerId]=trueset AiSlotBoolFlagGZ[playerId]=falseset AiSlotBoolFlagG0[48+playerId]=falseset AiSlotBoolFlagG0[playerId]=falseset AiSlotBoolFlagGZ[160+playerId]=falseset AiPlayerTimeThreshold[864+playerId]=GetRandomReal(-TimeThresholdRandomRange,TimeThresholdRandomRange)call SaveBoolean(GameHashtable,GetHandleId(heroUnit),'DARK',false)call RemoveSavedHandle(GameHashtable,GetHandleId(heroUnit),'DARK')if ElapsedGameSeconds>TimeThresholdSeconds thencall EnableTrigger(PerPlayerAiControlTrigger[128+playerId])endifendifcall RemoveGuardPosition(heroUnit)loopexitwhen((GetUnitLifePercent(heroUnit)>90.)and(GetUnitManaPercent(heroUnit)>85.)and(ElapsedGameSeconds>healDeadline or(ElapsedGameSeconds>PlayerItemStateData[160+playerId])))if(((SentinelDefendFlag)and(IsUnitAlly(heroUnit,SentinelPlayer[0])))or((ScourgeDefendFlag)and(IsUnitAlly(heroUnit,ScourgePlayer[0]))))thenexitwhen((GetUnitLifePercent(heroUnit)>75.)and(GetUnitManaPercent(heroUnit)>25.))endifif(not IsUnitAliveAndValidTarget(heroUnit))thenset PlayerLaneRole[playerId]=1exitwhen trueendifif(IsUnitInRange(heroUnit,fountainUnit,600.))thencall SetUnitLifePercentBJ(heroUnit,RMinBJ(GetUnitLifePercent(heroUnit)+3.,100.))call SetUnitManaPercentBJ(heroUnit,RMinBJ(GetUnitManaPercent(heroUnit)+3.,100.))if(IsUnitOrderInterruptible(heroUnit))thencall IssueTargetOrderById(heroUnit,851971,fountainUnit)endifelseif(not IsUnitAliveAndValidTarget(fountainUnit))thenexitwhen trueendifcall TriggerSleepAction(1.)endloopendfunctionfunction ConsumeTowerDefenseRequirement takes integer towerIndex,unit tower0,unit tower1,unit tower2 returns booleanlocal integer requireCount=0local boolean foundFlag=falseset bj_lastReplacedUnit=nullif(towerIndex==0)thenset bj_lastReplacedUnit=tower0elseif(towerIndex==1)thenset bj_lastReplacedUnit=tower1elseif(towerIndex==2)thenset bj_lastReplacedUnit=tower2elsereturn falseendifset requireCount=LoadIntByStringKey(GetHandleId(bj_lastReplacedUnit),"AI|TowerDef_Require")if(requireCount>0)thencall SaveIntByStringKey(GetHandleId(bj_lastReplacedUnit),"AI|TowerDef_Require",requireCount-1)return trueendifreturn falseendfunctionfunction IsAreaOverwhelmedByEnemies takes unit whichUnit returns booleancall MoveLocation(TempScanLocation,GetUnitX(whichUnit),GetUnitY(whichUnit))return((CountUnitsInRangeOfLoc(1800.,TempScanLocation,Condition(function FilterVisibleAttackableEnemy))-(CountUnitsInRangeOfLoc(1400.,TempScanLocation,Condition(function FilterOtherHealthyAllyHero))*4))>5)endfunctionfunction IsHumanHeroContestingMid takes boolean isScourge returns booleanlocal integer slotLoop=1local player teamPlayerlocal integer teamPidlocal unit humanHerolocal boolean midContested=falselocal rect ownBase=nullif isScourge thenset ownBase=BaseCenterRectAelseset ownBase=BaseCenterRectBendifloopexitwhen slotLoop>5 or midContestedif isScourge thenset teamPlayer=ScourgePlayer[slotLoop]elseset teamPlayer=SentinelPlayer[slotLoop]endifif IsPlayerPlayingUser(teamPlayer)thenset teamPid=GetPlayerId(teamPlayer)set humanHero=TrackedSideUnit[teamPid]if(humanHero!=null)and(not PlayerHeroDead[teamPid])and(GetWidgetLife(humanHero)>.405)and(not IsUnitIllusion(humanHero))thenif(RAbsBJ(GetUnitX(humanHero)-GetUnitY(humanHero))<1500.)and(DistanceUnitToRectCenter(humanHero,ownBase)>=4000.)and((isScourge)or(RectContainsUnit(ScourgeBaseAreaRect,humanHero)==false))thenset midContested=trueendifendifendifset slotLoop=slotLoop+1endloopset humanHero=nullset teamPlayer=nullset ownBase=nullreturn midContestedendfunctionfunction RecountLaneHeroCounts takes nothing returns nothinglocal integer playerIndex=1local integer laneIndex=0loopexitwhen laneIndex>10if(AiSelectionCountData['p'+laneIndex]!=0)thenset AiSelectionCountData[144+laneIndex]=R2I(ElapsedGameSeconds)+AiTaskDelay30SecIntendifset AiSelectionCountData['p'+laneIndex]=0set AiSelectionCountData[128+laneIndex]=0set laneIndex=laneIndex+1endloopset playerIndex=1loopexitwhen playerIndex>11if(TrackedSideUnit[playerIndex]!=null)thencall EvaluateHeroLaneAssignment(playerIndex)endifset playerIndex=playerIndex+1endloopset playerIndex=1loopexitwhen playerIndex>5set laneIndex=GetPlayerId(SentinelPlayer[playerIndex])if((PlayerLaneRole[80+laneIndex]==3)and(PlayerLaneRole[64+laneIndex]<3))or(PlayerLaneRole[64+laneIndex]==5)thenset AiSelectionCountData['p'+PlayerLaneRole[64+laneIndex]]=AiSelectionCountData['p'+PlayerLaneRole[64+laneIndex]]+1elseset AiSelectionCountData['p'+PlayerLaneRole[80+laneIndex]]=AiSelectionCountData['p'+PlayerLaneRole[80+laneIndex]]+1endifif PlayerLaneRole[32+laneIndex]>0 thenset AiSelectionCountData[128+PlayerLaneRole[80+laneIndex]]=AiSelectionCountData[128+PlayerLaneRole[80+laneIndex]]+1endifset laneIndex=GetPlayerId(ScourgePlayer[playerIndex])if((PlayerLaneRole[80+laneIndex]==4)and(PlayerLaneRole[64+laneIndex]<3))or(PlayerLaneRole[64+laneIndex]==5)thenset AiSelectionCountData['p'+6+PlayerLaneRole[64+laneIndex]]=AiSelectionCountData['p'+6+PlayerLaneRole[64+laneIndex]]+1elseset AiSelectionCountData['p'+6+PlayerLaneRole[80+laneIndex]]=AiSelectionCountData['p'+6+PlayerLaneRole[80+laneIndex]]+1endifif PlayerLaneRole[32+laneIndex]>0 thenset AiSelectionCountData[128+6+PlayerLaneRole[80+laneIndex]]=AiSelectionCountData[128+6+PlayerLaneRole[80+laneIndex]]+1endifset playerIndex=playerIndex+1endloopif IsHumanHeroContestingMid(false)thenset AiSelectionCountData['p'+0]=IMaxBJ(AiSelectionCountData['p'+0]+1,2)endifif IsHumanHeroContestingMid(true)thenset AiSelectionCountData['p'+6+0]=IMaxBJ(AiSelectionCountData['p'+6+0]+1,2)endifendfunctionfunction SelectLaneForScourgeHero takes unit heroUnit returns integerlocal integer laneChoice=3local integer playerId=GetPlayerId(GetOwningPlayer(heroUnit))if(Team1SecondaryLaneChoice>=0)thenset laneChoice=Team1SecondaryLaneChoiceelseif(GetHeroLevel(heroUnit)<6)thenset laneChoice=PlayerLaneRole[64+playerId]elseif(GetHeroLevel(heroUnit)>=AiHeroLevelThresholdB)thenif(ScourgeDefendFlag and AiSelectionCountData[64+playerId]>=0)thenset laneChoice=SelectIntByFlag(AiSelectionCountData[64+playerId]==3,0,AiSelectionCountData[64+playerId])elseif(Team1PrimaryLaneChoice>=0)thenset laneChoice=Team1PrimaryLaneChoiceendifendifif(laneChoice==3)thenset bj_lastLoadedUnit=heroUnitif(ConsumeTowerDefenseRequirement(Team2LaneATowerTierDestroyed,LaneTowerJX,GuardTowerJA4,GuardTowerJ34))thenset laneChoice=0elseif(ConsumeTowerDefenseRequirement(Team2LaneCTowerTierDestroyed,LaneTowerJY,GuardTowerJB4,GuardTowerJ64))thenset laneChoice=2elseif(ConsumeTowerDefenseRequirement(Team2LaneBTowerTierDestroyed,LaneTowerJW,LaneTowerJZ,GuardTowerJC4))thenset laneChoice=1elseif(IsSlotValueThreeAboveOther(playerId))thenif(AiSelectionCountData['p'+6+0]==1)thenset laneChoice=0elseif(AiSelectionCountData['p'+6+1]==1)thenif((AiSelectionCountData['p'+6+2]==0)or(GetRandomInt(1,2)==1))thenset laneChoice=1elseset laneChoice=2endifendifelseif(((AiSelectionCountData['p'+6+0]==0)and(AiSelectionCountData[128+0]>0))or((AiSelectionCountData[128+0]-AiSelectionCountData['p'+6+0])>1))thenset laneChoice=0elseif((AiSelectionCountData[128+1]-AiSelectionCountData['p'+6+1])>1)thenset laneChoice=1elseif((AiSelectionCountData[128+2]-AiSelectionCountData['p'+6+2])>1)thenset laneChoice=2elseif((AiSelectionCountData['p'+6+1]==0)and(AiSelectionCountData[128+1]>0))thenif((AiSelectionCountData['p'+6+2]>0)or(AiSelectionCountData[128+2]==0)or(GetRandomInt(1,2)==1))thenset laneChoice=1elseset laneChoice=2endifelseif((AiSelectionCountData['p'+6+2]==0)and(AiSelectionCountData[128+2]>0))thenset laneChoice=2elseif(AiSelectionCountData['p'+6+0]==0)thenset laneChoice=0elseif(AiSelectionCountData['p'+6+1]==0)thenif((AiSelectionCountData['p'+6+2]>0)or(GetRandomInt(1,2)==1))thenset laneChoice=1elseset laneChoice=2endifelseif(AiSelectionCountData['p'+6+2]==0)thenset laneChoice=2endifelseif((GetHeroLevel(heroUnit)>13)and(Team1SecondaryLaneChoice<0)and(Team1PrimaryLaneChoice>=0)and(laneChoice==Team1PrimaryLaneChoice)and((AiSelectionCountData[128+laneChoice])-AiSelectionCountData['p'+6+laneChoice]>=0))thenif((laneChoice!=0)and(Team2LaneATowerTierDestroyed>=2)and(IsAreaOverwhelmedByEnemies(CandidateUnitByIndex[17])))thenset laneChoice=0elseif((laneChoice!=1)and(Team2LaneBTowerTierDestroyed>=2)and(IsA