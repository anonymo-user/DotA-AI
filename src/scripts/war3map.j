nent[itemIndex])thenset candidateCount=candidateCount+1if(GetRandomInt(1,candidateCount)==1)thenset chosenItemType=ITEM_TYPE_PERMANENTset chosenItemId=itemIndexendifendifif(bj_stockAllowedCharged[itemIndex])thenset candidateCount=candidateCount+1if(GetRandomInt(1,candidateCount)==1)thenset chosenItemType=ITEM_TYPE_CHARGEDset chosenItemId=itemIndexendifendifif(bj_stockAllowedArtifact[itemIndex])thenset candidateCount=candidateCount+1if(GetRandomInt(1,candidateCount)==1)thenset chosenItemType=ITEM_TYPE_ARTIFACTset chosenItemId=itemIndexendifendifset itemIndex=itemIndex+1exitwhen itemIndex>10endloopif(candidateCount==0)thenset chosenItemType=nullreturnendifcall AddStockItemToAllMarketplaces(chosenItemType,chosenItemId)set chosenItemType=nullendfunctionfunction StartStockRestockTimer takes nothing returns nothingcall PerformRandomStockRestock()call TimerStart(bj_stockUpdateTimer,bj_STOCK_RESTOCK_INTERVAL,true,function PerformRandomStockRestock)endfunctionfunction OnDeferredPlayerItemCreateExpire takes nothing returns booleanlocal trigger triggerHandle=GetTriggeringTrigger()local integer handleId=GetHandleId(triggerHandle)local integer itemTypeId=(LoadInteger(GameHashtable,(handleId),(74)))local real itemX=(LoadReal(GameHashtable,(handleId),(6)))local real itemY=(LoadReal(GameHashtable,(handleId),(7)))local player ownerPlayer=(LoadPlayerHandle(GameHashtable,(handleId),(54)))local boolean setChargesFlag=(LoadBoolean(GameHashtable,(handleId),(75)))local integer chargeCount=(LoadInteger(GameHashtable,(handleId),(76)))local item createdItem=CreateItem(itemTypeId,itemX,itemY)call SetItemPlayer(createdItem,ownerPlayer,true)call SetItemUserData(createdItem,0)if setChargesFlag thencall SetItemCharges(createdItem,chargeCount)endifcall FlushChildHashtable(GameHashtable,handleId)call RecycleExpiringTrigger(triggerHandle)set PlayerLaneRole[512+GetPlayerId(ownerPlayer)]=3set HeroInventoryItem[288+GetPlayerId(ownerPlayer)]=createdIt