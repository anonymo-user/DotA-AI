itY=GetUnitY(targetUnit)set StoredUnitHandle=targetUnitif isEmpowered thencall SetUnitAbilityLevel(conjurerUnit,'A0QL',3+abilityLevel)call IssueTargetOrderById(conjurerUnit,852274,targetUnit)call DamageTargetByType(conjurerUnit,targetUnit,DamageType1,150)elsecall IssueTargetOrderById(conjurerUnit,852274,targetUnit)call DamageTargetByType(conjurerUnit,targetUnit,DamageType1,150)endifcall UnitApplyTimedLife(effectDummy,'BTLF',.5)call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl",GetUnitX(targetUnit),GetUnitY(targetUnit)))set conjurerUnit=nullset targetUnit=nullset effectDummy=nullreturn falseendfunctionfunction OnHeroEnterConjurerRangeNormal takes nothing returns booleanlocal group gif IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO) and IsUnitEnemy(GetFilterUnit(),GetOwningPlayer((LoadUnitHandle(GameHashtable,(GetHandleId(GetTriggeringTrigger())),(259)))))and IsSkillAnnounceExemptUnit(GetUnitTypeId(GetFilterUnit()))==false thenset g=(LoadGroupHandle(GameHashtable,(GetHandleId(GetTriggeringTrigger())),(257)))if IsUnitInGroup(GetFilterUnit(),g)==false thencall GroupAddUnit(g,GetFilterUnit())call OrderConjurerStrikeHero(false)endifendifset g=nullreturn falseendfunctionfunction OnHeroEnterConjurerRangeScepter takes nothing returns booleanlocal group gif IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO) and IsUnitEnemy(GetFilterUnit(),GetOwningPlayer((LoadUnitHandle(GameHashtable,(GetHandleId(GetTriggeringTrigger())),(259)))))and IsSkillAnnounceExemptUnit(GetUnitTypeId(GetFilterUnit()))==false thenset g=(LoadGroupHandle(GameHashtable,(GetHandleId(GetTriggeringTrigger())),(257)))if IsUnitInGroup(GetFilterUnit(),g)==false thencall GroupAddUnit(g,GetFilterUnit())call OrderConjurerStrikeHero(true)endifendifset g=nullreturn falseendfunctionfunction OnConjuredImageDeath takes nothing returns booleanlocal trigger deathTrig=GetTriggeringTrigger()local integer trigId=GetHandleId(deathTrig)call GroupRemoveUnit((LoadGroupHandle(GameHashtable,(trigId),(257))),(LoadUnitHandle(GameHashtable,(trigId),(261))))call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl",GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit())))call FlushChildHashtable(GameHashtable,trigId)call DisableTrigger(deathTrig)set deathTrig=nullreturn falseendfunctionfunction OnConjurerSummonImage takes nothing returns booleanlocal unit summonerUnit=GetSummoningUnit()local unit summonedUnit=GetSummonedUnit()local integer summonerId=GetHandleId(summonerUnit)local integer imageCount=(LoadInteger(GameHashtable,(summonerId),(260)))local trigger deathTrigger=CreateTrigger()call SetUnitVertexColor(summonedUnit,255,255,255,100)call TriggerRegisterUnitEvent(deathTrigger,summonedUnit,EVENT_UNIT_DEATH)call TriggerAddCondition(deathTrigger,Condition(function OnConjuredImageDeath))call SaveGroupHandle(GameHashtable,(GetHandleId(deathTrigger)),(257),((LoadGroupHandle(GameHashtable,(summonerId),(257)))))call SaveUnitHandle(GameHashtable,(GetHandleId(deathTrigger)),(261),(StoredUnitHandle))set imageCount=imageCount+1call SaveInteger(GameHashtable,(summonerId),(260),(imageCount))call SaveInteger(GameHashtable,(summonerId),(2800+imageCount),(RegisterUnitHandleSlot(summonedUnit)))call SaveTriggerHandle(GameHashtable,(summonerId),(2900+imageCount),(deathTrigger))call SetUnitX(summonedUnit,SavedUnitX)call SetUnitY(summonedUnit,SavedUnitY)set summonerUnit=nullset summonedUnit=nullset deathTrigger=nullreturn falseendfunctionfunction EnumRemoveConjurerBarrierUnit takes nothing returns nothingcall RemoveUnit(GetEnumUnit())endfunctionfunction OnConjurerSpellExpireCleanup takes nothing returns booleanlocal trigger cleanupTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(cleanupTrigger)local trigger linkedTrigger=(LoadTriggerHandle(GameHashtable,(triggerId),(255)))local integer linkedTriggerId=GetHandleId(linkedTrigger)local trigger secondaryTrigger=(LoadTriggerHandle(GameHashtable,(linkedTriggerId),(256)))local group barrierGroup=(LoadGroupHandle(GameHashtable,(linkedTriggerId),(257)))local group unitGroup=(LoadGroupHandle(GameHashtable,(linkedTriggerId),(258)))local unit conjurerUnit=(LoadUnitHandle(GameHashtable,(linkedTriggerId),(259)))local integer conjurerId=GetHandleId(conjurerUnit)local integer imageCount=(LoadInteger(GameHashtable,(conjurerId),(260)))local integer unitHandleIdlocal integer loopIndexlocal unit imageUnitcall ForGroup(unitGroup,function EnumRemoveConjurerBarrierUnit)set loopIndex=1loopexitwhen loopIndex>imageCountset unitHandleId=(LoadInteger(GameHashtable,(conjurerId),(2800+loopIndex)))set imageUnit=UnitByIndex(unitHandleId)call FlushChildHashtable(GameHashtable,(GetHandleId((LoadTriggerHandle(GameHashtable,(conjurerId),(2900+loopIndex))))))call RecycleExpiringTrigger((LoadTriggerHandle(GameHashtable,(conjurerId),(2900+loopIndex))))if IsUnitIllusion(imageUnit)thencall DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl",GetUnitX(imageUnit),GetUnitY(imageUnit)))call RemoveUnit(imageUnit)call ClearUnitHandleSlot(unitHandleId)endifset loopIndex=loopIndex+1endloopcall FlushChildHashtable(GameHashtable,triggerId)call FlushChildHashtable(GameHashtable,linkedTriggerId)call FlushChildHashtable(GameHashtable,conjurerId)call RemoveUnit(conjurerUnit)call ReleaseGroupToPool(barrierGroup)call ReleaseGroupToPool(unitGroup)call RecycleExpiringTrigger(linkedTrigger)call RecycleExpiringTrigger(secondaryTrigger)call RecycleExpiringTrigger(cleanupTrigger)set cleanupTrigger=nullset linkedTrigger=nullset secondaryTrigger=nullset barrierGroup=nullset unitGroup=nullset conjurerUnit=nullset imageUnit=nullreturn falseendfunctionfunction OnCastA0QKConjurer takes nothing returns nothinglocal unit caster=GetTriggerUnit()local location targetLoc=GetSpellTargetLoc()local real targetX=GetLocationX(targetLoc)local real targetY=GetLocationY(targetLoc)local real spawnFacing=GetUnitFacing(caster)-45local unit conjurerUnit=CreateUnit(GetOwningPlayer(caster),'h00O',targetX,targetY,spawnFacing)local unit gateUnitlocal real gateXlocal real gateYlocal integer loopIndexlocal real tempReallocal trigger tempTrigger=CreateTrigger()local group imageGroup=AcquireGroupFromPool()local integer triggerId=GetHandleId(tempTrigger)local group gateGroup=AcquireGroupFromPool()local trigger mainTrigger=tempTriggerlocal integer abilityLevel=GetUnitAbilityLevel(caster,'A0QK')local boolean isScepter=falseif abilityLevel==0 thenset isScepter=trueset abilityLevel=GetUnitAbilityLevel(caster,'A21Q')endifcall SetUnitAbilityLevel(conjurerUnit,'A0QL',abilityLevel)call PlaySoundAtPoint(SndSoulGem,targetX,targetY)call SaveGroupHandle(GameHashtable,(triggerId),(257),(imageGroup))call SaveGroupHandle(GameHashtable,(GetHandleId(conjurerUnit)),(257),(imageGroup))call SaveGroupHandle(GameHashtable,(triggerId),(258),(gateGroup))call SaveUnitHandle(GameHashtable,(triggerId),(259),(conjurerUnit))call SaveInteger(GameHashtable,(GetHandleId(conjurerUnit)),(260),(0))set loopIndex=0loopexitwhen loopIndex>39set gateX=targetX+(500-25*loopIndex)*Cos((spawnFacing-45)*bj_DEGTORAD)set gateY=targetY+(500-25*loopIndex)*Sin((spawnFacing-45)*bj_DEGTORAD)set gateUnit=CreateUnit(GetOwningPlayer(caster),'h00P',gateX,gateY,spawnFacing)call SetUnitPathing(gateUnit,false)call SetUnitX(gateUnit,gateX)call SetUnitY(gateUnit,gateY)call GroupAddUnit(gateGroup,gateUnit)call TriggerRegisterUnitInRange(tempTrigger,gateUnit,17,Condition(function FilterAlwaysTrue))set loopIndex=loopIndex+1endloopif isScepter thencall TriggerAddCondition(tempTrigger,Condition(function OnHeroEnterConjurerRangeScepter))elsecall TriggerAddCondition(tempTrigger,Condition(function OnHeroEnterConjurerRangeNormal))endifset tempTrigger=CreateTrigger()call TriggerRegisterUnitEvent(tempTrigger,conjurerUnit,EVENT_UNIT_SUMMON)call TriggerAddCondition(tempTrigger,Condition(function OnConjurerSummonImage))call SaveTriggerHandle(GameHashtable,(triggerId),(256),(tempTrigger))set tempTrigger=CreateTrigger()call TriggerRegisterTimerEvent(tempTrigger,15*abilityLevel,false)call TriggerAddCondition(tempTrigger,Condition(function OnConjurerSpellExpireCleanup))call SaveTriggerHandle(GameHashtable,(GetHandleId(tempTrigger)),(255),(mainTrigger))call RemoveLocation(targetLoc)set caster=nullset targetLoc=nullset gateUnit=nullset tempTrigger=nullset mainTrigger=nullset imageGroup=nullset gateGroup=nullset conjurerUnit=nullendfunctionfunction DispatchA0QKConjurerEffect takes nothing returns booleanif GetSpellAbilityId()=='A0QK' or GetSpellAbilityId()=='A21Q' thencall OnCastA0QKConjurer()endifreturn falseendfunctionfunction InitA0QKConjurerSpell takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(t,Condition(function DispatchA0QKConjurerEffect))set t=nullendfunctionfunction EnumApplyChargeShieldToEnemy takes nothing returns nothingif IsUnitInGroup(GetEnumUnit(),DamageHitFilterGroup)==false and UnitHasAnyImmunityAbilityOrFlag(GetEnumUnit())==false thencall GroupAddUnit(DamageHitFilterGroup,GetEnumUnit())call SetPlayerAbilityAvailable(GetOwningPlayer(GetEnumUnit()),GrantedAbilityId,false)call GrantTimedAbilityPair(GetEnumUnit(),GrantedAbilityId,1,3,'B05Q')call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\SpellShieldAmulet\\SpellShieldCaster.mdl",GetEnumUnit(),"overhead"))endifendfunctionfunction OnA0LKChargeTick takes nothing returns booleanlocal trigger tickTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(tickTrigger)local unit casterUnit=(LoadUnitHandle(GameHashtable,(triggerId),(14)))local real targetX=(LoadReal(GameHashtable,(triggerId),(66)))local real targetY=(LoadReal(GameHashtable,(triggerId),(67)))local real angle=(LoadReal(GameHashtab