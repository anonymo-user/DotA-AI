difset shareTrigger=nullset casterUnit=nullset linkedAlly=nullreturn falseendfunctionfunction OnInnerFireHealTick takes nothing returns booleanlocal trigger eventTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(eventTrigger)local unit caster=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local unit targetUnit=(LoadUnitHandle(GameHashtable,(triggerId),(17)))local integer abilityLevel=(LoadInteger(GameHashtable,(triggerId),(5)))local integer tickCount=(LoadInteger(GameHashtable,(triggerId),(34)))local integer maxTicks=5if caster==null thencall FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(eventTrigger)return falseendifif caster==targetUnit thenset maxTicks=5endifset tickCount=tickCount+1call SaveInteger(GameHashtable,(triggerId),(34),(tickCount))if GetTriggerEventId()==EVENT_WIDGET_DEATH or tickCount>maxTicks thencall UnitRemoveAbility(targetUnit,MorphAbilityIdArray[abilityLevel])call DestroyEffect((LoadEffectHandle(GameHashtable,(triggerId),(32))))call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(eventTrigger)elsecall SetUnitState(targetUnit,UNIT_STATE_LIFE,GetUnitState(targetUnit,UNIT_STATE_LIFE)+20+10*abilityLevel)call CreateTimedEffectOnUnitUntilDeath("Abilities\\Spells\\Orc\\SpiritLink\\SpiritLinkZapTarget.mdl",targetUnit,"chest",1.9)endifset eventTrigger=nullset caster=nullset targetUnit=nullreturn falseendfunctionfunction CastInnerFireHealSteal takes nothing returns nothinglocal unit caster=GetTriggerUnit()local unit targetUnit=GetSpellTargetUnit()local integer abilityLevel=GetUnitAbilityLevel(caster,'A2J2')local trigger healTrigger=CreateTrigger()local integer handleId=GetHandleId(healTrigger)call RemoveRegisteredAbilities(targetUnit)call SetTieredAbilityLevel(targetUnit,0,0)call AddPermanentAbility(targetUnit,MorphAbilityIdArray[abilityLevel])call SetPlayerAbilityAvailable(GetOwningPlayer(targetUnit),MorphAbilityIdArray[abilityLevel],false)c