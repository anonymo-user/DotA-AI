tterImage2)call HideAndDestroyImage(ModeTextLetterImage3)call HideAndDestroyImage(ModeTextLetterImage4)set ModeTextLetterImage1=CreateColoredCenteredImage("Fonts\\B.blp",90,90,baseX-40,baseY,0,true,colorR,colorG,colorB)set ModeTextLetterImage2=CreateColoredCenteredImage("Fonts\\A.blp",90,90,baseX,baseY,0,true,colorR,colorG,colorB)set ModeTextLetterImage3=CreateColoredCenteredImage("Fonts\\N.blp",90,90,baseX+50,baseY,0,true,colorR,colorG,colorB)elseif phaseIndex==6 thenset colorR=pickRedset colorG=pickGreenset colorB=pickBluecall HideAndDestroyImage(ModeTextLetterImage1)call HideAndDestroyImage(ModeTextLetterImage2)call HideAndDestroyImage(ModeTextLetterImage3)set ModeTextLetterImage1=CreateColoredCenteredImage("Fonts\\P.blp",90,90,baseX-60,baseY,0,true,colorR,colorG,colorB)set ModeTextLetterImage2=CreateColoredCenteredImage("Fonts\\I.blp",90,90,baseX-20,baseY,0,true,colorR,colorG,colorB)set ModeTextLetterImage3=CreateColoredCenteredImage("Fonts\\C.blp",90,90,baseX,baseY,0,true,colorR,colorG,colorB)set ModeTextLetterImage4=CreateColoredCenteredImage("Fonts\\K.blp",90,90,baseX+45,baseY,0,true,colorR,colorG,colorB)elseif phaseIndex==7 thencall HideAndDestroyImage(ModeTextLetterImage1)call HideAndDestroyImage(ModeTextLetterImage2)call HideAndDestroyImage(ModeTextLetterImage3)call HideAndDestroyImage(ModeTextLetterImage4)endifendfunctionfunction FormatScoreboardCountString takes integer count,integer teamIndex returns stringif count<0 thenset count=0endifif TimerGetElapsed(GameClockTimer)<15 thenreturn GrayTextColorCode+I2S(count)endifif TeamDisplayMode==3 thenreturn GrayTextColorCode+I2S(count)endifif TeamDisplayMode==1 and teamIndex!=GetTrackedPlayerTeamIndex()thenreturn GrayTextColorCode+I2S(count)elseif TeamDisplayMode==2 and teamIndex!=GetTrackedPlayerTeamIndex()thenreturn GrayTextColorCode+I2S(count)elseif count==0 thenreturn GrayTextColorCode+I2S(count)elseif count<6 thenreturn RedTextColorCode_2+I2S(count)elsereturn I2S(count)endifendfunctionfunction OnTimerRefreshItemMultiboard takes nothing returns booleanlocal multiboarditem boardItemlocal integer indexlocal integer columnlocal integer currentRowlocal integer maxSlot=7local integer rowBase=0set column=1set currentRow=rowBaseset boardItem=MultiboardGetItem(ScoreboardMultiboard_3,column,currentRow)call MultiboardSetItemStyle(boardItem,true,false)call MultiboardSetItemWidth(boardItem,.5)call MultiboardSetItemValue(boardItem,PlayerColorCode[GetPlayerId(SentinelPlayer[1])]+(PlayerName[GetPlayerId((SentinelPlayer[1]))])+"|r")call MultiboardReleaseItem(boardItem)set column=column+2set currentRow=rowBaseset boardItem=MultiboardGetItem(ScoreboardMultiboard_3,column,currentRow)call MultiboardSetItemStyle(boardItem,true,false)call MultiboardSetItemValue(boardItem,StructureNameColorCode+GetObjectName('n0EV'))call MultiboardSetItemWidth(boardItem,.035)call MultiboardReleaseItem(boardItem)set index=0set column=columnset currentRow=rowBase+index+1set boardItem=MultiboardGetItem(ScoreboardMultiboard_3,column,currentRow)call MultiboardSetItemWidth(boardItem,.015)if ScoreboardHeroIdColumnA[index]>0 thencall MultiboardSetItemStyle(boardItem,false,true)call MultiboardSetItemIcon(boardItem,HeroIconPath[ScoreboardHeroIdColumnA[index]])endifcall MultiboardReleaseItem(boardItem)set index=1set currentRow=rowBase+index+1set boardItem=MultiboardGetItem(ScoreboardMultiboard_3,column,currentRow)call MultiboardSetItemWidth(boardItem,.015)if ScoreboardHeroIdColumnA[index]>0 thencall MultiboardSetItemStyle(boardItem,false,true)call MultiboardSetItemIcon(boardItem,HeroIconPath[ScoreboardHeroIdColumnA[index]])endifcall MultiboardReleaseItem(boardItem)set index=2set currentRow=rowBase+index+1set boardItem=MultiboardGetItem(ScoreboardMultiboard_3,column,currentRow)call MultiboardSetItemWidth(boardItem,.015)if ScoreboardHeroIdColumnA[index]>0 thencall MultiboardSetItemStyle(boardItem,false,true)call MultiboardSetItem