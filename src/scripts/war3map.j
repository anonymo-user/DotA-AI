cation(filterX,filterY)local integer alliesAhead=0local integer targetTypeId=GetUnitTypeId(GetFilterUnit())set AllyHealthPercentThreshold=20.call MoveLocation(checkPoint,aheadX,aheadY)set alliesAhead=CountUnitsInRangeOfLoc(600,checkPoint,Condition(function FilterAllyHeroAboveLifePercent))call RemoveLocation(checkPoint)set checkPoint=nullreturn FilterTargetableEnemyHero()and((GetWidgetLife(GetFilterUnit())<50+50*GetUnitAbilityLevel(GetEnumUnit(),'A2UU'))or((HeroMatchesRoleCategory(targetTypeId,HeroRoleCategoryFive)or HeroMatchesRoleCategory(targetTypeId,HeroRoleCategorySix))and(alliesAhead<=1)))endfunctionfunction FindNearestComboTarget takes real lifethres,unit source returns unitreturn LowestLifeUnitInRange(250,source,Or(Condition(function FilterAllyWithMoreAlliesAhead),Condition(function FilterTargetLowLifeOrIsolated)))endfunctionfunction IsUnitTimedMarkActive takes unit whichUnit returns booleanreturn(LoadReal(GameHashtable,(GetHandleId(whichUnit)),(807)))>=TimerGetElapsed(GameClockTimer)endfunctionfunction IsUnitMarkExpiringWithin1p5s takes unit whichUnit returns booleanreturn(LoadReal(GameHashtable,(GetHandleId(whichUnit)),(807)))-TimerGetElapsed(GameClockTimer)<=1.5 and LoadReal(GameHashtable,(GetHandleId(whichUnit)),(807))>=TimerGetElapsed(GameClockTimer)endfunctionfunction IsUnitMarkExpiringWithin3s takes unit whichUnit returns booleanreturn(LoadReal(GameHashtable,(GetHandleId(whichUnit)),(807)))-TimerGetElapsed(GameClockTimer)<=3 and LoadReal(GameHashtable,(GetHandleId(whichUnit)),(807))>=TimerGetElapsed(GameClockTimer)endfunctionfunction FilterUnitWithActiveMark takes nothing returns booleanreturn FilterTargetableEnemyHero()and IsUnitTimedMarkActive(GetFilterUnit())endfunctionfunction FilterIsolatedMarkedTargetFinish takes nothing returns booleanreturn FilterTargetableEnemyHero()and CountUnitsInRangeOfUnit(350,GetFilterUnit(),Condition(function FilterAliveUnitPairType))<1 and IsUnitMarkExpiringWithin1p5s(GetFilterUnit())and(IsHero