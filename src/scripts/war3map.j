ionfunction ScheduleSummonedClonesExpire takes unit casterUnit,integer abilityLevel,unit cloneUnitA,unit cloneUnitB,unit cloneUnitC,unit cloneUnitD returns nothinglocal trigger triggerHandle=CreateTrigger()local integer handleId=GetHandleId(triggerHandle)local real durationset duration=1.5call SaveInteger(GameHashtable,(GetHandleId((casterUnit))),((4299)),(2))call TriggerRegisterTimerEvent(triggerHandle,duration,false)call TriggerAddCondition(triggerHandle,Condition(function OnSummonedClonesExpire))call SaveUnitHandle(GameHashtable,(handleId),(14),(casterUnit))call SaveUnitHandle(GameHashtable,(handleId),(379),(cloneUnitA))call SaveUnitHandle(GameHashtable,(handleId),(380),(cloneUnitB))call SaveUnitHandle(GameHashtable,(handleId),(381),(cloneUnitC))call SaveUnitHandle(GameHashtable,(handleId),(382),(cloneUnitD))set triggerHandle=nullendfunctionfunction FilterDamageValidEnemyInRange takes nothing returns booleanif(IsUnitEnemy(FilterReferenceUnit_2,GetOwningPlayer(GetFilterUnit()))and(GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and IsUnitDeadOrInvalid(GetFilterUnit())==false)and(IsUnitType(GetFilterUnit(),UNIT_TYPE_ANCIENT)==false or IsTargetableAncientType(GetFilterUnit())))thencall DamageTargetByType(DamageSourceUnit_6,GetFilterUnit(),DamageType1,PendingDamageAmount_2)endifreturn falseendfunctionfunction OnA0H0ChannelTick takes nothing returns booleanlocal trigger channelTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(channelTrigger)local unit casterUnit=(LoadUnitHandle(GameHashtable,(handleId),(14)))local unit cloneUnit1=(LoadUnitHandle(GameHashtable,(handleId),(379)))local unit cloneUnit2=(LoadUnitHandle(GameHashtable,(handleId),(380)))local unit cloneUnit3=(LoadUnitHandle(GameHashtable,(handleId),(381)))local unit cloneUnit4=(LoadUnitHandle(GameHashtable,(handleId),(382)))local integer abilityLevel=GetUnitAbilityLevel(casterUnit,'A0H0')local integer tickC