able(GameHashtable,(handleId))call RecycleExpiringTrigger(tickTrigger)endifset tickTrigger=nullset caster=nullreturn falseendfunctionfunction StartA060Replenish takes unit targetUnit returns nothinglocal integer abilityLevel=GetUnitAbilityLevel(targetUnit,'A060')local trigger replenishTrigger=CreateTrigger()local integer triggerId=GetHandleId(replenishTrigger)call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\ReplenishMana\\SpiritTouchTarget.mdl",targetUnit,"origin"))call TriggerRegisterTimerEvent(replenishTrigger,1,true)call TriggerRegisterDeathEvent(replenishTrigger,targetUnit)call TriggerAddCondition(replenishTrigger,Condition(function OnA060ReplenishTick))call SaveUnitHandle(GameHashtable,(triggerId),(2),(targetUnit))if IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO) thencall SaveInteger(GameHashtable,(triggerId),(34),(10))elsecall SaveInteger(GameHashtable,(triggerId),(34),(1))endifset replenishTrigger=nullendfunctionfunction OnDeathStartA060Replenish takes nothing returns booleanif GetUnitAbilityLevel(GetKillingUnit(),'B02R')>0 thencall StartA060Replenish(GetKillingUnit())elseif((LoadInteger(GameHashtable,(GetHandleId((GetTriggerUnit()))),((4333))))==1)thencall StartA060Replenish(ReplenishTargetUnit)endifreturn falseendfunctionfunction RegisterA060DeathTrigger takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_DEATH)call TriggerAddCondition(t,Condition(function OnDeathStartA060Replenish))set t=nullendfunctionfunction OnPQ4ProjectileImpact takes nothing returns nothinglocal integer triggerId=GetHandleId(GetTriggeringTrigger())local unit caster=FilterReferenceUnit_2local unit target=FilterReferenceUnitBlocal real damageAmount=(LoadReal(GameHashtable,(triggerId),(20)))local real healAmount=(LoadReal(GameHashtable,(triggerId),(21)))if IsUnitAlly(target,GetOwningPlayer(caster))thencall SetUnitState(target,UNIT_STATE_LIFE,GetUnitState(target