((GetUnitCurrentOrder(whichUnit)<852000)and(ElapsedGameSeconds>AiPlayerTimeThreshold[832+GetPlayerId(GetOwningPlayer(whichUnit))]))endfunctionfunction CanAICommandUnit takes unit whichUnit returns booleanlocal integer currentOrder=GetUnitCurrentOrder(whichUnit)return((currentOrder<852000)and AlwaysTrue("(GetUnitAbilityLevel(UnitObject,'B01Z')==0)")and(not LoadBoolean(GameHashtable,GetHandleId(whichUnit),'DARK'))and((currentOrder!=851983)or(not AiSlotBoolFlagGZ[48+GetPlayerId(GetOwningPlayer(whichUnit))]))and(ElapsedGameSeconds>AiPlayerTimeThreshold[832+GetPlayerId(GetOwningPlayer(whichUnit))])and(GetUnitAbilityLevel(whichUnit,'B0FG')==0))endfunctionfunction HeroHasNoActiveThreat takes unit whichUnit returns booleanlocal integer playerId=GetPlayerId(GetOwningPlayer(whichUnit))return((AiPrimaryTargetUnit[playerId]==null)and((AiPrimaryTargetUnit[160+playerId]==null)or(GetWidgetLife(AiPrimaryTargetUnit[160+playerId])<=.405)or(not IsUnitInRange(AiPrimaryTargetUnit[160+playerId],whichUnit,1000.)))and(not AiSlotBoolFlagG0[144+playerId]))endfunctionfunction IsUnitExecutingOrder takes unit whichUnit returns booleanlocal integer currentOrder=GetUnitCurrentOrder(whichUnit)local integer unitTypeId=GetUnitTypeId(whichUnit)local integer handleId=GetHandleId(whichUnit)if AiPlayerTimeThreshold[832+GetPlayerId(GetOwningPlayer(whichUnit))]>ElapsedGameSeconds thenreturn falseelseif((currentOrder==851973)or(GetWidgetLife(whichUnit)<=.405)or(IsUnitPaused(whichUnit)))thenreturn falseelseif(currentOrder>852007)and(currentOrder<852014)and((GetItemTypeId(UnitItemInSlot(whichUnit,currentOrder-852007))==ItemTypeId[ItemIndexGold100PointUse])or(GetItemTypeId(UnitItemInSlot(whichUnit,currentOrder-852007))==ItemTypeId[ItemIndexCost2450]))thenreturn falseelseif((currentOrder<852008)and((unitTypeId!='O00J')or((LoadBoolean(GameHashtable,handleId,'DARK')==false))))thenreturn trueelseif(GetUnitAbilityLevel(whichUnit,'B0FG')!=0)thenreturn falseendifreturn((currentOrder>852013)and(currentOrder!=852480)and(currentOrder!=852525)and(currentOrder!=852487)and(currentOrder!=852597)and((unitTypeId!='E01C')or(currentOrder!=852089))and((unitTypeId!='U00K')or(currentOrder!=852581))and((currentOrder!=852600)or((unitTypeId!='Hjai')and(unitTypeId!='Ntin')and(unitTypeId!='Hblm')))and(((unitTypeId!='Eevi')and(unitTypeId!='Eevm')and(unitTypeId!='E02V')and(unitTypeId!='E02W')and(unitTypeId!='E02U'))or(currentOrder!=852189))and((unitTypeId!='N00R')or(currentOrder!=852238))and((unitTypeId!='N0EG')or(currentOrder!=852662))and((unitTypeId!='O015')or(currentOrder!=852581))and(unitTypeId!='N0MD' or currentOrder!=852095))endfunctionfunction IsUnitExecutingOrderExt takes unit unit_2 returns booleanlocal integer currentOrder=GetUnitCurrentOrder(unit_2)local integer unitTypeId=GetUnitTypeId(unit_2)local integer handleId=GetHandleId(unit_2)if AiPlayerTimeThreshold[832+GetPlayerId(GetOwningPlayer(unit_2))]>ElapsedGameSeconds thenreturn falseelseif((currentOrder==851973)or(GetWidgetLife(unit_2)<=.405)or(IsUnitPaused(unit_2)))thenreturn falseelseif(currentOrder>852007)and(currentOrder<852014)and((GetItemTypeId(UnitItemInSlot(unit_2,currentOrder-852007))==ItemTypeId[ItemIndexGold100PointUse])or(GetItemTypeId(UnitItemInSlot(unit_2,currentOrder-852007))==ItemTypeId[ItemIndexCost2450]))thenreturn falseelseif((currentOrder<852008)and((unitTypeId!='O00J')or((LoadBoolean(GameHashtable,handleId,'DARK')==false))))thenreturn trueelseif(currentOrder==852600)and((unitTypeId=='HC49'))thenreturn falseelseif(GetUnitAbilityLevel(unit_2,'B0FG')!=0)thenreturn falseendifreturn((currentOrder>852013)and(currentOrder!=852480)and(currentOrder!=852525)and(currentOrder!=852487)and(currentOrder!=852597)and((unitTypeId!='E01C')or(currentOrder!=852089))and((unitTypeId!='Nfir')or(currentOrder!=852127))and((unitTypeId!='U00K')or(currentOrder!=852581))and((currentOrder!=852553)or((unitTypeId!='H00I')and(unitTypeId!='H00J')))and((currentOrder!=852600)or((unitTypeId!='Hjai')and(unitTypeId!='Ntin')and(unitTypeId!='Hblm')))and(((unitTypeId!='Eevi')and(unitTypeId!='Eevm')and(unitTypeId!='E02V')and(unitTypeId!='E02W')and(unitTypeId!='E02U'))or(currentOrder!=852189))and((unitTypeId!='N00R')or(currentOrder!=852238))and((unitTypeId!='N0EG')or(currentOrder!=852662))and((unitTypeId!='O015')or(currentOrder!=852581))and((unitTypeId!='U00K')or(currentOrder!=852503))and((unitTypeId!='N00B')or(currentOrder!=852514))and(((unitTypeId=='H06X')or(unitTypeId=='H06Y')or(unitTypeId=='H06W'))or(currentOrder!=852248))and(unitTypeId!='N0MD' or currentOrder!=852095)and(unitTypeId!='H00S' or currentOrder!=852526))endfunctionfunction IsUnitCastingKeySpell takes unit unit_2 returns booleanlocal integer currentOrder=GetUnitCurrentOrder(unit_2)local integer unitTypeId=GetUnitTypeId(unit_2)if(currentOrder<852008)thenreturn falseendifreturn((currentOrder<=852013)or(currentOrder==852480)or(currentOrder==852487)or(currentOrder==852597)or((unitTypeId=='O00J')and(AlwaysTrue("GetUnitAbilityLevel(UnitObject,'B01Z')>0"))and LoadBoolean(GameHashtable,GetHandleId(unit_2),'DARK'))or((unitTypeId=='E01C')and(currentOrder==852089))or((unitTypeId=='Nfir')and(currentOrder==852127))or((unitTypeId=='U00K')and(currentOrder==852581))or(((unitTypeId=='Hjai')or(unitTypeId=='Ntin')or(unitTypeId=='Hblm'))and(currentOrder==852600)))endfunctionfunction PlayerFromSlotIndex takes integer slotIndex returns playerif((slotIndex>0)and(slotIndex<6))thenreturn SentinelPlayer[slotIndex]elseif((slotIndex>5)and(slotIndex<11))thenreturn ScourgePlayer[slotIndex-5]endifreturn nullendfunctionfunction PlayerFromSlotString takes string slotString returns playerif slotString=="0" thenset bj_forLoopAIndex=10elseset bj_forLoopAIndex=S2I(slotString)endifif((bj_forLoopAIndex>0)and(bj_forLoopAIndex<6))thenreturn SentinelPlayer[bj_forLoopAIndex]elseif((bj_forLoopAIndex>5)and(bj_forLoopAIndex<11))thenreturn ScourgePlayer[bj_forLoopAIndex-5]endifreturn nullendfunctionfunction SlotIndexOfPlayer takes player whichPlayer returns integerlocal integer slotIndex=1loopexitwhen slotIndex>5if(whichPlayer==SentinelPlayer[slotIndex])thenreturn slotIndexelseif(whichPlayer==ScourgePlayer[slotIndex])thenreturn slotIndex+5endifset slotIndex=slotIndex+1endloopreturn 0endfunctionfunction IsUnitVisibleToTeam takes unit unit_2 returns booleanif IsUnitAlly(unit_2,SentinelPlayer[0])thenreturn IsUnitVisible(unit_2,FirstActiveScourgePlayer)elsereturn IsUnitVisible(unit_2,FirstActiveSentinelPlayer)endifreturn falseendfunctionfunction IsUnitPositionVisibleToTeam takes unit unit_2 returns booleanif IsUnitAlly(unit_2,SentinelPlayer[0])thenreturn IsVisibleToPlayer(GetUnitX(unit_2),GetUnitY(unit_2),FirstActiveScourgePlayer)elsereturn IsVisibleToPlayer(GetUnitX(unit_2),GetUnitY(unit_2),FirstActiveSentinelPlayer)endifreturn falseendfunctionfunction Smaller takes real valueA,real valueB returns realif(valueA<valueB)thenreturn valueAelsereturn valueBendifendfunctionfunction IsUnitAliveAndValidTarget takes unit targetUnit returns booleanreturn(GetWidgetLife(targetUnit)>.405 and((not IsUnitType(targetUnit,UNIT_TYPE_HERO))or(not PlayerHeroDead[GetPlayerId(GetOwningPlayer(targetUnit))])))endfunctionfunction IsHeroFinishableTarget takes unit targetUnit,unit sourceUnit returns booleanlocal integer playerId=GetPlayerId(GetOwningPlayer(sourceUnit))return((IsUnitType(targetUnit,UNIT_TYPE_HERO))and(((R2I(GetWidgetLife(targetUnit))<(250+(GetHeroLevel(targetUnit)*25)))and(GetUnitLifePercent(targetUnit)<Smaller(25.+ElapsedGameSeconds*0.02,85.)))or((AiPlayerTimeThreshold[624+playerId]>ElapsedGameSeconds and AiPrimaryTargetUnit[playerId]==targetUnit)))and(IsUnitAliveAndValidTarget(targetUnit)))endfunctionfunction IsHeroLowHealthOrMana takes unit targetUnit returns booleanreturn((IsUnitType(targetUnit,UNIT_TYPE_HERO))and(R2I(GetWidgetLife(targetUnit))<(250+(GetHeroLevel(targetUnit)*25)))and((GetUnitLifePercent(targetUnit)<Smaller(25.+ElapsedGameSeconds*0.02,85.))or(GetUnitManaPercent(targetUnit)<10.))and(IsUnitAliveAndValidTarget(targetUnit)))endfunctionfunction IsChaseTargetStillValid takes integer playerId returns booleanreturn(AiPlayerTimeThreshold[624+playerId]>ElapsedGameSeconds and AiPrimaryTargetUnit[playerId]!=null)and(not IsHeroLowHealthOrMana(TrackedSideUnit[playerId]))endfunctionfunction UnitHasAnyTrackedAbility takes unit targetUnit returns booleanreturn((GetUnitAbilityLevel(targetUnit,'B0DP')>0)or(GetUnitAbilityLevel(targetUnit,'A0WR')>0)or(GetUnitAbilityLevel(targetUnit,'B02H')>0))endfunctionfunction IsHeroBelowLevelHealthThreshold takes unit targetUnit returns booleanreturn((IsUnitType(targetUnit,UNIT_TYPE_HERO))and(R2I(GetWidgetLife(targetUnit))<(600+(GetHeroLevel(targetUnit)*30)))and(GetWidgetLife(targetUnit)>.405))endfunctionfunction IsHeroFinishableByAttacker takes unit targetUnit,unit attacker returns booleanreturn((IsUnitType(targetUnit,UNIT_TYPE_HERO))and(R2I(GetWidgetLife(targetUnit))<(300+(GetHeroLevel(targetUnit)*30)))and(GetUnitLifePercent(targetUnit)<40.)and(GetWidgetLife(targetUnit)>.405)and(GetUnitState(attacker,UNIT_STATE_LIFE)>(GetUnitState(targetUnit,UNIT_STATE_LIFE)-(10.*GetHeroLevel(attacker)))))endfunctionfunction IsSlotValueThreeAboveOther takes integer playerId returns booleanreturn((PlayerDeaths[playerId]-3)>=PlayerMultiboardStat[playerId])endfunctionfunction IsSlotTargetFinishable takes integer slotIndex returns booleanreturn((AiPrimaryTargetUnit[slotIndex]!=null)and(IsHeroFinishableByAttacker(AiPrimaryTargetUnit[slotIndex],TrackedSideUnit[slotIndex])))endfunctionfunction RandomUnitInRect takes rect rect,boolexpr filter returns unitcall GroupClear(ScratchEnumGroup)call GroupEnumUnitsInRect(ScratchEnumGroup,rect,filter)set bj_groupRandomConsidered=0set bj_groupRandomCurrentPick=nullcall ForGroup(ScratchEnumGroup,function GroupPickRandomUnitEnum)call DestroyBoolExpr(filter)return bj_groupRandomCurrentPickendfunctionfunction AccumulateGroupCountAndLifeEnum takes nothing returns nothingset bj_groupCountUnits=bj_groupCountUnits+1set LifeSumAccumulator=LifeSumAccumulator+GetUnitState(GetEnumUnit(),UNIT_STATE_LIFE)endfunctionfunction CountUnitsOfPlayerMatching takes player player_2,boolexpr filter returns integercall GroupClear(ScratchEnumGroup)call GroupEnumUnitsOfPlayer(ScratchEnumGroup,player_2,filter)set bj_groupCountUnits=0call ForGroup(ScratchEnumGroup,function CountUnitsInGroupEnum)call DestroyBoolExpr(filter)return bj_groupCountUnitsendfunctionfunction RandomUnitInRangeOfLoc takes real radius,location center,boolexpr filter returns unitset bj_groupRandomConsidered=0set bj_groupRandomCurrentPick=nullcall GroupClear(RandomUnitPickEnumGroup)call GroupEnumUnitsInRangeOfLoc(RandomUnitPickEnumGroup,center,radius,filter)call ForGroup(RandomUnitPickEnumGroup,function GroupPickRandomUnitEnum)call DestroyBoolExpr(filter)return bj_groupRandomCurrentPickendfunctionfunction RandomUnitInRangeOfUnit takes real radius,unit centerUnit,boolexpr filter returns unitset bj_groupRandomConsidered=0set bj_groupRandomCurrentPick=nullcall GroupClear(RandomUnitPickEnumGroup)call GroupEnumUnitsInRange(RandomUnitPickEnumGroup,GetUnitX(centerUnit),GetUnitY(centerUnit),radius,filter)call ForGroup(RandomUnitPickEnumGroup,function GroupPickRandomUnitEnum)call DestroyBoolExpr(filter)return bj_groupRandomCurrentPickendfunctionfunction FirstUnitInRangeOfLoc takes real radius,location center,boolexpr filter returns unitcall GroupClear(RandomUnitPickEnumGroup)call GroupEnumUnitsInRangeOfLoc(RandomUnitPickEnumGroup,center,radius,filter)call DestroyBoolExpr(filter)return FirstOfGroup(RandomUnitPickEnumGroup)endfunctionfunction FirstUnitInRangeOfWidget takes real radius,widget targetWidget,boolexpr filter returns unitcall GroupClear(RandomUnitPickEnumGroup)call GroupEnumUnitsInRange(RandomUnitPickEnumGroup,GetWidgetX(targetWidget),GetWidgetY(targetWidget),radius,filter)call DestroyBoolExpr(filter)return FirstOfGroup(RandomUnitPickEnumGroup)endfunctionfunction CountUnitsInRangeOfLoc takes real radius,location center,boolexpr filter returns integercall GroupClear(UnitCountEnumGroup)call GroupEnumUnitsInRangeOfLoc(UnitCountEnumGroup,center,radius,filter)set bj_groupCountUnits=0call ForGroup(UnitCountEnumGroup,function CountUnitsInGroupEnum)call DestroyBoolExpr(filter)return bj_groupCountUnitsendfunctionfunction CountUnitsInRangeOfUnit takes real radius,unit whichUnit,boolexpr filter returns integercall GroupClear(UnitCountEnumGroup)call GroupEnumUnitsInRange(UnitCountEnumGroup,GetUnitX(whichUnit),GetUnitY(whichUnit),radius,filter)set bj_groupCountUnits=0set LifeSumAccumulator=.0call ForGroup(UnitCountEnumGroup,function AccumulateGroupCountAndLifeEnum)call DestroyBoolExpr(filter)return bj_groupCountUnitsendfunctionfunction CountUnitsInRangeOfPoint takes real radius,real centerX,real centerY,boolexpr filter returns integercall GroupClear(UnitCountEnumGroup)call GroupEnumUnitsInRange(UnitCountEnumGroup,centerX,centerY,radius,filter)set bj_groupCountUnits=0set LifeSumAccumulator=.0call ForGroup(UnitCountEnumGroup,function AccumulateGroupCountAndLifeEnum)call DestroyBoolExpr(filter)return bj_groupCountUnitsendfunctionfunction ForUnitsInRangeOfPoint takes real centerX,real centerY,real radius,boolexpr filter,code callback returns nothingcall GroupClear(RandomUnitEnumGroup)call GroupEnumUnitsInRange(RandomUnitEnumGroup,centerX,centerY,radius,filter)call ForGroup(RandomUnitEnumGroup,callback)call DestroyBoolExpr(filter)endfunctionfunction IsEnemyTowerOrBuildingFilter takes nothing returns booleanlocal integer unitTypeId=GetUnitTypeId(GetFilterUnit())return((IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE))and(IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(bj_lastLoadedUnit)))and(GetWidgetLife(GetFilterUnit())>.405)and((unitTypeId=='e00S')or(unitTypeId=='e011')or(unitTypeId=='e00R')or(unitTypeId=='e019')or(unitTypeId=='u00N')or(unitTypeId=='u00D')or(unitTyp