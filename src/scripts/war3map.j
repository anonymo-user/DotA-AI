f duration>=2 thenreturn 12elseif duration>=1.8 thenreturn 11elseif duration>=1.75 thenreturn 10elseif duration>=1.65 thenreturn 9elseif duration>=1.5 thenreturn 8elseif duration>=1.4 thenreturn 7elseif duration>=1.25 thenreturn 6elseif duration>=1.2 thenreturn 5elseif duration>=1 thenreturn 4elseif duration>=.75 thenreturn 3elseif duration>=.5 thenreturn 2elseif duration>=.25 thenreturn 1endifreturn 1endfunctionfunction CreateDummyCastScaledAbilityOnTarget takes unit sourceUnit,unit targetUnit,real duration returns nothinglocal unit dummy=CreateUnit(GetOwningPlayer(targetUnit),'e00E',GetUnitX(targetUnit),GetUnitY(targetUnit),0)local integer abilityLevel=MapDurationToAbilityLevel(duration)call UnitAddAbility(dummy,'A0X6')call SetUnitAbilityLevel(dummy,'A0X6',abilityLevel)call IssueTargetOrderById(dummy,852095,targetUnit)set dummy=nullendfunctionfunction RecordDamageTraceToDisk takes nothing returns nothingendfunctionfunction DamageTargetByType takes unit sourceUnit,unit targetUnit,integer damageType,real damageAmount returns nothingif damageType==DamageType0 thenreturnendifif DamageRecursionDepth>=12 thenreturnendifset DamageRecursionDepth=DamageRecursionDepth+1if damageType==DamageType1 thencall UnitDamageTarget(sourceUnit,targetUnit,damageAmount,true,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_FIRE,WEAPON_TYPE_WHOKNOWS)elseif damageType==DamageType2 thencall UnitDamageTarget(sourceUnit,targetUnit,damageAmount,true,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)elseif damageType==DamageType3 thencall UnitDamageTarget(sourceUnit,targetUnit,damageAmount,true,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)elseif damageType==DamageType4 thencall UnitDamageTarget(sourceUnit,targetUnit,damageAmount,true,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)elseif damageType==DamageType5 thencall UnitDamageTarget(sourceUnit,targetUnit,damageAmount,true,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_