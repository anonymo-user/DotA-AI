Id(GetOwningPlayer(sourceHero))),(372))))if skipSkillCopy==false thencall PropagateSkillToClones(sourceHero,'A0MW')call PropagateSkillToClones(sourceHero,'A27C')endifset cloneUnit=CreateUnit(GetOwningPlayer(sourceHero),'H00J',GetUnitX(sourceHero),GetUnitY(sourceHero),0)call CopyHeroXpAndSkillsToClone(cloneUnit,sourceHero)call GrantHighestPriorityItemToClone(cloneUnit,sourceHero)call SaveUnitHandle(GameHashtable,(ownerId),(699+CloneUnitCount),(cloneUnit))set cloneUnit=nullendfunctionfunction CreateInitialCloneHero takes nothing returns nothingif CloneSkillInitFlag==false thenset CloneSkillInitFlag=truecall DisableTrigger(ToggleableTrigger_2)call SpawnCloneHero(FilterReferenceUnit_2,true)call EnableTrigger(ToggleableTrigger_2)endifendfunctionfunction OnCloneHeroSkillLearned takes nothing returns booleanlocal trigger triggeringTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(triggeringTrigger)local unit cloneOwnerUnit=(LoadUnitHandle(GameHashtable,(handleId),(2)))if IsUnitIllusion(GetTriggerUnit())==false and GetOwningPlayer(GetTriggerUnit())==GetOwningPlayer(cloneOwnerUnit)and IsCloneHeroType(GetTriggerUnit())thenif GetLearnedSkill()=='A0MW' or GetLearnedSkill()=='A27C' thencall DisableTrigger(GetTriggeringTrigger())call SpawnCloneHero(GetTriggerUnit(),false)call EnableTrigger(GetTriggeringTrigger())elseif GetLearnedSkill()=='Aamk' or GetLearnedSkill()=='A0N8' or GetLearnedSkill()=='A0NB' or GetLearnedSkill()=='A0N7' thencall TriggerExecute((LoadTriggerHandle(GameHashtable,(GetHandleId(GetOwningPlayer(GetTriggerUnit()))),(371))))call TriggerExecute((LoadTriggerHandle(GameHashtable,(GetHandleId(GetOwningPlayer(GetTriggerUnit()))),(372))))call DisableTrigger(GetTriggeringTrigger())call PropagateSkillToClones(GetTriggerUnit(),GetLearnedSkill())call EnableTrigger(GetTriggeringTrigger())endifendifset cloneOwnerUnit=nullreturn falseendfunctionfunction InitCloneSkillLearnTrigger takes nothing returns nothinglocal unit h