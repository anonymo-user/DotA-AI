all SetPlayerName(CreepControlPlayer,(GetObjectName(('n0E8'))))call SetupPlayerShopUnits()if(SentinelPlayer[0]!=Player(0)or ScourgePlayer[0]!=Player(6))thencall ReassignBaseUnitsToTeamCaptains()endifcall SetupPlayerColorsAndAINames()set sentinelPlayerCount=CountPlayingPlayersInForce(TeamOneForce)set scourgePlayerCount=CountPlayingPlayersInForce(TeamTwoForce)set teamSlotIndex=1set maxSlotIndex=5loopexitwhen teamSlotIndex>maxSlotIndexif(IsPlayerSlotActive(SentinelPlayer[teamSlotIndex]))thencall SetPlayerState(SentinelPlayer[teamSlotIndex],PLAYER_STATE_RESOURCE_GOLD,(4375/ sentinelPlayerCount))call SetPlayerState(SentinelPlayer[teamSlotIndex],PLAYER_STATE_RESOURCE_LUMBER,0)endifif(IsPlayerSlotActive(ScourgePlayer[teamSlotIndex]))thencall SetPlayerState(ScourgePlayer[teamSlotIndex],PLAYER_STATE_RESOURCE_GOLD,(4375/ scourgePlayerCount))call SetPlayerState(ScourgePlayer[teamSlotIndex],PLAYER_STATE_RESOURCE_LUMBER,0)endifset teamSlotIndex=teamSlotIndex+1endloopcall SetPlayerHandicapXP(SentinelPlayer[1],1)call SetPlayerHandicapXP(SentinelPlayer[2],1)call SetPlayerHandicapXP(SentinelPlayer[3],1)call SetPlayerHandicapXP(SentinelPlayer[4],1)call SetPlayerHandicapXP(SentinelPlayer[5],1)call SetPlayerHandicapXP(ScourgePlayer[1],1)call SetPlayerHandicapXP(ScourgePlayer[2],1)call SetPlayerHandicapXP(ScourgePlayer[3],1)call SetPlayerHandicapXP(ScourgePlayer[4],1)call SetPlayerHandicapXP(ScourgePlayer[5],1)call SetPlayerState(SentinelPlayer[0],PLAYER_STATE_GIVES_BOUNTY,1)call SetPlayerState(SentinelPlayer[1],PLAYER_STATE_GIVES_BOUNTY,1)call SetPlayerState(SentinelPlayer[2],PLAYER_STATE_GIVES_BOUNTY,1)call SetPlayerState(SentinelPlayer[3],PLAYER_STATE_GIVES_BOUNTY,1)call SetPlayerState(SentinelPlayer[4],PLAYER_STATE_GIVES_BOUNTY,1)call SetPlayerState(SentinelPlayer[5],PLAYER_STATE_GIVES_BOUNTY,1)call SetPlayerState(ScourgePlayer[0],PLAYER_STATE_GIVES_BOUNTY,1)call SetPlayerState(ScourgePlayer[1],PLAYER_STATE_GIVES_BOUNTY,1)call SetPlayerState(ScourgePlayer[2],PLAYER_STATE_GIVES_BOUNTY,1)call SetPlayerState(ScourgePlayer[3],PLAYER_STATE_GIVES_BOUNTY,1)call SetPlayerState(ScourgePlayer[4],PLAYER_STATE_GIVES_BOUNTY,1)call SetPlayerState(ScourgePlayer[5],PLAYER_STATE_GIVES_BOUNTY,1)call PickSyncReferencePlayer()call InitPlayerRGBColorComponents()call StripPlayerClanTag(SentinelPlayer[1])call StripPlayerClanTag(SentinelPlayer[2])call StripPlayerClanTag(SentinelPlayer[3])call StripPlayerClanTag(SentinelPlayer[4])call StripPlayerClanTag(SentinelPlayer[5])call StripPlayerClanTag(ScourgePlayer[1])call StripPlayerClanTag(ScourgePlayer[2])call StripPlayerClanTag(ScourgePlayer[3])call StripPlayerClanTag(ScourgePlayer[4])call StripPlayerClanTag(ScourgePlayer[5])set playerIndexA=1loopexitwhen playerIndexA>5if IsPlayerSlotActive(SentinelPlayer[playerIndexA])thencall CreateUnitAtLoc(SentinelPlayer[playerIndexA],'n00C',centerA,bj_UNIT_FACING)endifif IsPlayerSlotActive(ScourgePlayer[playerIndexA])thencall CreateUnitAtLoc(ScourgePlayer[playerIndexA],'n00C',centerB,bj_UNIT_FACING)endifset playerIndexA=playerIndexA+1endloopcall RemoveLocation(centerA)call RemoveLocation(centerB)set playerNameIndex=0loopset PlayerName[playerNameIndex]=GetPlayerName(Player(playerNameIndex))set playerNameIndex=playerNameIndex+1exitwhen playerNameIndex==16endloopset centerA=nullset centerB=nullendfunctionfunction InitHeroDataAndTips takes nothing returns nothinglocal integer heroIndex=1set CachedLoopIndex=1set RestrictedTechId[1]='Hvwd'set ScaledUnitType[1]='h03Z'set HeroTypeByPointValue[1]='n09U'set HeroIconPath[1]="ReplaceableTextures\\CommandButtons\\BTNAvengingWatcher.blp"call RegisterUnitTypeAnimation(RestrictedTechId[1],"stand 4")call RegisterUnitTypeScale(RestrictedTechId[1],1.35,ScaledUnitType[1])set HeroTipLine1[heroIndex]="Cheap items such as Bracers, Bottle and Magic Stick help give Vengeful Spirit what she needs to use Magic Missile and Swap safely and frequently."set HeroTipLine2[heroIndex]="By getting Magic Missile first, Vengeful Spirit should take advantage of this powerful stun by moving around the map instead of simply farming in a lane."set HeroTipLine3[heroIndex]="It is sometimes a good idea to save the Command Aura for later in the game when it will give your team more damage."set HeroTipLine4[heroIndex]="Wave of Terror is used to provide sight, giving you vision over an area or providing an opportunity to use Swap."set HeroTipLine5[heroIndex]="Swap will allow you to isolate a key hero on their team, sometimes your sacrifice is needed to win the battle and maybe even the game."set heroIndex=heroIndex+1set RestrictedTechId[2]='Hmbr'set ScaledUnitType[2]='h040'set HeroTypeByPointValue[2]='n09A'set HeroIconPath[2]="ReplaceableTextures\\CommandButtons\\BTNAvatar.blp"call RegisterUnitTypeAnimation(RestrictedTechId[2],"attack slam alternate")call RegisterUnitTypeScale(RestrictedTechId[2],1.3,ScaledUnitType[2])set HeroTipLine1[heroIndex]="When using Arc lightning, try to kill creeps and harass your opponent at the same time"set HeroTipLine2[heroIndex]="When ganking, you can use Lightning Bolt to ensure you will not lose sight of the target quickly."set HeroTipLine3[heroIndex]="Lightning Bolt has a mini-stun that can be used against channeling spells and teleporting heroes."set HeroTipLine4[heroIndex]="Static Field is extremely powerful throughout the game: Use your spells as frequently as possible during fights."set HeroTipLine5[heroIndex]="Both Lightning Bolt and Wrath of the Thundergod reveal invisible units. Wrath will not damage invisible units."set heroIndex=heroIndex+1set RestrictedTechId[3]='Emoo'set ScaledUnitType[3]='h041'set HeroTypeByPointValue[3]='n099'set HeroIconPath[3]="ReplaceableTextures\\CommandButtons\\BTNDryad.blp"call RegisterUnitTypeAnimation(RestrictedTechId[3],"stand 4")call RegisterUnitTypeScale(RestrictedTechId[3],1,ScaledUnitType[3])set HeroTipLine1[heroIndex]="Enchant can be used on neutral creeps, meaning Enchantress can fight and use neutral creeps to engage enemy heroes effectively."set HeroTipLine2[heroIndex]="Nature's Attendants heals in an area AOE, so make sure you're far from creeps if you only want to heal yourself."set HeroTipLine3[heroIndex]="Untouchable is great against physical attacks, but it does not help you survive huge burst damage nukes."set HeroTipLine4[heroIndex]="Impetus deals negligible damage at short range; switch to normal attacks if your target gets close to save mana."set HeroTipLine5[heroIndex]="Impetus deals pure damage, making it a great tool against heroes with a lot of resistance because it is not reduced."set heroIndex=heroIndex+1set RestrictedTechId[4]='O00P'set ScaledUnitType[4]='h042'set HeroTypeByPointValue[4]='n098'set HeroIconPath[4]="ReplaceableTextures\\CommandButtons\\BTNSeaElemental.blp"call RegisterUnitTypeAnimation(RestrictedTechId[4],"stand 2")call RegisterUnitTypeScale(RestrictedTechId[4],1,ScaledUnitType[4])set HeroTipLine1[heroIndex]="Waveform is extremely powerful: Used for damage, chasing, escaping, it even allows you to dodge some spells by casting it at the right time."set HeroTipLine2[heroIndex]="Morph allows you to manipulate your Agility and Strength. Using the Strength Morph ('F') can act as a heal to help you survive between spells."set HeroTipLine3[heroIndex]="Use Morph Replicate to take the location of your Replicated unit, making it great for a quick escape or simply as a free teleport."set HeroTipLine4[heroIndex]="Replicate is usually cast on the strongest ally or enemy in a fight. Certain hero passives or items will retain their effects, so Replicate those heroes."set HeroTipLine5[heroIndex]="Eye of Skadi and Linken's Sphere are two examples of Statistic-increasing items which give Morphling a lot of versatility and the ability to cast spells often."set heroIndex=heroIndex+1set RestrictedTechId[5]='Hjai'set ScaledUnitType[5]='h043'set HeroTypeByPointValue[5]='n09W'set HeroIconPath[5]="ReplaceableTextures\\CommandButtons\\BTNJaina.blp"call RegisterUnitTypeAnimation(RestrictedTechId[5],"stand victory")call RegisterUnitTypeScale(RestrictedTechId[5],1,ScaledUnitType[5])set HeroTipLine1[heroIndex]="CM is a fragile support hero: Items like Bracers and Phase Boots will help her survive and deal with her low movement speed and armor."set HeroTipLine2[heroIndex]="A few points of Brilliance Aura early on provides your team with massive amounts of extra mana."set HeroTipLine3[heroIndex]="Enemies hit by Frostbite can still cast spells, so don't take them lightly. "set HeroTipLine4[heroIndex]="Frostbite on non-hero units will last 10 seconds. This can be useful for killing neutral creeps that are level 5 or lower as well."set HeroTipLine5[heroIndex]="There are two items that can help you with the perfect Freezing Field: Placement with Kelen's Dagger and the spell immunity of Black King Bar."set heroIndex=heroIndex+1set RestrictedTechId[6]='H001'set ScaledUnitType[6]='h044'set HeroTypeByPointValue[6]='n096'set HeroIconPath[6]="ReplaceableTextures\\CommandButtons\\BTNFelGuardBlue.tga"call RegisterUnitTypeAnimation(RestrictedTechId[6],"spell")call RegisterUnitTypeScale(RestrictedTechId[6],1,ScaledUnitType[6])set HeroTipLine1[heroIndex]="Storm Bolt is a skill Sven should usually get early because of its damage and stun. "set HeroTipLine2[heroIndex]="Take advantage of Storm Bolt's area of effect by hitting additional enemy creeps and heroes whenever possible. "set HeroTipLine3[heroIndex]="Try to be near your allies when you cast Warcry."set HeroTipLine4[heroIndex]="Only items that increase Strength will give you additional damage from the effect of God's Strength."set HeroTipLine5[heroIndex]="Casting God's Strength before engaging in fights or casting Storm Bolt will allow you to get additional attacks on your opponent."set heroIndex=heroIndex+1set RestrictedTechId[7]='HC49'set ScaledUnitType[7]='h045'set HeroTypeByPointValue[7]='n09P'set HeroIconPath[7]="ReplaceableTextures\\CommandButtons\\BTNSeaWitch.blp"call RegisterUnitTypeAnimation(RestrictedTechId[7],"spell")call RegisterUnitTypeScale(RestrictedTechId[7],1,ScaledUnitType[7])set HeroTipLine1[heroIndex]="Opponents can attack and cast spells while Ensnared. However, it will work on magic immune units and reveal invisible heroes until the duration expires."set HeroTipLine2[heroIndex]="Mirror Image can be used defensively to avoid certain spells and dispel debuffs or channeling spells."set HeroTipLine3[heroIndex]="Items that provide attribute bonuses improve your Image's power."set HeroTipLine4[heroIndex]="Enemies caught by Song of the Siren are invulnerable while asleep. Save your attacks and spells for after the spell expires."set HeroTipLine5[heroIndex]="Use Song of the Siren to isolate a magic immune or Cycloned hero (since they will not be affected), or to demolish buildings while enemies are asleep."set heroIndex=heroIndex+1set RestrictedTechId[8]='Otch'set ScaledUnitType[8]='h046'set HeroTypeByPointValue[8]='n09D'set HeroIconPath[8]="ReplaceableTextures\\CommandButtons\\BTNTauren.blp"call RegisterUnitTypeAnimation(RestrictedTechId[8],"attack slam")call RegisterUnitTypeScale(RestrictedTechId[8],1.1,ScaledUnitType[8])set HeroTipLine1[heroIndex]="Although he's a strength hero, Earthshaker (ES) actually plays more like a caster. Damage items are not very useful, but mana items can be nice."set HeroTipLine2[heroIndex]="A good cast of Fissure can isolate an opponent and cut off their escape. Practice often to achieve devastating results."set HeroTipLine3[heroIndex]="Kelen's Dagger is an incredible item on ES, it allows you to quickly position yourself for the perfect Fissure or Echoslam."set HeroTipLine4[heroIndex]="The timing of your spells is important, by spacing them out properly you can keep a group of heroes disabled for several seconds."set HeroTipLine5[heroIndex]="Due to Raigor's ability to split up an enemy team and keep them stunned, he is great for initiating fights."set heroIndex=heroIndex+1set RestrictedTechId[9]='HC92'set ScaledUnitType[9]='h047'set HeroTypeByPointValue[9]='n09X'set HeroIconPath[9]="ReplaceableTextures\\CommandButtons\\BTNSatyrTrickster.blp"call RegisterUnitTypeAnimation(RestrictedTechId[9],"stand 4")call RegisterUnitTypeScale(RestrictedTechId[9],1,ScaledUnitType[9])set HeroTipLine1[heroIndex]="Getting at least one level of Blink Strike and Smoke Screen helps you survive to level 6 when you can learn Permanent Invisibility."set HeroTipLine2[heroIndex]="Attacking or using your spells makes you visible: Consider the fade time of Permanent Invisibility before placing yourself at risk."set HeroTipLine3[heroIndex]="Try to position Smoke Screen slightly behind enemies so that they spend more time in the cloud if they retreat."set HeroTipLine4[heroIndex]="Wraith Bands and later a Yasha or a Diffusal Blade will provide Rikimaru with cheap damage and chasing power for dispatching fragile heroes quickly."set HeroTipLine5[heroIndex]="Be careful of items that render you visible, such as Dust of Appearance, Sentry Wards or a Gem of True Sight."set heroIndex=heroIndex+1set RestrictedTechId[10]='N01O'set ScaledUnitType[10]='h048'set HeroTypeByPointValue[10]='n09Y'set HeroIconPath[10]="ReplaceableTextures\\CommandButtons\\BTNDruidOfTheClaw.blp"call RegisterUnitTypeAnimation(RestrictedTechId[10],"spell slam")call RegisterUnitTypeScale(RestrictedTechId[10],1,ScaledUnitType[10])call RegisterUnitTypeScale('n013',1.1,ScaledUnitType[10])call RegisterUnitTypeScale('n014',1.2,ScaledUnitType[10])call RegisterUnitTypeScale('n015',1.3,ScaledUnitType[10])call RegisterUnitTypeScale('n004',1,ScaledUnitType[10])call RegisterUnitTypeScale('n018',1.1,ScaledUnitType[10])call RegisterUnitTypeScale('n01C',1.2,ScaledUnitType[10])call RegisterUnitTypeScale('n01G',1.3,ScaledUnitType[10])set HeroTipLine1[heroIndex]="Spirit Bear is great to have in the lane and allows Syllabear to fight neutral creeps because of its high HP and damage. "set HeroTipLine2[heroIndex]="Leveling Spirit Bear also gets various bonuses that make it very powerful for fighting heroes and towers so it is usually the first thing to max out."set HeroTipLine3[heroIndex]="Your Spirit Bear might be able to handle a lot of damage, but if it dies you will also take damage (100 X its level). If you die, it dies as well."set HeroTipLine4[heroIndex]="Give items to your bear instead of Syllabear since it is usually engaging the enemy for you. Remember that stat-increasing items do not benefit the bear."set HeroTipLine5[heroIndex]="True Form gives Syllabear massive HP in his melee form, and Rabid and Battle Cry give both him and his Bear huge damage temporarily."set heroIndex=heroIndex+1set RestrictedTechId[11]='H004'set ScaledUnitType[11]='h049'set HeroTypeByPointValue[11]='n09Z'set HeroIconPath[11]="ReplaceableTextures\\CommandButtons\\BTNSorceress.blp"call RegisterUnitTypeAnimation(RestrictedTechId[11],"stand victory")call RegisterUnitTypeScale(RestrictedTechId[11],1.2,ScaledUnitType[11])set HeroTipLine1[heroIndex]="Light Strike Array is usually a good skill to get at level 1 because it provides you with a stun."set HeroTipLine2[heroIndex]="Target the ground in their direction instead of clicking on enemies to maximize Dragon Slave's long range."set HeroTipLine3[heroIndex]="Cheap items will help Lina do her job: Bracers, Bottle, Phase Boots. A Point booster provides a nice HP/mana bonus for its cost."set HeroTipLine4[heroIndex]="Fiery Soul can help you maneuver better during a fight."set HeroTipLine5[heroIndex]="Try to stun as many heroes as possible during team fights"set heroIndex=heroIndex+1set RestrictedTechId[12]='Nbbc'set ScaledUnitType[12]='h04A'set HeroTypeByPointValue[12]='n0A5'set HeroIconPath[12]="ReplaceableTextures\\CommandButtons\\BTNChaosBlademaster.blp"call RegisterUnitTypeAnimation(RestrictedTechId[12],"stand victory")call RegisterUnitTypeScale(RestrictedTechId[12],1,ScaledUnitType[12])set HeroTipLine1[heroIndex]="Blade Fury is your most important skill early game for getting hero kills and avoiding magic damage."set HeroTipLine2[heroIndex]="Avoid follow-command (right-clicking) heroes with Blade Fury and instead click the ground near the opponent."set HeroTipLine3[heroIndex]="Isolate enemy heroes before using Omnislash to prevent Juggernaut from attacking multiple targets and doing less damage."set HeroTipLine4[heroIndex]="Increasing your attack speed will give you 'extra attacks' during Omnislash, which are treated like a normal attack (in terms of damage and orb effects)."set HeroTipLine5[heroIndex]="Protect the 1-HP Healing Ward in battles and it can prolong and save the lives of your entire team."set heroIndex=heroIndex+1set RestrictedTechId[13]='N01A'set ScaledUnitType[13]='h04B'set HeroTypeByPointValue[13]='n097'set HeroIconPath[13]="ReplaceableTextures\\CommandButtons\\BTNSpellBreaker.blp"call RegisterUnitTypeAnimation(RestrictedTechId[13],"stand ready")call RegisterUnitTypeScale(RestrictedTechId[13],1,ScaledUnitType[13])set HeroTipLine1[heroIndex]="Glaives of Wisdom is useful to get early because it is useful for killing creeps and harassing your opponent manually ('W' and then the target)."set HeroTipLine2[heroIndex]="Curse of the Silent will cause an enemy to lose HP/mana if they do not choose to use their spells, or cannot use their spells (disabled, silenced, cooldown)."set HeroTipLine3[heroIndex]="Last Word will prevent enemies from using multiple spells on you and your team at the same time provided you get close enough."set HeroTipLine4[heroIndex]="Global Silence can be used for initiating on enemies or saving allies early on. Try to pay attention to your teammates and enemies, even those not nearby."set HeroTipLine5[heroIndex]="Global Silence will also give your allies the opportunity in team battles to use their spells without repercussions - making it a powerful control spell."set heroIndex=heroIndex+1set RestrictedTechId[14]='Hamg'set ScaledUnitType[14]='h04C'set HeroTypeByPointValue[14]='n09F'set HeroIconPath[14]="ReplaceableTextures\\CommandButtons\\BTNTreant.blp"call RegisterUnitTypeAnimation(RestrictedTechId[14],"stand 3")call RegisterUnitTypeScale(RestrictedTechId[14],.72,ScaledUnitType[14])set HeroTipLine1[heroIndex]="Thanks to his high base damage and survivability, Rooftrellen can usually obtain high-tier damage or caster items depending on the needs of the team."set HeroTipLine2[heroIndex]="Living armor adds significant defensive bonuses to an allied unit. It can even be cast on buildings to make them more resilient and provide regeneration."set HeroTipLine3[heroIndex]="Nature's Guise is more than an escape tool, it can be used offensively as well. Use it to position allies and yourself near trees before surprising the enemy."set HeroTipLine4[heroIndex]="Use Eyes in the Forest whenever you can to gain vision of key locations such as the rune spots, neutral creep camps and Roshan."set HeroTipLine5[heroIndex]="Enemies under the effect of Overgrowth can still use spells and items, so make sure your team acts quickly while enemies remain immobilized."set heroIndex=heroIndex+1set RestrictedTechId[15]='O015'set ScaledUnitType[15]='h07P'set HeroTypeByPointValue[15]='n0GC'set HeroIconPath[15]="ReplaceableTextures\\CommandButtons\\BTNHeroTaurenChieftain.blp"call RegisterUnitTypeAnimation(RestrictedTechId[15],"stand victory")call RegisterUnitTypeScale(RestrictedTechId[15],1.1,ScaledUnitType[15])set HeroTipLine1[heroIndex]=""set HeroTipLine2[heroIndex]=""set HeroTipLine3[heroIndex]=""set HeroTipLine4[heroIndex]=""set HeroTipLine5[heroIndex]=""set heroIndex=heroIndex+1set RestrictedTechId[16]='Hblm'set ScaledUnitType[16]='h04E'set HeroTypeByPointValue[16]='n09G'set HeroIconPath[16]="ReplaceableTextures\\CommandButtons\\BTNHeroArchMage.blp"call RegisterUnitTypeAnimation(RestrictedTechId[16],"stand victory")call RegisterUnitTypeScale(RestrictedTechId[16],1.2,ScaledUnitType[16])call RegisterUnitTypeScale('H06X',1.5,ScaledUnitType[16])call RegisterUnitTypeScale('H06Y',1.5,ScaledUnitType[16])call RegisterUnitTypeScale('H06W',1.5,ScaledUnitType[16])set HeroTipLine1[heroIndex]="Chakra Magic is an amazing support skill that you should cast on allies as often as possible if they have powerful spells."set HeroTipLine2[heroIndex]="Illuminate can be useful for earning gold or clearing creeps quickly, but channeling the blast can leave you vulnerable. "set HeroTipLine3[heroIndex]="Mana Leak gives you the offensive: an enemy that moves loses his resources to cast spells, but if he does not, you can punish him with spells and attacks."set HeroTipLine4[heroIndex]="When in your Spirit Form, use Blinding Light to push enemies aside, and Recall for saving or calling on the assistance of an ally."set HeroTipLine5[heroIndex]="Keeper of the Light usually needs to stay back in fights and make use of the long range of his spells as a support hero when pushing and defending."set heroIndex=heroIndex+1set RestrictedTechId[17]='Huth'set ScaledUnitType[17]='h04F'set HeroTypeByPointValue[17]='n09V'set HeroIconPath[17]="ReplaceableTextures\\CommandButtons\\BTNFurbolgTracker.blp"call RegisterUnitTypeAnimation(RestrictedTechId[17],"attack spell")call RegisterUnitTypeScale(RestrictedTechId[17],1.2,ScaledUnitType[17])set HeroTipLine1[heroIndex]="Get Fury Swipes and Overpower early. Fury Swipes is a very powerful orb effect on Ursa, replacing it with another is not advised."set HeroTipLine2[heroIndex]="Ursa is a very effective hero to fight neutral creeps with: Vladmir's Offering is a recommended item choice."set HeroTipLine3[heroIndex]="Thanks to Enrage, Ursa usually purchases items that increase HP or Strength over Agility and Damage items."set HeroTipLine4[heroIndex]="It is a good idea to fight the two ancient camps when you need a quick boost in experience and gold. They are marked red in your minimap."set HeroTipLine5[heroIndex]="Certain items like Kelen's Dagger and Lothar's Edge will help both close the distance on enemies and take them by surprise."set heroIndex=heroIndex+1set RestrictedTechId[18]='Hmkg'set ScaledUnitType[18]='h04G'set HeroTypeByPointValue[18]='n0A1'set HeroIconPath[18]="ReplaceableTextures\\CommandButtons\\BTNOgreMagi.blp"call RegisterUnitTypeAnimation(RestrictedTechId[18],"sleep")call RegisterUnitTypeScale(RestrictedTechId[18],1.4,ScaledUnitType[18])set HeroTipLine1[heroIndex]="Buying a few Clarity Potions, Ring of Basilius or Bottle in the beginning of the game will help you cast a few more spells."set HeroTipLine2[heroIndex]="Fireblast provides a disable, Ignite provides a slow. Both deal damage, usually making them good skills early."set HeroTipLine3[heroIndex]="Ogre Magi has a lot of survivability but he does need the ability to use his spells: an Arcane Ring might be the only item you will need all game."set HeroTipLine4[heroIndex]="Use Bloodlust to help teammates chase and escape enemies and on the hero capable of dealing the most damage before major battles."set HeroTipLine5[heroIndex]="Focus heroes that need to be shut down quickly with Fireblast: Hopefully they are repeatedly damaged and disabled by the effect of Multicast."set heroIndex=heroIndex+1set RestrictedTechId[19]='Ntin'set ScaledUnitType[19]='h04H'set HeroTypeByPointValue[19]='n0AA'set HeroIconPath[19]="ReplaceableTextures\\CommandButtons\\BTNHeroTinker.blp"call RegisterUnitTypeAnimation(RestrictedTechId[19],"stand 2")call RegisterUnitTypeScale(RestrictedTechId[19],1,ScaledUnitType[19])set HeroTipLine1[heroIndex]="Laser and Missile give Tinker massive burst damage, so it is usually a good idea to get these two skills before Rearm, your ultimate."set HeroTipLine2[heroIndex]="Laser is not reduced by magic resistance or armor; you deal the number in the description exactly."set HeroTipLine3[heroIndex]="You can use the active effects of items indefinitely with Rearm, which makes Boots of Travel a very powerful item for Tinker."set HeroTipLine4[heroIndex]="March of the Machines can be very useful for killing creeps quickly, its large area of effect makes it useful for pushing and team fights."set HeroTipLine5[heroIndex]="Level 1 of Rearm is generally enough until much later when you have the mana pool to support levels 2 and 3."set heroIndex=heroIndex+1set RestrictedTechId[20]='Emns'set ScaledUnitType[20]='h04I'set HeroTypeByPointValue[20]='n0A4'set HeroIconPath[20]="ReplaceableTextures\\CommandButtons\\BTNFurion.blp"call RegisterUnitTypeAnimation(RestrictedTechId[20],"spell")call RegisterUnitTypeScale(RestrictedTechId[20],1.2,ScaledUnitType[20])set HeroTipLine1[heroIndex]="Get Force of Nature early if you plan on leaving the lane to kill neutral creeps. Start with a Ring of Basilius to provide you with mana and armor."set HeroTipLine2[heroIndex]="Invest points in Teleportation, it gives you the mobility to be anywhere in the map: Cancel the spell if you change your mind by clicking 'S'."set HeroTipLine3[heroIndex]="Sprout can be extremely useful offensively and defensively so get at least one point in it. Higher levels increase the duration but also the mana cost."set HeroTipLine4[heroIndex]="Teleportation shows allies and enemies where you intend to go, so if you want to surprise enemies, teleport where they cannot see."set HeroTipLine5[heroIndex]="Wrath of Nature is a great farming tool but also a powerful nuke on enemy heroes: Hit other units nearby to deal more damage to the intended target."set heroIndex=heroIndex+1set RestrictedTechId[21]='Ogrh'set ScaledUnitType[21]='h04J'set HeroTypeByPointValue[21]='n0A3'set HeroIconPath[21]="ReplaceableTextures\\CommandButtons\\BTNHellScream.blp"call RegisterUnitTypeAnimation(RestrictedTechId[21],"stand victory")call RegisterUnitTypeScale(RestrictedTechId[21],1,ScaledUnitType[21])set HeroTipLine1[heroIndex]="Get Spirit Lance and Doppelwalk first because Juxtapose is better when your illusions have more health and damage."set HeroTipLine2[heroIndex]="Beware of the high mana costs of your spells early game, especially for Doppelwalk, which can be an escape mechanism."set HeroTipLine3[heroIndex]="Keep your opponents guessing by controlling your illusions created by Doppelwalk and Juxtapose."set HeroTipLine4[heroIndex]="Your illusions are amazing for pushing later on. Focus creeps and heroes first because illusions will not create new ones when attacking buildings."set HeroTipLine5[heroIndex]="Diffusal Blade and Manta Style are good choices because they make his images much stronger by adding Agility directly."set heroIndex=heroIndex+1set RestrictedTechId[22]='Ucrl'set ScaledUnitType[22]='h04K'set HeroTypeByPointValue[22]='n0A7'set HeroIconPath[22]="ReplaceableTextures\\CommandButtons\\BTNMountainGiant.blp"call RegisterUnitTypeAnimation(RestrictedTechId[22],"spell")call RegisterUnitTypeScale(RestrictedTechId[22],.5,ScaledUnitType[22])set HeroTipLine1[heroIndex]="Buy items that give you at least 3 Intelligence or 39 mana in the beginning of the game so that you can use both of your spells at level 2."set HeroTipLine2[heroIndex]="Avalanche and Toss should be the two spells you level first because they make you a force to be reckoned with early game."set HeroTipLine3[heroIndex]="You can sometimes kill a hero outright by casting Avalanche on him, and then Tossing him on the Avalanche area of effect before the animation ends."set HeroTipLine4[heroIndex]="To ensure that you Toss your desired target, isolate him by making him the only one in the area of effect. Kelen's Dagger can help you with placement."set HeroTipLine5[heroIndex]="Tiny deals most of his damage through Avalanche and Toss, so the reduced attack speed from Grow is less important than the bonuses given."set heroIndex=heroIndex+1set RestrictedTechId[23]='H00K'set ScaledUnitType[23]='h04L'set HeroTypeByPointValue[23]='n0A9'set HeroIconPath[23]="ReplaceableTextures\\CommandButtons\\BTNGoblinSapper.blp"call RegisterUnitTypeAnimation(RestrictedTechId[23],"stand 2")call RegisterUnitTypeScale(RestrictedTechId[23],1,ScaledUnitType[23])set HeroTipLine1[heroIndex]=""set HeroTipLine2[heroIndex]=""set HeroTipLine3[heroIndex]=""set HeroTipLine4[heroIndex]=""set HeroTipLine5[heroIndex]=""set heroIndex=heroIndex+1set RestrictedTechId[24]='H00A'set ScaledUnitType[24]='h04M'set HeroTypeByPointValue[24]='n0AB'set HeroIconPath[24]="ReplaceableTextures\\CommandButtons\\BTNHeroFarseer.blp"call RegisterUnitTypeAnimation(RestrictedTechId[24],"spell chain lightning")call RegisterUnitTypeScale(RestrictedTechId[24],1,ScaledUnitType[24])set HeroTipLine1[heroIndex]="Chen can take control of high level neutral creeps with Holy Persuasion, making him extremely powerful at low levels even without items."set HeroTipLine2[heroIndex]="Neutrals with special abilities usually are more useful, try to find out what has a disable or slow as this will be much better for attacking heroes with."set HeroTipLine3[heroIndex]="When preparing to attack from the forest, start with Penitence to slow enemies. Engage enemies from the side or from behind to catch them off guard."set HeroTipLine4[heroIndex]="Chen excels as a support hero, items that contribute to teammates such as Mekansm usually benefit the team more than damage items."set HeroTipLine5[heroIndex]="Hand of God is really useful early on for helping allies across the map. Later, it can be used to assist with pushing or defending."set heroIndex=heroIndex+1set RestrictedTechId[25]='E005'set ScaledUnitType[25]='h04N'set HeroTypeByPointValue[25]='n0BE'set HeroIconPath[25]="ReplaceableTextures\\CommandButtons\\BTNHuntress.blp"call RegisterUnitTypeAnimation(RestrictedTechId[25],"spell")call RegisterUnitTypeScale(RestrictedTechId[25],1,ScaledUnitType[25])set HeroTipLine1[heroIndex]="The level of Lucent Beam determines the damage of Eclipse, making it the most important spell to get first. "set HeroTipLine2[heroIndex]="Moon Glaives can be useful early if you plan to kill neutral creeps. Lifesteal items like Helm of the Dominator can help you survive against neutral creeps."set HeroTipLine3[heroIndex]="Try to cast Eclipse on enemy heroes when other units are not present to maximize the damage dealt to a single target. "set HeroTipLine4[heroIndex]="Later on with some attack speed, Lunar Blessing and Moon Glaives provide you with both massive damage and pushing power."set HeroTipLine5[heroIndex]="You should also consider items that allow you to land Eclipse successfully and increase your carry potential in battles, such as a Black King Bar."set heroIndex=heroIndex+1set RestrictedTechId[26]='Usyl'set ScaledUnitType[26]='h04O'set HeroTypeByPointValue[26]='n0BD'set HeroIconPath[26]="ReplaceableTextures\\CommandButtons\\BTNRifleman.blp"call RegisterUnitTypeAnimation(RestrictedTechId[26],"spell")call RegisterUnitTypeScale(RestrictedTechId[26],1.1,ScaledUnitType[26])set HeroTipLine1[heroIndex]="Headshot will provide you with bonus damage and a short stun, making it useful for killing creeps and harassing with his incredible attack animation."set HeroTipLine2[heroIndex]="Sniper usually needs to find a combination of damage, attack speed and survivability that allow him to deal significant damage but survive to do so."set HeroTipLine3[heroIndex]="Sniper is very fragile so he needs to maintain his range. Getting Take Aim and/or Shrapnel can help provide means of staying out of harm's way."set HeroTipLine4[heroIndex]="Shrapnel can also be used for slowing opponents, pushing or defending against large waves of creeps."set HeroTipLine5[heroIndex]="Try to use Assassinate to heavily damage an enemy before the fight even begins to give your team an advantage."set heroIndex=heroIndex+1set RestrictedTechId[27]='N016'set ScaledUnitType[27]='h04P'set HeroTypeByPointValue[27]='n0A8'set HeroIconPath[27]="ReplaceableTextures\\CommandButtons\\BTNForestTroll.blp"call RegisterUnitTypeAnimation(RestrictedTechId[27],"stand 3")call RegisterUnitTypeScale(RestrictedTechId[27],1.25,ScaledUnitType[27])call RegisterUnitTypeScale('N02B',1.25,ScaledUnitType[27])call RegisterUnitTypeScale('N017',1.25,ScaledUnitType[27])set HeroTipLine1[heroIndex]="Berserker's Rage gives Troll the option of melee combat, which gives him many powerful offensive bonuses at the cost of losing his ranged ability."set HeroTipLine2[heroIndex]="Warlord generally does not have to worry about attack speed thanks to his set of skills, go for damage or survivability items instead."set HeroTipLine3[heroIndex]="Blind will prevent your opponents from landing all their attacks, making it harder for them to harass you or kill your creeps for gold."set HeroTipLine4[heroIndex]="Play defensively and fight neutral creeps too. Switch to melee form and it will allow you to have an easier time."set HeroTipLine5[heroIndex]="In team battles, it is vital that you cast Blind on the enemy hero that deals the most damage as this will greatly reduce their damage output."set heroIndex=heroIndex+1set RestrictedTechId[28]='Orkn'set ScaledUnitType[28]='h057'set HeroTypeByPointValue[28]='n094'set HeroIconPath[28]="ReplaceableTextures\\CommandButtons\\BTNShadowHunter.blp"call RegisterUnitTypeAnimation(RestrictedTechId[28],"stand victory")call RegisterUnitTypeScale(RestrictedTechId[28],1,ScaledUnitType[28])set HeroTipLine1[heroIndex]="At least one level of Shackles is advised early on for immobilizing opponents. Remember that it is channeling so it can be interrupted or broken by yourself."set HeroTipLine2[heroIndex]="Rhasta needs survivability and the mana to use his spells: Bracers, Null Talismans, Point Booster are examples of items that will help out a lot."set HeroTipLine3[heroIndex]="Forked Lightning is your primary nuke and finisher due to its range and ability to hit multiple targets, so it is more effective to get it earlier than later."set HeroTipLine4[heroIndex]="Use Shackles and Voodoo on enemy heroes when casting Mass Serpent Ward. You can even surround an enemy completely with the right timing."set HeroTipLine5[heroIndex]="Mass Serpent Wards can clear creeps quickly and deal a lot of damage over time to buildings, making them really useful for pushing and defending."set heroIndex=heroIndex+1set RestrictedTechId[29]='O01F'set ScaledUnitType[29]='h0CI'set HeroTypeByPointValue[29]='n0KS'set HeroIconPath[29]="ReplaceableTextures\\CommandButtons\\BTNWispHero.blp"call RegisterUnitTypeAnimation(RestrictedTechId[29],"stand 3")call RegisterUnitTypeScale(RestrictedTechId[29],1.3,ScaledUnitType[29])set HeroTipLine1[heroIndex]=""set HeroTipLine2[heroIndex]=""set HeroTipLine3[heroIndex]=""set HeroTipLine4[heroIndex]=""set HeroTipLine5[heroIndex]=""set heroIndex=heroIndex+1set RestrictedTechId[30]='Npbm'set ScaledUnitType[30]='h053'set HeroTypeByPointValue[30]='n0AO'set HeroIconPath[30]="ReplaceableTextures\\CommandButtons\\BTNPandarenBrewmaster.blp"call RegisterUnitTypeAnimation(RestrictedTechId[30],"stand ready")call RegisterUnitTypeScale(RestrictedTechId[30],1,ScaledUnitType[30])set HeroTipLine1[heroIndex]="Thunder Clap is a great skill early game but you may need to invest in regeneration items such as a Bottle, Magic Stick, Ring of Basilius or Void Stone."set HeroTipLine2[heroIndex]="Drunken Haze works not only as a slow, but the miss chance reduces the damage severely for enemy heroes."set HeroTipLine3[heroIndex]="Primal Split is not only for escaping: Once you master your three Pandas, Earth, Storm and Fire, you can use them offensively as well."set HeroTipLine4[heroIndex]="In Primal Split form, Mangix has two useful disables that can be used against enemies: Storm's Cyclone and Earth's Hurl Boulder."set HeroTipLine5[heroIndex]="Mangix usually initiates for the team, so survivability items are helpful, investing in a Kelen's Dagger to help land Thunder Clap is often a good idea."set heroIndex=heroIndex+1set RestrictedTechId[31]='H000'set ScaledUnitType[31]='h04X'set HeroTypeByPointValue[31]='n0AN'set HeroIconPath[31]="ReplaceableTextures\\CommandButtons\\BTNCentaurKhan.blp"call RegisterUnitTypeAnimation(RestrictedTechId[31],"stand 3")call RegisterUnitTypeScale(RestrictedTechId[31],1.75,ScaledUnitType[31])set HeroTipLine1[heroIndex]="Return should be leveled if Centaur plans to fight neutral creeps, otherwise Double Edge is more useful in the lane."set HeroTipLine2[heroIndex]="Thanks to a high strength gain and the bonus strength from your ultimate, Centaur is great at heading into battle first and receiving damage."set HeroTipLine3[heroIndex]="A Hood of Defiance can prove to be just as useful as a Vanguard depending on whether the other team has a lot of magical spells."set HeroTipLine4[heroIndex]="Avoid putting yourself at risk after using Double Edge. You can use it to commit suicide if you are about to die to deny opponents experience and gold."set HeroTipLine5[heroIndex]="Kelen's Dagger is a great way of initiating on opponents and dealing with his slow casting animation of Stomp."set heroIndex=heroIndex+1set RestrictedTechId[32]='Naka'set ScaledUnitType[32]='h052'set HeroTypeByPointValue[32]='n0AM'set HeroIconPath[32]="ReplaceableTextures\\CommandButtons\\BTNakama.blp"call RegisterUnitTypeAnimation(RestrictedTechId[32],"stand var4")call RegisterUnitTypeScale(RestrictedTechId[32],1.2,ScaledUnitType[32])set HeroTipLine1[heroIndex]="Shuriken Toss, Wind Walk and Track are much more useful than Jinada early on."set HeroTipLine2[heroIndex]="You're going to need mana regen: Bottle, Ring of Basilius and Void Stone are examples of good options. "set HeroTipLine3[heroIndex]="Use Wind Walk cautiously: If you wait until the cooldown is complete before breaking out of invisibility, you can cast it again immediately afterward."set HeroTipLine4[heroIndex]="Shuriken Toss and Wind Walk deal a lot of damage quickly: Search the map often for low HP heroes to hunt. "set HeroTipLine5[heroIndex]="Use Track on a nearby enemy hero to allow you and your allies to outrun them. Also cast it on nearly dead heroes for bonus gold."set heroIndex=heroIndex+1set RestrictedTechId[33]='Hlgr'set ScaledUnitType[33]='h04V'set HeroTypeByPointValue[33]='n0AQ'set HeroIconPath[33]="ReplaceableTextures\\CommandButtons\\BTNTheCaptain.blp"call RegisterUnitTypeAnimation(RestrictedTechId[33],"stand victory")call RegisterUnitTypeScale(RestrictedTechId[33],1.35,ScaledUnitType[33])call RegisterUnitTypeScale('H00F',1,ScaledUnitType[33])call RegisterUnitTypeScale('H00G',1,ScaledUnitType[33])call RegisterUnitTypeScale('H00E',1,ScaledUnitType[33])call RegisterUnitTypeColor('H00G',255,255,200)call RegisterUnitTypeColor('H00F',255,255,200)call RegisterUnitTypeColor('H00G',255,200,200)set HeroTipLine1[heroIndex]="Breath Fire is a strong nuke and farming ability. However, against difficult opponents, Dragon's Blood is very useful."set HeroTipLine2[heroIndex]="Dragon Tail is the longest duration level 1 stun in the game. One point is usually sufficient until later on."set HeroTipLine3[heroIndex]="Thanks to the defensive bonuses on Dragon's Blood, he can often focus on other damage items instead of increasing armor and regeneration."set HeroTipLine4[heroIndex]="Level 1 of Elder Dragon Form has a special passive called Corrosive Attack, which deals significant damage over time against towers."set HeroTipLine5[heroIndex]="The ranged splash damage and slow of his Level 3 ultimate make him extremely powerful; getting to level 16 is very important for DK."set heroIndex=heroIndex+1set RestrictedTechId[34]='Edem'set ScaledUnitType[34]='h04T'set HeroTypeByPointValue[34]='n0AR'set HeroIconPath[34]="ReplaceableTextures\\CommandButtons\\BTNHeroDemonHunter.blp"call RegisterUnitTypeAnimation(RestrictedTechId[34],"stand channel")call RegisterUnitTypeScale(RestrictedTechId[34],1,ScaledUnitType[34])set HeroTipLine1[heroIndex]="Blink is very versatile, allowing you to chase, escape and even avoid certain spells. It is definitely worth at least one point in the beginning."set HeroTipLine2[heroIndex]="You can also use Mana Break to prevent enemy heroes from casting spells on you, but be careful since it forces you to get in melee range to attack."set HeroTipLine3[heroIndex]="Spell Shield might be useful for reducing magic damage, but it does not prevent you from being disabled or status effects (slow, poison, etc.)."set HeroTipLine4[heroIndex]="Offensive items without orb effects such as a Battle Fury, Monkey King Bar or Butterfly are usually desired over items that would override your Mana Break."set HeroTipLine5[heroIndex]="Sometimes survivability is just as important as damage, items such as Linken's Sphere or Manta Style offer a good mix of both offense and defense."set heroIndex=heroIndex+1set RestrictedTechId[35]='Nbrn'set ScaledUnitType[35]='h055'set HeroTypeByPointValue[35]='n0AL'set HeroIconPath[35]="ReplaceableTextures\\CommandButtons\\BTNBansheeRanger.tga"call RegisterUnitTypeAnimation(RestrictedTechId[35],"spell")call RegisterUnitTypeScale(RestrictedTechId[35],1,ScaledUnitType[35])set HeroTipLine1[heroIndex]="Frost Arrows make Drow an excellent chaser early game and allow her to harass opponents safely by manually casting them (clicking 'R' and the target)."set HeroTipLine2[heroIndex]="An early level of Silence is great for preventing opponents from using multiple spells on you or your allies."set HeroTipLine3[heroIndex]="Trueshot Aura and Marksmanship provide Traxex with plenty of damage even with just a few Wraith Bands and Power Treads."set HeroTipLine4[heroIndex]="Lothar's Edge provides damage and an escape mechanism, the latter of which can help Traxex survive."set HeroTipLine5[heroIndex]="Stay out of danger in major battles, only close in on your enemies when you are chasing and finishing off heroes near the end."set heroIndex=heroIndex+1set RestrictedTechId[36]='Harf'set ScaledUnitType[36]='h04Z'set HeroTypeByPointValue[36]='n0AS'set HeroIconPath[36]="ReplaceableTextures\\CommandButtons\\BTNArthas.blp"call RegisterUnitTypeAnimation(RestrictedTechId[36],"stand victory")call RegisterUnitTypeScale(RestrictedTechId[36],1.1,ScaledUnitType[36])set HeroTipLine1[heroIndex]="Omniknight is a powerful support hero, items that provide mana such as Arcane Ring help make sure that you can use all your spells."set HeroTipLine2[heroIndex]="Purification can be used offensively and defensively: The unit you cast it on will deal damage around it, making it a powerful heal and nuke."set HeroTipLine3[heroIndex]="Degen Aura is a very strong passive slow that is useful both to chase down enemy heroes and help you and your allies escape as well."set HeroTipLine4[heroIndex]="Repel is used to remove buffs from allies and enemies, and to prevent heroes with spells from being interrupted or damage dealers from being disabled."set HeroTipLine5[heroIndex]="Guardian Angel makes a team nearly impervious to physical damage and provides 25/sec HP regeneration, use this time wisely to survive or attack."set heroIndex=heroIndex+1set RestrictedTechId[37]='H00D'set ScaledUnitType[37]='h04S'set HeroTypeByPointValue[37]='n0AK'set HeroIconPath[37]="ReplaceableTextures\\CommandButtons\\BTNBeastMaster.blp"call RegisterUnitTypeAnimation(RestrictedTechId[37],"spell slam")call RegisterUnitTypeScale(RestrictedTechId[37],1,ScaledUnitType[37])set HeroTipLine1[heroIndex]="Endurance Aura is usually more useful later in the game when your team is fighting together, so get your other skills first."set HeroTipLine2[heroIndex]="Call of the Wild is very powerful: The boar gives damage and slow, while the hawk can provide vision over runes, neutral creeps and other key locations."set HeroTipLine3[heroIndex]="Wild Axes are more useful early game and against heroes with less armor. Destroy trees with Wild Axes to surprise your opponents and for escaping."set HeroTipLine4[heroIndex]="Try casting Wild Axes behind the target to compensate for their movement. You can also manipulate their return path by moving Rexxar."set HeroTipLine5[heroIndex]="Find opportunities to use Roar whenever it is available. It is useful on heroes who have an escape mechanism or are immune to magic."set heroIndex=heroIndex+1set RestrictedTechId[38]='E00P'set ScaledUnitType[38]='h04R'set HeroTypeByPointValue[38]='n0AJ'set HeroIconPath[38]="ReplaceableTextures\\CommandButtons\\BTNChimaera.blp"call RegisterUnitTypeAnimation(RestrictedTechId[38],"stand 3")call RegisterUnitTypeScale(RestrictedTechId[38],1,ScaledUnitType[38])set HeroTipLine1[heroIndex]="Dual Breath and Ice Path help to make Jakiro a strong offensive and defensive support hero. "set HeroTipLine2[heroIndex]="Jakiro can cast his spells immediately by clicking the nearby ground in the desired direction, sometimes this is more effective than clicking on the target."set HeroTipLine3[heroIndex]="A level of Liquid Fire early on can be useful for deterring physical attacks "set HeroTipLine4[heroIndex]="Macropyre is a slow but powerful spell, combine it with other spells (yours or a teammate) to make sure the opponent is standing in the area of effect."set HeroTipLine5[heroIndex]="It is often a good idea to purchase useful support items like Mekansm or Shiva's Guard, two items that also increase his low armor significantly."set heroIndex=heroIndex+1set RestrictedTechId[39]='N01I'set ScaledUnitType[39]='h054'set HeroTypeByPointValue[39]='n0AI'set HeroIconPath[39]="ReplaceableTextures\\CommandButtons\\BTNHeroAlchemist.blp"call RegisterUnitTypeAnimation(RestrictedTechId[39],"stand 2")call RegisterUnitTypeScale(RestrictedTechId[39],1,ScaledUnitType[39])call RegisterUnitTypeScale('N01J',1,ScaledUnitType[39])call RegisterUnitTypeScale('N01H',1,ScaledUnitType[39])call RegisterUnitTypeScale('N01T',1,ScaledUnitType[39])set HeroTipLine1[heroIndex]=""set HeroTipLine2[heroIndex]=""set HeroTipLine3[heroIndex]=""set HeroTipLine4[heroIndex]=""set HeroTipLine5[heroIndex]=""set heroIndex=heroIndex+1set RestrictedTechId[40]='N01V'set ScaledUnitType[40]='h04W'set HeroTypeByPointValue[40]='n0AH'set HeroIconPath[40]="ReplaceableTextures\\CommandButtons\\BTNPriestessOfTheMoon.blp"call RegisterUnitTypeAnimation(RestrictedTechId[40],"stand ready")call RegisterUnitTypeScale(RestrictedTechId[40],1,ScaledUnitType[40])set HeroTipLine1[heroIndex]="PotM can be extremely efficient and gank with just a few Wraith Bands, Boots of Speed and a Bottle."set HeroTipLine2[heroIndex]="Getting one level of Leap is usually sufficient early on until Starfall and Elune's Arrow are fully leveled."set HeroTipLine3[heroIndex]="Land your Elune's Arrow by coordinating with allies and predicting enemy movements. You can even hit invisible or faraway targets with practice."set HeroTipLine4[heroIndex]="Starfall hits a second time for half damage to one random enemy within 200 range, get close if you can to deal bonus damage"set HeroTipLine5[heroIndex]="Moonlight Shadow can be used to initiate or escape but sometimes it can be learned later when PotM can use it without compromising her mana pool."set heroIndex=heroIndex+1set RestrictedTechId[41]='H00S'set ScaledUnitType[41]='h04Q'set HeroTypeByPointValue[41]='n0AT'set HeroIconPath[41]="ReplaceableTextures\\CommandButtons\\BTNStorm.blp"call RegisterUnitTypeAnimation(RestrictedTechId[41],"spell")call RegisterUnitTypeScale(RestrictedTechId[41],1,ScaledUnitType[41])set HeroTipLine1[heroIndex]="Do not get Overload at level 1 since you do not have any spells to activate its effect with."set HeroTipLine2[heroIndex]="Choosing which ability to max first can be difficult, but generally at least one point in all three skills is a good idea."set HeroTipLine3[heroIndex]="You have to wait 1 second after casting Static Remnant before it begins detecting nearby units for its explosion effect."set HeroTipLine4[heroIndex]="In addition to chasing and escaping, Lightning Ball can be used to dodge many spells with the right timing."set HeroTipLine5[heroIndex]="An item like Bloodstone is useful on Storm Spirit because the percentage-based mana cost of Lightning Ball makes regeneration an important asset."set heroIndex=heroIndex+1set RestrictedTechId[42]='H00Q'set ScaledUnitType[42]='h04Y'set HeroTypeByPointValue[42]='n0AG'set HeroIconPath[42]="ReplaceableTextures\\CommandButtons\\BTNHeadHunterBerserker.blp"call RegisterUnitTypeAnimation(RestrictedTechId[42],"stand alternate 3")call RegisterUnitTypeScale(RestrictedTechId[42],1.15,ScaledUnitType[42])set HeroTipLine1[heroIndex]="A level of Burning Spears early on is great for harassing enemy heroes. Use it manually by clicking 'R' then the desired target to avoid drawing focus fire."set HeroTipLine2[heroIndex]="Berserker's Blood makes you stronger as you take damage. The bonuses stop when you have 51% HP, so there is little point in taking additional damage."set HeroTipLine3[heroIndex]="Life Break deals damage based on the remaining health of the target, making it strongest at the beginning of a fight. "set HeroTipLine4[heroIndex]="Inner Vitality heals more when you have less than 40% of your life, but avoid making the mistake of casting it too late in battles."set HeroTipLine5[heroIndex]="Survivability while in low health is important for Huskar: Consider items such as Armlet of Mordiggan, Black King Bar, or Heart of Tarrasque."set heroIndex=heroIndex+1set RestrictedTechId[43]='E01Y'set ScaledUnitType[43]='h058'set HeroTypeByPointValue[43]='n0AF'set HeroIconPath[43]="ReplaceableTextures\\CommandButtons\\BTNAssassin.blp"call RegisterUnitTypeAnimation(RestrictedTechId[43],"stand victory")call RegisterUnitTypeScale(RestrictedTechId[43],1.2,ScaledUnitType[43])set HeroTipLine1[heroIndex]="Refraction is a great way of surviving in a lane, just be careful not to get hit by creeps too much."set HeroTipLine2[heroIndex]="Meld starts cooling down when you click the spell, so you can hit him twice with it if you can predict your enemy's movements."set HeroTipLine3[heroIndex]="Traps can be used for vision, most effectively in cramped areas like the end of ramps or at the rune powerup spots."set HeroTipLine4[heroIndex]="You can farm extremely fast by positioning yourself so that the Psi Blades splash on multiple creeps at once."set HeroTipLine5[heroIndex]="Placing a trap or two before engaging a fight can be a good idea, to cut off possible escape and/or chase routes."set heroIndex=heroIndex+1set RestrictedTechId[44]='N00B'set ScaledUnitType[44]='h050'set HeroTypeByPointValue[44]='n0AE'set HeroIconPath[44]="ReplaceableTextures\\CommandButtons\\BTNFaerieDragon.blp"call RegisterUnitTypeAnimation(RestrictedTechId[44],"attack spell")call RegisterUnitTypeScale(RestrictedTechId[44],1.1,ScaledUnitType[44])set HeroTipLine1[heroIndex]="Illusory Orb and Jaunt are used to travel short distances quickly, but if you wait too long to Jaunt, you will lose the opportunity."set HeroTipLine2[heroIndex]="Puck is very fragile early game, some Bracers or Null Talismans and a level of Phase Shift can help you survive."set HeroTipLine3[heroIndex]="Using Phase Shift manually instead of Autocast will prevent stray attacks from triggering it on Autocast. In general you will have better control of its use."set HeroTipLine4[heroIndex]="Waning Rift deals damage and silences, but forces you to be close enough. Use Illusory Orb or Dream Coil to help you land the spell on enemies."set HeroTipLine5[heroIndex]="Puck is a great initiator in fights who offers control of the battle with his spells, allowing allies to join the battle and use their spells or attacks safely."set heroIndex=heroIndex+1set RestrictedTechId[45]='H00T'set ScaledUnitType[45]='h051'set HeroTypeByPointValue[45]='n0AU'set HeroIconPath[45]="ReplaceableTextures\\CommandButtons\\BTNClockWerkGoblin.blp"call RegisterUnitTypeAnimation(RestrictedTechId[45],"Birth")call RegisterUnitTypeScale(RestrictedTechId[45],1.5,ScaledUnitType[45])set HeroTipLine1[heroIndex]="You can use Rocket Flare for harassing and killing creeps early on. With the right timing, you can even fire at enemies across the map."set HeroTipLine2[heroIndex]="Power Cogs can be used to trap an enemy, push them away while draining mana, or as an escape mechanism since Rattletrap destroys Cogs in only 1 hit."set HeroTipLine3[heroIndex]="Battery Assault adds a lot of damage and the stuns help you with chasing, use it when no other units are nearby for best results."set HeroTipLine4[heroIndex]="Hookshot's long range and high speed let you reach enemies from out of sight. Follow up with your other spells quickly so your target cannot escape."set HeroTipLine5[heroIndex]="Rocket Flare also gives vision where it lands, making it very useful for scouting areas such as rune spots, neutral creeps, the enemy base."set heroIndex=heroIndex+1set RestrictedTechId[46]='H06S'set ScaledUnitType[46]='h06T'set HeroTypeByPointValue[46]='n0EE'set HeroIconPath[46]="ReplaceableTextures\\CommandButtons\\BTNProudmoore.blp"call RegisterUnitTypeAnimation(RestrictedTechId[46],"stand victory")call RegisterUnitTypeScale(RestrictedTechId[46],1.1,ScaledUnitType[46])set HeroTipLine1[heroIndex]="Tidebringer is extremely useful early game: Use the bonus damage for killing creeps and the cleave effect to harass opponents at the same time."set HeroTipLine2[heroIndex]="The bubble animation from Torrent can only be seen by your team so try to use this to your advantage."set HeroTipLine3[heroIndex]="An ally's assistance or X Marks the Spot is a great way of making sure Torrent and Ghost Ship hit your opponent."set HeroTipLine4[heroIndex]="Escaping enemy heroes is easy by casting X Marks the Spot on them. It also prevents them from getting away."set HeroTipLine5[heroIndex]="The Ghost Ship will crash 1000 range from where you stand when you cast it. Keep your distance when you use it."set heroIndex=heroIndex+1set RestrictedTechId[47]='N0EG'set ScaledUnitType[47]='h07A'set HeroTypeByPointValue[47]='n0EH'set HeroIconPath[47]="ReplaceableTextures\\CommandButtons\\BTNSylvanusWindrunner.blp"call RegisterUnitTypeAnimation(RestrictedTechId[47],"stand victory")call RegisterUnitTypeScale(RestrictedTechId[47],1.2,ScaledUnitType[47])set HeroTipLine1[heroIndex]="Powershot deals significant damage, making it ideal to max first. Be sure not to fire through creeps if you want to deal maximum damage to your target."set HeroTipLine2[heroIndex]="An early level of Windrunner can provide you with a quick getaway and chasing tool."set HeroTipLine3[heroIndex]="Shackleshot can either be used on your intended target to bind him to a nearby unit, or to bind the designated target located BEHIND the unit that you fired it at."set HeroTipLine4[heroIndex]="Focus Fire is also a powerful spell to use on buildings and Roshan."set HeroTipLine5[heroIndex]="As long as you do not attack another target, the effect of Focus Fire will stay on. Use your spells and active items to help you fire at your target."set heroIndex=heroIndex+1set RestrictedTechId[48]='E02N'set ScaledUnitType[48]='h0CC'set HeroTypeByPointValue[48]='n0KN'set HeroIconPath[48]="ReplaceableTextures\\CommandButtons\\BTNFlyingMachine.blp"call RegisterUnitTypeAnimation(RestrictedTechId[48],"stand 3")call RegisterUnitTypeScale(RestrictedTechId[48],1.1,ScaledUnitType[48])call RegisterUnitTypeScale('E02O',1.1,ScaledUnitType[48])set HeroTipLine1[heroIndex]=""set HeroTipLine2[heroIndex]=""set HeroTipLine3[heroIndex]=""set HeroTipLine4[heroIndex]=""set HeroTipLine5[heroIndex]=""set heroIndex=heroIndex+1set RestrictedTechId[49]='E02J'set ScaledUnitType[49]='h0CD'set HeroTypeByPointValue[49]='n0KR'set HeroIconPath[49]="ReplaceableTextures\\CommandButtons\\BTNThrall.blp"call RegisterUnitTypeAnimation(RestrictedTechId[49],"stand 3")call RegisterUnitTypeScale(RestrictedTechId[49],1.1,ScaledUnitType[49])set HeroTipLine1[heroIndex]=""set HeroTipLine2[heroIndex]=""set HeroTipLine3[heroIndex]=""set HeroTipLine4[heroIndex]=""set HeroTipLine5[heroIndex]=""set heroIndex=heroIndex+1set RestrictedTechId[50]='E02I'set ScaledUnitType[50]='h0C9'set HeroTypeByPointValue[50]='n0KK'set HeroIconPath[50]="ReplaceableTextures\\CommandButtons\\BTNTuskaarBrown.blp"call RegisterUnitTypeAnimation(RestrictedTechId[50],"stand 3")call RegisterUnitTypeScale(RestrictedTechId[50],1.,ScaledUnitType[50])set HeroTipLine1[heroIndex]=""set HeroTipLine2[heroIndex]=""set HeroTipLine3[heroIndex]=""set HeroTipLine4[heroIndex]=""set HeroTipLine5[heroIndex]=""set heroIndex=heroIndex+1set RestrictedTechId[51]='E02F'set ScaledUnitType[51]='h0C8'set HeroTypeByPointValue[51]='n0KM'set HeroIconPath[51]="ReplaceableTextures\\CommandButtons\\BTNPhoenix.blp"call RegisterUnitTypeAnimation(RestrictedTechId[51],"stand 3")call RegisterUnitTypeScale(RestrictedTechId[51],1.05,ScaledUnitType[51])set HeroTipLine1[heroIndex]=""set HeroTipLine2[heroIndex]=""set HeroTipLine3[heroIndex]=""set HeroTipLine4[heroIndex]=""set HeroTipLine5[heroIndex]=""set heroIndex=heroIndex+1set RestrictedTechId[52]='H008'set ScaledUnitType[52]='h04U'set HeroTypeByPointValue[52]='n0AC'set HeroIconPath[52]="ReplaceableTextures\\CommandButtons\\BTNRazorback.blp"call RegisterUnitTypeAnimation(RestrictedTechId[52],"stand")call RegisterUnitTypeScale(RestrictedTechId[52],1.65,ScaledUnitType[52])set HeroTipLine1[heroIndex]="Rigwarl is known for punishing heroes that attack him and surviving for a long time but he still needs armor, regeneration and hit points."set HeroTipLine2[heroIndex]="Quill spray doesn't initially deal much damage, but the stacking effect makes it very powerful over time in battles."set HeroTipLine3[heroIndex]="Sometimes one level of Goo can be enough to slow down an enemy hero early game."set HeroTipLine4[heroIndex]="Rigwarl needs a fair amount of mana early-game, Ring of Basilius, Magic Stick or Bottle can boost his early offensive power immensely."set HeroTipLine5[heroIndex]="You can mitigate a lot of damage if you turn your hero at the right times thanks to your passive Bristleback. Play mind games on your opponent."set heroIndex=heroIndex+1set RestrictedTechId[53]='E02X'set ScaledUnitType[53]='h0CT'set HeroTypeByPointValue[53]='n0LK'set HeroIconPath[53]="ReplaceableTextures\\CommandButtons\\BTNMedivh.blp"call RegisterUnitTypeAnimation(RestrictedTechId[53],"stand 3")call RegisterUnitTypeScale(RestrictedTechId[53],1.15,ScaledUnitType[53])set HeroTipLine1[heroIndex]=""set HeroTipLine2[heroIndex]=""set HeroTipLine3[heroIndex]=""set HeroTipLine4[heroIndex]=""set HeroTipLine5[heroIndex]=""set heroIndex=heroIndex+1set RestrictedTechId[54]='N0M0'set ScaledUnitType[54]='h0DG'set HeroTypeByPointValue[54]='n0M1'set HeroIconPath[54]="ReplaceableTextures\\CommandButtons\\BTNFireBrewmaster.blp"call RegisterUnitTypeAnimation(RestrictedTechId[54],"stand 3")call RegisterUnitTypeScale(RestrictedTechId[54],1,ScaledUnitType[54])set HeroTipLine1[heroIndex]=""set HeroTipLine2[heroIndex]=""set HeroTipLine3[heroIndex]=""set HeroTipLine4[heroIndex]=""set HeroTipLine5[heroIndex]=""set heroIndex=heroIndex+1set RestrictedTechId[55]='E02K'set ScaledUnitType[55]='h0CA'set HeroTypeByPointValue[55]='n0KJ'set HeroIconPath[55]="ReplaceableTextures\\CommandButtons\\BTNGarithos.blp"call RegisterUnitTypeAnimation(RestrictedTechId[55],"stand 3")call RegisterUnitTypeScale(RestrictedTechId[55],1.3,ScaledUnitType[55])set HeroTipLine1[heroIndex]=""set HeroTipLine2[heroIndex]=""set HeroTipLine3[heroIndex]=""set HeroTipLine4[heroIndex]=""set HeroTipLine5[heroIndex]=""set heroIndex=heroIndex+1set RestrictedTechId[56]='H0DO'set ScaledUnitType[56]='h0DH'set HeroTypeByPointValue[56]='n0M6'set HeroIconPath[56]="ReplaceableTextures\\CommandButtons\\BTNDragonHawk.blp"call RegisterUnitTypeAnimation(RestrictedTechId[56],"stand 3")call RegisterUnitTypeScale(RestrictedTechId[56],1.1,ScaledUnitType[56])set HeroTipLine1[heroIndex]=""set HeroTipLine2[heroIndex]=""set HeroTipLine3[heroIndex]=""set HeroTipLine4[heroIndex]=""set HeroTipLine5[heroIndex]=""set heroIndex=heroIndex+1set RestrictedTechId[57]='E032'set ScaledUnitType[57]='h0EB'set HeroTypeByPointValue[57]='n0ME'set HeroIconPath[57]="ReplaceableTextures\\CommandButtons\\BTNJunkGolem.blp"call RegisterUnitTypeAnimation(RestrictedTechId[57],"stand 3")call RegisterUnitTypeScale(RestrictedTechId[57],1,ScaledUnitType[57])set HeroTipLine1[heroIndex]=""set HeroTipLine2[heroIndex]=""set HeroTipLine3[heroIndex]=""set HeroTipLine4[heroIndex]=""set HeroTipLine5[heroIndex]=""set heroIndex=heroIndex+1set RestrictedTechId[58]='N0MU'set ScaledUnitType[58]='h0EK'set HeroTypeByPointValue[58]='n0MV'set HeroIconPath[58]="ReplaceableTextures\\CommandButtons\\BTNEarthBrewmaster.blp"call RegisterUnitTypeAnimation(RestrictedTechId[58],"stand 3")call RegisterUnitTypeScale(RestrictedTechId[58],1,ScaledUnitType[58])set HeroTipLine1[heroIndex]=""set HeroTipLine2[heroIndex]=""set HeroTipLine3[heroIndex]=""set HeroTipLine4[heroIndex]=""set HeroTipLine5[heroIndex]=""set heroIndex=heroIndex+1set RestrictedTechId[59]='N0MD'set ScaledUnitType[59]='h0EP'set HeroTypeByPointValue[59]='n0MG'set HeroIconPath[59]="ReplaceableTextures\\CommandButtons\\BTNPriest.blp"call RegisterUnitTypeAnimation(RestrictedTechId[59],"stand victory")call RegisterUnitTypeScale(RestrictedTechId[59],1.25,ScaledUnitType[59])set HeroTipLine1[heroIndex]=""set HeroTipLine2[heroIndex]=""set HeroTipLine3[heroIndex]=""set HeroTipLine4[heroIndex]=""set HeroTipLine5[heroIndex]=""set heroIndex=heroIndex+1set HeroPoolLoopBoundA=59set heroIndex=60set HeroPoolLoopStartB=60set RestrictedTechId[60]='Ewar'set ScaledUnitType[60]='h05J'set HeroTypeByPointValue[60]='n0B5'set HeroIconPath[60]="ReplaceableTextures\\CommandButtons\\BTNHeroWarden.blp"call RegisterUnitTypeAnimation(RestrictedTechId[60],"spell slam")call RegisterUnitTypeScale(RestrictedTechId[60],1,ScaledUnitType[60])set HeroTipLine1[heroIndex]="Stifling Dagger is used for creep-killing and slowing opponents; prevent enemies from escaping by using it with Blink Strike."set HeroTipLine2[heroIndex]="Try to Blink Strike to a nearby allied or enemy unit to make a quick escape when caught in a defensive situation. "set HeroTipLine3[heroIndex]="Be cautious when entering battles with Blink Strike, you could be caught outnumbered or disabled without your escape mechanism."set HeroTipLine4[heroIndex]="Blur can sometimes allow you to surprise opponents if they aren't paying attention."set HeroTipLine5[heroIndex]="Items like Battle Fury are useful, but getting a Black King Bar or a Satanic afterward will help you survive long enough to deal damage."set heroIndex=heroIndex+1set RestrictedTechId[61]='H00V'set ScaledUnitType[61]='h05K'set HeroTypeByPointValue[61]='n0B6'set HeroIconPath[61]="ReplaceableTextures\\CommandButtons\\BTNNagaSeaWitch.blp"call RegisterUnitTypeAnimation(RestrictedTechId[61],"stand ready")call RegisterUnitTypeScale(RestrictedTechId[61],1,ScaledUnitType[61])call RegisterUnitTypeScale('H08D',1,ScaledUnitType[61])call RegisterUnitTypeScale('H08C',1,ScaledUnitType[61])call RegisterUnitTypeScale('H084',1,ScaledUnitType[61])call RegisterUnitTypeScale('H08B',1,ScaledUnitType[61])set HeroTipLine1[heroIndex]="Mystic Snake is a smart choice to have early game: Its damage and mana drain make it great for harassing and offsetting its own mana cost."set HeroTipLine2[heroIndex]="Mana Shield will increase your survivability drastically. Use it wisely or it can also leave you with no mana for your other spells."set HeroTipLine3[heroIndex]="Using Split Shot allows you to attack multiple units, but the extra arrows from Split Shot do not gain the properties of orb effects."set HeroTipLine4[heroIndex]="Stone Gaze is an ultimate that is used to slow opponents and remove their buffs, making it easy to escape or attack the purged enemies."set HeroTipLine5[heroIndex]="Items that increase statistics and regeneration like Linken's Sphere will always be a good choice because of Mana Shield."set heroIndex=heroIndex+1set RestrictedTechId[62]='Udre'set ScaledUnitType[62]='h05L'set HeroTypeByPointValue[62]='n0B7'set HeroIconPath[62]="ReplaceableTextures\\CommandButtons\\BTNTichondrius.blp"call RegisterUnitTypeAnimation(RestrictedTechId[62],"spell slam")call RegisterUnitTypeScale(RestrictedTechId[62],1,ScaledUnitType[62])set HeroTipLine1[heroIndex]="Night Stalker may be passive during the day, but at night his spells make him much more powerful and great for hunting heroes down."set HeroTipLine2[heroIndex]="Void is your primary source of damage early game and can be used to interrupt spells and teleports with its mini-stun."set HeroTipLine3[heroIndex]="While Hunter in the Night does nothing during the day, get it so that during nighttime it will give you massive movement and attack speed."set HeroTipLine4[heroIndex]="Use Crippling Fear when you are hunting heroes so that they cannot disable or slow you while you are chasing them."set HeroTipLine5[heroIndex]="Since Darkness will pause time when activated, casting it at night whenever it is on cooldown will extend the total nighttime."set heroIndex=heroIndex+1set RestrictedTechId[63]='NC00'set ScaledUnitType[63]='h05M'set HeroTypeByPointValue[63]='n0C0'set HeroIconPath[63]="ReplaceableTextures\\CommandButtons\\BTNSkeletonArcher.tga"call RegisterUnitTypeAnimation(RestrictedTechId[63],"stand victory")call RegisterUnitTypeScale(RestrictedTechId[63],1.8,ScaledUnitType[63])call RegisterUnitTypeColor(RestrictedTechId[63],100,125,100)set HeroTipLine1[heroIndex]="Skeleton King is a hero who is known for his ability to reincarnate if focused upon and dealing a lot of damage if he is ignored by opponents. "set HeroTipLine2[heroIndex]="Hellfire Blast is a great spell for the early laning phase and a few levels of Attribute Bonus can give you stat points for additional stuns."set HeroTipLine3[heroIndex]="Critical Strike is generally preferred over Vampiric Aura because its lifesteal is not very effective earlier when Leoric needs more damage."set HeroTipLine4[heroIndex]="Make sure you have enough mana for Hellfire Blasts and especially Reincarnation. Buying a Magic Stick and/or a Bottle can pay off nicely."set HeroTipLine5[heroIndex]="Get cheaper damage items like Armlet of Mordiggan and Desolator. A Black King Bar will allow you to dish out damage without being disabled."set heroIndex=heroIndex+1set RestrictedTechId[64]='UC42'set ScaledUnitType[64]='h05N'set HeroTypeByPointValue[64]='n0BV'set HeroIconPath[64]="ReplaceableTextures\\CommandButtons\\BTNDoomGuard.blp"call RegisterUnitTypeAnimation(RestrictedTechId[64],"stand victory")call RegisterUnitTypeScale(RestrictedTechId[64],1.1,ScaledUnitType[64])set HeroTipLine1[heroIndex]="Lucifer can obtain gold very quickly thanks to Devour, so getting regeneration items like Perseverance will help him to cast spells and survive in the lane."set HeroTipLine2[heroIndex]="Devour deals 20 damage per second, so consume creeps with low HP remaining so you can finish digesting the enemy quickly."set HeroTipLine3[heroIndex]="Watch your opponents' levels to pick out potential LVL? Death targets. Its mini-stun will also interrupt channeling spells and teleports."set HeroTipLine4[heroIndex]="Doom is usually used in conjunction with LVL? Death for killing enemy heroes; you can also use it on heroes to silence their spells."set HeroTipLine5[heroIndex]="When chasing or escaping with Scorched Earth, cast it in front of you so that you will experience the movement speed bonuses for a longer period of time."set heroIndex=heroIndex+1set RestrictedTechId[65]='U000'set ScaledUnitType[65]='h05O'set HeroTypeByPointValue[65]='n0BU'set HeroIconPath[65]="ReplaceableTextures\\CommandButtons\\BTNHeroCryptLord.tga"call RegisterUnitTypeAnimation(RestrictedTechId[65],"spell throw")call RegisterUnitTypeScale(RestrictedTechId[65],.8,ScaledUnitType[65])set HeroTipLine1[heroIndex]="Effective use of Impale and Mana Burn early game requires you to purchase some Null Talismans or Bracers and Bottle."set HeroTipLine2[heroIndex]="Mana Burn is a devastating spell to have in the lane, force opponents to play defensively by preventing them from casting spells."set HeroTipLine3[heroIndex]="Unlike other Agility heroes, Anub'arak is a caster. Getting items like Dagon can be more useful than purchasing damage items."set HeroTipLine4[heroIndex]="Vendetta is a good initiating spell for surprising opponents. Cast it far away so that they cannot hear its sound effect upon activation."set HeroTipLine5[heroIndex]="Be careful when using Vendetta against multiple opponents and going near towers where they can see you while you are invisible."set heroIndex=heroIndex+1set RestrictedTechId[66]='UC91'set ScaledUnitType[66]='h05P'set HeroTypeByPointValue[66]='n0C1'set HeroIconPath[66]="ReplaceableTextures\\CommandButtons\\BTNNagaMyrmidon.tga"call RegisterUnitTypeAnimation(RestrictedTechId[66],"spell")call RegisterUnitTypeScale(RestrictedTechId[66],1,ScaledUnitType[66])call RegisterUnitTypeColor(RestrictedTechId[66],175,75,200)set HeroTipLine1[heroIndex]="Slithereen Crush requires good positioning, so do your best to stand next to the hero you are trying to stun."set HeroTipLine2[heroIndex]="Sprint is a great spell for both chasing and escaping but be careful when using it because you will take bonus damage."set HeroTipLine3[heroIndex]="In addition to lowering armor, Amplify Damage provides vision of enemies, even heroes that have the ability to become invisible."set HeroTipLine4[heroIndex]="Bash is usually more effective later in the game when you have more items like Armlet of Mordiggan."set HeroTipLine5[heroIndex]="Slardar's role in battles is to initiate with Slithereen Crush and focus an enemy with Bash and Amplify Damage. Pick off escapees with Sprint."set heroIndex=heroIndex+1set RestrictedTechId[67]='UC01'set ScaledUnitType[67]='h05Q'set HeroTypeByPointValue[67]='n0C2'set HeroIconPath[67]="ReplaceableTextures\\CommandButtons\\BTNBlueDemoness.tga"call RegisterUnitTypeAnimation(RestrictedTechId[67],"spell slam")call RegisterUnitTypeScale(RestrictedTechId[67],1.3,ScaledUnitType[67])set HeroTipLine1[heroIndex]="Blink provides you with an escape mechanism and spell dodge but on higher levels it becomes a powerful chasing tool as well."set HeroTipLine2[heroIndex]="Scream of Pain is used for killing creeps and harassing opponents, making it more useful than Shadow Strike early game."set HeroTipLine3[heroIndex]="Try to hit as many targets as possible with Sonic Wave by targeting the ground instead of on an enemy hero directly."set HeroTipLine4[heroIndex]="Shadow Strike does decent damage but its primary use is for the slow it provides for chasing and outrunning opponents."set HeroTipLine5[heroIndex]="Her spell reliance, mobility and survivability allow her to buy expensive Intelligence items such as a Guinsoo's Scythe of Vyse."set heroIndex=heroIndex+1set RestrictedTechId[68]='E004'set ScaledUnitType[68]='h05R'set HeroTypeByPointValue[68]='n0BW'set HeroIconPath[68]="ReplaceableTextures\\CommandButtons\\BTNSkeletonMage.blp"call RegisterUnitTypeAnimation(RestrictedTechId[68],"stand victory")call RegisterUnitTypeScale(RestrictedTechId[68],1,ScaledUnitType[68])set HeroTipLine1[heroIndex]="Searing Arrows provide damage for last hitting creeps and harassing enemy heroes by using it manually by clicking 'R' followed by the designated target."set HeroTipLine2[heroIndex]="Wind Walk is commonly used for chasing and escaping but the invisibility and movement speed can help you avoid specific spells with the right timing."set HeroTipLine3[heroIndex]="Cast Death Pact on enemy or neutral creeps instead of allied units whenever possible because it will give you the gold for killing the unit."set HeroTipLine4[heroIndex]="Regeneration items like Orchid Malevolence or a Linken's Sphere will allow liberal use of his abilities in battle and help him against spellcasters and nukers."set HeroTipLine5[heroIndex]="Strafe is usually gotten later, but combined with Searing Arrows, Clinkz can deal a lot of damage quickly, powerful against enemy heroes and buildings."set heroIndex=heroIndex+1set RestrictedTechId[69]='EC45'set ScaledUnitType[69]='h05S'set HeroTypeByPointValue[69]='n0BS'set HeroIconPath[69]="ReplaceableTextures\\CommandButtons\\BTNFacelessOne.blp"call RegisterUnitTypeAnimation(RestrictedTechId[69],"spell slam")call RegisterUnitTypeScale(RestrictedTechId[69],1.3,ScaledUnitType[69])call RegisterUnitTypeColor(RestrictedTechId[69],0,255,150)set HeroTipLine1[heroIndex]="Time Walk is your escaping and chasing skill, but it will allow you to avoid spells and damage since you are invulnerable during the animation."set HeroTipLine2[heroIndex]="Get Backtrack early game if you need to play defensively, while Time Lock will allow you to be a little more aggressive."set HeroTipLine3[heroIndex]="Since Darkterror is so fragile, enter battles by using Time Walk and then cast Chronosphere to prevent yourself from being disabled or killed otherwise."set HeroTipLine4[heroIndex]="Chronosphere affects all units that are not controlled by you, including both allies and enemies. Avoid hitting teammates or it could cost them their lives."set HeroTipLine5[heroIndex]="Items such as Power Treads and Butterfly will give both damage and attack speed, which is useful if Void wants to repetitively stun with Time Lock."set heroIndex=heroIndex+1set RestrictedTechId[70]='EC77'set ScaledUnitType[70]='h05T'set HeroTypeByPointValue[70]='n0BR'set HeroIconPath[70]="ReplaceableTextures\\CommandButtons\\BTNNetherDragon.blp"call RegisterUnitTypeAnimation(RestrictedTechId[70],"spell slam")call RegisterUnitTypeScale(RestrictedTechId[70],1.2,ScaledUnitType[70])call RegisterUnitTypeColor(RestrictedTechId[70],75,255,25)set HeroTipLine1[heroIndex]="Poison Attack allows you to harass an opponent and permanently chase them thanks to a 0 cooldown starting at level 3."set HeroTipLine2[heroIndex]="Prevent creeps and towers from attacking you by casting Poison Attack manually by clicking 'C' and then the designated target."set HeroTipLine3[heroIndex]="Neurotoxin will add bonus damage, useful early for getting the last hit on creeps and also for dealing damage to heroes as well."set HeroTipLine4[heroIndex]="Early HP and movement speed items like Phase Boots or a Point/Vitality Booster can really make a difference."set HeroTipLine5[heroIndex]="Sometimes it is wise to invest in a Lothar's Edge or Kelen's Dagger to provide you with the ability to get in and out of combat safely."set heroIndex=heroIndex+1set RestrictedTechId[71]='E002'set ScaledUnitType[71]='h05U'set HeroTypeByPointValue[71]='n0BY'set HeroIconPath[71]="ReplaceableTextures\\CommandButtons\\BTNRevenant.blp"call RegisterUnitTypeAnimation(RestrictedTechId[71],"spell")call RegisterUnitTypeScale(RestrictedTechId[71],1,ScaledUnitType[71])set HeroTipLine1[heroIndex]="Use your attack range to help gauge how far opponents need to be for Plasma Field to deal the most damage."set HeroTipLine2[heroIndex]="Unstable Current will slow opponents who cast spells on you and could be useful to help prevent yourself from being killed."set HeroTipLine3[heroIndex]="Static Link is powerful if you can stay within the range of opponents - getting Unstable Current can sometimes help with that."set HeroTipLine4[heroIndex]="Storm Seeker strikes the target with the lowest health, so use it after creeps have died or when chasing a solitary target."set HeroTipLine5[heroIndex]="Consider increasing your HP along with damage when purchasing items."set heroIndex=heroIndex+1set RestrictedTechId[72]='U00C'set ScaledUnitType[72]='h05V'set HeroTypeByPointValue[72]='n0BQ'set HeroIconPath[72]="ReplaceableTextures\\CommandButtons\\BTNGhoul.blp"call RegisterUnitTypeAnimation(RestrictedTechId[72],"victory")call RegisterUnitTypeScale(RestrictedTechId[72],1.5,ScaledUnitType[72])call RegisterUnitTypeColor(RestrictedTechId[72],100,100,100)set HeroTipLine1[heroIndex]="Open Wounds is a powerful slow that nearly stops enemies in their tracks; it also lets you and your allies heal for attacking that unit."set HeroTipLine2[heroIndex]="Feast deals percentage-based damage, which is useful against heroes with high HP and lets Naix fight neutral creeps with ease."set HeroTipLine3[heroIndex]="Rage can be used to avoid spells and to prevent opponents from disabling you while you are attacking them or trying to escape from them."set HeroTipLine4[heroIndex]="Infest can be used for escaping, surprising your opponents, to neutral, or to just gain significant health quickly when necessary."set HeroTipLine5[heroIndex]="Thanks to your physical damage and ability to steal life, Armlet of Mordiggan or Desolator are both solid choices for high-tier items."set heroIndex=heroIndex+1set RestrictedTechId[73]='H00H'set ScaledUnitType[73]='h05W'set HeroTypeByPointValue[73]='n0BT'set HeroIconPath[73]="ReplaceableTextures\\CommandButtons\\BTNPugna.BLP"call RegisterUnitTypeAnimation(RestrictedTechId[73],"stand ready")call RegisterUnitTypeScale(RestrictedTechId[73],1,ScaledUnitType[73])set HeroTipLine1[heroIndex]="Nether Blast gives you an incredible skill for killing creeps, harassing heroes and pushing. Use it to score the killing blow to a tower."set HeroTipLine2[heroIndex]="Decrepify can be used on opponents either to increase spell damage from you and your allies or to prevent them from attacking."set HeroTipLine3[heroIndex]="Nether Ward will drain mana and punish opponents for using spells. Just remember to cast it where opponents cannot destroy it easily."set HeroTipLine4[heroIndex]="Aghanim's Scepter, Linken's Sphere and Bloodstone are examples of items that offer survivability while improving his spellcasting abilities."set HeroTipLine5[heroIndex]="Life Drain deals a lot of damage unless opponents disable you or run away. With an Aghanim's Scepter, its cooldown becomes 0."set heroIndex=heroIndex+1set RestrictedTechId[74]='Ofar'set ScaledUnitType[74]='h05X'set HeroTypeByPointValue[74]='n0BP'set HeroIconPath[74]="ReplaceableTextures\\CommandButtons\\BTNSeaGiantGreen.blp"call RegisterUnitTypeAnimation(RestrictedTechId[74],"attack slam")call RegisterUnitTypeScale(RestrictedTechId[74],1,ScaledUnitType[74])set HeroTipLine1[heroIndex]="Be sure to attack enemies slowed by Gush, the armor reduction means that your hits will deal more damage than normal."set HeroTipLine2[heroIndex]="Anchor Smash is an offensive damage spell that lets you hurt multiple units, good for killing neutral creeps and useful in team battles."set HeroTipLine3[heroIndex]="Kraken Shell gives you some protection against physical damage as well as a debuff removal against certain spells."set HeroTipLine4[heroIndex]="In fights, Tidehunter should be in the middle of the action drawing focus fire and dealing damage because of his skill set and high survivability."set HeroTipLine5[heroIndex]="Ravage has a large area of effect but Kelen's Dagger will allow you to initiate without being disabled and use it in an optimal spot."set heroIndex=heroIndex+1set RestrictedTechId[75]='Oshd'set ScaledUnitType[75]='h05Y'set HeroTypeByPointValue[75]='n0BO'set HeroIconPath[75]="ReplaceableTextures\\CommandButtons\\BTNVoidWalker.blp"call RegisterUnitTypeAnimation(RestrictedTechId[75],"spell")call RegisterUnitTypeScale(RestrictedTechId[75],1.5,ScaledUnitType[75])call RegisterUnitTypeColor(RestrictedTechId[75],150,0,150)set HeroTipLine1[heroIndex]="High costs and cooldowns give Atropos limited ability use: Cast spells intelligently and get items like Null Talismans and/or Magic Stick for your mana pool."set HeroTipLine2[heroIndex]="Brain Sap is a powerful nuke and heal and deals exact unreduced damage so get it early and always try to use it on enemy heroes when using the spell."set HeroTipLine3[heroIndex]="Use Nightmare to help teammates to aim their spells and remove an opponent from battles temporarily while you fight their allies."set HeroTipLine4[heroIndex]="Enfeeble is usually a skill to get after Brain Sap and Nightmare to use on enemy heroes with high damage to reduce their damage capabilities severely."set HeroTipLine5[heroIndex]="Fiend's Grip will work on Magic Immune units such as those under the active effect of Black King Bar, holding them in place but dealing no damage."set heroIndex=heroIndex+1set RestrictedTechId[76]='U00E'set ScaledUnitType[76]='h05Z'set HeroTypeByPointValue[76]='n0B8'set HeroIconPath[76]="ReplaceableTextures\\CommandButtons\\BTNGhostOfKelThuzad.blp"call RegisterUnitTypeAnimation(RestrictedTechId[76],"stand victory")call RegisterUnitTypeScale(RestrictedTechId[76],1.3,ScaledUnitType[76])set HeroTipLine1[heroIndex]="Death Pulse lets you kill creeps and harass heroes simultaneously, great for pushing and healing allied units because of its low cooldown."set HeroTipLine2[heroIndex]="Sadist will provide you with some early regeneration for killing creeps, while Heartstopper Aura becomes effective as the game goes on."set HeroTipLine3[heroIndex]="Reaper's Scythe is known for its ability to kill heroes outright, allowing you to bring down even high-HP Strength heroes with ease."set HeroTipLine4[heroIndex]="Your ultimate can also be used to stun opponents in certain situations, such as interrupting channeling spells and teleports."set HeroTipLine5[heroIndex]="Items like Bloodstone or Heart of Tarrasque allow you to survive long enough in team battles to make your spells more effective."set heroIndex=heroIndex+1set RestrictedTechId[77]='U00F'set ScaledUnitType[77]='h060'set HeroTypeByPointValue[77]='n0C5'set HeroIconPath[77]="ReplaceableTextures\\CommandButtons\\BTNAbomination.blp"call RegisterUnitTypeAnimation(RestrictedTechId[77],"stand 3")call RegisterUnitTypeScale(RestrictedTechId[77],1.,ScaledUnitType[77])set HeroTipLine1[heroIndex]="Pudge is known for his ability to isolate enemies with Meat Hook and using Rot and Dismember afterward, killing them outright. "set HeroTipLine2[heroIndex]="Early regeneration and movement speed items such as Bottle and Phase Boots help provide Pudge with the means to cast spells and chase his opponents."set HeroTipLine3[heroIndex]="Use Meat Hook from a location where you are not obstructed by any allied or enemy units other than your target to ensure a better chance of landing it."set HeroTipLine4[heroIndex]="A Hood of Defiance will improve your magic resistance to reduce damage from using Rot and getting hit by spells; The massive regeneration is also good."set HeroTipLine5[heroIndex]="Use your spells defensively: Rot can be used to commit suicide if necessary and Meat Hook can be used to rescue an ally from one or more enemies."set heroIndex=heroIndex+1set RestrictedTechId[78]='O00J'set ScaledUnitType[78]='h061'set HeroTypeByPointValue[78]='n0C3'set HeroIconPath[78]="ReplaceableTextures\\CommandButtons\\BTNSpiritWalker.blp"call RegisterUnitTypeAnimation(RestrictedTechId[78],"stand ready")call RegisterUnitTypeScale(RestrictedTechId[78],1.2,ScaledUnitType[78])set HeroTipLine1[heroIndex]="Empowering Haste is a smart skill to level first, it gives Barathrum movement speed and significant damage for killing creeps and heroes."set HeroTipLine2[heroIndex]="A level of Greater Bash early game can be useful as an extra disable, since the 17% chance is the same for all levels."set HeroTipLine3[heroIndex]="Get Strength Power Treads because the attack and movement speed benefits your other skills and the boost in HP helps you survive."set HeroTipLine4[heroIndex]="Charge of Darkness gives Barathrum spell immunity after 12 seconds and provides vision of the target for you and your allies."set HeroTipLine5[heroIndex]="Nether Strike puts you on the opposite side of where you were facing, pushing opponents backwards and into your allies."set heroIndex=heroIndex+1set RestrictedTechId[79]='Ubal'set ScaledUnitType[79]='h062'set HeroTypeByPointValue[79]='n0BX'set HeroIconPath[79]="ReplaceableTextures\\CommandButtons\\BTNNerubianQueen.blp"call RegisterUnitTypeAnimation(RestrictedTechId[79],"attack")call RegisterUnitTypeScale(RestrictedTechId[79],1.,ScaledUnitType[79])call RegisterUnitTypeColor(RestrictedTechId[79],255,200,200)set HeroTipLine1[heroIndex]="Take care of Weaver's HP/damage problems with Bracers or Wraith Bands and get regeneration so he can use his spells freely."set HeroTipLine2[heroIndex]="An early level of Watchers can be used to provide vision over the rune powerups. Patrol them to increase their area of detection."set HeroTipLine3[heroIndex]="Shukuchi is used for harassing and chasing opponents offensively, and escaping and avoiding certain projectile spells defensively."set HeroTipLine4[heroIndex]="If your Geminate Attack is not working, make sure that you input an attack command ('A' or right-click) and are not simply auto-attacking."set HeroTipLine5[heroIndex]="Use Time Lapse after taking a lot of recent damage to heal yourself, allowing you to pull off some dangerous moves like diving into towers."set heroIndex=heroIndex+1set RestrictedTechId[80]='Nfir'set ScaledUnitType[80]='h063'set HeroTypeByPointValue[80]='n0BN'set HeroIconPath[80]="ReplaceableTextures\\CommandButtons\\BTNShade.blp"call RegisterUnitTypeAnimation(RestrictedTechId[80],"stand channel")call RegisterUnitTypeScale(RestrictedTechId[80],1.15,ScaledUnitType[80])call RegisterUnitTypeColor(RestrictedTechId[80],0,0,0)set HeroTipLine1[heroIndex]="Necromastery is important because of its massive damage gain and because your ultimate deals damage based on the number of souls."set HeroTipLine2[heroIndex]="Shadow Raze gives you three powerful nuke spells that should be maxed out first. Gauge the distance correctly and hit multiple times."set HeroTipLine3[heroIndex]="Requiem of Souls deals more damage the closer you are: Placement items like Lothar's Edge and Kelen's Dagger can help you land it."set HeroTipLine4[heroIndex]="After maxing your other two spells, Presence of the Dark Lord will be useful by then, good for pushing and dealing more physical damage."set HeroTipLine5[heroIndex]="If you die, remember to fill up on souls again before major fights when you respawn or you will be much less effective in battles."set heroIndex=heroIndex+1set RestrictedTechId[81]='U00K'set ScaledUnitType[81]='h064'set HeroTypeByPointValue[81]='n0C4'set HeroIconPath[81]="ReplaceableTextures\\CommandButtons\\BTNArachnathidGreen.blp"call RegisterUnitTypeAnimation(RestrictedTechId[81],"attack 3")call RegisterUnitTypeScale(RestrictedTechId[81],1,ScaledUnitType[81])set HeroTipLine1[heroIndex]="Burrowstrike is both versatile and powerful: It deals damage, stuns and provides you with a useful escape or chasing mechanism."set HeroTipLine2[heroIndex]="Using Sandstorm at the right time will dodge certain projectile spells and can protect you temporarily if it is necessary."set HeroTipLine3[heroIndex]="Getting Kelen's Dagger will give him increased mobility and reach, and also the ability to Blink into battle right after channeling Epicenter."set HeroTipLine4[heroIndex]="While you cannot move while Epicenter is channeling, once the pulses begin you can freely move around (mostly to chase your opponent)."set HeroTipLine5[heroIndex]="Caustic Finale might be an orb effect but it is extremely useful for killing multiple units quickly for fighting neutrals, pushing and defending."set heroIndex=heroIndex+1set RestrictedTechId[82]='Opgh'set ScaledUnitType[82]='h065'set HeroTypeByPointValue[82]='n0BM'set HeroIconPath[82]="ReplaceableTextures\\CommandButtons\\BTNChaosGrom.blp"call RegisterUnitTypeAnimation(RestrictedTechId[82],"stand victory")call RegisterUnitTypeScale(RestrictedTechId[82],1,ScaledUnitType[82])set HeroTipLine1[heroIndex]="Counter Helix gives Axe the flexibility to both lane and jungle. A Stout Shield will help reduce the damage from taking attacks in order to activate Helix."set HeroTipLine2[heroIndex]="A Vanguard or a Hood of Defiance offers survivability and regeneration, which are usually more useful to Axe than increasing his attack speed or damage."set HeroTipLine3[heroIndex]="Berserker's Call is used to initiate fights and draw focus fire. Using it when there are more enemy units increases the chance of activating Counter Helix."set HeroTipLine4[heroIndex]="Monitor your opponent's HP for the perfect Culling Blade opportunity to finish them off. However, if your enemy has too much HP, it will hardly do anything."set HeroTipLine5[heroIndex]="Kelen's Dagger and/or Phase Boots can help you enter the fight first and get close enough for a Berserker's Call."set heroIndex=heroIndex+1set RestrictedTechId[83]='Hvsh'set ScaledUnitType[83]='h066'set HeroTypeByPointValue[83]='n0BZ'set HeroIconPath[83]="ReplaceableTextures\\CommandButtons\\BTNShaman.blp"call RegisterUnitTypeAnimation(RestrictedTechId[83],"stand victory")call RegisterUnitTypeScale(RestrictedTechId[83],1.25,ScaledUnitType[83])call RegisterUnitTypeColor(RestrictedTechId[83],250,150,150)set HeroTipLine1[heroIndex]="Getting Blood Bath will allow you to take a few hits as you are killing creeps because you will recover your health immediately afterwards."set HeroTipLine2[heroIndex]="An early level of Bloodrage can be useful for silencing enemies temporarily and for dealing a little bit of damage."set HeroTipLine3[heroIndex]="Phase Boots and HP can be just as useful as damage items because they increase his survivability for chasing enemies and other longer battles."set HeroTipLine4[heroIndex]="Use Rupture when your enemy has to run away, or to prevent them from moving, such as when an ally is about to use a powerful spell."set HeroTipLine5[heroIndex]="Both allies and enemies gain the massive damage increase and are silenced from Bloodrage, which can be disastrous if used incorrectly."set heroIndex=heroIndex+1set RestrictedTechId[84]='Udea'set ScaledUnitType[84]='h067'set HeroTypeByPointValue[84]='n0BL'set HeroIconPath[84]="ReplaceableTextures\\CommandButtons\\BTNHeroDeathKnight.blp"call RegisterUnitTypeAnimation(RestrictedTechId[84],"stand ready")call RegisterUnitTypeScale(RestrictedTechId[84],1,ScaledUnitType[84])set HeroTipLine1[heroIndex]="Abaddon's spells can save allies while dealing damage, so support and regeneration items like Vladmir's Offering can be more useful than damage items."set HeroTipLine2[heroIndex]="Death Coil can be used both as a nuke and a heal, just remember that it deals damage to you unless you are using Aphotic Shield or Borrowed Time."set HeroTipLine3[heroIndex]="Aphotic Shield prevents damage but can also be used to remove certain debuffs, such as removing the stun duration effect on an ally."set HeroTipLine4[heroIndex]="Frostmourne is usually gotten later but it is very useful for chasing and helping your allies outrun your opponents."set HeroTipLine5[heroIndex]="Borrowed Time can be cast manually as well. If you know you are going to receive a lot of damage sometimes it can be wiser to use it then."set heroIndex=heroIndex+1set RestrictedTechId[85]='E01B'set ScaledUnitType[85]='h068'set HeroTypeByPointValue[85]='n0B9'set HeroIconPath[85]="ReplaceableTextures\\CommandButtons\\BTNvengeanceincarnate.blp"call RegisterUnitTypeAnimation(RestrictedTechId[85],"stand ready")call RegisterUnitTypeScale(RestrictedTechId[85],.8,ScaledUnitType[85])set HeroTipLine1[heroIndex]="Spectral Dagger is your utility spell. You can use it for chasing people down, scouting dangerous areas and escaping. "set HeroTipLine2[heroIndex]="You also walk through units, trees, even cliffs while you are walking on Spectral Dagger's black path, making it very handy when used properly."set HeroTipLine3[heroIndex]="Desolate is great for dealing damage to isolated targets but Dispersion helps you to survive in the lane: Choose whatever combination suits you best."set HeroTipLine4[heroIndex]="Haunt lets you jump into a fight directly from anywhere in the map; just make sure that you pay attention to the actions of your team."set HeroTipLine5[heroIndex]="Getting HP will allow you to withstand and dish out more Dispersion damage, which is extremely powerful in team fights."set heroIndex=heroIndex+1set RestrictedTechId[86]='E01A'set ScaledUnitType[86]='h069'set HeroTypeByPointValue[86]='n0BK'set HeroIconPath[86]="ReplaceableTextures\\CommandButtons\\BTNWitchDoctor.blp"call RegisterUnitTypeAnimation(RestrictedTechId[86],"stand victory")call RegisterUnitTypeScale(RestrictedTechId[86],1.25,ScaledUnitType[86])set HeroTipLine1[heroIndex]="Paralyzing Cask is your initiating spell for your other skills and can effectively keep two nearby units stun-locked at higher levels."set HeroTipLine2[heroIndex]="Maledict drastically reduces the damage needed to kill opponents and is an important spell to land in every fight."set HeroTipLine3[heroIndex]="An early level of Voodoo Restoration can provide a relatively cheap heal if you are forced to play defensively."set HeroTipLine4[heroIndex]="Damaging your opponent immediately after using Maledict is wise because it will deal more bonus damage overall at the 3 ticks."set HeroTipLine5[heroIndex]="Death Ward is a powerful channeling spell if not interrupted. A Black King Bar will help to prevent enemies from disabling you."set heroIndex=heroIndex+1set RestrictedTechId[87]='U00P'set ScaledUnitType[87]='h06A'set HeroTypeByPointValue[87]='n0BA'set HeroIconPath[87]="ReplaceableTextures\\CommandButtons\\BTNDestroyer.blp"call RegisterUnitTypeAnimation(RestrictedTechId[87],"stand alternate 2")call RegisterUnitTypeScale(RestrictedTechId[87],.85,ScaledUnitType[87])set HeroTipLine1[heroIndex]="Getting Intelligence and mana items is extremely important for Harbringer as the power of Arcane Orb and Sanity's Eclipse rely on this."set HeroTipLine2[heroIndex]="Use Astral Imprisonment to control your opponents' mana, for escaping/chasing, or on yourself and allies to avoid spells."set HeroTipLine3[heroIndex]="Cast Arcane Orb manually early on because you will have a greater chance of activating Essence Aura to use it endlessly."set HeroTipLine4[heroIndex]="Guinsoo's Scythe of Vyse is a great choice because it offers Intelligence, balanced stats and provides Harbringer with a powerful disable."set HeroTipLine5[heroIndex]="Use Sanity's Eclipse early in fights so that you drain casters with high Intelligence of their mana and cripple their ability to cast spells."set heroIndex=heroIndex+1set RestrictedTechId[88]='E01C'set ScaledUnitType[88]='h06C'set HeroTypeByPointValue[88]='n0BB'set HeroIconPath[88]="ReplaceableTextures\\CommandButtons\\BTNGuldan.blp"call RegisterUnitTypeAnimation(RestrictedTechId[88],"spell")call RegisterUnitTypeScale(RestrictedTechId[88],1.5,ScaledUnitType[88])set HeroTipLine1[heroIndex]="Shadow Word is either a heal or damage over time, definitely the most powerful early game spell to have."set HeroTipLine2[heroIndex]="The affordable Mekansm is a good support item for Warlock, who is not a hero who is reliant on gold and items to be effective."set HeroTipLine3[heroIndex]="Rain of Chaos creates a powerful Infernal that can take on heroes and is also great for killing creeps and pushing buildings."set HeroTipLine4[heroIndex]="Fatal Bonds can deal huge damage if you and your teammates have other area of effect (AoE) spells that would hurt multiple linked units."set HeroTipLine5[heroIndex]="The stun when using Rain of Chaos along with its huge casting range (1200) is great for interrupting spells and initiating battles."set heroIndex=heroIndex+1set RestrictedTechId[89]='H00I'set ScaledUnitType[89]='h06D'set HeroTypeByPointValue[89]='n0BJ'set HeroIconPath[89]="ReplaceableTextures\\CommandButtons\\BTNKoboldGeomancer.blp"call RegisterUnitTypeAnimation(RestrictedTechId[89],"spell")call RegisterUnitTypeScale(RestrictedTechId[89],1.4,ScaledUnitType[89])call RegisterUnitTypeScale('H00J',1.4,ScaledUnitType[89])set HeroTipLine1[heroIndex]="Vladmir's Offering and/or Mekansm provides valuable auras and useful heals that can help support your team and keep your Meepos alive."set HeroTipLine2[heroIndex]="Poof is both a teleport and damage spell and is great against neutrals. Poof to yourself to deal double the damage (from departure and arrival)."set HeroTipLine3[heroIndex]="Geomancer is an advanced hero: Be sure to monitor their individual health because if one dies, they all will."set HeroTipLine4[heroIndex]="Strength Power Treads are suggested since clones will receive all of the Strength from footwear along with a 2.5 bonus (12.5 total)."set HeroTipLine5[heroIndex]="Time Earthbind with each of your clones. With 4 Meepos and Level 4 Earthbind, you can almost permanently immobilize them."set heroIndex=heroIndex+1set RestrictedTechId[90]='N01W'set ScaledUnitType[90]='h06E'set HeroTypeByPointValue[90]='n0BI'set HeroIconPath[90]="ReplaceableTextures\\CommandButtons\\BTNDarkTrollShadowPriest.blp"call RegisterUnitTypeAnimation(RestrictedTechId[90],"spell")call RegisterUnitTypeScale(RestrictedTechId[90],1.2,ScaledUnitType[90])set HeroTipLine1[heroIndex]="An early level of both Shadow Wave and Shallow Grave provides a lot of support before getting Poison Touch to level 3 for its added stun."set HeroTipLine2[heroIndex]="Try to use Shadow Wave to heal and damage opponents at the same time. Surround an enemy with multiple allied units for more damage."set HeroTipLine3[heroIndex]="In addition to slowing and damaging opponents, Poison Touch will allow you to interrupt channeling spells and teleports"set HeroTipLine4[heroIndex]="Dazzle generally does not need many items and can sometimes focus on increasing his spell use with regeneration and support items like Mekansm."set HeroTipLine5[heroIndex]="Weave is a powerful spell, try to hit both allies and enemies with it, and it can also be used to provide vision before major battles occur."set heroIndex=heroIndex+1set RestrictedTechId[91]='N00R'set ScaledUnitType[91]='h06F'set HeroTypeByPointValue[91]='n0BC'set HeroIconPath[91]="ReplaceableTextures\\CommandButtons\\BTNPitLord.blp"call RegisterUnitTypeAnimation(RestrictedTechId[91],"stand channel")call RegisterUnitTypeScale(RestrictedTechId[91],.95,ScaledUnitType[91])set HeroTipLine1[heroIndex]="Firestorm will be your main ability for killing creeps but it can deal a lot of damage to heroes if you combine it with disables or slows."set HeroTipLine2[heroIndex]="The Pit of Malice is a useful disable that lasts for 10 seconds so it will both ensnare opponents and deter opponents from entering the circle."set HeroTipLine3[heroIndex]="Expulsion is usually used after some creeps have died so the spell lasts longer and will deal damage and mini-stun enemies."set HeroTipLine4[heroIndex]="Pit Lord is played more as a caster, increase his team presence and spell use by obtaining expensive Intelligence items like Shiva's Guard."set HeroTipLine5[heroIndex]="Dark Rift is a great spell for transporting multiple allies to surprise opponents, and more importantly to defend and attack the base."set heroIndex=heroIndex+1set RestrictedTechId[92]='H00R'set ScaledUnitType[92]='h06G'set HeroTypeByPointValue[92]='n0BH'set HeroIconPath[92]="ReplaceableTextures\\CommandButtons\\BTNZombie.blp"call RegisterUnitTypeAnimation(RestrictedTechId[92],"stand")call RegisterUnitTypeScale(RestrictedTechId[92],2,ScaledUnitType[92])call RegisterUnitTypeScale('H07I',1.3,ScaledUnitType[92])set HeroTipLine1[heroIndex]="Decay is used to deal damage and make opponents more vulnerable, while increasing the survivability of Dirge temporarily."set HeroTipLine2[heroIndex]="Make sure Dirge is a presence who can cast his spells in fights by buying regeneration items like Vladmir's Offering and Void Stone."set HeroTipLine3[heroIndex]="Soul Rip is a powerful heal or nuke but remember that it will have almost no effect without nearby units. Cast it in crowds."set HeroTipLine4[heroIndex]="Use Tombstone when engaging the enemy because the zombies have a slowing capability and may also help block your opponents."set HeroTipLine5[heroIndex]="Tombstone Zombies become extremely powerful when your opponents have low health and attack and move much faster."set heroIndex=heroIndex+1set RestrictedTechId[93]='H00N'set ScaledUnitType[93]='h06H'set HeroTypeByPointValue[93]='n0BG'set HeroIconPath[93]="ReplaceableTextures\\CommandButtons\\BTNDranaiMage.blp"call RegisterUnitTypeAnimation(RestrictedTechId[93],"spell")call RegisterUnitTypeScale(RestrictedTechId[93],1.15,ScaledUnitType[93])set HeroTipLine1[heroIndex]="Ion shell is great for killing creeps and dealing damage to heroes, but it will not damage an enemy target if you cast it on them directly."set HeroTipLine2[heroIndex]="A level of Surge early game can help you and allies escape and chase enemies, and works nicely to help you close in on opponents with Ion Shell."set HeroTipLine3[heroIndex]="Vacuum is an extremely powerful skill that can be used for initiating and combining with other spells. It can also interrupt channeling and teleport spells."set HeroTipLine4[heroIndex]="Make sure they are standing closer to the edge of your targeting circle when casting Vacuum to pull your opponents further."set HeroTipLine5[heroIndex]="Use Wall of Replica where multiple heroes will touch it; try using it with Vacuum. Get your allies to run through the wall too."set heroIndex=heroIndex+1set RestrictedTechId[94]='H00U'set ScaledUnitType[94]='h06B'set HeroTypeByPointValue[94]='n0BF'set HeroIconPath[94]="ReplaceableTextures\\CommandButtons\\BTNHeroBloodElfPrince.blp"call RegisterUnitTypeAnimation(RestrictedTechId[94],"spell")call RegisterUnitTypeScale(RestrictedTechId[94],1.25,ScaledUnitType[94])set HeroTipLine1[heroIndex]="Having at least one level in Quas, Wex and Exort will give you a larger repertoire of spells. Type -invokelist to obtain a full list of combinations."set HeroTipLine2[heroIndex]="Ghost Walk (QQW) can be used to get yourself out of a tight situation, and also for slowing opponents so that your allies can chase/escape."set HeroTipLine3[heroIndex]="Sunstrike (EEE) is a global-ranged nuke that deals damage based on the level of Exort. When using it, you have to factor in the 1.7 casting time."set HeroTipLine4[heroIndex]="Forge Spirit (EEQ) and Cold Snap (QQQ) can be effective for pushing towers and against heroes with low armor. "set HeroTipLine5[heroIndex]="EMP (WWW) and Tornado (WWQ) can completely drain off heroes with low mana pools and have an impressive casting range."set heroIndex=heroIndex+1set RestrictedTechId[95]='Uktl'set ScaledUnitType[95]='h04D'set HeroTypeByPointValue[95]='n0A6'set HeroIconPath[95]="ReplaceableTextures\\CommandButtons\\BTNSpell_Shadow_SummonVoidWalker.blp"call RegisterUnitTypeAnimation(RestrictedTechId[95],"stand")call RegisterUnitTypeScale(RestrictedTechId[95],1.5,ScaledUnitType[95])set HeroTipLine1[heroIndex]="Conversion allows Enigma to farm neutral creeps effectively. Target the highest level creep possible and move your low HP Eidolons out of the way to save them."set HeroTipLine2[heroIndex]="In the lane, Conversion can be used on allied creeps to deny your opponents experience and gold, and for making sure you last hit enemy creeps."set HeroTipLine3[heroIndex]="The multiple stuns on higher levels of Malefice make it useful for preventing an opponent from channeling spells or helping you chase/escape them."set HeroTipLine4[heroIndex]="Use Midnight Pulse in conjunction with Black Hole to deal massive damage to enemies. Just make sure that you cast it before Black Hole."set HeroTipLine5[heroIndex]="Kelen's Dagger is great for Black Hole placement, and a Black King Bar will prevent most spells from stopping the channeling effect of the spell."set heroIndex=heroIndex+1set RestrictedTechId[96]='O016'set ScaledUnitType[96]='h07R'set HeroTypeByPointValue[96]='n0G9'set HeroIconPath[96]="ReplaceableTextures\\CommandButtons\\BTNTrollBatRider.blp"call RegisterUnitTypeAnimation(RestrictedTechId[96],"stand")call RegisterUnitTypeScale(RestrictedTechId[96],1.2,ScaledUnitType[96])call RegisterUnitTypeScale('O017',1.2,ScaledUnitType[96])set HeroTipLine1[heroIndex]=""set HeroTipLine2[heroIndex]=""set HeroTipLine3[heroIndex]=""set HeroTipLine4[heroIndex]=""set HeroTipLine5[heroIndex]=""set heroIndex=heroIndex+1set RestrictedTechId[97]='N0HP'set ScaledUnitType[97]='h0B0'set HeroTypeByPointValue[97]='n0HR'set HeroIconPath[97]="ReplaceableTextures\\CommandButtons\\BTNIcyGhost.blp"call RegisterUnitTypeAnimation(RestrictedTechId[97],"stand")call RegisterUnitTypeScale(RestrictedTechId[97],1.17,ScaledUnitType[97])call RegisterUnitTypeScale('N0HP',1.2,ScaledUnitType[97])set HeroTipLine1[heroIndex]=""set HeroTipLine2[heroIndex]=""set HeroTipLine3[heroIndex]=""set HeroTipLine4[heroIndex]=""set HeroTipLine5[heroIndex]=""set heroIndex=heroIndex+1set RestrictedTechId[98]='H071'set ScaledUnitType[98]='h072'set HeroTypeByPointValue[98]='n0EF'set HeroIconPath[98]="ReplaceableTextures\\CommandButtons\\BTNMurgulShadowCaster.blp"call RegisterUnitTypeAnimation(RestrictedTechId[98],"stand 3")call RegisterUnitTypeScale(RestrictedTechId[98],1.25,ScaledUnitType[98])set HeroTipLine1[heroIndex]=""set HeroTipLine2[heroIndex]=""set HeroTipLine3[heroIndex]=""set HeroTipLine4[heroIndex]=""set HeroTipLine5[heroIndex]=""set heroIndex=heroIndex+1set RestrictedTechId[99]='Eevi'set ScaledUnitType[99]='h056'set HeroTypeByPointValue[99]='n0AV'set HeroIconPath[99]="ReplaceableTextures\\CommandButtons\\BTNEvilIllidan.blp"call RegisterUnitTypeAnimation(RestrictedTechId[99],"spell channel")call RegisterUnitTypeScale(RestrictedTechId[99],1,ScaledUnitType[99])call RegisterUnitTypeScale('Eevm',1,ScaledUnitType[99])call RegisterUnitTypeScale('E02V',1,ScaledUnitType[99])call RegisterUnitTypeScale('E02W',1,ScaledUnitType[99])call RegisterUnitTypeScale('E02U',1,ScaledUnitType[99])set HeroTipLine1[heroIndex]="Get Soul Steal if you need healing in the lane."set HeroTipLine2[heroIndex]="Purchase statistic-increasing items like Wraith Bands and later items like Sange and Yasha to benefit both Terrorblade and his images."set HeroTipLine3[heroIndex]="It might be difficult to escape due to the trail you leave behind when walking, you may have to use an image to act as a block or decoy."set HeroTipLine4[heroIndex]="Sunder can turn fights around when you have low health but be careful of disables and high damage spells when trying to swap."set HeroTipLine5[heroIndex]="Creating ranged images in Metamorphosis will allow you to deal damage safely in fights as well as push down buildings very quickly."set heroIndex=heroIndex+1set RestrictedTechId[100]='Ekee'set ScaledUnitType[100]='h059'set HeroTypeByPointValue[100]='n0AW'set HeroIconPath[100]="ReplaceableTextures\\CommandButtons\\BTNKeeperGhostBlue.blp"call RegisterUnitTypeAnimation(RestrictedTechId[100],"stand victory")call RegisterUnitTypeScale(RestrictedTechId[100],1,ScaledUnitType[100])set HeroTipLine1[heroIndex]="Split Earth is a very useful disable while Lightning Storm is taken because of its low cooldown. Both are powerful spells that hit multiple targets."set HeroTipLine2[heroIndex]="By using Lightning Storm to finish low-health creeps with nearby opponents, you can get gold and harass enemy heroes at the same time."set HeroTipLine3[heroIndex]="Diabolic Edict is one of the most powerful spells for destroying buildings. Eliminate the creeps first so that you only have one target."set HeroTipLine4[heroIndex]="Turn off Pulse Nova when you have finished using it because the spell will continue until you have exhausted your entire mana pool."set HeroTipLine5[heroIndex]="Items like Bloodstone or Aghanim's Scepter will allow Leshrac to use his spells more liberally and survive in the midst of battle."set heroIndex=heroIndex+1set RestrictedTechId['e']='E02H'set ScaledUnitType['e']='h0CB'set HeroTypeByPointValue['e']='n0KL'set HeroIconPath['e']="ReplaceableTextures\\CommandButtons\\BTNArchimonde.blp"call RegisterUnitTypeAnimation(RestrictedTechId['e'],"stand 3")call RegisterUnitTypeScale(RestrictedTechId['e'],1.25,ScaledUnitType['e'])set HeroTipLine1[heroIndex]=""set HeroTipLine2[heroIndex]=""set HeroTipLine3[heroIndex]=""set HeroTipLine4[heroIndex]=""set HeroTipLine5[heroIndex]=""set heroIndex=heroIndex+1set RestrictedTechId['f']='Ulic'set ScaledUnitType['f']='h05A'set HeroTypeByPointValue['f']='n0AX'set HeroIconPath['f']="ReplaceableTextures\\CommandButtons\\BTNLichVersion2.blp"call RegisterUnitTypeAnimation(RestrictedTechId['f'],"stand channel")call RegisterUnitTypeScale(RestrictedTechId['f'],1.3,ScaledUnitType[51])set HeroTipLine1[heroIndex]="Dark Ritual is useful for denying allied creeps and provides you with mana to use spells without buying regeneration items."set HeroTipLine2[heroIndex]="Frost Nova is a very powerful spell that allows you to be aggressive. Attack the enemy a few extra times while they are slowed."set HeroTipLine3[heroIndex]="Chain Frost is most effective when used against 2-3 nearby targets (ideally heroes), but will not bounce when used on a lone unit."set HeroTipLine4[heroIndex]="Frost Armor should be cast on multiple teammates when you have the mana for it later on; it works nicely against melee units."set HeroTipLine5[heroIndex]="The first target of your Chain Frost can interrupt channeling and teleport spells if absolutely necessary."set heroIndex=heroIndex+1set RestrictedTechId['g']='UC76'set ScaledUnitType['g']='h05B'set HeroTypeByPointValue['g']='n0AY'set HeroIconPath['g']="ReplaceableTextures\\CommandButtons\\BTNBanshee.blp"call RegisterUnitTypeAnimation(RestrictedTechId['g'],"spell wail")call RegisterUnitTypeScale(RestrictedTechId['g'],1.35,ScaledUnitType['g'])set HeroTipLine1[heroIndex]="Carrion Swarm is your primary nuke and first skill to max. Make use of its range by casting it on the ground instead of on a unit directly."set HeroTipLine2[heroIndex]="An early level of Silence can help prevent you and your allies from being attacked by multiple spells."set HeroTipLine3[heroIndex]="The ghosts of Exorcism will attack whatever you attack, so if you want to direct all attention to a single unit simply focus them and stay nearby."set HeroTipLine4[heroIndex]="Exorcism also makes Krobelus extremely effective for quickly destroying enemy buildings, so be sure to push the enemy base when you can"set HeroTipLine5[heroIndex]="The effect of Exorcism stops if you die in combat: Invest in items that improve your survivability, such as a Bloodstone or a Heart of Tarrasque."set heroIndex=heroIndex+1set RestrictedTechId['h']='UC18'set ScaledUnitType['h']='h05C'set HeroTypeByPointValue['h']='n0AZ'set HeroIconPath['h']="ReplaceableTextures\\CommandButtons\\BTNLion.BLP"call RegisterUnitTypeAnimation(RestrictedTechId['h'],"spell callstorm")call RegisterUnitTypeScale(RestrictedTechId['h'],1.3,ScaledUnitType['h'])call RegisterUnitTypeColor(RestrictedTechId['h'],50,100,255)set HeroTipLine1[heroIndex]="With plenty of damage and disables, Lion is quite a force to be reckoned with, given cheap utility items such as Bottle and Phase Boots."set HeroTipLine2[heroIndex]="Impale gives Lion the ability to disable multiple targets and deals decent damage, so it is definitely the most versatile of his three skills for the early game."set HeroTipLine3[heroIndex]="Mana Drain only works on units with mana: Using Mana Drain on enemy heroes will reduce their spell use while replenishing mana."set HeroTipLine4[heroIndex]="Avoid wasting Finger of Death on low-health enemy heroes when a few extra attacks or using another spell like Impale will deal enough damage."set HeroTipLine5[heroIndex]="Wait until the duration of your first disable wears off before using another one for maximum disable time when using Impale and Voodoo."set heroIndex=heroIndex+1set RestrictedTechId[105]='EC57'set ScaledUnitType[105]='h05D'set HeroTypeByPointValue[105]='n0B0'set HeroIconPath[105]="ReplaceableTextures\\CommandButtons\\BTNHydralisk.blp"call RegisterUnitTypeAnimation(RestrictedTechId[105],"attack")call RegisterUnitTypeScale(RestrictedTechId[105],1.,ScaledUnitType[105])call RegisterUnitTypeColor(RestrictedTechId[105],150,200,255)set HeroTipLine1[heroIndex]="Venomous Gale is a spell that hits multiple opponents and slows them, making it very useful for getting early kills."set HeroTipLine2[heroIndex]="At least one level of Poison Sting is recommended early game for its slow effect."set HeroTipLine3[heroIndex]="Bottle and Magic Stick will help deal with his low HP/mana, while Phase Boots are a cheap way to improve his chasing capabilities."set HeroTipLine4[heroIndex]="Wards are very useful for pushing a lane and killing neutral and enemy creeps, but you can also use them to provide vision."set HeroTipLine5[heroIndex]="Poison Nova deals a lot of damage but you have to combine it with other spells and attacks because it does not deal fatal damage (stops at 1 HP)."set heroIndex=heroIndex+1set RestrictedTechId['j']='UC11'set ScaledUnitType['j']='h05E'set HeroTypeByPointValue['j']='n0A2'set HeroIconPath['j']="ReplaceableTextures\\CommandButtons\\BTNBlueMagnataur.tga"call RegisterUnitTypeAnimation(RestrictedTechId['j'],"stand channel")call RegisterUnitTypeScale(RestrictedTechId['j'],1,ScaledUnitType['j'])call RegisterUnitTypeColor(RestrictedTechId['j'],150,150,100)set HeroTipLine1[heroIndex]="Bottle and Perseverance help with early regeneration, while purchasing Kelen's Dagger later will help you to land Reverse Polarity."set HeroTipLine2[heroIndex]="A few Attribute Bonus points can help you cast more spells. Save Mighty Swing for later levels when you have more damage."set HeroTipLine3[heroIndex]="By targeting the ground where you want to fire Shockwave, you can hit both creeps and opponents and make use of its long range."set HeroTipLine4[heroIndex]="Magnus should cast Empower on himself and other allies with high damage before initiating team battles with his ultimate."set HeroTipLine5[heroIndex]="The cleave of Battle Fury stacks directly with Mighty Swing, making it a good damage item especially if you already have a Perseverance."set heroIndex=heroIndex+1set RestrictedTechId['k']='UC60'set ScaledUnitType['k']='h05F'set HeroTypeByPointValue['k']='n0B1'set HeroIconPath['k']="ReplaceableTextures\\CommandButtons\\BTNSpiritWyvern.blp"call RegisterUnitTypeAnimation(RestrictedTechId['k'],"stand victory")call RegisterUnitTypeScale(RestrictedTechId['k'],1,ScaledUnitType['k'])call RegisterUnitTypeColor(RestrictedTechId['k'],150,150,150)set HeroTipLine1[heroIndex]=""set HeroTipLine2[heroIndex]=""set HeroTipLine3[heroIndex]=""set HeroTipLine4[heroIndex]=""set HeroTipLine5[heroIndex]=""set heroIndex=heroIndex+1set RestrictedTechId['l']='U00A'set ScaledUnitType['l']='h05G'set HeroTypeByPointValue['l']='n0B2'set HeroIconPath['l']="ReplaceableTextures\\CommandButtons\\BTNChaosWarlord.blp"call RegisterUnitTypeAnimation(RestrictedTechId['l'],"stand victory")call RegisterUnitTypeScale(RestrictedTechId['l'],1.05,ScaledUnitType['l'])set HeroTipLine1[heroIndex]="Chaos Bolt and Blink Strike are active abilities that are more useful in the lane and for killing opponents than Critical Strike."set HeroTipLine2[heroIndex]="Chaos Bolt is a disable that switches between average and extremely powerful, the sooner you max out this spell, the better."set HeroTipLine3[heroIndex]="His high natural movement speed (325 - the highest in the game) and Blink Strike make him very difficult for opponents to outrun or chase."set HeroTipLine4[heroIndex]="If you Blink Strike and then use Chaos Bolt, you can spend more time hitting opponents and less time waiting for his slow casting animation. "set HeroTipLine5[heroIndex]="Make Nessaj and Phantasm stronger by buying Strength items like Armlet of Mordiggan (when activated) and Heart of Tarrasque."set heroIndex=heroIndex+1set RestrictedTechId['m']='N0M7'set ScaledUnitType['m']='h0DW'set HeroTypeByPointValue['m']='n0M8'set HeroIconPath['m']="ReplaceableTextures\\CommandButtons\\BTNFrostWyrm.blp"call RegisterUnitTypeAnimation(RestrictedTechId['m'],"stand victory")call RegisterUnitTypeScale(RestrictedTechId['m'],.9,ScaledUnitType['m'])set HeroTipLine1[heroIndex]=""set HeroTipLine2[heroIndex]=""set HeroTipLine3[heroIndex]=""set HeroTipLine4[heroIndex]=""set HeroTipLine5[heroIndex]=""set heroIndex=heroIndex+1set RestrictedTechId['n']='N0MK'set ScaledUnitType['n']='h0EF'set HeroTypeByPointValue['n']='n0ML'set HeroIconPath['n']="ReplaceableTextures\\CommandButtons\\BTNGnollWarden.blp"call RegisterUnitTypeAnimation(RestrictedTechId['n'],"stand victory")call RegisterUnitTypeScale(RestrictedTechId['n'],1.1,ScaledUnitType['n'])set HeroTipLine1[heroIndex]=""set HeroTipLine2[heroIndex]=""set HeroTipLine3[heroIndex]=""set HeroTipLine4[heroIndex]=""set HeroTipLine5[heroIndex]=""set heroIndex=heroIndex+1set RestrictedTechId['o']='U008'set ScaledUnitType['o']='h05H'set HeroTypeByPointValue['o']='n0B3'set HeroIconPath['o']="ReplaceableTextures\\CommandButtons\\BTNKiljaedin.blp"call RegisterUnitTypeAnimation(RestrictedTechId['o'],"spell")call RegisterUnitTypeScale(RestrictedTechId['o'],1.2,ScaledUnitType['o'])call RegisterUnitTypeScale('E015',1,ScaledUnitType['o'])call RegisterUnitTypeColor(RestrictedTechId['o'],255,75,255)set HeroTipLine1[heroIndex]="If you want to farm neutral creeps, start with Summon Wolves and a Ring of Basilius, which can be used to make Vladmir's Offering later."set HeroTipLine2[heroIndex]="Spirit Wolves gain invisibility at level 4, making them difficult to kill and easy to harass heroes with in the lane."set HeroTipLine3[heroIndex]="Feral Heart makes you and your wolves stronger overall, while Howl is an offensive spell used before engaging the enemy."set HeroTipLine4[heroIndex]="Shapeshift makes you incredibly powerful and gives you max movement speed. Avoid being blocked by your wolves when chasing."set HeroTipLine5[heroIndex]="A Black King Bar will prevent enemies from disabling you, making you very fearsome and almost unstoppable when attacking heroes."set heroIndex=heroIndex+1set RestrictedTechId['p']='U006'set ScaledUnitType['p']='h05I'set HeroTypeByPointValue['p']='n0B4'set HeroIconPath['p']="ReplaceableTextures\\CommandButtons\\BTNSpiderBlack.blp"call RegisterUnitTypeAnimation(RestrictedTechId['p'],"walk")call RegisterUnitTypeScale(RestrictedTechId['p'],1.36,ScaledUnitType['p'])set HeroTipLine1[heroIndex]="At least one level in Spin Web early game will increase your survivability greatly. Remember that attacking/using spells will cause you to break invisibility."set HeroTipLine2[heroIndex]="Spawn Spiderlings is both a nuke and pushing spell, so getting items like a Ring of Basilius will provide you with both mana and armor for pushing."set HeroTipLine3[heroIndex]="Incapacitating Bite makes it very difficult for enemies to get away from you, great for chasing and slowing opponents temporarily for your allies."set HeroTipLine4[heroIndex]="Try to space out your webs with at least 2 seconds of walking distance so that you can benefit from its bonuses on as much ground as possible."set HeroTipLine5[heroIndex]="With the damage and lifesteal from Insatiable Hunger, sometimes it is best to get items that will prevent you from being disabled, such as a Black King Bar.