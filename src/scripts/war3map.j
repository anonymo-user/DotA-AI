x,2.5)call SetMultiboardItemWidthPercent(ScoreboardMultiboard,5,index,2.5)call SetMultiboardItemWidthPercent(ScoreboardMultiboard,6,index,2.5)call SetMultiboardItemWidthPercent(ScoreboardMultiboard,7,index,2.5)call SetMultiboardItemWidthPercent(ScoreboardMultiboard,8,index,.01)call SetMultiboardItemWidthPercent(ScoreboardMultiboard,9,index,.01)call SetMultiboardItemWidthPercent(ScoreboardMultiboard,10,index,.01)call SetMultiboardItemWidthPercent(ScoreboardMultiboard,11,index,.01)call SetMultiboardItemWidthPercent(ScoreboardMultiboard,12,index,.01)call SetMultiboardItemWidthPercent(ScoreboardMultiboard,13,index,.01)call SetMultiboardItemWidthPercent(ScoreboardMultiboard,14,index,.01)call SetMultiboardItemWidthPercent(ScoreboardMultiboard,15,index,.01)set index=index+1endloopset index=1set loopEnd=7+6+2loopexitwhen index>loopEndset slotIndex=1set columnIndex=3+TeamTwoPlayerCount_2+TeamOnePlayerCount_2loopexitwhen slotIndex>columnIndexcall SetMultiboardItemDisplayStyle(ScoreboardMultiboard,index,slotIndex,true,false)set slotIndex=slotIndex+1endloopset index=index+1endloopset index=1set loopEnd=TeamOnePlayerCount_2loopexitwhen index>loopEndcall SetMultiboardItemDisplayStyle(ScoreboardMultiboard,1,index+2,true,true)call SetMultiboardItemTextColor(ScoreboardMultiboard,7,index+2,255,204,0,0)set ScoreboardPlayerColumn[GetPlayerId(MultiboardTeamOnePlayer[index])]=1-1set ScoreboardPlayerRow[GetPlayerId(MultiboardTeamOnePlayer[index])]=index+2-1call SetMultiboardItemText(ScoreboardMultiboard,1,index+2,(PlayerName[GetPlayerId((MultiboardTeamOnePlayer[index]))]))if IsPlayerSlotActive(MultiboardTeamOnePlayer[index])thencall SetMultiboardItemTextColor(ScoreboardMultiboard,1,index+2,(ParseHexByte(SubString(PlayerColorCode[GetPlayerId((MultiboardTeamOnePlayer[index]))],4,6)))/ 255.*100,(ParseHexByte(SubString(PlayerColorCode[GetPlayerId((MultiboardTeamOnePlayer[index]))],6,8)))/ 255.*100,(ParseHexByte(SubString(PlayerColorCode[GetPlayerId((Multib