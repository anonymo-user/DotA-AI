unctionfunction SpawnDummyCastA2JNOnCaster takes nothing returns nothinglocal unit casterUnit=GetTriggerUnit()local integer abilLevel=GetUnitAbilityLevel(casterUnit,'A0H4')local unit dummyUnit=CreateUnit(GetOwningPlayer(casterUnit),'e00E',GetUnitX(casterUnit),GetUnitY(casterUnit),0)call UnitAddAbility(dummyUnit,'A2JN')call SetUnitAbilityLevel(dummyUnit,'A2JN',abilLevel)call IssueTargetOrderById(dummyUnit,852274,casterUnit)endfunctionfunction InitA0H4SpellHandler takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(t,Condition(function FilterCastA0H4))call TriggerAddAction(t,function SpawnDummyCastA2JNOnCaster)endfunctionfunction OnA04EAccumulatedDamageBreak takes nothing returns booleanlocal trigger triggerHandle=GetTriggeringTrigger()local integer handleId=GetHandleId(triggerHandle)local unit ownerUnit=(LoadUnitHandle(GameHashtable,(handleId),(2)))local unit damageSource=GetEventDamageSource()local real damageAmount=GetEventDamage()local real accumulatedDamage=(LoadReal(GameHashtable,(handleId),(412)))local real lastDamageTime=(LoadReal(GameHashtable,(handleId),(411)))local integer abilityLevel=GetUnitAbilityLevel(ownerUnit,'A04E')local real damageThreshold=650-50*abilityLevelif IsPlayerInHeroSlot(GetOwningPlayer(damageSource))thenif(lastDamageTime+ModeSelectDelaySeconds)<(GetElapsedGameTime())thenset accumulatedDamage=0endifset lastDamageTime=(GetElapsedGameTime())set accumulatedDamage=accumulatedDamage+damageAmountif accumulatedDamage>damageThreshold and GetUnitAbilityLevel(ownerUnit,'BNdo')==0 thenset accumulatedDamage=0call RemoveRegisteredAbilities(ownerUnit)call SetTieredAbilityLevel(ownerUnit,0,0)call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl",ownerUnit,"origin"))endifcall SaveReal(GameHashtable,(handleId),(412),((accumulatedDamage)*1.0))call SaveReal(GameHashtable,(handleId),(411),((lastDamageTime)*1.0))endifset triggerHandle=nullset ownerUnit=nullset damageSource=nullreturn falseendfunctionfunction RegisterA04EDamageBreakTracker takes unit trackedUnit,boolean isEnabled returns nothinglocal trigger damageTrigger=CreateTrigger()local integer triggerId=GetHandleId(damageTrigger)call TriggerRegisterUnitEvent(damageTrigger,trackedUnit,EVENT_UNIT_DAMAGED)call TriggerAddCondition(damageTrigger,Condition(function OnA04EAccumulatedDamageBreak))call SaveUnitHandle(GameHashtable,(triggerId),(2),(trackedUnit))call SaveReal(GameHashtable,(triggerId),(412),((0)*1.0))call SaveReal(GameHashtable,(triggerId),(411),(((TimerGetElapsed(GameClockTimer)))*1.0))set damageTrigger=nullendfunctionfunction OnLearnA04ERegisterTracker takes nothing returns booleanif GetLearnedSkill()=='A04E' and IsUnitIllusion(GetTriggerUnit())==false and GetUnitAbilityLevel(GetTriggerUnit(),'A04E')==1 thencall RegisterA04EDamageBreakTracker(GetTriggerUnit(),false)endifreturn falseendfunctionfunction InitA04ELearnHandler takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_HERO_SKILL)call TriggerAddCondition(t,Condition(function OnLearnA04ERegisterTracker))set t=nullendfunctionfunction FilterCastA046OnUnmarked takes nothing returns booleanreturn GetSpellAbilityId()=='A046' and HasAnyMarkedAbility(GetSpellTargetUnit())==falseendfunctionfunction OnCastA046ColdDamage takes nothing returns nothinglocal unit targetUnit=GetSpellTargetUnit()local real damageAmount=(60.+(50.*I2R(GetUnitAbilityLevelSwapped('A046',GetTriggerUnit()))))call UnitDamageTargetBJ(GetTriggerUnit(),targetUnit,damageAmount,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_COLD)call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl",targetUnit,"chest"))set targetUnit=nullendfunctionfunction InitA046SpellHandler takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayer