 OnA0HWCasterPathingItemTick takes nothing returns nothinglocal timer pathingTimer=GetExpiredTimer()local integer timerId=GetHandleId(pathingTimer)local unit casterUnit=(LoadUnitHandle(GameHashtable,(timerId),(14)))local real elapsed=(LoadReal(GameHashtable,(timerId),(57)))local integer slotIndex=0loopexitwhen slotIndex>5if IsSlotSpeedOrFlagItem(casterUnit,slotIndex)thenif GetUnitAbilityLevel(casterUnit,('B047'))==0 thencall SetItemDropOnDeath(UnitItemInSlot(casterUnit,slotIndex),true)if GetItemTypeId(UnitItemInSlot(casterUnit,slotIndex))=='oflg' thencall SetItemDroppable(UnitItemInSlot(casterUnit,slotIndex),true)endifelsecall SetItemDropOnDeath(UnitItemInSlot(casterUnit,slotIndex),false)if GetItemTypeId(UnitItemInSlot(casterUnit,slotIndex))=='oflg' thencall SetItemDroppable(UnitItemInSlot(casterUnit,slotIndex),false)endifendifendifset slotIndex=slotIndex+1endloopset elapsed=elapsed+0.2call SaveReal(GameHashtable,(timerId),(57),((elapsed)*1.0))if GetUnitAbilityLevel(casterUnit,('B047'))==0 thencall SetUnitPathing(casterUnit,true)elsecall SetUnitPathing(casterUnit,false)endifif elapsed>30 thencall PauseTimer(pathingTimer)call FlushChildHashtable(GameHashtable,(timerId))call SetUnitPathing(casterUnit,true)set slotIndex=0loopexitwhen slotIndex>5if IsSlotSpeedOrFlagItem(casterUnit,slotIndex)thencall SetItemDropOnDeath(UnitItemInSlot(casterUnit,slotIndex),true)if GetItemTypeId(UnitItemInSlot(casterUnit,slotIndex))=='oflg' thencall SetItemDroppable(UnitItemInSlot(casterUnit,slotIndex),true)endifendifset slotIndex=slotIndex+1endloopendifset casterUnit=nullendfunctionfunction IsSpellA0HW takes nothing returns booleanreturn GetSpellAbilityId()==('A0HW')endfunctionfunction CastA0HWSpectralDagger takes nothing returns nothinglocal unit casterUnit=GetTriggerUnit()local unit targetUnit=GetSpellTargetUnit()local real casterX=ClampXToPlayableArea(GetUnitX(casterUnit))local real casterY=ClampYToPlayableArea(GetUnitY(casterUnit)