lity(carrierUnit,'A2O3')endifif IsUnitDeadOrInvalid(hero)==true thencall UnitRemoveAbility(carrierUnit,'A2NY')call UnitRemoveAbility(carrierUnit,'A2O3')elseif GetUnitAbilityLevel(carrierUnit,'A2NY')==0 thencall AddPermanentAbility(carrierUnit,'A2NY')if stateFlag==1 thencall AddPermanentAbility(carrierUnit,'A2O3')elseendifendifcall SetUnitAbilityLevel(carrierUnit,'A2NY',halfBonus)call SetUnitAbilityLevel(carrierUnit,'A2O3',halfBonus)call SetUnitX(carrierUnit,GetUnitX(hero))call SetUnitY(carrierUnit,GetUnitY(hero))endifset hero=nullset periodicTrigger=nullreturn falseendfunctionfunction StartA2O2AttackCarrier takes nothing returns nothinglocal trigger attackTrigger=CreateTrigger()local integer triggerId=GetHandleId(attackTrigger)local unit casterUnit=GetTriggerUnit()local unit carrierUnit=CreateUnit(GetOwningPlayer(casterUnit),'e01V',0,0,0)call TriggerRegisterUnitEvent(attackTrigger,casterUnit,EVENT_UNIT_SPELL_EFFECT)call TriggerRegisterTimerEvent(attackTrigger,.1,true)call TriggerAddCondition(attackTrigger,Condition(function SyncA2O2AgilityAttackCarrier))call SaveUnitHandle(GameHashtable,(triggerId),(2),(casterUnit))call SaveUnitHandle(GameHashtable,(triggerId),(19),(carrierUnit))call SaveInteger(GameHashtable,(triggerId),(34),(2))call AddPermanentAbility(carrierUnit,'A2NY')set attackTrigger=nullset casterUnit=nullendfunctionfunction OnLearnA2O2StartCarrier takes nothing returns booleanif GetLearnedSkill()=='A2O2' and IsUnitIllusion(GetTriggerUnit())==false and GetUnitAbilityLevel(GetTriggerUnit(),'A2O2')==1 thencall StartA2O2AttackCarrier()endifreturn falseendfunctionfunction RegisterA2O2SkillTrigger takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_HERO_SKILL)call TriggerAddCondition(t,Condition(function OnLearnA2O2StartCarrier))call PreloadAbilityOnDummy('A2NY')call PreloadAbilityOnDummy('A2O3')set t=nullendfunctionfunction CastDrunkenHazeFromDummy ta