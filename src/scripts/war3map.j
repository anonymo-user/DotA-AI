alue[index]thenreturn indexendifset index=index+1endloopreturn-1endfunctionfunction AddSpellToLastCastIgnoreList takes integer id returns nothingset StoredIdArray[StoredIdCount]=idset StoredIdCount=StoredIdCount+1endfunctionfunction IsSpellInLastCastIgnoreList takes integer spellId returns booleanlocal integer index=0loopexitwhen index==StoredIdCountif spellId==StoredIdArray[index]thenreturn trueendifset index=index+1endloopreturn falseendfunctionfunction OnSpellRecordHeroLastCast takes nothing returns booleanlocal integer spellId=GetSpellAbilityId()if IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO) and IsSpellInLastCastIgnoreList(spellId)==false thencall SaveInteger(GameHashtable,(GetHandleId(GetTriggerUnit())),(705),(spellId))call SaveInteger(GameHashtable,(GetHandleId(GetTriggerUnit())),(712),(GetUnitAbilityLevel(GetTriggerUnit(),spellId)))endifreturn falseendfunctionfunction StripAllModifierAbilities takes unit u returns nothingif u==null or IsUnitDeadOrInvalid(u) thenreturnendifcall UnitRemoveAbility(u,'A13D')call UnitRemoveAbility(u,'A2NI')call UnitRemoveAbility(u,'A1QV')call UnitRemoveAbility(u,'A1TU')call UnitRemoveAbility(u,'A24A')call UnitRemoveAbility(u,'A24B')call UnitRemoveAbility(u,'A1NH')call UnitRemoveAbility(u,'A20N')call UnitRemoveAbility(u,'A1Z2')call UnitRemoveAbility(u,'A1Z3')call UnitRemoveAbility(u,'A205')call UnitRemoveAbility(u,'A1VU')call UnitRemoveAbility(u,'A0GC')call UnitRemoveAbility(u,'A24E')call UnitRemoveAbility(u,'A0RT')call UnitRemoveAbility(u,'A1RA')call UnitRemoveAbility(u,'A0HA')call UnitRemoveAbility(u,'A0SA')call UnitRemoveAbility(u,'A121')call UnitRemoveAbility(u,'A1WF')call UnitRemoveAbility(u,'A02T')call UnitRemoveAbility(u,'A1S9')call UnitRemoveAbility(u,'A21H')call UnitRemoveAbility(u,'A1MN')call UnitRemoveAbility(u,'A06K')call UnitRemoveAbility(u,'A0NE')call UnitRemoveAbility(u,'A0MP')call UnitRemoveAbility(u,'A2MB')endfunctionfunction OnStolenAbilityExpireTick takes nothing returns booleanlocal trigger triggeringTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(triggeringTrigger)local unit heroUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local integer stolenAbilityId=(LoadInteger(GameHashtable,(triggerId),(704)))local integer elapsedAtStart=(LoadInteger(GameHashtable,(triggerId),(713)))if stolenAbilityId==(LoadInteger(GameHashtable,(GetHandleId(heroUnit)),(704)))thencall FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(triggeringTrigger)elseif GetTriggerEvalCount(triggeringTrigger)>(15-elapsedAtStart)and IsUnitDeadOrInvalid(heroUnit)==false thencall UnitRemoveAbility(heroUnit,stolenAbilityId)call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(triggeringTrigger)endifset triggeringTrigger=nullset heroUnit=nullreturn falseendfunctionfunction StartStolenAbilityExpireWatch takes unit heroUnit,integer stolenAbilityId,real stealTime returns nothinglocal trigger tickTrigger=CreateTrigger()local integer triggerId=GetHandleId(tickTrigger)call TriggerRegisterTimerEvent(tickTrigger,1.,true)call TriggerAddCondition(tickTrigger,Condition(function OnStolenAbilityExpireTick))call SaveUnitHandle(GameHashtable,(triggerId),(2),(heroUnit))call SaveInteger(GameHashtable,(triggerId),(704),(stolenAbilityId))call SaveInteger(GameHashtable,(GetHandleId(heroUnit)),(704),(-1))call SaveInteger(GameHashtable,(triggerId),(713),(R2I((TimerGetElapsed(GameClockTimer))-stealTime)))set tickTrigger=nullendfunctionfunction OnStolenAbilityLostHandler takes nothing returns booleanlocal trigger watchTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(watchTrigger)local unit thiefUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local integer stolenAbilityId=(LoadInteger(GameHashtable,(triggerId),(704)))local integer warnState=(LoadInteger(GameHashtable,(triggerId),(34)))local integer abilityLevel=GetUnitAbilityLevel(thiefUnit,'A27H')local real castTime=(LoadReal(GameHashtable,(triggerId),(411)))if abilityLevel==0 thenset abilityLevel=GetUnitAbilityLevel(thiefUnit,'A2V9')endifif GetTriggerEventId()!=EVENT_UNIT_SPELL_EFFECT and GetTriggerEventId()!=EVENT_WIDGET_DEATH thenif warnState==0 thencall SaveInteger(GameHashtable,(triggerId),(34),(1))call DisplayTimedTextToPlayer(GetOwningPlayer(thiefUnit),0,0,10,"|c00ff0303"+GetObjectName('n0LW')+"|r")elsecall StripAllModifierAbilities(thiefUnit)call SetPlayerAbilityAvailable(GetOwningPlayer(thiefUnit),stolenAbilityId,false)call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(watchTrigger)call StartStolenAbilityExpireWatch(thiefUnit,stolenAbilityId,castTime)endifelseif GetTriggerEventId()==EVENT_UNIT_SPELL_EFFECT thenif GetSpellAbilityId()=='A27H' or GetSpellAbilityId()=='A2V9' thencall StripAllModifierAbilities(thiefUnit)call SetPlayerAbilityAvailable(GetOwningPlayer(thiefUnit),stolenAbilityId,false)call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(watchTrigger)call StartStolenAbilityExpireWatch(thiefUnit,stolenAbilityId,castTime)elseif GetSpellAbilityId()==stolenAbilityId thencall SaveReal(GameHashtable,(triggerId),(411),(((TimerGetElapsed(GameClockTimer)))*1.))endifelseif GetTriggerEventId()==EVENT_WIDGET_DEATH thencall StripAllModifierAbilities(thiefUnit)call SetPlayerAbilityAvailable(GetOwningPlayer(thiefUnit),stolenAbilityId,false)call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(watchTrigger)call StartStolenAbilityExpireWatch(thiefUnit,stolenAbilityId,castTime)endifset watchTrigger=nullset thiefUnit=nullreturn falseendfunctionfunction OnSpellStealProjectileImpact takes nothing returns nothinglocal trigger watchTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(watchTrigger)local unit thiefUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local unit targetUnit=(LoadUnitHandle(GameHashtable,(triggerId),(17)))local integer stolenAbilityId=(LoadInteger(GameHashtable,(triggerId),(704)))local integer abilityLevel=(LoadInteger(GameHashtable,(triggerId),(5)))local real stealDuration=60*(2+GetUnitAbilityLevel(thiefUnit,'A27H'))if GetUnitAbilityLevel(thiefUnit,'A27H')==0 thenset stealDuration=60*(2+GetUnitAbilityLevel(thiefUnit,'A2V9'))endifif(LoadInteger(GameHashtable,(GetHandleId(targetUnit)),(3000)))>0 thencall SaveInteger(GameHashtable,(GetHandleId(thiefUnit)),(3000),((LoadInteger(GameHashtable,(GetHandleId(targetUnit)),(3000)))))endifif(LoadInteger(GameHashtable,(GetHandleId(targetUnit)),(3001)))>0 thencall SaveInteger(GameHashtable,(GetHandleId(thiefUnit)),(3001),((LoadInteger(GameHashtable,(GetHandleId(targetUnit)),(3001)))))endifif(LoadInteger(GameHashtable,(GetHandleId(targetUnit)),(3002)))>0 thencall SaveInteger(GameHashtable,(GetHandleId(thiefUnit)),(3002),((LoadInteger(GameHashtable,(GetHandleId(targetUnit)),(3002)))))endifif(LoadInteger(GameHashtable,(GetHandleId(targetUnit)),(710)))>0 thencall SaveInteger(GameHashtable,(GetHandleId(thiefUnit)),(710),((LoadInteger(GameHashtable,(GetHandleId(targetUnit)),(710)))))endifcall PlaySoundAtPoint(SpellStealTargetSound,GetUnitX(thiefUnit),GetUnitY(thiefUnit))call CreateTimedTextTagOnUnit(GetObjectName(stolenAbilityId),3.5,thiefUnit,.024,170,0,255,216)call SaveInteger(GameHashtable,(GetHandleId(thiefUnit)),(704),(stolenAbilityId))call SetPlayerAbilityAvailable(GetOwningPlayer(thiefUnit),stolenAbilityId,true)call AddPermanentAbility(thiefUnit,stolenAbilityId)call SetUnitAbilityLevel(thiefUnit,stolenAbilityId,abilityLevel)set watchTrigger=CreateTrigger()set triggerId=GetHandleId(watchTrigger)call SaveUnitHandle(GameHashtable,(triggerId),(2),(thiefUnit))call SaveInteger(GameHashtable,(triggerId),(34),(0))call SaveInteger(GameHashtable,(triggerId),(704),(stolenAbilityId))call TriggerRegisterUnitEvent(watchTrigger,thiefUnit,EVENT_UNIT_SPELL_EFFECT)call TriggerRegisterTimerEvent(watchTrigger,stealDuration,