tOwningPlayer(triggerUnit))],4))call UnitAddItem(triggerUnit,UnitItemInSlot(PlayerReserveHero[GetPlayerId(GetOwningPlayer(triggerUnit))],5))call EnableTrigger(ToggleableTrigger)elsecall RefundAllItemsForGold(PlayerReserveHero[GetPlayerId(GetOwningPlayer(triggerUnit))])endifif IsPickSelectorUnit(PlayerReserveHero[GetPlayerId(GetOwningPlayer(triggerUnit))])thencall RemovePlayerReservedUnits(PlayerReserveHero[GetPlayerId(GetOwningPlayer(triggerUnit))])elsecall RemoveUnitAndFlushData(PlayerReserveHero[GetPlayerId(GetOwningPlayer(triggerUnit))])endifendifendifif owner!=SentinelPlayer[0]and owner!=ScourgePlayer[0]thenif GameModeFlagY_2 thenif TimerGetElapsed(GameClockTimer)>60 thencall DisplayPickAnnouncementToAll(owner,GetObjectName('n02E')+" "+GetUnitName(triggerUnit))elseif PlayerModeFlag[GetPlayerId(heroOwner)] thencall DisplayPickAnnouncementToAll(owner,FormatHeroPickAnnouncement(triggerUnit,heroOwner))elsecall SetPlayerState(heroOwner,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(heroOwner,PLAYER_STATE_RESOURCE_GOLD)+250)call DisplayPickAnnouncementToAll(owner,GetObjectName('n0D1')+" "+GetUnitName(triggerUnit)+" "+GetObjectName('n0D0')+" "+(PlayerName[GetPlayerId((heroOwner))]))endifelseif GameOverFlag==false or owner==FirstPlayingUser thenif(IsPlayerControlAllowed[GetPlayerId(GetOwningPlayer(triggerUnit))] and GameOverFlag==false)thencall DisplayPickAnnouncementToAll(owner,GetObjectName('n0D5')+" "+GetUnitName(triggerUnit)+".")elseif((PlayerModeFlag[GetPlayerId(owner)] and AiSuppressModeFlag==false)or GameModeFlagV or GameModeFlagW or GameModeFlagO9 or AiRelatedGameModeFlag)thencall DisplayPickAnnouncementToAll(owner,GetObjectName('n0D3')+" "+GetUnitName(triggerUnit))elsecall DisplayPickAnnouncementToAll(owner,GetObjectName('n0D2')+" "+GetUnitName(triggerUnit))endifendifendifif IsGameOptionEnabled thenif GameModeFlagY_2 thencall RemovePlayerUnitsOfTypeN00C(heroOwner)elsecall RemovePlayerUnitsOfTypeN00C(owner)endifendifif(GameModeFlagOL or GameModeFlagO1)and IsGameOptionEnabled thencall RemovePlayerUnitsOfTypeN00C(owner)endifcall RefreshPlayerCourierAbilities(owner)if(GetUnitTypeId(triggerUnit)=='E005')thencall DisplayTimedTextToPlayer(owner,0,MessageDisplayY,60.," ")call DisplayTimedTextToPlayer(owner,0,MessageDisplayY,60.,"|c00ff0303"+(GetObjectName(('n06H')))+" "+(GetObjectName(('n0CB')))+". "+(GetObjectName(('n06E')))+"|r")elseif GetUnitTypeId(triggerUnit)=='O00J' or GetUnitTypeId(triggerUnit)=='N016' or GetUnitTypeId(triggerUnit)=='UC91' or GetUnitTypeId(triggerUnit)=='EC45' thencall DisplayTimedTextToPlayer(owner,0,MessageDisplayY,10.," ")call DisplayTimedTextToPlayer(owner,0,MessageDisplayY,10.,"|c00ff0303"+(GetObjectName(('n0G3')))+"|r")endifif(GetUnitTypeId(triggerUnit)=='E01B')thencall DisplayTimedTextToPlayer(owner,0,MessageDisplayY,30.," ")call DisplayTimedTextToPlayer(owner,0,MessageDisplayY,30.,"|c00ff0303"+(GetObjectName(('n06P')))+" "+(GetObjectName(('n06U')))+"|r")endifif(PlayerModeFlag[GetPlayerId(owner)]==false)thenif(GameModeFlagF9)thencall SetPlayerState(owner,PLAYER_STATE_RESOURCE_GOLD,175+GetPlayerState(owner,PLAYER_STATE_RESOURCE_GOLD))endifendifif HaveSavedBoolean(GameHashtable,600+GetUnitPointValue(triggerUnit),87)==false thencall SaveBoolean(GameHashtable,(600+GetUnitPointValue(triggerUnit)),(87),(true))call RegisterHeroSkillsByPointValue(triggerUnit)endifset FilterReferenceUnit_2=triggerUnitcall ExecuteFunc("InitH00UHiddenAbilities")if PlayerToggleIb[GetPlayerId(GetLocalPlayer())]==false thenif IsPlayerPlayingComputer(owner)thencall SetPlayerName(owner,PlayerName[GetPlayerId((owner))])elsecall SetPlayerName(owner,FormatNameWithHero(GetPlayerId(owner),TrackedSideUnit[GetPlayerId(owner)]))endifendifcall DisplayTimedTextToPlayer(messagePlayer,0,0,10.,message)set messagePlayer=nullcall RemoveRegion(createdRegion)set triggerUnit=nullset heldItem=nullendfunctionfunction IsSoldUnitHero takes nothing returns booleanreturn(IsUnitType(GetSoldUnit(),UNIT_TYPE_HERO)!=null)endfunctionfunction RestrictTechOnHeroSold takes nothing returns nothingif((AiControlToggleTrigger!=null)and(IsTriggerEnabled(AiControlToggleTrigger)))thenif((GetOwningPlayer(GetSoldUnit())==PendingSwapPlayerA)and(PendingSwapPartnerA!=null))thenreturnelseif((GetOwningPlayer(GetSoldUnit())==PendingSwapPlayerB)and(PendingSwapPartnerB!=null))thenreturnendifendifcall ForbidTechRangeForPlayer(GetOwningPlayer(GetSoldUnit()))endfunctionfunction GrantPeriodicGoldIncome takes nothing returns booleanlocal integer goldAmountlocal integer playerIndex=1loopexitwhen playerIndex>11if playerIndex==6 thenset playerIndex=7endifset goldAmount=0if(IsPlayerInForce(Player(playerIndex),RegisteredHeroPlayersForce))thenset FractionalAggressionAccumulator[playerIndex]=FractionalAggressionAccumulator[playerIndex]+(I2R(AiAggressionLevel[48+playerIndex])/8)set goldAmount=R2I(FractionalAggressionAccumulator[playerIndex])if goldAmount<0 thenset goldAmount=0endifset FractionalAggressionAccumulator[playerIndex]=FractionalAggressionAccumulator[playerIndex]-I2R(goldAmount)endifif(InitGuardF7)thenset goldAmount=goldAmount+2elseset goldAmount=goldAmount+1endifcall SetPlayerState(Player(playerIndex),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(playerIndex),PLAYER_STATE_RESOURCE_GOLD)+goldAmount)set playerIndex=playerIndex+1endloopreturn falseendfunctionfunction OnSpellStartCooldownTimer takes nothing returns booleanif IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO) and(LoadInteger(AbilityCooldownTable,(GetSpellAbilityId()),(GetUnitAbilityLevel(GetTriggerUnit(),GetSpellAbilityId()))))>0 thencall TimerStart(PlayerAbilityCooldownTimer[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))],(LoadInteger(AbilityCooldownTable,(GetSpellAbilityId()),(GetUnitAbilityLevel(GetTriggerUnit(),GetSpellAbilityId())))),false,null)endifif GetSpellAbilityId()=='A02W' thencall TimerStart(PlayerAbilityCooldownTimer[GetPlayerId((GetOwningPlayer(GetTriggerUnit())))],0,false,null)endifreturn falseendfunctionfunction InitSpellCooldownData takes nothing returns nothinglocal trigger spellTrigger=CreateTrigger()local integer timerIndexcall RegisterPlayerUnitEventAllPlayers(spellTrigger,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(spellTrigger,Condition(function OnSpellStartCooldownTimer))set timerIndex=0loopexitwhen(timerIndex>13)set PlayerAbilityCooldownTimer[timerIndex]=CreateTimer()set timerIndex=timerIndex+1endloopset AbilityCooldownTable=InitHashtable()call SaveInteger(AbilityCooldownTable,('A11K'),(1),(60))call SaveInteger(AbilityCooldownTable,('A11K'),(2),(50))call SaveInteger(AbilityCooldownTable,('A11K'),(3),(40))call SaveInteger(AbilityCooldownTable,('A0O2'),(1),(80))call SaveInteger(AbilityCooldownTable,('A0O2'),(2),(75))call SaveInteger(AbilityCooldownTable,('A0O2'),(3),(70))call SaveInteger(AbilityCooldownTable,('A289'),(1),(45))call SaveInteger(AbilityCooldownTable,('A289'),(2),(45))call SaveInteger(AbilityCooldownTable,('A289'),(3),(45))call SaveInteger(AbilityCooldownTable,('A0DH'),(1),(150))call SaveInteger(AbilityCooldownTable,('A0DH'),(2),(130))call SaveInteger(AbilityCooldownTable,('A0DH'),(3),(110))call SaveInteger(AbilityCooldownTable,('A1OB'),(1),(150))call SaveInteger(AbilityCooldownTable,('A1OB'),(2),(130))call SaveInteger(AbilityCooldownTable,('A1OB'),(3),(110))call SaveInteger(AbilityCooldownTable,('A0ER'),(1),(150))call SaveInteger(AbilityCooldownTable,('A0ER'),(2),(150))call SaveInteger(AbilityCooldownTable,('A0ER'),(3),(150))call SaveInteger(AbilityCooldownTable,('A2S8'),(1),(150))call SaveInteger(AbilityCooldownTable,('A2S8'),(2),(150))call SaveInteger(AbilityCooldownTable,('A2S8'),(3),(150))call SaveInteger(AbilityCooldownTable,('A0MQ'),(1),(140))call SaveInteger(AbilityCooldownTable,('A0MQ'),(2),(120))call SaveInteger(AbilityCooldownTable,('A0MQ'),(3),(100))call SaveInteger(AbilityCooldownTable,('A1B6'),(1),(140))call SaveInteger(Abilit