oleanlocal trigger tickTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(tickTrigger)local unit casterUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local unit projectileUnit=(LoadUnitHandle(GameHashtable,(triggerId),(19)))local integer abilityLevel=(LoadInteger(GameHashtable,(triggerId),(5)))local integer targetSlot=(LoadInteger(GameHashtable,(triggerId),(30)))local unit targetUnit=UnitByIndex(targetSlot)local group bouncedGroup=(LoadGroupHandle(GameHashtable,(triggerId),(187)))local real manaRestored=(LoadReal(GameHashtable,(triggerId),(222)))local real manaBurnStacks=(LoadReal(GameHashtable,(triggerId),(223)))local real bounceCount=(LoadReal(GameHashtable,(triggerId),(224)))local real manaBurnedlocal group tempGrouplocal real anglelocal real nextXlocal real nextYlocal integer cooldownAbilityLevel=GetUnitAbilityLevel(casterUnit,'A1AT')set angle=Atan2(GetUnitY(targetUnit)-GetUnitY(projectileUnit),GetUnitX(targetUnit)-GetUnitX(projectileUnit))if casterUnit==targetUnit thenset nextX=GetUnitX(projectileUnit)+24*Cos(angle)set nextY=GetUnitY(projectileUnit)+24*Sin(angle)elseset nextX=GetUnitX(projectileUnit)+24*Cos(angle)set nextY=GetUnitY(projectileUnit)+24*Sin(angle)endifcall SetUnitX(projectileUnit,nextX)call SetUnitY(projectileUnit,nextY)if DistanceBetweenCoords(nextX,nextY,GetUnitX(targetUnit),GetUnitY(targetUnit))<60 thencall SetUnitX(projectileUnit,GetUnitX(targetUnit))call SetUnitY(projectileUnit,GetUnitY(targetUnit))if casterUnit==targetUnit thencall SetUnitState(casterUnit,UNIT_STATE_MANA,GetUnitState(casterUnit,UNIT_STATE_MANA)+manaRestored)call KillUnit(projectileUnit)call ReleaseGroupToPool(bouncedGroup)call FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(tickTrigger)elseif UnitHasAnyStealthAbility(targetUnit)==false or IsUnitVisible(targetUnit,GetOwningPlayer(projectileUnit)) thenif(GetUnitAbilityLevel(targetUnit,'A2TL')>0)thencall DamageTargetByType(casterUnit,targetUnit,3,((40+40*abilityLevel)+0.25*bounceCount*(40+40*abilityLevel))/(1.2+.1*cooldownAbilityLevel))elsecall DamageTargetByType(casterUnit,targetUnit,DamageType1,(40+40*abilityLevel)+.25*bounceCount*(40+40*abilityLevel))endifset bounceCount=bounceCount+1if GetUnitState(targetUnit,UNIT_STATE_MANA)>0 thenset manaBurned=RMinBJ(GetUnitState(targetUnit,UNIT_STATE_MANA),(5+15*abilityLevel)+.25*manaBurnStacks*(10+10*abilityLevel))call SetUnitState(targetUnit,UNIT_STATE_MANA,GetUnitState(targetUnit,UNIT_STATE_MANA)-manaBurned)call PlaySoundAtPoint(FeedbackSound,GetUnitX(targetUnit),GetUnitY(targetUnit))set manaRestored=manaRestored+manaBurnedset manaBurnStacks=manaBurnStacks+1endifendifcall SaveReal(GameHashtable,(triggerId),(222),((manaRestored)*1.0))call SaveReal(GameHashtable,(triggerId),(224),((bounceCount)*1.0))call SaveReal(GameHashtable,(triggerId),(223),((manaBurnStacks)*1.0))set tempGroup=AcquireGroupFromPool()set FilterUnitTemp=nullset AllySearchSourceUnit=targetUnitset ExcludedUnitGroup_2=bouncedGroupset NearestDistanceFound_2=99999set VisionOwnerUnit=casterUnitcall GroupEnumUnitsInRange(tempGroup,GetUnitX(targetUnit),GetUnitY(targetUnit),500,Condition(function FilterNearestBounceTarget))call ReleaseGroupToPool(tempGroup)if FilterUnitTemp==null or bounceCount==(2+abilityLevel)thencall SaveInteger(GameHashtable,(triggerId),(30),(RegisterUnitHandleSlot(casterUnit)))elsecall SaveInteger(GameHashtable,(triggerId),(30),(RegisterUnitHandleSlot(FilterUnitTemp)))call GroupAddUnit(bouncedGroup,FilterUnitTemp)endifendifcall ClearUnitHandleSlot(targetSlot)endifset tickTrigger=nullset casterUnit=nullset targetUnit=nullset tempGroup=nullset projectileUnit=nullset bouncedGroup=nullreturn falseendfunctionfunction CastManaBounceProjectile takes nothing returns nothinglocal unit casterUnit=GetTriggerUnit()local unit targetUnit=GetSpellTargetUnit()local integer abilityLevel=GetUnitAbilityLevel(casterUnit,'A0G2')local trigger tickTrigger=Create