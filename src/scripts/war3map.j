if GetSpellAbilityId()==CastSpellIdA2L1 thencall ApplyBurnDebuffAoE()endifreturn falseendfunctionfunction RegisterBurnAoESpell takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(t,Condition(function FilterCastBurnAoE))set t=nullendfunctionfunction OnPurpleTintFadeTick takes nothing returns booleanlocal trigger tickTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(tickTrigger)local unit targetUnit=(LoadUnitHandle(GameHashtable,(handleId),(53)))local real fadeDuration=(LoadReal(GameHashtable,(handleId),(57)))local integer alpha=(LoadInteger(GameHashtable,(handleId),(58)))if GetTriggerEvalCount(tickTrigger)/10>R2I(fadeDuration)thencall SetUnitVertexColor(targetUnit,255,100,255,255)call FlushChildHashtable(GameHashtable,(handleId))call RecycleExpiringTrigger(tickTrigger)elseif IsUnitDeadOrInvalid(targetUnit)==false thencall SetUnitVertexColor(targetUnit,255,100,255,alpha)endifset tickTrigger=nullset targetUnit=nullreturn falseendfunctionfunction StartPurpleTintFade takes unit targetUnit,real fadeDuration,integer alpha returns nothinglocal trigger fadeTrigger=CreateTrigger()local integer handleId=GetHandleId(fadeTrigger)call TriggerRegisterTimerEvent(fadeTrigger,0.1,true)call TriggerAddCondition(fadeTrigger,Condition(function OnPurpleTintFadeTick))call SaveUnitHandle(GameHashtable,(handleId),(53),(targetUnit))call SaveReal(GameHashtable,(handleId),(57),((fadeDuration)*1.0))call SaveInteger(GameHashtable,(handleId),(58),(alpha))set fadeTrigger=nullendfunctionfunction OnTransformFinalEffectExpire takes nothing returns booleanlocal trigger expireTrigger=GetTriggeringTrigger()local integer triggerHandleId=GetHandleId(expireTrigger)local unit targetUnit=(LoadUnitHandle(GameHashtable,(triggerHandleId),(14)))call FlushChildHashtable(GameHashtable,(triggerHandleId))call RecycleExpiringTrigger(expireTrigger)call Dest