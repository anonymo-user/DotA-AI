ll and TrackedSideUnit[GetPlayerId(ScourgePlayer[1])]!=null and TrackedSideUnit[GetPlayerId(ScourgePlayer[2])]!=null and TrackedSideUnit[GetPlayerId(ScourgePlayer[3])]!=null and TrackedSideUnit[GetPlayerId(ScourgePlayer[4])]!=null and TrackedSideUnit[GetPlayerId(ScourgePlayer[5])]!=null)thenset tempTrigger=CreateTrigger()call TriggerRegisterTimerEvent(tempTrigger,7.,false)call TriggerAddCondition(tempTrigger,Condition(function OnBaseRevealTimerExpire))set tempTrigger=nullendifset PlayerHeroDead[GetPlayerId(GetOwningPlayer((triggerUnit)))]=falsecall RegionAddRect(createdRegion,RegionRRect1)if GameModeFlagY_2 and GameModeFlagA==false thenset PlayerCommandFlagE[GetPlayerId(owner)]=trueset owner=(LoadPlayerHandle(GameHashtable,(2000),(550+GetPlayerId(owner))))call SetUnitOwner(triggerUnit,owner,true)if(GetPlayerController(owner)==MAP_CONTROL_COMPUTER)and not AiSuppressModeFlag and not AiRelatedGameModeFlag thencall StoreUnitByName(AiGameCacheKey,"AIHSwap|U",triggerUnit)call ExecuteFunc("ReinitSwappedHeroCombat")endifendifcall SetPlayerAbilityAvailable(GetOwningPlayer(triggerUnit),'A2TS',false)if IsPlayerOnTeamZero(GetOwningPlayer(triggerUnit))thenif IsUnitInRegion(createdRegion,triggerUnit)thenset posX=GetRandomReal(GetRectMinX(BaseCenterRectB),GetRectMaxX(BaseCenterRectB))set posY=GetRandomReal(GetRectMinY(BaseCenterRectB),GetRectMaxY(BaseCenterRectB))elseset posX=GetUnitX(triggerUnit)set posY=GetUnitY(triggerUnit)endifelseif IsUnitInRegion(createdRegion,triggerUnit)thenset posX=GetRandomReal(GetRectMinX(BaseCenterRectA),GetRectMaxX(BaseCenterRectA))set posY=GetRandomReal(GetRectMinY(BaseCenterRectA),GetRectMaxY(BaseCenterRectA))elseset posX=GetUnitX(triggerUnit)set posY=GetUnitY(triggerUnit)endifendifset PlayerCommandFlagZ[GetPlayerId(owner)]=trueif(not GameModeFlagY_2 or GameModeFlagA)thenif GameModeFlagOL==false and GameModeFlagO1==false thencall PanCameraToTimedForPlayer(owner,posX,posY,0)endifif GetUnitTypeId(triggerUnit)!='