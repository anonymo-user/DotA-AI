Id[ItemIndexGold1000B]),0,0))elseif hasItem1000A thencall UnitAddItem(cloneUnit,CreateItem((ItemTypeId[ItemIndexGold1000A]),0,0))elseif hasItem1450 thencall UnitAddItem(cloneUnit,CreateItem(ItemTypeId[ItemIndexCost1450],0,0))elseif hasItem1350 thencall UnitAddItem(cloneUnit,CreateItem(ItemTypeId[ItemIndexCost1350],0,0))elseif hasItem1400B thencall UnitAddItem(cloneUnit,CreateItem(ItemTypeId[ItemIndexCost1400B],0,0))elseif hasItem1400C thencall UnitAddItem(cloneUnit,CreateItem(ItemTypeId[ItemIndexCost1400C],0,0))elseif hasItem1400D thencall UnitAddItem(cloneUnit,CreateItem(ItemTypeId[ItemIndexCost1400D],0,0))elseif hasItem2450 thencall UnitAddItem(cloneUnit,CreateItem(ItemTypeId[ItemIndexCost2450],0,0))elseif hasItem450A thencall UnitAddItem(cloneUnit,CreateItem(ItemTypeId[ItemIndexCost450A],0,0))endifcall EnableTrigger(itemTrigger)call EnableTrigger(ToggleableTrigger)set itemTrigger=nullendfunctionfunction SyncCloneItemsOnManipulate takes nothing returns nothinglocal unit manipulatingUnit=GetTriggerUnit()local integer slotIndex=0local boolean hasCost450=falselocal boolean hasCost2450=falselocal boolean hasCost1400D=falselocal boolean hasCost1400C=falselocal boolean hasCost1400B=falselocal boolean hasCost1350=falselocal boolean hasCost1450=falselocal boolean hasGold1000A=falselocal boolean hasGold1000B=falselocal integer playerId=GetHandleId(GetOwningPlayer(manipulatingUnit))local unit hero1=(LoadUnitHandle(GameHashtable,(playerId),(699)))local unit hero2=(LoadUnitHandle(GameHashtable,(playerId),(700)))local unit hero3=(LoadUnitHandle(GameHashtable,(playerId),(701)))local unit hero4=(LoadUnitHandle(GameHashtable,(playerId),(702)))local unit hero5=(LoadUnitHandle(GameHashtable,(playerId),(703)))local integer slotItemTypeIdlocal boolean isDropEvent=falselocal integer count450=0local integer count2450=0local integer count1400D=0local integer count1400C=0local integer count1400B=0local integer count1350=0local integer count