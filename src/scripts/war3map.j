Trigger=nullset heroUnit=nullendfunctionfunction EnumAccumDamageAndRemoveDebuff takes nothing returns nothingif IsUnitType(GetEnumUnit(),UNIT_TYPE_HERO) thenset AccumulatedDamage=AccumulatedDamage+60elseset AccumulatedDamage=AccumulatedDamage+20endifcall UnitRemoveAbility(GetEnumUnit(),RemovableAbilityId_A2LE)call UnitRemoveAbility(GetEnumUnit(),HiddenAbilityId_B0G1)endfunctionfunction EnumAccumDamageByUnitType takes nothing returns nothingif IsUnitType(GetEnumUnit(),UNIT_TYPE_HERO) thenset AccumulatedDamage=AccumulatedDamage+60elseset AccumulatedDamage=AccumulatedDamage+20endifendfunctionfunction EnumCastScaledAbilityAndDamage takes nothing returns nothingcall CreateDummyCastScaledAbilityOnTarget(DamageCasterUnit,GetEnumUnit(),.5+TempAbilityLevel*.5)call DamageTargetByType(DamageCasterUnit,GetEnumUnit(),DamageType1,AccumulatedDamage)endfunctionfunction FilterHasDebuffKU7 takes nothing returns booleanreturn GetUnitAbilityLevel(GetFilterUnit(),HiddenAbilityId_B0G1)>0endfunctionfunction OnCastDetonateDebuffKS7 takes nothing returns nothinglocal unit caster=GetTriggerUnit()local group tempGroup=AcquireGroupFromPool()local trigger whichTrigger=CreateTrigger()local integer triggerId=GetHandleId(whichTrigger)set DamageCasterUnit=casterset TempAbilityLevel=GetUnitAbilityLevel(caster,OnAttackAbilityId_A2L9)set AccumulatedDamage=0call GroupEnumUnitsInRange(tempGroup,0,0,9999,Condition(function FilterHasDebuffKU7))call ForGroup(tempGroup,function EnumAccumDamageAndRemoveDebuff)call ForGroup(tempGroup,function EnumCastScaledAbilityAndDamage)call ReleaseGroupToPool(tempGroup)set tempGroup=nullset caster=nullendfunctionfunction OnSpellEffectDetonateKS7 takes nothing returns booleanif GetSpellAbilityId()==OnAttackAbilityId_A2L9 thencall OnCastDetonateDebuffKS7()endifreturn falseendfunctionfunction CreateRisingBlueTextOverUnit takes string messageText,unit targetUnit,unit ownerUnit returns nothinglocal texttag whichTextTag=CreateTextTag()call SetTextTagText(whichTextTag,messageText,.033)call SetTextTagPosUnit(whichTextTag,targetUnit,64)call SetTextTagColor(whichTextTag,0,75,255,255)call SetTextTagVelocity(whichTextTag,0,.0355)call SetTextTagFadepoint(whichTextTag,.15)call SetTextTagPermanent(whichTextTag,false)call SetTextTagLifespan(whichTextTag,1.)if IsUnitAlly(ownerUnit,GetLocalPlayer())or IsEitherKeyPlayerActive(GetLocalPlayer())thencall SetTextTagVisibility(whichTextTag,true)elsecall SetTextTagVisibility(whichTextTag,false)endifset whichTextTag=nullendfunctionfunction OnGrantedAbilityPairExpire takes nothing returns booleanlocal trigger whichTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(whichTrigger)local unit targetUnit=(LoadUnitHandle(GameHashtable,(triggerId),(17)))local real expireTime=(LoadReal(GameHashtable,(GetHandleId(targetUnit)),(753)))if targetUnit==null thencall FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(whichTrigger)return falseendifif GetTriggerEventId()==EVENT_WIDGET_DEATH or expireTime<(TimerGetElapsed(GameClockTimer))thencall UnitRemoveAbility(targetUnit,RemovableAbilityId_A2LE)call UnitRemoveAbility(targetUnit,HiddenAbilityId_B0G1)call SaveReal(GameHashtable,(GetHandleId(targetUnit)),(753),((0)*1.))call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(whichTrigger)endifset whichTrigger=nullset targetUnit=nullreturn falseendfunctionfunction ApplyGrantedAbilityPairDebuff takes unit caster,unit targetUnit returns nothinglocal trigger expireTriggerlocal integer handleIdlocal group targetGroup=AcquireGroupFromPool()call SaveReal(GameHashtable,(GetHandleId(targetUnit)),(753),(((TimerGetElapsed(GameClockTimer))+BuffDuration20)*1.))set expireTrigger=CreateTrigger()set handleId=GetHandleId(expireTrigger)call TriggerRegisterTimerEvent(expireTrigger,.25,true)call TriggerRegisterDeathEvent(expireTrigger,targetUnit)call TriggerAddCondition(expireTrigger,Condition(function OnGrantedAbilityPairExpire))call SaveUnitHandle(GameHashtable,(handleId),(17),(targetUnit))call AddPermanentAbility(targetUnit,RemovableAbilityId_A2LE)call SetPlayerAbilityAvailable(GetOwningPlayer(targetUnit),RemovableAbilityId_A2LE,false)set DamageCasterUnit=casterset TempAbilityLevel=GetUnitAbilityLevel(caster,OnAttackAbilityId_A2L9)set AccumulatedDamage=0call GroupEnumUnitsInRange(targetGroup,0,0,9999,Condition(function FilterHasDebuffKU7))call ForGroup(targetGroup,function EnumAccumDamageByUnitType)call ReleaseGroupToPool(targetGroup)call CreateRisingBlueTextOverUnit(I2S(AccumulatedDamage),targetUnit,caster)set expireTrigger=nullendfunctionfunction OnFirstDamageApplyAbilityPair takes nothing returns booleanlocal trigger whichTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(whichTrigger)local unit caster=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local unit targetUnit=(LoadUnitHandle(GameHashtable,(triggerId),(17)))if GetTriggerEventId()!=EVENT_UNIT_DAMAGED thencall FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(whichTrigger)elseif GetEventDamageSource()==caster and GetEventDamage()>0 thencall FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(whichTrigger)if IsUnitTypeInSetC(targetUnit)==false thencall ApplyGrantedAbilityPairDebuff(caster,targetUnit)endifendifendifset whichTrigger=nullset caster=nullset targetUnit=nullreturn falseendfunctionfunction OnAttackStartAbilityPairWatcher takes nothing returns nothinglocal unit attacker=GetAttacker()local unit targetUnit=GetTriggerUnit()local trigger whichTriggerlocal integer triggerIdif((LoadInteger(GameHashtable,(GetHandleId((attacker))),((4325))))==1)==false thencall StartUnitFlagTimer(attacker,4325,0.2)set whichTrigger=CreateTrigger()set triggerId=GetHandleId(whichTrigger)call TriggerRegisterUnitEvent(whichTrigger,targetUnit,EVENT_UNIT_DAMAGED)call TriggerRegisterTimerEvent(whichTrigger,2.5,false)call TriggerAddCondition(whichTrigger,Condition(function OnFirstDamageApplyAbilityPair))call SaveUnitHandle(GameHashtable,(triggerId),(2),(attacker))call SaveUnitHandle(GameHashtable,(triggerId),(17),(targetUnit))endifset attacker=nullset targetUnit=nullendfunctionfunction FilterAttackedTriggerAbilityPair takes nothing returns booleanif GetUnitAbilityLevel(GetAttacker(),OnAttackAbilityId_A2L9)>0 and IsUnitType(GetTriggerUnit(),UNIT_TYPE_STRUCTURE)==false and GetUnitTypeId(GetTriggerUnit())!='n00L' and IsUnitEnemy(GetTriggerUnit(),GetOwningPlayer(GetAttacker()))thencall OnAttackStartAbilityPairWatcher()endifreturn falseendfunctionfunction InitAbilityPairAttackAndSpellTriggers takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(t,Condition(function OnSpellEffectDetonateKS7))set t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_ATTACKED)call TriggerAddCondition(t,Condition(function FilterAttackedTriggerAbilityPair))set t=nullendfunctionfunction OnHomingProjectileImpactApplyKW takes nothing returns nothinglocal integer handleId=GetHandleId(GetTriggeringTrigger())local unit caster=(LoadUnitHandle(GameHashtable,(handleId),(2)))local unit projectileUnit=FilterReferenceUnit_2local unit targetUnit=FilterReferenceUnitBlocal integer abilityLevel=GetUnitAbilityLevel(caster,MarkingSpellId_A2LA)if UnitHasAnyImmunityAbilityOrFlag(targetUnit)==false thencall DamageTargetByType(caster,targetUnit,DamageType1,20+80*abilityLevel)call GrantTimedAbilityPair(targetUnit,TimedGrantAbilityId_A2MK,1,4,TimedGrantPairedAbilityId_B0G4)call SetPlayerAbilityAvailable(GetOwningPlayer(targetUnit),TimedGrantAbilityId_A2MK,false)call UnitMakeAbilityPermanent(targetUnit,true,'A2MJ')endifset caster=nullset targetUnit=nullset projectileUnit=nullendfunctionfunction EnumLaunchHomingProjectileAtEnemy takes nothing returns nothinglocal unit sourceUnit=TempUnitParamlocal unit enemyUnit=GetEnumUnit()local trigger projectileTrigger=LaunchHomingProjectile(TempProjectileSource,enemyUnit,'h0EE',"OnHomingProjectileImpactApplyKW",600,false)local integer triggerId=GetHandleId(projectileTrigger)call SaveUnitHandle(GameHashtable,(triggerId),(2),(sourceUnit))set sourceUnit=nullset enemyUnit=nullset projectileTrigger=nullendfunctionfunction LaunchHomingProjectilesAtNearbyEnemies takes unit caster,unit projectileSource returns nothinglocal integer abilityLevel=GetUnitAbilityLevel(caster,MarkingSpellId_A2LA)local group tempGroup=AcquireGroupFromPool()set FilterReferenceUnit_2=casterset TempUnitParam=casterset TempProjectileSource=projectileSourcecall GroupEnumUnitsInRange(tempGroup,GetUnitX(projectileSource),GetUnitY(projectileSource),500+25,Condition(function FilterAttackableEnemy))call GroupRemoveUnit(tempGroup,projectileSource)call ForGroup(tempGroup,function EnumLaunchHomingProjectileAtEnemy)call ReleaseGroupToPool(tempGroup)set caster=nullset projectileSource=nullset tempGroup=nullendfunctionfunction OnKvMissileFlightTick takes nothing returns booleanlocal trigger whichTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(whichTrigger)local unit casterUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local unit targetUnit=(LoadUnitHandle(GameHashtable,(triggerId),(17)))local unit missileUnit=(LoadUnitHandle(GameHashtable,(triggerId),(45)))local real missileX=GetUnitX(missileUnit)local real missileY=GetUnitY(missileUnit)local real targetX=GetUnitX(targetUnit)local real targetY=GetUnitY(targetUnit)local real distanceToTarget=DistanceBetweenCoords(targetX,targetY,missileX,missileY)local integer tickCount=GetTriggerEvalCount(whichTrigger)local real travelAngle=AngleBetweenCoords(missileX,missileY,targetX,targetY)local real nextXlocal real nextYlocal real stepDistance=distanceToTarget/((ProjectileTravelConstant/.02)-tickCount)if stepDistance<MinProjectileSpeedPerTick*.02 thenset stepDistance=MinProjectileSpeedPerTick*.02endifset nextX=missileX+stepDistance*Cos(travelAngle*bj_DEGTORAD)set nextY=missileY+stepDistance*Sin(travelAngle*bj_DEGTORAD)call SetUnitX(missileUnit,nextX)call SetUnitY(missileUnit,nextY)call SetUnitFacing(missileUnit,travelAngle)if DistanceBetweenCoords(targetX,targetY,nextX,nextY)<=stepDistance thencall KillUnit(missileUnit)call LaunchHomingProjectilesAtNearbyEnemies(casterUnit,targetUnit)call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(whichTrigger)endifset whichTrigger=nullset targetUnit=nullset casterUnit=nullset missileUnit=nullreturn falseendfunctionfunction OnCastKvLaunchMissile takes nothing returns nothinglocal unit caster=GetTriggerUnit()local unit targetUnit=GetSpellTargetUnit()local trigger flightTrigger=CreateTrigger()local integer handleId=GetHandleId(flightTrigger)local unit missileUnit=CreateUnit(GetOwningPlayer(caster),'h0EJ',GetUnitX(caster),GetUnitY(caster),0)call TriggerRegisterTimerEvent(flightTrigger,.02,true)call TriggerAddCondition(flightTrigger,Condition(function OnKvMissileFlightTick))call SaveUnitHandle(GameHashtable,(handleId),(2),(caster))call SaveUnitHandle(GameHashtable,(handleId),(17),(targetUnit))call SaveUnitHandle(GameHashtable,(handleId),(45),(missileUnit))set caster=nullset targetUnit=nullset missileUnit=nullset flightTrigger=nullendfunctionfunction FilterCastKvUnmarkedTarget takes nothing returns booleanif GetSpellAbilityId()==MarkingSpellId_A2LA and HasAnyMarkedAbility(GetSpellTargetUnit())==false thencall OnCastKvLaunchMissile()endifreturn falseendfunctionfunction InitKvSpellHandler takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(t,Condition(function FilterCastKvUnmarkedTarget))set t=nullendfunctionfunction EnumDummyCastAndDamageA2F4 takes nothing returns nothingcall CreateDummyCastScaledAbilityOnTarget(ScaledAbilityCaster_2,GetEnumUnit(),1.5)call DamageTargetByType(ScaledAbilityCaster_2,GetEnumUnit(),2,50+50*ScaledAbilityLevel)endfunctionfunction OnA2F4DashTick takes nothing returns booleanlocal trigger thisTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(thisTrigger)local unit casterUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local real angle=(LoadReal(GameHashtable,(triggerId),(137)))local real targetX=(LoadReal(GameHashtable,(triggerId),(47)))local real targetY=(LoadReal(GameHashtable,(triggerId),(48)))local real currentX=GetUnitX(casterUnit)local real currentY=GetUnitY(casterUnit)local group enumGroup=AcquireGroupFromPool()local integer abilityLevel=GetUnitAbilityLevel(casterUnit,'A2F4')if casterUnit==null thencall ReleaseGroupToPool(enumGroup)call FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(thisTrigger)return falseendifset currentX=ClampXToPlayableArea(currentX+32*Cos(angle))set currentY=ClampYToPlayableArea(currentY+32*Sin(angle))if DistanceBetweenCoords(currentX,currentY,targetX,targetY)<40 thenset currentX=targetXset currentY=targetYendifcall SetUnitX(casterUnit,currentX)call SetUnitY(casterUnit,currentY)call SetUnitFacing(casterUnit,angle*bj_RADTODEG)set FilterReferenceUnit_2=casterUnitcall GroupEnumUnitsInRange(enumGroup,currentX,currentY,125+25,Condition(function FilterAttackableEnemy))if FirstOfGroup(enumGroup)!=null or(currentX==targetX and currentY==targetY)or GetTriggerEvalCount(thisTrigger)>200 or GetTriggerEventId()==EVENT_WIDGET_DEATH thencall DestroyEffect(AddSpecialEffect("war3mapImported\\BlackDragonMissile.mdx",currentX,currentY))call GroupEnumUnitsInRange(enumGroup,currentX,currentY,300+25,Condition(function FilterAttackableEnemy))set ScaledAbilityLevel=abilityLevelset ScaledAbilityCaster_2=casterUnitif GetTriggerEventId()!=EVENT_WIDGET_DEATH thencall ForGroup(enumGroup,function EnumDummyCastAndDamageA2F4)endifcall FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(thisTrigger)endifcall ReleaseGroupToPool(enumGroup)set thisTrigger=nullset casterUnit=nullset enumGroup=nullreturn falseendfunctionfunction InitCustomTeams takes nothing returns nothingcall SetPlayerTeam(Player(1),0)call SetPlayerTeam(Player(2),0)call SetPlayerTeam(Player(3),0)call SetPlayerTeam(Player(4),0)call SetPlayerTeam(Player(5),0)call SetPlayerTeam(Player(7),1)call SetPlayerTeam(Player(8),1)call SetPlayerTeam(Player(9),1)call SetPlayerTeam(Player(10),1)call SetPlayerTeam(Player(11),1)endfunctionfunction IndexOfCharFrom takes string sourceString,string searchChar,integer startIndex returns integerlocal integer i=startIndexlocal string currentChar=nullloopexitwhen i==StringLength(sourceString)set currentChar=SubString(sourceString,i,i+1)if(currentChar==searchChar)thenreturn iendifset i=i+1endloopreturn-1endfunctionfunction OnRenamePlayerChatCommand takes nothing returns nothinglocal string chatString=GetEventPlayerChatString()local integer firstSpaceIndex=IndexOfCharFrom(chatString," ",0)local integer secondSpaceIndex=IndexOfCharFrom(chatString," ",firstSpaceIndex+1)local integer targetPlayerId=S2I(SubString(chatString,firstSpaceIndex,secondSpaceIndex+1))local string newName=SubString(chatString,secondSpaceIndex+1,StringLength(chatString))local boolean nameTaken=falselocal integer index=0set newName="+"+newNameif targetPlayerId<12 thenloopexitwhen index==14if(newName==GetPlayerName(Player(index)))thenset nameTaken=trueendifset index=index+1endloopif((not nameTaken)and(RemainingAiNameSlots>0)and(GetPlayerController(Player(targetPlayerId))==MAP_CONTROL_COMPUTER)and(targetPlayerId!=0)and(targetPlayerId!=6)and(targetPlayerId<12)and(StringLength(newName)<20))thencall PrintTimedTextLocal("Renaming "+GetPlayerName(Player(targetPlayerId))+" : "+newName)set PlayerName[targetPlayerId]=newNamecall SetPlayerName(Player(targetPlayerId),newName)set RemainingAiNameSlots=RemainingAiNameSlots-1endifendifendfunctionfunction RegisterRenamePlayerChatTrigger takes nothing returns nothinglocal trigger renameTrigger=CreateTrigger()local integer index=0loopexitwhen index==14call TriggerRegisterPlayerChatEvent(renameTrigger,Player(index),"-rn ",false)set index=index+1endloopcall TriggerAddAction(renameTrigger,function OnRenamePlayerChatCommand)set renameTrigger=nullendfunctionfunction EnumDebugPrintItemInfo takes nothing returns nothingcall DebugPrintGlobal("Enum Item "+GetItemName(GetEnumItem())+IntToRawcodeString(GetItemTypeId(GetEnumItem()))+IntToStringSpaced(GetPlayerId(GetItemPlayer(GetEnumItem()))))endfunctionfunction HandleDebugNumericChatCommand takes nothing returns nothinglocal unit unit2=TrackedSideUnit[GetPlayerId(Player(2))]local unit unit7=TrackedSideUnit[GetPlayerId(Player(7))]local boolean tempFlag=falselocal item tempItem=nulllocal integer index=0local integer commandCode=0local group tempGrouplocal trigger tempTrigger=nulllocal timer tempTimer=nullset commandCode=S2I(SubString(GetEventPlayerChatString(),3,255))if commandCode==0 thencall KillUnit(LaneTowerJX)call KillUnit(GuardTowerJA4)call ExecuteTriggerJS()call ExecuteTriggerJS()call ExecuteTriggerJS()call ExecuteTriggerJS()call ExecuteTriggerJS()call KillNonStructureUnitsOfTeamTwo()elseif commandCode==1 thencall KillUnit(LaneTowerJX)call KillUnit(LaneTowerJW)call KillUnit(LaneTowerJY)call ExecuteTriggerJS()call ExecuteTriggerJS()call KillUnit(TrackedSideUnit[7])call KillUnit(TrackedSideUnit[8])call KillNonStructureUnitsOfTeamTwo()elseif commandCode==2 thenset index=1loopexitwhen index>11if index==6 thenset index=7endifif TrackedSideUnit[index]!=null thencall DisplayTextToPlayer(GetLocalPlayer(),0,0,"EHP Modifier "+I2S(index)+": "+R2S(AiPlayerTimeThreshold[752+index])+"/"+R2S(AiPlayerTimeThreshold[720+index])+" - d% = "+R2S(AiPlayerTimeThreshold[704+index]))endifset index=index+1endloopelseif commandCode=