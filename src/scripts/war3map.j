ggerUnit()))==MAP_CONTROL_USER)thencall AddPermanentAbility(GetTriggerUnit(),'A0AZ')elsecall PolledWait_2(.1)if(GetUnitAbilityLevel(GetTriggerUnit(),'B02T')>0)thencall UnitAddAbility(GetTriggerUnit(),'A0AZ')endifendifelseif(GetIssuedOrderId()==852178)thenif(GetPlayerController(GetOwningPlayer(GetTriggerUnit()))==MAP_CONTROL_USER)thencall UnitRemoveAbility(GetTriggerUnit(),'A0AZ')elsecall PolledWait_2(.1)if(GetUnitAbilityLevel(GetTriggerUnit(),'B02T')==0)thencall UnitRemoveAbility(GetTriggerUnit(),'A0AZ')endifendifendifendfunctionfunction RegisterA06KImmolationToggleHandler takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventBothTeams(t,EVENT_PLAYER_UNIT_ISSUED_ORDER)call TriggerAddCondition(t,Condition(function TriggeringUnitHasAbilityA06K))call TriggerAddAction(t,function OnImmolationToggleSwapA0AZ)set t=nullendfunctionfunction EnumIncrementUnitKillCounter takes nothing returns nothinglocal integer unitHandleId=GetHandleId(GetEnumUnit())if GetTriggerUnit()!=GetEnumUnit()thencall SaveInteger(GameHashtable,(unitHandleId),(672),((LoadInteger(GameHashtable,(unitHandleId),(672)))+1))endifendfunctionfunction FilterEnemyU00FNonIllusion takes nothing returns booleanreturn GetUnitTypeId(GetFilterUnit())=='U00F' and IsUnitIllusion(GetFilterUnit())==false and IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(GetTriggerUnit()))endfunctionfunction OnHeroDeathIncrementNearbyU00FKillCounters takes nothing returns booleanlocal group gif IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO) and IsSkillAnnounceExemptUnit(GetUnitTypeId(GetTriggerUnit()))==false and IsUnitIllusion(GetTriggerUnit())==false thenset g=AcquireGroupFromPool()call GroupEnumUnitsInRange(g,GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit()),475,Condition(function FilterEnemyU00FNonIllusion))if GetUnitTypeId(GetKillingUnit())=='U00F' thencall GroupAddUnit(g,GetKillingUnit())endifcall ForGroup(g,function EnumIncrementUnitKillCounter)call ReleaseG