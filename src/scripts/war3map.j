falseendfunctionfunction RegisterHeroCreepPull takes unit hero returns nothinglocal group creepGrouplocal trigger whichTriggerlocal timer pullTimerlocal integer handleId=GetHandleId(hero)set creepPullCounter=creepPullCounter+1call SaveBoolean(GameHashtable,(handleId),(142),(true))call SaveInteger(GameHashtable,(handleId),(143),(creepPullCounter))set creepGroup=AcquireGroupFromPool()call SaveGroupHandle(GameHashtable,(handleId),(144),(creepGroup))set whichTrigger=CreateTrigger()call TriggerRegisterUnitEvent(whichTrigger,hero,EVENT_UNIT_ISSUED_TARGET_ORDER)call TriggerAddCondition(whichTrigger,Condition(function OnHeroOrderedAttackPullCreeps))set whichTrigger=CreateTrigger()call TriggerRegisterUnitEvent(whichTrigger,hero,EVENT_UNIT_ATTACKED)call TriggerAddCondition(whichTrigger,Condition(function OnUnitAttackedPullCreeps))set pullTimer=CreateTimer()call SaveTimerHandle(GameHashtable,(GetHandleId(hero)),(141),(pullTimer))call SaveUnitHandle(GameHashtable,GetHandleId(pullTimer),(2),hero)set creepGroup=nullset whichTrigger=nullset pullTimer=nullendfunctionfunction ReissueCreepOrderToTargetOrLane takes nothing returns nothinglocal unit creepUnit=GetTriggerUnit()local unit targetUnit=UnitByCustomValue[GetUnitUserData(creepUnit)]call SetUnitPosition(creepUnit,GetUnitX(creepUnit),GetUnitY(creepUnit))if targetUnit!=null and IsUnitDeadOrInvalid(targetUnit)==false and IsUnitVisible(targetUnit,GetOwningPlayer(targetUnit))thencall IssueTargetOrderById(creepUnit,851983,targetUnit)elsecall DisableTrigger(GetTriggeringTrigger())call IssuePointOrderByIdLoc(creepUnit,851983,(AbilityLevelOrderPoint[GetUnitAbilityLevel((creepUnit),OrderAbilityId)]))call EnableTrigger(GetTriggeringTrigger())endifset creepUnit=nullset targetUnit=nullendfunctionfunction CondReissueCreepOrderIfMainPlayer takes nothing returns booleanif IsUnitOwnedByMainCreepPlayer(GetTriggerUnit())thencall ReissueCreepOrderToTargetOrLane()endifreturn falseendfunctionfunction Reis