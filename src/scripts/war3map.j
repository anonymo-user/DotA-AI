ayerAbilityAvailable(GetOwningPlayer(GetEnumUnit()),'A27S',false)endifelseif AbilityLevelBranch_2==2 thenif GetUnitAbilityLevel(GetEnumUnit(),'A27Q')==0 thencall UnitRemoveAbility(GetEnumUnit(),'A27S')call AddPermanentAbility(GetEnumUnit(),'A27Q')call SetPlayerAbilityAvailable(GetOwningPlayer(GetEnumUnit()),'A27Q',false)endifelseif AbilityLevelBranch_2==3 thenif GetUnitAbilityLevel(GetEnumUnit(),'A27R')==0 thencall UnitRemoveAbility(GetEnumUnit(),'A27S')call UnitRemoveAbility(GetEnumUnit(),'A27Q')call AddPermanentAbility(GetEnumUnit(),'A27R')call SetPlayerAbilityAvailable(GetOwningPlayer(GetEnumUnit()),'A27R',false)endifelseif AbilityLevelBranch_2==4 thenif GetUnitAbilityLevel(GetEnumUnit(),'A27T')==0 thencall UnitRemoveAbility(GetEnumUnit(),'A27S')call UnitRemoveAbility(GetEnumUnit(),'A27Q')call UnitRemoveAbility(GetEnumUnit(),'A27R')call AddPermanentAbility(GetEnumUnit(),'A27T')call SetPlayerAbilityAvailable(GetOwningPlayer(GetEnumUnit()),'A27T',false)endifendifendfunctionfunction OnTieredAuraGrantTick takes nothing returns booleanlocal trigger auraTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(auraTrigger)local unit casterUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local group prevGroup=(LoadGroupHandle(GameHashtable,(triggerId),(340)))local real casterX=GetUnitX(casterUnit)local real casterY=GetUnitY(casterUnit)local group currentGroup=AcquireGroupFromPool()if casterUnit==null or GetUnitTypeId(casterUnit)!='E02X' thencall FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(auraTrigger)call ForGroup(prevGroup,function EnumRemoveTieredGrantAbility)call ReleaseGroupToPool(prevGroup)call ReleaseGroupToPool(currentGroup)return falseendifset FilterReferenceUnit_2=casterUnitset AbilityLevelBranch_2=GetUnitAbilityLevel(casterUnit,'A27V')if IsUnitDeadOrInvalid(casterUnit)==false thencall GroupEnumUnitsInRange(currentGroup,casterX,casterY,925,Condition(function FilterAllyHeroValidTarget))endifcall GroupRemoveGroup(currentGroup,prevGroup)call ForGroup(prevGroup,function EnumRemoveTieredGrantAbility)if IsUnitDeadOrInvalid(casterUnit)==false thencall ForGroup(currentGroup,function EnumGrantTieredAbilityByLevel)endifcall SaveGroupHandle(GameHashtable,(triggerId),(340),(currentGroup))call ReleaseGroupToPool(prevGroup)set auraTrigger=nullset casterUnit=nullset prevGroup=nullset currentGroup=nullreturn falseendfunctionfunction StartTieredAuraGrant takes nothing returns nothinglocal trigger tickTrigger=CreateTrigger()local integer triggerId=GetHandleId(tickTrigger)local unit casterUnit=GetTriggerUnit()local integer slotIndexlocal player whichPlayercall TriggerRegisterTimerEvent(tickTrigger,.3,true)call TriggerAddCondition(tickTrigger,Condition(function OnTieredAuraGrantTick))call SaveUnitHandle(GameHashtable,(triggerId),(2),(casterUnit))call SaveGroupHandle(GameHashtable,(triggerId),(340),(AcquireGroupFromPool()))set slotIndex=0loopexitwhen slotIndex>5set whichPlayer=SentinelPlayer[slotIndex]call SetPlayerAbilityAvailable(whichPlayer,'A27S',false)call SetPlayerAbilityAvailable(whichPlayer,'A27Q',false)call SetPlayerAbilityAvailable(whichPlayer,'A27R',false)call SetPlayerAbilityAvailable(whichPlayer,'A27T',false)set whichPlayer=ScourgePlayer[slotIndex]call SetPlayerAbilityAvailable(whichPlayer,'A27S',false)call SetPlayerAbilityAvailable(whichPlayer,'A27Q',false)call SetPlayerAbilityAvailable(whichPlayer,'A27R',false)call SetPlayerAbilityAvailable(whichPlayer,'A27T',false)set slotIndex=slotIndex+1endloopset tickTrigger=nullset casterUnit=nullendfunctionfunction OnLearnTieredAura takes nothing returns booleanif GetLearnedSkill()=='A27V' and GetUnitAbilityLevel(GetTriggerUnit(),'A27V')==1 and IsUnitIllusion(GetTriggerUnit())==false thencall StartTieredAuraGrant()endifreturn falseendfunctionfunction InitTieredAuraGrantSystem takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_HERO_SKILL)call TriggerAddCondition(t,Condition(function OnLearnTieredAura))set t=nullendfunctionfunction OnAlternateAnimationTimer takes nothing returns booleanlocal trigger animationTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(animationTrigger)local unit animatedUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))call AddUnitAnimationProperties(animatedUnit,"alternate",false)call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(animationTrigger)set animationTrigger=nullset animatedUnit=nullreturn falseendfunctionfunction ScheduleAlternateAnimation takes nothing returns nothinglocal unit triggerUnit=GetTriggerUnit()local trigger animationTrigger=CreateTrigger()local integer triggerId=GetHandleId(animationTrigger)call TriggerRegisterTimerEvent(animationTrigger,0,false)call TriggerAddCondition(animationTrigger,Condition(function OnAlternateAnimationTimer))call SaveUnitHandle(GameHashtable,(triggerId),(2),(triggerUnit))set animationTrigger=nullset triggerUnit=nullendfunctionfunction TriggerAlternateAnimationOnMorphSpell takes nothing returns booleanif(GetSpellAbilityId()=='A073' or GetSpellAbilityId()=='A03J' or GetSpellAbilityId()=='A04J' or GetSpellAbilityId()=='A04M' or GetSpellAbilityId()=='A04N')and GetUnitTypeId(GetTriggerUnit())=='E02X' thencall ScheduleAlternateAnimation()endifreturn falseendfunctionfunction InitAlternateAnimationSystem takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(t,Condition(function TriggerAlternateAnimationOnMorphSpell))set t=nullendfunctionfunction OnRetaliationCounterCast takes nothing returns booleanlocal trigger triggeringTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(triggeringTrigger)local unit casterUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local unit targetUnit=(LoadUnitHandl