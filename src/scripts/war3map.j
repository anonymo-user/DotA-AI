er=nullset caster=nullset targetUnit=nullreturn falseendfunctionfunction OnSpellStealCast takes nothing returns nothinglocal unit caster=GetTriggerUnit()local unit targetUnit=GetSpellTargetUnit()local integer pairIndexlocal integer stolenAbilityId=(LoadInteger(GameHashtable,(GetHandleId(targetUnit)),(705)))if stolenAbilityId!=0 thencall DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Nebula.mdx",targetUnit,"origin"))set pairIndex=FindAbilityIdPairIndex(stolenAbilityId)if pairIndex!=-1 thenif GetSpellAbilityId()=='A27H' thenset stolenAbilityId=RegisteredItemKey[pairIndex]elseset stolenAbilityId=RegisteredItemValue[pairIndex]endifendifcall LaunchSpellStealProjectile(caster,targetUnit,(LoadInteger(GameHashtable,(GetHandleId(targetUnit)),(705))),(LoadInteger(GameHashtable,(GetHandleId(targetUnit)),(712))))endifset caster=nullset targetUnit=nullendfunctionfunction SpellSteal takes nothing returns nothinglocal unit casterUnit=GetTriggerUnit()local unit targetUnit=GetSpellTargetUnit()local trigger watchTrigger=CreateTrigger()local integer triggerId=GetHandleId(watchTrigger)local string effectPath=""if IsPlayerAlly(GetOwningPlayer(casterUnit),GetLocalPlayer())or IsEitherKeyPlayerActive(GetLocalPlayer())thenset effectPath="war3mapImported\\Nebula.mdx"endifcall SaveUnitHandle(GameHashtable,(triggerId),(2),(casterUnit))call SaveUnitHandle(GameHashtable,(triggerId),(17),(targetUnit))call SaveEffectHandle(GameHashtable,(triggerId),(32),(AddSpecialEffectTarget(effectPath,targetUnit,"origin")))call TriggerRegisterTimerEvent(watchTrigger,20,false)call TriggerRegisterDeathEvent(watchTrigger,targetUnit)call TriggerRegisterUnitEvent(watchTrigger,targetUnit,EVENT_UNIT_SPELL_EFFECT)call TriggerAddCondition(watchTrigger,Condition(function OnSpellStealChannelInterruptTick))set casterUnit=nullset targetUnit=nullendfunctionfunction TrySpellStealCast takes nothing returns booleanif (GetSpellAbilityId()=='A27H' or GetSpellAbilityId()=='A2V9'