 takes nothing returns nothinglocal unit casterUnit=GetTriggerUnit()local integer abilityLevel=GetUnitAbilityLevel(casterUnit,'A1IN')local real duration=4.0local unit dummyUnit=CreateUnit(GetOwningPlayer(casterUnit),'h0B1',GetUnitX(casterUnit),GetUnitY(casterUnit),0)local trigger periodicTrigger=CreateTrigger()local integer handleId=GetHandleId(periodicTrigger)if IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(casterUnit))==false and IsEitherKeyPlayerActive(GetLocalPlayer())==false thencall UnitSetUsesAltIcon(casterUnit,true)endifcall GrantTimedAbility_2(casterUnit,'A1HW',1,duration)call GrantTimedAbility_2(casterUnit,'A1HX',1,duration)call SaveInteger(GameHashtable,(GetHandleId((casterUnit))),((4421)),(1))call UnitAddAbility(casterUnit,'A2VU')call UnitRemoveAbility(casterUnit,'A2VU')if GetUnitTypeId(casterUnit)!='E02X' thencall UnitAddAbility(casterUnit,'Aloc')call UnitRemoveAbility(casterUnit,'Aloc')endifcall ShowUnit(casterUnit,false)call ShowUnit(casterUnit,true)call SelectUnitAddForPlayer(casterUnit,GetOwningPlayer(casterUnit))call TriggerRegisterTimerEvent(periodicTrigger,0.03,true)call TriggerRegisterDeathEvent(periodicTrigger,casterUnit)call TriggerRegisterUnitEvent(periodicTrigger,casterUnit,EVENT_UNIT_ATTACKED)call TriggerAddCondition(periodicTrigger,Condition(function WindWalkPeriodicUpdate))call SaveUnitHandle(GameHashtable,(handleId),(19),(dummyUnit))call SaveUnitHandle(GameHashtable,(handleId),(2),(casterUnit))call SaveInteger(GameHashtable,(handleId),(5),(abilityLevel))call SaveInteger(GameHashtable,(handleId),(34),(0))set casterUnit=nullendfunctionfunction OnCastConditionA1IN takes nothing returns booleanif GetSpellAbilityId()=='A1IN' thencall OnCastWindWalkA1IN()endifreturn falseendfunctionfunction RegisterWindWalkA1IN takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(t,Condition(function OnCastConditionA1IN))set t=nullendfunctionfunction PounceLeashPeriodic takes nothing returns booleanlocal trigger tickTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(tickTrigger)local integer tickCount=GetTriggerEvalCount(tickTrigger)local unit casterUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local unit targetUnit=(LoadUnitHandle(GameHashtable,(triggerId),(17)))local lightning leashLightning=(LoadLightningHandle(GameHashtable,(triggerId),(196)))local integer abilityLevel=(LoadInteger(GameHashtable,(triggerId),(5)))local real anchorX=(LoadReal(GameHashtable,(triggerId),(189)))local real anchorY=(LoadReal(GameHashtable,(triggerId),(190)))local real targetX=GetUnitX(targetUnit)local real targetY=GetUnitY(targetUnit)local real clampedXlocal real clampedYlocal real prevX=(LoadReal(GameHashtable,(triggerId),(23)))local real prevY=(LoadReal(GameHashtable,(triggerId),(24)))local real anglelocal real moveDistance=DistanceBetweenCoords(prevX,prevY,targetX,targetY)call SaveReal(GameHashtable,(triggerId),(23),((targetX)*1.0))call SaveReal(GameHashtable,(triggerId),(24),((targetY)*1.0))if moveDistance>100 or tickCount>(3.5/ .03)or UnitHasAnyImmunityAbilityOrFlag(targetUnit) thencall DestroyLightning(leashLightning)call FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(tickTrigger)elsecall MoveLightning(leashLightning,true,anchorX,anchorY,targetX,targetY)if DistanceBetweenCoords(anchorX,anchorY,targetX,targetY)>325 thenset angle=Atan2(targetY-anchorY,targetX-anchorX)set clampedX=anchorX+(325)*Cos(angle)set clampedY=anchorY+(325)*Sin(angle)call SetUnitX(targetUnit,clampedX)call SetUnitY(targetUnit,clampedY)endifendifset tickTrigger=nullset casterUnit=nullset targetUnit=nullset leashLightning=nullreturn falseendfunctionfunction StartPounceLeash takes unit sourceUnit,unit targetUnit,integer abilityLevel returns nothinglocal trigger leashTrigger=CreateTrigger()local integer handleId=GetHandleId(leashTrigger)