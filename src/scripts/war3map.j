D)<100 thenreturnendifendifif PlayerModeFlag[GetPlayerId(firstPlayer)] and IsPlayerControlAllowed[GetPlayerId(firstPlayer)]==false and PlayerControlWarnedFlag[GetPlayerId(firstPlayer)]==0 thenset PlayerControlWarnedFlag[GetPlayerId(firstPlayer)]=1call SetPlayerState(firstPlayer,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(firstPlayer,PLAYER_STATE_RESOURCE_GOLD)-100)endifif PlayerModeFlag[GetPlayerId(secondPlayer)] and IsPlayerControlAllowed[GetPlayerId(secondPlayer)]==false and PlayerControlWarnedFlag[GetPlayerId(secondPlayer)]==0 thenset PlayerControlWarnedFlag[GetPlayerId(secondPlayer)]=1call SetPlayerState(secondPlayer,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(secondPlayer,PLAYER_STATE_RESOURCE_GOLD)-100)endifset tempMinGold=PlayerMinGold[GetPlayerId(firstPlayer)]set PlayerMinGold[GetPlayerId(firstPlayer)]=PlayerMinGold[GetPlayerId(secondPlayer)]set PlayerMinGold[GetPlayerId(secondPlayer)]=tempMinGoldcall DisableTrigger(ToggleableTrigger)if GetUnitAbilityLevel(firstHero,'A03E')>0 thenset SwapUnitFirst=firstHeroset SwapUnitSecond=secondHerocall ExecuteFunc("TransferCompanionOwnership")elseif GetUnitAbilityLevel(secondHero,'A03E')>0 thenset SwapUnitFirst=secondHeroset SwapUnitSecond=firstHerocall ExecuteFunc("TransferCompanionOwnership")endifif GetUnitAbilityLevel(firstHero,'A0CY')>0 thenset SwapUnitFirst=firstHeroset SwapUnitSecond=secondHerocall ExecuteFunc("TransferCompanionUnitOwner")elseif GetUnitAbilityLevel(secondHero,'A0CY')>0 thenset SwapUnitFirst=secondHeroset SwapUnitSecond=firstHerocall ExecuteFunc("TransferCompanionUnitOwner")endifif GetUnitAbilityLevel(firstHero,'A13T')>0 thenset SwapUnitFirst=firstHeroset SwapUnitSecond=secondHerocall ExecuteFunc("DisableWindwalkVariantAbilities")elseif GetUnitAbilityLevel(secondHero,'A13T')>0 thenset SwapUnitFirst=secondHeroset SwapUnitSecond=firstHerocall ExecuteFunc("DisableWindwalkVariantAbilities")endifcall FlushChildHashtable(GameHashtable,(800+GetPlayerId(GetOwningPlayer(firstHero))))call FlushChildHashtable(GameHashtable,(800+GetPlayerId(GetOwningPlayer(secondHero))))set tempGroup=AcquireGroupFromPool()set bj_groupEnumOwningPlayer=firstPlayercall GroupEnumUnitsInRect(tempGroup,GetWorldBounds(),filterGetUnitsInRectOfPlayer)call ForGroup(tempGroup,function EnumRemoveTaggedPlayerUnits)call ReleaseGroupToPool(tempGroup)set tempGroup=AcquireGroupFromPool()set bj_groupEnumOwningPlayer=secondPlayercall GroupEnumUnitsInRect(tempGroup,GetWorldBounds(),filterGetUnitsInRectOfPlayer)call ForGroup(tempGroup,function EnumRemoveTaggedPlayerUnits)call ReleaseGroupToPool(tempGroup)call SetUnitOwner(secondHero,firstPlayer,true)call SetUnitOwner(firstHero,secondPlayer,true)set TrackedSideUnit[GetPlayerId(firstPlayer)]=secondHeroset TrackedSideUnit[GetPlayerId(secondPlayer)]=firstHeroif IsPlayerPlayingComputer(firstPlayer)thencall SetPlayerName(firstPlayer,GetPlayerLabel(firstPlayer))elsecall SetPlayerName(firstPlayer,FormatNameWithHero(GetPlayerId(firstPlayer),TrackedSideUnit[GetPlayerId(firstPlayer)]))endifif IsPlayerPlayingComputer(secondPlayer)thencall SetPlayerName(secondPlayer,GetPlayerLabel(secondPlayer))elsecall SetPlayerName(secondPlayer,FormatNameWithHero(GetPlayerId(secondPlayer),TrackedSideUnit[GetPlayerId(secondPlayer)]))endifcall UnitAddItem(stashUnit,UnitItemInSlot(secondHero,0))call UnitAddItem(stashUnit,UnitItemInSlot(secondHero,1))call UnitAddItem(stashUnit,UnitItemInSlot(secondHero,2))call UnitAddItem(stashUnit,UnitItemInSlot(secondHero,3))call UnitAddItem(stashUnit,UnitItemInSlot(secondHero,4))call UnitAddItem(stashUnit,UnitItemInSlot(secondHero,5))set tempItem=UnitItemInSlot(firstHero,0)if tempItem!=null thencall SetItemPlayer(tempItem,firstPlayer,false)call SetItemUserData(tempItem,1)call UnitAddItem(secondHero,tempItem)endifset tempItem=UnitItemInSlot(firstHero,1)if tempItem!=null thencall SetItemPlayer(tempItem,firstPlayer,false)call SetItemUserData(tempItem,1)call UnitAddItem(secondHero,tempItem)endifset tempItem=UnitItemInSlot(firstHero,2)if tempItem!=null thencall SetItemPlayer(tempItem,firstPlayer,false)call SetItemUserData(tempItem,1)call UnitAddItem(secondHero,tempItem)endifset tempItem=UnitItemInSlot(firstHero,3)if tempItem!=null thencall SetItemPlayer(tempItem,firstPlayer,false)call SetItemUserData(tempItem,1)call UnitAddItem(secondHero,tempItem)endifset tempItem=UnitItemInSlot(firstHero,4)if tempItem!=null thencall SetItemPlayer(tempItem,firstPlayer,false)call SetItemUserData(tempItem,1)call UnitAddItem(secondHero,tempItem)endifset tempItem=UnitItemInSlot(firstHero,5)if tempItem!=null thencall SetItemPlayer(tempItem,firstPlayer,false)call SetItemUserData(tempItem,1)call UnitAddItem(secondHero,tempItem)endifset tempItem=UnitItemInSlot(stashUnit,0)if tempItem!=null thencall SetItemPlayer(tempItem,secondPlayer,false)call SetItemUserData(tempItem,1)call UnitAddItem(firstHero,tempItem)endifset tempItem=UnitItemInSlot(stashUnit,1)if tempItem!=null thencall SetItemPlayer(tempItem,secondPlayer,false)call SetItemUserData(tempItem,1)call UnitAddItem(firstHero,tempItem)endifset tempItem=UnitItemInSlot(stashUnit,2)if tempItem!=null thencall SetItemPlayer(tempItem,secondPlayer,false)call SetItemUserData(tempItem,1)call UnitAddItem(firstHero,tempItem)endifset tempItem=UnitItemInSlot(stashUnit,3)if tempItem!=null thencall SetItemPlayer(tempItem,secondPlayer,false)call SetItemUserData(tempItem,1)call UnitAddItem(firstHero,tempItem)endifset tempItem=UnitItemInSlot(stashUnit,4)if tempItem!=null thencall SetItemPlayer(tempItem,secondPlayer,false)call SetItemUserData(tempItem,1)call UnitAddItem(firstHero,tempItem)endifset tempItem=UnitItemInSlot(stashUnit,5)if tempItem!=null thencall SetItemPlayer(tempItem,secondPlayer,false)call SetItemUserData(tempItem,1)call UnitAddItem(firstHero,tempItem)endifcall RemoveUnit(stashUnit)call EnableTrigger(ToggleableTrigger)if(IsUnitType(firstHero,UNIT_TYPE_MELEE_ATTACKER) or GetUnitTypeId(firstHero)=='H06S')and UnitItemOfType(firstHero,ItemTypeId[ItemIndexCost225Melee])!=null thencall UnitRemoveItem(firstHero,UnitItemOfType(firstHero,ItemTypeId[ItemIndexCost225Melee]))elseif(IsUnitType(firstHero,UNIT_TYPE_RANGED_ATTACKER) or GetUnitTypeId(firstHero)=='H06S')and UnitItemOfType(firstHero,ItemTypeId[ItemIndexCost225Ranged])!=null thencall UnitRemoveItem(firstHero,UnitItemOfType(firstHero,ItemTypeId[ItemIndexCost225Ranged]))endifif(IsUnitType(secondHero,UNIT_TYPE_MELEE_ATTACKER) or GetUnitTypeId(firstHero)=='H06S')and UnitItemOfType(secondHero,ItemTypeId[ItemIndexCost225Melee])!=null thencall UnitRemoveItem(firstHero,UnitItemOfType(secondHero,ItemTypeId[ItemIndexCost225Melee]))elseif(IsUnitType(secondHero,UNIT_TYPE_RANGED_ATTACKER) or GetUnitTypeId(firstHero)=='H06S')and UnitItemOfType(secondHero,ItemTypeId[ItemIndexCost225Ranged])!=null thencall UnitRemoveItem(firstHero,UnitItemOfType(secondHero,ItemTypeId[ItemIndexCost225Ranged]))endifif GetUnitTypeId(firstHero)=='H06S' and UnitItemOfType(firstHero,ItemTypeId[ItemIndexCost225Ranged])!=null thencall UnitRemoveItem(firstHero,UnitItemOfType(firstHero,ItemTypeId[ItemIndexCost225Ranged]))elseif GetUnitTypeId(firstHero)=='H06S' and UnitItemOfType(firstHero,ItemTypeId[ItemIndexCost225Melee])!=null thencall UnitRemoveItem(firstHero,UnitItemOfType(firstHero,ItemTypeId[ItemIndexCost225Melee]))endifif GetUnitTypeId(secondHero)=='H06S' and UnitItemOfType(secondHero,ItemTypeId[ItemIndexCost225Ranged])!=null thencall UnitRemoveItem(secondHero,UnitItemOfType(secondHero,ItemTypeId[ItemIndexCost225Ranged]))elseif GetUnitTypeId(secondHero)=='H06S' and UnitItemOfType(secondHero,ItemTypeId[ItemIndexCost225Melee])!=null thencall UnitRemoveItem(secondHero,UnitItemOfType(secondHero,ItemTypeId[ItemIndexCost225Melee]))endifif(IsUnitType(firstHero,UNIT_TYPE_MELEE_ATTACKER))and UnitItemOfType(firstHero,ItemTypeId[ItemIndexCost550Melee])!=null thencall UnitRemoveItem(firstHero,UnitItemOfType(firstHero,ItemTypeId[ItemIndexCost550Melee]))elseif(IsUnitType(firstHero,UNIT_TYPE_RANGED_ATTACKER))and UnitItemOfType(firstHero,ItemTypeId[ItemIndexCost550Ranged])!=null thencall UnitRemoveItem(firstHero,UnitItemOfType(firstHero,ItemTypeId[ItemIndexCost550Ranged]))endifif(IsUnitType(secondHero,UNIT_TYPE_MELEE_ATTACKER))and UnitItemOfType(secondHero,ItemTypeId[ItemIndexCost550Melee])!=null thencall UnitRemoveItem(firstHero,UnitItemOfType(secondHero,ItemTypeId[ItemIndexCost550Melee]))elseif(IsUnitType(secondHero,UNIT_TYPE_RANGED_ATTACKER))and UnitItemOfType(secondHero,ItemTypeId[ItemIndexCost550Ranged])!=null thencall UnitRemoveItem(firstHero,UnitItemOfType(secondHero,ItemTypeId[ItemIndexCost550Ranged]))endifcall ClearSelectionForPlayer(firstPlayer)call SelectUnitAddForPlayer(secondHero,firstPlayer)call ClearSelectionForPlayer(secondPlayer)call SelectUnitAddForPlayer(firstHero,secondPlayer)call FlushChildHashtable(GameHashtable,(800+GetPlayerId(firstPlayer)))call FlushChildHashtable(GameHashtable,(800+GetPlayerId(secondPlayer)))set FilterReferenceUnit_2=firstHerocall ExecuteFunc("InitH00UHiddenAbilities")set FilterReferenceUnit_2=secondHerocall ExecuteFunc("InitH00UHiddenAbilities")call StoreAndSyncPlayerInteger(GetOwningPlayer(firstHero),"9",GetUnitTypeId(firstHero))call StoreAndSyncPlayerInteger(GetOwningPlayer(secondHero),"9",GetUnitTypeId(secondHero))call StoreAndSyncDataInteger("SWAP_"+I2S(GetPlayerId(GetOwningPlayer(firstHero)))+"_"+I2S(GetPlayerId(GetOwningPlayer(secondHero))),GetUnitTypeId(firstHero))call StoreAndSyncDataInteger("SWAP_"+I2S(GetPlayerId(GetOwningPlayer(secondHero)))+"_"+I2S(GetPlayerId(GetOwningPlayer(firstHero))),GetUnitTypeId(secondHero))call RefreshPlayerStockUnit(firstPlayer)call RefreshPlayerStockUnit(secondPlayer)if(GetPlayerController(secondPlayer)==MAP_CONTROL_COMPUTER)thencall StoreUnitByName(AiGameCacheKey,"AIHSwap|U",firstHero)call ExecuteFunc("ReinitSwappedHeroCombat")endifset firstPlayer=nullset secondPlayer=nullset tempGroup=nullset stashUnit=nullset tempItem=nullendfunctionfunction IsSwapReciprocated takes unit firstUnit,unit secondUnit returns booleanreturn(LoadBoolean(GameHashtable,(800+GetPlayerId(GetOwningPlayer(secondUnit))),(GetUnitTypeId(firstUnit)+GetUnitTypeId(secondUnit))))endfunctionfunction CancelPendingSwapRequests takes nothing returns nothingcall FlushChildHashtable(GameHashtable,(800+GetPlayerId(GetTriggerPlayer())))endfunctionfunction GetPlayerTeamSlotIndex takes player whichPlayer returns integerlocal integer slotIndex=1loopexitwhen slotIndex>5if SentinelPlayer[slotIndex]==whichPlayer or ScourgePlayer[slotIndex]==whichPlayer thenreturn slotIndexendifset slotIndex=slotIndex+1endloopreturn-1endfunctionfunction RequestOrExecuteHeroSwap takes unit requesterUnit,unit targetUnit,boolean showRequesterMessage returns booleancall SaveBoolean(GameHashtable,(800+GetPlayerId(GetOwningPlayer(requesterUnit))),(GetUnitTypeId(requesterUnit)+GetUnitTypeId(targetUnit)),(true))if IsSwapReciprocated(requesterUnit,targetUnit)thencall ExecuteHeroSwapBetweenPlayers(requesterUnit,targetUnit)return trueelsecall DisplayTimedTextToPlayer(GetOwningPlayer(targetUnit),0,MessageDisplayY,30,"  ")call DisplayTimedTextToPlayer(GetOwningPlayer(targetUnit),0,MessageDisplayY,30,"                         "+PlayerColorCode[GetPlayerId(GetOwningPlayer(requesterUnit))]+(PlayerName[GetPlayerId(GetOwningPlayer(requesterUnit))])+"|r |cff99ccff"+GetObjectName('n082')+" "+GetObjectName('n083')+"|r |c00ff0303-swap "+I2S(GetPlayerTeamSlotIndex(GetOwningPlayer(requesterUnit)))+"|r |cff99ccff"+GetObjectName('n081')+"|r")call DisplayTimedTextToPlayer(GetOwningPlayer(targetUnit),0,MessageDisplayY,30,"  ")if showRequesterMessage thencall DisplayTimedTextToPlayer(GetOwningPlayer(requesterUnit),0,MessageDisplayY,30,"  ")call DisplayTimedTextToPlayer(GetOwningPlayer(requesterUnit),0,MessageDisplayY,30,"|cff99ccff"+GetObjectName('n08C')+" |r"+PlayerColorCode[GetPlayerId(GetOwningPlayer(targetUnit))]+GetUnitName(targetUnit)+"|r")call DisplayTimedTextToPlayer(GetOwningPlayer(requesterUnit),0,MessageDisplayY,30,"  ")endifif(GetPlayerController(GetOwningPlayer(targetUnit))==MAP_CONTROL_USER)thencall DisplayTimedTextToPlayer(GetOwningPlayer(targetUnit),0,MessageDisplayY,30,"  ")call DisplayTimedTextToPlayer(GetOwningPlayer(targetUnit),0,MessageDisplayY,30,"                         "+PlayerColorCode[GetPlayerId(GetOwningPlayer(requesterUnit))]+(PlayerName[GetPlayerId(GetOwningPlayer(requesterUnit))])+"|r |cff99ccff"+GetObjectName('n082')+" "+GetObjectName('n083')+"|r |c00ff0303-swap "+I2S(GetPlayerTeamSlotIndex(GetOwningPlayer(requesterUnit)))+"|r |cff99ccff"+GetObjectName('n081')+"|r")call DisplayTimedTextToPlayer(GetOwningPlayer(targetUnit),0,MessageDisplayY,30,"  ")elseif(GetHeroSkillPoints(requesterUnit)!=GetHeroLevel(requesterUnit))thencall DisplayTimedTextToPlayer(GetOwningPlayer(requesterUnit),0,MessageDisplayY,10,"                |cff99ccffRequest to swap with |r"+PlayerColorCode[GetPlayerId(GetOwningPlayer(targetUnit))]+GetUnitName(targetUnit)+"|r rejected because you used a skill point")elseif(ElapsedGameSeconds>TimeThresholdSeconds)thencall DisplayTimedTextToPlayer(GetOwningPlayer(requesterUnit),0,MessageDisplayY,10,"                |cff99ccffRequest to swap with |r"+PlayerColorCode[GetPlayerId(GetOwningPlayer(targetUnit))]+GetUnitName(targetUnit)+"|r rejected because it is too late")elseif((PlayerItemGoldWorth[GetPlayerId(GetOwningPlayer(targetUnit))]>0)or(not IsInventoryEmpty(targetUnit)))thencall DisplayTimedTextToPlayer(GetOwningPlayer(requesterUnit),0,MessageDisplayY,10,"                |cff99ccffRequest to swap with |r"+PlayerColorCode[GetPlayerId(GetOwningPlayer(targetUnit))]+GetUnitName(targetUnit)+"|r rejected because it already started its item build")elseif(not IsInventoryEmpty(requesterUnit))thencall DisplayTimedTextToPlayer(GetOwningPlayer(requesterUnit),0,MessageDisplayY,10,"                |cff99ccffRequest to swap with |r"+PlayerColorCode[GetPlayerId(GetOwningPlayer(targetUnit))]+GetUnitName(targetUnit)+"|r rejected because you have an item")elsecall ExecuteHeroSwapBetweenPlayers(requesterUnit,targetUnit)endifendifendifreturn falseendfunctionfunction HandleSwapWithSlotCommand takes nothing returns nothinglocal integer slotIndex=S2I(SubString(GetEventPlayerChatString(),6,StringLength(GetEventPlayerChatString())))if GetEventPlayerChatString()=="-swapall" thenset slotIndex=1set FilterReferenceUnitB=TrackedSideUnit[GetPlayerId(GetTriggerPlayer())]loopexitwhen slotIndex>5if IsPlayerOnTeamZero(GetTriggerPlayer())thenset ItemOwnerPlayer_2=SentinelPlayer[slotIndex]elseset ItemOwnerPlayer_2=ScourgePlayer[slotIndex]endifset FilterReferenceUnit_2=TrackedSideUnit[GetPlayerId(ItemOwnerPlayer_2)]if not(FilterReferenceUnitB==null or GetOwningPlayer(FilterReferenceUnitB)!=GetTriggerPlayer()or FilterReferenceUnit_2==null or GetOwningPlayer(FilterReferenceUnit_2)!=ItemOwnerPlayer_2 or ItemOwnerPlayer_2==GetTriggerPlayer())thenif RequestOrExecuteHeroSwap(FilterReferenceUnitB,FilterReferenceUnit_2,false)thenreturnendifendifset slotIndex=slotIndex+1endloopreturnelseif slotIndex<1 or slotIndex>5 thencall ShowErrorMessageToPlayer(GetTriggerPlayer(),GetObjectName('n02Z'))returnendifset FilterReferenceUnitB=TrackedSideUnit[GetPlayerId(GetTriggerPlayer())]if IsPlayerOnTeamZero(GetTriggerPlayer())thenset ItemOwnerPlayer_2=SentinelPlayer[slotIndex]elseset ItemOwnerPlayer_2=ScourgePlayer[slotIndex]endifset FilterReferenceUnit_2=TrackedSideUnit[GetPlayerId(ItemOwnerPlayer_2)]if FilterReferenceUnitB==null or GetOwningPlayer(FilterReferenceUnitB)!=GetTriggerPlayer()or FilterReferenceUnit_2==null or GetOwningPlayer(FilterReferenceUnit_2)!=ItemOwnerPlayer_2 or ItemOwnerPlayer_2==GetTriggerPlayer()thencall ShowErrorMessageToPlayer(GetTriggerPlayer(),GetObjectName('n02Z'))returnendifcall RequestOrExecuteHeroSwap(FilterReferenceUnitB,FilterReferenceUnit_2,true)endfunctionfunction DisplaySwapHeroMenu takes nothing returns nothinglocal integer slotIndexlocal player listedPlayerlocal unit listedUnitlocal string suffixTextif GetLocalPlayer()==GetTriggerPlayer()thencall ClearTextMessages()endifcall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,45,"|cff99ccff"+GetObjectName('n08B')+":|r")call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,45," ")set slotIndex=1loopexitwhen slotIndex>5set listedPlayer=SentinelPlayer[slotIndex]set listedUnit=TrackedSideUnit[GetPlayerId(listedPlayer)]if IsPlayerAlly(GetTriggerPlayer(),listedPlayer)and GetTriggerPlayer()!=listedPlayer and listedUnit!=null and GetOwningPlayer(listedUnit)==listedPlayer thenset suffixText=" "if IsSwapReciprocated(TrackedSideUnit[GetPlayerId(GetTriggerPlayer())],listedUnit)thenset suffixText=" |c00ff0303("+GetObjectName('n085')+")|r"endifcall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,45,PlayerColorCode[GetPlayerId(listedPlayer)]+I2S(slotIndex)+"|r"+" - "+"|cff99ccff"+GetUnitName(listedUnit)+"|r"+suffixText)endifset listedPlayer=ScourgePlayer[slotIndex]set listedUnit=TrackedSideUnit[GetPlayerId(listedPlayer)]if IsPlayerAlly(GetTriggerPlayer(),listedPlayer)and GetTriggerPlayer()!=listedPlayer and listedUnit!=null and GetOwningPlayer(listedUnit)==listedPlayer thenset suffixText=" "if IsSwapReciprocated(TrackedSideUnit[GetPlayerId(GetTriggerPlayer())],listedUnit)thenset suffixText=" |c00ff0303("+GetObjectName('n085')+")|r"endifcall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,45,PlayerColorCode[GetPlayerId(listedPlayer)]+I2S(slotIndex)+"|r"+" - "+"|cff99ccff"+GetUnitName(listedUnit)+"|r"+suffixText)endifset slotIndex=slotIndex+1endloopcall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,45," ")call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,45,"|cff99ccff"+GetObjectName('n083')+"|r |c00ff0303-swap #|r |cff99ccff"+GetObjectName('n086')+" -swapcancel "+GetObjectName('n087')+"|r")call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,45," ")endfunctionfunction HasLevelOneAllyToSwap takes player whichPlayer returns booleanlocal integer slotIndex=1local integer levelOneAllyCount=0loopexitwhen slotIndex>5if IsPlayerOnTeamZero(whichPlayer)thenif TrackedSideUnit[GetPlayerId(SentinelPlayer[slotIndex])]!=null and SentinelPlayer[slotIndex]!=whichPlayer and GetHeroLevel(TrackedSideUnit[GetPlayerId(SentinelPlayer[slotIndex])])==1 thenset levelOneAllyCount=levelOneAllyCount+1endifelseif TrackedSideUnit[GetPlayerId(ScourgePlayer[slotIndex])]!=null and ScourgePlayer[slotIndex]!=whichPlayer and GetHeroLevel(TrackedSideUnit[GetPlayerId(ScourgePlayer[slotIndex])])==1 thenset levelOneAllyCount=levelOneAllyCount+1endifendifset slotIndex=slotIndex+1endloopif levelOneAllyCount>0 thenreturn trueelsereturn falseendifendfunctionfunction CanRequestHeroSwap takes nothing returns booleanif OneTimeInitFlagPG4 thencall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10,"-swaphero "+(GetObjectName(('n088'))))return falseendifif PlayerModeFlag[GetPlayerId(GetTriggerPlayer())] thenif GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD)<100 thencall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10,GetObjectName('N0MT'))return falseendifendifif GetUnitState(TrackedSideUnit[GetPlayerId(GetTriggerPlayer())],UNIT_STATE_LIFE)<1 thencall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10,(GetObjectName(('n08F'))))return falseendifif OneTimeEventFlag thencall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10,(GetObjectName(('n08G')))+" -swaphero.")return falseendifif HasLevelOneAllyToSwap(GetTriggerPlayer())==false thencall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10,(GetObjectName(('n08H'))))return falseendifreturn trueendfunctionfunction OnSwapChatCommand takes nothing returns nothingif CanRequestHeroSwap()thenif GetEventPlayerChatString()=="-swap"or GetEventPlayerChatString()=="-swaphero"thencall DisplaySwapHeroMenu()elseif GetEventPlayerChatString()=="-swapcancel"thencall CancelPendingSwapRequests()elsecall HandleSwapWithSlotCommand()endifendifendfunctionfunction IsMorphSwapAbilityCast takes nothing returns booleanreturn GetSpellAbilityId()=='A0FI'endfunctionfunction CopyAbilityLevelsToHero takes integer abilityId,unit sourceHero,unit targetHero returns nothinglocal integer levelIndex=1local integer sourceLevel=GetUnitAbilityLevel(sourceHero,abilityId)loopexitwhen levelIndex>sourceLevelcall SelectHeroSkill(targetHero,abilityId)set levelIndex=levelIndex+1endloopendfunctionfunction CloneAndReplaceMorphHero takes nothing returns nothinglocal integer loopIndexlocal integer loopMaxlocal unit cloneUnitlocal location heroLoc=GetUnitLoc(GetTriggerUnit())set cloneUnit=CreateUnitAtLoc(GetOwningPlayer(GetTriggerUnit()),GetUnitTypeId(GetTriggerUnit()),heroLoc,bj_UNIT_FACING)call SetHeroXP(cloneUnit,GetHeroXP(GetTriggerUnit()),false)set loopIndex=1set loopMax=GetUnitAbilityLevel(GetTriggerUnit(),'Aamk')loopexitwhen loopIndex>loopMaxcall SelectHeroSkill(bj_lastCreatedUnit,'Aamk')set loopIndex=loopIndex+1endloopset loopIndex=0set loopMax=5loopexitwhen loopIndex>loopMaxcall UnitAddItem(cloneUnit,UnitItemInSlot(GetTriggerUnit(),loopIndex))set loopIndex=loopIndex+1endloopif(GetUnitTypeId(GetTriggerUnit())=='Eevi')thencall CopyAbilityLevelsToHero('A04L',GetTriggerUnit(),cloneUnit)call CopyAbilityLevelsToHero('A0H4',GetTriggerUnit(),cloneUnit)call CopyAbilityLevelsToHero('AEvi',GetTriggerUnit(),cloneUnit)call CopyAbilityLevelsToHero('A07Q',GetTriggerUnit(),cloneUnit)endifif(GetUnitTypeId(GetTriggerUnit())=='U008')thencall CopyAbilityLevelsToHero('A03D',GetTriggerUnit(),cloneUnit)call CopyAbilityLevelsToHero('A02G',GetTriggerUnit(),cloneUnit)call CopyAbilityLevelsToHero('A03E',GetTriggerUnit(),cloneUnit)call CopyAbilityLevelsToHero('A093',GetTriggerUnit(),cloneUnit)endifif(GetUnitTypeId(GetTriggerUnit())=='U007')thencall CopyAbilityLevelsToHero('A0F9',GetTriggerUnit(),cloneUnit)call CopyAbilityLevelsToHero('A06Y',GetTriggerUnit(),cloneUnit)call CopyAbilityLevelsToHero('A01E',GetTriggerUnit(),cloneUnit)call CopyAbilityLevelsToHero('A028',GetTriggerUnit(),cloneUnit)endifif(GetUnitTypeId(GetTriggerUnit())=='Hlgr')thencall CopyAbilityLevelsToHero('A03G',GetTriggerUnit(),cloneUnit)call CopyAbilityLevelsToHero('A03F',GetTriggerUnit(),cloneUnit)call CopyAbilityLevelsToHero('A0O3',GetTriggerUnit(),cloneUnit)call CopyAbilityLevelsToHero('AEim',GetTriggerUnit(),cloneUnit)endifif(GetUnitTypeId(GetTriggerUnit())=='Ekee')thencall CopyAbilityLevelsToHero('A035',GetTriggerUnit(),cloneUnit)call CopyAbilityLevelsToHero('A06W',GetTriggerUnit(),cloneUnit)call CopyAbilityLevelsToHero('A06V',GetTriggerUnit(),cloneUnit)call CopyAbilityLevelsToHero('A06X',GetTriggerUnit(),cloneUnit)endifcall RemoveUnitAndFlushData(GetTriggerUnit())call RemoveLocation(heroLoc)set TrackedSideUnit[GetPlayerId(GetOwningPlayer(cloneUnit))]=cloneUnitset heroLoc=nullset cloneUnit=nullendfunctionfunction IsMorphHeroInBase takes nothing returns booleanlocal integer heroTypeId=GetUnitTypeId(TrackedSideUnit[GetPlayerId(GetTriggerPlayer())])return(heroTypeId=='U008' or heroTypeId=='U007' or heroTypeId=='Hlgr' or heroTypeId=='Eevi' or heroTypeId=='Ekee')and(RectContainsUnit(TeamOneStashRect,TrackedSideUnit[GetPlayerId(GetTriggerPlayer())])or RectContainsUnit(TeamTwoStashRect,TrackedSideUnit[GetPlayerId(GetTriggerPlayer())]))endfunctionfunction CastHeroMorphSwapAbility takes nothing returns nothinglocal unit heroUnit=TrackedSideUnit[GetPlayerId(GetTriggerPlayer())]call UnitAddAbility(heroUnit,'A0FI')call IssueImmediateOrderById(heroUnit,852663)call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,120.,"|c00ff0303"+(GetObjectName(('n08I')))+" "+GetHeroNameByPointValue(GetEnumUnit())+". "+(GetObjectName(('n08J')))+"|r")endfunctionfunction OnMorphHeroSwapCommand takes nothing returns nothingif IsMorphHeroInBase()thencall CastHeroMorphSwapAbility()endifendfunctionfunction ReturnHeroToBaseOnDeathOrTimeout takes nothing returns booleanlocal trigger eventTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(eventTrigger)local unit heroUnit=(LoadUnitHandle(GameHashtable,(triggerId),(14)))local integer evalCount=GetTriggerEvalCount(eventTrigger)local real baseXlocal real baseYif GetTriggerEventId()==EVENT_UNIT_DEATH or evalCount>60 thenif((LoadInteger(GameHashtable,(GetHandleId((heroUnit))),((4259))))==1)==false thenif IsPlayerOnTeamZero(GetOwningPlayer(heroUnit))thenset baseX=GetRectCenterX(BaseCenterRectB)set baseY=GetRectCenterY(BaseCenterRectB)elseset baseX=GetRectCenterX(BaseCenterRectA)set baseY=GetRectCenterY(BaseCenterRectA)endifcall SetUnitPosition(heroUnit,baseX,baseY)call PauseUnit(heroUnit,false)endifcall FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(eventTrigger)elsecall PauseUnit(heroUnit,true)endifset eventTrigger=nullset heroUnit=nullreturn falseendfunctionfunction PrepareHeroReturnToBase takes player whichPlayer returns nothinglocal unit hero=TrackedSideUnit[GetPlayerId(whichPlayer)]local trigger returnTriggerif IsUnitDeadOrInvalid(hero)==false thenset returnTrigger=CreateTrigger()call DisplayTimedTextToPlayer(whichPlayer,0,MessageDisplayY,30.,(GetObjectName(('n08K'))))call UnitRemoveBuffs(hero,true,false)call UnitRemoveAbility(hero,'Bcyc')call UnitRemoveAbility(hero,'Bcy2')call UnitRemoveAbility(hero,'B02J')call UnitRemoveAbility(hero,'BUsp')call UnitRemoveAbility(hero,'Bust')call UnitRemoveAbility(hero,'B02F')call PauseUnit(hero,true)call TriggerRegisterTimerEvent(returnTrigger,1.,true)call TriggerRegisterUnitEvent(returnTrigger,hero,EVENT_UNIT_DEATH)call TriggerAddCondition(returnTrigger,Condition(function ReturnHeroToBaseOnDeathOrTimeout))call SaveUnitHandle(GameHashtable,(GetHandleId(returnTrigger)),(14),(hero))endifset whichPlayer=nullset hero=nullset returnTrigger=nullendfunctionfunction OnReturnHomeGraceExpire takes nothing returns booleanlocal trigger graceTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(graceTrigger)local player whichPlayer=(LoadPlayerHandle(GameHashtable,(handleId),(54)))call FlushChildHashtable(GameHashtable,handleId)call RecycleExpiringTrigger(graceTrigger)if GetTriggerEventId()!=EVENT_UNIT_DAMAGED thencall PrepareHeroReturnToBase(whichPlayer)endifset graceTrigger=nullreturn falseendfunctionfunction StartReturnHomeCountdown takes nothing returns nothinglocal player whichPlayer=GetTriggerPlayer()local unit hero=TrackedSideUnit[GetPlayerId(whichPlayer)]local trigger countdownTriggerif IsUnitDeadOrInvalid(hero)==false thenset countdownTrigger=CreateTrigger()call TriggerRegisterTimerEvent(countdownTrigger,3.5,false)call TriggerRegisterUnitEvent(countdownTrigger,hero,EVENT_UNIT_DAMAGED)call TriggerAddCondition(countdownTrigger,Condition(function OnReturnHomeGraceExpire))call SavePlayerHandle(GameHashtable,(GetHandleId(countdownTrigger)),(54),(whichPlayer))endifset whichPlayer=nullset hero=nullset countdownTrigger=nullendfunctionfunction ForceHeroReturnToBase takes player whichPlayer returns nothinglocal unit hero=TrackedSideUnit[GetPlayerId(whichPlayer)]local trigger returnTriggerif IsUnitDeadOrInvalid(hero)==false thenset returnTrigger=CreateTrigger()call DisplayTimedTextToPlayer(whichPlayer,0,MessageDisplayY,30.0,GetObjectName('n08K'))call UnitRemoveBuffs(hero,true,false)call UnitRemoveAbility(hero,'Bcyc')call UnitRemoveAbility(hero,'Bcy2')call UnitRemoveAbility(hero,'B02J')call UnitRemoveAbility(hero,'BUsp')call UnitRemoveAbility(hero,'Bust')call UnitRemoveAbility(hero,'B02F')call PauseUnit(hero,true)call TriggerRegisterTimerEvent(returnTrigger,1.,true)call TriggerRegisterUnitEvent(returnTrigger,hero,EVENT_UNIT_DEATH)call TriggerAddCondition(returnTrigger,Condition(function ReturnHeroToBaseOnDeathOrTimeout))call SaveUnitHandle(GameHashtable,(GetHandleId(returnTrigger)),(14),(hero))endifset whichPlayer=nullset hero=nullset returnTrigger=nullendfunctionfunction HandleForcePlayerReturnHomeCommand takes nothing returns nothinglocal string chatString=GetEventPlayerChatString()local player targetPlayer=PlayerFromSlotIndex(S2I(SubString(chatString,10,StringLength(chatString))))if((targetPlayer!=null)and(IsPlayerSlotActive(targetPlayer))and(IsPlayerInForce(targetPlayer,RegisteredHeroPlayersForce)))thenif(TrackedSideUnit[GetPlayerId(targetPlayer)]==null)thencall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,PlayerColorCode[GetPlayerId(targetPlayer)]+GetPlayerName(targetPlayer)+"|r has no Hero")elsecall ForceHeroReturnToBase(targetPlayer)endifendifset targetPlayer=nullendfunctionfunction FormatHeroLocationTag takes player whichPlayer returns stringlocal string statusText=PlayerBoardStatusText[GetPlayerId(whichPlayer)]if PlayerBoardStatusText[GetPlayerId(whichPlayer)]!="Here" thenreturn" |c00ff0303("+(GetObjectName(('n089')))+" at "+SubString(statusText,10,StringLength(statusText))+"|c00ff0303)|r"endifreturn" "endfunctionfunction DisplayAlliedHeroRoster takes nothing returns nothinglocal integer slotIndex=1local integer maxSlot=5local integer playerIdcall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,20," ")if(IsPlayerOnTeamOne(GetTriggerPlayer()))thenloopexitwhen slotIndex>maxSlotset playerId=GetPlayerId(SentinelPlayer[slotIndex])if(TrackedSideUnit[playerId]!=null)thencall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,20,PlayerColorCode[playerId]+(PlayerName[GetPlayerId((SentinelPlayer[slotIndex]))])+"|r "+(GetObjectName(('n08M')))+" "+GetUnitName(TrackedSideUnit[playerId])+" ("+(GetObjectName(('n08L')))+" "+I2S(GetUnitLevel(TrackedSideUnit[playerId]))+")"+FormatHeroLocationTag(SentinelPlayer[slotIndex]))endifset slotIndex=slotIndex+1endloopelseloopexitwhen slotIndex>maxSlotset playerId=GetPlayerId(ScourgePlayer[slotIndex])if(TrackedSideUnit[playerId]!=null)thencall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,20,PlayerColorCode[playerId]+(PlayerName[GetPlayerId((ScourgePlayer[slotIndex]))])+"|r "+(GetObjectName(('n08M')))+" "+GetUnitName(TrackedSideUnit[playerId])+" ("+(GetObjectName(('n08L')))+" "+I2S(GetUnitLevel(TrackedSideUnit[playerId]))+")"+FormatHeroLocationTag(ScourgePlayer[slotIndex]))endifset slotIndex=slotIndex+1endloopendifcall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,20," ")endfunctionfunction IsHeroWithSecondaryUnit takes unit whichUnit returns booleanreturn GetUnitTypeId(whichUnit)=='N01O' or GetUnitTypeId(whichUnit)=='N013' or GetUnitTypeId(whichUnit)=='N014' or GetUnitTypeId(whichUnit)=='N015'endfunctionfunction GetPlayerStoredPetUnit takes unit whichUnit returns unitlocal integer ownerHandleId=GetHandleId(GetOwningPlayer(whichUnit))return(LoadUnitHandle(GameHashtable,(ownerHandleId),(333)))endfunctionfunction DisplayHeroMoveSpeed takes nothing returns nothinglocal unit petUnitlocal integer unusedIndex=0if ModeEnabledFlag_2 thenreturnendifif(TrackedSideUnit[GetPlayerId(GetTriggerPlayer())]==null)thencall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10.,(GetObjectName(('n08A'))))elsecall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10.00,GetUnitName(TrackedSideUnit[GetPlayerId(GetTriggerPlayer())])+" "+GetObjectName('n08N')+" "+I2S(R2I(0.5+GetEffectiveMoveSpeed(TrackedSideUnit[GetPlayerId(GetTriggerPlayer())]))))if IsHeroWithSecondaryUnit(TrackedSideUnit[GetPlayerId(GetTriggerPlayer())])thenset petUnit=GetPlayerStoredPetUnit(TrackedSideUnit[GetPlayerId(GetTriggerPlayer())])if petUnit!=null thencall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10.,GetUnitName(petUnit)+" "+(GetObjectName(('n08N')))+" "+I2S(R2I(.5+GetUnitMoveSpeed(petUnit))))endifendifendifendfunctionfunction DisplayAlliedMoveSpeeds takes nothing returns nothinglocal unit alliedUnitlocal integer playerIndex=0if ModeEnabledFlag_2 thenreturnendifif(TrackedSideUnit[GetPlayerId(GetTriggerPlayer())]==null)thencall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10.,(GetObjectName(('n08A'))))elsecall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10.00,GetUnitName(TrackedSideUnit[GetPlayerId(GetTriggerPlayer())])+" "+GetObjectName('n08N')+" "+I2S(R2I(0.5+GetEffectiveMoveSpeed(TrackedSideUnit[GetPlayerId(GetTriggerPlayer())]))))if IsHeroWithSecondaryUnit(TrackedSideUnit[GetPlayerId(GetTriggerPlayer())])thenset alliedUnit=GetPlayerStoredPetUnit(TrackedSideUnit[GetPlayerId(GetTriggerPlayer())])if alliedUnit!=null thencall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10.,GetUnitName(alliedUnit)+" "+GetObjectName('n08N')+" "+I2S(R2I(.5+GetUnitMoveSpeed(alliedUnit))))endifendifendifloopexitwhen playerIndex>16set alliedUnit=TrackedSideUnit[playerIndex]if alliedUnit!=null and alliedUnit!=TrackedSideUnit[GetPlayerId(GetTriggerPlayer())]and IsUnitAlly(alliedUnit,GetTriggerPlayer()) thencall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10.,GetUnitName(alliedUnit)+" "+GetObjectName('n08N')+" "+I2S(R2I(.5+GetUnitMoveSpeed(alliedUnit))))endifset playerIndex=playerIndex+1endloopendfunctionfunction EnablePlayerFlag139 takes nothing returns nothingcall SaveBoolean(GameHashtable,(GetHandleId(GetTriggerPlayer())),(139),(true))call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10,(GetObjectName(('n08R'))))endfunctionfunction DisablePlayerFlag139 takes nothing returns nothingcall SaveBoolean(GameHashtable,(GetHandleId(GetTriggerPlayer())),(139),(false))call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10,(GetObjectName(('n08O'))))endfunctionfunction DisplayPlayerFarmStats takes nothing returns nothingcall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10.,"   "+(GetObjectName(('n08P')))+" "+I2S(PlayerKillCount[GetPlayerId(GetTriggerPlayer())])+" "+(GetObjectName(('n08Q')))+" "+I2S(PlayerDenyCount[GetPlayerId(GetTriggerPlayer())])+" "+(GetObjectName(('n08S')))+" "+I2S(PlayerNeutralKillCount[GetPlayerId(GetTriggerPlayer())]))endfunctionfunction HandleCreepStatsOnCommand takes nothing returns nothinglocal integer playerId=GetPlayerId(GetTriggerPlayer())if(GetEventPlayerChatString()=="-cson")thenset PlayerActiveFlag[playerId]=trueset PlayerViewFlag[playerId]=trueelseset PlayerActiveFlag[playerId]=falseset PlayerViewFlag[playerId]=falseendifcall NoOp()endfunctionfunction CenterCameraOnHeroTick takes nothing returns booleanlocal trigger tickTrigger=GetTriggeringTrigger()local integer timerId=GetHandleId(tickTrigger)local integer playerIndex=(LoadInteger(GameHashtable,(timerId),(34)))local real heroXlocal real heroYif PlayerCameraCentered[playerIndex]==false thencall FlushChildHashtable(GameHashtable,(timerId))call RecycleExpiringTrigger(tickTrigger)elseif TrackedSideUnit[playerIndex]!=null and IsUnitDeadOrInvalid(TrackedSideUnit[playerIndex])==false thenset heroX=GetUnitX(TrackedSideUnit[playerIndex])set heroY=GetUnitY(TrackedSideUnit[playerIndex])call PanCameraToTimedForPlayer(Player(playerIndex),heroX,heroY,0)endifset tickTrigger=nullreturn falseendfunctionfunction HandleCenterCameraCommand takes nothing returns nothinglocal integer playerId=GetPlayerId(GetTriggerPlayer())local trigger centerTriggerlocal integer handleIdlocal integer tempIndexif PlayerCameraCentered[playerId]==false and(GetEventPlayerChatString()=="-center" or GetEventPlayerChatString()=="-c")thenset PlayerCameraCentered[playerId]=trueset centerTrigger=CreateTrigger()set handleId=GetHandleId(centerTrigger)call TriggerRegisterTimerEvent(centerTrigger,.01,true)call TriggerAddCondition(centerTrigger,Condition(function CenterCameraOnHeroTick))call SaveInteger(GameHashtable,(handleId),(34),(playerId))call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10,GetObjectName('n0JW'))elseif GetEventPlayerChatString()=="-centeroff" or GetEventPlayerChatString()=="-co" thencall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10,GetObjectName('n0JX'))set PlayerCameraCentered[playerId]=falseendifendfunctionfunction DisablePlayerAbFlag takes nothing returns nothingset PlayerToggleAb[GetPlayerId(GetTriggerPlayer())]=falsecall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,5,GetObjectName('n0JZ'))endfunctionfunction EnablePlayerAbFlag takes nothing returns nothingset PlayerToggleAb[GetPlayerId(GetTriggerPlayer())]=truecall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,5,GetObjectName('n0K0'))endfunctionfunction UpdateRespawnLeaderboards takes nothing returns nothinglocal integer slotIndex=1local integer secondsRemaininglocal integer playerIdloopexitwhen slotIndex>5set playerId=GetPlayerId(SentinelPlayer[slotIndex])set secondsRemaining=R2I(TimerGetRemaining(PlayerRespawnTimer[playerId]))if secondsRemaining>0 and PlayerModeVoteEnabled[playerId]and ModeSelectionAppliedFlag==false and ModeSelectionLocked==false thencall PlayerSetLeaderboard(SentinelPlayer[slotIndex],TeamLeaderboard[playerId])call LeaderboardDisplay(TeamLeaderboard[playerId],true)call LeaderboardSetLabel(TeamLeaderboard[playerId],"   "+GetObjectName('n08V')+" "+I2S(secondsRemaining)+" "+GetObjectName('n095'))elsecall LeaderboardDisplay(TeamLeaderboard[playerId],false)endifset playerId=GetPlayerId(ScourgePlayer[slotIndex])set secondsRemaining=R2I(TimerGetRemaining(PlayerRespawnTimer[playerId]))if secondsRemaining>0 and PlayerModeVoteEnabled[playerId]and ModeSelectionAppliedFlag==false and ModeSelectionLocked==false thencall PlayerSetLeaderboard(ScourgePlayer[slotIndex],TeamLeaderboard[playerId])call LeaderboardDisplay(TeamLeaderboard[playerId],true)call LeaderboardSetLabel(TeamLeaderboard[playerId],"   "+GetObjectName('n08V')+" "+I2S(secondsRemaining)+" "+GetObjectName('n095'))elsecall LeaderboardDisplay(TeamLeaderboard[playerId],false)endifset slotIndex=slotIndex+1endloopendfunctionfunction CreateRespawnLeaderboards takes nothing returns nothinglocal integer playerSlot=0set playerSlot=playerSlot+1set TeamLeaderboard[GetPlayerId(SentinelPlayer[playerSlot])]=CreateLeaderboard()call PlayerSetLeaderboard(SentinelPlayer[playerSlot],TeamLeaderboard[GetPlayerId(SentinelPlayer[playerSlot])])call LeaderboardDisplay(TeamLeaderboard[GetPlayerId(SentinelPlayer[playerSlot])],false)call LeaderboardSetLabel(TeamLeaderboard[GetPlayerId(SentinelPlayer[playerSlot])],GetObjectName('n0E4')+": ")set TeamLeaderboard[GetPlayerId(ScourgePlayer[playerSlot])]=CreateLeaderboard()call PlayerSetLeaderboard(ScourgePlayer[playerSlot],TeamLeaderboard[GetPlayerId(ScourgePlayer[playerSlot])])call LeaderboardDisplay(TeamLeaderboard[GetPlayerId(ScourgePlayer[playerSlot])],false)call LeaderboardSetLabel(TeamLeaderboard[GetPlayerId(ScourgePlayer[playerSlot])],GetObjectName('n0E4')+": ")set playerSlot=playerSlot+1set TeamLeaderboard[GetPlayerId(SentinelPlayer[playerSlot])]=CreateLeaderboard()call PlayerSetLeaderboard(SentinelPlayer[playerSlot],TeamLeaderboard[GetPlayerId(SentinelPlayer[playerSlot])])call LeaderboardDisplay(TeamLeaderboard[GetPlayerId(SentinelPlayer[playerSlot])],false)call LeaderboardSetLabel(TeamLeaderboard[GetPlayerId(SentinelPlayer[playerSlot])],GetObjectName('n0E4')+": ")set TeamLeaderboard[GetPlayerId(ScourgePlayer[playerSlot])]=CreateLeaderboard()call PlayerSetLeaderboard(ScourgePlayer[playerSlot],TeamLeaderboard[GetPlayerId(ScourgePlayer[playerSlot])])call LeaderboardDisplay(TeamLeaderboard[GetPlayerId(ScourgePlayer[playerSlot])],false)call LeaderboardSetLabel(TeamLeaderboard[GetPlayerId(ScourgePlayer[playerSlot])],GetObjectName('n0E4')+": ")set playerSlot=playerSlot+1set TeamLeaderboard[GetPlayerId(SentinelPlayer[playerSlot])]=CreateLeaderboard()call PlayerSetLeaderboard(SentinelPlayer[playerSlot],TeamLeaderboard[GetPlayerId(SentinelPlayer[playerSlot])])call LeaderboardDisplay(TeamLeaderboard[GetPlayerId(SentinelPlayer[playerSlot])],false)call LeaderboardSetLabel(TeamLeaderboard[GetPlayerId(SentinelPlayer[playerSlot])],GetObjectName('n0E4')+": ")set TeamLeaderboard[GetPlayerId(ScourgePlayer[playerSlot])]=CreateLeaderboard()call PlayerSetLeaderboard(ScourgePlayer[playerSlot],TeamLeaderboard[GetPlayerId(ScourgePlayer[playerSlot])])call LeaderboardDisplay(TeamLeaderboard[GetPlayerId(ScourgePlayer[playerSlot])],false)call LeaderboardSetLabel(TeamLeaderboard[GetPlayerId(ScourgePlayer[playerSlot])],GetObjectName('n0E4')+": ")set playerSlot=playerSlot+1set TeamLeaderboard[GetPlayerId(SentinelPlayer[playerSlot])]=CreateLeaderboard()call PlayerSetLeaderboard(SentinelPlayer[playerSlot],TeamLeaderboard[GetPlayerId(SentinelPlayer[playerSlot])])call LeaderboardDisplay(TeamLeaderboard[GetPlayerId(SentinelPlayer[playerSlot])],false)call LeaderboardSetLabel(TeamLeaderboard[GetPlayerId(SentinelPlayer[playerSlot])],GetObjectName('n0E4')+": ")set TeamLeaderboard[GetPlayerId(ScourgePlayer[playerSlot])]=CreateLeaderboard()call PlayerSetLeaderboard(ScourgePlayer[playerSlot],TeamLeaderboard[GetPlayerId(ScourgePlayer[playerSlot])])call LeaderboardDisplay(TeamLeaderboard[GetPlayerId(ScourgePlayer[playerSlot])],false)call LeaderboardSetLabel(TeamLeaderboard[GetPlayerId(ScourgePlayer[playerSlot])],GetObjectName('n0E4')+": ")set playerSlot=playerSlot+1set TeamLeaderboard[GetPlayerId(SentinelPlayer[playerSlot])]=CreateLeaderboard()call PlayerSetLeaderboard(SentinelPlayer[playerSlot],TeamLeaderboard[GetPlayerId(SentinelPlayer[playerSlot])])call LeaderboardDisplay(TeamLeaderboard[GetPlayerId(SentinelPlayer[playerSlot])],false)call LeaderboardSetLabel(TeamLeaderboard[GetPlayerId(SentinelPlayer[playerSlot])],GetObjectName('n0E4')+": ")set TeamLeaderboard[GetPlayerId(ScourgePlayer[playerSlot])]=CreateLeaderboard()call PlayerSetLeaderboard(ScourgePlayer[playerSlot],TeamLeaderboard[GetPlayerId(ScourgePlayer[playerSlot])])call LeaderboardDisplay(TeamLeaderboard[GetPlayerId(ScourgePlayer[playerSlot])],false)call LeaderboardSetLabel(TeamLeaderboard[GetPlayerId(ScourgePlayer[playerSlot])],GetObjectName('n0E4')+": ")endfunctionfunction HandleDeathTimerToggleCommand takes nothing returns nothinglocal integer playerId=GetPlayerId(GetTriggerPlayer())if GetEventPlayerChatString()=="-don" or GetEventPlayerChatString()=="-deathon" thenset PlayerModeVoteEnabled[playerId]=truecall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10,(GetObjectName(('n08W'))))elseset PlayerModeVoteEnabled[playerId]=falsecall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10,(GetObjectName(('n08X'))))endifendfunctionfunction InitRespawnLeaderboardTimers takes nothing returns nothinglocal trigger whichTrigger=CreateTrigger()call TriggerAddAction(whichTrigger,function CreateRespawnLeaderboards)call TriggerRegisterTimerEvent(whichTrigger,.5,false)set whichTrigger=CreateTrigger()call TriggerAddAction(whichTrigger,function UpdateRespawnLeaderboards)call TriggerRegisterTimerEvent(whichTrigger,1.,true)endfunctionfunction HandleShowDenyCommand takes nothing returns nothingif(GetEventPlayerChatString()=="-showdeny")thenset PlayerViewFlag[GetPlayerId(GetTriggerPlayer())]=trueelseset PlayerViewFlag[GetPlayerId(GetTriggerPlayer())]=falseendifendfunctionfunction ShowChatCommandErrorMessage takes nothing returns nothingcall ShowErrorMessageToPlayer(GetTriggerPlayer(),(GetObjectName(('n0HG'))))endfunctionfunction EnableCreepStatsForAllPlayers takes nothing returns nothinglocal integer playerIndex=0loopexitwhen playerIndex>16set PlayerViewFlag[playerIndex]=trueset PlayerActiveFlag[playerIndex]=trueset playerIndex=playerIndex+1endloopendfunctionfunction LeaveForceT9OnCommand takes nothing returns nothingcall ForceRemovePlayer(ReplayRequestForce,GetTriggerPlayer())call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10,(GetObjectName(('n08U'))))endfunctionfunction JoinForceT9OnCommand takes nothing returns nothingcall ForceAddPlayer(ReplayRequestForce,GetTriggerPlayer())call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10,(GetObjectName(('n08Z'))))endfunctionfunction RandomizeWeatherTick takes nothing returns booleanlocal integer weatherRoll=GetRandomInt(1,4)if weatherRoll==1 thenset CurrentWeatherEffect=WeatherEffectAelseif weatherRoll==2 thenset CurrentWeatherEffect=WeatherEffectBelseif weatherRoll==3 thenset CurrentWeatherEffect=PrimaryWeatherEffectelseif weatherRoll==4 thenset CurrentWeatherEffect=SecondaryWeatherEffectendifif PlayerLocalToggleA[GetPlayerId(GetLocalPlayer())]thencall EnableWeatherEffect(WeatherEffectA,false)call EnableWeatherEffect(WeatherEffectB,false)call EnableWeatherEffect(PrimaryWeatherEffect,false)call EnableWeatherEffect(SecondaryWeatherEffect,false)call EnableWeatherEffect(CurrentWeatherEffect,true)endifreturn falseendfunctionfunction InitWeatherCycle takes nothing returns nothinglocal integer weatherRoll=GetRandomInt(1,4)local trigger weatherTimerTrigger=CreateTrigger()call TriggerRegisterTimerEvent(weatherTimerTrigger,300.,true)call TriggerAddCondition(weatherTimerTrigger,Condition(function RandomizeWeatherTick))set PlayerLocalToggleA[GetPlayerId(SentinelPlayer[1])]=falseset PlayerLocalToggleA[GetPlayerId(SentinelPlayer[2])]=falseset PlayerLocalToggleA[GetPlayerId(SentinelPlayer[3])]=falseset PlayerLocalToggleA[GetPlayerId(SentinelPlayer[4])]=falseset PlayerLocalToggleA[GetPlayerId(SentinelPlayer[5])]=falseset PlayerLocalToggleA[GetPlayerId(ScourgePlayer[1])]=falseset PlayerLocalToggleA[GetPlayerId(ScourgePlayer[2])]=falseset PlayerLocalToggleA[GetPlayerId(ScourgePlayer[3])]=falseset PlayerLocalToggleA[GetPlayerId(ScourgePlayer[4])]=falseset PlayerLocalToggleA[GetPlayerId(ScourgePlayer[5])]=falseif TwoPlayerViewModeActive thenset PlayerLocalToggleA[GetPlayerId(ViewModePlayerLeft)]=falseset PlayerLocalToggleA[GetPlayerId(ViewModePlayerRight)]=falseendifif weatherRoll==1 thenset CurrentWeatherEffect=WeatherEffectAelseif weatherRoll==2 thenset CurrentWeatherEffect=WeatherEffectBelseif weatherRoll==3 thenset CurrentWeatherEffect=PrimaryWeatherEffectelseif weatherRoll==4 thenset CurrentWeatherEffect=SecondaryWeatherEffectendifset weatherTimerTrigger=nullendfunctionfunction HandleWeatherChatCommand takes nothing returns nothinglocal string chatCommand=StringCase(GetEventPlayerChatString(),false)if FirstRunFlag thenset FirstRunFlag=falsecall InitWeatherCycle()endifif chatCommand=="-weather snow" and GetLocalPlayer()==GetTriggerPlayer()thenset PlayerLocalToggleA[GetPlayerId(GetTriggerPlayer())]=falsecall EnableWeatherEffect(WeatherEffectA,true)call EnableWeatherEffect(WeatherEffectB,false)call EnableWeatherEffect(PrimaryWeatherEffect,false)call EnableWeatherEffect(SecondaryWeatherEffect,false)endifif chatCommand=="-weather rain" and GetLocalPlayer()==GetTriggerPlayer()thenset PlayerLocalToggleA[GetPlayerId(GetTriggerPlayer())]=falsecall EnableWeatherEffect(WeatherEffectA,false)call EnableWeatherEffect(WeatherEffectB,true)call EnableWeatherEffect(PrimaryWeatherEffect,false)call EnableWeatherEffect(SecondaryWeatherEffect,false)endifif chatCommand=="-weather moonlight" and GetLocalPlayer()==GetTriggerPlayer()thenset PlayerLocalToggleA[GetPlayerId(GetTriggerPlayer())]=falsecall EnableWeatherEffect(WeatherEffectA,false)call EnableWeatherEffect(WeatherEffectB,false)call EnableWeatherEffect(PrimaryWeatherEffect,true)call EnableWeatherEffect(SecondaryWeatherEffect,false)endifif chatCommand=="-weather wind" and GetLocalPlayer()==GetTriggerPlayer()thenset PlayerLocalToggleA[GetPlayerId(GetTriggerPlayer())]=falsecall EnableWeatherEffect(WeatherEffectA,false)call EnableWeatherEffect(WeatherEffectB,false)call EnableWeatherEffect(PrimaryWeatherEffect,false)call EnableWeatherEffect(SecondaryWeatherEffect,true)endifif chatCommand=="-weather off" and GetLocalPlayer()==GetTriggerPlayer()thenset PlayerLocalToggleA[GetPlayerId(GetTriggerPlayer())]=falsecall EnableWeatherEffect(WeatherEffectA,false)call EnableWeatherEffect(WeatherEffectB,false)call EnableWeatherEffect(PrimaryWeatherEffect,false)call EnableWeatherEffect(SecondaryWeatherEffect,false)endifif chatCommand=="-weather random" thenset PlayerLocalToggleA[GetPlayerId(GetTriggerPlayer())]=trueif GetLocalPlayer()==GetTriggerPlayer()thencall EnableWeatherEffect(WeatherEffectA,false)call EnableWeatherEffect(WeatherEffectB,false)call EnableWeatherEffect(PrimaryWeatherEffect,false)call EnableWeatherEffect(SecondaryWeatherEffect,false)call EnableWeatherEffect(CurrentWeatherEffect,true)endifendifendfunctionfunction HandleRollChatCommand takes nothing returns nothinglocal integer rollMax=S2I(SubString(GetEventPlayerChatString(),6,StringLength(GetEventPlayerChatString())))local integer playerId=GetPlayerId(GetTriggerPlayer())set CommandUseCount[playerId]=CommandUseCount[playerId]+1if CommandUseCount[playerId]>20 thencall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10,(GetObjectName(('n0DQ'))))returnendifif GetEventPlayerChatString()=="-rollon" or GetEventPlayerChatString()=="-rolloff" thenreturnendifif rollMax==0 thenset rollMax=100endifif rollMax>0 and rollMax<2001 thencall DisplayTimedTextToForce_2(ReplayRequestForce,5,PlayerColorCode[GetPlayerId(GetTriggerPlayer())]+(PlayerName[GetPlayerId((GetTriggerPlayer()))])+"|r "+(GetObjectName(('n05I')))+" "+I2S(GetRandomInt(1,rollMax))+" "+(GetObjectName(('n05M')))+" "+I2S(rollMax))elsecall ShowErrorMessageToPlayer(GetTriggerPlayer(),(GetObjectName(('n02Y'))))endifendfunctionfunction HandleRandomHeroHintCommand takes nothing returns nothinglocal integer heroIndexif GetRandomInt(1,2)==1 thenset heroIndex=GetRandomInt(HeroPoolLoopStartB,HeroPoolLoopBoundC)elseset heroIndex=GetRandomInt(CachedLoopIndex,HeroPoolLoopBoundA)endifcall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10,(GetObjectName(('n0GS')))+" "+GetUnitTypeNameByIndex(heroIndex))endfunctionfunction HandleCaptainPickOrderCommand takes nothing returns nothinglocal integer pickOrder=S2I(SubString(GetEventPlayerChatString(),4,StringLength(GetEventPlayerChatString())))if GetTriggerPlayer()!=SentinelPlayer[1]or pickOrder>2 or pickOrder<1 or GameModeSelectedFlag==false or TimerGetElapsed(GameClockTimer)>14 or ModeCommandLockFlag thenreturnendifset RandomTeamPick=pickOrderset TeamDisplayMode=pickOrderset GameStateToggleFlag=trueif pickOrder==1 thencall DisplayTimedTextToForceMembers(bj_FORCE_ALL_PLAYERS,15.,PlayerColorCode[GetPlayerId(SentinelPlayer[1])]+(PlayerName[GetPlayerId((SentinelPlayer[1]))])+"|r "+GetObjectName('n0DS'))elsecall DisplayTimedTextToForceMembers(bj_FORCE_ALL_PLAYERS,15.,PlayerColorCode[GetPlayerId(ScourgePlayer[1])]+(PlayerName[GetPlayerId((ScourgePlayer[1]))])+"|r "+GetObjectName('n0DS'))endifif RandomTeamPick==1 thenset FirstCaptainPlayer=SentinelPlayer[1]set SecondCaptainPlayer=ScourgePlayer[1]elseset FirstCaptainPlayer=ScourgePlayer[1]set SecondCaptainPlayer=SentinelPlayer[1]endifendfunctionfunction DisableMtFlagForChatPlayer takes nothing returns nothingendfunctionfunction EnableMtFlagForChatPlayer takes nothing returns nothingendfunctionfunction HandleShowRealNamesCommand takes nothing returns nothingcall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10,(GetObjectName(('n090'))))set PlayerToggleIb[GetPlayerId(GetTriggerPlayer())]=trueif GetLocalPlayer()==GetTriggerPlayer()thencall SetPlayerName(SentinelPlayer[1],(PlayerName[GetPlayerId((SentinelPlayer[1]))]))call SetPlayerName(SentinelPlayer[2],(PlayerName[GetPlayerId((SentinelPlayer[2]))]))call SetPlayerName(SentinelPlayer[3],(PlayerName[GetPlayerId((SentinelPlayer[3]))]))call SetPlayerName(SentinelPlayer[4],(PlayerName[GetPlayerId((SentinelPlayer[4]))]))call SetPlayerName(SentinelPlayer[5],(PlayerName[GetPlayerId((SentinelPlayer[5]))]))call SetPlayerName(ScourgePlayer[1],(PlayerName[GetPlayerId((ScourgePlayer[1]))]))call SetPlayerName(ScourgePlayer[2],(PlayerName[GetPlayerId((ScourgePlayer[2]))]))call SetPlayerName(ScourgePlayer[3],(PlayerName[GetPlayerId((ScourgePlayer[3]))]))call SetPlayerName(ScourgePlayer[4],(PlayerName[GetPlayerId((ScourgePlayer[4]))]))call SetPlayerName(ScourgePlayer[5],(PlayerName[GetPlayerId((ScourgePlayer[5]))]))endifendfunctionfunction ToggleCwFlagForChatPlayer takes nothing returns nothinglocal integer playerId=GetPlayerId(GetTriggerPlayer())if PlayerLocalToggleB[playerId] thenset PlayerLocalToggleB[playerId]=falsecall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10,(GetObjectName(('n08T'))))elseset PlayerLocalToggleB[playerId]=truecall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10,(GetObjectName(('n091'))))endifendfunctionfunction SetAbFlagForChatPlayer takes nothing returns nothinglocal integer playerId=GetPlayerId(GetTriggerPlayer())set PlayerFlagAb[playerId]=trueendfunctionfunction DisplayPerMinuteRateForAllPlayers takes nothing returns nothinglocal integer slotIndex=1local player whichPlayerlocal real perMinuteRateloopexitwhen slotIndex>5set whichPlayer=SentinelPlayer[slotIndex]if IsPlayerSlotActive(whichPlayer)thenset perMinuteRate=PlayerCreepKillCount[GetPlayerId(whichPlayer)]/(TimerGetElapsed(GameClockTimer))*60call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,15.,PlayerColorCode[GetPlayerId(whichPlayer)]+(PlayerName[GetPlayerId((whichPlayer))])+"|r"+" "+(GetObjectName(('n084')))+" "+R2S(perMinuteRate))endifset whichPlayer=ScourgePlayer[slotIndex]if IsPlayerSlotActive(whichPlayer)thenset perMinuteRate=PlayerCreepKillCount[GetPlayerId(whichPlayer)]/(TimerGetElapsed(GameClockTimer))*60call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,15.,PlayerColorCode[GetPlayerId(whichPlayer)]+(PlayerName[GetPlayerId((whichPlayer))])+"|r"+" "+(GetObjectName(('n084')))+" "+R2S(perMinuteRate))endifset slotIndex=slotIndex+1endloopcall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,15.," ")set whichPlayer=nullendfunctionfunction HandleClearMessagesCommand takes nothing returns nothingcall ClearTextMessagesForPlayer(GetTriggerPlayer())endfunctionfunction FilterOwnedUnitInEitherSet takes nothing returns booleanreturn IsUnitTypeInEitherSet(GetFilterUnit())and GetOwningPlayer(GetFilterUnit())==GetTriggerPlayer()endfunctionfunction EnumOwnedUnitsInEitherSetInRange takes nothing returns nothinglocal group unitGroup=AcquireGroupFromPool()call GroupEnumUnitsInRange(unitGroup,0,0,12000,Condition(function FilterOwnedUnitInEitherSet))call ReleaseGroupToPool(unitGroup)set unitGroup=nullendfunctionfunction DisplaySpellComboList takes nothing returns nothingcall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10,(GetObjectName(('n0CV')))+" [|cffff0000E|r|cffff0000E|r|cffff0000E|r] - [|cffffcc00T|r]")call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10,(GetObjectName(('n0CU')))+" [|cffff0000E|r|cffff0000E|r|cff00ffffW|r] - [|cffffcc00D|r]")call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10,(GetObjectName(('n0CT')))+" [|cffff0000E|r|cffff0000E|r|cff0000ffQ|r] - [|cffffcc00F|r]")call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10,(GetObjectName(('n0C6')))+" [|cff0000ffQ|r|cff0000ffQ|r|cff0000ffQ|r] - [|cffffcc00Y|r]")call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10,(GetObjectName(('n0CL')))+" [|cff0000ffQ|r|cff0000ffQ|r|cff00ffffW|r] - [|cffffcc00V|r]")call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10,(GetObjectName(('n0CN')))+" [|cff0000ffQ|r|cff0000ffQ|r|cffff0000E|r] - [|cffffcc00G|r]")call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10,(GetObjectName(('n0CS')))+" [|cff00ffffW|r|cff00ffffW|r|cffff0000E|r] - [|cffffcc00Z|r]")call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10,(GetObjectName(('n0CO')))+" [|cff00ffffW|r|cff00ffffW|r|cff0000ffQ|r] - [|cffffcc00X|r]")call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10,(GetObjectName(('n0CP')))+" [|cff00ffffW|r|cff00ffffW|r|cff00ffffW|r] - [|cffffcc00C|r]")call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10,(GetObjectName(('n0CQ')))+" [|cff0000ffQ|r|cff00ffffW|r|cffff0000E|r] - [|cffffcc00B|r]")endfunctionfunction PlayMusicTrack takes string musicPath returns nothingcall StopMusic(true)call PlayMusic(musicPath)endfunctionfunction HandleMusicChatCommand takes nothing returns nothinglocal string chatString=GetEventPlayerChatString()local integer randomTrackIndex=GetRandomInt(1,MusicTrackCount)if GetLocalPlayer()==GetTriggerPlayer()thenif chatString=="-music off" thencall StopMusic(false)elseif chatString=="-music random" thencall PlayMusicTrack(MusicTrackPath[randomTrackIndex])elseif chatString=="-music nightelf1" thencall PlayMusicTrack(MusicTrackNightElf1)elseif chatString=="-music nightelf2" thencall PlayMusicTrack(MusicTrackNightElf2)elseif chatString=="-music nightelf3" thencall PlayMusicTrack(MusicTrackNightElf3)elseif chatString=="-music human1" thencall PlayMusicTrack(MusicTrackHuman1)elseif chatString=="-music human2" thencall PlayMusicTrack(MusicTrackHuman2)elseif chatString=="-music human3" thencall PlayMusicTrack(MusicTrackHuman3)elseif chatString=="-music orc1" thencall PlayMusicTrack(MusicTrackOrc1)elseif chatString=="-music orc2" thencall PlayMusicTrack(MusicTrackOrc2)elseif chatString=="-music orc3" thencall PlayMusicTrack(MusicTrackOrc3)elseif chatString=="-music undead1" thencall PlayMusicTrack(MusicTrackUndead1)elseif chatString=="-music undead2" thencall PlayMusicTrack(MusicTrackUndead2)elseif chatString=="-music undead3" thencall PlayMusicTrack(MusicTrackUndead3)elseif chatString=="-music other1" thencall PlayMusicTrack(MusicTrackBloodElfTheme)elseif chatString=="-music other2" thencall PlayMusicTrack(MusicTrackDarkAgents)elseif chatString=="-music other3" thencall PlayMusicTrack(MusicTrackTragicConfrontation)elseif chatString=="-music other4" thencall PlayMusicTrack(MusicTrackSadMystery)elseif chatString=="-music other5" thencall PlayMusicTrack(MusicTrackIllidansTheme)elseif chatString=="-music other6"thencall PlayMusicTrack(TensionMusicPath)elseif chatString=="-music other7"thencall PlayMusicTrack(ArthasThemeMusicPath)elseif chatString=="-music other8"thencall PlayMusicTrack(NightElfDefeatMusicPath)elseif chatString=="-music other9"thencall PlayMusicTrack(NightElfVictoryMusicPath)elseif chatString=="-music special" thencall PlayMusicTrack(MusicTrackPH1)elsecall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10,(GetObjectName(('n0CW')))+" ")call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10,"off, random, nightelf1, nightelf2, nightelf3, human1, human2, human3, orc1, orc2, orc3, undead1, undead2, undead3, other1, other2, other3, other4, other5, other6, other7, other8, other9, special")endifendifendfunctionfunction PopulateMusicTrackList takes nothing returns booleanset MusicTrackCount=MusicTrackCount+1set MusicTrackPath[MusicTrackCount]=MusicTrackNightElf1set MusicTrackCount=MusicTrackCount+1set MusicTrackPath[MusicTrackCount]=MusicTrackNightElf2set MusicTrackCount=MusicTrackCount+1set MusicTrackPath[MusicTrackCount]=MusicTrackNightElf3set MusicTrackCount=MusicTrackCount+1set MusicTrackPath[MusicTrackCount]=MusicTrackHuman1set MusicTrackCount=MusicTrackCount+1set MusicTrackPath[MusicTrackCount]=MusicTrackHuman2set MusicTrackCount=MusicTrackCount+1set MusicTrackPath[MusicTrackCount]=MusicTrackHuman3set MusicTrackCount=MusicTrackCount+1set MusicTrackPath[MusicTrackCount]=MusicTrackOrc1set MusicTrackCount=MusicTrackCount+1set MusicTrackPath[MusicTrackCount]=MusicTrackOrc2set MusicTrackCount=MusicTrackCount+1set MusicTrackPath[MusicTrackCount]=MusicTrackOrc3set MusicTrackCount=MusicTrackCount+1set MusicTrackPath[MusicTrackCount]=MusicTrackUndead1set MusicTrackCount=MusicTrackCount+1set MusicTrackPath[MusicTrackCount]=MusicTrackUndead2set MusicTrackCount=MusicTrackCount+1set MusicTrackPath[MusicTrackCount]=MusicTrackUndead3set MusicTrackCount=MusicTrackCount+1set MusicTrackPath[MusicTrackCount]=MusicTrackBloodElfThemeset MusicTrackCount=MusicTrackCount+1set MusicTrackPath[MusicTrackCount]=MusicTrackDarkAgentsset MusicTrackCount=MusicTrackCount+1set MusicTrackPath[MusicTrackCount]=MusicTrackTragicConfrontationset MusicTrackCount=MusicTrackCount+1set MusicTrackPath[MusicTrackCount]=MusicTrackSadMysteryset MusicTrackCount=MusicTrackCount+1set MusicTrackPath[MusicTrackCount]=MusicTrackIllidansThemeset MusicTrackCount=MusicTrackCount+1set MusicTrackPath[MusicTrackCount]=TensionMusicPathset MusicTrackCount=MusicTrackCount+1set MusicTrackPath[MusicTrackCount]=ArthasThemeMusicPathset MusicTrackCount=MusicTrackCount+1set MusicTrackPath[MusicTrackCount]=NightElfDefeatMusicPathset MusicTrackCount=MusicTrackCount+1set MusicTrackPath[MusicTrackCount]=NightElfVictoryMusicPathset MusicTrackCount=MusicTrackCount+1set MusicTrackPath[MusicTrackCount]=MusicTrackPH1return falseendfunctionfunction RegisterMusicTrackListInit takes nothing returns nothinglocal trigger initTrigger=CreateTrigger()call TriggerRegisterTimerEvent(initTrigger,.01,false)call TriggerAddCondition(initTrigger,Condition(function PopulateMusicTrackList))endfunctionfunction SetWaterColorForPlayer takes player whichPlayer,integer redValue,integer greenValue,integer blueValue,integer alphaValue returns nothingif GetLocalPlayer()==whichPlayer thencall SetWaterBaseColor(redValue,greenValue,blueValue,alphaValue)endifendfunctionfunction ParseRgbFromString takes string inputStr returns nothinglocal string redStr=""local string greenStr=""local string blueStr=""local integer index=0local integer strLen=StringLength(inputStr)local integer segmentIndex=1loopexitwhen index>strLenif SubString(inputStr,index,index+1)==" " thenset segmentIndex=segmentIndex+1elseif segmentIndex==1 thenset redStr=redStr+SubString(inputStr,index,index+1)elseif segmentIndex==2 thenset greenStr=greenStr+SubString(inputStr,index,index+1)elseset blueStr=blueStr+SubString(inputStr,index,index+1)endifendifset index=index+1endloopset ColorRed=S2I(redStr)set ColorGreen=S2I(greenStr)set ColorBlue=S2I(blueStr)endfunctionfunction HandleWaterColorCommand takes nothing returns nothinglocal string colorArg=SubString(GetEventPlayerChatString(),7,StringLength(GetEventPlayerChatString()))local player whichPlayer=GetTriggerPlayer()local integer redValuelocal integer greenValuelocal integer blueValueset PlayerFlagNb[GetPlayerId(whichPlayer)]=trueif colorArg=="red" thencall SetWaterColorForPlayer(whichPlayer,255,0,0,255)elseif colorArg=="blue" thencall SetWaterColorForPlayer(whichPlayer,0,0,255,255)elseif colorArg=="green" thencall SetWaterColorForPlayer(whichPlayer,0,255,0,255)elseif colorArg=="default" thencall SetWaterColorForPlayer(whichPlayer,0,0,255,255)elseif colorArg=="random" thenset redValue=GetRandomInt(0,255)set greenValue=GetRandomInt(0,255)set blueValue=GetRandomInt(0,255)call SetWaterColorForPlayer(whichPlayer,redValue,greenValue,blueValue,255)call DisplayTimedTextToPlayer(whichPlayer,0,0,5,(GetObjectName(('n0HD')))+" r="+I2S(redValue)+" g="+I2S(greenValue)+" b="+I2S(blueValue))elsecall ParseRgbFromString(colorArg)set redValue=ColorRedset greenValue=ColorGreenset blueValue=ColorBlueif redValue>=0 and redValue<=255 and greenValue>=0 and greenValue<=255 and blueValue>=0 and blueValue<=255 thencall SetWaterColorForPlayer(whichPlayer,redValue,greenValue,blueValue,255)endifendifendfunctionfunction DisplayCommandDisabledMessage takes nothing returns nothingcall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,15.,"This command has been temporarily disabled")endfunctionfunction DisplayBonusXpGoldCommand takes nothing returns booleancall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10.,"Total Bonus XP/Gold: "+I2S(PlayerTotalBonusXp[GetPlayerId(GetTriggerPlayer())])+"/"+I2S(PlayerTotalBonusGold[GetPlayerId(GetTriggerPlayer())]))return falseendfunctionfunction DisplayGlobalStatCounterCommand takes nothing returns booleanif AccumulatedUnitCount>0 thencall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10.,GetObjectName('n0LO')+": "+I2S(AccumulatedUnitCount))endifreturn falseendfunctionfunction OnLightningTetherTimerTick takes nothing returns booleanlocal trigger whichTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(whichTrigger)local integer firstSlot=(LoadInteger(GameHashtable,(triggerId),(61)))local integer secondSlot=(LoadInteger(GameHashtable,(triggerId),(62)))local unit firstUnit=UnitByIndex(firstSlot)local unit secondUnit=UnitByIndex(secondSlot)local real duration=(LoadReal(GameHashtable,(triggerId),(57)))local lightning tetherLightning=(LoadLightningHandle(GameHashtable,(triggerId),(41)))if I2R(GetTriggerEvalCount(whichTrigger))*.025>duration thencall DestroyLightning(tetherLightning)call ClearUnitHandleSlot(firstSlot)call ClearUnitHandleSlot(secondSlot)call FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(whichTrigger)elsecall MoveLightning(tetherLightning,true,GetUnitX(firstUnit),GetUnitY(firstUnit),GetUnitX(secondUnit),GetUnitY(secondUnit))endifset whichTrigger=nullset firstUnit=nullset secondUnit=nullset tetherLightning=nullreturn falseendfunctionfunction CreateTimedLightningBetweenUnits takes string lightningType,unit sourceUnit,unit targetUnit,real colorRed,real colorGreen,real colorBlue,real colorAlpha,real duration returns nothinglocal real sourceX=GetUnitX(sourceUnit)local real sourceY=GetUnitY(sourceUnit)local real targetX=GetUnitX(targetUnit)local real targetY=GetUnitY(targetUnit)local trigger tickTrigger=CreateTrigger()local integer triggerId=GetHandleId(tickTrigger)local lightning lightningBolt=AddLightning(lightningType,true,sourceX,sourceY,targetX,targetY)call SetLightningColor(lightningBolt,colorRed,colorGreen,colorBlue,colorAlpha)call SaveLightningHandle(GameHashtable,(triggerId),(41),(lightningBolt))call SaveInteger(GameHashtable,(triggerId),(61),(RegisterUnitHandleSlot(sourceUnit)))call SaveInteger(GameHashtable,(triggerId),(62),(RegisterUnitHandleSlot(targetUnit)))call SaveReal(GameHashtable,(triggerId),(57),((duration)*1.0))call TriggerRegisterTimerEvent(tickTrigger,.025,true)call TriggerAddCondition(tickTrigger,Condition(function OnLightningTetherTimerTick))set tickTrigger=nullset lightningBolt=nullendfunctionfunction PreloadSoundAtZeroVolume takes string soundPath returns nothinglocal sound tempSound=CreateSound(soundPath,false,false,false,10,10,"")call SetSoundVolume(tempSound,0)call StartSound(tempSound)call KillSoundWhenDone(tempSound)set tempSound=nullendfunctionfunction OnUbersplatDestroyTimerExpire takes nothing returns booleanlocal trigger timerTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(timerTrigger)local ubersplat targetUbersplat=(LoadUbersplatHandle(GameHashtable,(handleId),(131)))call DestroyUbersplat(targetUbersplat)call FlushChildHashtable(GameHashtable,(handleId))call RecycleExpiringTrigger(timerTrigger)set timerTrigger=nullset targetUbersplat=nullreturn falseendfunctionfunction ScheduleUbersplatDestruction takes ubersplat whichSplat,real delay returns nothinglocal trigger destroyTrigger=CreateTrigger()local integer handleId=GetHandleId(destroyTrigger)call SaveUbersplatHandle(GameHashtable,(handleId),(131),(whichSplat))call TriggerRegisterTimerEvent(destroyTrigger,delay,false)call TriggerAddCondition(destroyTrigger,Condition(function OnUbersplatDestroyTimerExpire))set destroyTrigger=nullendfunctionfunction EnumTrackNearestUnitToPoint takes nothing returns nothinglocal real dist=DistanceBetweenCoords(GetUnitX(GetEnumUnit()),GetUnitY(GetEnumUnit()),DistanceRefX,DistanceRefY)if dist<NearestUnitDistance_3 thenset NearestUnitDistance_3=distset FoundEnumUnit=GetEnumUnit()endifendfunctionfunction GetNearestUnitInGroupToPoint takes group whichGroup,real pointX,real pointY returns unitset NearestUnitDistance_3=999999set FoundEnumUnit=nullset DistanceRefX=pointXset DistanceRefY=pointYcall ForGroup(whichGroup,function EnumTrackNearestUnitToPoint)return FoundEnumUnitendfunctionfunction DisableAbilityForAllTeamPlayers takes integer abilityId returns nothinglocal integer slotIndex=0loopexitwhen slotIndex>5call SetPlayerAbilityAvailable(SentinelPlayer[slotIndex],abilityId,false)call SetPlayerAbilityAvailable(ScourgePlayer[slotIndex],abilityId,false)set slotIndex=slotIndex+1endloopendfunctionfunction DisableAbilityForAllPlayers takes integer abilityId returns nothinglocal integer playerIndex=0loopexitwhen playerIndex>12call SetPlayerAbilityAvailable(Player(playerIndex),abilityId,false)set playerIndex=playerIndex+1endloopendfunctionfunction OnTauntSoundChatCommand takes nothing returns nothinglocal string chatString=GetEventPlayerChatString()local trigger tempTriggerlocal integer soundIndex=S2I(SubString(GetEventPlayerChatString(),7,StringLength(GetEventPlayerChatString())))local integer preloadIndex=1if soundIndex<1 or soundIndex>TauntSoundCount thenset soundIndex=GetRandomInt(1,TauntSoundCount)call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10,(GetObjectName(('n0E5')))+I2S(soundIndex))endifif IsFirstRun thenloopexitwhen preloadIndex>TauntSoundCountcall PreloadSoundAtZeroVolume(PissedSoundPath[preloadIndex])set preloadIndex=preloadIndex+1endloopset IsFirstRun=falseendifif SoundPlayedFlag[soundIndex]==false thenendifcall PlaySoundFileForPlayer(GetTriggerPlayer(),PissedSoundPath[soundIndex])endfunctionfunction ToggleFormlessOverride takes nothing returns nothingif PlayerToggleEnabled[GetPlayerId(GetTriggerPlayer())]==false thenset PlayerToggleEnabled[GetPlayerId(GetTriggerPlayer())]=truecall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,15.,"Override is now on for Formless")elseset PlayerToggleEnabled[GetPlayerId(GetTriggerPlayer())]=falsecall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,15.,"Override is now off for Formless")endifendfunctionfunction OnFormlessHeroCreateTimerExpire takes nothing returns nothinglocal timer expiredTimer=GetExpiredTimer()local player whichPlayer=GetPlayerByName(GetHandleId(expiredTimer),"FormlessPlayer")if TrackedSideUnit[GetPlayerId(whichPlayer)]!=null and IsGameOptionEnabled thencall ShowErrorMessageToPlayer(whichPlayer,"Already have a hero.")elseif IsPlayerOnTeamZero(whichPlayer)thencall CreateUnitAtLoc(whichPlayer,'H500',GetRectCenter(BaseCenterRectB),0)elsecall CreateUnitAtLoc(whichPlayer,'H500',GetRectCenter(BaseCenterRectA),0)endifendifcall FlushChildHashtable(GameHashtable,GetHandleId(expiredTimer))call DestroyTimer(expiredTimer)set whichPlayer=nullset expiredTimer=nullendfunctionfunction RequestFormlessHeroCreation takes nothing returns nothinglocal player whichPlayer=GetTriggerPlayer()local timer createTimerif(TrackedSideUnit[GetPlayerId(whichPlayer)]==null or IsGameOptionEnabled==false)and IsModeSelectionLocked and GameModeFlagV==false and GameModeFlagW==false and GameModeFlagO9==false and AiSuppressModeFlag==false and AiRelatedGameModeFlag==false thencall ForbidTechRangeForPlayer(whichPlayer)call DisplayTimedTextToPlayer(whichPlayer,0,MessageDisplayY,10,"Formless will be created for you shortly.")set createTimer=CreateTimer()call StorePlayerByName(GetHandleId(createTimer),"FormlessPlayer",whichPlayer)call TimerStart(createTimer,6,false,function OnFormlessHeroCreateTimerExpire)endifset whichPlayer=nullset createTimer=nullendfunctionfunction OnBastionHeroCreateTimerExpire takes nothing returns nothinglocal timer expiredTimer=GetExpiredTimer()local player whichPlayer=GetPlayerByName(GetHandleId(expiredTimer),"BastionPlayer")if TrackedSideUnit[GetPlayerId(whichPlayer)]!=null and IsGameOptionEnabled thencall ShowErrorMessageToPlayer(whichPlayer,"Already have a hero.")elseif IsPlayerOnTeamZero(whichPlayer)thencall CreateUnitAtLoc(whichPlayer,'H600',GetRectCenter(BaseCenterRectB),0)elsecall CreateUnitAtLoc(whichPlayer,'H600',GetRectCenter(BaseCenterRectA),0)endifendifcall FlushChildHashtable(GameHashtable,GetHandleId(expiredTimer))call DestroyTimer(expiredTimer)set whichPlayer=nullset expiredTimer=nullendfunctionfunction RequestBastionHeroCreation takes nothing returns nothinglocal player whichPlayer=GetTriggerPlayer()local timer createTimerif(TrackedSideUnit[GetPlayerId(whichPlayer)]==null or IsGameOptionEnabled==false)and IsModeSelectionLocked and GameModeFlagV==false and GameModeFlagW==false and GameModeFlagO9==false and AiSuppressModeFlag==false and AiRelatedGameModeFlag==false thencall ForbidTechRangeForPlayer(whichPlayer)call DisplayTimedTextToPlayer(whichPlayer,0,MessageDisplayY,10,"Bastion will be created for you shortly.")set createTimer=CreateTimer()call StorePlayerByName(GetHandleId(createTimer),"BastionPlayer",whichPlayer)call TimerStart(createTimer,6,false,function OnBastionHeroCreateTimerExpire)endifset whichPlayer=nullset createTimer=nullendfunctionfunction OnTerrainSnapshotScanTimerExpire takes nothing returns booleanlocal trigger whichTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(whichTrigger)local real currentX=(LoadReal(GameHashtable,(triggerId),(149)))local real currentY=(LoadReal(GameHashtable,(triggerId),(150)))local real rowLimit=(LoadReal(GameHashtable,(triggerId),(151)))local real stepSize=128local real sampleXlocal real sampleYloopexitwhen currentX>rowLimitloopexitwhen currentY>8192set TerrainSampleIndex=TerrainSampleIndex+1set sampleX=currentXset sampleY=currentYif IsPointBlighted(sampleX,sampleY)==false then