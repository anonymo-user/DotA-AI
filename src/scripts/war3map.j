FilterUnit(),GetOwningPlayer(bj_lastLoadedUnit)))and(IsUnitAliveAndValidTarget(GetFilterUnit()))and(IsUnitVisible(GetFilterUnit(),GetOwningPlayer(bj_lastLoadedUnit))))endfunctionfunction UnitHasAnyImmunityAbilityOrFlag takes unit whichUnit returns booleanreturn GetUnitAbilityLevel(whichUnit,'A0S6')>0 or GetUnitAbilityLevel(whichUnit,'A179')>0 or GetUnitAbilityLevel(whichUnit,'ACmi')>0 or GetUnitAbilityLevel(whichUnit,'A0SU')>0 or GetUnitAbilityLevel(whichUnit,'B014')>0 or GetUnitAbilityLevel(whichUnit,'A0H3')>0 or((LoadInteger(GameHashtable,(GetHandleId(((whichUnit)))),((4252))))==1)endfunctionfunction UnitOrOwnerHasImmunity takes unit whichUnit returns booleanreturn((GetUnitAbilityLevel(whichUnit,'A0RN')>0)or(UnitHasAnyImmunityAbilityOrFlag(whichUnit))or(GetUnitAbilityLevel(whichUnit,'A2T4')>0)or(AiSlotBoolFlagGZ[256+GetPlayerId(GetOwningPlayer(whichUnit))]))endfunctionfunction IsUnitInsideOwnBaseRegion takes unit whichUnit returns booleanlocal real unitX=GetUnitX(whichUnit)local real unitY=GetUnitY(whichUnit)if IsUnitAlly(whichUnit,SentinelPlayer[0])thenreturn unitX<GetRectMaxX(TeamSpawnRectB)and unitX>GetRectMinX(TeamSpawnRectB)and unitY<GetRectMaxY(TeamSpawnRectB)and unitY>GetRectMinY(TeamSpawnRectB)endifreturn unitX<GetRectMaxX(TeamSpawnRectA)and unitX>GetRectMinX(TeamSpawnRectA)and unitY<GetRectMaxY(TeamSpawnRectA)and unitY>GetRectMinY(TeamSpawnRectA)endfunctionfunction FilterVulnerableAllyHeroOutsideBase takes nothing returns booleanreturn((IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO))and(IsUnitAlly(GetFilterUnit(),GetOwningPlayer(GetEnumUnit())))and(IsUnitAliveAndValidTarget(GetFilterUnit()))and(IsUnitType(GetFilterUnit(),UNIT_TYPE_MAGIC_IMMUNE)==false and GetUnitAbilityLevel(GetFilterUnit(),'Avul')==0)and IsUnitInsideOwnBaseRegion(GetFilterUnit())==false)endfunctionfunction FilterAllyHeroOfTrigger takes nothing returns booleanreturn((IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO))and(IsUnitAlly(GetFilterUnit(),GetOwningPlayer(GetTriggerUnit())