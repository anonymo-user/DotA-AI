nitFacing(casterUnit,moveAngle*bj_RADTODEG)endifset chargeTrigger=nullset casterUnit=nullset targetUnit=nullreturn falseendfunctionfunction StartLifeBreakCharge takes nothing returns nothinglocal unit casterUnit=GetTriggerUnit()local unit targetUnit=GetSpellTargetUnit()local trigger tickTrigger=CreateTrigger()local integer triggerId=GetHandleId(tickTrigger)call TriggerRegisterTimerEvent(tickTrigger,0.015,true)call TriggerRegisterDeathEvent(tickTrigger,casterUnit)call TriggerAddCondition(tickTrigger,Condition(function OnLifeBreakChargeTick))call SaveUnitHandle(GameHashtable,(triggerId),(2),(casterUnit))call SaveUnitHandle(GameHashtable,(triggerId),(17),(targetUnit))call SaveReal(GameHashtable,(triggerId),(23),((GetUnitX(targetUnit))*1.0))call SaveReal(GameHashtable,(triggerId),(24),((GetUnitY(targetUnit))*1.0))call SaveEffectHandle(GameHashtable,(triggerId),(175),(AddSpecialEffectTarget("war3mapImported\\LifeBreakCharge.mdx",casterUnit,"hand right alternate")))call SaveEffectHandle(GameHashtable,(triggerId),(176),(AddSpecialEffectTarget("war3mapImported\\LifeBreakCharge.mdx",casterUnit,"hand left alternate")))call SetUnitPathing(casterUnit,false)call AddPermanentAbility(casterUnit,'A0ST')call SetPlayerAbilityAvailable(GetOwningPlayer(casterUnit),'A0ST',false)call SetUnitAnimationByIndex(casterUnit,17)call SetUnitTimeScale(casterUnit,3.0)set casterUnit=nullset targetUnit=nullset tickTrigger=nullendfunctionfunction OnLifeBreakCast takes nothing returns booleanif(GetSpellAbilityId()=='A0QR' or GetSpellAbilityId()=='A1B3')and HasAnyMarkedAbility(GetSpellTargetUnit())==false thencall StartLifeBreakCharge()endifreturn falseendfunctionfunction InitSpellEffectA0QUTrigger takes nothing returns nothinglocal trigger lifeBreakTrigger=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(lifeBreakTrigger,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(lifeBreakTrigger,Condition(function OnLifeBreakCast))call PreloadAbilityOnDummy('A0QU')set lifeBreakTrigger=nullendfunctionfunction OnLiquidFireSlowExpiry takes nothing returns booleanlocal trigger t=GetTriggeringTrigger()local integer triggerId=GetHandleId(t)local integer abilityLevel=(LoadInteger(GameHashtable,(triggerId),(5)))local unit p5=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local unit m5=(LoadUnitHandle(GameHashtable,(triggerId),(17)))if p5==null thencall FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(t)return falseendifif GetTriggerEvalCount(t)>10 or GetTriggerEventId()==EVENT_UNIT_DEATH thencall DestroyEffect((LoadEffectHandle(GameHashtable,(triggerId),(32))))if GetTriggerEventId()==EVENT_UNIT_DEATH or (LoadReal(GameHashtable,(triggerId),(8812)))>=((LoadReal(GameHashtable,(GetHandleId(m5)),(8811)))-0.05) thencall UnitRemoveAbility(m5,'A1G5')call UnitRemoveAbility(m5,'A1G3')call UnitRemoveAbility(m5,'A1G6')call UnitRemoveAbility(m5,'A1G4')endifcall FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(t)elsecall DamageTargetByType(p5,m5,1,(abilityLevel*4+8)/2)endifset t=nullset p5=nullset m5=nullreturn falseendfunctionfunction EnumApplyLiquidFireSlowToUnit takes nothing returns nothinglocal trigger t=CreateTrigger()local integer triggerId=GetHandleId(t)local integer abilityLevel=TempIntegerSwapFlocal unit p5=TempUnitSwapFlocal unit m5=GetEnumUnit()if abilityLevel==1 thencall AddPermanentAbility(m5,'A1G5')call SetPlayerAbilityAvailable(GetOwningPlayer(m5),'A1G5',false)elseif abilityLevel==2 thencall AddPermanentAbility(m5,'A1G3')call SetPlayerAbilityAvailable(GetOwningPlayer(m5),'A1G3',false)elseif abilityLevel==3 thencall AddPermanentAbility(m5,'A1G6')call SetPlayerAbilityAvailable(GetOwningPlayer(m5),'A1G6',false)elseif abilityLevel==4 thencall AddPermanentAbility(m5,'A1G4')call SetPlayerAbilityAvailable(GetOwningPlayer(m5),'A1G4',false)endifcall SaveEffectHandle(GameHashtable,(triggerId),(32),(AddSpecialEffectTarget("Abilities\\Spells\\Other\\BreathOfFire\\BreathOfFireDamage.mdl",m5,"chest")))call SaveUnitHandle(GameHashtable,(triggerId),(2),(p5))call SaveUnitHandle(GameHashtable,(triggerId),(17),(m5))call SaveInteger(GameHashtable,(triggerId),(5),(abilityLevel))call SaveReal(GameHashtable,(triggerId),(8812),((TimerGetElapsed(GameClockTimer))+5.5))call SaveReal(GameHashtable,(GetHandleId(m5)),(8811),((TimerGetElapsed(GameClockTimer))+5.5))call TriggerRegisterTimerEvent(t,.5,true)call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DEATH)call TriggerAddCondition(t,Condition(function OnLiquidFireSlowExpiry))call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl",GetUnitX(m5),GetUnitY(m5)))set t=nullset p5=nullset m5=nullendfunctionfunction ApplyLiquidFireBurnAndSlow takes unit p5,unit m5 returns nothinglocal trigger t=CreateTrigger()local integer triggerId=GetHandleId(t)local integer abilityLevel=GetUnitAbilityLevel(p5,'A2VO')local real x=GetUnitX(m5)local real y=GetUnitY(m5)local group g=AcquireGroupFromPool()local group g2=AcquireGroupFromPool()set TempIntegerSwapF=abilityLevelset TempUnitSwapF=p5set FilterReferenceUnit_2=p5call GroupEnumUnitsInRange(g,x,y,300+25,Condition(function FilterEnemyTargetable))call GroupEnumUnitsInRange(g2,x,y,300+25,Condition(function FilterEnemySiegeUnit))call GroupAddGroup(g2,g)call ForGroup(g,function EnumApplyLiquidFireSlowToUnit)call ReleaseGroupToPool(g)call ReleaseGroupToPool(g2)set t=nullset g=nullset g2=nullendfunctionfunction OnDamagedTriggerW5DFromB0GX takes nothing returns booleanif GetUnitAbilityLevel(GetTriggerUnit(),'B0GX')>0 and GetUnitAbilityLevel(GetEventDamageSource(),'A2UM')>0 and(LoadUnitHandle(GameHashtable,(GetHandleId(GetTriggeringTrigger())),(2)))==GetEventDamageSource()thencall UnitRemoveAbility(GetTriggerUnit(),'B0GX')call FlushChildHashtable(GameHashtable,(GetHandleId(GetTriggeringTrigger())))call RecycleExpiringTrigger(GetTriggeringTrigger())endifreturn falseendfunctionfunction RegisterSpellTargetDamageWatch takes nothing returns nothinglocal trigger damageWatchTrigger=CreateTrigger()local unit targetUnit=GetSpellTargetUnit()local unit casterUnit=GetTriggerUnit()call SaveUnitHandle(GameHashtable,(GetHandleId(damageWatchTrigger)),(2),(casterUnit))call TriggerRegisterUnitEvent(damageWatchTrigger,targetUnit,EVENT_UNIT_DAMAGED)call TriggerAddCondition(damageWatchTrigger,Condition(function OnDamagedTriggerW5DFromB0GX))set damageWatchTrigger=nullset targetUnit=nullset casterUnit=nullendfunctionfunction OnPoisonArrowsToggleRecord takes nothing returns booleanlocal unit p5=GetTriggerUnit()local trigger tif GetTriggerEventId()==EVENT_UNIT_ISSUED_ORDER thenif GetIssuedOrderId()==OrderId("poisonarrows")thencall SaveInteger(GameHashtable,(GetHandleId(p5)),(8825),(1))elseif GetIssuedOrderId()==OrderId("unpoisonarrows")thencall SaveInteger(GameHashtable,(GetHandleId(p5)),(8825),(0))endifelseif GetTriggerEventId()==EVENT_UNIT_SPELL_EFFECT and GetSpellAbilityId()=='A2UM' thencall RegisterSpellTargetDamageWatch()endifset p5=nullreturn falseendfunctionfunction SetupPassiveA2UMForA2VO takes nothing returns nothinglocal trigger passiveTriggerif GetUnitAbilityLevel(GetTriggerUnit(),'A2VO')==1 thenset passiveTrigger=CreateTrigger()call TriggerRegisterUnitEvent(passiveTrigger,GetTriggerUnit(),EVENT_UNIT_SPELL_EFFECT)call TriggerRegisterUnitEvent(passiveTrigger,GetTriggerUnit(),EVENT_UNIT_ISSUED_ORDER)call TriggerAddCondition(passiveTrigger,Condition(function OnPoisonArrowsToggleRecord))set passiveTrigger=nullendifif GetUnitAbilityLevel(GetTriggerUnit(),'A2UM')==0 thencall AddPermanentAbility(GetTriggerUnit(),'A2UM')endifcall SetUnitAbilityLevel(GetTriggerUnit(),'A2UM',GetUnitAbilityLevel(GetTriggerUnit(),'A2VO'))endfunctionfunction OnLearnA2VOFilter takes nothing returns booleanif GetLearnedSkill()=='A2VO' and IsUnitIllusion(GetTriggerUnit())==false thencall SetupPassiveA2UMForA2VO()endifreturn falseendfunctionfunction InitLearnA2VOTrigger takes nothing returns nothinglocal trigger learnTrigger=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(learnTrigger,EVENT_PLAYER_HERO_SKILL)call TriggerAddCondition(learnTrigger,Condition(function OnLearnA2VOFilter))set learnTrigger=nullendfunctionfunction IsPointInTriangle takes real vertexAX,real vertexAY,real vertexBX,real vertexBY,real vertexCX,real vertexCY,real pointX,real pointY returns booleanlocal real cross1=(pointY-vertexAY)*(vertexBX-vertexAX)-(pointX-vertexAX)*(vertexBY-vertexAY)local real cross2=(pointY-vertexCY)*(vertexAX-vertexCX)-(pointX-vertexCX)*(vertexAY-vertexCY)local real cross3=(pointY-vertexBY)*(vertexCX-vertexBX)-(pointX-vertexBX)*(vertexCY-vertexBY)return(cross1*cross2>0)and(cross3*cross2>0)endfunctionfunction FilterEnemyInConeTriangle takes nothing returns booleanlocal real pointAx=EnumParamXlocal real pointAy=EnumParamYlocal real pointBx=EnumParamAnglelocal real pointBy=SavedRealAlocal real pointCx=SavedRealBlocal real pointCy=SavedRealCreturn IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(GetTriggerUnit()))and IsPointInTriangle(pointAx,pointAy,pointBx,pointBy,pointCx,pointCy,GetUnitX(GetFilterUnit()),GetUnitY(GetFilterUnit()))endfunctionfunction ComputeConeTriangleVertices takes real coneAngle,real originX,real originY returns nothinglocal real coneLength=600local real nearRadius=200local real farRadius=250local real spreadAngle=Asin((farRadius-nearRadius)/ coneLength)local real apexOffset=nearRadius/ Sin(spreadAngle)local real sideOffset=(coneLength+farRadius+apexOffset)*Tan(spreadAngle)local real apexX=originX+apexOffset*Cos((coneAngle-180)*bj_DEGTORAD)local real apexY=originY+apexOffset*Sin((coneAngle-180)*bj_DEGTORAD)local real leftX=(originX+(coneLength+farRadius)*Cos(coneAngle*bj_DEGTORAD))+sideOffset*Cos((coneAngle-90)*bj_DEGTORAD)local real leftY=(originY+(coneLength+farRadius)*Sin(coneAngle*bj_DEGTORAD))+sideOffset*Sin((coneAngle-90)*bj_DEGTORAD)local real rightX=(originX+(coneLength+farRadius)*Cos(coneAngle*bj_DEGTORAD))+sideOffset*Cos((coneAngle+90)*bj_DEGTORAD)local real rightY=(originY+(coneLength+farRadius)*Sin(coneAngle*bj_DEGTORAD))+sideOffset*Sin((coneAngle+90)*bj_DEGTORAD)set EnumParamX=apexXset EnumParamY=apexYset EnumParamAngle=leftXset SavedRealA=leftYset SavedRealB=rightXset SavedRealC=rightYendfunctionfunction EnumDummyCastA2ZEOnUnit takes nothing returns nothinglocal unit dummyUnit=CreateUnit(GetOwningPlayer(GetTriggerUnit()),'e00E',GetUnitX(GetEnumUnit()),GetUnitY(GetEnumUnit()),0)call AddPermanentAbility(dummyUnit,'A2ZE')call SetUnitAbilityLevel(dummyUnit,'A2ZE',GetUnitAbilityLevel(GetTriggerUnit(),'A0O7'))call IssueTargetOrderById(dummyUnit,852226,GetEnumUnit())set dummyUnit=nullendfunctionfunction OnTimerDelayedCastA0OC takes nothing returns booleanlocal trigger whichTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(whichTrigger)local player owner=(LoadPlayerHandle(GameHashtable,(handleId),(54)))local unit caster=(LoadUnitHandle(GameHashtable,(handleId),(14)))local real posX=(LoadReal(GameHashtable,(handleId),(6)))local real posY=(LoadReal(GameHashtable,(handleId),(7)))local real orderX=(LoadReal(GameHashtable,(handleId),(47)))local real orderY=(LoadReal(GameHashtable,(handleId),(48)))local integer abilityLevel=(LoadInteger(GameHashtable,(handleId),(5)))local unit dummyUnitif GetTriggerEvalCount(whichTrigger)>1 thencall SetUnitAnimation(caster,"stand")call FlushChildHashtable(GameHashtable,handleId)call RecycleExpiringTrigger(whichTrigger)elsecall SetUnitAnimation(caster,"spell")set dummyUnit=CreateUnit(owner,'e00E',posX,posY,0)call AddPermanentAbility(dummyUnit,'A0OC')call SetUnitAbilityLevel(dummyUnit,'A0OC',abilityLevel)call IssuePointOrderById(dummyUnit,852560,orderX,orderY)endifset whichTrigger=nullset owner=nullset caster=nullset dummyUnit=nullreturn falseendfunctionfunction ScheduleDelayedCastA0OC takes unit caster,player owner,integer abilityLevel,location targetLoc,real castX,real castY returns nothinglocal trigger castTrigger=CreateTrigger()local integer handleId=GetHandleId(castTrigger)call SavePlayerHandle(GameHashtable,(handleId),(54),(owner))call SaveReal(GameHashtable,(handleId),(6),((castX)*1.0))call SaveReal(GameHashtable,(handleId),(7),((castY)*1.0))call SaveReal(GameHashtable,(handleId),(47),((GetLocationX(targetLoc))*1.0))call SaveReal(GameHashtable,(handleId),(48),((GetLocationY(targetLoc))*1.0))call SaveInteger(GameHashtable,(handleId),(5),(abilityLevel))call SaveUnitHandle(GameHashtable,(handleId),(14),(caster))call TriggerRegisterTimerEvent(castTrigger,.3,true)call TriggerAddCondition(castTrigger,Condition(function OnTimerDelayedCastA0OC))set castTrigger=nullendfunctionfunction OnCastA0O7ConeNuke takes nothing returns nothinglocal unit caster=GetTriggerUnit()local integer abilityLevel=GetUnitAbilityLevel(caster,'A0O7')local real casterX=GetUnitX(caster)local real casterY=GetUnitY(caster)local location targetLoclocal unit dummyUnitlocal group coneGroup=AcquireGroupFromPool()if GetSpellTargetUnit()==null thenset targetLoc=GetSpellTargetLoc()elseset targetLoc=GetUnitLoc(GetSpellTargetUnit())endifcall ComputeConeTriangleVertices(bj_RADTODEG*Atan2(GetLocationY(targetLoc)-casterY,GetLocationX(targetLoc)-casterX),casterX,casterY)call GroupEnumUnitsInRange(coneGroup,casterX,casterY,2000,Condition(function FilterEnemyInConeTriangle))call ForGroup(coneGroup,function EnumDummyCastA2ZEOnUnit)call ReleaseGroupToPool(coneGroup)set dummyUnit=CreateUnit(GetOwningPlayer(caster),'e00E',casterX,casterY,0)call AddPermanentAbility(dummyUnit,'A0OB')call SetUnitAbilityLevel(dummyUnit,'A0OB',abilityLevel)call IssuePointOrderById(dummyUnit,852580,GetLocationX(targetLoc),GetLocationY(targetLoc))call ScheduleDelayedCastA0OC(caster,GetOwningPlayer(caster),abilityLevel,targetLoc,casterX+50*Cos(Atan2(GetLocationY(targetLoc)-casterY,GetLocationX(targetLoc)-casterX)),casterY+50*Sin(Atan2(GetLocationY(targetLoc)-casterY,GetLocationX(targetLoc)-casterX)))call RemoveLocation(targetLoc)set caster=nullset targetLoc=nullset coneGroup=nullset dummyUnit=nullendfunctionfunction OnCastA0O7Filter takes nothing returns booleanif GetSpellAbilityId()=='A0O7' thencall OnCastA0O7ConeNuke()endifreturn falseendfunctionfunction InitCastA0O7Trigger takes nothing returns nothinglocal trigger castTrigger=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(castTrigger,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(castTrigger,Condition(function OnCastA0O7Filter))call PreloadAbilityOnDummy('A0OB')call PreloadAbilityOnDummy('A0OC')call PreloadAbilityOnDummy('A2ZE')set castTrigger=nullendfunctionfunction EnumApplyFreezeToUnit takes nothing returns nothinglocal unit casterUnit=TempCasterUnit_3local unit enumUnit=GetEnumUnit()local unit tempUnitif IsUnitInGroup(enumUnit,EnumDedupeGroup_2)==false thencall GroupAddUnit(EnumDedupeGroup_2,enumUnit)call CreateDummyCastScaledAbilityOnTarget(casterUnit,enumUnit,CastAbilityScale)call DamageTargetByType(casterUnit,enumUnit,DamageType1,50)call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\FreezingBreath\\FreezingBreathMissile.mdl",GetUnitX(enumUnit),GetUnitY(enumUnit)))endifendfunctionfunction OnTimerIcePathDamage takes nothing returns booleanlocal trigger pathTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(pathTrigger)local real originX=(LoadReal(GameHashtable,(triggerId),(6)))local real originY=(LoadReal(GameHashtable,(triggerId),(7)))local real pathAngle=(LoadReal(GameHashtable,(triggerId),(137)))local unit casterUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local integer tickCount=GetTriggerEvalCount(pathTrigger)local real segmentXlocal real segmentYlocal group enumGrouplocal integer loopIndexlocal group hitGroup=(LoadGroupHandle(GameHashtable,(triggerId),(187)))local integer abilityLevel=GetUnitAbilityLevel(casterUnit,'A0O6')set loopIndex=0loopexitwhen loopIndex>10set segmentX=originX+100*loopIndex*Cos(pathAngle*bj_DEGTORAD)set segmentY=originY+100*loopIndex*Sin(pathAngle*bj_DEGTORAD)if ModuloInteger(tickCount,10)==0 thenendifset FilterReferenceUnit_2=casterUnitset TempCasterUnit_3=casterUnitset EnumDedupeGroup_2=hitGroupset CastAbilityScale=(.6+.4*abilityLevel)-(tickCount*.05)set enumGroup=AcquireGroupFromPool()call GroupEnumUnitsInRange(enumGroup,segmentX,segmentY,150+25,Condition(function FilterAttackableEnemy))call ForGroup(enumGroup,function EnumApplyFreezeToUnit)call ReleaseGroupToPool(enumGroup)set loopIndex=loopIndex+1endloopif tickCount==20*(.6+.4*abilityLevel)thencall ReleaseGroupToPool(hitGroup)call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(pathTrigger)endifset pathTrigger=nullset casterUnit=nullset enumGroup=nullset hitGroup=nullreturn falseendfunctionfunction OnTimerIcePathBuild takes nothing returns booleanlocal trigger castTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(castTrigger)local real originX=(LoadReal(GameHashtable,(handleId),(6)))local real originY=(LoadReal(GameHashtable,(handleId),(7)))local real angle=(LoadReal(GameHashtable,(handleId),(137)))local integer tickCount=GetTriggerEvalCount(castTrigger)local real pointX=originX+100*tickCount*Cos(angle*bj_DEGTORAD)local real pointY=originY+100*tickCount*Sin(angle*bj_DEGTORAD)local unit casterUnit=(LoadUnitHandle(GameHashtable,(handleId),(2)))local integer abilityLevel=GetUnitAbilityLevel(casterUnit,'A0O6')local ubersplat iceSplatlocal integer loopIndexif tickCount<10 thencall SaveEffectHandle(GameHashtable,(handleId),(609+tickCount),(AddSpecialEffect("effects\\IcePath.mdx",pointX,pointY)))set iceSplat=CreateUbersplat(pointX,pointY,"IPTH",255,255,255,255,false,false)call SetUbersplatRenderAlways(iceSplat,true)call SaveUbersplatHandle(GameHashtable,(handleId),(760+tickCount),(iceSplat))endifif tickCount==10 thenset castTrigger=CreateTrigger()set handleId=GetHandleId(castTrigger)call TriggerRegisterTimerEvent(castTrigger,.05,true)call TriggerAddCondition(castTrigger,Condition(function OnTimerIcePathDamage))call SaveReal(GameHashtable,(handleId),(6),((originX)*1.))call SaveReal(GameHashtable,(handleId),(7),((originY)*1.))call SaveReal(GameHashtable,(handleId),(137),((angle)*1.))call SaveUnitHandle(GameHashtable,(handleId),(2),(casterUnit))call SaveGroupHandle(GameHashtable,(handleId),(187),(AcquireGroupFromPool()))call TriggerEvaluate(castTrigger)elseif tickCount>=(.4+.6+.4*abilityLevel)/.05 thenset loopIndex=0loopexitwhen loopIndex==10call DestroyEffect((LoadEffectHandle(GameHashtable,(handleId),(609+loopIndex))))call DestroyUbersplat((LoadUbersplatHandle(GameHashtable,(handleId),(760+loopIndex))))set loopIndex=loopIndex+1endloopcall FlushChildHashtable(GameHashtable,(handleId))call RecycleExpiringTrigger(castTrigger)endifset castTrigger=nullset casterUnit=nullreturn falseendfunctionfunction OnCastA0O6IcePath takes nothing returns nothinglocal trigger tickTrigger=CreateTrigger()local integer trigId=GetHandleId(tickTrigger)local unit casterUnit=GetTriggerUnit()local real casterX=GetUnitX(casterUnit)local real casterY=GetUnitY(casterUnit)local real pathAngle=AngleBetweenCoords(casterX,casterY,GetSpellTargetX(),GetSpellTargetY())call TriggerRegisterTimerEvent(tickTrigger,.05,true)call TriggerAddCondition(tickTrigger,Condition(function OnTimerIcePathBuild))call SaveReal(GameHashtable,(trigId),(6),((casterX)*1.))call SaveReal(GameHashtable,(trigId),(7),((casterY)*1.))call SaveReal(GameHashtable,(trigId),(137),((pathAngle)*1.))call SaveUnitHandle(GameHashtable,(trigId),(2),(casterUnit))call TriggerEvaluate(tickTrigger)set tickTrigger=nullset casterUnit=nullendfunctionfunction OnCastA0O6Filter takes nothing returns booleanif GetSpellAbilityId()=='A0O6' thencall OnCastA0O6IcePath()endifreturn falseendfunctionfunction InitCastA0O6Trigger takes nothing returns nothinglocal trigger castTrigger=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(castTrigger,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(castTrigger,Condition(function OnCastA0O6Filter))set castTrigger=nullendfunctionfunction OnTimerDriveA0O5Channel takes nothing returns booleanlocal trigger castTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(castTrigger)local unit casterUnit=(LoadUnitHandle(GameHashtable,(handleId),(2)))local integer abilityLevel=(LoadInteger(GameHashtable,(handleId),(5)))local real angle=(LoadReal(GameHashtable,(handleId),(137)))local real originX=(LoadReal(GameHashtable,(handleId),(6)))local real originY=(LoadReal(GameHashtable,(handleId),(7)))local integer playerId=GetPlayerId(GetOwningPlayer(casterUnit))local integer tickCount=GetTriggerEvalCount(castTrigger)local real orderX=originX+150*tickCount*Cos(angle)local real orderY=originY+150*tickCount*Sin(angle)local integer maxTicks=6if GetUnitAbilityLevel(casterUnit,'A0O5')==0 thenset maxTicks=11endifif GetPlayerController(GetOwningPlayer(PlayerDummyCasterA0OE[playerId]))==MAP_CONTROL_COMPUTER thencall UnitAddAbility(PlayerDummyCasterA0OE[GetPlayerId(GetOwningPlayer(casterUnit))],'A0OE')call SetUnitAbilityLevel(PlayerDummyCasterA0OE[GetPlayerId(GetOwningPlayer(casterUnit))],'A0OE',abilityLevel)endifcall IssuePointOrderById(PlayerDummyCasterA0OE[playerId],852488,orderX,orderY)if tickCount==(maxTicks)thencall FlushChildHashtable(GameHashtable,handleId)call RecycleExpiringTrigger(castTrigger)call SetUnitAnimation(casterUnit,"stand")endifset castTrigger=nullset casterUnit=nullreturn falseendfunctionfunction OnCastA0O5LineSpell takes nothing returns nothinglocal trigger thisTrigger=CreateTrigger()local integer triggerId=GetHandleId(thisTrigger)local unit casterUnit=GetTriggerUnit()local location targetLoc=GetSpellTargetLoc()local real targetX=GetLocationX(targetLoc)local real targetY=GetLocationY(targetLoc)local real angle=Atan2(targetY-GetUnitY(casterUnit),targetX-GetUnitX(casterUnit))local integer abilityLevel=GetUnitAbilityLevel(casterUnit,'A0O5')local integer dummyAbilityId='A0OE'if abilityLevel==0 thenset abilityLevel=GetUnitAbilityLevel(casterUnit,'A1B1')set dummyAbilityId='A1B2'endifcall RemoveLocation(targetLoc)call SetUnitAnimation(casterUnit,"spell")set PlayerDummyCasterA0OE[GetPlayerId(GetOwningPlayer(casterUnit))]=CreateUnit(GetOwningPlayer(casterUnit),'e00E',targetX,targetY,0)call AddPermanentAbility(PlayerDummyCasterA0OE[GetPlayerId(GetOwningPlayer(casterUnit))],dummyAbilityId)call SetUnitAbilityLevel(PlayerDummyCasterA0OE[GetPlayerId(GetOwningPlayer(casterUnit))],dummyAbilityId,abilityLevel)call SaveInteger(GameHashtable,(triggerId),(5),(abilityLevel))call SaveReal(GameHashtable,(triggerId),(6),((GetUnitX(casterUnit))*1.0))call SaveReal(GameHashtable,(triggerId),(7),((GetUnitY(casterUnit))*1.0))call SaveReal(GameHashtable,(triggerId),(137),((angle)*1.0))call SaveUnitHandle(GameHashtable,(triggerId),(2),(casterUnit))if dummyAbilityId=='A0OE' thencall TriggerRegisterTimerEvent(thisTrigger,.1,true)elsecall TriggerRegisterTimerEvent(thisTrigger,.05,true)endifcall TriggerAddCondition(thisTrigger,Condition(function OnTimerDriveA0O5Channel))set thisTrigger=nullset casterUnit=nullset targetLoc=nullendfunctionfunction OnCastA0O5OrA1B1Filter takes nothing returns booleanif GetSpellAbilityId()=='A0O5' or GetSpellAbilityId()=='A1B1' thencall OnCastA0O5LineSpell()endifreturn falseendfunctionfunction InitCastA0O5Trigger takes nothing returns nothinglocal trigger castTrigger=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(castTrigger,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(castTrigger,Condition(function OnCastA0O5OrA1B1Filter))call PreloadAbilityOnDummy('A0OE')set castTrigger=nullendfunctionfunction IsSummonedUnitAbilityInheritor takes nothing returns booleanreturn GetUnitTypeId(GetSummonedUnit())=='o00C' or GetUnitTypeId