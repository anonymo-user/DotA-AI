(LoadEffectHandle(GameHashtable,(triggerId),(176))))call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(linkTrigger)if IsUnitDeadOrInvalid(casterUnit)==false thencall SetUnitState(casterUnit,UNIT_STATE_LIFE,RealMax(1,GetUnitState(casterUnit,UNIT_STATE_LIFE)-drainAmount))endifif IsUnitDeadOrInvalid(targetUnit)==false thencall SetUnitState(targetUnit,UNIT_STATE_LIFE,GetUnitState(targetUnit,UNIT_STATE_LIFE)+drainAmount)endifelseset drainAmount=GetUnitState(targetUnit,UNIT_STATE_MAX_LIFE)*.2call SetUnitState(casterUnit,UNIT_STATE_LIFE,GetUnitState(casterUnit,UNIT_STATE_LIFE)+drainAmount)call SetUnitState(targetUnit,UNIT_STATE_LIFE,RealMax(1,GetUnitState(targetUnit,UNIT_STATE_LIFE)-drainAmount))call SaveReal(GameHashtable,(triggerId),(797),((drainAmount)*1.))call SaveReal(GameHashtable,(triggerId),(798),((linkValue)*1.))endifset linkTrigger=nullset casterUnit=nullset targetUnit=nullreturn falseendfunctionfunction StartA2S0LifeLink takes nothing returns nothinglocal trigger whichTrigger=CreateTrigger()local integer triggerId=GetHandleId(whichTrigger)local unit casterUnit=GetTriggerUnit()local unit targetUnit=GetSpellTargetUnit()call TriggerRegisterTimerEvent(whichTrigger,.01,false)call TriggerRegisterTimerEvent(whichTrigger,7,false)call TriggerRegisterDeathEvent(whichTrigger,casterUnit)call TriggerAddCondition(whichTrigger,Condition(function OnA2S0LifeLinkTick))call SaveUnitHandle(GameHashtable,(triggerId),(2),(casterUnit))call SaveUnitHandle(GameHashtable,(triggerId),(17),(targetUnit))call SaveReal(GameHashtable,(triggerId),(797),((0)*1.))call SaveReal(GameHashtable,(triggerId),(798),((0)*1.))call SaveEffectHandle(GameHashtable,(triggerId),(175),(AddSpecialEffectTarget("war3mapImported\\MortalStrikeCaster.mdx",casterUnit,"overhead")))call SaveEffectHandle(GameHashtable,(triggerId),(176),(AddSpecialEffectTarget("war3mapImported\\MortalStrikeTarget.mdx",targetUnit,"overhead")))call SaveInteger(GameHashtable,(Ge