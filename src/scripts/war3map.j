r itemIndex=FindItemTypeIndexBaseTables(pickedItem)local integer slotIndexcall DisableTrigger(ToggleableTrigger)if itemIndex==ItemIndexCost3150A and GetItemCharges(pickedItem)==0 thenset slotIndex=GetUnitItemSlotIndex(pickerUnit,pickedItem)set ItemOwnerPlayer_2=GetItemPlayer(GetManipulatedItem())call RemoveItem(pickedItem)set TempCreatedItem=CreateItemInInventorySlot(pickerUnit,ItemTypeId[ItemIndexCost3150B],slotIndex)call SetItemPlayer(TempCreatedItem,ItemOwnerPlayer_2,false)call SetItemUserData(TempCreatedItem,1)elseif itemIndex==ItemIndexCost3850A and GetItemCharges(pickedItem)==0 thenset slotIndex=GetUnitItemSlotIndex(pickerUnit,pickedItem)set ItemOwnerPlayer_2=GetItemPlayer(GetManipulatedItem())call RemoveItem(pickedItem)set TempCreatedItem=CreateItemInInventorySlot(pickerUnit,ItemTypeId[ItemIndexCost3850B],slotIndex)call SetItemPlayer(TempCreatedItem,ItemOwnerPlayer_2,false)call SetItemUserData(TempCreatedItem,1)elseif itemIndex==ItemIndexGold1850A and GetItemCharges(pickedItem)==0 thenset slotIndex=GetUnitItemSlotIndex(pickerUnit,pickedItem)set ItemOwnerPlayer_2=GetItemPlayer(GetManipulatedItem())call RemoveItem(pickedItem)set TempCreatedItem=CreateItemInInventorySlot(pickerUnit,ItemTypeId[ItemIndexGold1850B],slotIndex)call SetItemPlayer(TempCreatedItem,ItemOwnerPlayer_2,false)call SetItemUserData(TempCreatedItem,1)endifcall EnableTrigger(ToggleableTrigger)set pickerUnit=nullset pickedItem=nullendfunctionfunction OnItemReAddAbilityDelayExpire takes nothing returns booleanlocal trigger delayTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(delayTrigger)local unit heroUnit=(LoadUnitHandle(GameHashtable,(handleId),(2)))if TryGiveItemI0KKToUnit(heroUnit)thencall TryAddItemByIdToUnit(heroUnit,'I0HM')endifcall FlushChildHashtable(GameHashtable,handleId)call RecycleExpiringTrigger(delayTrigger)call SaveBoolean(GameHashtable,(GetHandleId(heroUnit)),(129),(false))set delayTrigger=nullset heroUnit=nullreturn falseendfunctionfunction OnPickupScheduleItemReAddDelay takes nothing returns nothinglocal unit pickerUnit=GetTriggerUnit()local item pickedItem=GetManipulatedItem()local integer itemIndex=FindItemTypeIndexBaseTables(pickedItem)local trigger delayTriggerif(itemIndex==ItemIndexCost4950A or itemIndex==ItemIndexCost4950B)and(LoadBoolean(GameHashtable,(GetHandleId(pickerUnit)),(129)))==true thenset delayTrigger=CreateTrigger()call TriggerRegisterTimerEvent(delayTrigger,.41,false)call TriggerAddCondition(delayTrigger,Condition(function OnItemReAddAbilityDelayExpire))call SaveUnitHandle(GameHashtable,(GetHandleId(delayTrigger)),(2),(pickerUnit))set delayTrigger=nullendifset pickerUnit=nullset pickedItem=nullendfunctionfunction OnHealOverTimeTick takes nothing returns booleanlocal trigger tickTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(tickTrigger)local unit healedUnit=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local integer ticksRemaining=(LoadInteger(GameHashtable,(triggerId),(34)))if healedUnit==null thencall FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(tickTrigger)return falseendifif GetTriggerEventId()==EVENT_UNIT_SPELL_EFFECT thenif GetSpellAbilityId()=='Aeat' thencall SaveInteger(GameHashtable,(triggerId),(34),(16))endifelseif IsUnitDeadOrInvalid(healedUnit)or GetTriggerEventId()==EVENT_UNIT_DEATH or ticksRemaining<=0 thencall UnitRemoveAbility(healedUnit,'A0PV')call UnitRemoveAbility(healedUnit,'B07L')call SaveInteger(GameHashtable,(GetHandleId((healedUnit))),((4255)),(2))call FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(tickTrigger)elsecall SetUnitState(healedUnit,UNIT_STATE_LIFE,GetUnitState(healedUnit,UNIT_STATE_LIFE)+115/ 16)call SaveInteger(GameHashtable,(triggerId),(34),(ticksRemaining-1))endifreturn falseendfunctionfunction StartHealOverTimeEffect takes nothing returns nothinglocal unit heroUnit=GetTriggerUnit()local trigger healTrigger=CreateTrigger()local integer handleId=GetHandleId(healTrigger)call SaveInteger(GameHashtable,(GetHandleId((heroUnit))),((4255)),(1))call AddPermanentAbility(heroUnit,'A0PV')call SaveUnitHandle(GameHashtable,(handleId),(2),(heroUnit))call SaveInteger(GameHashtable,(handleId),(34),(16))call TriggerRegisterTimerEvent(healTrigger,1,true)call TriggerRegisterUnitEvent(healTrigger,heroUnit,EVENT_UNIT_DEATH)call TriggerRegisterUnitEvent(healTrigger,heroUnit,EVENT_UNIT_SPELL_EFFECT)call TriggerAddCondition(healTrigger,Condition(function OnHealOverTimeTick))call TriggerEvaluate(healTrigger)set heroUnit=nullset healTrigger=nullendfunctionfunction OnCastAeatHealTreeOrGrantItem takes nothing returns nothingif GetSpellAbilityId()=='Aeat' or GetSpellAbilityId()=='A2VG' thenif((LoadInteger(GameHashtable,(GetHandleId((GetTriggerUnit()))),((4255))))==1)==false and GetSpellTargetDestructable()!=null thencall StartHealOverTimeEffect()elseif GetSpellTargetUnit()!=null thencall UnitAddItemById(GetSpellTargetUnit(),'I0Q6')endifendifendfunctionfunction RecordPlayerPositionSample takes integer playerId,real posX,real posY returns nothingif IsPointInRegion(BaseCornerRegion,posX,posY)==false thenset TrackedPointCount=TrackedPointCount+1set TrackedPlayer[TrackedPointCount]=Player(playerId)set TrackedUnitX[TrackedPointCount]=posXset TrackedPointY[TrackedPointCount]=posYset TrackedPointTimestamp[TrackedPointCount]=(TimerGetElapsed(GameClockTimer))endifendfunctionfunction CountNearbyRecentAllySamples takes integer playerId,real checkX,real checkY returns integerlocal real currentTime=(TimerGetElapsed(GameClockTimer))local integer index=0local integer count=0if IsPointInRegion(BaseCornerRegion,checkX,checkY) thenreturn countendifloopexitwhen index>TrackedPointCountif(currentTime<TrackedPointTimestamp[index]+TrackedPointTimeWindow)and(DistanceBetweenCoords(checkX,checkY,TrackedUnitX[index],TrackedPointY[index])<AbilityCastRadius*2+50)and IsPlayerAlly(Player(playerId),TrackedPlayer[index]) thenset count=count+1endifset index=index+1endloopreturn countendfunctionfunction GetPlayerTeleportBeaconUnitId takes integer playerId returns integerif playerId==GetPlayerId(SentinelPlayer[1])thenreturn'h0BI'elseif playerId==GetPlayerId(SentinelPlayer[2])thenreturn'h0BK'elseif playerId==GetPlayerId(SentinelPlayer[3])thenreturn'h0BG'elseif playerId==GetPlayerId(SentinelPlayer[4])thenreturn'h0BF'elseif playerId==GetPlayerId(SentinelPlayer[5])thenreturn'h0BL'elseif playerId==GetPlayerId(ScourgePlayer[1])thenreturn'h0BH'elseif playerId==GetPlayerId(ScourgePlayer[2])thenreturn'h0BJ'elseif playerId==GetPlayerId(ScourgePlayer[3])thenreturn'h0BM'elseif playerId==GetPlayerId(ScourgePlayer[4])thenreturn'h0A5'elseif playerId==GetPlayerId(ScourgePlayer[5])thenreturn'h0BN'endifreturn'h0BN'endfunctionfunction GetDefaultTeleportBeaconUnitId takes integer playerId returns integerreturn'h0AX'endfunctionfunction GetPlayerTeleportTargetModel takes integer playerId returns stringif playerId==GetPlayerId(SentinelPlayer[1])thenreturn"war3mapImported\\TeleportTarget_Blue.mdx"elseif playerId==GetPlayerId(SentinelPlayer[2])thenreturn"war3mapImported\\TeleportTarget_Teal.mdx"elseif playerId==GetPlayerId(SentinelPlayer[3])thenreturn"war3mapImported\\TeleportTarget_Purple.mdx"elseif playerId==GetPlayerId(SentinelPlayer[4])thenreturn"war3mapImported\\TeleportTarget_Yellow.mdx"elseif playerId==GetPlayerId(SentinelPlayer[5])thenreturn"war3mapImported\\TeleportTarget_Orange.mdx"elseif playerId==GetPlayerId(ScourgePlayer[1])thenreturn"war3mapImported\\TeleportTarget_Pink.mdx"elseif playerId==GetPlayerId(ScourgePlayer[2])thenreturn"war3mapImported\\TeleportTarget_Gray.mdx"elseif playerId==GetPlayerId(ScourgePlayer[3])thenreturn"war3mapImported\\TeleportTarget_LightBlue.mdx"elseif playerId==GetPlayerId(ScourgePlayer[4])thenreturn"war3mapImported\\TeleportTarget_DarkGreen.mdx"elseif playerId==GetPlayerId(ScourgePlayer[5