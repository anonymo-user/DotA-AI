tPlayerId(owningPlayer)]+bountyGoldcall TriggerRegisterTimerEvent(expireTrigger,30.,false)call TriggerAddCondition(expireTrigger,Condition(function OnKillBountyStackExpire))call SaveUnitHandle(GameHashtable,(GetHandleId(expireTrigger)),(26),(killerUnit))call SaveInteger(GameHashtable,(killerHandleId),(27),(stackCount+1))call SetPlayerState(owningPlayer,PLAYER_STATE_RESOURCE_GOLD,bountyGold+GetPlayerState(owningPlayer,PLAYER_STATE_RESOURCE_GOLD))call SetTextTagText(bountyText,"+"+I2S(bountyGold),.025)call SetTextTagPosUnit(bountyText,dyingUnit,0)call SetTextTagColor(bountyText,255,220,0,255)call SetTextTagVelocity(bountyText,0,.03)if GetLocalPlayer()==owningPlayer thencall SetTextTagVisibility(bountyText,true)elsecall SetTextTagVisibility(bountyText,false)endifcall SetTextTagFadepoint(bountyText,2)call SetTextTagLifespan(bountyText,3)call SetTextTagPermanent(bountyText,false)set expireTrigger=nullset killerUnit=nullset dyingUnit=nullset owningPlayer=nullendfunctionfunction ShowKillBountyStatsOnCommand takes nothing returns booleanlocal integer accumulatedBounty=PlayerAccumulatedAmount[GetPlayerId(GetTriggerPlayer())]if(GetUnitTypeId(TrackedSideUnit[GetPlayerId(GetTriggerPlayer())])=='N01I' or GetUnitTypeId(TrackedSideUnit[GetPlayerId(GetTriggerPlayer())])=='N01H' or GetUnitTypeId(TrackedSideUnit[GetPlayerId(GetTriggerPlayer())])=='N01T' or GetUnitTypeId(TrackedSideUnit[GetPlayerId(GetTriggerPlayer())])=='N01J')and accumulatedBounty>0 thencall DisplayTimedTextToPlayer(GetTriggerPlayer(),0,MessageDisplayY,10.,(GetObjectName(('n0GQ')))+" "+I2S(accumulatedBounty))endifreturn falseendfunctionfunction InitKillBountyAndStatsCommands takes nothing returns nothinglocal trigger cmdTrigger=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(cmdTrigger,EVENT_PLAYER_UNIT_DEATH)call TriggerAddCondition(cmdTrigger,Condition(function FilterKillBountyEligibleA0O3))call TriggerAddAction(cmdTrigger,function AwardStackingKillBountyGold)set cmdTrigger=CreateTrigger()call TriggerRegisterPlayerChatEvent(cmdTrigger,SentinelPlayer[1],"-stats",true)call TriggerRegisterPlayerChatEvent(cmdTrigger,SentinelPlayer[2],"-stats",true)call TriggerRegisterPlayerChatEvent(cmdTrigger,SentinelPlayer[3],"-stats",true)call TriggerRegisterPlayerChatEvent(cmdTrigger,SentinelPlayer[4],"-stats",true)call TriggerRegisterPlayerChatEvent(cmdTrigger,SentinelPlayer[5],"-stats",true)call TriggerRegisterPlayerChatEvent(cmdTrigger,ScourgePlayer[1],"-stats",true)call TriggerRegisterPlayerChatEvent(cmdTrigger,ScourgePlayer[2],"-stats",true)call TriggerRegisterPlayerChatEvent(cmdTrigger,ScourgePlayer[3],"-stats",true)call TriggerRegisterPlayerChatEvent(cmdTrigger,ScourgePlayer[4],"-stats",true)call TriggerRegisterPlayerChatEvent(cmdTrigger,ScourgePlayer[5],"-stats",true)call TriggerRegisterPlayerChatEvent(cmdTrigger,SentinelPlayer[1],"-st",true)call TriggerRegisterPlayerChatEvent(cmdTrigger,SentinelPlayer[2],"-st",true)call TriggerRegisterPlayerChatEvent(cmdTrigger,SentinelPlayer[3],"-st",true)call TriggerRegisterPlayerChatEvent(cmdTrigger,SentinelPlayer[4],"-st",true)call TriggerRegisterPlayerChatEvent(cmdTrigger,SentinelPlayer[5],"-st",true)call TriggerRegisterPlayerChatEvent(cmdTrigger,ScourgePlayer[1],"-st",true)call TriggerRegisterPlayerChatEvent(cmdTrigger,ScourgePlayer[2],"-st",true)call TriggerRegisterPlayerChatEvent(cmdTrigger,ScourgePlayer[3],"-st",true)call TriggerRegisterPlayerChatEvent(cmdTrigger,ScourgePlayer[4],"-st",true)call TriggerRegisterPlayerChatEvent(cmdTrigger,ScourgePlayer[5],"-st",true)call TriggerAddCondition(cmdTrigger,Condition(function ShowKillBountyStatsOnCommand))set cmdTrigger=nullendfunctionfunction EnumConcoctionDamageAndSlow takes nothing returns nothingcall DamageTargetByType(ScaledAbilityCaster,GetEnumUnit(),DamageType2,ScaledDamageAmount)call CreateDummyCastScaledAbilityOnTarget(ScaledAbilityCaster,GetEnumUnit(),AbilityDuration)endfunctionfunction DetonateConcoctionAoe takes unit caster,unit targetUnit,real brewTime returns nothinglocal group nearbyGrouplocal integer abilityLevel=GetUnitAbilityLevel(caster,'A1NI')local real tempXlocal real tempYset ScaledAbilityCaster=casterset ScaledDamageAmount=(80+70*abilityLevel)*brewTime/ConcoctionMaxBrewTimeset AbilityDuration=(1+.75*abilityLevel)*brewTime/ConcoctionMaxBrewTimeset AbilityDummyUnit=CreateUnit(GetOwningPlayer(caster),'e00E',GetUnitX(targetUnit),GetUnitY(targetUnit),0)call AddPermanentAbility(AbilityDummyUnit,'A0X6')call SetUnitAbilityLevel(AbilityDummyUnit,'A0X6',MapDurationToAbilityLevel(AbilityDuration))call UnitApplyTimedLife(AbilityDummyUnit,'BTLF',1)set FilterReferenceUnit_2=casterset nearbyGroup=AcquireGroupFromPool()call GroupEnumUnitsInRange(nearbyGroup,GetUnitX(targetUnit),GetUnitY(targetUnit),175+25,Condition(function FilterAttackableEnemy))if GetUnitTypeId(targetUnit)!='h0BD' thencall GroupAddUnit(nearbyGroup,targetUnit)endifcall ForGroup(nearbyGroup,function EnumConcoctionDamageAndSlow)call ReleaseGroupToPool(nearbyGroup)call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\DemolisherFireMissile\\DemolisherFireMissile.mdl",GetUnitX(targetUnit),GetUnitY(targetUnit)))set nearbyGroup=nullendfunctionfunction OnConcoctionMissileTick takes nothing returns booleanlocal trigger whichTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(whichTrigger)local unit caster=(LoadUnitHandle(GameHashtable,(handleId),(2)))local unit targetUnit=(LoadUnitHandle(GameHashtable,(handleId),(17)))local unit missileUnit=(LoadUnitHandle(GameHashtable,(handleId),(45)))local real aoeDamage=(LoadReal(GameHashtable,(handleId),(444)))local real tempReal=(LoadReal(GameHashtable,(handleId),(445)))local real angle=AngleBetweenCoords(GetUnitX(missileUnit),GetUnitY(missileUnit),GetUnitX(targetUnit),GetUnitY(targetUnit))local real newX=GetUnitX(missileUnit)+18*Cos(angle*bj_DEGTORAD)local real newY=GetUnitY(missileUnit)+18*Sin(angle*bj_DEGTORAD)call SetUnitX(missileUnit,newX)call SetUnitY(missileUnit,newY)if DistanceBetweenCoords(newX,newY,GetUnitX(targetUnit),GetUnitY(targetUnit))<=18 thencall KillUnit(missileUnit)call DetonateConcoctionAoe(caster,targetUnit,aoeDamage)call FlushChildHashtable(GameHashtable,handleId)call RecycleExpiringTrigger(whichTrigger)endifset whichTrigger=nullset caster=nullset targetUnit=nullset missileUnit=nullreturn falseendfunctionfunction LaunchConcoctionMissile takes unit caster,unit targetUnit,real brewTime,real throwValue returns nothinglocal trigger tickTrigger=CreateTrigger()local integer handleId=GetHandleId(tickTrigger)local unit missileUnit=CreateUnit(GetOwningPlayer(caster),'h0BD',GetUnitX(caster),GetUnitY(caster),GetUnitFacing(caster))call SaveUnitHandle(GameHashtable,(handleId),(2),(caster))call SaveUnitHandle(GameHashtable,(handleId),(17),(targetUnit))call SaveUnitHandle(GameHashtable,(handleId),(45),(missileUnit))call SaveReal(GameHashtable,(handleId),(444),((brewTime)*1.0))call SaveReal(GameHashtable,(handleId),(445),((throwValue)*1.0))call TriggerRegisterTimerEvent(tickTrigger,.02,true)call TriggerAddCondition(tickTrigger,Condition(function OnConcoctionMissileTick))set tickTrigger=nullset missileUnit=nullendfunctionfunction FloatConcoctionCountdownText takes string labelText,unit anchorUnit,unit ownerUnit returns nothinglocal texttag textTag=CreateTextTag()call SetTextTagText(textTag,labelText,.033)call SetTextTagPosUnit(textTag,anchorUnit,64)call SetTextTagColor(textTag,255,0,0,255)call SetTextTagVelocity(textTag,0,.0355)call SetTextTagFadepoint(textTag,.15)call SetTextTagPermanent(textTag,false)call SetTextTagLifespan(textTag,.65)if IsUnitAlly(ownerUnit,GetLocalPlayer())or IsEitherKeyPlayerActive(GetLocalPlayer())thencall SetTextTagVisibility(textTag,true)elsecall SetTextTagVisibility(textTag,false)endifset textTag=nullendfunctionfunction FormatHalfSecondText takes real seconds returns stringif seconds>4.5 thenreturn"5.0"elseif seconds>4. thenreturn"4.5"elseif seconds>3.5 thenreturn"4.0"elseif seconds>3. thenreturn"3.5"elseif seconds>2.5 thenreturn"3.0"elseif seconds>2. thenreturn"2.5"elseif seconds>1.5 thenreturn"2.0"elseif seconds>1. thenreturn"1.5"elseif seconds>.5 thenreturn"1.0"elseif seconds>.0 thenreturn"0.5"elsereturn"0.0"endifreturn" "endfunctionfunction HandleConcoctionBrewState takes nothing returns booleanlocal trigger whichTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(whichTrigger)local unit caster=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local real startTime=(LoadReal(GameHashtable,(triggerId),(442)))local real currentTime=(TimerGetElapsed(GameClockTimer))local real remainingTime=5.-(currentTime-startTime)local real brewTime=RealMin(currentTime-startTime,5.)local integer tickCount=(LoadInteger(GameHashtable,(triggerId),(34)))+1if GetTriggerEventId()==EVENT_UNIT_DEATH thencall DetonateConcoctionAoe(caster,caster,ConcoctionMaxBrewTime)if(LoadInteger(GameHashtable,(GetHandleId(caster)),(704)))==0 or(LoadInteger(GameHashtable,(GetHandleId(caster)),(704)))=='A1NI' thencall SetPlayerAbilityAvailable(GetOwningPlayer(caster),'A1NI',true)endifcall SetPlayerAbilityAvailable(GetOwningPlayer(caster),'A1NH',false)call SetUnitVertexColor(caster,255,255,255,255)call DestroyEffect((LoadEffectHandle(GameHashtable,(triggerId),(32))))call FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(whichTrigger)elseif GetTriggerEventId()==EVENT_UNIT_SPELL_EFFECT thenif GetSpellAbilityId()=='A1NH' thenif HasAnyMarkedAbility(GetSpellTargetUnit())==false thencall LaunchConcoctionMissile(caster,GetSpellTargetUnit(),brewTime,startTime)endifif(LoadInteger(GameHashtable,(GetHandleId(caster)),(704)))==0 or(LoadInteger(GameHashtable,(GetHandleId(caster)),(704)))=='A1NI' thencall SetPlayerAbilityAvailable(GetOwningPlayer(caster),'A1NI',true)endifcall SetPlayerAbilityAvailable(GetOwningPlayer(caster),'A1NH',false)call SetUnitVertexColor(caster,255,255,255,255)call DestroyEffect((LoadEffectHandle(GameHashtable,(triggerId),(32))))call FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(whichTrigger)endifelsecall SaveInteger(GameHashtable,(triggerId),(34),(tickCount))if remainingTime>=0 thencall FloatConcoctionCountdownText(FormatHalfSecondText(remainingTime),caster,caster)if ModuloInteger(tickCount,2)==0 thencall SetUnitVertexColor(caster,255,125,125,255)elsecall SetUnitVertexColor(caster,255,175,175,255)endifelsecall SetUnitVertexColor(caster,255,0,0,255)endifif currentTime-startTime>(ConcoctionMaxBrewTime+.5)thencall DetonateConcoctionAoe(caster,caster,ConcoctionMaxBrewTime)if(LoadInteger(GameHashtable,(GetHandleId(caster)),(704)))==0 or(LoadInteger(GameHashtable,(GetHandleId(caster)),(704)))=='A1NI' thencall SetPlayerAbilityAvailable(GetOwningPlayer(caster),'A1NI',true)endifcall SetPlayerAbilityAvailable(GetOwningPlayer(caster),'A1NH',false)call SetUnitVertexColor(caster,255,255,255,255)call DestroyEffect((LoadEffectHandle(GameHashtable,(triggerId),(32))))call FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(whichTrigger)endifendifset whichTrigger=nullset caster=nullreturn falseendfunctionfunction OnCastConcoctionBeginBrew takes nothing returns nothinglocal unit castingUnit=GetTriggerUnit()local trigger whichTrigger=CreateTrigger()local integer handleId=GetHandleId(whichTrigger)local string modelPath="war3mapImported\\UnstableConcoctionRangeDisplay3.mdx"if GetLocalPlayer()!=GetOwningPlayer(castingUnit)thenset modelPath=""endifcall SaveUnitHandle(GameHashtable,(handleId),(2),(castingUnit))call SaveReal(GameHashtable,(handleId),(442),(((TimerGetElapsed(GameClockTimer)))*1.0))call SaveEffectHandle(GameHashtable,(handleId),(32),(AddSpecialEffectTarget(modelPath,castingUnit,"origin")))call TriggerRegisterTimerEvent(whichTrigger,.5,true)call TriggerRegisterUnitEvent(whichTrigger,castingUnit,EVENT_UNIT_SPELL_E