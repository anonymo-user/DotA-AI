ionfunction EnumBeginMagnetizePulse takes nothing returns nothingcall BeginMagnetizePulse(MagnetizePulseCaster,GetEnumUnit())endfunctionfunction CastMagnetizeAndSpread takes unit caster,unit targetUnit returns nothinglocal group enumGroup=AcquireGroupFromPool()local real targetX=GetUnitX(targetUnit)local real targetY=GetUnitY(targetUnit)local real searchRadius=300if GetUnitTypeId(targetUnit)=='o01X' thencall DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\DemolisherMissile\\DemolisherMissile.mdx",GetUnitX(targetUnit),GetUnitY(targetUnit)))call UnitApplyTimedLife(targetUnit,'BTLF',8)call SaveInteger(GameHashtable,(GetHandleId((targetUnit))),((4340)),(1))call SetUnitVertexColor(targetUnit,0,0,0,100)set searchRadius=600elsecall DestroyEffect(AddSpecialEffect("war3mapImported\\MagnetizeCastAoE.mdx",GetUnitX(targetUnit),GetUnitY(targetUnit)))endifset FilterReferenceUnit_2=casterset MagnetizePulseCaster=casterset MagnetizeTargetUnit=targetUnitcall GroupEnumUnitsInRange(enumGroup,targetX,targetY,searchRadius+25,Condition(function FilterAttackableEnemy))call ForGroup(enumGroup,function EnumBeginMagnetizePulse)call ReleaseGroupToPool(enumGroup)set caster=nullset enumGroup=nullendfunctionfunction SpreadMagnetizeToStoredTarget takes nothing returns nothingcall CastMagnetizeAndSpread(MagnetizePulseCaster,MagnetizeTargetUnit)endfunctionfunction OnCastMagnetizeA2TI takes nothing returns booleanif GetSpellAbilityId()=='A2TI' thencall CastMagnetizeAndSpread(GetTriggerUnit(),GetTriggerUnit())endifreturn falseendfunctionfunction RegisterMagnetizeSpell takes nothing returns nothinglocal trigger t=CreateTrigger()call RegisterPlayerUnitEventAllPlayers(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)call TriggerAddCondition(t,Condition(function OnCastMagnetizeA2TI))set t=nullendfunctionfunction OnDeathAnimHoldExpire takes nothing returns booleanlocal trigger holdTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(holdTrigger)local unit anim