dButtonByTag(AiGameCacheKey,hostPrefix+"|Btn04"))thencall ShowAiTargetPlayerDialog("-of",false)elseif(clickedButton==LoadButtonByTag(AiGameCacheKey,hostPrefix+"|Btn05"))thencall ShowAiLaneSelectDialog("-og",false)elseif(clickedButton==LoadButtonByTag(AiGameCacheKey,hostPrefix+"|Btn06"))thencall ShowAiLaneSelectDialog("-op",true)elseif(clickedButton==LoadButtonByTag(AiGameCacheKey,hostPrefix+"|Btn07"))thencall ShowAiRoshanNeutralDialog()endifcall FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(GetTriggeringTrigger())call DialogDestroy(GetClickedDialog())set clickedButton=nullendfunctionfunction ShowAiCommandMenu takes nothing returns nothinglocal dialog menuDialog=DialogCreate()local trigger clickTrigger=CreateTrigger()local string hostPrefix=""if(GetTriggerPlayer()==PendingSwapPlayerA)thenset hostPrefix="Sent"elseset hostPrefix="Scrg"endifcall DialogSetMessage(menuDialog,GetObjectName('Y043'))call StoreButtonByName(AiGameCacheKey,hostPrefix+"|Btn01",DialogAddButton(menuDialog,GetObjectName('Y044'),0))call StoreButtonByName(AiGameCacheKey,hostPrefix+"|Btn02",DialogAddButton(menuDialog,GetObjectName('Y045'),0))call StoreButtonByName(AiGameCacheKey,hostPrefix+"|Btn03",DialogAddButton(menuDialog,GetObjectName('Y046'),0))call StoreButtonByName(AiGameCacheKey,hostPrefix+"|Btn04",DialogAddButton(menuDialog,GetObjectName('Y047'),0))if(not FirstWaveSpawnedFlag)thencall StoreButtonByName(AiGameCacheKey,hostPrefix+"|Btn05",DialogAddButton(menuDialog,GetObjectName('Y048'),0))call StoreButtonByName(AiGameCacheKey,hostPrefix+"|Btn06",DialogAddButton(menuDialog,GetObjectName('Y084'),0))endifcall StoreButtonByName(AiGameCacheKey,hostPrefix+"|Btn07",DialogAddButton(menuDialog,GetObjectName('Y049'),0))call DialogAddButton(menuDialog,GetObjectName('Y050'),0)call StoreStringByName(GetHandleId(clickTrigger),"PlHost",hostPrefix)call TriggerRegisterDialogEvent(clickTrigger,menuDialog)call TriggerAddAction(clickTrigger,function OnAiCommandMenuClick)call DialogDisplay(GetTriggerPlayer(),menuDialog,true)set clickTrigger=nullendfunctionfunction SpawnRandomSpecialLaneCreeps takes nothing returns nothinglocal integer creepTypeRolllocal integer creepTypeIdlocal integer laneChoicelocal integer spawnCount=1local location sentinelSpawnLoc=nulllocal location scourgeSpawnLoc=nulllocal string creepName=""local string laneName=""if(ElapsedGameSeconds<150.)thenset creepTypeRoll=0elseif(ElapsedGameSeconds<1200.)thenset creepTypeRoll=GetRandomInt(1,2)elseset creepTypeRoll=GetRandomInt(1,3)endifif(creepTypeRoll==0)thenreturnelseif(creepTypeRoll==1)thenset creepTypeId='n003'set creepName="Siege Golems"elseif(creepTypeRoll==2)thenset creepTypeId='n00E'set creepName="Scary Fish"elseset creepTypeId='n00D'set creepName="Ancient Hydras"endifif(ElapsedGameSeconds>2400.)thenset spawnCount=spawnCount+1endifif FirstWaveSpawnedFlag thenset laneChoice=3elseset laneChoice=GetRandomInt(2,4)endifif(laneChoice==2)thenset sentinelSpawnLoc=SentinelCasterSpawnLaneCset scourgeSpawnLoc=ScourgeCasterSpawnLaneCset laneName="west"elseif(laneChoice==3)thenset sentinelSpawnLoc=SentinelCasterSpawnLaneAset scourgeSpawnLoc=ScourgeCasterSpawnLaneAset laneName="middle"elseif(laneChoice==4)thenset sentinelSpawnLoc=SentinelCasterSpawnLaneBset scourgeSpawnLoc=ScourgeCasterSpawnLaneBset laneName="east"endifcall CreateNUnitsAtLoc(spawnCount,creepTypeId,SentinelPlayer[0],sentinelSpawnLoc,bj_UNIT_FACING)call SetCreepGroupUpgradeLevel(bj_lastCreatedGroup,laneChoice)call CreateNUnitsAtLoc(spawnCount,creepTypeId,ScourgePlayer[0],scourgeSpawnLoc,bj_UNIT_FACING)call SetCreepGroupUpgradeLevel(bj_lastCreatedGroup,laneChoice)call DisplayTimedTextToForceMembers(bj_FORCE_ALL_PLAYERS,10.,"|c000000ff"+creepName+"|r spawned in the "+laneName+" path!")set sentinelSpawnLoc=nullset scourgeSpawnLoc=nullendfunctionfunction StoreEnemyTeamCompositionFlags takes boolean useSecondTeam,string cacheKeyPrefix,integer enemyHeroCount returns nothinglocal integer meleeCount=0local integer roleFiveCount=0local integer primaryRoleCount=0local boolean hasStrongHero=falselocal boolean hasKeyHero=falselocal integer slotIndex=1local integer heroTypeIdlocal player teamPlayerloopset teamPlayer=GetTeamPlayerBySlot(slotIndex,not useSecondTeam)if((IsPlayerSlotActive(teamPlayer))and(TrackedSideUnit[GetPlayerId(teamPlayer)]!=null))thenset heroTypeId=GetUnitTypeId(TrackedSideUnit[GetPlayerId(teamPlayer)])if((heroTypeId=='H00K')or(heroTypeId=='HC92')or(heroTypeId=='N0MD'))thenset hasKeyHero=trueelseif((heroTypeId=='Naka')or(heroTypeId=='E004')or(heroTypeId=='U000')or(heroTypeId=='N01V')or(heroTypeId=='U006')or(heroTypeId=='Hamg'))thenset hasStrongHero=trueendifif(IsUnitType(TrackedSideUnit[GetPlayerId(teamPlayer)],UNIT_TYPE_MELEE_ATTACKER))thenset meleeCount=meleeCount+1endifif(HeroMatchesRoleCategory(heroTypeId,HeroRoleCategoryFive))thenset roleFiveCount=roleFiveCount+1endifif(GetHeroPrimaryRoleFlag(heroTypeId)<=2)thenset primaryRoleCount=primaryRoleCount+1endifendifset slotIndex=slotIndex+1exitwhen slotIndex>5endloopif(hasKeyHero)thencall StoreBooleanByName(AiGameCacheKey,cacheKeyPrefix+"|G",true)call StoreBooleanByName(AiGameCacheKey,cacheKeyPrefix+"|W",true)elseif(hasStrongHero)thencall StoreBooleanByName(AiGameCacheKey,cacheKeyPrefix+"|W",true)endifif(meleeCount!=0)and((meleeCount==enemyHeroCount)or((enemyHeroCount>3)and(meleeCount>=3)))thencall StoreBooleanByName(AiGameCacheKey,cacheKeyPrefix+"|M",true)endifif(roleFiveCount!=0)and((roleFiveCount==enemyHeroCount)or((enemyHeroCount>3)and(roleFiveCount>=3)))thencall StoreBooleanByName(AiGameCacheKey,cacheKeyPrefix+"|X",true)endifif(enemyHeroCount>3 and roleFiveCount<=2)or(enemyHeroCount<=3 and roleFiveCount<enemyHeroCount)thencall StoreBooleanByName(AiGameCacheKey,cacheKeyPrefix+"|Xb",true)endifif(primaryRoleCount!=0)and((primaryRoleCount==enemyHeroCount)or((enemyHeroCount>3)and(primaryRoleCount>=3)))thencall StoreBooleanByName(AiGameCacheKey,cacheKeyPrefix+"|D",true)endifset teamPlayer=nullendfunctionfunction AnalyzeBothTeamCompositions takes nothing returns nothingcall RecycleExpiringTrigger(GetTriggeringTrigger())call StoreEnemyTeamCompositionFlags(true,"Sent",TeamTwoPlayerCount_2)call StoreEnemyTeamCompositionFlags(false,"Scrg",TeamOnePlayerCount_2)endfunctionfunction ApplyAiHeroXpHandicap takes player whichPlayer returns nothingif((GameModeFlagLT))thenelseif(AiAggressionLevel[GetPlayerId(whichPlayer)]==AiAggressionLow)thenif(not GameModeFlagBT)thencall SetPlayerHandicapXPBJ(whichPlayer,(GetPlayerHandicapXPBJ(whichPlayer)+30.))elsecall SetPlayerHandicapXPBJ(whichPlayer,(GetPlayerHandicapXPBJ(whichPlayer)+40.))endifelseif(AiAggressionLevel[GetPlayerId(whichPlayer)]==AiAggressionMedium)thenif(not GameModeFlagBT)thencall SetPlayerHandicapXPBJ(whichPlayer,(GetPlayerHandicapXPBJ(whichPlayer)+45.))elsecall SetPlayerHandicapXPBJ(whichPlayer,(GetPlayerHandicapXPBJ(whichPlayer)+80.))endifelseif(not GameModeFlagBT)thencall SetPlayerHandicapXPBJ(whichPlayer,(GetPlayerHandicapXPBJ(whichPlayer)+60.))elsecall SetPlayerHandicapXPBJ(whichPlayer,(GetPlayerHandicapXPBJ(whichPlayer)+110.))endifendifset AiAggressionLevel[16+GetPlayerId(whichPlayer)]=R2I(GetPlayerHandicapXPBJ(whichPlayer))endfunctionfunction SetupAiPlayerStartResources takes player whichPlayer,integer aiCount returns nothinglocal integer resourceFlags=0local integer playerId=GetPlayerId(whichPlayer)set PlayerItemGoldWorth[48+playerId]=GetRandomInt(0,1)if(AiSuppressModeFlag or AiRelatedGameModeFlag)thenset PlayerItemGoldWorth[48+playerId]=GetRandomInt(0,2)endifset PlayerItemGoldWorth[64+playerId]=GetRandomInt(0,2)set PlayerItemGoldWorth[80+playerId]=GetRandomInt(0,2)set PlayerModeVoteEnabled[playerId]=falsecall ForceRemovePlayer(ReplayRequestForce,whichPlayer)if InitGuardF7 thenset resourceFlags=resourceFlags+8endifif(GameModeFlagCT)thenset resourceFlags=resourceFlags+8endifif((GameModeFlagWT)or(aiCount==0))thenelseif(AiAggressionLevel[playerId]==AiAggressionLow)thencall SetPlayerStateBJ(whichPlayer,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(whichPlayer,PLAYER_STATE_RESOURCE_GOLD))elseif(AiAggressionLevel[playerId]==AiAggressionMedium)thencall SetPlayerStateBJ(whichPlayer,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(whichPlayer,PLAYER_STATE_RESOURCE_GOLD))set resourceFlags=resourceFlags+4elsecall SetPlayerStateBJ(whichPlayer,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(whichPlayer,PLAYER_STATE_RESOURCE_GOLD)+(500/aiCount)+(10*(aiCount-1)))set resourceFlags=resourceFlags+8endifif(GameModeFlagCT)thencall SetPlayerStateBJ(whichPlayer,PLAYER_STATE_RESOURCE_GOLD,R2I(GetPlayerState(whichPlayer,PLAYER_STATE_RESOURCE_GOLD)*1.2))endifset AiAggressionLevel[32+playerId]=resourceFlagsset AiAggressionLevel[48+playerId]=resourceFlagsset AiAggressionLevel[64+playerId]=0endfunctionfunction RegisterAiLeaderChatCommands takes trigger whichTrigger,boolean isSentinel,boolean showFullControl,boolean allowExtraCommands returns nothingif(SelectPlayerFromFirstPair(isSentinel)!=null)thencall TriggerRegisterPlayerChatEvent(whichTrigger,SelectPlayerFromFirstPair(isSentinel),"-o",false)call TriggerRegisterPlayerChatEvent(whichTrigger,SelectPlayerFromFirstPair(isSentinel),"-c",false)call TriggerRegisterPlayerChatEvent(whichTrigger,SelectPlayerFromFirstPair(isSentinel)," c",false)call TriggerRegisterPlayerChatEvent(whichTrigger,SelectPlayerFromFirstPair(isSentinel)," ",true)if(IsTriggerEnabled(AiControlToggleTrigger))thencall TriggerRegisterPlayerChatEvent(AiControlToggleTrigger,SelectPlayerFromFirstPair(isSentinel),"-pa",true)call TriggerRegisterPlayerChatEvent(AiControlToggleTrigger,SelectPlayerFromFirstPair(isSentinel),"-px",true)if((SelectPlayerFromFirstPair(not isSentinel)==null)and(allowExtraCommands))thenif(showFullControl)thencall DisplayTimedTextToPlayer(SelectPlayerFromFirstPair(isSentinel),0,0,10.,GetObjectName('Y100')+HighlightColorCode+"-pa|r/"+HighlightColorCode+"-pe|r")elsecall DisplayTimedTextToPlayer(SelectPlayerFromFirstPair(isSentinel),0,0,10.,GetObjectName('Y101')+HighlightColorCode+"-pe|r")endifcall TriggerRegisterPlayerChatEvent(AiControlToggleTrigger,SelectPlayerFromFirstPair(isSentinel),"-pe",true)elseif(showFullControl)thencall DisplayTimedTextToPlayer(SelectPlayerFromFirstPair(isSentinel),0,0,10.,GetObjectName('Y102')+HighlightColorCode+"-pa|r")endifendifendifendfunctionfunction ClearAiFountainStateWhenAway takes nothing returns nothinglocal integer i=0loopexitwhen i>15if TrackedSideUnit[i]!=null and GetPlayerController(Player(i))==MAP_CONTROL_COMPUTER and IsUnitInRange(TrackedSideUnit[i],SentinelBaseStructure,1000)==false and IsUnitInRange(TrackedSideUnit[i],ScourgeFountain,1000)==false thenset PlayerItemStateData[176+i]=0endifset i=i+1endloopendfunctionfunction RegisterFountainProximityTriggers takes nothing returns nothinglocal trigger tset t=CreateTrigger()call TriggerRegisterUnitInRange(t,ScourgeFountain,700.,null)call TriggerAddCondition(t,Condition(function IsTriggerAiUnitAllyOfSideB))call TriggerAddAction(t,function OnUnitEnterFountainRegion)set t=CreateTrigger()call TriggerRegisterUnitInRange(t,SentinelBaseStructure,700.,null)call TriggerAddCondition(t,Condition(function IsTriggerAiUnitAllyOfSideA))call TriggerAddAction(t,function OnUnitEnterFountainRegion)set t=CreateTrigger()call TriggerRegisterTimerEvent(t,10,true)call TriggerAddAction(t,function ClearAiFountainStateWhenAway)set t=nullendfunctionfunction OnAiLeadershipGrantCommand takes nothing returns nothinglocal trigger chatTrigger=nulllocal string chatString=GetEventPlayerChatString()local player grantedPlayer=PlayerFromSlotIndex(S2I(SubString(chatString,8,StringLength(chatString))))if(grantedPlayer!=null)and(grantedPlayer!=GetTriggerPlayer())and IsPlayerPlayingUser(grantedPlayer)thenif GetTriggerPlayer()==PendingSwapPlayerA thenif IsPlayerAlly(GetLocalPlayer(),PendingSwapPlayerA)thencall DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,10.,PlayerColorCode[0]+"The Sentinel|r's AI leadership has been granted to "+PlayerColorCode[GetPlayerId(grantedPlayer)]+GetPlayerName(grantedPlayer)+"|r.")endifset PendingSwapPlayerA=grantedPlayerset chatTrigger=GetTriggeringTrigger()call RecycleExpiringTrigger(chatTrigger)set chatTrigger=CreateTrigger()call TriggerRegisterPlayerChatEvent(chatTrigger,PendingSwapPlayerA,"-aigrant",false)call TriggerAddAction(chatTrigger,function OnAiLeadershipGrantCommand)call RecycleExpiringTrigger(AiLeaderControlChatTriggerA)set AiLeaderControlChatTriggerA=CreateTrigger()call RegisterAiLeaderChatCommands(AiLeaderControlChatTriggerA,true,false,false)call TriggerAddAction(AiLeaderControlChatTriggerA,function OnChatRunAiControlCommand)elseif IsPlayerAlly(GetLocalPlayer(),PendingSwapPlayerB)thencall DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,10.,PlayerColorCode[6]+"The Scourge|r's AI leadership has been granted to "+PlayerColorCode[GetPlayerId(grantedPlayer)]+GetPlayerName(grantedPlayer)+"|r.")endifset PendingSwapPlayerB=grantedPlayerset chatTrigger=GetTriggeringTrigger()call RecycleExpiringTrigger(chatTrigger)set chatTrigger=CreateTrigger()call TriggerRegisterPlayerChatEvent(chatTrigger,PendingSwapPlayerB,"-aigrant",false)call TriggerAddAction(chatTrigger,function OnAiLeadershipGrantCommand)call RecycleExpiringTrigger(AiLeaderControlChatTriggerB)set AiLeaderControlChatTriggerB=CreateTrigger()call RegisterAiLeaderChatCommands(AiLeaderControlChatTriggerB,false,false,false)call TriggerAddAction(AiLeaderControlChatTriggerB,function OnChatRunAiControlCommand)endifelsecall ShowErrorMessageToPlayer(GetTriggerPlayer(),"Invalid Leader Choice")endifendfunctionfunction OnB031ReturnDamageAccumulate takes nothing returns booleanlocal trigger damageTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(damageTrigger)local unit caster=(LoadUnitHandle(GameHashtable,(triggerId),(2)))local integer targetSlot=(LoadInteger(GameHashtable,(triggerId),(30)))local unit target=UnitByIndex(targetSlot)local real storedDamage=(LoadReal(GameHashtable,(triggerId),(20)))if GetTriggerEventId()!=EVENT_UNIT_DAMAGED or GetUnitAbilityLevel(GetTriggerUnit(),'B031')==0 thencall DestroyEffect((LoadEffectHandle(GameHashtable,(triggerId),(32))))call ClearUnitHandleSlot(targetSlot)call FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(damageTrigger)set DamageEventGuard=truecall DamageTargetByType(caster,target,DamageType1,storedDamage)set DamageEventGuard=falseif storedDamage>0 thencall CreateTimedTextTagOnUnit("+"+I2S(R2I(storedDamage)),1,target,.023,255,0,0,216)endifelseif GetEventDamage()>1 and DamageEventGuard==false thencall SaveReal(GameHashtable,(triggerId),(20),((storedDamage+GetEventDamage()*0.3)*1.0))endifset damageTrigger=nullset caster=nullset target=nullreturn falseendfunctionfunction BeginB031ReturnDamageMark takes nothing returns booleanlocal trigger triggeringTrigger=GetTriggeringTrigger()local integer triggerHandleId=GetHandleId(triggeringTrigger)local unit casterUnit=(LoadUnitHandle(GameHashtable,(triggerHandleId),(2)))local unit targetUnit=(LoadUnitHandle(GameHashtable,(triggerHandleId),(17)))call FlushChildHashtable(GameHashtable,triggerHandleId)call RecycleExpiringTrigger(triggeringTrigger)set triggeringTrigger=CreateTrigger()set triggerHandleId=GetHandleId(triggeringTrigger)call SaveUnitHandle(GameHashtable,(triggerHandleId),(2),(casterUnit))call SaveInteger(GameHashtable,(triggerHandleId),(30),(RegisterUnitHandleSlot(targetUnit)))call SaveEffectHandle(GameHashtable,(triggerHandleId),(32),(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Silence\\SilenceTarget.mdl",targetUnit,"overhead")))call SaveReal(GameHashtable,(triggerHandleId),(20),((0)*1.0))call TriggerRegisterUnitEvent(triggeringTrigger,targetUnit,EVENT_UNIT_DAMAGED)call TriggerRegisterTimerEvent(triggeringTrigger,5,false)call TriggerAddCondition(triggeringTrigger,Condition(function OnB031ReturnDamageAccumulate))set triggeringTrigger=nullreturn falseendfunctionfunction ScheduleB031ReturnDamageMark takes nothing returns nothinglocal trigger scheduleTrigger=CreateTrigger()local integer triggerId=GetHandleId(scheduleTrigger)call TriggerRegisterTimerEvent(scheduleTrigger,0,false)call TriggerAddCondition(scheduleTrigger,Condition(function BeginB031ReturnDamageMark))call SaveUnitHandle(GameHashtable,(triggerId),(17),(GetSpellTargetUnit()))call SaveUnitHandle(GameHashtable,(triggerId),(2),(GetTriggerUnit()))set scheduleTrigger=nullendfunctionfunction OnCastA0FDApplyDamageMark takes nothing returns nothingif GetSpellAbilityId()=='A0FD' and HasAnyMarkedAbility(GetSpellTargetUnit())==false thencall ScheduleB031ReturnDamageMark()endifendfunctionfunction DisassembleItemIntoComponents takes nothing returns nothinglocal unit triggerUnit=GetTriggerUnit()local item slotItemlocal integer slotIndex=0local real posX=GetUnitX(triggerUnit)local real posY=GetUnitY(triggerUnit)local integer itemTypeIndexlocal item componentItemcall DisableTrigger(ToggleableTrigger)loopexitwhen slotIndex>5set slotItem=UnitItemInSlot(triggerUnit,slotIndex)set itemTypeIndex=FindItemTypeIndexAllTables(slotItem)if itemTypeIndex==ItemIndexCost1750 thenset ItemOwnerPlayer_2=GetItemPlayer(slotItem)call RemoveItem(slotItem)set componentItem=CreateItem(ItemTypeIdTableA[ItemIndexCost875],posX,posY)call SetItemPlayer(componentItem,ItemOwnerPlayer_2,false)call SetItemUserData(componentItem,1)set componentItem=CreateItem(ItemTypeIdTableA[ItemIndexCost875_2],posX,posY)call SetItemPlayer(componentItem,ItemOwnerPlayer_2,false)call SetItemUserData(componentItem,1)elseif itemTypeIndex==ItemIndexCost525A or itemTypeIndex==ItemIndexCost525B thenset ItemOwnerPlayer_2=GetItemPlayer(slotItem)call RemoveItem(slotItem)set componentItem=CreateItem(ItemTypeIdTableA[ItemIndexCost200],posX,posY)call 