ble,(handleId),(14)))local real lastX=(LoadReal(GameHashtable,(handleId),(23)))local real lastY=(LoadReal(GameHashtable,(handleId),(24)))local boolean isEnhanced=(LoadBoolean(GameHashtable,(handleId),(15)))local integer abilityLevel=(LoadInteger(GameHashtable,(handleId),(5)))local integer ringIndex=(LoadInteger(GameHashtable,(handleId),(25)))local integer maxRings=4+abilityLevel*2local real currentX=lastXlocal real currentY=lastYif isEnhanced thenset maxRings=maxRings+2endifif ringIndex>maxRings thencall FlushChildHashtable(GameHashtable,handleId)call RecycleExpiringTrigger(whichTrigger)elseif casterUnit!=null and IsUnitDeadOrInvalid(casterUnit)==false thenset currentX=GetUnitX(casterUnit)set currentY=GetUnitY(casterUnit)endifcall EmitExpandingWaveRing(casterUnit,currentX,currentY,abilityLevel,ringIndex)call SaveInteger(GameHashtable,(handleId),(25),(ringIndex+1))call SaveReal(GameHashtable,(handleId),(23),((currentX)*1.0))call SaveReal(GameHashtable,(handleId),(24),((currentY)*1.0))endifset whichTrigger=nullset ownerPlayer=nullset casterUnit=nullreturn falseendfunctionfunction CastExpandingWaveRingsA06R takes nothing returns nothinglocal unit caster=GetTriggerUnit()local player castingPlayer=GetOwningPlayer(caster)local trigger tickTrigger=CreateTrigger()local integer handleId=GetHandleId(tickTrigger)local integer abilityLevel=GetUnitAbilityLevel(caster,'A06R')local boolean usedAltAbility=falseif abilityLevel==0 thenset usedAltAbility=trueset abilityLevel=GetUnitAbilityLevel(caster,'A1B4')endifif IsPlayerOnTeamZero(castingPlayer)thenset PlayerDummyCasterA17B[GetPlayerId(castingPlayer)]=CreateUnit(ScourgePlayer[0],'e00E',GetUnitX(caster),GetUnitY(caster),0)elseset PlayerDummyCasterA17B[GetPlayerId(castingPlayer)]=CreateUnit(SentinelPlayer[0],'e00E',GetUnitX(caster),GetUnitY(caster),0)endifcall AddPermanentAbility(PlayerDummyCasterA17B[GetPlayerId(castingPlayer)],'A17B')call SaveUnitHandle(GameHashtable,(handleId),(14),(