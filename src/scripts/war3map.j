endloopreturn bestSlotendfunctionfunction GetHeroAttackRange takes unit hero returns reallocal integer unitTypeId=GetUnitTypeId(hero)if(unitTypeId=='Usyl')thenreturn 550.+I2R(100*GetUnitAbilityLevel(hero,'A03U'))elseif((unitTypeId=='H000')or(unitTypeId=='Harf')or(unitTypeId=='Npbm')or(unitTypeId=='Hamg')or(unitTypeId=='H008')or(unitTypeId=='O00J')or(unitTypeId=='U00C')or(unitTypeId=='U008')or(unitTypeId=='Udre')or(unitTypeId=='N00R')or(unitTypeId=='UC91')or(unitTypeId=='H00R')or(unitTypeId=='Edem')or(unitTypeId=='Nbbc')or(unitTypeId=='HC49')or(unitTypeId=='Ogrh')or(unitTypeId=='H00I')or(unitTypeId=='Huth')or(unitTypeId=='Hvsh')or(unitTypeId=='Ewar')or(unitTypeId=='Eevi')or(unitTypeId=='E01B')or(unitTypeId=='Hmkg')or(unitTypeId=='H00T')or(unitTypeId=='HC92')or(unitTypeId=='H06S')or(unitTypeId=='Otch')or(unitTypeId=='N01I')or(unitTypeId=='U00K')or(unitTypeId=='U00F')or(unitTypeId=='Naka')or(unitTypeId=='EC45')or(unitTypeId=='U000')or(unitTypeId=='O015')or(unitTypeId=='H071')or(unitTypeId=='E02I')or(unitTypeId=='N0M0')or(unitTypeId=='E02K')or(unitTypeId=='E032')or(unitTypeId=='Udea')or(unitTypeId=='Hlgr')or(unitTypeId=='H00D')or(unitTypeId=='H001')or(unitTypeId=='Ucrl')or(unitTypeId=='U01X')or(unitTypeId=='UC11')or(unitTypeId=='Ofar')or(unitTypeId=='Opgh')or(unitTypeId=='U00A')or(unitTypeId=='NC00')or(unitTypeId=='H00N')or(unitTypeId=='U006'))thenreturn 128.elseif((unitTypeId=='UC42')or(unitTypeId=='H0ES'))thenreturn 150.elseif((unitTypeId=='O00P')or(unitTypeId=='Hmbr'))thenreturn 350.elseif((unitTypeId=='H00Q')or(unitTypeId=='E00P'))thenreturn 400.elseif(unitTypeId=='Ubal')or(unitTypeId=='N0M7')thenreturn 425.elseif((unitTypeId=='EC57')or(unitTypeId=='U00P'))thenreturn 450.elseif(unitTypeId=='E002')thenreturn 475.elseif(unitTypeId=='H00S')thenreturn 480.elseif((unitTypeId=='Nfir')or(unitTypeId=='Ntin')or(unitTypeId=='Orkn')or(unitTypeId=='N01W'))thenreturn 500.elseif(unitTypeId=='N01O')or(unitTypeId=='Emoo')or(unitTypeId=='UC01')or(unitTypeId=='N00B')thenreturn 550.elseif(unitTypeId=='EC77')thenreturn 575.elseif((unitTypeId=='N01V')or(unitTypeId=='Nbrn')or(unitTypeId=='E004')or(unitTypeId=='H00A')or(unitTypeId=='N01A'))or(unitTypeId=='Ekee')or(unitTypeId=='E01A')or(unitTypeId=='UC76')or(unitTypeId=='UC18')or(unitTypeId=='H00U')or(unitTypeId=='U00E')or(unitTypeId=='H00H')or(unitTypeId=='E01C')or(unitTypeId=='N0HP')or(unitTypeId=='E02X')or(unitTypeId=='H0DO')thenreturn 600.elseif(unitTypeId=='N0MK')or(unitTypeId=='H00K')or(unitTypeId=='H004')or((unitTypeId=='H00V')or(unitTypeId=='H08D')or(unitTypeId=='H08C')or(unitTypeId=='H084')or(unitTypeId=='H08B'))thenreturn 625.elsereturn 128.endifendfunctionfunction AssignLaneTargetByTeam takes unit unit_2,integer slotIndex returns nothingif(IsUnitAlly(unit_2,SentinelPlayer[0]))thenif AiSelectionCountData[64+slotIndex]==0 thenset AiAssignedUnit[64+slotIndex]=CandidateUnitByIndex[2]elseif AiSelectionCountData[64+slotIndex]==1 thenset AiAssignedUnit[64+slotIndex]=CandidateUnitByIndex[4]elseif AiSelectionCountData[64+slotIndex]==2 thenset AiAssignedUnit[64+slotIndex]=CandidateUnitByIndex[3]elseif AiSelectionCountData[64+slotIndex]==3 thenset AiAssignedUnit[64+slotIndex]=CandidateUnitByIndex[1]endifelseif AiSelectionCountData[64+slotIndex]==0 thenset AiAssignedUnit[64+slotIndex]=CandidateUnitByIndex['f']elseif AiSelectionCountData[64+slotIndex]==1 thenset AiAssignedUnit[64+slotIndex]=CandidateUnitByIndex['g']elseif AiSelectionCountData[64+slotIndex]==2 thenset AiAssignedUnit[64+slotIndex]=CandidateUnitByIndex['h']elseif AiSelectionCountData[64+slotIndex]==3 thenset AiAssignedUnit[64+slotIndex]=CandidateUnitByIndex['e']endifendifendfunctionfunction IsGroupEmpty takes group group_2 returns booleanreturn FirstOfGroup(group_2)==nullendfunctionfunction EnablePlayerAbilityPair takes integer flagIndex,unit unit_2,integer firstAbility,integer secondAbility returns booleancall SetPlayerAbilityAvailable(GetOwningPlayer(unit_2),firstAbility,true)call SetPlayerAbilityAvailable(GetOwningPlayer(unit_2),secondAbility,true)return trueendfunctionfunction MarkFlagTrue takes integer flagIndex returns booleanset AiSlotBoolFlagGZ[flagIndex]=truereturn trueendfunctionfunction PolledWait_2 takes real duration returns nothinglocal real remaininglocal real startElapsed=TimerGetElapsed(GameClockTimer)if startElapsed<=0 thenset GameClockTimer=CreateTimer()call TimerStart(GameClockTimer,9000,false,null)endifif(duration>0)thenloopset remaining=duration-TimerGetElapsed(GameClockTimer)+startElapsedexitwhen remaining<=0if(remaining>bj_POLLED_WAIT_SKIP_THRESHOLD)thencall TriggerSleepAction(.1*remaining)elsecall TriggerSleepAction(bj_POLLED_WAIT_INTERVAL)endifendloopendifendfunctionfunction IsUnitFacingWidgetWithin takes unit whichUnit,widget targetWidget,real angleTolerance returns booleanlocal real angleDiff=(GetUnitFacing(whichUnit)-bj_RADTODEG*Atan2(GetWidgetY(targetWidget)-GetUnitY(whichUnit),GetWidgetX(targetWidget)-GetUnitX(whichUnit)))call DebugPrintGlobal(R2S(GetUnitFacing(whichUnit))+" "+R2S(bj_RADTODEG*Atan2(GetWidgetY(targetWidget)-GetUnitY(whichUnit),GetWidgetX(targetWidget)-GetUnitX(whichUnit))))if angleDiff>180 thenset angleDiff=360-angleDiffendifif angleDiff<0 thenset angleDiff=-angleDiffendifcall DebugPrintGlobal(R2S(angleDiff))return angleDiff<=angleToleranceendfunctionfunction DistanceBetweenWidgets takes widget widgetA,widget widgetB returns reallocal real widgetAX=GetWidgetX(widgetA)local real widgetAY=GetWidgetY(widgetA)local real widgetBX=GetWidgetX(widgetB)local real widgetBY=GetWidgetY(widgetB)if widgetA==null or widgetB==null thenreturn 9999999999.elsereturn SquareRoot((widgetAX-widgetBX)*(widgetAX-widgetBX)+(widgetAY-widgetBY)*(widgetAY-widgetBY))endifreturn 1.0endfunctionfunction DistanceBetweenCoords takes real fromX,real fromY,real targetX,real targetY returns realreturn SquareRoot(((fromX-targetX)*(fromX-targetX))+((fromY-targetY)*(fromY-targetY)))endfunctionfunction GetLaneRoleIndex takes integer playerId returns integerlocal integer roleIndex=3if((PlayerSkillData[256+playerId]==18)or(PlayerSkillData[playerId]==10)or(PlayerSkillData[256+playerId]=='v')or(PlayerSkillData[playerId]=='n'))thenset roleIndex=0elseif((PlayerSkillData[256+playerId]==40)or(PlayerSkillData[playerId]==30)or(PlayerSkillData[256+playerId]==140)or(PlayerSkillData[playerId]==130))thenset roleIndex=1elseif((PlayerSkillData[256+playerId]==60)or(PlayerSkillData[playerId]==50)or(PlayerSkillData[256+playerId]==160)or(PlayerSkillData[playerId]==150))thenset roleIndex=2endifreturn roleIndexendfunctionfunction GetUnitLaneRoleIndex takes unit whichUnit returns integerlocal integer playerId=GetPlayerId(GetOwningPlayer(whichUnit))local integer unitTypeData=GetUnitUserData(AiAssignedUnit[playerId])if((unitTypeData==0)or(unitTypeData==100)or(unitTypeData==1)or(unitTypeData=='e'))thenset unitTypeData=GetUnitUserData(AiSurroundTargetUnit[playerId])endifreturn GetLaneRoleIndex(unitTypeData)endfunctionfunction EvaluateHeroLaneAssignment takes integer playerId returns integerset PlayerLaneRole[80+playerId]=5if PlayerHeroDead[playerId]thenelseif(DistanceBetweenWidgets(TrackedSideUnit[playerId],CandidateUnitByIndex[0])<4000.)thenset PlayerLaneRole[80+playerId]=3elseif(DistanceBetweenWidgets(TrackedSideUnit[playerId],CandidateUnitByIndex[100])<4000.)thenset PlayerLaneRole[80+playerId]=4elseif IsUnitInRange(TrackedSideUnit[playerId],AiAssignedUnit[playerId],2000.)thenset PlayerLaneRole[80+playerId]=GetLaneRoleIndex(GetUnitUserData(AiAssignedUnit[playerId]))if PlayerLaneRole[80+playerId]==3 thenset PlayerLaneRole[80+playerId]=5endifelseif IsUnitInRange(TrackedSideUnit[playerId],AiAssignedUnit[80+playerId],2000.)thenset PlayerLaneRole[80+playerId]=GetLaneRoleIndex(GetUnitUserData(AiAssignedUnit[80+playerId]))if PlayerLaneRole[80+playerId]==3 thenset PlayerLaneRole[80+playerId]=5endifelseset PlayerLaneRole[80+playerId]=5set AiSlotBoolFlagGZ[400+playerId]=trueendifreturn PlayerLaneRole[80+playerId]endfunctionfunction LookupValueForKey takes integer unitTypeKey returns integerlocal integer index=0loopexitwhen index>HeroPoolLoopBoundCif ScaledUnitType[index]==unitTypeKey thenreturn RestrictedTechId[index]endifset index=index+1endloopreturn-1endfunctionfunction GetHeroLevelValue takes unit hero returns integerlocal integer heroLevel=GetHeroLevel(hero)if heroLevel==1 thenreturn 100elseif heroLevel==2 thenreturn 120elseif heroLevel==3 thenreturn 160elseif heroLevel==4 thenreturn 220elsereturn-200+100*heroLevelendifreturn 0endfunctionfunction GetElapsedGameTime takes nothing returns realreturn TimerGetElapsed(GameClockTimer)endfunctionfunction ForceStopUnit takes unit unit_2 returns nothingcall PauseUnit(unit_2,true)call IssueImmediateOrderById(unit_2,851972)call PauseUnit(unit_2,false)endfunctionfunction PolarOffsetLocation takes location origin,real distance,real angle returns locationreturn Location(GetLocationX(origin)+distance*Cos(angle*bj_DEGTORAD),GetLocationY(origin)+distance*Sin(angle*bj_DEGTORAD))endfunctionfunction FilterDestructableInRange takes nothing returns booleanlocal real deltaX=GetDestructableX(GetFilterDestructable())-DestructableFilterOriginXlocal real deltaY=GetDestructableY(GetFilterDestructable())-DestructableFilterOriginYreturn(deltaX*deltaX+deltaY*deltaY<=bj_enumDestructableRadius)endfunctionfunction BuildEnemyForceOf_2 takes player player_2 returns forceset TempEnemyForce=CreateForce()call ForceEnumEnemies(TempEnemyForce,player_2,AlwaysTrueFilter)return TempEnemyForceendfunctionfunction IsUnitTypeInSetA takes unit unit_2 returns booleanlocal integer unitTypeId=GetUnitTypeId(unit_2)return unitTypeId==UnitTypeIdN00I or unitTypeId==UnitTypeIdN022 or unitTypeId==UnitTypeIdN021 or unitTypeId==UnitTypeIdN0KY or unitTypeId==NeutralUnitTypeN0KZ or unitTypeId==NeutralUnitTypeN0LE or unitTypeId==NeutralUnitTypeN023 or unitTypeId==NeutralUnitTypeN024 or unitTypeId==NeutralUnitTypeN025 or unitTypeId==NeutralUnitTypeN0L0 or unitTypeId==NeutralUnitTypeN0L1 or unitTypeId==NeutralUnitTypeN0M4 or unitTypeId==ScaledUnitTypeN00M or unitTypeId==NeutralUnitTypeN0HV or unitTypeId==ScaledUnitTypeN0LSendfunctionfunction IsUnitTypeInSetB takes unit unit_2 returns booleanlocal integer unitTypeId=GetUnitTypeId(unit_2)return unitTypeId==UnitTypeIdE01H or unitTypeId==ElfUnitTypeE01Z or unitTypeId==ScaledUnitTypeE02R or unitTypeId==ScaledUnitTypeE02T or unitTypeId==ScaledUnitTypeE02S or unitTypeId==ScaledUnitTypeE030endfunctionfunction IsUnitTypeInEitherSet takes unit unit_2 returns booleanreturn IsUnitTypeInSetA(unit_2)or IsUnitTypeInSetB(unit_2)endfunctionfunction RemoveItemSilently takes item itemToRemove returns nothingcall DisableTrigger(ToggleableTrigger)call RemoveItem(itemToRemove)call EnableTrigger(ToggleableTrigger)endfunctionfunction FindItemTypeIndexAllTables takes item whichItem returns integerlocal integer itemTypeIdlocal integer tableIndex=1if whichItem==null thenreturn-2endifset itemTypeId=GetItemTypeId(whichItem)loopexitwhen tableIndex>ItemTypeIndexCounterif ItemTypeIdTableA[tableIndex]==itemTypeId or ItemTypeId[tableIndex]==itemTypeId or ItemTypeIdTableC[tableIndex]==itemTypeId thenreturn tableIndexendifset tableIndex=tableIndex+1endloopreturn-1endfunctionfunction FindItemTypeIndexBaseTables takes item whichItem returns integerlocal integer itemTypeIdlocal integer tableIndex=1if whichItem==null thenreturn-2endifset itemTypeId=GetItemTypeId(whichItem)loopexitwhen tableIndex>ItemTypeIndexCounterif ItemTypeIdTableA[tableIndex]==itemTypeId or ItemTypeId[tableIndex]==itemTypeId thenreturn tableIndexendifset tableIndex=tableIndex+1endloopreturn-1endfunctionfunction FindItemTypeIndexLuTable takes item whichItem returns integerlocal integer itemTypeIdlocal integer tableIndex=1if whichItem==null thenreturn-2endifset itemTypeId=GetItemTypeI