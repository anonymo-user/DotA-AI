andomPoolValue()endfunctionfunction EnumRemovePickSelectorUnits takes nothing returns nothingif(GetUnitTypeId(GetEnumUnit())=='n004')thencall RemoveUnit(GetEnumUnit())endifif(GetUnitTypeId(GetEnumUnit())=='o003')thencall RemoveUnit(GetEnumUnit())endifendfunctionfunction ApplyMirrorMatchHeroes takes nothing returns booleanlocal integer loopIndexlocal group heroGroup=AcquireGroupFromPool()local unit tempHerolocal location baseCenterB=GetRectCenter(BaseCenterRectB)local location baseCenterA=GetRectCenter(BaseCenterRectA)local integer teamOneCount=CountForcePlayersPassingFilter(TeamOneForce)local player array sentinelPlayerslocal player array scourgePlayerslocal integer sentinelIndexlocal integer scourgeIndexlocal real spawnXlocal real spawnYlocal real spawnFacinglocal integer heroTypeIdlocal group worldUnits=UnitsInRect(GetWorldBounds(),null)call ForGroup(worldUnits,function EnumRemovePickSelectorUnits)call ReleaseGroupToPool(worldUnits)set loopIndex=1set sentinelIndex=1set scourgeIndex=1loopexitwhen loopIndex>5if(IsPlayerSlotActive(SentinelPlayer[loopIndex]))thencall StoreHeroInventoryItems(TrackedSideUnit[GetPlayerId(SentinelPlayer[loopIndex])])call GroupAddUnit(heroGroup,TrackedSideUnit[GetPlayerId(SentinelPlayer[loopIndex])])set sentinelPlayers[sentinelIndex]=SentinelPlayer[loopIndex]set sentinelIndex=sentinelIndex+1endifif(IsPlayerSlotActive(ScourgePlayer[loopIndex]))thencall StoreHeroInventoryItems(TrackedSideUnit[GetPlayerId(ScourgePlayer[loopIndex])])call GroupAddUnit(heroGroup,TrackedSideUnit[GetPlayerId(ScourgePlayer[loopIndex])])set scourgePlayers[scourgeIndex]=ScourgePlayer[loopIndex]set scourgeIndex=scourgeIndex+1endifset loopIndex=loopIndex+1endloopset sentinelIndex=1loopexitwhen sentinelIndex>teamOneCountset heroTypeId=PickMirrorHeroForPlayerPair(sentinelPlayers[sentinelIndex],scourgePlayers[sentinelIndex])if(TrackedSideUnit[GetPlayerId(sentinelPlayers[sentinelIndex])]==null)thenset spawnX=GetLocationX(