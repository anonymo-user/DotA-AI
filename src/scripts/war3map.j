erName[GetPlayerId((GetTriggerPlayer()))])+"|r's never gonna say goodbye")elseif lyricIndex==7 thencall DisplayTimedTextToForceMembers(ReplayRequestForce,5,PlayerColorCode[GetPlayerId(GetTriggerPlayer())]+(PlayerName[GetPlayerId((GetTriggerPlayer()))])+"|r's never gonna tell a lie")elseif lyricIndex==8 thencall DisplayTimedTextToForceMembers(ReplayRequestForce,5,PlayerColorCode[GetPlayerId(GetTriggerPlayer())]+(PlayerName[GetPlayerId((GetTriggerPlayer()))])+"|r's never gonna hurt you")endifendfunctionfunction OnSleepUnitOrderRemoveEffect takes nothing returns booleanlocal trigger whichTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(whichTrigger)call DestroyEffect((LoadEffectHandle(GameHashtable,(triggerId),(32))))set whichTrigger=nullreturn falseendfunctionfunction StartHeroSleepAnimation takes nothing returns nothinglocal trigger whichTrigger=CreateTrigger()local integer triggerId=GetHandleId(whichTrigger)local unit hero=TrackedSideUnit[GetPlayerId(GetTriggerPlayer())]call SaveEffectHandle(GameHashtable,(triggerId),(32),(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\Sleep\\SleepTarget.mdl",hero,"overhead")))call TriggerRegisterUnitEvent(whichTrigger,hero,EVENT_UNIT_ISSUED_ORDER)call TriggerRegisterUnitEvent(whichTrigger,hero,EVENT_UNIT_ISSUED_TARGET_ORDER)call TriggerRegisterUnitEvent(whichTrigger,hero,EVENT_UNIT_ISSUED_POINT_ORDER)call TriggerAddCondition(whichTrigger,Condition(function OnSleepUnitOrderRemoveEffect))call SetUnitAnimation(hero,"sleep")set whichTrigger=nullset hero=nullendfunctionfunction PlayHeroCalmAnimation takes nothing returns nothingcall SetUnitAnimationByIndex(TrackedSideUnit[GetPlayerId(GetTriggerPlayer())],23)endfunctionfunction ActivateHeroTipsSystem takes nothing returns nothingif PlayerFlagQT[GetPlayerId(GetTriggerPlayer())]==false thenset PlayerFlagQT[GetPlayerId(GetTriggerPlayer())]=trueif(GetObjectName(('n0HH')))=="Language: English" thencall DisplayTimedTextToPlayer(GetTriggerP