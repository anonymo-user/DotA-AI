VENT_WIDGET_DEATH thencall FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(expireTrigger)set ItemOwnerPlayer=ownerPlayerset ItemReceiverUnit=receiverUnitset ItemGrantTargetUnit=grantTargetUnitcall EnumItemsInRect(searchRect,Condition(function FilterAlwaysTrue),function EnumAddVisiblePlayerItemToStash)elseif GetTriggerEvalCount(expireTrigger)>9 thencall FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(expireTrigger)set ItemOwnerPlayer=ownerPlayerset ItemReceiverUnit=receiverUnitset ItemGrantTargetUnit=grantTargetUnitcall EnumItemsInRect(searchRect,Condition(function FilterAlwaysTrue),function EnumAddVisiblePlayerItemToStash)elseset ItemOwnerPlayer=ownerPlayerset ItemReceiverUnit=receiverUnitset ItemPickupGuard=0call EnumItemsInRect(searchRect,Condition(function FilterAlwaysTrue),function EnumAddFirstVisiblePlayerItemToUnit)endifendifcall RemoveRect(searchRect)set expireTrigger=nullset receiverUnit=nullset grantTargetUnit=nullset searchRect=nullreturn falseendfunctionfunction DropAndTrackUnitDroppableItems takes unit sourceUnit,unit heroUnit returns nothinglocal player owner=GetOwningPlayer(heroUnit)local integer slotIndexlocal item currentItemlocal trigger recollectTrigger=CreateTrigger()local integer triggerId=GetHandleId(recollectTrigger)local real dropX=GetUnitX(sourceUnit)local real dropY=GetUnitY(sourceUnit)local integer itemIndexif IsTerrainPathable(dropX,dropY,PATHING_TYPE_WALKABILITY)thenset dropX=GetUnitX(heroUnit)set dropY=GetUnitY(heroUnit)endifcall TriggerRegisterDeathEvent(recollectTrigger,heroUnit)call TriggerRegisterTimerEvent(recollectTrigger,.01,true)call TriggerAddCondition(recollectTrigger,Condition(function OnDroppedItemRecollectExpire))call SaveUnitHandle(GameHashtable,(triggerId),(2),(heroUnit))call SaveUnitHandle(GameHashtable,(triggerId),(92),(sourceUnit))call SavePlayerHandle(GameHashtable,(triggerId),(54),(owner))call SaveReal(GameHashtable,(trigge