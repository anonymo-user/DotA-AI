 thenreturn"4.5"elseif value>3.5 thenreturn"4.0"elseif value>3. thenreturn"3.5"elseif value>2.5 thenreturn"3.0"elseif value>2. thenreturn"2.5"elseif value>1.5 thenreturn"2.0"elseif value>1. thenreturn"1.5"elseif value>.5 thenreturn"1.0"elseif value>.0 thenreturn"0.5"elsereturn"0.0"endifreturn" "endfunctionfunction OnCountdownTextDisplayTick takes nothing returns booleanlocal trigger tickTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(tickTrigger)local unit targetUnit=(LoadUnitHandle(GameHashtable,(triggerId),(17)))local integer tickCount=GetTriggerEvalCount(tickTrigger)if tickCount>11 thencall FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(tickTrigger)elsecall CreatePurpleFloatingTextOnUnit(FormatRealToHalfStepString(5.5-.5*tickCount),targetUnit,targetUnit)endifset tickTrigger=nullset targetUnit=nullreturn falseendfunctionfunction OnDelayedDamageApplyExpire takes nothing returns booleanlocal trigger expireTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(expireTrigger)local unit targetUnit=(LoadUnitHandle(GameHashtable,(handleId),(17)))local real damageAmount=(LoadReal(GameHashtable,(handleId),(20)))local real newLife=RealMax(GetUnitState(targetUnit,UNIT_STATE_LIFE)-damageAmount,1)local real pendingDamage=(LoadReal(GameHashtable,(GetHandleId(targetUnit)),(243)))call SetUnitState(targetUnit,UNIT_STATE_LIFE,newLife)call SaveReal(GameHashtable,(GetHandleId(targetUnit)),(243),((pendingDamage-damageAmount)*1.0))call FlushChildHashtable(GameHashtable,handleId)call RecycleExpiringTrigger(expireTrigger)set expireTrigger=nullset targetUnit=nullreturn falseendfunctionfunction ScheduleDelayedDamageReduction takes unit targetUnit,real reductionAmount returns nothinglocal trigger delayTrigger=CreateTrigger()local integer triggerId=GetHandleId(delayTrigger)local real currentReduction=(LoadReal(GameHashtable,(GetHandleId(targetUnit)),(243)))call SaveUnitHandle(GameH