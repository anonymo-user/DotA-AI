[ItemIndexCost1400C]thenset count1400C=count1400C+1if(not(isDropEvent and slotItemTypeId==GetItemTypeId(GetManipulatedItem())))or(count1400C>1 and slotItemTypeId==GetItemTypeId(GetManipulatedItem()))thenset hasCost1400C=trueendifendifif slotItemTypeId==ItemTypeId[ItemIndexCost1400B]thenset count1400B=count1400B+1if(not(isDropEvent and slotItemTypeId==GetItemTypeId(GetManipulatedItem())))or(count1400B>1 and slotItemTypeId==GetItemTypeId(GetManipulatedItem()))thenset hasCost1400B=trueendifendifif slotItemTypeId==ItemTypeId[ItemIndexCost1350]thenset count1350=count1350+1if(not(isDropEvent and slotItemTypeId==GetItemTypeId(GetManipulatedItem())))or(count1350>1 and slotItemTypeId==GetItemTypeId(GetManipulatedItem()))thenset hasCost1350=trueendifendifif slotItemTypeId==(ItemTypeId[ItemIndexCost1450])thenset count1450=count1450+1if(not(isDropEvent and slotItemTypeId==GetItemTypeId(GetManipulatedItem())))or(count1450>1 and slotItemTypeId==GetItemTypeId(GetManipulatedItem()))thenset hasCost1450=trueendifendifif slotItemTypeId==(ItemTypeId[ItemIndexGold1000A])thenset count1000A=count1000A+1if(not(isDropEvent and slotItemTypeId==GetItemTypeId(GetManipulatedItem())))or(count1000A>1 and slotItemTypeId==GetItemTypeId(GetManipulatedItem()))thenset hasGold1000A=trueendifendifif slotItemTypeId==(ItemTypeId[ItemIndexGold1000B])thenset count1000B=count1000B+1if(not(isDropEvent and slotItemTypeId==GetItemTypeId(GetManipulatedItem())))or(count1000B>1 and slotItemTypeId==GetItemTypeId(GetManipulatedItem()))thenset hasGold1000B=trueendifendifset slotIndex=slotIndex+1endloopcall RemoveItem(UnitRemoveItemFromSlot(hero2,0))if hero3!=null thencall RemoveItem(UnitRemoveItemFromSlot(hero3,0))endifif hero4!=null thencall RemoveItem(UnitRemoveItemFromSlot(hero4,0))endifif hero5!=null thencall RemoveItem(UnitRemoveItemFromSlot(hero5,0))endifif hasGold1000B thencall UnitAddItem(hero2,CreateItem((ItemTypeId[ItemIndexGold1000B]),0,0))if hero3!=null thencall UnitAddItem(hero3,CreateItem((ItemTypeId[ItemIndexGold1000B]),0,0))endifif hero4!=null thencall UnitAddItem(hero4,CreateItem((ItemTypeId[ItemIndexGold1000B]),0,0))endifif hero5!=null thencall UnitAddItem(hero5,CreateItem((ItemTypeId[ItemIndexGold1000B]),0,0))endifelseif hasGold1000A thencall UnitAddItem(hero2,CreateItem((ItemTypeId[ItemIndexGold1000A]),0,0))if hero3!=null thencall UnitAddItem(hero3,CreateItem((ItemTypeId[ItemIndexGold1000A]),0,0))endifif hero4!=null thencall UnitAddItem(hero4,CreateItem((ItemTypeId[ItemIndexGold1000A]),0,0))endifif hero5!=null thencall UnitAddItem(hero5,CreateItem((ItemTypeId[ItemIndexGold1000A]),0,0))endifelseif hasCost1450 thencall UnitAddItem(hero2,CreateItem((ItemTypeId[ItemIndexCost1450]),0,0))if hero3!=null thencall UnitAddItem(hero3,CreateItem((ItemTypeId[ItemIndexCost1450]),0,0))endifif hero4!=null thencall UnitAddItem(hero4,CreateItem((ItemTypeId[ItemIndexCost1450]),0,0))endifif hero5!=null thencall UnitAddItem(hero5,CreateItem((ItemTypeId[ItemIndexCost1450]),0,0))endifelseif hasCost1350 thencall UnitAddItem(hero2,CreateItem(ItemTypeId[ItemIndexCost1350],0,0))if hero3!=null thencall UnitAddItem(hero3,CreateItem(ItemTypeId[ItemIndexCost1350],0,0))endifif hero4!=null thencall UnitAddItem(hero4,CreateItem(ItemTypeId[ItemIndexCost1350],0,0))endifif hero5!=null thencall UnitAddItem(hero5,CreateItem((ItemTypeId[ItemIndexCost1350]),0,0))endifelseif hasCost1400B thencall UnitAddItem(hero2,CreateItem(ItemTypeId[ItemIndexCost1400B],0,0))if hero3!=null thencall UnitAddItem(hero3,CreateItem(ItemTypeId[ItemIndexCost1400B],0,0))endifif hero4!=null thencall UnitAddItem(hero4,CreateItem(ItemTypeId[ItemIndexCost1400B],0,0))endifif hero5!=null thencall UnitAddItem(hero5,CreateItem((ItemTypeId[ItemIndexCost1400B]),0,0))endifelseif hasCost1400C thencall UnitAddItem(hero2,CreateItem(ItemTypeId[ItemIndexCost1400C],0,0))if hero3!=null thencall UnitAddItem(hero3,CreateItem(ItemTypeId[ItemIndexCost1400C],0,0))endifif hero4!=null thencall UnitAddItem(hero4,CreateItem(ItemTypeId[ItemIndexCost1400C],0,0))endifif hero5!=null thencall UnitAddItem(hero5,CreateItem((ItemTypeId[ItemIndexCost1400C]),0,0))endifelseif hasCost1400D thencall UnitAddItem(hero2,CreateItem(ItemTypeId[ItemIndexCost1400D],0,0))if hero3!=null thencall UnitAddItem(hero3,CreateItem(ItemTypeId[ItemIndexCost1400D],0,0))endifif hero4!=null thencall UnitAddItem(hero4,CreateItem(ItemTypeId[ItemIndexCost1400D],0,0))endifif hero5!=null thencall UnitAddItem(hero5,CreateItem((ItemTypeId[ItemIndexCost1400D]),0,0))endifelseif hasCost2450 thencall UnitAddItem(hero2,CreateItem(ItemTypeId[ItemIndexCost2450],0,0))if hero3!=null thencall UnitAddItem(hero3,CreateItem(ItemTypeId[ItemIndexCost2450],0,0))endifif hero4!=null thencall UnitAddItem(hero4,CreateItem(ItemTypeId[ItemIndexCost2450],0,0))endifif hero5!=null thencall UnitAddItem(hero5,CreateItem((ItemTypeId[ItemIndexCost2450]),0,0))endifelseif hasCost450 thencall UnitAddItem(hero2,CreateItem(ItemTypeId[ItemIndexCost450A],0,0))if hero3!=null thencall UnitAddItem(hero3,CreateItem(ItemTypeId[ItemIndexCost450A],0,0))endifif hero4!=null thencall UnitAddItem(hero4,CreateItem(ItemTypeId[ItemIndexCost450A],0,0))endifif hero5!=null thencall UnitAddItem(hero5,CreateItem((ItemTypeId[ItemIndexCost450A]),0,0))endifendifcall EnableTrigger(GetTriggeringTrigger())call EnableTrigger(ToggleableTrigger)set manipulatingUnit=nullset hero1=nullset hero2=nullset hero3=nullset hero4=nullendfunctionfunction PropagateSkillToClones takes unit sourceHero,integer skillId returns nothinglocal integer ownerId=GetHandleId(GetOwningPlayer(sourceHero))local unit clone0=(LoadUnitHandle(GameHashtable,(ownerId),(699)))local unit clone1=(LoadUnitHandle(GameHashtable,(ownerId),(700)))local unit clone2=(LoadUnitHandle(GameHashtable,(ownerId),(701)))local unit clone3=(LoadUnitHandle(GameHashtable,(ownerId),(702)))local unit clone4=(LoadUnitHandle(GameHashtable,(ownerId),(703)))if clone0!=null and clone0!=sourceHero thencall SelectHeroSkill(clone0,skillId)endifif clone1!=null and clone1!=sourceHero thencall SelectHeroSkill(clone1,skillId)endifif clone2!=null and clone2!=sourceHero thencall SelectHeroSkill(clone2,skillId)endifif clone3!=null and clone3!=sourceHero thencall SelectHeroSkill(clone3,skillId)endifif clone4!=null and clone4!=sourceHero thencall SelectHeroSkill(clone4,skillId)endifset clone0=nullset clone1=nullset clone2=nullset clone3=nullset clone4=nullendfunctionfunction LevelSkillToMatch takes integer abilityId,unit sourceUnit,unit targetUnit returns nothinglocal integer index=1local integer skillLevel=GetUnitAbilityLevel(sourceUnit,abilityId)loopexitwhen index>skillLevelcall SelectHeroSkill(targetUnit,abilityId)set index=index+1endloopendfunctionfunction CopyHeroXpAndSkillsToClone takes unit cloneUnit,unit sourceHero returns nothingcall AddHeroXP(cloneUnit,GetHeroXP(sourceHero),false)call SaveInteger(GameHashtable,(GetHandleId(cloneUnit)),(368),(GetHeroXP(sourceHero)))call SaveInteger(GameHashtable,(GetHandleId(cloneUnit)),(367),(0))call LevelSkillToMatch('A0N8',sourceHero,cloneUnit)call LevelSkillToMatch('A0NB',sourceHero,cloneUnit)call LevelSkillToMatch('A0N7',sourceHero,cloneUnit)call LevelSkillToMatch('Aamk',sourceHero,cloneUnit)call LevelSkillToMatch('A0MW',sourceHero,cloneUnit)call LevelSkillToMatch('A27C',sourceHero,cloneUnit)endfunctionfunction EqualizeSkillLevelPair takes unit firstHero,unit secondHero,integer abilityId,integer firstLevel,integer secondLevel returns nothingif firstLevel>secondLevel thencall SelectHeroSkill(secondHero,abilityId)elseif secondLevel>firstLevel thencall SelectHeroSkill(firstHero,abilityId)endifendfunctionfunction TransferHeroXpBetween takes unit unitA,unit unitB returns nothinglocal integer y8=GetHeroXP(unitA)local integer y9=GetHeroXP(unitB)local integer yW=GetHandleId(unitA)local integer yx=GetHandleId(unitB)local integer yZ=(LoadInteger(GameHashtable,(yW),(368)))local integer y4=(LoadInteger(GameHashtable,(yx),(368)))local integer xpDeltaif y8>y9 thenset xpDelta=y8-y9call AddHeroXP(unitB,xpDelta,true)if y9!=GetHeroXP(unitB)thencall SaveInteger(GameHashtable,(yx),(368),(y4+xpDelta))endifelseif y8<y9 thenset xpDelta=y9-y8call AddHeroXP(unitA,xpDelta,true)if y8!=GetHeroXP(unitA)thencall SaveInteger(GameHashtable,(yW),(368),(yZ+xpDelta))endifendifendfunctionfunction SyncSkillLevelsPair takes unit firstUnit,unit secondUnit returns nothinglocal integer firstLevelA0N8=GetUnitAbilityLevel(firstUnit,'A0N8')local integer firstLevelA0NB=GetUnitAbilityLevel(firstUnit,'A0NB')local integer firstLevelA0N7=GetUnitAbilityLevel(firstUnit,'A0N7')local integer firstLevelA0MW=GetUnitAbilityLevel(firstUnit,'A0MW')local integer firstLevelAamk=GetUnitAbilityLevel(firstUnit,'Aamk')local integer firstLevelA27C=GetUnitAbilityLevel(firstUnit,'A27C')local integer secondLevelA0N8=GetUnitAbilityLevel(secondUnit,'A0N8')local integer secondLevelA0NB=GetUnitAbilityLevel(secondUnit,'A0NB')local integer secondLevelA0N7=GetUnitAbilityLevel(secondUnit,'A0N7')local integer secondLevelA0MW=GetUnitAbilityLevel(secondUnit,'A0MW')local integer secondLevelAamk=GetUnitAbilityLevel(secondUnit,'Aamk')local integer secondLevelA27C=GetUnitAbilityLevel(secondUnit,'A27C')call TransferHeroXpBetween(firstUnit,secondUnit)call EqualizeSkillLevelPair(firstUnit,secondUnit,'A0N8',firstLevelA0N8,secondLevelA0N8)call EqualizeSkillLevelPair(firstUnit,secondUnit,'A0NB',firstLevelA0NB,secondLevelA0NB)call EqualizeSkillLevelPair(firstUnit,secondUnit,'A0N7',firstLevelA0N7,secondLevelA0N7)call EqualizeSkillLevelPair(firstUnit,secondUnit,'A0MW',firstLevelA0MW,secondLevelA0MW)call EqualizeSkillLevelPair(firstUnit,secondUnit,'A27C',firstLevelA27C,secondLevelA27C)call EqualizeSkillLevelPair(firstUnit,secondUnit,'Aamk',firstLevelAamk,secondLevelAamk)endfunctionfunction SyncSkillPairIfBothAlive takes unit firstUnit,unit secondUnit returns nothingif firstUnit!=null and secondUnit!=null thencall SyncSkillLevelsPair(firstUnit,secondUnit)endifendfunctionfunction SyncAllClonePairSkills takes nothing returns nothinglocal integer ownerPlayerId=GetHandleId((LoadPlayerHandle(GameHashtable,(GetHandleId(GetTriggeringTrigger())),(370))))local unit cloneUnit1=(LoadUnitHandle(GameHashtable,(ownerPlayerId),(699)))local unit cloneUnit2=(LoadUnitHandle(GameHashtable,(ownerPlayerId),(700)))local unit cloneUnit3=(LoadUnitHandle(GameHashtable,(ownerPlayerId),(701)))local unit cloneUnit4=(LoadUnitHandle(GameHashtable,(ownerPlayerId),(702)))local unit cloneUnit5=(LoadUnitHandle(GameHashtable,(ownerPlayerId),(703)))call DisableTrigger(ToggleableTrigger_2)call SyncSkillPairIfBothAlive(cloneUnit1,cloneUnit2)call SyncSkillPairIfBothAlive(cloneUnit1,cloneUnit3)call SyncSkillPairIfBothAlive(cloneUnit1,cloneUnit4)call SyncSkillPairIfBothAlive(cloneUnit1,cloneUnit5)call SyncSkillPairIfBothAlive(cloneUnit2,cloneUnit3)call SyncSkillPairIfBothAlive(cloneUnit2,cloneUnit4)call SyncSkillPairIfBothAlive(cloneUnit2,cloneUnit5)call SyncSkillPairIfBothAlive(cloneUnit3,cloneUnit4)call SyncSkillPairIfBothAlive(cloneUnit3,cloneUnit5)call SyncSkillPairIfBothAlive(cloneUnit4,cloneUnit5)call EnableTrigger(ToggleableTrigger_2)set cloneUnit1=nullset cloneUnit2=nullset cloneUnit3=nullset cloneUnit4=nullset cloneUnit5=nullendfunctionfunction StartCloneSkillSyncTimer takes nothing returns nothinglocal trigger t=CreateTrigger()call TriggerRegisterTimerEvent(t,.2,true)call TriggerAddAction(t,function SyncAllClonePairSkills)call SavePlayerHandle(GameHashtable,(GetHandleId(t)),(370),(GetOwningPlayer(GetTriggerUnit())))set t=nullendfunctionfunction InitCloneHeroSystem takes unit heroUnit returns nothinglocal trigger syncTrigcall SaveUnitHandle(GameHashtable,(GetHandleId(GetOwningPlayer(heroUnit))),(699),(heroUnit))call SaveInteger(GameHashtable,(GetHandleId(