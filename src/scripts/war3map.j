 SetUnitStackBonusAbilitiesFromCount(hero,0)call SetUnitState(hero,UNIT_STATE_LIFE,RealMax(GetUnitState(hero,UNIT_STATE_MAX_LIFE)-missingLife,1))call FlushChildHashtable(GameHashtable,(triggerId))call RecycleExpiringTrigger(stackTrigger)elseif GetTriggerEventId()!=EVENT_UNIT_DROP_ITEM and stackCount<25 thencall SaveInteger(GameHashtable,(GetHandleId((hero))),((4298)),(1))set stackCount=stackCount+1call SetUnitStackBonusAbilitiesFromCount(hero,stackCount)call SetUnitState(hero,UNIT_STATE_LIFE,RealMax(GetUnitState(hero,UNIT_STATE_MAX_LIFE)-missingLife,1))call SaveInteger(GameHashtable,(triggerId),(34),(stackCount))elsecall SaveInteger(GameHashtable,(GetHandleId((hero))),((4298)),(2))endifset stackTrigger=nullset hero=nullset whichItem=nullreturn falseendfunctionfunction TickHeldItemLifeDrain takes nothing returns booleanlocal trigger tickTrigger=GetTriggeringTrigger()local integer triggerId=GetHandleId(tickTrigger)local unit holderUnit=(LoadUnitHandle(GameHashtable,(triggerId),(14)))local item drainItem=(LoadItemHandle(GameHashtable,(triggerId),(96)))if GetTriggerEventId()==EVENT_UNIT_DROP_ITEM and GetManipulatedItem()==drainItem thencall FlushChildHashtable(GameHashtable,triggerId)call RecycleExpiringTrigger(tickTrigger)elseif GetTriggerEventId()!=EVENT_UNIT_DROP_ITEM thenif((LoadInteger(GameHashtable,(GetHandleId((holderUnit))),((4310))))==1)==false thencall SetUnitState(holderUnit,UNIT_STATE_LIFE,RealMax(GetUnitState(holderUnit,UNIT_STATE_LIFE)-LifeDrainBaseAmount*.1,1))endifendifset tickTrigger=nullset holderUnit=nullset drainItem=nullreturn falseendfunctionfunction StartHeldItemDrainAndStackTimers takes nothing returns nothinglocal unit carrierUnit=GetTriggerUnit()local trigger timerTrigger=CreateTrigger()local integer handleId=GetHandleId(timerTrigger)call TriggerRegisterTimerEvent(timerTrigger,.1,true)call TriggerRegisterUnitEvent(timerTrigger,carrierUnit,EVENT_UNIT_DROP_ITEM)call TriggerAddCondition(timerTrigger,Condit