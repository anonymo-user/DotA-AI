nset enemyPlayer=ScourgePlayer[1]elseset enemyPlayer=SentinelPlayer[1]endifif GetTriggerEventId()==EVENT_UNIT_DAMAGED and GetOwningPlayer(GetEventDamageSource())==CreepControlPlayer thenif GetUnitAbilityLevel(heroUnit,'A1IE')>0 thencall UnitRemoveAbility(heroUnit,'A1IE')call UnitRemoveAbility(heroUnit,'B0C9')endifif GetUnitAbilityLevel(heroUnit,'A1IF')>0 thencall UnitRemoveAbility(heroUnit,'A1IF')call UnitRemoveAbility(heroUnit,'B0C9')endifif GetUnitAbilityLevel(heroUnit,'A1IG')>0 thencall UnitRemoveAbility(heroUnit,'A1IG')call UnitRemoveAbility(heroUnit,'B0C9')endifcall SaveReal(GameHashtable,(handleId),(414),((currentTime+2)*1.0))set tickTrigger=nullset heroUnit=nullreturn falseendifif(LoadReal(GameHashtable,(handleId),(414)))>currentTime thenset tickTrigger=nullset heroUnit=nullreturn falseendifif(IsUnitVisible(heroUnit,enemyPlayer)and IsAnyOfStatus4420Or4421Set(heroUnit)==false)or GetUnitAbilityLevel(heroUnit,'BNdo')>0 thenset invisibleAccumulator=0if GetUnitAbilityLevel(heroUnit,'A1IE')>0 or GetUnitAbilityLevel(heroUnit,'A1IF')>0 or GetUnitAbilityLevel(heroUnit,'A1IG')>0 thenset visibleAccumulator=visibleAccumulator+0.1if visibleAccumulator>0.4 thenset visibleAccumulator=0if GetUnitAbilityLevel(heroUnit,'A1IE')>0 thencall UnitRemoveAbility(heroUnit,'A1IE')call UnitRemoveAbility(heroUnit,'B0C9')endifif GetUnitAbilityLevel(heroUnit,'A1IF')>0 thencall UnitRemoveAbility(heroUnit,'A1IF')call UnitRemoveAbility(heroUnit,'B0C9')endifif GetUnitAbilityLevel(heroUnit,'A1IG')>0 thencall UnitRemoveAbility(heroUnit,'A1IG')call UnitRemoveAbility(heroUnit,'B0C9')endifendifendifcall SaveReal(GameHashtable,(handleId),(415),((visibleAccumulator)*1.0))call SaveReal(GameHashtable,(handleId),(416),((invisibleAccumulator)*1.0))elseif IsUnitVisible(heroUnit,enemyPlayer)==false or IsAnyOfStatus4420Or4421Set(heroUnit)thenset visibleAccumulator=0if(abilityLevel==1 and GetUnitAbilityLevel(heroUnit,'A1IE')==0)or(abilityLevel==2 and GetUnitAbilityLevel(heroUnit,'A1IF')==0)or(abilityLevel==3 and GetUnitAbilityLevel(heroUnit,'A1IG')==0)thenset invisibleAccumulator=invisibleAccumulator+0.1if invisibleAccumulator>0.4 thenset invisibleAccumulator=0if abilityLevel==1 thenif GetUnitAbilityLevel(heroUnit,'A1IE')==0 thencall AddPermanentAbility(heroUnit,'A1IE')call UnitMakeAbilityPermanent(heroUnit,true,'A1I7')call UnitMakeAbilityPermanent(heroUnit,true,'A1I8')call UnitMakeAbilityPermanent(heroUnit,true,'A1IC')endifendifif abilityLevel==2 thenif GetUnitAbilityLevel(heroUnit,'A1IE')>0 thencall UnitRemoveAbility(heroUnit,'A1IE')call UnitRemoveAbility(heroUnit,'B0C9')endifif GetUnitAbilityLevel(heroUnit,'A1IF')==0 thencall AddPermanentAbility(heroUnit,'A1IF')call UnitMakeAbilityPermanent(heroUnit,true,'A1I7')call UnitMakeAbilityPermanent(heroUnit,true,'A1I9')call UnitMakeAbilityPermanent(heroUnit,true,'A1ID')endifendifif abilityLevel==3 thenif GetUnitAbilityLevel(heroUnit,'A1IE')>0 thencall UnitRemoveAbility(heroUnit,'A1IE')call UnitRemoveAbility(heroUnit,'B0C9')endifif GetUnitAbilityLevel(heroUnit,'A1IF')>0 thencall UnitRemoveAbility(heroUnit,'A1IF')call UnitRemoveAbility(heroUnit,'B0C9')endifif GetUnitAbilityLevel(heroUnit,'A1IG')==0 thencall AddPermanentAbility(heroUnit,'A1IG')call UnitMakeAbilityPermanent(heroUnit,true,'A1I7')call UnitMakeAbilityPermanent(heroUnit,true,'A1IA')call UnitMakeAbilityPermanent(heroUnit,true,'A1IB')endifendifendifendifcall SaveReal(GameHashtable,(handleId),(415),((visibleAccumulator)*1.0))call SaveReal(GameHashtable,(handleId),(416),((invisibleAccumulator)*1.0))endifset tickTrigger=nullset heroUnit=nullreturn falseendfunctionfunction StartPermanentInvisibilityMonitor takes unit heroUnit,boolean initialFlag returns nothinglocal trigger monitorTrigger=CreateTrigger()local integer trigHandleId=GetHandleId(monitorTrigger)call SaveReal(GameHashtable,(trigHandleId),(415),((0)*1.0))call SaveReal(GameHashtable,(trigHandleId),(416),((0)*