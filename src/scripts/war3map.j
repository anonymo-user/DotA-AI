up(unitGroup,function RemoveEnumeratedUnit)call DestroyBoolExpr(filter)call ReleaseGroupToPool(unitGroup)set filter=nullset unitGroup=nullendfunctionfunction FilterUnitTypeNcop takes nothing returns booleanreturn GetUnitTypeId(GetFilterUnit())=='ncop'endfunctionfunction RefreshEnumCourierAbilities takes nothing returns nothingif GameModeFlagVT thencall UnitRemoveAbility(PlayerControlUnit[GetPlayerId(GetOwningPlayer(GetEnumUnit()))],'A14E')call UnitRemoveAbility(PlayerControlUnit[GetPlayerId(GetOwningPlayer(GetEnumUnit()))],'A14H')endifif GetUnitAbilityLevel(GetEnumUnit(),'A0I4')==0 thencall UnitAddAbility(GetEnumUnit(),'A0I4')endifendfunctionfunction RefreshPlayerCourierAbilities takes player whichPlayer returns nothinglocal group unitGroup=AcquireGroupFromPool()call GroupEnumUnitsOfPlayer(unitGroup,whichPlayer,Condition(function FilterUnitTypeNcop))call ForGroup(unitGroup,function RefreshEnumCourierAbilities)call ReleaseGroupToPool(unitGroup)set unitGroup=nullendfunctionfunction GetNextTeammateInForce takes player whichPlayer returns playerlocal integer slot=1local integer foundSlot=0local boolean useScourgeSide=falseloopif((foundSlot>0)and(GetTeamPlayerBySlot(slot,useScourgeSide)!=null)and(IsPlayerInForce(GetTeamPlayerBySlot(slot,useScourgeSide),RegisteredHeroPlayersForce)))thenreturn GetTeamPlayerBySlot(slot,useScourgeSide)endifif(SentinelPlayer[slot]==whichPlayer)thenset useScourgeSide=trueset foundSlot=slotelseif(ScourgePlayer[slot]==whichPlayer)thenset foundSlot=slotendifset slot=slot+1exitwhen slot>5endloopreturn nullendfunctionfunction FormatHeroPickAnnouncement takes unit heroUnit,player whichPlayer returns stringlocal string announcement=(GetObjectName(('n0DB')))set announcement=ReplaceFirstOccurrence(announcement,"$hero",GetUnitName(heroUnit))set announcement=ReplaceFirstOccurrence(announcement,"$p",(PlayerName[GetPlayerId((whichPlayer))]))return announcementendfunctionfunction RefundAllItemsForGold takes 