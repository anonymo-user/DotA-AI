retFound,whichPlayer)elseif GetTriggerEvalCount(whichTrigger)==3 thencall DisplayTimedTextToPlayer(whichPlayer,0,0,15,"Tip 3: "+colorCode+HeroTipLine3[heroIndex]+"|r")call PlaySoundForPlayerIfUnmuted(SndSecretFound,whichPlayer)elseif GetTriggerEvalCount(whichTrigger)==4 thencall DisplayTimedTextToPlayer(whichPlayer,0,0,15,"Tip 4: "+colorCode+HeroTipLine4[heroIndex]+"|r")call PlaySoundForPlayerIfUnmuted(SndSecretFound,whichPlayer)elseif GetTriggerEvalCount(whichTrigger)==5 thencall DisplayTimedTextToPlayer(whichPlayer,0,0,15,"Tip 5: "+colorCode+HeroTipLine5[heroIndex]+"|r")call PlaySoundForPlayerIfUnmuted(SndSecretFound,whichPlayer)endifendifif GetTriggerEvalCount(whichTrigger)==5 thencall RecycleExpiringTrigger(whichTrigger)call FlushChildHashtable(GameHashtable,handleId)endifset whichTrigger=nullreturn falseendfunctionfunction ScheduleGameTipsForPlayer takes player whichPlayer,integer heroIndex returns nothinglocal trigger whichTrigger=CreateTrigger()local integer handleId=GetHandleId(whichTrigger)call TriggerRegisterTimerEvent(whichTrigger,10,false)call TriggerRegisterTimerEvent(whichTrigger,15,false)call TriggerRegisterTimerEvent(whichTrigger,300,true)call TriggerAddCondition(whichTrigger,Condition(function OnGameTipTimer))call SavePlayerHandle(GameHashtable,(handleId),(54),(whichPlayer))call SaveInteger(GameHashtable,(handleId),(77),(heroIndex))set whichTrigger=nullendfunctionfunction GetAttachedUnitTypeForOwner takes unit whichUnit returns integerlocal integer unitTypeId=GetUnitTypeId(whichUnit)local integer attachedUnitType='o01P'if unitTypeId=='Udre' thenset attachedUnitType='o01N'elseif unitTypeId=='Emoo' or unitTypeId=='H00I' or unitTypeId=='H071' or unitTypeId=='E005' thenset attachedUnitType='o01O'endifreturn attachedUnitTypeendfunctionfunction OnAttachedUnitTrackOrDeath takes nothing returns booleanlocal trigger whichTrigger=GetTriggeringTrigger()local integer handleId=GetHandleId(whichTrigger)local unit tracked