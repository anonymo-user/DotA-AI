rue)call SetPlayerAlliance(SentinelPlayer[playerIndexA],SentinelPlayer[playerIndexB],ConvertAllianceType(2),true)call SetPlayerAlliance(SentinelPlayer[playerIndexA],SentinelPlayer[playerIndexB],ConvertAllianceType(3),true)call SetPlayerAlliance(SentinelPlayer[playerIndexA],SentinelPlayer[playerIndexB],ConvertAllianceType(4),true)call SetPlayerAlliance(SentinelPlayer[playerIndexA],SentinelPlayer[playerIndexB],ConvertAllianceType(5),true)call SetPlayerAlliance(SentinelPlayer[playerIndexA],SentinelPlayer[playerIndexB],ConvertAllianceType(6),false)call SetPlayerAlliance(SentinelPlayer[playerIndexA],SentinelPlayer[playerIndexB],ConvertAllianceType(7),false)call SetPlayerAlliance(ScourgePlayer[playerIndexA],ScourgePlayer[playerIndexB],ConvertAllianceType(0),true)call SetPlayerAlliance(ScourgePlayer[playerIndexA],ScourgePlayer[playerIndexB],ConvertAllianceType(1),true)call SetPlayerAlliance(ScourgePlayer[playerIndexA],ScourgePlayer[playerIndexB],ConvertAllianceType(2),true)call SetPlayerAlliance(ScourgePlayer[playerIndexA],ScourgePlayer[playerIndexB],ConvertAllianceType(3),true)call SetPlayerAlliance(ScourgePlayer[playerIndexA],ScourgePlayer[playerIndexB],ConvertAllianceType(4),true)call SetPlayerAlliance(ScourgePlayer[playerIndexA],ScourgePlayer[playerIndexB],ConvertAllianceType(5),true)call SetPlayerAlliance(ScourgePlayer[playerIndexA],ScourgePlayer[playerIndexB],ConvertAllianceType(6),false)call SetPlayerAlliance(ScourgePlayer[playerIndexA],ScourgePlayer[playerIndexB],ConvertAllianceType(7),false)call SetPlayerAlliance(SentinelPlayer[playerIndexA],ScourgePlayer[playerIndexB],ConvertAllianceType(0),false)call SetPlayerAlliance(SentinelPlayer[playerIndexA],ScourgePlayer[playerIndexB],ConvertAllianceType(1),false)call SetPlayerAlliance(SentinelPlayer[playerIndexA],ScourgePlayer[playerIndexB],ConvertAllianceType(2),false)call SetPlayerAlliance(SentinelPlayer[playerIndexA],ScourgePlayer[playerIndexB],ConvertAllianceType(3),false)call SetPlayerAlliance(Sent